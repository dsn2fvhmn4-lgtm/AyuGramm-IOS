+import Foundation
+import UIKit
+import AccountContext
+
+/// The plugin store: code plugins from the online catalog (github.com/murk-sus/AyuGramm-Plugins)
+/// with search, one-tap install verified by SHA-256 and an "update available" mark.
+final class AyuScriptCatalogController: AyuPluginTableController, UISearchBarDelegate {
+    private enum State {
+        case loading
+        case loaded([AyuScriptCatalog.Entry])
+        case failed(String)
+    }
+
+    private let russian: Bool
+    private let palette: AyuPreferencesPalette?
+    private let presentAlert: ((_ title: String?, _ message: String, _ actions: [AyuPluginAlertAction]) -> Void)?
+    private var state: State = .loading
+    private var query = ""
+    private var installing = Set<String>()
+    private var observer: NSObjectProtocol?
+
+    init(russian: Bool, palette: AyuPreferencesPalette?, presentAlert: ((_ title: String?, _ message: String, _ actions: [AyuPluginAlertAction]) -> Void)?) {
+        self.russian = russian
+        self.palette = palette
+        self.presentAlert = presentAlert
+        super.init(style: .insetGrouped)
+        self.title = russian ? "Каталог" : "Catalog"
+    }
+
+    required init?(coder: NSCoder) { return nil }
+
+    deinit {
+        if let observer = self.observer {
+            NotificationCenter.default.removeObserver(observer)
+        }
+    }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        self.edgesForExtendedLayout = []
+        let back = UIBarButtonItem(image: UIImage(systemName: "chevron.backward", withConfiguration: UIImage.SymbolConfiguration(weight: .semibold)), style: .plain, target: self, action: #selector(self.backTapped))
+        back.accessibilityLabel = self.russian ? "Назад" : "Back"
+        self.navigationItem.leftBarButtonItem = back
+        let search = UISearchBar(frame: CGRect(x: 0.0, y: 0.0, width: self.tableView.bounds.width, height: 56.0))
+        search.delegate = self
+        search.searchBarStyle = .minimal
+        search.placeholder = self.russian ? "Поиск плагинов" : "Search plugins"
+        search.autoresizingMask = [.flexibleWidth]
+        search.searchTextField.returnKeyType = .done
+        self.tableView.tableHeaderView = search
+        self.tableView.keyboardDismissMode = .onDrag
+        self.tableView.rowHeight = UITableView.automaticDimension
+        self.tableView.estimatedRowHeight = 110.0
+        self.tableView.backgroundColor = self.palette?.background ?? .systemGroupedBackground
+        let refresh = UIRefreshControl()
+        refresh.addTarget(self, action: #selector(self.refreshPulled), for: .valueChanged)
+        self.refreshControl = refresh
+        self.observer = NotificationCenter.default.addObserver(forName: ayuCodePluginsDidChangeNotification, object: nil, queue: .main, using: { [weak self] _ in
+            self?.reload()
+        })
+        self.load()
+    }
+
+    @objc private func backTapped() {
+        self.navigationController?.popViewController(animated: true)
+    }
+
+    @objc private func refreshPulled() {
+        self.load()
+    }
+
+    private func load() {
+        if case .failed = self.state { self.state = .loading }
+        self.reload()
+        AyuScriptCatalog.shared.load(completion: { [weak self] result in
+            guard let self else { return }
+            self.refreshControl?.endRefreshing()
+            switch result {
+            case let .success(entries):
+                self.state = .loaded(entries)
+            case let .failure(error):
+                if case .loaded = self.state {
+                    self.alert(title: self.russian ? "Каталог не обновлён" : "Catalog not updated", message: error.localizedDescription)
+                } else {
+                    self.state = .failed(error.localizedDescription)
+                }
+            }
+            self.reload()
+        })
+    }
+
+    private var installed: [String: String] {
+        var result: [String: String] = [:]
+        for plugin in AyuScriptRuntime.shared.plugins {
+            result[plugin.id] = plugin.version
+        }
+        return result
+    }
+
+    private var entries: [AyuScriptCatalog.Entry] {
+        guard case let .loaded(all) = self.state else { return [] }
+        guard !self.query.isEmpty else { return all }
+        return all.filter { entry in
+            ([entry.name, entry.author, entry.description, entry.id] + (entry.tags ?? [])).contains { $0.localizedCaseInsensitiveContains(self.query) }
+        }
+    }
+
+    private func reload() {
+        self.tableView.reloadData()
+        let message: String?
+        switch self.state {
+        case .loading:
+            message = self.russian ? "Загрузка каталога…" : "Loading the catalog…"
+        case let .failed(text):
+            message = text + (self.russian ? "\n\nПотяните вниз, чтобы повторить." : "\n\nPull down to retry.")
+        case .loaded:
+            message = self.entries.isEmpty ? (self.russian ? "Ничего не найдено." : "Nothing found.") : nil
+        }
+        guard let message else {
+            self.tableView.backgroundView = nil
+            return
+        }
+        let label = UILabel()
+        label.numberOfLines = 0
+        label.textAlignment = .center
+        label.textColor = self.palette?.secondary ?? .secondaryLabel
+        label.font = .preferredFont(forTextStyle: .subheadline)
+        label.text = message
+        let container = UIView()
+        label.translatesAutoresizingMaskIntoConstraints = false
+        container.addSubview(label)
+        NSLayoutConstraint.activate([
+            label.centerYAnchor.constraint(equalTo: container.centerYAnchor),
+            label.leadingAnchor.constraint(equalTo: container.leadingAnchor, constant: 32.0),
+            label.trailingAnchor.constraint(equalTo: container.trailingAnchor, constant: -32.0)
+        ])
+        self.tableView.backgroundView = container
+    }
+
+    func searchBar(_ searchBar: UISearchBar, textDidChange searchText: String) {
+        self.query = searchText.trimmingCharacters(in: .whitespacesAndNewlines)
+        self.reload()
+    }
+
+    func searchBarSearchButtonClicked(_ searchBar: UISearchBar) {
+        searchBar.resignFirstResponder()
+    }
+
+    override func numberOfSections(in tableView: UITableView) -> Int { return 1 }
+
+    override func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int {
+        return self.entries.count
+    }
+
+    override func tableView(_ tableView: UITableView, titleForFooterInSection section: Int) -> String? {
+        guard case .loaded = self.state, !self.entries.isEmpty else { return nil }
+        return self.russian
+            ? "Плагины из github.com/murk-sus/AyuGramm-Plugins. Каждый файл проверяется по SHA-256 из каталога. Свой плагин можно прислать pull request'ом."
+            : "Plugins from github.com/murk-sus/AyuGramm-Plugins. Every file is checked against the catalog's SHA-256. Send your own plugin as a pull request."
+    }
+
+    private enum Status {
+        case available
+        case installed
+        case update(String)
+    }
+
+    private func status(_ entry: AyuScriptCatalog.Entry) -> Status {
+        guard let version = self.installed[entry.id] else { return .available }
+        return AyuScriptCatalog.isNewer(entry.version, than: version) ? .update(version) : .installed
+    }
+
+    override func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
+        let entries = self.entries
+        let cell = UITableViewCell(style: .subtitle, reuseIdentifier: nil)
+        guard indexPath.row < entries.count else { return cell }
+        let entry = entries[indexPath.row]
+        let primary = self.palette?.text ?? .label
+        let secondary = self.palette?.secondary ?? .secondaryLabel
+        let accent = self.palette?.accent ?? .systemBlue
+        cell.backgroundColor = self.palette?.panel ?? .secondarySystemGroupedBackground
+        cell.textLabel?.numberOfLines = 2
+        cell.detailTextLabel?.numberOfLines = 0
+        let title = NSMutableAttributedString(string: entry.name, attributes: [.font: UIFont.systemFont(ofSize: 17.0, weight: .semibold), .foregroundColor: primary])
+        title.append(NSAttributedString(string: "  " + entry.version, attributes: [.font: UIFont.systemFont(ofSize: 13.0), .foregroundColor: secondary]))
+        cell.textLabel?.attributedText = title
+        let detail = NSMutableAttributedString(string: entry.author, attributes: [.font: UIFont.systemFont(ofSize: 14.0, weight: .medium), .foregroundColor: accent])
+        if !entry.description.isEmpty {
+            detail.append(NSAttributedString(string: "\n" + entry.description, attributes: [.font: UIFont.systemFont(ofSize: 14.0), .foregroundColor: secondary]))
+        }
+        if let tags = entry.tags, !tags.isEmpty {
+            detail.append(NSAttributedString(string: "\n" + tags.map { "#" + $0 }.joined(separator: " "), attributes: [.font: UIFont.systemFont(ofSize: 13.0), .foregroundColor: secondary.withAlphaComponent(0.8)]))
+        }
+        cell.detailTextLabel?.attributedText = detail
+        cell.accessoryView = self.actionView(entry)
+        cell.selectionStyle = .default
+        return cell
+    }
+
+    private func actionView(_ entry: AyuScriptCatalog.Entry) -> UIView {
+        if self.installing.contains(entry.id) {
+            let spinner = UIActivityIndicatorView(style: .medium)
+            spinner.startAnimating()
+            return spinner
+        }
+        let accent = self.palette?.accent ?? .systemBlue
+        let title: String
+        let filled: Bool
+        var enabled = true
+        switch self.status(entry) {
+        case .available:
+            title = self.russian ? "Установить" : "Install"
+            filled = false
+        case .update:
+            title = self.russian ? "Обновить" : "Update"
+            filled = true
+        case .installed:
+            title = self.russian ? "Установлен" : "Installed"
+            filled = false
+            enabled = false
+        }
+        var configuration = UIButton.Configuration.plain()
+        configuration.attributedTitle = AttributedString(title, attributes: AttributeContainer([.font: UIFont.systemFont(ofSize: 14.0, weight: .semibold)]))
+        configuration.baseForegroundColor = enabled ? (filled ? .white : accent) : (self.palette?.secondary ?? .secondaryLabel)
+        configuration.background.backgroundColor = filled ? accent : (enabled ? accent.withAlphaComponent(0.14) : .clear)
+        configuration.background.cornerRadius = 14.0
+        configuration.contentInsets = NSDirectionalEdgeInsets(top: 5.0, leading: 12.0, bottom: 5.0, trailing: 12.0)
+        let button = UIButton(configuration: configuration, primaryAction: UIAction(handler: { [weak self] _ in
+            self?.confirm(entry)
+        }))
+        button.isEnabled = enabled
+        button.sizeToFit()
+        return button
+    }
+
+    override func tableView(_ tableView: UITableView, didSelectRowAt indexPath: IndexPath) {
+        tableView.deselectRow(at: indexPath, animated: true)
+        let entries = self.entries
+        guard indexPath.row < entries.count else { return }
+        self.confirm(entries[indexPath.row])
+    }
+
+    private func confirm(_ entry: AyuScriptCatalog.Entry) {
+        guard !self.installing.contains(entry.id) else { return }
+        let status = self.status(entry)
+        var message = entry.author + "\n" + entry.id + " · " + entry.version
+        if case let .update(version) = status {
+            message += (self.russian ? " (установлена \(version))" : " (installed \(version))")
+        }
+        if let size = entry.size {
+            message += " · " + ByteCountFormatter.string(fromByteCount: Int64(size), countStyle: .file)
+        }
+        if !entry.description.isEmpty {
+            message += "\n\n" + entry.description
+        }
+        message += self.russian
+            ? "\n\nПлагин выполняется как код на этом устройстве. Он сможет изменять или полностью заменять обработку исходящего текста и отключать функции приложения. Доступа к сети и аккаунту у него нет."
+            : "\n\nThe plugin runs as code on this device. It can change or fully replace outgoing-text handling and switch app features off. It has no network or account access."
+        let title: String
+        let action: String
+        switch status {
+        case .available:
+            title = self.russian ? "Установить плагин?" : "Install plugin?"
+            action = self.russian ? "Установить" : "Install"
+        case .update:
+            title = self.russian ? "Обновить плагин?" : "Update plugin?"
+            action = self.russian ? "Обновить" : "Update"
+        case .installed:
+            title = entry.name
+            action = self.russian ? "Переустановить" : "Reinstall"
+        }
+        self.showAlert(title: title, message: message, actions: [
+            AyuPluginAlertAction(title: self.russian ? "Отмена" : "Cancel", style: .cancel, handler: nil),
+            AyuPluginAlertAction(title: action, style: .default, handler: { [weak self] in
+                self?.install(entry)
+            })
+        ])
+    }
+
+    private func install(_ entry: AyuScriptCatalog.Entry) {
+        self.installing.insert(entry.id)
+        self.reload()
+        AyuScriptCatalog.shared.install(entry, completion: { [weak self] result in
+            guard let self else { return }
+            self.installing.remove(entry.id)
+            self.reload()
+            if case let .failure(error) = result {
+                self.alert(title: self.russian ? "Не удалось установить" : "Could not install", message: error.localizedDescription)
+            }
+        })
+    }
+
+    private func alert(title: String, message: String) {
+        self.showAlert(title: title, message: message, actions: [AyuPluginAlertAction(title: "OK", style: .default, handler: nil)])
+    }
+
+    private func showAlert(title: String?, message: String, actions: [AyuPluginAlertAction]) {
+        if let presentAlert = self.presentAlert {
+            presentAlert(title, message, actions)
+            return
+        }
+        let alert = UIAlertController(title: title, message: message, preferredStyle: .alert)
+        for action in actions {
+            alert.addAction(UIAlertAction(title: action.title, style: action.style == .cancel ? .cancel : .default, handler: { _ in action.handler?() }))
+        }
+        self.present(alert, animated: true)
+    }
+}
