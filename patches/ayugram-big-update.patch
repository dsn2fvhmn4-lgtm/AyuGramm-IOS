+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        self.view.backgroundColor = .clear
+        self.dim.backgroundColor = UIColor.black.withAlphaComponent(0.35)
+        self.dim.frame = self.view.bounds
+        self.dim.autoresizingMask = [.flexibleWidth, .flexibleHeight]
+        self.dim.addGestureRecognizer(UITapGestureRecognizer(target: self, action: #selector(self.close)))
+        self.view.addSubview(self.dim)
+        self.panel.backgroundColor = .systemGroupedBackground
+        self.panel.layer.shadowOpacity = 0.2
+        self.panel.layer.shadowRadius = 12.0
+        self.view.addSubview(self.panel)
+        let navigation = UINavigationController(rootViewController: self.content)
+        self.addChild(navigation)
+        self.panel.addSubview(navigation.view)
+        navigation.didMove(toParent: self)
+        let swipe = UISwipeGestureRecognizer(target: self, action: #selector(self.close))
+        swipe.direction = .left
+        self.panel.addGestureRecognizer(swipe)
+    }
+
+    override func viewDidLayoutSubviews() {
+        super.viewDidLayoutSubviews()
+        let width = min(360.0, self.view.bounds.width * 0.82)
+        self.panel.frame = CGRect(x: 0.0, y: 0.0, width: width, height: self.view.bounds.height)
+        self.children.first?.view.frame = self.panel.bounds
+    }
+
+    override func viewWillAppear(_ animated: Bool) {
+        super.viewWillAppear(animated)
+        let width = min(360.0, self.view.bounds.width * 0.82)
+        self.panel.transform = CGAffineTransform(translationX: -width, y: 0.0)
+        UIView.animate(withDuration: 0.3, delay: 0.0, usingSpringWithDamping: 0.9, initialSpringVelocity: 0.0, options: [], animations: {
+            self.panel.transform = .identity
+        })
+    }
+
+    @objc private func close() {
+        UIView.animate(withDuration: 0.2, animations: {
+            self.panel.transform = CGAffineTransform(translationX: -self.panel.bounds.width, y: 0.0)
+        }, completion: { _ in
+            self.dismiss(animated: true)
+        })
+    }
+}
+
+/// `ayu.ui.searchBar.show`: a search field whose queries go to the plugin, which answers with rows.
+final class AyuPluginSearchController: UITableViewController, UISearchResultsUpdating {
+    private let owner: String
+    private let searchId: String
+    private var rows: [[String: Any]] = []
+    private var observer: NSObjectProtocol?
+    private var pending: DispatchWorkItem?
+
+    init(owner: String, id: String, title: String, placeholder: String) {
+        self.owner = owner
+        self.searchId = id.isEmpty ? "search" : id
+        super.init(style: .insetGrouped)
+        self.title = title
+        let search = UISearchController(searchResultsController: nil)
+        search.obscuresBackgroundDuringPresentation = false
+        search.searchResultsUpdater = self
+        search.searchBar.placeholder = placeholder.isEmpty ? nil : placeholder
+        self.navigationItem.searchController = search
+        self.navigationItem.hidesSearchBarWhenScrolling = false
+        self.navigationItem.rightBarButtonItem = UIBarButtonItem(barButtonSystemItem: .done, target: self, action: #selector(self.close))
+        self.observer = NotificationCenter.default.addObserver(forName: AyuPluginUI.searchResultsNotification, object: nil, queue: .main, using: { [weak self] notification in
+            guard let self, let info = notification.userInfo, info["owner"] as? String == self.owner, info["id"] as? String == self.searchId else { return }
+            self.rows = info["rows"] as? [[String: Any]] ?? []
+            self.tableView.reloadData()
+        })
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    deinit {
+        if let observer = self.observer {
+            NotificationCenter.default.removeObserver(observer)
+        }
+    }
+
+    @objc private func close() {
+        self.dismiss(animated: true)
+    }
+
+    func updateSearchResults(for searchController: UISearchController) {
+        let query = String((searchController.searchBar.text ?? "").prefix(200))
+        self.pending?.cancel()
+        // Debounced so the plugin hears one query per pause in typing.
+        let item = DispatchWorkItem { [owner = self.owner, searchId = self.searchId] in
+            AyuPluginUI.send("searchQuery", to: owner, ["id": searchId, "query": query])
+        }
+        self.pending = item
+        DispatchQueue.main.asyncAfter(deadline: .now() + 0.3, execute: item)
+    }
+
+    override func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int {
+        return self.rows.count
+    }
+
+    override func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
+        let cell = UITableViewCell(style: .subtitle, reuseIdentifier: nil)
+        let row = self.rows[indexPath.row]
+        cell.textLabel?.text = String(((row["title"] as? String) ?? "").prefix(120))
+        cell.detailTextLabel?.text = (row["subtitle"] as? String).map { String($0.prefix(300)) }
+        cell.detailTextLabel?.numberOfLines = 2
+        return cell
+    }
+
+    override func tableView(_ tableView: UITableView, didSelectRowAt indexPath: IndexPath) {
+        tableView.deselectRow(at: indexPath, animated: true)
+        let rowId = String(((self.rows[indexPath.row]["id"] as? String) ?? "").prefix(64))
+        AyuPluginUI.send("searchResult", to: self.owner, ["id": self.searchId, "rowId": rowId])
+    }
+}
