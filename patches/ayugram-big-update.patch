+
+func ayuPlayerTextSettingsController(context: AccountContext) -> ViewController {
+    return ayuDailyHost(context: context, root: AyuPlayerTextSettingsController(context: context))
+}
diff --git a/submodules/SettingsUI/Sources/AyuPluginConsoleController.swift b/submodules/SettingsUI/Sources/AyuPluginConsoleController.swift
new file mode 100644
index 00000000..8e040769
--- /dev/null
+++ b/submodules/SettingsUI/Sources/AyuPluginConsoleController.swift
@@ -0,0 +1,130 @@
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import PresentationDataUtils
+import ItemListUI
+import AccountContext
+
+// Developer → Plugin console: the newest plugin output first, copied on tap.
+
+private enum AyuPluginConsoleEntry: ItemListNodeEntry {
+    case clear(String)
+    case empty(String)
+    case line(Int64, String, String)
+
+    var section: ItemListSectionId {
+        switch self {
+        case .clear: return 0
+        case .empty, .line: return 1
+        }
+    }
+
+    var stableId: Int64 {
+        switch self {
+        case .clear: return Int64.min
+        case .empty: return Int64.min + 1
+        case let .line(id, _, _): return -id
+        }
+    }
+
+    static func < (lhs: AyuPluginConsoleEntry, rhs: AyuPluginConsoleEntry) -> Bool { return lhs.stableId < rhs.stableId }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! AyuPluginConsoleArguments
+        switch self {
+        case let .clear(title):
+            return ItemListActionItem(presentationData: presentationData, systemStyle: .glass, title: title, kind: .destructive, alignment: .natural, sectionId: self.section, style: .blocks, action: { arguments.clear() })
+        case let .empty(text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        case let .line(_, title, text):
+            return ItemListDisclosureItem(presentationData: presentationData, systemStyle: .glass, title: text, label: title, sectionId: self.section, style: .blocks, action: { arguments.copy(text) })
+        }
+    }
+}
+
+private struct AyuPluginConsoleArguments {
+    let clear: () -> Void
+    let copy: (String) -> Void
+}
+
+func ayuPluginConsoleController(context: AccountContext) -> ViewController {
+    var presentController: ((ViewController) -> Void)?
+    let arguments = AyuPluginConsoleArguments(clear: {
+        AyuPluginConsole.shared.clear()
+    }, copy: { text in
+        UIPasteboard.general.string = text
+        let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+        presentController?(textAlertController(context: context, title: nil, text: presentationData.strings.baseLanguageCode.hasPrefix("ru") ? "Скопировано" : "Copied", actions: [TextAlertAction(type: .defaultAction, title: presentationData.strings.Common_OK, action: {})]))
+    })
+    let formatter = DateFormatter()
+    formatter.dateFormat = "HH:mm:ss"
+    let signal = combineLatest(context.sharedContext.presentationData, AyuPluginConsole.shared.signal)
+    |> deliverOnMainQueue
+    |> map { presentationData, lines -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        // The memory the app uses now (plugin VMs live inside it), as the system counts it.
+        let memory = ayuMemoryFootprint().map { String(format: ru ? " · память %.0f МБ" : " · memory %.0f MB", $0) } ?? ""
+        var entries: [AyuPluginConsoleEntry] = [.clear((ru ? "Очистить" : "Clear") + memory)]
+        if lines.isEmpty {
+            entries.append(.empty(ru ? "Вывода пока нет. Включённые плагины пишут сюда print(), ошибки и срабатывания хуков." : "No output yet. Enabled plugins write print(), errors and hook activity here."))
+        }
+        for line in lines.suffix(300) {
+            let marker: String
+            switch line.level {
+            case .info: marker = ""
+            case .warning: marker = "⚠️ "
+            case .error: marker = "⛔️ "
+            }
+            entries.append(.line(line.id, "\(formatter.string(from: line.date)) \(line.pluginId)", marker + line.text))
+        }
+        let data = ItemListPresentationData(presentationData)
+        // REPL: run a line of JavaScript inside a running plugin.
+        let replButton = ItemListNavigationButton(content: .text("REPL"), style: .regular, enabled: true, action: {
+            let plugins = AyuScriptRuntime.shared.plugins.filter { $0.enabled && $0.engine == .javascript }
+            let alert = UIAlertController(title: "REPL", message: (ru ? "Код выполнится внутри плагина. Плагины: " : "The code runs inside the plugin. Plugins: ") + plugins.map { $0.id }.joined(separator: ", "), preferredStyle: .alert)
+            alert.addTextField { field in
+                field.text = plugins.first?.id
+                field.placeholder = "plugin id"
+                field.autocapitalizationType = .none
+            }
+            alert.addTextField { field in
+                field.placeholder = "ayu.device.info()"
+                field.autocapitalizationType = .none
+                field.autocorrectionType = .no
+            }
+            alert.addAction(UIAlertAction(title: ru ? "Отмена" : "Cancel", style: .cancel))
+            alert.addAction(UIAlertAction(title: ru ? "Выполнить" : "Run", style: .default, handler: { [weak alert] _ in
+                let pluginId = alert?.textFields?.first?.text ?? ""
+                let code = alert?.textFields?.last?.text ?? ""
+                AyuScriptRuntime.shared.evaluate(pluginId: pluginId, code: code, completion: { result in
+                    let answer = UIAlertController(title: "› " + String(code.prefix(60)), message: String(result.prefix(3000)), preferredStyle: .alert)
+                    answer.addAction(UIAlertAction(title: ru ? "Скопировать" : "Copy", style: .default, handler: { _ in UIPasteboard.general.string = result }))
+                    answer.addAction(UIAlertAction(title: "OK", style: .cancel))
+                    context.sharedContext.applicationBindings.presentNativeController(answer)
+                })
+            }))
+            context.sharedContext.applicationBindings.presentNativeController(alert)
+        })
+        let state = ItemListControllerState(presentationData: data, title: .text(ru ? "Консоль плагинов" : "Plugin console"), leftNavigationButton: nil, rightNavigationButton: replButton, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        return (state, (ItemListNodeState(presentationData: data, entries: entries, style: .blocks, animateChanges: false), arguments))
+    }
+    let controller = ItemListController(context: context, state: signal)
+    presentController = { [weak controller] in controller?.present($0, in: .window(.root)) }
+    return controller
+}
+
+/// Physical footprint of the process in MB (what iOS uses to decide on memory kills).
+func ayuMemoryFootprint() -> Double? {
+    var info = task_vm_info_data_t()
+    var count = mach_msg_type_number_t(MemoryLayout<task_vm_info_data_t>.size / MemoryLayout<natural_t>.size)
+    let result = withUnsafeMutablePointer(to: &info) { pointer in
+        pointer.withMemoryRebound(to: integer_t.self, capacity: Int(count)) { raw in
+            task_info(mach_task_self_, task_flavor_t(TASK_VM_INFO), raw, &count)
+        }
+    }
+    guard result == KERN_SUCCESS else { return nil }
+    return Double(info.phys_footprint) / 1_048_576.0
+}
