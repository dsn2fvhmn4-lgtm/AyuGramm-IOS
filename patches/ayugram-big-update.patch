@@ -0,0 +1,334 @@
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import AccountContext
+import AppBundle
+
+/// Launch splash, decoy mode, the cold-start code lock and the "no longer works" screen.
+final class AyuDecoyCoordinator {
+    static let shared = AyuDecoyCoordinator()
+
+    private weak var sharedContext: SharedAccountContextImpl?
+    private weak var window: UIWindow?
+    private var splashView: UIView?
+    private var lockView: AyuDecoyLockView?
+    private var fakeWindow: UIWindow?
+
+    // MARK: Launch
+
+    /// Called once the main window exists. Shows the splash, then the code lock when needed.
+    func attach(window: UIWindow, sharedContext: SharedAccountContextImpl) {
+        self.window = window
+        self.sharedContext = sharedContext
+        self.showSplash()
+        if AyuDecoyState.codeRequired && AyuDecoyState.isConfigured {
+            self.showLock()
+        } else if AyuDecoyState.isActive && AyuDecoyState.decoyAccountId == nil {
+            // A stand-in decoy that was open when the app closed without a code (not configured).
+            self.showFakeTelegram()
+        }
+    }
+
+    private func showSplash() {
+        guard let window = self.window else { return }
+        let splash = UIView(frame: window.bounds)
+        splash.autoresizingMask = [.flexibleWidth, .flexibleHeight]
+        splash.backgroundColor = UIColor.systemBackground
+        let icon = UIImageView(image: UIImage(bundleImageName: "AyuGram/OriginalDefault"))
+        icon.contentMode = .scaleAspectFit
+        icon.layer.cornerRadius = 26.0
+        icon.layer.cornerCurve = .continuous
+        icon.clipsToBounds = true
+        icon.frame = CGRect(x: 0.0, y: 0.0, width: 116.0, height: 116.0)
+        icon.center = CGPoint(x: splash.bounds.midX, y: splash.bounds.midY)
+        icon.autoresizingMask = [.flexibleLeftMargin, .flexibleRightMargin, .flexibleTopMargin, .flexibleBottomMargin]
+        icon.alpha = 0.0
+        icon.transform = CGAffineTransform(scaleX: 0.55, y: 0.55).translatedBy(x: 0.0, y: 40.0)
+        splash.addSubview(icon)
+        let title = UILabel()
+        title.text = "AyuGram"
+        title.font = UIFont.systemFont(ofSize: 22.0, weight: .semibold)
+        title.textColor = UIColor.label
+        title.sizeToFit()
+        title.center = CGPoint(x: splash.bounds.midX, y: icon.center.y + 88.0)
+        title.autoresizingMask = icon.autoresizingMask
+        title.alpha = 0.0
+        splash.addSubview(title)
+        if AyuDecoyState.isConfigured && !AyuDecoyState.codeRequired && !AyuDecoyState.isActive {
+            let doubleTap = UITapGestureRecognizer(target: self, action: #selector(self.splashDoubleTapped))
+            doubleTap.numberOfTapsRequired = 2
+            splash.addGestureRecognizer(doubleTap)
+        }
+        window.addSubview(splash)
+        self.splashView = splash
+
+        let reduceMotion = UIAccessibility.isReduceMotionEnabled
+        UIView.animate(withDuration: reduceMotion ? 0.2 : 0.55, delay: 0.05, usingSpringWithDamping: 0.72, initialSpringVelocity: 0.4, options: [.allowUserInteraction], animations: {
+            icon.alpha = 1.0
+            icon.transform = .identity
+        })
+        UIView.animate(withDuration: 0.35, delay: reduceMotion ? 0.1 : 0.3, options: [.allowUserInteraction], animations: {
+            title.alpha = 1.0
+        })
+        DispatchQueue.main.asyncAfter(deadline: .now() + (reduceMotion ? 0.6 : 1.25)) { [weak self] in
+            self?.hideSplash()
+        }
+    }
+
+    private func hideSplash(completion: (() -> Void)? = nil) {
+        guard let splash = self.splashView else {
+            completion?()
+            return
+        }
+        self.splashView = nil
+        UIView.animate(withDuration: 0.3, animations: {
+            splash.alpha = 0.0
+            splash.transform = CGAffineTransform(scaleX: 1.06, y: 1.06)
+        }, completion: { _ in
+            splash.removeFromSuperview()
+            completion?()
+        })
+    }
+
+    @objc private func splashDoubleTapped() {
+        self.enterDecoy()
+    }
+
+    // MARK: Decoy
+
+    func enterDecoy() {
+        guard AyuDecoyState.isConfigured else { return }
+        AyuDecoyState.enter()
+        AyuScriptRuntime.shared.stopAll()
+        NotificationCenter.default.post(name: AyuExtras.didChangeNotification, object: nil)
+        AyuOverlayEffects.shared.applySettings()
+        if let decoyId = AyuDecoyState.decoyAccountId, let sharedContext = self.sharedContext {
+            let _ = (sharedContext.activeAccountContexts
+            |> take(1)
+            |> deliverOnMainQueue).startStandalone(next: { [weak self] primary, accounts, _ in
+                guard let self else { return }
+                if let primary {
+                    AyuDecoyState.mainAccountId = primary.account.id.int64
+                }
+                if let decoy = accounts.first(where: { $0.0.int64 == decoyId }) {
+                    sharedContext.switchToAccount(id: decoy.0)
+                    self.hideSplash()
+                } else {
+                    self.showFakeTelegram()
+                    self.hideSplash()
+                }
+            })
+        } else {
+            self.showFakeTelegram()
+            self.hideSplash()
+        }
+    }
+
+    private func leaveDecoy() {
+        let wasStandIn = AyuDecoyState.decoyAccountId == nil
+        AyuDecoyState.leave()
+        NotificationCenter.default.post(name: AyuExtras.didChangeNotification, object: nil)
+        AyuOverlayEffects.shared.applySettings()
+        if let window = self.fakeWindow {
+            self.fakeWindow = nil
+            window.isHidden = true
+        }
+        if !wasStandIn, let mainId = AyuDecoyState.mainAccountId, let sharedContext = self.sharedContext {
+            sharedContext.switchToAccount(id: AccountRecordId(rawValue: mainId))
+        }
+    }
+
+    private func showFakeTelegram() {
+        guard self.fakeWindow == nil else { return }
+        let fake = UIWindow(frame: UIScreen.main.bounds)
+        if let scene = self.window?.windowScene {
+            fake.windowScene = scene
+        }
+        fake.windowLevel = .normal + 1.0
+        fake.rootViewController = AyuFakeTelegramController()
+        fake.makeKeyAndVisible()
+        self.fakeWindow = fake
+    }
+
+    // MARK: Code lock
+
+    private func showLock() {
+        guard let window = self.window, self.lockView == nil else { return }
+        let lock = AyuDecoyLockView(frame: window.bounds)
+        lock.autoresizingMask = [.flexibleWidth, .flexibleHeight]
+        lock.submit = { [weak self, weak lock] code in
+            guard let self, let lock else { return }
+            switch AyuDecoyState.check(code) {
+            case .real:
+                self.lockView = nil
+                self.leaveDecoy()
+                UIView.animate(withDuration: 0.25, animations: { lock.alpha = 0.0 }, completion: { _ in lock.removeFromSuperview() })
+            case .fake:
+                AyuDecoyState.markBroken()
+                lock.removeFromSuperview()
+                self.lockView = nil
+                self.showBroken()
+            case .wrong:
+                lock.shake()
+            }
+        }
+        if let splash = self.splashView {
+            window.insertSubview(lock, belowSubview: splash)
+        } else {
+            window.addSubview(lock)
+        }
+        self.lockView = lock
+        DispatchQueue.main.asyncAfter(deadline: .now() + 1.3) {
+            lock.focus()
+        }
+    }
+
+    func showBroken() {
+        guard let window = self.window else { return }
+        let broken = AyuBrokenView(frame: window.bounds)
+        broken.autoresizingMask = [.flexibleWidth, .flexibleHeight]
+        window.addSubview(broken)
+        self.fakeWindow?.isHidden = true
+        self.fakeWindow = nil
+    }
+}
+
+/// The "AyuGram no longer works" screen; it stays until the app is reinstalled.
+final class AyuBrokenView: UIView {
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+        self.backgroundColor = UIColor.systemBackground
+        let icon = UIImageView(image: UIImage(systemName: "exclamationmark.triangle.fill", withConfiguration: UIImage.SymbolConfiguration(pointSize: 54.0, weight: .regular)))
+        icon.tintColor = UIColor.systemOrange
+        let title = UILabel()
+        title.text = "Извините, AyuGram больше не работает"
+        title.font = UIFont.systemFont(ofSize: 21.0, weight: .semibold)
+        title.textAlignment = .center
+        title.numberOfLines = 0
+        let text = UILabel()
+        text.text = "Данные приложения повреждены. Чтобы исправить, полностью удалите AyuGram и установите его заново."
+        text.font = UIFont.systemFont(ofSize: 15.0)
+        text.textColor = UIColor.secondaryLabel
+        text.textAlignment = .center
+        text.numberOfLines = 0
+        let stack = UIStackView(arrangedSubviews: [icon, title, text])
+        stack.axis = .vertical
+        stack.alignment = .center
+        stack.spacing = 14.0
+        stack.translatesAutoresizingMaskIntoConstraints = false
+        self.addSubview(stack)
+        NSLayoutConstraint.activate([
+            stack.centerYAnchor.constraint(equalTo: self.centerYAnchor),
+            stack.leadingAnchor.constraint(equalTo: self.leadingAnchor, constant: 32.0),
+            stack.trailingAnchor.constraint(equalTo: self.trailingAnchor, constant: -32.0)
+        ])
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+}
+
+/// The launch-time controller form of the broken screen (used before any account is loaded).
+final class AyuBrokenController: UIViewController {
+    override func loadView() {
+        self.view = AyuBrokenView(frame: UIScreen.main.bounds)
+    }
+}
+
+/// A passcode screen in the style of Telegram's own.
+final class AyuDecoyLockView: UIView, UITextFieldDelegate {
+    var submit: ((String) -> Void)?
+    private let field = UITextField()
+    private let dots = UIStackView()
+    private let maximumLength = 12
+
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+        self.backgroundColor = UIColor.systemBackground
+        let icon = UIImageView(image: UIImage(systemName: "lock.fill", withConfiguration: UIImage.SymbolConfiguration(pointSize: 34.0, weight: .medium)))
+        icon.tintColor = UIColor.label
+        let title = UILabel()
+        title.text = "Введите код-пароль"
+        title.font = UIFont.systemFont(ofSize: 20.0, weight: .regular)
+        title.textAlignment = .center
+        self.dots.axis = .horizontal
+        self.dots.spacing = 14.0
+        self.field.keyboardType = .numberPad
+        self.field.isSecureTextEntry = true
+        self.field.delegate = self
+        self.field.alpha = 0.02
+        self.field.addTarget(self, action: #selector(self.textChanged), for: .editingChanged)
+        let done = UIButton(type: .system)
+        done.setTitle("Готово", for: .normal)
+        done.titleLabel?.font = UIFont.systemFont(ofSize: 17.0, weight: .semibold)
+        done.addTarget(self, action: #selector(self.donePressed), for: .touchUpInside)
+        let stack = UIStackView(arrangedSubviews: [icon, title, self.dots, done, self.field])
+        stack.axis = .vertical
+        stack.alignment = .center
+        stack.spacing = 22.0
+        stack.translatesAutoresizingMaskIntoConstraints = false
+        self.addSubview(stack)
+        NSLayoutConstraint.activate([
+            stack.centerXAnchor.constraint(equalTo: self.centerXAnchor),
+            stack.topAnchor.constraint(equalTo: self.safeAreaLayoutGuide.topAnchor, constant: 90.0),
+            self.field.widthAnchor.constraint(equalToConstant: 1.0)
+        ])
+        self.updateDots()
+        let tap = UITapGestureRecognizer(target: self, action: #selector(self.focus))
+        self.addGestureRecognizer(tap)
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    @objc func focus() {
+        self.field.becomeFirstResponder()
+    }
+
+    private func updateDots() {
+        for view in self.dots.arrangedSubviews {
+            view.removeFromSuperview()
+        }
+        let count = max(4, (self.field.text ?? "").count)
+        for index in 0 ..< count {
+            let dot = UIView()
+            dot.layer.cornerRadius = 6.5
+            dot.layer.borderWidth = 1.5
+            dot.layer.borderColor = UIColor.label.cgColor
+            dot.backgroundColor = index < (self.field.text ?? "").count ? UIColor.label : UIColor.clear
+            dot.translatesAutoresizingMaskIntoConstraints = false
+            dot.widthAnchor.constraint(equalToConstant: 13.0).isActive = true
+            dot.heightAnchor.constraint(equalToConstant: 13.0).isActive = true
+            self.dots.addArrangedSubview(dot)
+        }
+    }
+
+    @objc private func textChanged() {
+        self.updateDots()
+    }
+
+    @objc private func donePressed() {
+        let code = self.field.text ?? ""
+        guard !code.isEmpty else { return }
+        self.submit?(code)
+    }
+
+    func textField(_ textField: UITextField, shouldChangeCharactersIn range: NSRange, replacementString string: String) -> Bool {
+        let current = textField.text ?? ""
+        return current.count - range.length + string.count <= self.maximumLength
+    }
+
+    func shake() {
+        self.field.text = ""
+        self.updateDots()
+        UINotificationFeedbackGenerator().notificationOccurred(.error)
+        let animation = CAKeyframeAnimation(keyPath: "transform.translation.x")
+        animation.values = [0.0, -16.0, 16.0, -10.0, 10.0, -4.0, 0.0]
+        animation.duration = 0.4
+        self.dots.layer.add(animation, forKey: "shake")
+    }
+}
