+
+/// AyuGram "Watermark on photos" (Settings → Media & Calls → Video messages & camera); the
+/// settings live in Display, which this module cannot import, so the keys are read directly.
+private func ayuWatermarked(_ image: UIImage) -> UIImage {
+    let defaults = UserDefaults.standard
+    let text = defaults.string(forKey: "ayu.media.watermarkText") ?? ""
+    guard defaults.bool(forKey: "ayu.media.watermark"), !text.isEmpty, !defaults.bool(forKey: "ayu.decoy.active") else { return image }
+    let size = image.size
+    let fontSize = max(12.0, min(size.width, size.height) * 0.035)
+    let attributes: [NSAttributedString.Key: Any] = [
+        .font: UIFont.systemFont(ofSize: fontSize, weight: .semibold),
+        .foregroundColor: UIColor.white.withAlphaComponent(0.85),
+        .strokeColor: UIColor.black.withAlphaComponent(0.35),
+        .strokeWidth: -2.0
+    ]
+    let textSize = (text as NSString).size(withAttributes: attributes)
+    let format = UIGraphicsImageRendererFormat()
+    format.scale = image.scale
+    return UIGraphicsImageRenderer(size: size, format: format).image { _ in
+        image.draw(in: CGRect(origin: .zero, size: size))
+        (text as NSString).draw(at: CGPoint(x: size.width - textSize.width - fontSize, y: size.height - textSize.height - fontSize * 0.8), withAttributes: attributes)
+    }
+}
