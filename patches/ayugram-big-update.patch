diff --git a/submodules/Display/Source/AyuExtras.swift b/submodules/Display/Source/AyuExtras.swift
new file mode 100644
index 00000000..683e0043
--- /dev/null
+++ b/submodules/Display/Source/AyuExtras.swift
@@ -0,0 +1,197 @@
+import Foundation
+import UIKit
+import ImageIO
+import UniformTypeIdentifiers
+
+/// Settings → AyuGram → Privacy & extras. Local switches, all off by default, stored in
+/// UserDefaults under "ayu.extra.*" (TelegramCore reads `cleanLinks` by the same key).
+public enum AyuExtras {
+    public static let didChangeNotification = Notification.Name("AyuGram.ExtrasChanged")
+
+    public enum Key: String, CaseIterable {
+        /// Photos sent as files lose their real metadata (GPS, camera, dates) and get fake values.
+        case spoofPhotoMetadata
+        /// Files from the gallery are sent under a random name instead of IMG_1234.HEIC.
+        case randomFileNames
+        /// The app switcher shows a blurred snapshot.
+        case blurInAppSwitcher
+        /// No vibration feedback anywhere in the app.
+        case disableHaptics
+        /// Calls start only after a confirmation.
+        case confirmCalls
+        /// The screen stays on while the music player is open.
+        case keepScreenOnInPlayer
+        /// The music player opens with the lyrics shown.
+        case autoOpenLyrics
+        /// The music player keeps the last playback speed.
+        case rememberPlaybackSpeed
+        /// utm_*, fbclid, gclid, si and similar are removed from links you send.
+        case cleanLinks
+        /// The message history keeps no deleted copies of the account's own messages.
+        case skipOwnDeleted
+        /// The message history keeps no originals of the account's own edited messages.
+        case skipOwnEdited
+        /// A ban keeps the chat open, with its title, photo and downloaded history.
+        case stayAfterBan
+        /// The other person's replies to your messages are faded.
+        case dimRepliesToMe
+        /// View-once photos and videos are saved to Photos when opened.
+        case saveViewOnce
+        /// Chat scrolling glides longer and settles softly.
+        case springScroll
+        /// A notification when someone deletes a message (the history must be saving deletions).
+        case notifyDeleted
+        /// No warnings for punycode or mixed-alphabet links.
+        case antiScamOff
+        /// Reacting to a message marks the chat read (ghost mode's read-after-send for reactions).
+        case readAfterReaction
+        /// A 🌐 button above the keyboard translates the draft before it is sent.
+        case translateBeforeSend
+        /// Each account keeps its own theme accent colour.
+        case accentPerAccount
+        /// Installed catalog plugins update themselves at launch.
+        case pluginAutoUpdate
+        /// The music player's track on the Lock Screen and in the Dynamic Island.
+        case nowPlayingLiveActivity
+        /// A message typed entirely in capitals is sent in normal case.
+        case antiCaps
+        /// A plain reply quotes the start of the replied message.
+        case replyWithQuote
+        case alwaysOnline
+        case warnBeforeStories
+        /// The AyuGram team badge is not shown in chats (still in the profile).
+        case hideAyuBadges
+        /// Screenshots and screen recordings of AyuGram show an empty screen.
+        case blockScreenshots
+        /// An accounts button in the chat list for quick switching.
+        case accountsButton
+        /// Retain local conversations after a confirmed remote logout; never restores authorization.
+        case keepUnavailableAccounts
+        /// Channel posts marked as paid ads (erid, «реклама», INN…) are not shown.
+        case hidePaidAds
+        /// Reaction buttons without the glow.
+        case noReactionGlow
+        /// AyuGram settings open only after Face ID / Touch ID or the device passcode.
+        case lockAyuSettings
+        /// A voice or video message stops at its end instead of playing the next one.
+        case noAutoplayNextVoice
+    }
+
+    public static func isOn(_ key: Key) -> Bool {
+        return !AyuDecoyMode.isActive && UserDefaults.standard.bool(forKey: "ayu.extra." + key.rawValue)
+    }
+
+    public static func set(_ key: Key, _ value: Bool) {
+        UserDefaults.standard.set(value, forKey: "ayu.extra." + key.rawValue)
+        if key == .disableHaptics {
+            AyuExtras.hapticsDisabled = value
+        }
+        NotificationCenter.default.post(name: didChangeNotification, object: nil)
+    }
+
+    /// Read on every haptic, so cached.
+    public private(set) static var hapticsDisabled: Bool = UserDefaults.standard.bool(forKey: "ayu.extra." + Key.disableHaptics.rawValue)
+
+    public static var playbackSpeed: Double {
+        get {
+            let value = UserDefaults.standard.double(forKey: "ayu.extra.playbackSpeed")
+            return value > 0.0 ? value : 1.0
+        }
+        set { UserDefaults.standard.set(newValue, forKey: "ayu.extra.playbackSpeed") }
+    }
+
+    // MARK: File names
+
+    /// `IMG_4821.HEIC` → `a8f3k2q9.heic` when random names are on.
+    public static func outgoingFileName(_ name: String) -> String {
+        guard AyuExtras.isOn(.randomFileNames) else { return name }
+        let ext = (name as NSString).pathExtension.lowercased()
+        let letters = Array("abcdefghijklmnopqrstuvwxyz0123456789")
+        let stem = String((0 ..< 10).map { _ in letters.randomElement()! })
+        return ext.isEmpty ? stem : stem + "." + ext
+    }
+
+    // MARK: Photo metadata
+
+    /// Re-encodes an image with only fake metadata: no GPS, no real camera, lens, serial
+    /// numbers, software or dates; orientation is kept so the photo looks the same.
+    /// Returns nil for data that is not an image, so the caller sends the original.
+    public static func spoofedImageData(_ data: Data) -> Data? {
+        guard let source = CGImageSourceCreateWithData(data as CFData, nil), let type = CGImageSourceGetType(source), CGImageSourceGetCount(source) > 0 else {
+            return nil
+        }
+        if let utType = UTType(type as String), !utType.conforms(to: .image) || utType.conforms(to: .gif) {
+            return nil
+        }
+        guard let image = CGImageSourceCreateImageAtIndex(source, 0, nil) else {
+            return nil
+        }
+        let original = CGImageSourceCopyPropertiesAtIndex(source, 0, nil) as? [CFString: Any]
+        let output = NSMutableData()
+        guard let destination = CGImageDestinationCreateWithData(output as CFMutableData, type, 1, nil) else {
+            return nil
+        }
+        let fake = AyuExtras.fakeCamera()
+        var properties: [CFString: Any] = [
+            kCGImageDestinationLossyCompressionQuality: 0.95,
+            kCGImagePropertyTIFFDictionary: [
+                kCGImagePropertyTIFFMake: fake.make,
+                kCGImagePropertyTIFFModel: fake.model,
+                kCGImagePropertyTIFFSoftware: "Shish s maslom 1.0",
+                kCGImagePropertyTIFFDateTime: fake.date
+            ] as [CFString: Any],
+            kCGImagePropertyExifDictionary: [
+                kCGImagePropertyExifDateTimeOriginal: fake.date,
+                kCGImagePropertyExifDateTimeDigitized: fake.date,
+                kCGImagePropertyExifLensModel: fake.lens,
+                kCGImagePropertyExifUserComment: "Shish s maslom"
+            ] as [CFString: Any]
+        ]
+        if let orientation = original?[kCGImagePropertyOrientation] {
+            properties[kCGImagePropertyOrientation] = orientation
+        }
+        CGImageDestinationAddImage(destination, image, properties as CFDictionary)
+        guard CGImageDestinationFinalize(destination) else {
+            return nil
+        }
+        return output as Data
+    }
+
+    private static func fakeCamera() -> (make: String, model: String, lens: String, date: String) {
+        let cameras: [(String, String, String)] = [
+            ("Nokia", "3310", "Nokia 3310 front camera"),
+            ("Kodak", "EasyShare C143", "Kodak 36-108mm"),
+            ("Sony Ericsson", "K750i", "Sony Ericsson 2MP"),
+            ("Canon", "PowerShot A520", "Canon 5.8-23.2mm"),
+            ("Siemens", "C65", "Siemens VGA")
+        ]
+        let camera = cameras.randomElement()!
+        let year = Int.random(in: 2004 ... 2012)
+        let date = String(format: "%04d:%02d:%02d %02d:%02d:%02d", year, Int.random(in: 1 ... 12), Int.random(in: 1 ... 28), Int.random(in: 0 ... 23), Int.random(in: 0 ... 59), Int.random(in: 0 ... 59))
+        return (camera.0, camera.1, camera.2, date)
+    }
+}
+
+/// "Hide paid ads in posts": Russian ad-marking rules make sponsored posts carry these markers.
+public enum AyuPaidAds {
+    private static let results: NSCache<NSString, NSNumber> = {
+        let cache = NSCache<NSString, NSNumber>()
+        cache.countLimit = 4096
+        return cache
+    }()
+
+    public static func isAd(_ text: String, messageKey: String, version: UInt32) -> Bool {
+        // Include the text hash: the same cloud message can have different cached versions per account.
+        let key = "\(messageKey):\(version):\(text.hashValue)" as NSString
+        if let value = results.object(forKey: key) { return value.boolValue }
+        let value = isAd(text)
+        results.setObject(NSNumber(value: value), forKey: key)
+        return value
+    }
+    private static let pattern = try? NSRegularExpression(pattern: "(\\berid\\b|#реклама|\\bреклама\\b|на правах рекламы|\\bинн\\s*[:№]?\\s*\\d{10,12}|\\bооо\\s+[«\"]|\\bогрн|рекламодатель|#ad\\b|#sponsored|\\bsponsored\\b)", options: [.caseInsensitive])
+
+    public static func isAd(_ text: String) -> Bool {
+        guard !text.isEmpty, let pattern else { return false }
+        return pattern.firstMatch(in: text, options: [], range: NSRange(location: 0, length: (text as NSString).length)) != nil
+    }
+}
diff --git a/submodules/Display/Source/AyuFontCatalog.swift b/submodules/Display/Source/AyuFontCatalog.swift
new file mode 100644
index 00000000..6326e07b
--- /dev/null
+++ b/submodules/Display/Source/AyuFontCatalog.swift
@@ -0,0 +1,93 @@
+import Foundation
+import CryptoKit
+
+/// Fonts published in github.com/murk-sus/AyuGramm-Plugins (fonts/index.json), installed with
+/// the same import as a .ttf/.otf picked by hand. Every download must match its SHA-256.
+public final class AyuFontCatalog {
+    public struct Entry: Codable, Equatable {
+        public let id: String
+        public let name: String
+        public let author: String
+        public let description: String?
+        public let url: String
+        public let sha256: String
+        public let size: Int?
+    }
+
+    public enum Failure: LocalizedError {
+        case network
+        case invalidCatalog
+        case checksumMismatch
+        case notAFont
+
+        public var errorDescription: String? {
+            let ru = Locale.preferredLanguages.first?.hasPrefix("ru") == true
+            switch self {
+            case .network: return ru ? "Каталог шрифтов недоступен. Проверьте подключение." : "The font catalog is unreachable. Check the connection."
+            case .invalidCatalog: return ru ? "Каталог шрифтов повреждён." : "The font catalog is damaged."
+            case .checksumMismatch: return ru ? "Файл шрифта не совпадает с каталогом (SHA-256)." : "The font file does not match the catalog (SHA-256)."
+            case .notAFont: return ru ? "Файл не является шрифтом .ttf или .otf." : "The file is not a .ttf or .otf font."
+            }
+        }
+    }
+
+    public static let shared = AyuFontCatalog()
+    public static let indexURL = "https://raw.githubusercontent.com/murk-sus/AyuGramm-Plugins/main/fonts/index.json"
+
+    private let session: URLSession = {
+        let configuration = URLSessionConfiguration.ephemeral
+        configuration.timeoutIntervalForRequest = 30.0
+        configuration.requestCachePolicy = .reloadIgnoringLocalCacheData
+        return URLSession(configuration: configuration)
+    }()
+
+    private init() {}
+
+    private func fetch(_ url: URL, limit: Int, completion: @escaping (Data?) -> Void) {
+        guard url.scheme?.lowercased() == "https" else {
+            DispatchQueue.main.async { completion(nil) }
+            return
+        }
+        self.session.dataTask(with: url, completionHandler: { data, response, _ in
+            let ok = (response as? HTTPURLResponse)?.statusCode == 200 && (data?.count ?? 0) <= limit
+            DispatchQueue.main.async { completion(ok ? data : nil) }
+        }).resume()
+    }
+
+    public func load(completion: @escaping (Result<[Entry], Failure>) -> Void) {
+        guard let url = URL(string: AyuFontCatalog.indexURL) else { return completion(.failure(.invalidCatalog)) }
+        self.fetch(url, limit: 1024 * 1024, completion: { data in
+            guard let data else { return completion(.failure(.network)) }
+            struct Index: Codable { let format: String; let fonts: [Entry] }
+            guard let index = try? JSONDecoder().decode(Index.self, from: data), index.format == "ayugram-font-catalog" else {
+                return completion(.failure(.invalidCatalog))
+            }
+            completion(.success(index.fonts.filter { $0.sha256.count == 64 && URL(string: $0.url)?.scheme?.lowercased() == "https" }))
+        })
+    }
+
+    /// Downloads, checks and installs a font, then makes it the app font. Returns its names.
+    public func install(_ entry: Entry, completion: @escaping (Result<[String], Error>) -> Void) {
+        guard let url = URL(string: entry.url) else { return completion(.failure(Failure.invalidCatalog)) }
+        self.fetch(url, limit: 15 * 1024 * 1024, completion: { data in
+            guard let data else { return completion(.failure(Failure.network)) }
+            let digest = SHA256.hash(data: data).map { String(format: "%02x", $0) }.joined()
+            guard digest == entry.sha256.lowercased() else { return completion(.failure(Failure.checksumMismatch)) }
+            let ext = url.pathExtension.lowercased()
+            guard ["ttf", "otf"].contains(ext) else { return completion(.failure(Failure.notAFont)) }
+            let file = FileManager.default.temporaryDirectory.appendingPathComponent(entry.id + "." + ext)
+            do {
+                try data.write(to: file, options: .atomic)
+                let names = try AyuWhiteGram.importFont(from: file)
+                try? FileManager.default.removeItem(at: file)
+                if let first = names.first {
+                    AyuWhiteGram.set(first, forKey: "customFontName")
+                    AyuWhiteGram.set(true, forKey: "customFontEnabled")
+                }
+                completion(.success(names))
+            } catch {
+                completion(.failure(error))
+            }
+        })
+    }
+}
diff --git a/submodules/Display/Source/AyuGlass.swift b/submodules/Display/Source/AyuGlass.swift
new file mode 100644
index 00000000..a8cfe4dc
--- /dev/null
+++ b/submodules/Display/Source/AyuGlass.swift
@@ -0,0 +1,108 @@
+import Foundation
+import UIKit
+
+/// Glass looks for chat content (Settings → AyuGram → Glass): message bubbles, inline buttons,
+/// an outline around bubbles. Chats pick the values up when they are next laid out.
+public enum AyuGlass {
+    public enum BubbleStyle: String, CaseIterable {
+        case none
+        /// Liquid Glass on iOS 26+, a thin material before.
+        case glass
+        /// A vivid frosted surface with a cold tint.
+        case cold
+        /// The wallpaper is blurred behind the bubble; the bubble colour stays.
+        case blur
+
+        public func title(_ russian: Bool) -> String {
+            switch self {
+            case .none: return russian ? "Обычные" : "Regular"
+            case .glass: return russian ? "Стеклянные" : "Glass"
+            case .cold: return russian ? "Холодное стекло" : "Cold glass"
+            case .blur: return russian ? "Размытие фона" : "Background blur"
+            }
+        }
+    }
+
+    public static let didChangeNotification = Notification.Name("AyuGram.GlassChanged")
+
+    private static let key = "ayu.glass."
+
+    /// Decoy mode, or the classic design: no Liquid Glass anywhere.
+    private static var off: Bool {
+        return AyuDecoyMode.isActive || AyuAppearancePlus.launchClassicDesign
+    }
+
+    public static var bubbleStyle: BubbleStyle {
+        get { return off ? .none : (BubbleStyle(rawValue: UserDefaults.standard.string(forKey: key + "bubble") ?? "") ?? .none) }
+        set { set(newValue.rawValue, "bubble") }
+    }
+
+    /// The bubble colour shows through the glass instead of fully clear glass.
+    public static var tinted: Bool {
+        get { return UserDefaults.standard.bool(forKey: key + "tinted") }
+        set { set(newValue, "tinted") }
+    }
+
+    /// A thin line around every bubble.
+    public static var outline: Bool {
+        get { return !AyuDecoyMode.isActive && UserDefaults.standard.bool(forKey: key + "outline") }
+        set { set(newValue, "outline") }
+    }
+
+    /// Inline buttons under messages drawn as glass.
+    public static var buttons: Bool {
+        get { return !off && UserDefaults.standard.bool(forKey: key + "buttons") }
+        set { set(newValue, "buttons") }
+    }
+
+    /// Settings and profile sections drawn as glass instead of solid panels.
+    public static var lists: Bool {
+        get { return !off && UserDefaults.standard.bool(forKey: key + "lists") }
+        set { set(newValue, "lists") }
+    }
+
+    /// Profile gifts drawn on glass backgrounds.
+    public static var gifts: Bool {
+        get { return !off && UserDefaults.standard.bool(forKey: key + "gifts") }
+        set { set(newValue, "gifts") }
+    }
+
+    /// How opaque the bubble fill stays under the chosen style.
+    public static var bubbleFillAlpha: CGFloat {
+        switch AyuGlass.bubbleStyle {
+        case .none: return 1.0
+        case .glass, .cold: return AyuGlass.tinted ? 0.4 : 0.12
+        case .blur: return 0.72
+        }
+    }
+
+    /// The effect a bubble draws under its fill, or nil for none.
+    public static func makeBubbleEffect() -> UIVisualEffect? {
+        switch AyuGlass.bubbleStyle {
+        case .none:
+            return nil
+        case .glass:
+            if #available(iOS 26.0, *) {
+                return UIGlassEffect(style: .regular)
+            }
+            return UIBlurEffect(style: .systemThinMaterial)
+        case .cold:
+            return UIBlurEffect(style: .systemUltraThinMaterial)
+        case .blur:
+            return UIBlurEffect(style: .regular)
+        }
+    }
+
+    /// A colour laid over the effect (the cold tint), or nil.
+    public static var bubbleOverlayColor: UIColor? {
+        switch AyuGlass.bubbleStyle {
+        case .cold: return UIColor(red: 0.55, green: 0.8, blue: 1.0, alpha: 0.22)
+        default: return nil
+        }
+    }
+
+    private static func set(_ value: Any, _ name: String) {
+        UserDefaults.standard.set(value, forKey: key + name)
+        NotificationCenter.default.post(name: didChangeNotification, object: nil)
+    }
+}
