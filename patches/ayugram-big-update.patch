+        sheet.addAction(UIAlertAction(title: ru ? "🕵️ Максимум приватности" : "🕵️ Maximum privacy", style: .default, handler: { _ in apply(0) }))
+        sheet.addAction(UIAlertAction(title: ru ? "🖥 Как AyuGram Desktop" : "🖥 Like AyuGram Desktop", style: .default, handler: { _ in apply(1) }))
+        sheet.addAction(UIAlertAction(title: ru ? "🧘 Минимализм" : "🧘 Minimalism", style: .default, handler: { _ in apply(2) }))
+        sheet.addAction(UIAlertAction(title: ru ? "Пропустить" : "Skip", style: .cancel))
