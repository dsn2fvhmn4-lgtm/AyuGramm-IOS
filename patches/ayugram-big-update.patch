+static bool os_getcwd(int argc, py_Ref argv) {
+    char buf[1024];
+    if(!platform_getcwd(buf, sizeof(buf))) return OSError("getcwd() failed");
+    py_newstr(py_retval(), buf);
+    return true;
+}
