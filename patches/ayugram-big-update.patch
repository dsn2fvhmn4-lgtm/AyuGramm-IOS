@@ -0,0 +1,48 @@
+import Foundation
+
+/// Settings → AyuGram → Extras → Chat list swipes: hide swipe actions and swap the two sides.
+public enum AyuChatListSwipes {
+    public enum Action: String, CaseIterable {
+        case pin
+        case mute
+        case read
+        case archive
+        case delete
+
+        public func title(_ russian: Bool) -> String {
+            switch self {
+            case .pin: return russian ? "Закрепить" : "Pin"
+            case .mute: return russian ? "Без звука" : "Mute"
+            case .read: return russian ? "Прочитано / непрочитано" : "Read / unread"
+            case .archive: return russian ? "Архив" : "Archive"
+            case .delete: return russian ? "Удалить" : "Delete"
+            }
+        }
+    }
+
+    private static let hiddenKey = "ayu.swipes.hidden"
+    private static let swapKey = "ayu.swipes.swap"
+
+    public static func isHidden(_ action: Action) -> Bool {
+        guard !AyuDecoyMode.isActive else { return false }
+        return (UserDefaults.standard.stringArray(forKey: hiddenKey) ?? []).contains(action.rawValue)
+    }
+
+    public static func setHidden(_ action: Action, _ value: Bool) {
+        var list = UserDefaults.standard.stringArray(forKey: hiddenKey) ?? []
+        list.removeAll(where: { $0 == action.rawValue })
+        if value {
+            list.append(action.rawValue)
+        }
+        UserDefaults.standard.set(list, forKey: hiddenKey)
+    }
+
+    public static var swapSides: Bool {
+        get { return !AyuDecoyMode.isActive && UserDefaults.standard.bool(forKey: swapKey) }
+        set { UserDefaults.standard.set(newValue, forKey: swapKey) }
+    }
+
+    public static var isCustomized: Bool {
+        return swapSides || Action.allCases.contains(where: { isHidden($0) })
+    }
+}
