+++ b/submodules/TelegramUI/Sources/AyuToast.swift
@@ -0,0 +1,58 @@
+import Foundation
+import UIKit
+
+/// Minimal non-interactive toast for host messages (plugin `ayu.toast`, runtime notices).
+/// One at a time; a new message replaces the visible one.
+final class AyuToast {
+    static let shared = AyuToast()
+
+    private weak var container: UIView?
+    private weak var current: UIView?
+
+    private init() {}
+
+    func attach(to container: UIView) {
+        self.container = container
+    }
+
+    func show(_ text: String) {
+        guard let container = self.container, !text.isEmpty else { return }
+        self.current?.removeFromSuperview()
+
+        let label = UILabel()
+        label.text = text
+        label.numberOfLines = 3
+        label.textAlignment = .center
+        label.font = .systemFont(ofSize: 14.0, weight: .medium)
+        label.textColor = .white
+
+        let view = UIView()
+        view.isUserInteractionEnabled = false
+        view.backgroundColor = UIColor(white: 0.1, alpha: 0.88)
+        view.layer.cornerRadius = 14.0
+        view.addSubview(label)
+
+        let maxWidth = min(360.0, container.bounds.width - 40.0)
+        let size = label.sizeThatFits(CGSize(width: maxWidth - 28.0, height: .greatestFiniteMagnitude))
+        let width = min(maxWidth, ceil(size.width) + 28.0)
+        let height = ceil(size.height) + 20.0
+        let top = max(container.safeAreaInsets.top, 20.0) + 8.0
+        view.frame = CGRect(x: floor((container.bounds.width - width) / 2.0), y: top, width: width, height: height)
+        label.frame = view.bounds.insetBy(dx: 14.0, dy: 10.0)
+        view.autoresizingMask = [.flexibleLeftMargin, .flexibleRightMargin, .flexibleBottomMargin]
+        container.addSubview(view)
+        self.current = view
+
+        view.alpha = 0.0
+        view.transform = CGAffineTransform(translationX: 0.0, y: -12.0)
+        UIView.animate(withDuration: 0.25, delay: 0.0, usingSpringWithDamping: 0.85, initialSpringVelocity: 0.0, options: [.beginFromCurrentState], animations: {
+            view.alpha = 1.0
+            view.transform = .identity
+        })
+        UIView.animate(withDuration: 0.25, delay: 2.6, options: [.beginFromCurrentState], animations: {
+            view.alpha = 0.0
+        }, completion: { [weak view] _ in
+            view?.removeFromSuperview()
+        })
+    }
+}
diff --git a/submodules/TelegramUI/Sources/AyuTrackRecognizer.swift b/submodules/TelegramUI/Sources/AyuTrackRecognizer.swift
new file mode 100644
index 00000000..2ca4e2f8
--- /dev/null
+++ b/submodules/TelegramUI/Sources/AyuTrackRecognizer.swift
@@ -0,0 +1,265 @@
+import Foundation
+import AVFoundation
+import ShazamKit
+
+/// Identifies the playing track from the file itself when Telegram's audio attributes are
+/// missing or useless: first the embedded ID3/iTunes tags, then (on request) Shazam.
+/// Results are remembered per file so the player and lyrics use them from then on.
+enum AyuTrackRecognizer {
+    struct Identity: Codable, Equatable {
+        var title: String
+        var artist: String?
+        var source: String
+    }
+
+    enum Failure: Error {
+        case unreadableAudio
+        case noMatch
+        case unavailable(String)
+    }
+
+    // MARK: Remembered results
+
+    private static func overrideKey(fileId: Int64) -> String {
+        return "ayu.music.identity.\(fileId)"
+    }
+
+    static func remembered(fileId: Int64) -> Identity? {
+        guard let data = UserDefaults.standard.data(forKey: self.overrideKey(fileId: fileId)) else { return nil }
+        return try? JSONDecoder().decode(Identity.self, from: data)
+    }
+
+    static func remember(_ identity: Identity?, fileId: Int64) {
+        if let identity, let data = try? JSONEncoder().encode(identity) {
+            UserDefaults.standard.set(data, forKey: self.overrideKey(fileId: fileId))
+        } else {
+            UserDefaults.standard.removeObject(forKey: self.overrideKey(fileId: fileId))
+        }
+    }
+
+    // MARK: File access
+
+    /// Telegram's cache files have no extension, which AVFoundation needs to pick a parser.
+    private static func playableURL(path: String, mimeType: String?, fileName: String?) -> URL? {
+        var ext = (fileName.map { ($0 as NSString).pathExtension.lowercased() }) ?? ""
+        if ext.isEmpty {
+            switch (mimeType ?? "").lowercased() {
+            case "audio/mpeg", "audio/mp3": ext = "mp3"
+            case "audio/mp4", "audio/x-m4a", "audio/m4a", "audio/aac": ext = "m4a"
+            case "audio/flac", "audio/x-flac": ext = "flac"
+            case "audio/wav", "audio/x-wav", "audio/wave": ext = "wav"
+            case "audio/aiff", "audio/x-aiff": ext = "aiff"
+            default: ext = "mp3"
+            }
+        }
+        let directory = FileManager.default.temporaryDirectory.appendingPathComponent("ayu-recognition", isDirectory: true)
+        try? FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        let target = directory.appendingPathComponent(String(abs(path.hashValue)) + "." + ext)
+        if !FileManager.default.fileExists(atPath: target.path) {
+            do {
+                try FileManager.default.linkItem(atPath: path, toPath: target.path)
+            } catch {
+                do { try FileManager.default.copyItem(atPath: path, toPath: target.path) } catch { return nil }
+            }
+        }
+        return target
+    }
+
+    // MARK: Embedded tags
+
+    static func embeddedTags(path: String, mimeType: String?, fileName: String?, completion: @escaping (Identity?) -> Void) {
+        guard let url = self.playableURL(path: path, mimeType: mimeType, fileName: fileName) else {
+            completion(nil)
+            return
+        }
+        Task {
+            let asset = AVURLAsset(url: url)
+            var title: String?
+            var artist: String?
+            if let items = try? await asset.load(.commonMetadata) {
+                for item in AVMetadataItem.metadataItems(from: items, filteredByIdentifier: .commonIdentifierTitle) {
+                    if let value = try? await item.load(.stringValue), !value.isEmpty { title = value; break }
+                }
+                for item in AVMetadataItem.metadataItems(from: items, filteredByIdentifier: .commonIdentifierArtist) {
+                    if let value = try? await item.load(.stringValue), !value.isEmpty { artist = value; break }
+                }
+            }
+            let identity: Identity?
+            if let title = title?.trimmingCharacters(in: .whitespacesAndNewlines), !title.isEmpty {
+                let cleaned = AyuMusicMetadata.track(title: title, artist: artist, filename: nil)
+                identity = Identity(title: cleaned.title, artist: cleaned.artist, source: "tags")
+            } else {
+                identity = nil
+            }
+            DispatchQueue.main.async {
+                completion(identity)
+            }
+        }
+    }
+
+    // MARK: Vocal activity
+
+    /// Per-50 ms vocal-activity envelope of the whole track, computed on the device: energy
+    /// in the voice band (two-pole band-pass around 300–3400 Hz) relative to the full band,
+    /// log-compressed and smoothed. Feeds AyuLyricsAligner for plain-text lyrics.
+    static func vocalEnvelope(path: String, mimeType: String?, fileName: String?, completion: @escaping ([Float]?) -> Void) {
+        guard let url = self.playableURL(path: path, mimeType: mimeType, fileName: fileName) else {
+            completion(nil)
+            return
+        }
+        DispatchQueue.global(qos: .utility).async {
+            let envelope = try? self.envelope(url: url)
+            DispatchQueue.main.async { completion(envelope) }
+        }
+    }
+
+    static let envelopeFrameDuration = 0.05
+
+    private static func envelope(url: URL) throws -> [Float] {
+        let file = try AVAudioFile(forReading: url)
+        let format = file.processingFormat
+        let rate = format.sampleRate
+        guard rate > 0.0, file.length > 0, file.length < AVAudioFramePosition(rate * 60.0 * 20.0) else { throw Failure.unreadableAudio }
+        let frameSamples = AVAudioFrameCount(rate * self.envelopeFrameDuration)
+        guard let buffer = AVAudioPCMBuffer(pcmFormat: format, frameCapacity: frameSamples * 40) else { throw Failure.unreadableAudio }
+
+        // RBJ band-pass, centre ≈ 1 kHz, wide Q to cover 300–3400 Hz.
+        let centre = 1000.0, q = 0.35
+        let w0 = 2.0 * Double.pi * centre / rate
+        let alpha = sin(w0) / (2.0 * q)
+        let a0 = 1.0 + alpha
+        let b0 = Float(alpha / a0), b2 = Float(-alpha / a0)
+        let a1 = Float(-2.0 * cos(w0) / a0), a2 = Float((1.0 - alpha) / a0)
+        var x1: Float = 0.0, x2: Float = 0.0, y1: Float = 0.0, y2: Float = 0.0
+
+        var envelope: [Float] = []
+        var bandEnergy: Float = 0.0, fullEnergy: Float = 0.0, counted: AVAudioFrameCount = 0
+        while file.framePosition < file.length {
+            try file.read(into: buffer, frameCount: min(buffer.frameCapacity, AVAudioFrameCount(file.length - file.framePosition)))
+            guard let channels = buffer.floatChannelData, buffer.frameLength > 0 else { break }
+            let channelCount = Int(format.channelCount)
+            for index in 0 ..< Int(buffer.frameLength) {
+                var sample: Float = 0.0
+                for channel in 0 ..< channelCount { sample += channels[channel][index] }
+                sample /= Float(max(1, channelCount))
+                let filtered = b0 * sample + b2 * x2 - a1 * y1 - a2 * y2
+                x2 = x1; x1 = sample; y2 = y1; y1 = filtered
+                bandEnergy += filtered * filtered
+                fullEnergy += sample * sample
+                counted += 1
+                if counted == frameSamples {
+                    let n = Float(frameSamples)
+                    let band = bandEnergy / n, full = fullEnergy / n
+                    // Loud and voice-heavy frames score high; silence and pure bass score low.
+                    let ratio = full > 1e-9 ? band / full : 0.0
+                    envelope.append(log10(1.0 + 1000.0 * band) * (0.5 + ratio))
+                    bandEnergy = 0.0; fullEnergy = 0.0; counted = 0
+                }
+            }
+        }
+        // 5-frame moving average smooths consonants and drum hits.
+        guard envelope.count > 5 else { return envelope }
+        var smoothed = envelope
+        for index in 2 ..< envelope.count - 2 {
+            smoothed[index] = (envelope[index - 2] + envelope[index - 1] + envelope[index] + envelope[index + 1] + envelope[index + 2]) / 5.0
+        }
+        return smoothed
+    }
+
+    // MARK: Shazam
+
+    private final class MatchDelegate: NSObject, SHSessionDelegate {
+        var completion: ((Result<Identity, Failure>) -> Void)?
+        let session = SHSession()
+
+        override init() {
+            super.init()
+            self.session.delegate = self
+        }
+
+        func session(_ session: SHSession, didFind match: SHMatch) {
+            let item = match.mediaItems.first
+            if let title = item?.title, !title.isEmpty {
+                self.deliver(.success(Identity(title: title, artist: item?.artist, source: "Shazam")))
+            } else {
+                self.deliver(.failure(.noMatch))
+            }
+        }
+
+        func session(_ session: SHSession, didNotFindMatchFor signature: SHSignature, error: Error?) {
+            // No error means the catalog simply has no match. An error (typically
+            // matchAttemptFailed) usually means this build's bundle ID is not registered for ShazamKit.
+            if let error {
+                self.deliver(.failure(.unavailable(error.localizedDescription)))
+            } else {
+                self.deliver(.failure(.noMatch))
+            }
+        }
+
+        private func deliver(_ result: Result<Identity, Failure>) {
+            let completion = self.completion
+            self.completion = nil
+            DispatchQueue.main.async {
+                completion?(result)
+                AyuTrackRecognizer.activeMatch = nil
+            }
+        }
+    }
+
+    /// Kept alive until the session answers.
+    private static var activeMatch: MatchDelegate?
+
+    static func shazam(path: String, mimeType: String?, fileName: String?, duration: Double, completion: @escaping (Result<Identity, Failure>) -> Void) {
+        guard let url = self.playableURL(path: path, mimeType: mimeType, fileName: fileName) else {
+            completion(.failure(.unreadableAudio))
+            return
+        }
+        DispatchQueue.global(qos: .userInitiated).async {
+            let signature: SHSignature
+            do {
+                signature = try self.signature(url: url, duration: duration)
+            } catch {
+                DispatchQueue.main.async { completion(.failure(.unreadableAudio)) }
+                return
+            }
+            DispatchQueue.main.async {
+                let delegate = MatchDelegate()
+                delegate.completion = completion
+                self.activeMatch = delegate
+                delegate.session.match(signature)
+            }
+        }
+    }
+
+    /// About 12 seconds from roughly a third into the track (intros are often silent),
+    /// converted to 44.1 kHz mono as ShazamKit expects.
+    private static func signature(url: URL, duration: Double) throws -> SHSignature {
+        let file = try AVAudioFile(forReading: url)
+        guard let target = AVAudioFormat(standardFormatWithSampleRate: 44100.0, channels: 1),
+              let converter = AVAudioConverter(from: file.processingFormat, to: target) else { throw Failure.unreadableAudio }
+        let sourceRate = file.processingFormat.sampleRate
+        let total = file.length
+        let start = AVAudioFramePosition(Double(total) * 0.3)
+        file.framePosition = min(max(0, start), max(0, total - AVAudioFramePosition(sourceRate * 12.0)))
+        let readFrames = AVAudioFrameCount(min(Double(total - file.framePosition), sourceRate * 12.0))
+        guard readFrames > 0, let input = AVAudioPCMBuffer(pcmFormat: file.processingFormat, frameCapacity: readFrames) else { throw Failure.unreadableAudio }
+        try file.read(into: input, frameCount: readFrames)
+        let outputCapacity = AVAudioFrameCount(Double(input.frameLength) * target.sampleRate / sourceRate) + 1024
+        guard let output = AVAudioPCMBuffer(pcmFormat: target, frameCapacity: outputCapacity) else { throw Failure.unreadableAudio }
+        var consumed = false
+        var conversionError: NSError?
+        converter.convert(to: output, error: &conversionError, withInputFrom: { _, status in
+            if consumed {
+                status.pointee = .endOfStream
+                return nil
+            }
+            consumed = true
+            status.pointee = .haveData
+            return input
+        })
+        if let conversionError { throw conversionError }
+        let generator = SHSignatureGenerator()
+        try generator.append(output, at: nil)
+        return generator.signature()
+    }
+}
