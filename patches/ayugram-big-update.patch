+import Foundation
+import UIKit
+import SwiftSignalKit
+import TelegramCore
+import AccountContext
+
+/// Ready-made "smart" chat folders built from Telegram's own folder rules, so they sync to all
+/// devices and update themselves: unread only, people, unread groups, channels, bots.
+enum AyuSmartFolders {
+    struct Preset {
+        let titleRu: String
+        let titleEn: String
+        let emoji: String
+        let categories: ChatListFilterPeerCategories
+        let excludeMuted: Bool
+        let excludeRead: Bool
+    }
+
+    static let presets: [Preset] = [
+        Preset(titleRu: "Непрочитанные", titleEn: "Unread", emoji: "✅", categories: .all, excludeMuted: false, excludeRead: true),
+        Preset(titleRu: "Важное", titleEn: "Important", emoji: "⭐", categories: .all, excludeMuted: true, excludeRead: true),
+        Preset(titleRu: "Люди", titleEn: "People", emoji: "👤", categories: [.contacts, .nonContacts], excludeMuted: false, excludeRead: false),
+        Preset(titleRu: "Группы", titleEn: "Groups", emoji: "👥", categories: [.groups], excludeMuted: false, excludeRead: false),
+        Preset(titleRu: "Каналы", titleEn: "Channels", emoji: "📢", categories: [.channels], excludeMuted: false, excludeRead: false),
+        Preset(titleRu: "Боты", titleEn: "Bots", emoji: "🤖", categories: [.bots], excludeMuted: false, excludeRead: false)
+    ]
+
+    static func present(context: AccountContext, russian ru: Bool) {
+        let sheet = UIAlertController(title: ru ? "Умные папки" : "Smart folders", message: ru ? "Папка создаётся в Telegram и обновляется сама: например, «Важное» — непрочитанные чаты без звука не попадают." : "The folder is created in Telegram and updates itself: for example, Important shows unread chats that are not muted.", preferredStyle: .alert)
+        for preset in presets {
+            sheet.addAction(UIAlertAction(title: preset.emoji + " " + (ru ? preset.titleRu : preset.titleEn), style: .default, handler: { _ in
+                create(context: context, preset: preset, russian: ru)
+            }))
+        }
+        sheet.addAction(UIAlertAction(title: ru ? "Отмена" : "Cancel", style: .cancel))
+        context.sharedContext.applicationBindings.presentNativeController(sheet)
+    }
+
+    private static func create(context: AccountContext, preset: Preset, russian ru: Bool) {
+        let title = ru ? preset.titleRu : preset.titleEn
+        let _ = (context.engine.peers.updateChatListFiltersInteractively { filters in
+            var filters = filters
+            let id = context.engine.peers.generateNewChatListFilterId(filters: filters)
+            let data = ChatListFilterData(isShared: false, hasSharedLinks: false, categories: preset.categories, excludeMuted: preset.excludeMuted, excludeRead: preset.excludeRead, excludeArchived: true, includePeers: ChatListFilterIncludePeers(), excludePeers: [], color: nil)
+            filters.append(.filter(id: id, title: ChatFolderTitle(text: title, entities: [], enableAnimations: true), emoticon: preset.emoji, data: data))
+            return filters
+        }
+        |> deliverOnMainQueue).startStandalone(next: { _ in
+            let alert = UIAlertController(title: title, message: ru ? "Папка создана — она появилась вверху списка чатов." : "The folder was created; it is at the top of the chat list.", preferredStyle: .alert)
+            alert.addAction(UIAlertAction(title: "OK", style: .default))
+            context.sharedContext.applicationBindings.presentNativeController(alert)
+        })
+    }
+}
