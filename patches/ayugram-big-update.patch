+import Foundation
+import UIKit
+import MetricKit
+import UserNotifications
+import SwiftSignalKit
+import Display
+import TelegramCore
+import AccountContext
+import SettingsUI
+
+/// Anti-scam check for links: punycode (xn--) hosts and hosts mixing Latin and Cyrillic letters,
+/// the usual look-alike tricks. Returns the warning to show, or nil.
+enum AyuAntiScam {
+    static let disabledKey = "ayu.extra.antiScamOff"
+
+    static func warning(for url: String, russian: Bool) -> String? {
+        guard !UserDefaults.standard.bool(forKey: disabledKey), !AyuDecoyMode.isActive,
+              let host = URLComponents(string: url)?.host?.lowercased(), !host.isEmpty else { return nil }
+        if host.split(separator: ".").contains(where: { $0.hasPrefix("xn--") }) {
+            return russian ? "Адрес \(host) записан в punycode: так часто маскируют поддельные сайты под настоящие. Открывайте, только если доверяете отправителю." : "\(host) is written in punycode, a common way to disguise fake sites as real ones. Open it only if you trust the sender."
+        }
+        var hasLatin = false
+        var hasCyrillic = false
+        for scalar in host.unicodeScalars {
+            if ("a" ... "z").contains(scalar) { hasLatin = true }
+            if (0x0400 ... 0x04FF).contains(scalar.value) { hasCyrillic = true }
+        }
+        if hasLatin && hasCyrillic {
+            return russian ? "В адресе \(host) смешаны латинские и русские буквы — признак сайта-двойника." : "\(host) mixes Latin and Cyrillic letters, a sign of a look-alike site."
+        }
+        return nil
+    }
+}
+
+/// Crash and hang reports from MetricKit, kept on the device and shared from Tools.
+final class AyuCrashReports: NSObject, MXMetricManagerSubscriber {
+    static let shared = AyuCrashReports()
+
+    static var directory: URL? {
+        return FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first?.appendingPathComponent("AyuGram/Diagnostics", isDirectory: true)
+    }
+
+    func start() {
+        MXMetricManager.shared.add(self)
+    }
+
+    func didReceive(_ payloads: [MXDiagnosticPayload]) {
+        guard let directory = AyuCrashReports.directory else { return }
+        try? FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        for payload in payloads {
+            let name = "diagnostic-\(Int(payload.timeStampEnd.timeIntervalSince1970)).json"
+            try? payload.jsonRepresentation().write(to: directory.appendingPathComponent(name), options: .atomic)
+        }
+        // Keep the newest 30.
+        if let files = try? FileManager.default.contentsOfDirectory(at: directory, includingPropertiesForKeys: [.creationDateKey]), files.count > 30 {
+            for file in files.sorted(by: { $0.lastPathComponent < $1.lastPathComponent }).prefix(files.count - 30) {
+                try? FileManager.default.removeItem(at: file)
+            }
+        }
+    }
+
+    static var files: [URL] {
+        guard let directory = AyuCrashReports.directory, let files = try? FileManager.default.contentsOfDirectory(at: directory, includingPropertiesForKeys: nil) else { return [] }
+        return files.sorted(by: { $0.lastPathComponent > $1.lastPathComponent })
+    }
+}
+
+enum AyuAppExtras {
+    private static var installed = false
+
+    static func install(sharedContext: SharedAccountContext) {
+        guard !installed else { return }
+        installed = true
+        AyuCrashReports.shared.start()
+        AyuAccountAccent.install(sharedContext: sharedContext)
+        AyuSystemIntegration.install(sharedContext: sharedContext)
+        AyuCallStatistics.install(sharedContext: sharedContext)
+        if AyuScriptCatalog.autoUpdate {
+            DispatchQueue.main.asyncAfter(deadline: .now() + 15.0) {
+                AyuScriptCatalog.shared.updateInstalled(completion: { names in
+                    guard !names.isEmpty else { return }
+                    DispatchQueue.main.async {
+                        let ru = sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru")
+                        let alert = UIAlertController(title: ru ? "Плагины обновлены" : "Plugins updated", message: names.joined(separator: "\n"), preferredStyle: .alert)
+                        alert.addAction(UIAlertAction(title: "OK", style: .default))
+                        sharedContext.applicationBindings.presentNativeController(alert)
+                    }
+                })
+            }
+        }
+
+        // Text shortcuts and templates run as a built-in outgoing-text hook, only while in use.
+        let updateShortcutHook = {
+            AyuHooks.shared.removeAll(owner: "ayu.shortcuts")
+            if AyuTextShortcuts.isActive {
+                AyuHooks.shared.register(point: .outgoingText, mode: .before, owner: "ayu.shortcuts", handler: { text, _ in
+                    return AyuTextShortcuts.apply(text)
+                })
+            }
+        }
+        updateShortcutHook()
+        let _ = NotificationCenter.default.addObserver(forName: AyuTextShortcuts.didChangeNotification, object: nil, queue: .main, using: { _ in
+            updateShortcutHook()
+        })
+
+        // Anti-caps: "HELLO THERE" goes out as "Hello there".
+        let updateAntiCapsHook = {
+            AyuHooks.shared.removeAll(owner: "ayu.anticaps")
+            if AyuExtras.isOn(.antiCaps) {
+                AyuHooks.shared.register(point: .outgoingText, mode: .after, owner: "ayu.anticaps", handler: { text, _ in
+                    return ayuDecapitalized(text)
+                })
+            }
+        }
+        updateAntiCapsHook()
+        let _ = NotificationCenter.default.addObserver(forName: AyuExtras.didChangeNotification, object: nil, queue: .main, using: { _ in
+            updateAntiCapsHook()
+        })
+
+        // A plugin's hook took over 100 ms.
+        let _ = NotificationCenter.default.addObserver(forName: AyuHooks.slowPluginNotification, object: nil, queue: .main, using: { notification in
+            guard let owner = notification.userInfo?["owner"] as? String else { return }
+            let seconds = notification.userInfo?["seconds"] as? Double ?? 0.0
+            let name = AyuScriptRuntime.shared.plugin(id: owner)?.name ?? owner
