+    debugger.pause_allowed_depth = -1;
+    debugger.step_line = -1;
+    debugger.keep_suspend = false;
+    debugger.isexceptionmode = false;
+    debugger.step_mode = C11_STEP_CONTINUE;
+    init_structures();
+}
