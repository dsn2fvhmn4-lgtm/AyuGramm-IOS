--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuGram/AyuLyricsProviderSettings.swift
@@ -0,0 +1,68 @@
+import Foundation
+
+/// Which lyrics sources the music player asks, shared by the settings screen and the player.
+/// Stored app-wide; nothing here is sent anywhere except the lookups themselves.
+public struct AyuLyricsProviderSettings: Codable, Equatable {
+    /// A user's own lyrics endpoint. `urlTemplate` placeholders: {artist} {title} {album}
+    /// {duration} (seconds) {query} ("artist title"). The response may be raw LRC/Enhanced LRC,
+    /// plain text, or JSON with `syncedLyrics`/`lrc`/`lyrics`/`plainLyrics`/`text`.
+    public struct CustomProvider: Codable, Equatable {
+        public var name: String
+        public var urlTemplate: String
+        public var enabled: Bool
+        public init(name: String, urlTemplate: String, enabled: Bool = true) {
+            self.name = name
+            self.urlTemplate = urlTemplate
+            self.enabled = enabled
+        }
+    }
+
+    public var lrclibEnabled = true
+    /// Base URL of an LRCLIB-compatible server, for a self-hosted mirror.
+    public var lrclibBaseURL = "https://lrclib.net"
+    public var netEaseEnabled = true
+    public var lyricsOvhEnabled = true
+    public var customProviders: [CustomProvider] = []
+    /// Overall time budget for one lookup, in seconds.
+    public var timeout: Double = 12.0
+
+    public init() {}
+
+    private enum CodingKeys: String, CodingKey {
+        case lrclibEnabled, lrclibBaseURL, netEaseEnabled, lyricsOvhEnabled, customProviders, timeout
+    }
+
+    public init(from decoder: Decoder) throws {
+        let values = try decoder.container(keyedBy: CodingKeys.self)
+        self.lrclibEnabled = (try? values.decodeIfPresent(Bool.self, forKey: .lrclibEnabled)) ?? true
+        self.lrclibBaseURL = (try? values.decodeIfPresent(String.self, forKey: .lrclibBaseURL)) ?? "https://lrclib.net"
+        self.netEaseEnabled = (try? values.decodeIfPresent(Bool.self, forKey: .netEaseEnabled)) ?? true
+        self.lyricsOvhEnabled = (try? values.decodeIfPresent(Bool.self, forKey: .lyricsOvhEnabled)) ?? true
+        self.customProviders = (try? values.decodeIfPresent([CustomProvider].self, forKey: .customProviders)) ?? []
+        self.timeout = min(30.0, max(4.0, (try? values.decodeIfPresent(Double.self, forKey: .timeout)) ?? 12.0))
+    }
+
+    /// A template must be http(s) and mention the track somehow.
+    public static func isValidTemplate(_ template: String) -> Bool {
+        let trimmed = template.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard trimmed.lowercased().hasPrefix("https://") || trimmed.lowercased().hasPrefix("http://") else { return false }
+        return ["{title}", "{query}"].contains(where: { trimmed.contains($0) }) && trimmed.count <= 2048
+    }
+
+    private static let defaultsKey = "ayu.lyrics.providers.v1"
+
+    public static var current: AyuLyricsProviderSettings {
+        get {
+            guard let data = UserDefaults.standard.data(forKey: self.defaultsKey),
+                  let value = try? JSONDecoder().decode(AyuLyricsProviderSettings.self, from: data) else {
+                return AyuLyricsProviderSettings()
+            }
+            return value
+        }
+        set {
+            if let data = try? JSONEncoder().encode(newValue) {
+                UserDefaults.standard.set(data, forKey: self.defaultsKey)
+            }
+        }
+    }
+}
diff --git a/submodules/TelegramCore/Sources/AyuGram/AyuPeerArchive.swift b/submodules/TelegramCore/Sources/AyuGram/AyuPeerArchive.swift
new file mode 100644
index 00000000..894ec525
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuGram/AyuPeerArchive.swift
@@ -0,0 +1,188 @@
+import Foundation
+import Postbox
+
+/// Local snapshots of chats, channels and people this account has seen, kept so a saved ID
+/// still resolves to a name and old usernames after the account is deleted, the channel is
+/// removed or the user leaves it. Stored only on this device, per account.
+public final class AyuPeerArchive {
+    public struct Entry: Codable, Equatable {
+        public enum Kind: String, Codable {
+            case user, bot, group, channel
+        }
+        /// `EnginePeer.Id.toInt64()` of the peer.
+        public var peerId: Int64
+        /// The bare server id as users see and share it.
+        public var rawId: Int64
+        public var kind: Kind
+        public var title: String
+        public var usernames: [String]
+        public var firstSeen: Int32
+        public var lastSeen: Int32
+        /// The peer was seen deleted/unavailable after this snapshot was taken.
+        public var goneSince: Int32?
+    }
+
+    private static var instances: [Int64: AyuPeerArchive] = [:]
+    private static let instancesLock = NSLock()
+
+    public static func shared(accountPeerId: Int64) -> AyuPeerArchive {
+        AyuPeerArchive.instancesLock.lock()
+        defer { AyuPeerArchive.instancesLock.unlock() }
+        if let current = AyuPeerArchive.instances[accountPeerId] {
+            return current
+        }
+        let archive = AyuPeerArchive(accountPeerId: accountPeerId)
+        AyuPeerArchive.instances[accountPeerId] = archive
+        return archive
+    }
+
+    private let lock = NSLock()
+    private let fileURL: URL?
+    private var entries: [Int64: Entry] = [:]
+    private var dirty = false
+    private var saveScheduled = false
+    private let saveQueue = DispatchQueue(label: "AyuGram.PeerArchive")
+    private let capacity = 5000
+
+    private init(accountPeerId: Int64) {
+        self.fileURL = FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first?
+            .appendingPathComponent("AyuGram", isDirectory: true)
+            .appendingPathComponent("peer-archive-\(accountPeerId).json")
+        if let url = self.fileURL, let data = try? Data(contentsOf: url), let decoded = try? JSONDecoder().decode([Entry].self, from: data) {
+            for entry in decoded { self.entries[entry.peerId] = entry }
+        }
+    }
+
+    public var count: Int {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return self.entries.count
+    }
+
+    public func entry(peerId: Int64) -> Entry? {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return self.entries[peerId]
+    }
+
+    /// Entries whose bare id equals `rawId` (a user and a channel can share one).
+    public func entries(rawId: Int64) -> [Entry] {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return self.entries.values.filter { $0.rawId == rawId }
+    }
+
+    /// Peers last seen deleted or unavailable, most recent first.
+    public func goneEntries(limit: Int = 50) -> [Entry] {
+        self.lock.lock()
+        let gone = self.entries.values.filter { $0.goneSince != nil }
+        self.lock.unlock()
+        return Array(gone.sorted(by: { ($0.goneSince ?? 0) > ($1.goneSince ?? 0) }).prefix(limit))
+    }
+
+    public func search(_ query: String, limit: Int = 50) -> [Entry] {
+        let needle = query.trimmingCharacters(in: .whitespacesAndNewlines).lowercased()
+        let bare = needle.hasPrefix("@") ? String(needle.dropFirst()) : needle
+        guard !bare.isEmpty else { return [] }
+        self.lock.lock()
+        let all = Array(self.entries.values)
+        self.lock.unlock()
+        let matches = all.filter { entry in
+            if String(entry.rawId) == bare || String(entry.peerId) == bare { return true }
+            if entry.title.lowercased().contains(bare) { return true }
+            return entry.usernames.contains(where: { $0.lowercased().hasPrefix(bare) })
+        }
+        return Array(matches.sorted(by: { $0.lastSeen > $1.lastSeen }).prefix(limit))
+    }
+
+    public func record(_ peer: EnginePeer) {
+        let now = Int32(Date().timeIntervalSince1970)
+        let kind: Entry.Kind
+        let title: String
+        switch peer {
+        case let .user(user):
+            kind = user.botInfo != nil ? .bot : .user
+            title = [user.firstName, user.lastName].compactMap { $0 }.filter { !$0.isEmpty }.joined(separator: " ")
+        case let .legacyGroup(group):
+            kind = .group
+            title = group.title
+        case let .channel(channel):
+            if case .broadcast = channel.info { kind = .channel } else { kind = .group }
+            title = channel.title
+        default:
+            // Secret chats and communities are not archived.
+            return
+        }
+        let usernames = peer.usernames.map { $0.username }.filter { !$0.isEmpty }
+        let gone = peer.isDeleted || title.isEmpty
+        let peerId = peer.id.toInt64()
+
+        self.lock.lock()
+        var entry = self.entries[peerId] ?? Entry(peerId: peerId, rawId: peer.id.id._internalGetInt64Value(), kind: kind, title: title, usernames: [], firstSeen: now, lastSeen: now, goneSince: nil)
+        if gone {
+            // Keep the last real snapshot; only note that the peer is gone now.
+            if entry.goneSince == nil { entry.goneSince = now }
+            if entry.title.isEmpty { entry.title = title }
+        } else {
+            entry.title = title
+            entry.kind = kind
+            entry.goneSince = nil
+            // Old usernames stay listed after the newer ones: they can lead back to the peer.
+            var merged = usernames
+            for old in entry.usernames where !merged.contains(old) { merged.append(old) }
+            entry.usernames = Array(merged.prefix(16))
+        }
+        entry.lastSeen = now
+        let changed = self.entries[peerId] != entry
+        self.entries[peerId] = entry
+        if self.entries.count > self.capacity {
+            let overflow = self.entries.values.sorted(by: { $0.lastSeen < $1.lastSeen }).prefix(self.entries.count - self.capacity)
+            for item in overflow { self.entries.removeValue(forKey: item.peerId) }
+        }
+        if changed { self.dirty = true }
+        let shouldSchedule = changed && !self.saveScheduled
+        if shouldSchedule { self.saveScheduled = true }
+        self.lock.unlock()
+        if shouldSchedule {
+            // Coalesce bursts (a whole chat list) into one write.
+            self.saveQueue.asyncAfter(deadline: .now() + 2.0) { [weak self] in
+                self?.flush()
+            }
+        }
+    }
+
+    public func remove(peerId: Int64) {
+        self.lock.lock()
+        self.entries.removeValue(forKey: peerId)
+        self.dirty = true
+        self.lock.unlock()
+        self.saveQueue.async { [weak self] in self?.flush() }
+    }
+
+    public func clear() {
+        self.lock.lock()
+        self.entries = [:]
+        self.dirty = true
+        self.lock.unlock()
+        self.saveQueue.async { [weak self] in self?.flush() }
+    }
+
+    private func flush() {
+        self.lock.lock()
+        self.saveScheduled = false
+        guard self.dirty, let url = self.fileURL else {
+            self.lock.unlock()
+            return
+        }
+        self.dirty = false
+        let snapshot = Array(self.entries.values)
+        self.lock.unlock()
+        guard let data = try? JSONEncoder().encode(snapshot) else { return }
+        try? FileManager.default.createDirectory(at: url.deletingLastPathComponent(), withIntermediateDirectories: true)
+        #if os(iOS)
+        try? data.write(to: url, options: [.atomic, .completeFileProtectionUntilFirstUserAuthentication])
+        #else
+        try? data.write(to: url, options: .atomic)
+        #endif
+    }
+}
diff --git a/submodules/TelegramCore/Sources/AyuGram/AyuPluginConsole.swift b/submodules/TelegramCore/Sources/AyuGram/AyuPluginConsole.swift
new file mode 100644
index 00000000..6435c251
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuGram/AyuPluginConsole.swift
@@ -0,0 +1,69 @@
+import Foundation
+import SwiftSignalKit
+
+/// In-memory ring buffer of plugin runtime output (print, errors, hook activity).
+/// Filled only while Developer → Plugin console is on; never persisted or uploaded.
+public final class AyuPluginConsole {
+    public struct Line: Equatable {
+        public enum Level: String {
+            case info, warning, error
+        }
+        public let id: Int64
+        public let date: Date
+        public let pluginId: String
+        public let level: Level
+        public let text: String
+    }
+
+    public static let shared = AyuPluginConsole()
+
+    private let lock = NSLock()
+    private var lines: [Line] = []
+    private var nextId: Int64 = 0
+    private let capacity = 500
+    private let updates = ValuePromise<Int64>(0, ignoreRepeated: true)
+
+    private init() {}
+
+    public func append(pluginId: String, level: Line.Level, _ text: String) {
+        guard AyuDeveloperSettings.shared.current.pluginConsole else {
+            if level == .error {
+                AyuDevLog.shared.log("plugin:\(pluginId)", text)
+            }
+            return
+        }
+        self.lock.lock()
+        self.nextId += 1
+        let id = self.nextId
+        // Bound each line too: a plugin printing in a loop must not exhaust memory.
+        self.lines.append(Line(id: id, date: Date(), pluginId: pluginId, level: level, text: String(text.prefix(2000))))
+        if self.lines.count > self.capacity {
+            self.lines.removeFirst(self.lines.count - self.capacity)
+        }
+        self.lock.unlock()
+        AyuDevLog.shared.log("plugin:\(pluginId)", "[\(level.rawValue)] \(text)")
+        self.updates.set(id)
+    }
+
+    public func clear() {
+        self.lock.lock()
+        self.lines = []
+        self.nextId += 1
+        let id = self.nextId
+        self.lock.unlock()
+        self.updates.set(id)
+    }
+
+    public var snapshot: [Line] {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return self.lines
+    }
+
+    public var signal: Signal<[Line], NoError> {
+        return self.updates.get()
+        |> map { [weak self] _ -> [Line] in
+            return self?.snapshot ?? []
+        }
+    }
+}
