+import Foundation
+
+/// Built-in link rewriting (Settings → AyuGram → Tools → Links), applied before plugins'
+/// `link.open` hooks: privacy-friendly or embed-friendly front ends for popular sites.
+public enum AyuLinkRewrite {
+    public enum Rule: String, CaseIterable {
+        case twitter
+        case youtube
+        case instagram
+        case reddit
+        case tiktok
+
+        public func title(_ russian: Bool) -> String {
+            switch self {
+            case .twitter: return "X / Twitter → fxtwitter"
+            case .youtube: return "YouTube → Invidious"
+            case .instagram: return "Instagram → ddinstagram"
+            case .reddit: return "Reddit → old.reddit"
+            case .tiktok: return "TikTok → vxtiktok"
+            }
+        }
+    }
+
+    public static let didChangeNotification = Notification.Name("AyuGram.LinkRewriteChanged")
+    private static let key = "ayu.links."
+
+    public static func isOn(_ rule: Rule) -> Bool {
+        return !AyuDecoyMode.isActive && UserDefaults.standard.bool(forKey: key + rule.rawValue)
+    }
+
+    public static func set(_ rule: Rule, _ value: Bool) {
+        UserDefaults.standard.set(value, forKey: key + rule.rawValue)
+        NotificationCenter.default.post(name: didChangeNotification, object: nil)
+    }
+
+    /// The Invidious instance used for YouTube links.
+    public static var invidiousHost: String {
+        get {
+            let value = UserDefaults.standard.string(forKey: key + "invidious") ?? ""
+            return value.isEmpty ? "yewtu.be" : value
+        }
+        set {
+            UserDefaults.standard.set(newValue.trimmingCharacters(in: .whitespacesAndNewlines), forKey: key + "invidious")
+            NotificationCenter.default.post(name: didChangeNotification, object: nil)
+        }
+    }
+
+    public static var hasRules: Bool {
+        return Rule.allCases.contains(where: { isOn($0) })
+    }
+
+    /// The rewritten link, or the same string when no rule applies.
+    public static func apply(_ url: String) -> String {
+        guard hasRules, var components = URLComponents(string: url), let host = components.host?.lowercased() else {
+            return url
+        }
+        let bare = host.hasPrefix("www.") ? String(host.dropFirst(4)) : (host.hasPrefix("m.") ? String(host.dropFirst(2)) : host)
+        let rule: Rule
+        switch bare {
+        case "x.com", "twitter.com": rule = .twitter
+        case "youtube.com", "youtu.be", "music.youtube.com": rule = .youtube
+        case "instagram.com": rule = .instagram
+        case "reddit.com": rule = .reddit
+        case "tiktok.com", "vm.tiktok.com": rule = .tiktok
+        default: return url
+        }
+        guard isOn(rule) else {
+            return url
+        }
+        switch rule {
+        case .twitter:
+            components.host = "fxtwitter.com"
+        case .youtube:
+            if bare == "youtu.be" {
+                let id = components.path.trimmingCharacters(in: CharacterSet(charactersIn: "/"))
+                components.path = "/watch"
+                var items = components.queryItems ?? []
+                items.insert(URLQueryItem(name: "v", value: id), at: 0)
+                components.queryItems = items
+            }
+            components.host = invidiousHost
+        case .instagram:
+            components.host = "ddinstagram.com"
+        case .reddit:
+            components.host = "old.reddit.com"
+        case .tiktok:
+            components.host = "vxtiktok.com"
+        }
+        return components.string ?? url
+    }
+}
