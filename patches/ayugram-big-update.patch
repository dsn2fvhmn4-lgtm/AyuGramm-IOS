@@ -0,0 +1,37 @@
+import Foundation
+#if canImport(FoundationModels)
+// Weakly linked: the framework exists only on iOS 26+, and the app still launches on iOS 15.
+@_weakLinked import FoundationModels
+#endif
+
+/// Apple's on-device language model (iOS 26, Apple Intelligence devices): shortening and
+/// "what did I miss" summaries without an API key. Nothing leaves the device.
+enum AyuOnDeviceAI {
+    static var isAvailable: Bool {
+        #if canImport(FoundationModels)
+        if #available(iOS 26.0, *) {
+            return SystemLanguageModel.default.isAvailable
+        }
+        #endif
+        return false
+    }
+
+    static func respond(instructions: String, prompt: String, completion: @escaping (String?) -> Void) {
+        #if canImport(FoundationModels)
+        if #available(iOS 26.0, *), SystemLanguageModel.default.isAvailable {
+            Task {
+                do {
+                    let session = LanguageModelSession(instructions: instructions)
+                    let response = try await session.respond(to: String(prompt.prefix(12000)))
+                    let text = response.content
+                    DispatchQueue.main.async { completion(text) }
+                } catch {
+                    DispatchQueue.main.async { completion(nil) }
+                }
+            }
+            return
+        }
+        #endif
+        completion(nil)
+    }
+}
diff --git a/submodules/TelegramUI/Sources/AyuOnlineTools.swift b/submodules/TelegramUI/Sources/AyuOnlineTools.swift
new file mode 100644
index 00000000..7c1fe98b
--- /dev/null
+++ b/submodules/TelegramUI/Sources/AyuOnlineTools.swift
@@ -0,0 +1,289 @@
+import Foundation
+import UIKit
+import CryptoKit
+import Display
+import TelegramCore
+import AccountContext
+import SwiftSignalKit
+import LocalizedPeerData
+
+/// VirusTotal checks and AI shortening from the message menu. Each runs only when the user taps
+/// it, with the user's own API key; files are checked by their SHA-256 and never uploaded.
+enum AyuOnlineTools {
+    private static let session: URLSession = {
+        let configuration = URLSessionConfiguration.ephemeral
+        configuration.timeoutIntervalForRequest = 30.0
+        return URLSession(configuration: configuration)
+    }()
+
+    static func present(_ context: AccountContext, title: String, message: String) {
+        let ru = context.sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru")
+        let alert = UIAlertController(title: title, message: message, preferredStyle: .alert)
+        alert.addAction(UIAlertAction(title: ru ? "Скопировать" : "Copy", style: .default, handler: { _ in
+            UIPasteboard.general.string = message
+        }))
+        alert.addAction(UIAlertAction(title: "OK", style: .cancel))
+        context.sharedContext.applicationBindings.presentNativeController(alert)
+    }
+
+    private static func missingKey(_ context: AccountContext, _ what: String) {
+        let ru = context.sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru")
+        present(context, title: what, message: ru ? "Добавьте свой ключ API: AyuGram → Инструменты." : "Add your API key: AyuGram → Tools.")
+    }
+
+    // MARK: VirusTotal
+
+    static func firstUrl(in text: String) -> String? {
+        guard let detector = try? NSDataDetector(types: NSTextCheckingResult.CheckingType.link.rawValue) else { return nil }
+        let range = NSRange(text.startIndex..., in: text)
+        return detector.firstMatch(in: text, options: [], range: range)?.url?.absoluteString
+    }
+
+    private static func stats(_ data: Data?) -> [String: Int]? {
+        guard let data, let json = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
+              let object = json["data"] as? [String: Any], let attributes = object["attributes"] as? [String: Any],
+              let stats = attributes["last_analysis_stats"] as? [String: Any] else { return nil }
+        var result: [String: Int] = [:]
+        for (key, value) in stats {
+            if let number = value as? NSNumber { result[key] = number.intValue }
+        }
+        return result
+    }
+
+    private static func verdict(_ stats: [String: Int], ru: Bool) -> String {
+        let malicious = stats["malicious"] ?? 0
+        let suspicious = stats["suspicious"] ?? 0
+        let harmless = stats["harmless"] ?? 0
+        let undetected = stats["undetected"] ?? 0
+        let head: String
+        if malicious > 0 {
+            head = ru ? "⛔️ Опасно" : "⛔️ Dangerous"
+        } else if suspicious > 0 {
+            head = ru ? "⚠️ Подозрительно" : "⚠️ Suspicious"
+        } else {
+            head = ru ? "✅ Угроз не найдено" : "✅ No threats found"
+        }
+        return head + "\n\n" + (ru ? "Вредоносно: \(malicious)\nПодозрительно: \(suspicious)\nБезопасно: \(harmless)\nНе определено: \(undetected)" : "Malicious: \(malicious)\nSuspicious: \(suspicious)\nHarmless: \(harmless)\nUndetected: \(undetected)")
+    }
+
+    static func checkUrl(context: AccountContext, url: String) {
+        let ru = context.sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru")
+        let key = AyuTools.virusTotalKey
+        guard !key.isEmpty else { return missingKey(context, "VirusTotal") }
+        let id = Data(url.utf8).base64EncodedString().replacingOccurrences(of: "+", with: "-").replacingOccurrences(of: "/", with: "_").replacingOccurrences(of: "=", with: "")
+        guard let reportUrl = URL(string: "https://www.virustotal.com/api/v3/urls/" + id) else { return }
+        var request = URLRequest(url: reportUrl)
+        request.setValue(key, forHTTPHeaderField: "x-apikey")
+        session.dataTask(with: request, completionHandler: { data, response, _ in
+            let status = (response as? HTTPURLResponse)?.statusCode ?? 0
+            if status == 200, let stats = stats(data) {
+                DispatchQueue.main.async { present(context, title: "VirusTotal", message: url + "\n\n" + verdict(stats, ru: ru)) }
+                return
+            }
+            if status == 404, let submitUrl = URL(string: "https://www.virustotal.com/api/v3/urls") {
+                // Not analysed yet: submit it, the report appears in about a minute.
+                var submit = URLRequest(url: submitUrl)
+                submit.httpMethod = "POST"
+                submit.setValue(key, forHTTPHeaderField: "x-apikey")
+                submit.setValue("application/x-www-form-urlencoded", forHTTPHeaderField: "Content-Type")
+                var allowed = CharacterSet.alphanumerics
+                allowed.insert(charactersIn: "-._~")
+                submit.httpBody = ("url=" + (url.addingPercentEncoding(withAllowedCharacters: allowed) ?? "")).data(using: .utf8)
+                session.dataTask(with: submit, completionHandler: { _, response, _ in
+                    let ok = (response as? HTTPURLResponse)?.statusCode == 200
+                    DispatchQueue.main.async {
+                        present(context, title: "VirusTotal", message: ok ? (ru ? "Ссылка отправлена на проверку. Повторите через минуту." : "The link was sent for analysis. Check again in a minute.") : (ru ? "VirusTotal не принял ссылку." : "VirusTotal did not accept the link."))
+                    }
+                }).resume()
+                return
+            }
+            DispatchQueue.main.async {
+                present(context, title: "VirusTotal", message: status == 401 ? (ru ? "Неверный ключ API." : "Invalid API key.") : (ru ? "Не удалось проверить (код \(status))." : "The check failed (code \(status))."))
+            }
+        }).resume()
+    }
+
+    static func checkFile(context: AccountContext, path: String, name: String) {
+        let ru = context.sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru")
+        let key = AyuTools.virusTotalKey
+        guard !key.isEmpty else { return missingKey(context, "VirusTotal") }
+        DispatchQueue.global(qos: .userInitiated).async {
+            guard let data = try? Data(contentsOf: URL(fileURLWithPath: path), options: .mappedIfSafe) else { return }
+            let hash = SHA256.hash(data: data).map { String(format: "%02x", $0) }.joined()
+            guard let url = URL(string: "https://www.virustotal.com/api/v3/files/" + hash) else { return }
+            var request = URLRequest(url: url)
+            request.setValue(key, forHTTPHeaderField: "x-apikey")
+            session.dataTask(with: request, completionHandler: { data, response, _ in
+                let status = (response as? HTTPURLResponse)?.statusCode ?? 0
+                let message: String
+                if status == 200, let stats = stats(data) {
+                    message = name + "\n\n" + verdict(stats, ru: ru)
+                } else if status == 404 {
+                    message = name + "\n\n" + (ru ? "VirusTotal ещё не видел этот файл. AyuGram не загружает ваши файлы — проверить можно на virustotal.com вручную." : "VirusTotal has not seen this file. AyuGram never uploads your files; you can check it on virustotal.com yourself.")
+                } else if status == 401 {
+                    message = ru ? "Неверный ключ API." : "Invalid API key."
+                } else {
+                    message = ru ? "Не удалось проверить (код \(status))." : "The check failed (code \(status))."
+                }
+                DispatchQueue.main.async { present(context, title: "VirusTotal", message: message) }
+            }).resume()
+        }
+    }
+
+    // MARK: AI
+
+    /// The on-device model when there is no key, else the configured service.
+    static func ask(context: AccountContext, title: String, instructions: String, prompt: String) {
+        let ru = context.sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru")
+        if AyuTools.aiKey.isEmpty && AyuOnDeviceAI.isAvailable {
+            AyuOnDeviceAI.respond(instructions: instructions, prompt: prompt, completion: { text in
+                present(context, title: title, message: text ?? (ru ? "Модель на устройстве не ответила." : "The on-device model did not answer."))
+            })
+            return
+        }
+        request(context: context, title: title, instructions: instructions, prompt: prompt)
+    }
+
+    /// "Year in review" for one chat, from the messages stored on this device since January 1.
+    static func yearInReview(context: AccountContext, peerId: EnginePeer.Id) {
+        let ru = context.sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru")
+        let calendar = Calendar.current
+        let year = calendar.component(.year, from: Date())
+        let start = calendar.date(from: DateComponents(year: year, month: 1, day: 1)) ?? Date()
+        let _ = (context.engine.messages.ayuMessagesSince(peerId: peerId, since: Int32(start.timeIntervalSince1970), limit: 20000)
+        |> deliverOnMainQueue).startStandalone(next: { messages in
+            guard !messages.isEmpty else {
+                return present(context, title: ru ? "Итоги года" : "Year in review", message: ru ? "За этот год на устройстве нет сообщений этого чата." : "No messages from this chat this year on this device.")
+            }
+            var authors: [String: Int] = [:]
+            var months = [Int](repeating: 0, count: 12)
+            var days: [Int: Int] = [:]
+            var words: [String: Int] = [:]
+            var emoji: [String: Int] = [:]
+            var media = 0
+            var voice = 0
+            var mine = 0
+            for message in messages {
+                authors[message.author.map { $0.compactDisplayTitle } ?? "?", default: 0] += 1
+                let date = Date(timeIntervalSince1970: TimeInterval(message.timestamp))
+                months[calendar.component(.month, from: date) - 1] += 1
+                days[calendar.ordinality(of: .day, in: .year, for: date) ?? 0, default: 0] += 1
+                if message.flags.contains(.Incoming) == false {
+                    mine += 1
+                }
+                for item in message.media {
+                    if let file = item as? TelegramMediaFile, file.isVoice || file.isInstantVideo {
+                        voice += 1
+                    } else {
+                        media += 1
+                    }
+                }
+                for word in message.text.lowercased().split(whereSeparator: { !$0.isLetter }) where word.count >= 4 {
+                    words[String(word), default: 0] += 1
+                }
+                for character in message.text where character.unicodeScalars.first?.properties.isEmojiPresentation == true {
+                    emoji[String(character), default: 0] += 1
+                }
+            }
+            let monthNames = ru ? ["январь", "февраль", "март", "апрель", "май", "июнь", "июль", "август", "сентябрь", "октябрь", "ноябрь", "декабрь"] : calendar.monthSymbols
+            let busiestMonth = months.enumerated().max(by: { $0.element < $1.element })?.offset ?? 0
+            let busiestDay = days.max(by: { $0.value < $1.value })
+            let busiestDayText = busiestDay.flatMap { calendar.date(byAdding: .day, value: $0.key - 1, to: start) }.map { DateFormatter.localizedString(from: $0, dateStyle: .medium, timeStyle: .none) } ?? "—"
+            let top = authors.sorted(by: { $0.value > $1.value }).prefix(3).map { "\($0.key) — \($0.value)" }.joined(separator: "\n")
+            let topWords = words.sorted(by: { $0.value > $1.value }).prefix(5).map { $0.key }.joined(separator: ", ")
+            let topEmoji = emoji.sorted(by: { $0.value > $1.value }).prefix(5).map { $0.key }.joined()
+            let text: String
+            if ru {
+                text = "\(year): \(messages.count) сообщений, из них ваших \(mine).\n\nБольше всех писали:\n\(top)\n\nСамый активный месяц: \(monthNames[busiestMonth])\nСамый активный день: \(busiestDayText) (\(busiestDay?.value ?? 0))\nМедиа: \(media), голосовых и кружков: \(voice)\nЧастые слова: \(topWords.isEmpty ? "—" : topWords)\nЛюбимые эмодзи: \(topEmoji.isEmpty ? "—" : topEmoji)"
+            } else {
+                text = "\(year): \(messages.count) messages, \(mine) of them yours.\n\nMost active:\n\(top)\n\nBusiest month: \(monthNames[busiestMonth])\nBusiest day: \(busiestDayText) (\(busiestDay?.value ?? 0))\nMedia: \(media), voice and video messages: \(voice)\nFrequent words: \(topWords.isEmpty ? "—" : topWords)\nFavourite emoji: \(topEmoji.isEmpty ? "—" : topEmoji)"
+            }
+            present(context, title: ru ? "Итоги года" : "Year in review", message: text)
+        })
+    }
+
+    /// Local chat statistics over the newest stored messages: who writes most and when.
+    static func chatStats(context: AccountContext, peerId: EnginePeer.Id) {
+        let ru = context.sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru")
+        let _ = (context.engine.messages.ayuRecentMessages(peerId: peerId, limit: 100)
+        |> deliverOnMainQueue).startStandalone(next: { messages in
+            guard !messages.isEmpty else {
+                return present(context, title: ru ? "Статистика" : "Statistics", message: ru ? "Нет сохранённых сообщений." : "No stored messages.")
+            }
+            var authors: [String: Int] = [:]
+            var hours = [Int](repeating: 0, count: 24)
+            var characters = 0
+            let calendar = Calendar.current
+            for message in messages {
+                let name = message.author.map { $0.compactDisplayTitle } ?? "?"
+                authors[name, default: 0] += 1
+                hours[calendar.component(.hour, from: Date(timeIntervalSince1970: TimeInterval(message.timestamp)))] += 1
+                characters += message.text.count
+            }
+            let top = authors.sorted(by: { $0.value > $1.value }).prefix(5).map { "\($0.key): \($0.value)" }.joined(separator: "\n")
+            let busiest = hours.enumerated().max(by: { $0.element < $1.element })?.offset ?? 0
+            let first = messages.last.map { Date(timeIntervalSince1970: TimeInterval($0.timestamp)) } ?? Date()
+            let since = DateFormatter.localizedString(from: first, dateStyle: .medium, timeStyle: .short)
+            let text = ru
+                ? "По последним \(messages.count) сообщениям (с \(since)):\n\n\(top)\n\nСамый активный час: \(busiest):00\nСимволов: \(characters)"
+                : "Over the last \(messages.count) messages (since \(since)):\n\n\(top)\n\nBusiest hour: \(busiest):00\nCharacters: \(characters)"
+            present(context, title: ru ? "Статистика чата" : "Chat statistics", message: text)
+        })
+    }
+
+    /// The last messages of a chat, summarised.
+    static func whatDidIMiss(context: AccountContext, peerId: EnginePeer.Id) {
+        let ru = context.sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru")
+        let _ = (context.engine.messages.ayuRecentMessages(peerId: peerId, limit: 60)
+        |> deliverOnMainQueue).startStandalone(next: { messages in
+            let transcript = messages.reversed().compactMap { message -> String? in
+                guard !message.text.isEmpty else { return nil }
+                let name = message.author.map { $0.compactDisplayTitle } ?? "?"
+                return name + ": " + message.text
+            }.joined(separator: "\n")
+            guard !transcript.isEmpty else {
+                return present(context, title: ru ? "Что я пропустил" : "What did I miss", message: ru ? "В чате нет текстовых сообщений." : "No text messages in this chat.")
+            }
+            ask(context: context, title: ru ? "Что я пропустил" : "What did I miss", instructions: ru ? "Кратко перескажи переписку по-русски: главные темы, решения и вопросы ко мне. Не больше 6 пунктов." : "Summarise the conversation briefly: main topics, decisions and questions for me. At most 6 bullet points.", prompt: transcript)
+        })
+    }
+
+    static func shorten(context: AccountContext, text: String) {
+        let russian = context.sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru")
+        ask(context: context, title: russian ? "Кратко" : "Summary", instructions: "Shorten the user's message to one to three sentences. Keep its language, names and numbers. Reply with the shortened text only.", prompt: text)
+    }
+
+    private static func request(context: AccountContext, title: String, instructions: String, prompt text: String) {
+        let ru = context.sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru")
+        let key = AyuTools.aiKey
+        guard !key.isEmpty else { return missingKey(context, title) }
+        guard let url = URL(string: AyuTools.aiEndpoint), url.scheme?.lowercased() == "https" else {
+            return present(context, title: title, message: ru ? "Адрес ИИ должен начинаться с https://" : "The AI address must start with https://")
+        }
+        var request = URLRequest(url: url)
+        request.httpMethod = "POST"
+        request.setValue("application/json", forHTTPHeaderField: "Content-Type")
+        request.setValue("Bearer " + key, forHTTPHeaderField: "Authorization")
+        let body: [String: Any] = [
+            "model": AyuTools.aiModel,
+            "max_tokens": 300,
+            "messages": [
+                ["role": "system", "content": instructions],
+                ["role": "user", "content": String(text.prefix(12000))]
+            ]
+        ]
+        request.httpBody = try? JSONSerialization.data(withJSONObject: body)
+        session.dataTask(with: request, completionHandler: { data, response, _ in
+            let status = (response as? HTTPURLResponse)?.statusCode ?? 0
+            var result: String?
+            if status == 200, let data, let json = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
+               let choices = json["choices"] as? [[String: Any]], let message = choices.first?["message"] as? [String: Any],
+               let content = message["content"] as? String {
+                result = content.trimmingCharacters(in: .whitespacesAndNewlines)
+            }
+            DispatchQueue.main.async {
+                present(context, title: title, message: result ?? (status == 401 ? (ru ? "Неверный ключ API." : "Invalid API key.") : (ru ? "ИИ не ответил (код \(status))." : "The AI did not answer (code \(status)).")))
+            }
+        }).resume()
+    }
+}
diff --git a/submodules/TelegramUI/Sources/AyuPlayerButtonMotion.swift b/submodules/TelegramUI/Sources/AyuPlayerButtonMotion.swift
new file mode 100644
index 00000000..2bc92251
--- /dev/null
+++ b/submodules/TelegramUI/Sources/AyuPlayerButtonMotion.swift
@@ -0,0 +1,85 @@
+import Foundation
+import UIKit
+
+/// Press feedback for player controls. The button's content (not its frame, which layout owns)
+/// shrinks under the finger and springs back on release; skip buttons also nudge toward their
+/// direction. Runs on `sublayerTransform`, so it never fights frame changes or transform-based
+/// presentation animations of the button itself.
+@MainActor
+func ayuAttachPressMotion(_ button: UIButton, scale: CGFloat = 0.82, nudge: CGFloat = 0.0) {
+    button.addAction(UIAction { [weak button] _ in
+        guard let button else { return }
+        ayuAnimateContent(button.layer, to: CATransform3DMakeScale(scale, scale, 1.0), stiffness: 600.0, damping: 32.0)
+    }, for: [.touchDown, .touchDragEnter])
+    button.addAction(UIAction { [weak button] _ in
+        guard let button else { return }
+        ayuAnimateContent(button.layer, to: CATransform3DIdentity, stiffness: 420.0, damping: 20.0)
+    }, for: [.touchUpOutside, .touchDragExit, .touchCancel])
+    button.addAction(UIAction { [weak button] _ in
+        guard let button else { return }
+        ayuAnimateContent(button.layer, to: CATransform3DIdentity, stiffness: 420.0, damping: 16.0)
+        if nudge != 0.0 && !UIAccessibility.isReduceMotionEnabled {
+            let shift = CAKeyframeAnimation(keyPath: "sublayerTransform.translation.x")
+            shift.values = [0.0, nudge, 0.0]
+            shift.keyTimes = [0.0, 0.35, 1.0]
+            shift.timingFunctions = [CAMediaTimingFunction(name: .easeOut), CAMediaTimingFunction(name: .easeInEaseOut)]
+            shift.duration = 0.32
+            shift.isAdditive = true
+            button.layer.add(shift, forKey: "ayuNudge")
+        }
+    }, for: .touchUpInside)
+}
+
+/// Swaps a button's symbol with a crossfade and a small pop, as when play turns into pause.
+@MainActor
+func ayuSetImageAnimated(_ button: UIButton, _ image: UIImage?) {
+    guard button.window != nil, !UIAccessibility.isReduceMotionEnabled else {
+        button.setImage(image, for: .normal)
+        return
+    }
+    UIView.transition(with: button, duration: 0.18, options: [.transitionCrossDissolve, .allowUserInteraction, .beginFromCurrentState], animations: {
+        button.setImage(image, for: .normal)
+    })
+    ayuPop(button)
+}
+
+/// Swaps a button's title with a crossfade and a small pop (the playback rate pill).
+@MainActor
+func ayuSetTitleAnimated(_ button: UIButton, _ title: String?) {
+    guard button.window != nil, !UIAccessibility.isReduceMotionEnabled, button.title(for: .normal) != title else {
+        button.setTitle(title, for: .normal)
+        return
+    }
+    UIView.transition(with: button, duration: 0.18, options: [.transitionCrossDissolve, .allowUserInteraction, .beginFromCurrentState], animations: {
+        button.setTitle(title, for: .normal)
+    })
+    ayuPop(button)
+}
+
+@MainActor
+private func ayuPop(_ button: UIButton) {
+    let pop = CASpringAnimation(keyPath: "sublayerTransform.scale")
+    pop.fromValue = 0.7
+    pop.toValue = 1.0
+    pop.stiffness = 380.0
+    pop.damping = 15.0
+    pop.duration = pop.settlingDuration
+    button.layer.add(pop, forKey: "ayuPop")
+}
+
+@MainActor
+private func ayuAnimateContent(_ layer: CALayer, to target: CATransform3D, stiffness: CGFloat, damping: CGFloat) {
+    let from = layer.presentation()?.sublayerTransform ?? layer.sublayerTransform
+    layer.sublayerTransform = target
+    guard !UIAccessibility.isReduceMotionEnabled else {
+        layer.removeAnimation(forKey: "ayuPress")
+        return
+    }
+    let spring = CASpringAnimation(keyPath: "sublayerTransform")
+    spring.fromValue = NSValue(caTransform3D: from)
+    spring.toValue = NSValue(caTransform3D: target)
+    spring.stiffness = stiffness
+    spring.damping = damping
+    spring.duration = spring.settlingDuration
+    layer.add(spring, forKey: "ayuPress")
+}
