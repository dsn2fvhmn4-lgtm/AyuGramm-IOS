diff --git a/submodules/TelegramCore/Sources/AyuGram/AyuPluginConsole.swift b/submodules/TelegramCore/Sources/AyuGram/AyuPluginConsole.swift
new file mode 100644
index 00000000..6435c251
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuGram/AyuPluginConsole.swift
@@ -0,0 +1,69 @@
+import Foundation
+import SwiftSignalKit
+
+/// In-memory ring buffer of plugin runtime output (print, errors, hook activity).
+/// Filled only while Developer → Plugin console is on; never persisted or uploaded.
+public final class AyuPluginConsole {
+    public struct Line: Equatable {
+        public enum Level: String {
+            case info, warning, error
+        }
+        public let id: Int64
+        public let date: Date
+        public let pluginId: String
+        public let level: Level
+        public let text: String
+    }
+
+    public static let shared = AyuPluginConsole()
+
+    private let lock = NSLock()
+    private var lines: [Line] = []
+    private var nextId: Int64 = 0
+    private let capacity = 500
+    private let updates = ValuePromise<Int64>(0, ignoreRepeated: true)
+
+    private init() {}
+
+    public func append(pluginId: String, level: Line.Level, _ text: String) {
+        guard AyuDeveloperSettings.shared.current.pluginConsole else {
+            if level == .error {
+                AyuDevLog.shared.log("plugin:\(pluginId)", text)
+            }
+            return
+        }
+        self.lock.lock()
+        self.nextId += 1
+        let id = self.nextId
+        // Bound each line too: a plugin printing in a loop must not exhaust memory.
+        self.lines.append(Line(id: id, date: Date(), pluginId: pluginId, level: level, text: String(text.prefix(2000))))
+        if self.lines.count > self.capacity {
+            self.lines.removeFirst(self.lines.count - self.capacity)
+        }
+        self.lock.unlock()
+        AyuDevLog.shared.log("plugin:\(pluginId)", "[\(level.rawValue)] \(text)")
+        self.updates.set(id)
+    }
+
+    public func clear() {
+        self.lock.lock()
+        self.lines = []
+        self.nextId += 1
+        let id = self.nextId
+        self.lock.unlock()
+        self.updates.set(id)
+    }
+
+    public var snapshot: [Line] {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return self.lines
+    }
+
+    public var signal: Signal<[Line], NoError> {
+        return self.updates.get()
+        |> map { [weak self] _ -> [Line] in
+            return self?.snapshot ?? []
+        }
+    }
+}
