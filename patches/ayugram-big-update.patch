+#include <AyuPluginEngines/AyuPluginEngines.h>
+
+#include <stdlib.h>
+#include <string.h>
+
+#include "pocketpy.h"
+
+// One PocketPy VM per plugin (indices 1...15; 0 is the unused default VM). PocketPy keeps the
+// current VM in a global, so every call happens on the caller's single serial thread.
+
+#define AYU_PY_SLOTS 16
+
+/// The `ayu` API on top of `_ayuhost.call(json)`, and `__ayu_dispatch` for the app's calls.
+static const char *ayu_py_prelude =
+    "import json\n"
+    "import _ayuhost\n"
+    "def _ayu_req(obj):\n"
+    "    answer = _ayuhost.call(json.dumps(obj))\n"
+    "    return json.loads(answer) if answer else None\n"
+    "_ayu_handlers = {}\n"
+    "_ayu_events = {}\n"
+    "def _ayu_text(value):\n"
+    "    return '' if value is None else str(value)\n"
+    "class _AyuPoints:\n"
+    "    outgoing_text = 'message.outgoing.text'\n"
+    "    lyrics_text = 'lyrics.text'\n"
+    "class _AyuHooks:\n"
+    "    points = _AyuPoints\n"
+    "    def _register(self, point, mode, fn):\n"
+    "        hid = len(_ayu_handlers) + 1\n"
+    "        _ayu_handlers[hid] = fn\n"
+    "        _ayu_req({'op': 'hook', 'point': point, 'mode': mode, 'handler': hid})\n"
+    "        return fn\n"
+    "    def _make(self, mode, point, fn):\n"
+    "        if fn is None:\n"
+    "            return lambda f: self._register(point, mode, f)\n"
+    "        return self._register(point, mode, fn)\n"
+    "    def before(self, point, fn=None):\n"
+    "        return self._make('before', point, fn)\n"
+    "    def after(self, point, fn=None):\n"
+    "        return self._make('after', point, fn)\n"
+    "    def replace(self, point, fn=None):\n"
+    "        return self._make('replace', point, fn)\n"
+    "class _AyuFeatures:\n"
+    "    def disable(self, name):\n"
+    "        _ayu_req({'op': 'feature', 'name': name, 'disabled': True})\n"
+    "    def enable(self, name):\n"
+    "        _ayu_req({'op': 'feature', 'name': name, 'disabled': False})\n"
+    "class _AyuStorage:\n"
+    "    def get(self, key):\n"
+    "        r = _ayu_req({'op': 'storage.get', 'key': _ayu_text(key)})\n"
+    "        return r.get('value') if r else None\n"
+    "    def set(self, key, value):\n"
+    "        _ayu_req({'op': 'storage.set', 'key': _ayu_text(key), 'value': None if value is None else _ayu_text(value)})\n"
+    "class _AyuSettings:\n"
+    "    def declare(self, items):\n"
+    "        _ayu_req({'op': 'settings', 'items': items})\n"
+    "    def get(self, key):\n"
+    "        r = _ayu_req({'op': 'setting.get', 'key': key})\n"
+    "        return r.get('value') if r else None\n"
+    "class _AyuPlayer:\n"
+    "    def state(self):\n"
+    "        return _ayu_req({'op': 'player.state'}) or {}\n"
+    "    def control(self, action, value=None):\n"
+    "        r = _ayu_req({'op': 'player.control', 'action': action, 'value': value})\n"
+    "        return bool(r and r.get('ok'))\n"
+    "    def play(self):\n"
+    "        return self.control('play')\n"
+    "    def pause(self):\n"
+    "        return self.control('pause')\n"
+    "    def next(self):\n"
+    "        return self.control('next')\n"
+    "    def previous(self):\n"
+    "        return self.control('previous')\n"
+    "_ayu_pending = {}\n"
+    "def _ayu_copy(value):\n"
+    "    out = {}\n"
+    "    if isinstance(value, dict):\n"
+    "        for key in value:\n"
+    "            out[key] = value[key]\n"
+    "    return out\n"
+    "_ayu_next_request = [1]\n"
+    "def _ayu_call(op, args):\n"
+    "    obj = _ayu_copy(args)\n"
+    "    obj['op'] = op\n"
+    "    return _ayu_req(obj)\n"
+    "def _ayu_request(op, options, fn):\n"
+    "    rid = 'r' + str(_ayu_next_request[0])\n"
+    "    _ayu_next_request[0] += 1\n"
+    "    if fn is not None:\n"
+    "        _ayu_pending[rid] = fn\n"
+    "    opts = _ayu_copy(options)\n"
+    "    opts['requestId'] = rid\n"
+    "    return _ayu_call(op, opts)\n"
+    "class _AyuSection:\n"
+    "    def __init__(self, prefix, methods):\n"
+    "        self._prefix = prefix\n"
+    "        for name in methods:\n"
+    "            setattr(self, name, self._make(name))\n"
+    "    def _make(self, name):\n"
+    "        prefix = self._prefix\n"
+    "        def method(options=None, **kwargs):\n"
+    "            args = _ayu_copy(options) if isinstance(options, dict) else ({} if options is None else {'id': str(options)})\n"
+    "            for key in kwargs:\n"
+    "                args[key] = kwargs[key]\n"
+    "            return _ayu_call(prefix + '.' + name, args)\n"
+    "        return method\n"
+    "class _AyuGiftsCatalog:\n"
+    "    def list(self, fn):\n"
+    "        return _ayu_request('ui.gifts.catalog.list', {}, fn)\n"
+    "class _AyuGifts:\n"
+    "    catalog = _AyuGiftsCatalog()\n"
+    "class _AyuUI:\n"
+    "    gifts = _AyuGifts()\n"
+    "    menu = _AyuSection('ui.menu', ['add', 'remove'])\n"
+    "    profile = _AyuSection('ui.profile', ['addBlock', 'removeBlock', 'addButton', 'removeButton'])\n"
+    "    overlay = _AyuSection('ui.overlay', ['create', 'update', 'addText', 'addClock', 'showFPS', 'remove'])\n"
+    "    font = _AyuSection('ui.font', ['set', 'reset'])\n"
+    "    badge = _AyuSection('ui.badge', ['add', 'remove'])\n"
+    "    floatingButton = _AyuSection('ui.floatingButton', ['add', 'remove'])\n"
+    "    avatar = _AyuSection('ui.avatar', ['decorate', 'clear'])\n"
+    "    tabs = _AyuSection('ui.tabs', ['add', 'remove'])\n"
+    "    sidebar = _AyuSection('ui.sidebar', ['show'])\n"
+    "    searchBar = _AyuSection('ui.searchBar', ['show', 'setResults'])\n"
+    "    chatBackground = _AyuSection('ui.chatBackground', ['set', 'reset'])\n"
+    "    progress = _AyuSection('ui.progress', ['show', 'hide'])\n"
+    "    animation = _AyuSection('ui.animation', ['play'])\n"
+    "    def alert(self, options, fn=None):\n"
+    "        return _ayu_request('ui.alert', options, fn)\n"
+    "    def sheet(self, options, fn=None):\n"
+    "        return _ayu_request('ui.sheet', options, fn)\n"
+    "class _AyuNet:\n"
+    "    def fetch(self, url, fn=None, method='GET', headers=None, body=None):\n"
+    "        args = {'url': str(url), 'method': method}\n"
+    "        if headers is not None:\n"
+    "            args['headers'] = headers\n"
+    "        if body is not None:\n"
+    "            args['body'] = str(body)\n"
+    "        return _ayu_request('net.fetch', args, fn)\n"
