@@ -0,0 +1,40 @@
+import Foundation
+
+/// Shadow ban (AyuGram Desktop): messages of chosen people disappear from groups and channels
+/// on this device. They are still delivered; nothing is reported to anyone.
+public enum AyuShadowBan {
+    public static let didChangeNotification = Notification.Name("AyuGram.ShadowBanChanged")
+    private static let key = "ayu.shadowBan.users"
+    private static let lock = NSLock()
+    private static var cache: Set<Int64>?
+
+    public static var users: Set<Int64> {
+        lock.lock(); defer { lock.unlock() }
+        if cache == nil {
+            cache = Set((UserDefaults.standard.array(forKey: key) as? [NSNumber] ?? []).map { $0.int64Value })
+        }
+        return AyuDecoyMode.isActive ? [] : cache!
+    }
+
+    public static func contains(_ userId: Int64) -> Bool {
+        return users.contains(userId)
+    }
+
+    public static func set(_ userId: Int64, _ banned: Bool) {
+        lock.lock()
+        var value = cache ?? Set((UserDefaults.standard.array(forKey: key) as? [NSNumber] ?? []).map { $0.int64Value })
+        if banned { value.insert(userId) } else { value.remove(userId) }
+        cache = value
+        UserDefaults.standard.set(value.sorted().map { NSNumber(value: $0) }, forKey: key)
+        lock.unlock()
+        NotificationCenter.default.post(name: didChangeNotification, object: nil)
+    }
+
+    public static func clear() {
+        lock.lock()
+        cache = []
+        UserDefaults.standard.removeObject(forKey: key)
+        lock.unlock()
+        NotificationCenter.default.post(name: didChangeNotification, object: nil)
+    }
+}
diff --git a/submodules/Display/Source/AyuSpeechBleep.swift b/submodules/Display/Source/AyuSpeechBleep.swift
