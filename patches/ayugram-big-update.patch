@@ -0,0 +1,70 @@
+import Foundation
+import SwiftSignalKit
+import Display
+import TelegramCore
+import AccountContext
+
+/// "Now playing" in the profile bio: the playing track replaces the bio (at most once a minute,
+/// within the 70-character limit); turning it off puts the saved bio back.
+enum AyuNowPlaying {
+    static let enabledKey = "ayu.tools.nowPlayingBio"
+    private static let savedKey = "ayu.tools.nowPlayingSavedBio"
+    static weak var sharedContext: SharedAccountContext?
+    private static var lastUpdate = Date.distantPast
+    private static var lastText = ""
+
+    static var isEnabled: Bool {
+        return UserDefaults.standard.bool(forKey: enabledKey) && !AyuDecoyMode.isActive
+    }
+
+    private static func primary(_ completion: @escaping (AccountContext) -> Void) {
+        guard let sharedContext else { return }
+        let _ = (sharedContext.activeAccountContexts
+        |> take(1)
+        |> deliverOnMainQueue).startStandalone(next: { primary, _, _ in
+            if let primary {
+                completion(primary)
+            }
+        })
+    }
+
+    static func trackChanged(title: String, artist: String?) {
+        guard isEnabled, !title.isEmpty else { return }
+        var text = "🎧 " + (artist.map { $0 + " — " } ?? "") + title
+        if text.count > 70 {
+            text = String(text.prefix(69)) + "…"
+        }
+        guard text != lastText, Date().timeIntervalSince(lastUpdate) > 60.0 else { return }
+        lastUpdate = Date()
+        lastText = text
+        primary { context in
+            let save: Signal<Void, NoError>
+            if UserDefaults.standard.object(forKey: savedKey) == nil {
+                save = context.engine.data.get(TelegramEngine.EngineData.Item.Peer.AboutText(id: context.account.peerId))
+                |> map { about -> Void in
+                    UserDefaults.standard.set(about.knownValue.flatMap { $0 } ?? "", forKey: savedKey)
+                }
+            } else {
+                save = .single(Void())
+            }
+            let _ = (save
+            |> mapToSignal { _ -> Signal<Void, NoError> in
+                return context.engine.accountData.updateAbout(about: text)
+                |> `catch` { _ -> Signal<Void, NoError> in
+                    return .single(Void())
+                }
+            }).startStandalone()
+        }
+    }
+
+    /// Turning the option off restores the bio saved before the first track.
+    static func setEnabled(_ value: Bool) {
+        UserDefaults.standard.set(value, forKey: enabledKey)
+        guard !value, let saved = UserDefaults.standard.string(forKey: savedKey) else { return }
+        UserDefaults.standard.removeObject(forKey: savedKey)
+        lastText = ""
+        primary { context in
+            let _ = context.engine.accountData.updateAbout(about: saved).startStandalone()
+        }
+    }
+}
