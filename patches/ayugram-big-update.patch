diff --git a/submodules/TelegramCore/Sources/AyuGram/AyuHistoryTextDiff.swift b/submodules/TelegramCore/Sources/AyuGram/AyuHistoryTextDiff.swift
new file mode 100644
index 00000000..98873b0b
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuGram/AyuHistoryTextDiff.swift
@@ -0,0 +1,95 @@
+import Foundation
+
+/// Word-level changes with a bounded work budget. Text and composed Unicode characters
+/// are preserved exactly; long inputs fall back to one changed middle section.
+public enum AyuHistoryTextDiff {
+    public struct Span: Equatable {
+        public let text: String
+        public let changed: Bool
+        public init(text: String, changed: Bool) { self.text = text; self.changed = changed }
+    }
+
+    public struct Result: Equatable {
+        public let before: [Span]
+        public let after: [Span]
+    }
+
+    private static func tokens(_ text: String) -> [String] {
+        var result: [String] = []
+        var buffer = ""
+        var previous = -1
+        for character in text {
+            let kind = character.isWhitespace ? 0 : (character.isLetter || character.isNumber ? 1 : 2)
+            if kind != previous || kind == 2 {
+                if !buffer.isEmpty { result.append(buffer) }
+                buffer = ""
+            }
+            buffer.append(character)
+            previous = kind
+        }
+        if !buffer.isEmpty { result.append(buffer) }
+        return result
+    }
+
+    private static func append(_ text: String, changed: Bool, to spans: inout [Span]) {
+        guard !text.isEmpty else { return }
+        if let last = spans.last, last.changed == changed {
+            spans[spans.count - 1] = Span(text: last.text + text, changed: changed)
+        } else { spans.append(Span(text: text, changed: changed)) }
+    }
+
+    public static func compare(before: String, after: String) -> Result {
+        if before == after { return Result(before: [Span(text: before, changed: false)], after: [Span(text: after, changed: false)]) }
+        let a = self.tokens(before), b = self.tokens(after)
+        var left: [Span] = [], right: [Span] = []
+        if a.count > 500 || b.count > 500 {
+            let old = Array(before), new = Array(after)
+            var prefix = 0, suffix = 0
+            while prefix < min(old.count, new.count), old[prefix] == new[prefix] { prefix += 1 }
+            while suffix < min(old.count, new.count) - prefix, old[old.count - suffix - 1] == new[new.count - suffix - 1] { suffix += 1 }
+            for (characters, isBefore) in [(old, true), (new, false)] {
+                var spans: [Span] = []
+                self.append(String(characters.prefix(prefix)), changed: false, to: &spans)
+                self.append(String(characters[prefix..<(characters.count - suffix)]), changed: true, to: &spans)
+                self.append(String(characters.suffix(suffix)), changed: false, to: &spans)
+                if isBefore { left = spans } else { right = spans }
+            }
+            return Result(before: left, after: right)
+        }
+        let width = b.count + 1
+        var lengths = [Int](repeating: 0, count: (a.count + 1) * width)
+        for i in a.indices.reversed() {
+            for j in b.indices.reversed() {
+                lengths[i * width + j] = a[i] == b[j]
+                    ? lengths[(i + 1) * width + j + 1] + 1
+                    : max(lengths[(i + 1) * width + j], lengths[i * width + j + 1])
+            }
+        }
+        var i = 0, j = 0
+        while i < a.count || j < b.count {
+            if i < a.count, j < b.count, a[i] == b[j] {
+                self.append(a[i], changed: false, to: &left)
+                self.append(b[j], changed: false, to: &right)
+                i += 1; j += 1
+            } else if i < a.count && (j == b.count || lengths[(i + 1) * width + j] >= lengths[i * width + j + 1]) {
+                self.append(a[i], changed: true, to: &left); i += 1
+            } else {
+                self.append(b[j], changed: true, to: &right); j += 1
+            }
+        }
+        return Result(before: left, after: right)
+    }
+}
+
+public enum AyuLocalSearch {
+    public static func normalized(_ text: String) -> String {
+        return text.folding(options: [.caseInsensitive, .diacriticInsensitive], locale: Locale(identifier: "ru_RU"))
+            .replacingOccurrences(of: "ё", with: "е")
+    }
+
+    public static func matches(_ query: String, fields: [String]) -> Bool {
+        let words = self.normalized(String(query.prefix(200))).split(whereSeparator: { $0.isWhitespace })
+        let haystack = self.normalized(fields.joined(separator: " "))
+        return words.allSatisfy { haystack.contains($0) }
+    }
+}
diff --git a/submodules/TelegramCore/Sources/AyuGram/AyuHooks.swift b/submodules/TelegramCore/Sources/AyuGram/AyuHooks.swift
new file mode 100644
index 00000000..32e7bb96
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuGram/AyuHooks.swift
@@ -0,0 +1,240 @@
+import Foundation
+import CoreFoundation
+
+/// Hook points code plugins can intercept. TelegramCore only knows the registry; the
+/// JavaScript runtime that fills it lives in AccountContext.
+///
+/// For a text point the chain is: every `before` handler in registration order, then the
+/// native handler (or the first `replace` handler, which disables the native one), then
+/// every `after` handler. A handler that returns nil leaves the text unchanged.
+public final class AyuHooks {
+    public enum TextPoint: String, CaseIterable {
+        /// Plain outgoing text right before it is enqueued (JSON outgoing-replace plugins are
+        /// the native handler here).
+        case outgoingText = "message.outgoing.text"
+        /// Song lyrics before they are shown, one line per `\n` (inject: needs a trusted plugin).
+        case lyricsText = "lyrics.text"
+        /// A URL right before it opens (permission `links`).
+        case linkOpen = "link.open"
+        /// A message's text as shown in the chat; stored data never changes.
+        case messageRender = "message.render"
+        /// The text of a notification AyuGram itself shows (permission `notifications`).
+        case notificationBeforeShow = "notification.beforeShow"
+
+        /// The plugin permission a point needs, if any.
+        public var permission: String? {
+            switch self {
+            case .linkOpen: return "links"
+            case .notificationBeforeShow: return "notifications"
+            default: return nil
+            }
+        }
+
+        /// Points that change what the app itself shows or plays; only trusted (official, or
+        /// explicitly allowed) plugins may hook them.
+        public var isInject: Bool {
+            return self == .lyricsText
+        }
+    }
+
+    public enum Mode: String {
+        case before, replace, after
+    }
+
+    public struct TextContext {
+        public let peerId: Int64
+        public let isSecret: Bool
+        public init(peerId: Int64, isSecret: Bool) {
+            self.peerId = peerId
+            self.isSecret = isSecret
+        }
+    }
+
+    public typealias TextHandler = (String, TextContext) -> String?
+
+    private struct Registration {
+        let owner: String
+        let mode: Mode
+        let handler: TextHandler
+    }
+
+    /// Native features a plugin may switch off. Each maps onto an existing AyuGram interface
+    /// setting so every call site that already honours that setting honours the plugin too.
+    public enum Feature: String, CaseIterable {
+        case fastShare, messageShot, reactionPicker, readSummary, editedInfo, messageDetails
+        case stories, similarChannels, premiumStatuses, unreadCounters, greetingSticker
+        case openLinkWarning, doubleTapToEdit, formattingToolbar, keyboardHideOnScroll
+    }
+
+    public static let shared = AyuHooks()
+    public static let didChangeNotification = Notification.Name("AyuGram.HooksChanged")
+
+    private let lock = NSLock()
+    private var textHandlers: [TextPoint: [Registration]] = [:]
+    private var disabledFeatures: [String: Set<Feature>] = [:]
+    /// Union of `disabledFeatures`, kept current on every change: the settings store asks for
+    /// it on each read, which happens many times per frame while lists scroll.
+    private var disabledUnion: Set<Feature> = []
+    private var revision: Int = 0
+
+    private init() {}
+
+    public func register(point: TextPoint, mode: Mode, owner: String, handler: @escaping TextHandler) {
+        self.lock.lock()
+        self.textHandlers[point, default: []].append(Registration(owner: owner, mode: mode, handler: handler))
+        self.revision += 1
+        self.lock.unlock()
+        self.notify()
+    }
+
+    public func setFeature(_ feature: Feature, disabled: Bool, owner: String) {
+        self.lock.lock()
+        var set = self.disabledFeatures[owner] ?? []
+        if disabled { set.insert(feature) } else { set.remove(feature) }
+        self.disabledFeatures[owner] = set.isEmpty ? nil : set
+        self.disabledUnion = self.disabledFeatures.values.reduce(into: Set<Feature>()) { $0.formUnion($1) }
+        self.revision += 1
+        self.lock.unlock()
+        self.notify()
+    }
+
+    /// Drops every hook and feature override a plugin installed (on disable, unload or hang).
+    public func removeAll(owner: String) {
+        self.lock.lock()
+        for (point, list) in self.textHandlers {
+            self.textHandlers[point] = list.filter { $0.owner != owner }
+        }
+        self.disabledFeatures.removeValue(forKey: owner)
+        self.disabledUnion = self.disabledFeatures.values.reduce(into: Set<Feature>()) { $0.formUnion($1) }
+        self.revision += 1
+        self.lock.unlock()
+        self.notify()
+    }
+
+    public func hasHandlers(_ point: TextPoint) -> Bool {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return !(self.textHandlers[point]?.isEmpty ?? true)
+    }
+
+    /// Plugins with a handler on `point`, in registration order.
+    public func owners(_ point: TextPoint) -> [String] {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        var result: [String] = []
+        for registration in self.textHandlers[point] ?? [] where !result.contains(registration.owner) {
+            result.append(registration.owner)
+        }
+        return result
+    }
+
+    /// Who currently replaces the native handler of `point`, for the plugin screen.
+    public func replacingOwner(_ point: TextPoint) -> String? {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return self.textHandlers[point]?.first(where: { $0.mode == .replace })?.owner
+    }
+
+    public func run(_ point: TextPoint, text: String, context: TextContext, native: (String) -> String) -> String {
+        self.lock.lock()
+        let registrations = self.textHandlers[point] ?? []
+        self.lock.unlock()
+        if registrations.isEmpty {
+            return native(text)
+        }
+        var result = text
+        for registration in registrations where registration.mode == .before {
+            if let value = self.timed(registration, result, context) { result = value }
+        }
+        if let replacement = registrations.first(where: { $0.mode == .replace }) {
+            if let value = self.timed(replacement, result, context) { result = value }
+        } else {
+            result = native(result)
+        }
+        for registration in registrations where registration.mode == .after {
+            if let value = self.timed(registration, result, context) { result = value }
+        }
+        return result
+    }
+
+    // MARK: Profiler
+
+    public struct Timing {
+        public var calls: Int = 0
+        public var total: Double = 0.0
+        public var slowest: Double = 0.0
+    }
+
+    /// Posted once per plugin and launch when one of its hooks takes longer than 100 ms;
+    /// userInfo["owner"] is the plugin id.
+    public static let slowPluginNotification = Notification.Name("AyuGram.SlowPlugin")
+
+    private var timings: [String: Timing] = [:]
+    private var reportedSlow: Set<String> = []
+
+    private func timed(_ registration: Registration, _ text: String, _ context: TextContext) -> String? {
+        let start = CFAbsoluteTimeGetCurrent()
+        let value = registration.handler(text, context)
+        let elapsed = CFAbsoluteTimeGetCurrent() - start
+        self.lock.lock()
+        var timing = self.timings[registration.owner] ?? Timing()
+        timing.calls += 1
+        timing.total += elapsed
+        timing.slowest = max(timing.slowest, elapsed)
+        self.timings[registration.owner] = timing
+        let report = elapsed > 0.1 && self.reportedSlow.insert(registration.owner).inserted
+        self.lock.unlock()
+        if report {
+            let owner = registration.owner
+            DispatchQueue.main.async {
+                NotificationCenter.default.post(name: AyuHooks.slowPluginNotification, object: nil, userInfo: ["owner": owner, "seconds": elapsed])
+            }
+        }
+        return value
+    }
+
+    /// Hook calls, total and slowest time of one plugin since launch.
+    public func timing(owner: String) -> Timing? {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return self.timings[owner]
+    }
+
+    public var activeDisabledFeatures: Set<Feature> {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return self.disabledUnion
+    }
+
+    /// The account policy as the app should see it with plugin feature overrides applied.
+    func applyingOverrides(to settings: AyuGhostModeSettings) -> AyuGhostModeSettings {
+        let disabled = self.activeDisabledFeatures
+        guard !disabled.isEmpty else { return settings }
+        var settings = settings
+        for feature in disabled {
+            switch feature {
+            case .fastShare: settings.interface.hideFastShare = true
+            case .messageShot: settings.interface.showMessageShot = false
+            case .reactionPicker: settings.interface.showReactionPicker = false
+            case .readSummary: settings.interface.showReadSummary = false
+            case .editedInfo: settings.interface.showEditedInfo = false
+            case .messageDetails: settings.interface.showMessageDetails = false
+            case .stories: settings.interface.hideStories = true
+            case .similarChannels: settings.interface.hideSimilarChannels = true
+            case .premiumStatuses: settings.interface.hidePremiumStatuses = true
+            case .unreadCounters: settings.interface.hideUnreadCounters = true
+            case .greetingSticker: settings.interface.disableGreetingSticker = true
+            case .openLinkWarning: settings.interface.disableOpenLinkWarning = true
+            case .doubleTapToEdit: settings.interface.doubleTapToEdit = false
+            case .formattingToolbar: settings.interface.formattingToolbar = false
+            case .keyboardHideOnScroll: settings.interface.hideKeyboardOnScroll = false
+            }
+        }
+        return settings
+    }
+
+    private func notify() {
+        let post = { NotificationCenter.default.post(name: AyuHooks.didChangeNotification, object: nil) }
+        if Thread.isMainThread { post() } else { DispatchQueue.main.async(execute: post) }
+    }
+}
