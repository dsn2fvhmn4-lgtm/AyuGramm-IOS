+/// Privacy → Activity & traces → Hidden statuses: the 12 statuses one by one.
+func ayuActivityStatusesController(context: AccountContext) -> ViewController {
+    let kinds = AyuActivityFilter.Kind.allCases
+    let arguments = AyuSectionedArguments(open: { _ in }, toggle: { id, value in
+        let index = Int(id) - 1
+        guard index >= 0, index < kinds.count else { return }
+        AyuActivityFilter.setHidden(kinds[index], value)
+        NotificationCenter.default.post(name: ayuLocalSettingsChanged, object: nil)
+    })
+    let signal = combineLatest(context.sharedContext.presentationData, ayuChanges([ayuLocalSettingsChanged]))
+    |> deliverOnMainQueue
+    |> map { presentationData, _ -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        let hidden = AyuActivityFilter.hidden
+        var entries: [AyuSectionedEntry] = [.header(1, 0, ru ? "НЕ ОТПРАВЛЯТЬ" : "NEVER SEND")]
+        for (index, kind) in kinds.enumerated() {
+            entries.append(.toggle(1, Int32(index + 1), nil, kind.title(ru), nil, hidden.contains(kind)))
+        }
+        entries.append(.info(1, 99, ru ? "Включённые статусы не уходят собеседникам. Остальные решает режим призрака." : "Statuses switched on here never reach anyone. Ghost Mode decides the rest."))
+        let data = ItemListPresentationData(presentationData)
+        let state = ItemListControllerState(presentationData: data, title: .text(ru ? "Статусы активности" : "Activity statuses"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        return (state, (ItemListNodeState(presentationData: data, entries: entries, style: .blocks, animateChanges: false), arguments))
+    }
+    return ItemListController(context: context, state: signal)
+}
