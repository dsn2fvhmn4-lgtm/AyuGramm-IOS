+import AccountContext
+
+// Settings → AyuGram → Developer. Every switch defaults to off; the page only exposes
+// diagnostics and local presentation toggles, never account or network behaviour.
+
+private enum AyuDeveloperRow: Int32 {
+    case playerDebugOverlay = 1
+    case fpsCounter = 2
+    case slowAnimations = 3
+    case highlightAyuViews = 4
+    case forceStockMusicPlayer = 11
+    case lyricsDiagnostics = 12
+    case pluginConsole = 21
+    case experimentalPluginHooks = 22
+    case openPluginConsole = 23
+    case showInternalIds = 31
+    case verboseLogging = 41
+    case shareLog = 42
+    case clearLog = 43
+    case resetAll = 51
+}
+
+func ayuDeveloperSettingsController(context: AccountContext) -> ViewController {
+    var presentNative: ((UIViewController) -> Void)?
+    var push: ((ViewController) -> Void)?
+    var presentController: ((ViewController) -> Void)?
+    let store = AyuDeveloperSettings.shared
+
+    let arguments = AyuSectionedArguments(open: { id in
+        guard let row = AyuDeveloperRow(rawValue: id) else { return }
+        let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+        let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        switch row {
+        case .shareLog:
+            guard let url = AyuDevLog.shared.fileURL, FileManager.default.fileExists(atPath: url.path) else {
+                presentController?(textAlertController(context: context, title: "AyuGram", text: ru ? "Журнал пока пуст. Включите подробный журнал и повторите действие." : "The log is empty. Turn on verbose logging and reproduce the issue.", actions: [TextAlertAction(type: .defaultAction, title: presentationData.strings.Common_OK, action: {})]))
+                return
+            }
+            presentNative?(UIActivityViewController(activityItems: [url], applicationActivities: nil))
+        case .clearLog:
+            AyuDevLog.shared.clear()
+        case .openPluginConsole:
+            push?(ayuPluginConsoleController(context: context))
+        case .resetAll:
+            presentController?(textAlertController(context: context, title: ru ? "Сбросить настройки разработчика?" : "Reset developer settings?", text: ru ? "Все переключатели на этой странице будут выключены." : "Every switch on this page will be turned off.", actions: [
+                TextAlertAction(type: .genericAction, title: presentationData.strings.Common_Cancel, action: {}),
+                TextAlertAction(type: .destructiveAction, title: ru ? "Сбросить" : "Reset", action: { store.resetAll() })
+            ]))
+        default:
+            break
+        }
+    }, toggle: { id, value in
+        guard let row = AyuDeveloperRow(rawValue: id) else { return }
+        store.update { settings in
+            switch row {
+            case .playerDebugOverlay: settings.playerDebugOverlay = value
+            case .fpsCounter: settings.fpsCounter = value
+            case .slowAnimations: settings.slowAnimations = value
+            case .highlightAyuViews: settings.highlightAyuViews = value
+            case .forceStockMusicPlayer: settings.forceStockMusicPlayer = value
+            case .lyricsDiagnostics: settings.lyricsDiagnostics = value
+            case .pluginConsole: settings.pluginConsole = value
+            case .experimentalPluginHooks: settings.experimentalPluginHooks = value
+            case .showInternalIds: settings.showInternalIds = value
+            case .verboseLogging: settings.verboseLogging = value
+            default: break
+            }
+        }
+    })
+
+    func symbol(_ name: String, _ color: UInt32) -> UIImage? {
+        return AyuSettingsIcons.symbol(name, color: UIColor(rgb: color))
+    }
+
+    let signal = combineLatest(context.sharedContext.presentationData, store.signal)
+    |> deliverOnMainQueue
+    |> map { presentationData, settings -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        func toggle(_ section: Int32, _ row: AyuDeveloperRow, _ icon: UIImage?, _ title: String, _ text: String?, _ value: Bool) -> AyuSectionedEntry {
+            return .toggle(section, row.rawValue, icon, title, text, value)
+        }
+        var entries: [AyuSectionedEntry] = [
+            .header(1, 0, ru ? "ИНТЕРФЕЙС" : "INTERFACE"),
+            toggle(1, .playerDebugOverlay, symbol("ladybug.fill", 0xFF3B30), ru ? "Отладка плеера" : "Player debug overlay", ru ? "Состояние воспроизведения в правом нижнем углу плеера" : "Playback state in the player's bottom-right corner", settings.playerDebugOverlay),
+            toggle(1, .fpsCounter, symbol("speedometer", 0x34C759), ru ? "Счётчик FPS" : "FPS counter", nil, settings.fpsCounter),
+            toggle(1, .highlightAyuViews, symbol("square.dashed", 0xAF52DE), ru ? "Подсветить элементы AyuGram" : "Outline AyuGram views", nil, settings.highlightAyuViews),
+            .header(2, 10, ru ? "МУЗЫКА" : "MUSIC"),
+            toggle(2, .forceStockMusicPlayer, symbol("music.note", 0xFF2D55), ru ? "Стандартный плеер Telegram" : "Stock Telegram player", ru ? "Вместо плеера AyuGram" : "Instead of the AyuGram player", settings.forceStockMusicPlayer),
+            toggle(2, .lyricsDiagnostics, symbol("text.quote", 0x5856D6), ru ? "Диагностика текстов" : "Lyrics diagnostics", ru ? "Источник, совпадение и время поиска" : "Source, match score and lookup time", settings.lyricsDiagnostics),
+            .header(3, 20, ru ? "ПЛАГИНЫ" : "PLUGINS"),
+            toggle(3, .pluginConsole, symbol("terminal.fill", 0x8E8E93), ru ? "Консоль плагинов" : "Plugin console", ru ? "Вывод print() и ошибки скриптов" : "Script print() output and errors", settings.pluginConsole),
+            toggle(3, .experimentalPluginHooks, symbol("flask.fill", 0xFF9500), ru ? "Мягкие лимиты плагинов" : "Relaxed plugin limits", ru ? "Таймаут хуков 2 с вместо 0,25 с, ошибки скриптов всплывают сообщением" : "2 s hook timeout instead of 0.25 s; script errors show as toasts", settings.experimentalPluginHooks)
+        ]
+        if settings.pluginConsole {
+            entries.append(.link(3, AyuDeveloperRow.openPluginConsole.rawValue, symbol("list.bullet.rectangle.fill", 0x007AFF), ru ? "Открыть консоль" : "Open console", ""))
+        }
+        entries.append(contentsOf: [
+            .header(4, 30, ru ? "ДАННЫЕ" : "DATA"),
+            toggle(4, .showInternalIds, symbol("number", 0x32ADE6), ru ? "Внутренние ID в меню" : "Internal IDs in menus", nil, settings.showInternalIds),
+            .header(5, 40, ru ? "ЖУРНАЛ" : "LOG"),
+            toggle(5, .verboseLogging, symbol("doc.text.fill", 0x8E8E93), ru ? "Подробный журнал" : "Verbose logging", ru ? "Плагины, тексты, распознавание; хранится только на устройстве" : "Plugins, lyrics, recognition; stays on this device", settings.verboseLogging),
+            .link(5, AyuDeveloperRow.shareLog.rawValue, symbol("square.and.arrow.up", 0x007AFF), ru ? "Поделиться журналом" : "Share log", ""),
+            .link(5, AyuDeveloperRow.clearLog.rawValue, symbol("trash.fill", 0xFF3B30), ru ? "Очистить журнал" : "Clear log", ""),
+            .header(6, 50, ""),
+            .link(6, AyuDeveloperRow.resetAll.rawValue, symbol("arrow.counterclockwise", 0xFF3B30), ru ? "Сбросить всё" : "Reset all", settings.anyEnabled ? "" : (ru ? "всё выключено" : "all off")),
+            .info(6, 52, ru ? "Эти настройки предназначены для отладки и по умолчанию выключены." : "These settings are meant for debugging and are off by default.")
+        ])
+        let data = ItemListPresentationData(presentationData)
+        let state = ItemListControllerState(presentationData: data, title: .text(ru ? "Для разработчиков" : "Developer"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        return (state, (ItemListNodeState(presentationData: data, entries: entries, style: .blocks, animateChanges: true), arguments))
+    }
+    let controller = ItemListController(context: context, state: signal)
+    push = { [weak controller] in controller?.push($0) }
+    presentController = { [weak controller] in controller?.present($0, in: .window(.root)) }
+    presentNative = { viewController in
+        context.sharedContext.applicationBindings.presentNativeController(viewController)
+    }
+    return controller
+}
