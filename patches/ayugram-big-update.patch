+
+/// Plugins watching TL traffic; events go only to them.
+enum AyuTLObservers {
+    private static let lock = NSLock()
+    private static var owners = Set<String>()
+
+    static func add(_ owner: String) {
+        lock.lock()
+        owners.insert(owner)
+        lock.unlock()
+        AyuTLHooks.onRequest = { method, error in
+            for owner in current() {
+                AyuScriptRuntime.shared.emit("tlRequest", ["method": method, "error": error.map { Int($0) as Any } ?? NSNull()], only: owner)
+            }
+        }
+        AyuTLHooks.onUpdates = { names in
+            for owner in current() {
+                AyuScriptRuntime.shared.emit("tlUpdate", ["updates": names], only: owner)
+            }
+        }
+        AyuTLHooks.setObserving(true)
+    }
+
+    static func remove(_ owner: String) {
+        lock.lock()
+        owners.remove(owner)
+        let empty = owners.isEmpty
+        lock.unlock()
+        AyuTLHooks.removeAll(owner: owner)
+        if empty {
+            AyuTLHooks.setObserving(false)
+        }
+    }
+
+    private static func current() -> Set<String> {
+        lock.lock()
+        defer { lock.unlock() }
+        return owners
+    }
+}
+
+/// `ayu.player.spectrum.subscribe`: sends "playerSpectrum" { bands, level } to a plugin at up to
+/// 30 updates a second while it listens.
+enum AyuPluginSpectrumFeed {
+    private static let lock = NSLock()
+    private static var timers: [String: DispatchSourceTimer] = [:]
+    private static let queue = DispatchQueue(label: "AyuGram.Plugins.Spectrum", qos: .userInitiated)
+
+    static func start(owner: String, bands: Int, fps: Double) {
+        stop(owner: owner)
+        let interval = 1.0 / max(1.0, min(30.0, fps))
+        let count = max(4, min(64, bands))
+        let timer = DispatchSource.makeTimerSource(queue: queue)
+        timer.schedule(deadline: .now(), repeating: interval)
+        timer.setEventHandler {
+            let values = AyuAudioSpectrum.shared.bands(count: count).map { (Double($0) * 1000.0).rounded() / 1000.0 }
+            AyuPluginUI.send("playerSpectrum", to: owner, ["bands": values, "level": values.max() ?? 0.0])
+        }
+        AyuAudioSpectrum.shared.addListener()
+        lock.lock()
+        timers[owner] = timer
+        lock.unlock()
+        timer.resume()
+    }
+
+    static func stop(owner: String) {
+        lock.lock()
+        let timer = timers.removeValue(forKey: owner)
+        lock.unlock()
+        if let timer {
+            timer.cancel()
+            AyuAudioSpectrum.shared.removeListener()
+        }
+    }
+
+    /// Listens for two seconds so a plugin polling with `get` sees real values.
+    static func touch() {
+        AyuAudioSpectrum.shared.addListener()
+        queue.asyncAfter(deadline: .now() + 2.0) {
+            AyuAudioSpectrum.shared.removeListener()
+        }
+    }
+}
