diff --git a/submodules/TelegramCore/Sources/AyuGram/AyuBotAuthorization.swift b/submodules/TelegramCore/Sources/AyuGram/AyuBotAuthorization.swift
new file mode 100644
index 00000000..3c5a53bf
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuGram/AyuBotAuthorization.swift
@@ -0,0 +1,67 @@
+import Foundation
+import Postbox
+import SwiftSignalKit
+internal import TelegramApi
+import MtProtoKit
+
+public enum AyuBotAuthorizationError: Equatable {
+    case invalidToken
+    case flood
+    case generic(String)
+}
+
+/// Signs this unauthorized account in as a bot with a BotFather token (`auth.importBotAuthorization`),
+/// following the bot's datacenter if the server redirects, then switches to the authorized
+/// account exactly as a phone or QR sign-in does.
+public func ayuAuthorizeWithBotToken(accountManager: AccountManager<TelegramAccountManagerTypes>, account: UnauthorizedAccount, apiId: Int32, apiHash: String, token: String) -> Signal<Void, AyuBotAuthorizationError> {
+    let trimmed = token.trimmingCharacters(in: .whitespacesAndNewlines)
+    // "123456789:AA…" — numeric bot id, colon, secret.
+    guard let colon = trimmed.firstIndex(of: ":"), Int64(trimmed[trimmed.startIndex ..< colon]) != nil, trimmed.count >= 30, trimmed.count <= 120 else {
+        return .fail(.invalidToken)
+    }
+    let request = Api.functions.auth.importBotAuthorization(flags: 0, apiId: apiId, apiHash: apiHash, botAuthToken: trimmed)
+
+    func attempt(_ account: UnauthorizedAccount, followRedirect: Bool) -> Signal<(Api.auth.Authorization, UnauthorizedAccount), AyuBotAuthorizationError> {
+        return account.network.request(request, automaticFloodWait: false)
+        |> map { result -> (Api.auth.Authorization, UnauthorizedAccount) in
+            return (result, account)
+        }
+        |> `catch` { error -> Signal<(Api.auth.Authorization, UnauthorizedAccount), AyuBotAuthorizationError> in
+            let description = error.errorDescription ?? ""
+            if followRedirect, let range = description.range(of: "_MIGRATE_"), let datacenter = Int32(description[range.upperBound...]) {
+                return account.changedMasterDatacenterId(accountManager: accountManager, masterDatacenterId: datacenter)
+                |> castError(AyuBotAuthorizationError.self)
+                |> mapToSignal { updated -> Signal<(Api.auth.Authorization, UnauthorizedAccount), AyuBotAuthorizationError> in
+                    return attempt(updated, followRedirect: false)
+                }
+            }
+            if description.hasPrefix("ACCESS_TOKEN_") || description.hasPrefix("BOT_") || description == "AUTH_KEY_INVALID" {
+                return .fail(.invalidToken)
+            }
+            if description.hasPrefix("FLOOD_WAIT") {
+                return .fail(.flood)
+            }
+            return .fail(.generic(description))
+        }
+    }
+
+    return attempt(account, followRedirect: true)
+    |> mapToSignal { authorization, account -> Signal<Void, AyuBotAuthorizationError> in
+        switch authorization {
+        case let .authorization(authorizationData):
+            return account.postbox.transaction { transaction -> Signal<Void, NoError> in
+                let user = TelegramUser(user: authorizationData.user)
+                let state = AuthorizedAccountState(isTestingEnvironment: account.testingEnvironment, masterDatacenterId: account.masterDatacenterId, peerId: user.id, state: nil, invalidatedChannels: [])
+                initializedAppSettingsAfterLogin(transaction: transaction, appVersion: account.networkArguments.appVersion, syncContacts: false)
+                transaction.setState(state)
+                return accountManager.transaction { transaction -> Void in
+                    switchToAuthorizedAccount(transaction: transaction, account: account, isSupportUser: false)
+                }
+            }
+            |> switchToLatest
+            |> castError(AyuBotAuthorizationError.self)
+        case .authorizationSignUpRequired:
+            return .fail(.generic("SIGN_UP_REQUIRED"))
+        }
+    }
+}
diff --git a/submodules/TelegramCore/Sources/AyuGram/AyuDecoyState.swift b/submodules/TelegramCore/Sources/AyuGram/AyuDecoyState.swift
new file mode 100644
index 00000000..df8a621d
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuGram/AyuDecoyState.swift
@@ -0,0 +1,145 @@
+import Foundation
+import CryptoKit
+
+/// AyuGram decoy mode (Settings → AyuGram → Privacy → Decoy mode).
+///
+/// A double tap on the launch splash switches to a decoy: a second, real account when one is
+/// chosen, otherwise a built-in stand-in Telegram. While the decoy is active every AyuGram feature
+/// is off and AyuGram is absent from the settings. The next cold start asks for a code: the real
+/// code returns to the real account; the fake code shows "AyuGram no longer works" and wipes the
+/// local data on the following launch, before any database is opened.
+public enum AyuDecoyState {
+    public enum CodeCheck {
+        case real
+        case fake
+        case wrong
+    }
+
+    private static let prefix = "ayu.decoy."
+    public static let activeKey = "ayu.decoy.active"
+
+    /// Decoy mode is set up: both codes exist.
+    public static var isConfigured: Bool {
+        return UserDefaults.standard.bool(forKey: prefix + "enabled") && !(UserDefaults.standard.string(forKey: prefix + "real") ?? "").isEmpty && !(UserDefaults.standard.string(forKey: prefix + "fake") ?? "").isEmpty
+    }
+
+    public static var hasCodes: Bool {
+        return !(UserDefaults.standard.string(forKey: prefix + "real") ?? "").isEmpty && !(UserDefaults.standard.string(forKey: prefix + "fake") ?? "").isEmpty
+    }
+
+    public static var isEnabled: Bool {
+        get { return UserDefaults.standard.bool(forKey: prefix + "enabled") }
+        set { UserDefaults.standard.set(newValue, forKey: prefix + "enabled") }
+    }
+
+    /// The decoy is showing now: AyuGram features are off.
+    public static var isActive: Bool {
+        return UserDefaults.standard.bool(forKey: activeKey)
+    }
+
+    /// The next cold start must ask for a code.
+    public static var codeRequired: Bool {
+        return UserDefaults.standard.bool(forKey: prefix + "codeRequired")
+    }
+
+    /// The account shown as the decoy (an AccountRecordId value), or nil for the stand-in Telegram.
+    public static var decoyAccountId: Int64? {
+        get {
+            let value = UserDefaults.standard.object(forKey: prefix + "account") as? NSNumber
+            return value?.int64Value
+        }
+        set {
+            if let newValue {
+                UserDefaults.standard.set(NSNumber(value: newValue), forKey: prefix + "account")
+            } else {
+                UserDefaults.standard.removeObject(forKey: prefix + "account")
+            }
+        }
+    }
+
+    /// The real account to return to after the real code.
+    public static var mainAccountId: Int64? {
+        get { return (UserDefaults.standard.object(forKey: prefix + "main") as? NSNumber)?.int64Value }
+        set {
+            if let newValue {
+                UserDefaults.standard.set(NSNumber(value: newValue), forKey: prefix + "main")
+            } else {
+                UserDefaults.standard.removeObject(forKey: prefix + "main")
+            }
+        }
+    }
+
+    private static func hash(_ code: String) -> String {
+        var salt = UserDefaults.standard.string(forKey: prefix + "salt") ?? ""
+        if salt.isEmpty {
+            salt = UUID().uuidString
+            UserDefaults.standard.set(salt, forKey: prefix + "salt")
+        }
+        return SHA256.hash(data: Data((salt + ":" + code).utf8)).map { String(format: "%02x", $0) }.joined()
+    }
+
+    /// Both codes at once; they must differ and be at least 4 characters.
+    public static func setCodes(real: String, fake: String) -> Bool {
+        guard real.count >= 4, fake.count >= 4, real != fake else { return false }
+        UserDefaults.standard.set(hash(real), forKey: prefix + "real")
+        UserDefaults.standard.set(hash(fake), forKey: prefix + "fake")
+        return true
+    }
+
+    public static func check(_ code: String) -> CodeCheck {
+        let value = hash(code)
+        if value == UserDefaults.standard.string(forKey: prefix + "real") {
+            return .real
+        }
+        if value == UserDefaults.standard.string(forKey: prefix + "fake") {
+            return .fake
+        }
+        return .wrong
+    }
+
+    public static func enter() {
+        UserDefaults.standard.set(true, forKey: activeKey)
+        UserDefaults.standard.set(true, forKey: prefix + "codeRequired")
+    }
+
+    /// The real code was entered: back to the real account, no code until the next decoy.
+    public static func leave() {
+        UserDefaults.standard.set(false, forKey: activeKey)
+        UserDefaults.standard.set(false, forKey: prefix + "codeRequired")
+    }
+
+    // MARK: Fake code
+
+    public static var isBroken: Bool {
+        return UserDefaults.standard.bool(forKey: prefix + "broken")
+    }
+
+    public static var wipePending: Bool {
+        return UserDefaults.standard.bool(forKey: prefix + "wipePending")
+    }
+
+    /// The fake code was entered: the app stays broken and wipes its data on the next launch.
+    public static func markBroken() {
+        UserDefaults.standard.set(true, forKey: prefix + "broken")
+        UserDefaults.standard.set(true, forKey: prefix + "wipePending")
+    }
+
+    /// Deletes every account's local data and AyuGram's own files and settings. Runs at launch
+    /// before anything is opened. Only the "broken" mark stays, until the app is reinstalled.
+    public static func wipe(rootPath: String, extraPaths: [String]) {
+        let manager = FileManager.default
+        for path in [rootPath] + extraPaths {
+            if let items = try? manager.contentsOfDirectory(atPath: path) {
+                for item in items {
+                    try? manager.removeItem(atPath: (path as NSString).appendingPathComponent(item))
+                }
+            }
+        }
+        let defaults = UserDefaults.standard
+        for key in defaults.dictionaryRepresentation().keys where key.hasPrefix("ayu.") {
+            defaults.removeObject(forKey: key)
+        }
+        defaults.set(true, forKey: prefix + "broken")
+        defaults.set(false, forKey: prefix + "wipePending")
+    }
+}
