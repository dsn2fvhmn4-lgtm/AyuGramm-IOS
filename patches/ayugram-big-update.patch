+            out[o++] = (char)(0xC0 | (code >> 6));
+            out[o++] = (char)(0x80 | (code & 0x3F));
+        } else if (code < 0x10000) {
+            out[o++] = (char)(0xE0 | (code >> 12));
+            out[o++] = (char)(0x80 | ((code >> 6) & 0x3F));
+            out[o++] = (char)(0x80 | (code & 0x3F));
+        } else {
+            out[o++] = (char)(0xF0 | (code >> 18));
+            out[o++] = (char)(0x80 | ((code >> 12) & 0x3F));
+            out[o++] = (char)(0x80 | ((code >> 6) & 0x3F));
+            out[o++] = (char)(0x80 | (code & 0x3F));
+        }
+        i += consumed - 1;
+    }
+    out[o] = 0;
+    return out;
+}
+
+/// PocketPy's json.dumps writes control characters as `\xHH`, which is not JSON: turn them into
+/// `\u00HH` on the way out. Escaped backslashes are skipped, so `\\x41` stays text.
+static char *ayu_json_hex_escapes(const char *in) {
+    size_t length = strlen(in);
+    size_t count = 0;
+    for (size_t i = 0; i + 3 < length; i++) {
+        if (in[i] == '\\') {
+            if (in[i + 1] == 'x' && ayu_hex_digit(in[i + 2]) >= 0 && ayu_hex_digit(in[i + 3]) >= 0) count++;
+            i++;
+        }
+    }
+    if (count == 0) return ayu_strdup(in);
+    char *out = malloc(length + 2 * count + 1);
+    if (out == NULL) return NULL;
+    size_t o = 0;
+    for (size_t i = 0; i < length; i++) {
+        if (in[i] == '\\' && i + 1 < length) {
+            if (in[i + 1] == 'x' && i + 3 < length && ayu_hex_digit(in[i + 2]) >= 0 && ayu_hex_digit(in[i + 3]) >= 0) {
+                memcpy(out + o, "\\u00", 4);
+                out[o + 4] = in[i + 2];
+                out[o + 5] = in[i + 3];
+                o += 6;
+                i += 3;
+            } else {
+                out[o++] = in[i];
+                out[o++] = in[i + 1];
+                i++;
+            }
+            continue;
+        }
+        out[o++] = in[i];
+    }
+    out[o] = 0;
+    return out;
+}
+
+static void ayu_py_take_exception(char **error) {
+    char *message = py_formatexc();
+    if (error != NULL) {
+        *error = ayu_strdup(message != NULL ? message : "Python error");
+    }
+    if (message != NULL) {
+        py_free(message);
+    }
+    py_clearexc(NULL);
+}
+
+// `_ayuhost.call(request: str) -> str | None`
+static bool ayu_py_host_call(int argc, py_StackRef argv) {
+    PY_CHECK_ARGC(1);
+    PY_CHECK_ARG_TYPE(0, tp_str);
+    int index = py_currentvm();
+    char *answer = NULL;
+    if (index > 0 && index < AYU_PY_SLOTS && ayu_py_hosts[index] != NULL) {
+        char *request = ayu_json_hex_escapes(py_tostr(py_arg(0)));
+        if (request != NULL) {
+            answer = ayu_py_hosts[index](ayu_py_contexts[index], request);
+            free(request);
+        }
+    }
+    if (answer != NULL) {
+        char *plain = ayu_json_plain_escapes(answer);
+        free(answer);
+        if (plain == NULL) {
+            py_newnone(py_retval());
+            return true;
+        }
+        py_newstr(py_retval(), plain);
+        free(plain);
+    } else {
+        py_newnone(py_retval());
+    }
+    return true;
+}
+
+static bool ayu_py_noop(int argc, py_StackRef argv) {
+    py_newnone(py_retval());
+    return true;
+}
+
+// No file imports: a plugin is one source file plus the built-in modules.
+static char *ayu_py_refuse_import(const char *path, int *size) {
+    if (size != NULL) {
+        *size = 0;
+    }
+    return NULL;
+}
+
+static void ayu_py_discard_print(const char *text) {
+}
+
+int ayu_python_create(const char *source, const char *filename, int32_t timeout_ms, AyuEngineHostFunction host, void *context, char **error) {
+    if (!ayu_py_initialized) {
+        py_initialize();
+        ayu_py_initialized = true;
+    }
+    int index = -1;
+    for (int i = 1; i < AYU_PY_SLOTS; i++) {
+        if (!ayu_py_used[i]) {
+            index = i;
+            break;
+        }
+    }
+    if (index < 0) {
+        if (error != NULL) {
+            *error = ayu_strdup("Too many Python plugins are running (15 at most).");
+        }
+        return -1;
+    }
+    py_switchvm(index);
+    py_resetvm();
+    ayu_py_used[index] = true;
+    ayu_py_hosts[index] = host;
+    ayu_py_contexts[index] = context;
+
+    py_Callbacks *callbacks = py_callbacks();
+    callbacks->importfile = ayu_py_refuse_import;
+    callbacks->print = ayu_py_discard_print;
+
+    py_GlobalRef module = py_newmodule("_ayuhost");
+    py_bindfunc(module, "call", ayu_py_host_call);
+    // A plugin must not be able to lift its own time limit.
+    py_GlobalRef pkpy = py_getmodule("pkpy");
+    if (pkpy != NULL) {
+        py_bindfunc(pkpy, "watchdog_begin", ayu_py_noop);
+        py_bindfunc(pkpy, "watchdog_end", ayu_py_noop);
+    }
+
+    py_watchdog_begin(timeout_ms);
+    bool ok = py_exec(ayu_py_prelude, "<ayu>", EXEC_MODE, NULL);
+    if (ok) {
+        ok = py_exec(source, filename, EXEC_MODE, NULL);
+    }
+    py_watchdog_end();
+    if (!ok) {
+        ayu_py_take_exception(error);
+        ayu_python_destroy(index);
+        return -1;
+    }
+    return index;
+}
+
+char *ayu_python_dispatch(int handle, const char *request, int32_t timeout_ms, char **error) {
+    if (handle <= 0 || handle >= AYU_PY_SLOTS || !ayu_py_used[handle]) {
+        if (error != NULL) {
+            *error = ayu_strdup("The plugin is not running.");
+        }
+        return NULL;
+    }
+    py_switchvm(handle);
+    py_ItemRef function = py_getglobal(py_name("__ayu_dispatch"));
+    if (function == NULL || !py_callable(function)) {
+        if (error != NULL) {
+            *error = ayu_strdup("__ayu_dispatch is missing.");
+        }
+        return NULL;
+    }
+    char *plain = ayu_json_plain_escapes(request);
+    if (plain == NULL) {
+        return NULL;
+    }
+    py_StackRef argument = py_pushtmp();
+    py_newstr(argument, plain);
+    free(plain);
+    py_watchdog_begin(timeout_ms);
+    bool ok = py_call(function, 1, argument);
+    py_watchdog_end();
+    py_pop();
+    if (!ok) {
+        ayu_py_take_exception(error);
+        return NULL;
+    }
+    py_GlobalRef result = py_retval();
+    if (py_isstr(result)) {
+        return ayu_json_hex_escapes(py_tostr(result));
+    }
+    return NULL;
+}
+
+void ayu_python_destroy(int handle) {
+    if (handle <= 0 || handle >= AYU_PY_SLOTS || !ayu_py_used[handle]) {
+        return;
+    }
+    py_switchvm(handle);
+    py_resetvm();
+    py_switchvm(0);
+    ayu_py_used[handle] = false;
+    ayu_py_hosts[handle] = NULL;
+    ayu_py_contexts[handle] = NULL;
+}
diff --git a/submodules/AyuPluginEngines/Sources/AyuWasmEngine.c b/submodules/AyuPluginEngines/Sources/AyuWasmEngine.c
new file mode 100644
index 00000000..ca0067ac
--- /dev/null
+++ b/submodules/AyuPluginEngines/Sources/AyuWasmEngine.c
@@ -0,0 +1,220 @@
+#include <AyuPluginEngines/AyuPluginEngines.h>
+
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "wasm_export.h"
+
+// Rust (or any language) compiled to WebAssembly, run by WAMR's interpreter (no JIT, no AOT).
+// The module's only import is `ayu.host(ptr, len) -> i64`; strings travel through its memory.
+
+struct AyuWasmPlugin {
+    uint8_t *bytes;
+    wasm_module_t module;
+    wasm_module_inst_t instance;
+    wasm_function_inst_t allocate;
+    wasm_function_inst_t release;
+    wasm_function_inst_t dispatch;
+    AyuEngineHostFunction host;
+    void *context;
+};
+
+static pthread_once_t ayu_wasm_once = PTHREAD_ONCE_INIT;
+static bool ayu_wasm_ready = false;
+
+static uint64_t ayu_wasm_host_import(wasm_exec_env_t env, uint32_t pointer, uint32_t length);
+
+static NativeSymbol ayu_wasm_symbols[] = {
+    { "host", (void *)ayu_wasm_host_import, "(ii)I", NULL }
+};
+
+static void ayu_wasm_initialize(void) {
+    RuntimeInitArgs args;
+    memset(&args, 0, sizeof(args));
+    args.mem_alloc_type = Alloc_With_System_Allocator;
+    if (!wasm_runtime_full_init(&args)) {
+        return;
+    }
+    ayu_wasm_ready = wasm_runtime_register_natives("ayu", ayu_wasm_symbols, sizeof(ayu_wasm_symbols) / sizeof(ayu_wasm_symbols[0]));
+}
+
+static char *ayu_wasm_strdup(const char *string) {
+    size_t length = strlen(string);
+    char *copy = malloc(length + 1);
+    if (copy != NULL) {
+        memcpy(copy, string, length + 1);
+    }
+    return copy;
+}
+
+static void ayu_wasm_set_error(char **error, const char *message) {
+    if (error != NULL) {
+        *error = ayu_wasm_strdup(message != NULL ? message : "WebAssembly error");
+    }
+}
+
+/// Copies `length` bytes into memory the module allocates; returns the module address or 0.
+static uint32_t ayu_wasm_copy_in(AyuWasmPlugin *plugin, wasm_exec_env_t env, const char *data, uint32_t length) {
+    uint32_t argv[1] = { length };
+    if (!wasm_runtime_call_wasm(env, plugin->allocate, 1, argv)) {
+        return 0;
+    }
+    uint32_t address = argv[0];
+    if (address == 0 || !wasm_runtime_validate_app_addr(plugin->instance, address, length)) {
+        return 0;
+    }
+    memcpy(wasm_runtime_addr_app_to_native(plugin->instance, address), data, length);
+    return address;
+}
+
+/// Reads a packed (address << 32 | length) string out of module memory.
+static char *ayu_wasm_copy_out(AyuWasmPlugin *plugin, uint64_t packed) {
+    uint32_t address = (uint32_t)(packed >> 32);
+    uint32_t length = (uint32_t)(packed & 0xffffffffu);
+    if (address == 0 || length > 1024 * 1024 || !wasm_runtime_validate_app_addr(plugin->instance, address, length)) {
+        return NULL;
+    }
+    char *result = malloc((size_t)length + 1);
+    if (result == NULL) {
+        return NULL;
+    }
+    memcpy(result, wasm_runtime_addr_app_to_native(plugin->instance, address), length);
+    result[length] = 0;
+    return result;
+}
+
+static uint64_t ayu_wasm_host_import(wasm_exec_env_t env, uint32_t pointer, uint32_t length) {
+    wasm_module_inst_t instance = wasm_runtime_get_module_inst(env);
+    AyuWasmPlugin *plugin = wasm_runtime_get_custom_data(instance);
+    if (plugin == NULL || length > 1024 * 1024 || !wasm_runtime_validate_app_addr(instance, pointer, length)) {
+        return 0;
+    }
+    char *request = malloc((size_t)length + 1);
+    if (request == NULL) {
+        return 0;
+    }
+    memcpy(request, wasm_runtime_addr_app_to_native(instance, pointer), length);
+    request[length] = 0;
+    char *answer = plugin->host(plugin->context, request);
+    free(request);
+    if (answer == NULL) {
+        return 0;
+    }
+    uint32_t answerLength = (uint32_t)strlen(answer);
+    uint32_t address = ayu_wasm_copy_in(plugin, env, answer, answerLength);
+    free(answer);
+    if (address == 0) {
+        return 0;
+    }
+    return ((uint64_t)address << 32) | answerLength;
+}
+
+AyuWasmPlugin *ayu_wasm_create(const uint8_t *bytes, uint32_t size, AyuEngineHostFunction host, void *context, char **error) {
+    pthread_once(&ayu_wasm_once, ayu_wasm_initialize);
+    if (!ayu_wasm_ready) {
+        ayu_wasm_set_error(error, "The WebAssembly runtime is unavailable.");
+        return NULL;
+    }
+    AyuWasmPlugin *plugin = calloc(1, sizeof(AyuWasmPlugin));
+    if (plugin == NULL) {
+        return NULL;
+    }
+    // WAMR keeps pointers into the buffer it loaded.
+    plugin->bytes = malloc(size);
+    if (plugin->bytes == NULL) {
+        free(plugin);
+        return NULL;
+    }
+    memcpy(plugin->bytes, bytes, size);
+    plugin->host = host;
+    plugin->context = context;
+
+    char message[256] = { 0 };
+    plugin->module = wasm_runtime_load(plugin->bytes, size, message, sizeof(message));
+    if (plugin->module == NULL) {
+        ayu_wasm_set_error(error, message);
+        ayu_wasm_destroy(plugin);
+        return NULL;
+    }
+    plugin->instance = wasm_runtime_instantiate(plugin->module, 64 * 1024, 0, message, sizeof(message));
+    if (plugin->instance == NULL) {
+        ayu_wasm_set_error(error, message);
+        ayu_wasm_destroy(plugin);
+        return NULL;
+    }
+    wasm_runtime_set_custom_data(plugin->instance, plugin);
+    plugin->allocate = wasm_runtime_lookup_function(plugin->instance, "ayu_alloc");
+    plugin->release = wasm_runtime_lookup_function(plugin->instance, "ayu_free");
+    plugin->dispatch = wasm_runtime_lookup_function(plugin->instance, "ayu_dispatch");
+    if (plugin->allocate == NULL || plugin->dispatch == NULL) {
+        ayu_wasm_set_error(error, "The module must export ayu_alloc and ayu_dispatch.");
+        ayu_wasm_destroy(plugin);
+        return NULL;
+    }
+    wasm_function_inst_t initialize = wasm_runtime_lookup_function(plugin->instance, "ayu_init");
+    if (initialize != NULL) {
+        wasm_exec_env_t env = wasm_runtime_create_exec_env(plugin->instance, 64 * 1024);
+        if (env == NULL) {
+            ayu_wasm_set_error(error, "Could not create an execution environment.");
+            ayu_wasm_destroy(plugin);
+            return NULL;
+        }
+        uint32_t argv[1] = { 0 };
+        bool ok = wasm_runtime_call_wasm(env, initialize, 0, argv);
+        wasm_runtime_destroy_exec_env(env);
+        if (!ok) {
+            ayu_wasm_set_error(error, wasm_runtime_get_exception(plugin->instance));
+            ayu_wasm_destroy(plugin);
+            return NULL;
+        }
+    }
+    return plugin;
+}
+
+char *ayu_wasm_dispatch(AyuWasmPlugin *plugin, const char *request, char **error) {
+    // A fresh environment per call records the current thread's stack bounds.
+    wasm_exec_env_t env = wasm_runtime_create_exec_env(plugin->instance, 64 * 1024);
+    if (env == NULL) {
+        ayu_wasm_set_error(error, "Could not create an execution environment.");
+        return NULL;
+    }
+    wasm_runtime_clear_exception(plugin->instance);
+    uint32_t length = (uint32_t)strlen(request);
+    uint32_t address = ayu_wasm_copy_in(plugin, env, request, length);
+    if (address == 0) {
+        const char *exception = wasm_runtime_get_exception(plugin->instance);
+        ayu_wasm_set_error(error, exception != NULL ? exception : "ayu_alloc failed.");
+        wasm_runtime_destroy_exec_env(env);
+        return NULL;
+    }
+    uint32_t argv[2] = { address, length };
+    if (!wasm_runtime_call_wasm(env, plugin->dispatch, 2, argv)) {
+        ayu_wasm_set_error(error, wasm_runtime_get_exception(plugin->instance));
+        wasm_runtime_destroy_exec_env(env);
+        return NULL;
+    }
+    uint64_t packed = ((uint64_t)argv[1] << 32) | argv[0];
+    char *result = ayu_wasm_copy_out(plugin, packed);
+    if (plugin->release != NULL && packed != 0) {
+        uint32_t freeArgs[2] = { (uint32_t)(packed >> 32), (uint32_t)(packed & 0xffffffffu) };
+        wasm_runtime_call_wasm(env, plugin->release, 2, freeArgs);
+    }
+    wasm_runtime_destroy_exec_env(env);
+    return result;
+}
+
+void ayu_wasm_destroy(AyuWasmPlugin *plugin) {
+    if (plugin == NULL) {
+        return;
+    }
+    if (plugin->instance != NULL) {
+        wasm_runtime_deinstantiate(plugin->instance);
+    }
+    if (plugin->module != NULL) {
+        wasm_runtime_unload(plugin->module);
+    }
+    free(plugin->bytes);
+    free(plugin);
+}
