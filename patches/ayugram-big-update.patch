+#if canImport(WidgetKit)
+import Foundation
+import SwiftUI
+import WidgetKit
+@_weakLinked import ActivityKit
+@_weakLinked import AppIntents
+
+/// The app group shared with AyuGram: "group." + the app's bundle id (this extension is "<app>.Widget").
+private func ayuGroupDefaults() -> UserDefaults? {
+    guard let bundleId = Bundle.main.bundleIdentifier, let dot = bundleId.range(of: ".", options: .backwards) else { return nil }
+    return UserDefaults(suiteName: "group." + String(bundleId[..<dot.lowerBound]))
+}
+
+// MARK: - Live Activity: the music player's track
+
+/// Must match AyuNowPlayingAttributes in TelegramUI field for field.
+@available(iOS 16.1, *)
+struct AyuNowPlayingAttributes: ActivityAttributes {
+    public struct ContentState: Codable, Hashable {
+        var title: String
+        var artist: String
+        var playing: Bool
+    }
+    var appName: String
+}
+
+@available(iOS 16.1, *)
+struct AyuNowPlayingLiveActivity: Widget {
+    var body: some WidgetConfiguration {
+        ActivityConfiguration(for: AyuNowPlayingAttributes.self) { context in
+            HStack(spacing: 12) {
+                Image(systemName: context.state.playing ? "music.note" : "pause.fill")
+                    .font(.title2)
+                    .foregroundColor(.white)
+                    .frame(width: 44, height: 44)
+                    .background(Circle().fill(Color.purple))
+                VStack(alignment: .leading, spacing: 2) {
+                    Text(context.state.title).font(.headline).lineLimit(1)
+                    Text(context.state.artist.isEmpty ? context.attributes.appName : context.state.artist)
+                        .font(.subheadline).foregroundColor(.secondary).lineLimit(1)
+                }
+                Spacer()
+            }
+            .padding()
+        } dynamicIsland: { context in
+            DynamicIsland {
+                DynamicIslandExpandedRegion(.leading) {
+                    Image(systemName: context.state.playing ? "music.note" : "pause.fill")
+                }
+                DynamicIslandExpandedRegion(.center) {
+                    VStack(spacing: 2) {
+                        Text(context.state.title).font(.headline).lineLimit(1)
+                        Text(context.state.artist).font(.caption).foregroundColor(.secondary).lineLimit(1)
+                    }
+                }
+            } compactLeading: {
+                Image(systemName: "music.note")
+            } compactTrailing: {
+                Text(context.state.title).lineLimit(1).frame(maxWidth: 60)
+            } minimal: {
+                Image(systemName: "music.note")
+            }
+        }
+    }
+}
+
+// MARK: - Control Center: Ghost Mode
+
+@available(iOS 18.0, *)
+struct AyuGhostToggleIntent: SetValueIntent {
+    static let title: LocalizedStringResource = "Ghost Mode"
+
+    @Parameter(title: "Enabled")
+    var value: Bool
+
+    init() {}
+
+    func perform() async throws -> some IntentResult {
+        // The extension cannot change account settings: it asks the app, which applies the
+        // request at once when running (Darwin notification) or the next time it opens.
+        let defaults = ayuGroupDefaults()
+        defaults?.set(self.value, forKey: "ayu.ghost.request")
+        defaults?.set(self.value, forKey: "ayu.ghost.active")
+        CFNotificationCenterPostNotification(CFNotificationCenterGetDarwinNotifyCenter(), CFNotificationName("one.ayugram.control.ghost" as CFString), nil, nil, true)
+        return .result()
+    }
+}
+
+@available(iOS 18.0, *)
+struct AyuGhostControlProvider: ControlValueProvider {
+    var previewValue: Bool { false }
+
+    func currentValue() async throws -> Bool {
+        return ayuGroupDefaults()?.bool(forKey: "ayu.ghost.active") ?? false
+    }
+}
+
+@available(iOS 18.0, *)
+struct AyuGhostControl: ControlWidget {
+    var body: some ControlWidgetConfiguration {
+        StaticControlConfiguration(kind: "one.ayugram.control.ghost", provider: AyuGhostControlProvider()) { enabled in
+            ControlWidgetToggle("Ghost Mode", isOn: enabled, action: AyuGhostToggleIntent()) { isOn in
+                Label(isOn ? "On" : "Off", systemImage: isOn ? "eye.slash.fill" : "eye.fill")
+            }
+        }
+        .displayName("AyuGram Ghost Mode")
+        .description("Turns AyuGram Ghost Mode on and off.")
+    }
+}
+#endif
