diff --git a/submodules/TelegramUI/Sources/AyuPlayerDebugOverlay.swift b/submodules/TelegramUI/Sources/AyuPlayerDebugOverlay.swift
new file mode 100644
index 00000000..da8660d2
--- /dev/null
+++ b/submodules/TelegramUI/Sources/AyuPlayerDebugOverlay.swift
@@ -0,0 +1,94 @@
+import Foundation
+import UIKit
+import TelegramCore
+import UniversalMediaPlayer
+
+/// Developer-only playback diagnostics shown in the music player's bottom-right corner.
+/// Enabled from Settings → AyuGram → Developer; hidden and idle otherwise.
+final class AyuPlayerDebugOverlay: UIView {
+    private let label = UILabel()
+    private var events: [String] = []
+    private var lastRender: Double = 0.0
+    private var frameTimes: [Double] = []
+    private var observer: NSObjectProtocol?
+
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+        self.isUserInteractionEnabled = false
+        self.backgroundColor = UIColor(white: 0.0, alpha: 0.55)
+        self.layer.cornerRadius = 8.0
+        self.layer.borderWidth = 0.5
+        self.layer.borderColor = UIColor(white: 1.0, alpha: 0.2).cgColor
+        self.label.numberOfLines = 0
+        self.label.font = UIFont.monospacedSystemFont(ofSize: 9.0, weight: .medium)
+        self.label.textColor = UIColor(red: 0.6, green: 1.0, blue: 0.7, alpha: 1.0)
+        self.addSubview(self.label)
+        self.accessibilityElementsHidden = true
+        self.observer = NotificationCenter.default.addObserver(forName: AyuDeveloperSettings.didChangeNotification, object: nil, queue: .main, using: { [weak self] _ in
+            guard let self else { return }
+            self.isHidden = !AyuDeveloperSettings.shared.playerDebugOverlay
+            self.superview?.setNeedsLayout()
+        })
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    deinit {
+        if let observer = self.observer {
+            NotificationCenter.default.removeObserver(observer)
+        }
+    }
+
+    func note(_ event: String) {
+        let stamp = String(format: "%.2f", CACurrentMediaTime().truncatingRemainder(dividingBy: 1000.0))
+        self.events.append("\(stamp) \(event)")
+        if self.events.count > 4 {
+            self.events.removeFirst(self.events.count - 4)
+        }
+        AyuDevLog.shared.log("player", event)
+    }
+
+    func update(status: MediaPlayerStatus, timestamp: Double, trackKey: String?, lyricsOffset: Double, haptics: Bool, fps: Double) {
+        let now = CACurrentMediaTime()
+        self.frameTimes.append(now)
+        self.frameTimes.removeAll(where: { now - $0 > 1.0 })
+        // Text layout is the expensive part; four refreshes a second is plenty to read.
+        guard now - self.lastRender > 0.25 else { return }
+        self.lastRender = now
+
+        let state: String
+        switch status.status {
+        case .playing:
+            state = "playing"
+        case .paused:
+            state = "paused"
+        case let .buffering(_, whilePlaying, progress, _):
+            state = String(format: "buffering %@ %.0f%%", whilePlaying ? "(play)" : "(pause)", Double(progress) * 100.0)
+        }
+        var lines: [String] = [
+            "AYU PLAYER DEBUG",
+            "state  \(state)",
+            String(format: "time   %.2f / %.2f", timestamp, status.duration),
+            String(format: "rate   %.2fx  gen %.2f", status.baseRate, status.generationTimestamp),
+            String(format: "fps    %d (target %.0f)", self.frameTimes.count, fps),
+            String(format: "lyrics %+.1fs  haptics %@", lyricsOffset, haptics ? "on" : "off"),
+            "track  \(trackKey.map { String($0.prefix(18)) } ?? "-")"
+        ]
+        lines.append(contentsOf: self.events)
+        self.label.text = lines.joined(separator: "\n")
+        self.superview?.setNeedsLayout()
+    }
+
+    override func sizeThatFits(_ size: CGSize) -> CGSize {
+        let maxWidth = min(220.0, size.width * 0.6)
+        let fitted = self.label.sizeThatFits(CGSize(width: maxWidth - 12.0, height: .greatestFiniteMagnitude))
+        return CGSize(width: min(maxWidth, ceil(fitted.width) + 12.0), height: ceil(fitted.height) + 10.0)
+    }
+
+    override func layoutSubviews() {
+        super.layoutSubviews()
+        self.label.frame = self.bounds.insetBy(dx: 6.0, dy: 5.0)
+    }
+}
