+
+extension UIViewController {
+    /// Close button target for pages AyuGram presents in their own navigation controller.
+    @objc func ayuDismissSelf() {
+        self.dismiss(animated: true)
+    }
+}
+
+/// Text shortcuts (;adr → address) and template variables.
+final class AyuShortcutsController: UITableViewController {
+    private let russian: Bool
+
+    init(russian: Bool) {
+        self.russian = russian
+        super.init(style: .insetGrouped)
+        self.title = russian ? "Шаблоны и сокращения" : "Shortcuts and templates"
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        self.navigationItem.rightBarButtonItem = UIBarButtonItem(barButtonSystemItem: .add, target: self, action: #selector(self.add))
+    }
+
+    @objc private func add() {
+        let alert = UIAlertController(title: self.russian ? "Новое сокращение" : "New shortcut", message: self.russian ? "Сообщение, равное сокращению, заменяется текстом. Можно использовать {date}, {time}, {weekday}, {clipboard}." : "A message equal to the shortcut is replaced with the text. {date}, {time}, {weekday} and {clipboard} work.", preferredStyle: .alert)
+        alert.addTextField { $0.placeholder = self.russian ? ";адр" : ";adr"; $0.autocapitalizationType = .none }
+        alert.addTextField { $0.placeholder = self.russian ? "Текст" : "Text" }
+        alert.addAction(UIAlertAction(title: self.russian ? "Отмена" : "Cancel", style: .cancel))
+        alert.addAction(UIAlertAction(title: self.russian ? "Добавить" : "Add", style: .default, handler: { [weak self, weak alert] _ in
+            let trigger = (alert?.textFields?.first?.text ?? "").trimmingCharacters(in: .whitespacesAndNewlines)
+            let text = alert?.textFields?.last?.text ?? ""
+            guard !trigger.isEmpty, !text.isEmpty else { return }
+            var items = AyuTextShortcuts.shortcuts.filter { $0.trigger != trigger }
+            items.append(AyuTextShortcuts.Shortcut(trigger: trigger, text: text))
+            AyuTextShortcuts.shortcuts = items
+            self?.tableView.reloadData()
+        }))
+        self.present(alert, animated: true)
+    }
+
+    override func numberOfSections(in tableView: UITableView) -> Int {
+        return 2
+    }
+
+    override func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int {
+        return section == 0 ? 1 : max(1, AyuTextShortcuts.shortcuts.count)
+    }
+
+    override func tableView(_ tableView: UITableView, titleForFooterInSection section: Int) -> String? {
+        if section == 0 {
+            return self.russian ? "Подставлять {date}, {time}, {weekday} и {clipboard} в любые сообщения." : "Fill {date}, {time}, {weekday} and {clipboard} in any message."
+        }
+        return self.russian ? "Работает для обычных текстовых сообщений без форматирования." : "Works for plain text messages without formatting."
+    }
+
+    override func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
+        let cell = UITableViewCell(style: .subtitle, reuseIdentifier: nil)
+        if indexPath.section == 0 {
+            cell.textLabel?.text = self.russian ? "Переменные в сообщениях" : "Variables in messages"
+            let toggle = UISwitch()
+            toggle.isOn = AyuTextShortcuts.variablesEnabled
+            toggle.addTarget(self, action: #selector(self.variablesChanged(_:)), for: .valueChanged)
+            cell.accessoryView = toggle
+            cell.selectionStyle = .none
+            return cell
+        }
+        let items = AyuTextShortcuts.shortcuts
+        if items.isEmpty {
+            cell.textLabel?.text = self.russian ? "Нажмите +, чтобы добавить" : "Tap + to add one"
+            cell.textLabel?.textColor = .secondaryLabel
+        } else {
+            cell.textLabel?.text = items[indexPath.row].trigger
+            cell.detailTextLabel?.text = items[indexPath.row].text
+            cell.detailTextLabel?.numberOfLines = 2
+        }
+        cell.selectionStyle = .none
+        return cell
+    }
+
+    @objc private func variablesChanged(_ sender: UISwitch) {
+        AyuTextShortcuts.variablesEnabled = sender.isOn
+    }
+
+    override func tableView(_ tableView: UITableView, canEditRowAt indexPath: IndexPath) -> Bool {
+        return indexPath.section == 1 && !AyuTextShortcuts.shortcuts.isEmpty
+    }
+
+    override func tableView(_ tableView: UITableView, commit editingStyle: UITableViewCell.EditingStyle, forRowAt indexPath: IndexPath) {
+        guard editingStyle == .delete else { return }
+        var items = AyuTextShortcuts.shortcuts
+        guard indexPath.row < items.count else { return }
+        items.remove(at: indexPath.row)
+        AyuTextShortcuts.shortcuts = items
+        tableView.reloadData()
+    }
+}
+
+/// Plugin profiles: named sets of enabled plugins switched on together ("Work", "Stream").
+enum AyuPluginProfiles {
+    private static let key = "ayu.plugins.profiles"
+
+    static var all: [String: [String]] {
+        get { return (UserDefaults.standard.dictionary(forKey: key) as? [String: [String]]) ?? [:] }
+        set { UserDefaults.standard.set(newValue, forKey: key) }
+    }
+
+    static func present(context: AccountContext) {
+        let ru = context.sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru")
+        let sheet = UIAlertController(title: ru ? "Профили плагинов" : "Plugin profiles", message: ru ? "Профиль включает свой набор плагинов и выключает остальные." : "A profile turns its plugins on and the rest off.", preferredStyle: .actionSheet)
+        for name in all.keys.sorted() {
+            sheet.addAction(UIAlertAction(title: (ru ? "Включить «" : "Apply \"") + name + (ru ? "»" : "\""), style: .default, handler: { _ in
+                let enabled = Set(all[name] ?? [])
+                for plugin in AyuScriptRuntime.shared.plugins {
+                    if plugin.enabled != enabled.contains(plugin.id) {
+                        AyuScriptRuntime.shared.setEnabled(plugin.id, enabled.contains(plugin.id))
+                    }
+                }
+            }))
+        }
+        sheet.addAction(UIAlertAction(title: ru ? "Сохранить текущие как профиль…" : "Save current as a profile…", style: .default, handler: { _ in
+            let alert = UIAlertController(title: ru ? "Название профиля" : "Profile name", message: nil, preferredStyle: .alert)
+            alert.addTextField { $0.placeholder = ru ? "Работа" : "Work" }
+            alert.addAction(UIAlertAction(title: ru ? "Отмена" : "Cancel", style: .cancel))
+            alert.addAction(UIAlertAction(title: ru ? "Сохранить" : "Save", style: .default, handler: { [weak alert] _ in
+                let name = (alert?.textFields?.first?.text ?? "").trimmingCharacters(in: .whitespacesAndNewlines)
+                guard !name.isEmpty else { return }
+                var profiles = all
+                profiles[String(name.prefix(40))] = AyuScriptRuntime.shared.plugins.filter { $0.enabled }.map { $0.id }
+                all = profiles
+            }))
+            context.sharedContext.applicationBindings.presentNativeController(alert)
+        }))
+        if !all.isEmpty {
+            sheet.addAction(UIAlertAction(title: ru ? "Удалить все профили" : "Delete all profiles", style: .destructive, handler: { _ in
+                all = [:]
+            }))
+        }
+        sheet.addAction(UIAlertAction(title: ru ? "Отмена" : "Cancel", style: .cancel))
+        context.sharedContext.applicationBindings.presentNativeController(sheet)
+    }
+}
