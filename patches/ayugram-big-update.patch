+    for(int i = 1; i < 16; i++) {
+        VM* vm = pk_all_vm[i];
+        if(vm) {
+            // temp fix https://github.com/pocketpy/pocketpy/issues/315
+            // TODO: refactor VM__ctor and VM__dtor
+            pk_current_vm = vm;
+            VM__dtor(vm);
+            PK_FREE(vm);
+        }
+    }
+    pk_current_vm = &pk_default_vm;
+    VM__dtor(&pk_default_vm);
+    pk_current_vm = NULL;
+
+    pk_names_finalize();
+}
+
+int VM__index(VM* self) {
+    for(int i = 0; i < 16; i++) {
+        if(pk_all_vm[i] == self) return i;
+    }
+    return -1;
