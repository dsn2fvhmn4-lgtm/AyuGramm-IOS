index 00000000..ec3962f6
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuGram/AyuPeerIdentity.swift
@@ -0,0 +1,137 @@
+import Foundation
+import Postbox
+
+/// Local nicknames for people: shown instead of their name everywhere names are drawn
+/// (chat list, chat title, messages). This device only; off in decoy mode.
+public enum AyuNicknames {
+    public static let didChangeNotification = Notification.Name("AyuGram.NicknamesChanged")
+    private static let key = "ayu.nicknames"
+    private static let lock = NSLock()
+    private static var cache: [Int64: String]?
+
+    private static func load() -> [Int64: String] {
+        if let cache = cache {
+            return cache
+        }
+        var result: [Int64: String] = [:]
+        for (key, value) in (UserDefaults.standard.dictionary(forKey: key) as? [String: String]) ?? [:] {
+            if let id = Int64(key), !value.isEmpty {
+                result[id] = value
+            }
+        }
+        cache = result
+        return result
+    }
+
+    /// Hot path (every drawn name): one in-memory lookup under a lock.
+    public static func nickname(_ peerId: Int64) -> String? {
+        if AyuDecoyState.isActive {
+            return nil
+        }
+        lock.lock()
+        defer { lock.unlock() }
+        return load()[peerId]
+    }
+
+    public static func setNickname(_ peerId: Int64, _ value: String?) {
+        let trimmed = String((value ?? "").trimmingCharacters(in: .whitespacesAndNewlines).prefix(64))
+        lock.lock()
+        var all = load()
+        all[peerId] = trimmed.isEmpty ? nil : trimmed
+        cache = all
+        lock.unlock()
+        var stored: [String: String] = [:]
+        for (id, name) in all {
+            stored[String(id)] = name
+        }
+        UserDefaults.standard.set(stored, forKey: key)
+        NotificationCenter.default.post(name: didChangeNotification, object: nil)
+    }
+}
+
+/// What people were called before: names, usernames and profile photo changes seen by this
+/// device, recorded when a user's record is updated. Newest first, 50 per person.
+public enum AyuNameHistory {
+    public struct Entry: Codable, Equatable {
+        public enum Kind: String, Codable {
+            case name
+            case username
+            case photo
+        }
+        public var kind: Kind
+        public var old: String
+        public var new: String
+        public var date: Int32
+    }
+
+    private static let key = "ayu.nameHistory"
+    private static let queue = DispatchQueue(label: "ayu.nameHistory")
+    private static var cache: [String: [Entry]]?
+
+    private static func loadLocked() -> [String: [Entry]] {
+        if let cache = cache {
+            return cache
+        }
+        let value = UserDefaults.standard.data(forKey: key).flatMap { try? JSONDecoder().decode([String: [Entry]].self, from: $0) } ?? [:]
+        cache = value
+        return value
+    }
+
+    public static func entries(_ peerId: Int64) -> [Entry] {
+        if AyuDecoyState.isActive {
+            return []
+        }
+        return queue.sync { loadLocked()[String(peerId)] ?? [] }
+    }
+
+    public static func clear(_ peerId: Int64) {
+        queue.async {
+            var all = loadLocked()
+            all[String(peerId)] = nil
+            cache = all
+            if let data = try? JSONEncoder().encode(all) {
+                UserDefaults.standard.set(data, forKey: key)
+            }
+        }
+    }
+
+    private static func fullName(_ user: TelegramUser) -> String {
+        return [user.firstName, user.lastName].compactMap { $0 }.filter { !$0.isEmpty }.joined(separator: " ")
+    }
+
+    /// Called for every user update; cheap when nothing visible changed.
+    static func record(previous: TelegramUser, updated: TelegramUser) {
+        // Min updates carry no reliable name; ignore records without one.
+        let oldName = fullName(previous)
+        let newName = fullName(updated)
+        let oldUsername = previous.addressName ?? ""
+        let newUsername = updated.addressName ?? ""
+        let oldPhoto = previous.photo.first?.resource.id.stringRepresentation ?? ""
+        let newPhoto = updated.photo.first?.resource.id.stringRepresentation ?? ""
+        var changes: [Entry] = []
+        let now = Int32(Date().timeIntervalSince1970)
+        if !oldName.isEmpty, !newName.isEmpty, oldName != newName {
+            changes.append(Entry(kind: .name, old: oldName, new: newName, date: now))
+        }
+        if oldUsername != newUsername, !(oldUsername.isEmpty && newUsername.isEmpty) {
+            changes.append(Entry(kind: .username, old: oldUsername, new: newUsername, date: now))
+        }
+        if !oldPhoto.isEmpty, !newPhoto.isEmpty, oldPhoto != newPhoto {
+            changes.append(Entry(kind: .photo, old: "", new: "", date: now))
+        }
+        if changes.isEmpty {
+            return
+        }
+        let id = String(updated.id.toInt64())
+        queue.async {
+            var all = loadLocked()
+            var list = all[id] ?? []
+            list.insert(contentsOf: changes, at: 0)
+            all[id] = Array(list.prefix(50))
+            cache = all
+            if let data = try? JSONEncoder().encode(all) {
+                UserDefaults.standard.set(data, forKey: key)
+            }
+        }
+    }
+}
