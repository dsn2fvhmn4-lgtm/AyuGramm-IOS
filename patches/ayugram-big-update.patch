+import Foundation
+import UIKit
+import Display
+import AsyncDisplayKit
+import TelegramCore
+import TelegramPresentationData
+import ChatPresentationInterfaceState
+import AccountContext
+import LegacyChatHeaderPanelComponent
+
+/// The AyuGram team label under a chat's title: "… — confirmed by the AyuGram for iOS team",
+/// from the signed list kept with @ayugram_dev_settings_bot. Its own AyuGram icon keeps it apart
+/// from Telegram's official verification.
+final class AyuTeamVerifiedTitlePanelNode: ChatTitleAccessoryPanelNode {
+    private let separatorNode: ASDisplayNode
+    private let iconNode: ASImageNode
+    private let textNode: ImmediateTextNode
+    private let closeButton: HighlightableButtonNode
+    private var theme: PresentationTheme?
+    private var peerId: Int64?
+
+    override init() {
+        self.separatorNode = ASDisplayNode()
+        self.separatorNode.isLayerBacked = true
+        self.iconNode = ASImageNode()
+        self.iconNode.displaysAsynchronously = false
+        self.textNode = ImmediateTextNode()
+        self.textNode.maximumNumberOfLines = 3
+        self.textNode.textAlignment = .center
+        self.closeButton = HighlightableButtonNode()
+        self.closeButton.hitTestSlop = UIEdgeInsets(top: -8.0, left: -8.0, bottom: -8.0, right: -8.0)
+        self.closeButton.displaysAsynchronously = false
+        self.closeButton.accessibilityLabel = "Close"
+        super.init()
+        self.addSubnode(self.separatorNode)
+        self.addSubnode(self.iconNode)
+        self.addSubnode(self.textNode)
+        self.closeButton.addTarget(self, action: #selector(self.closePressed), forControlEvents: [.touchUpInside])
+        self.addSubnode(self.closeButton)
+    }
+
+    /// The cross hides the label in this chat for good; the profile still shows it.
+    @objc private func closePressed() {
+        guard let peerId = self.peerId else {
+            return
+        }
+        AyuVerifiedRegistry.dismissPanel(peerId: peerId)
+        self.interfaceInteraction?.requestLayout(.animated(duration: 0.3, curve: .spring))
+    }
+
+    override func hitTest(_ point: CGPoint, with event: UIEvent?) -> UIView? {
+        if let result = self.closeButton.hitTest(CGPoint(x: point.x - self.closeButton.frame.minX, y: point.y - self.closeButton.frame.minY), with: event) {
+            return result
+        }
+        return super.hitTest(point, with: event)
+    }
+
+    override func updateLayout(width: CGFloat, leftInset: CGFloat, rightInset: CGFloat, transition: ContainedViewLayoutTransition, interfaceState: ChatPresentationInterfaceState) -> LayoutResult {
+        if interfaceState.theme !== self.theme {
+            self.theme = interfaceState.theme
+            self.separatorNode.backgroundColor = interfaceState.theme.rootController.navigationBar.separatorColor
+            self.iconNode.image = UIImage(systemName: "checkmark.shield.fill", withConfiguration: UIImage.SymbolConfiguration(pointSize: 12.0, weight: .semibold))?.withTintColor(UIColor(rgb: 0x8E5CF7), renderingMode: .alwaysOriginal)
+            let closeColor = interfaceState.theme.chat.inputPanel.panelControlColor
+            self.closeButton.setImage(generateImage(CGSize(width: 12.0, height: 12.0), contextGenerator: { size, context in
+                context.clear(CGRect(origin: CGPoint(), size: size))
+                context.setStrokeColor(closeColor.cgColor)
+                context.setLineWidth(1.33)
+                context.setLineCap(.round)
+                context.move(to: CGPoint(x: 1.0, y: 1.0))
+                context.addLine(to: CGPoint(x: size.width - 1.0, y: size.height - 1.0))
+                context.strokePath()
+                context.move(to: CGPoint(x: size.width - 1.0, y: 1.0))
+                context.addLine(to: CGPoint(x: 1.0, y: size.height - 1.0))
+                context.strokePath()
+            }), for: [])
+        }
+        self.peerId = interfaceState.renderedPeer?.peer?.id.id._internalGetInt64Value()
+        var panelHeight: CGFloat = 12.0
+        if !AyuExtras.isOn(.hideAyuBadges), let peerId = interfaceState.renderedPeer?.peer?.id, let entry = AyuVerifiedRegistry.shared.entry(peer: peerId) {
+            let russian = interfaceState.strings.baseLanguageCode.hasPrefix("ru")
+            self.textNode.attributedText = NSAttributedString(string: AyuVerifiedRegistry.caption(entry, russian: russian), font: Font.regular(12.0), textColor: interfaceState.theme.rootController.navigationBar.secondaryTextColor)
+            let iconSize = CGSize(width: 14.0, height: 14.0)
+            // Room for the cross on both sides keeps the text centered.
+            let textSize = self.textNode.updateLayout(CGSize(width: width - leftInset - rightInset - 76.0 - iconSize.width - 4.0, height: .greatestFiniteMagnitude))
+            let total = iconSize.width + 4.0 + textSize.width
+            let originX = floor((width - total) / 2.0)
+            transition.updateFrame(node: self.iconNode, frame: CGRect(origin: CGPoint(x: originX, y: panelHeight + 1.0), size: iconSize))
+            transition.updateFrame(node: self.textNode, frame: CGRect(origin: CGPoint(x: originX + iconSize.width + 4.0, y: panelHeight), size: textSize))
+            panelHeight += textSize.height + 12.0
+            let closeSize = self.closeButton.measure(CGSize(width: 100.0, height: 100.0))
+            transition.updateFrame(node: self.closeButton, frame: CGRect(origin: CGPoint(x: width - rightInset - 14.0 - closeSize.width, y: floorToScreenPixels((panelHeight - closeSize.height) / 2.0)), size: closeSize))
+        }
+        transition.updateFrame(node: self.separatorNode, frame: CGRect(origin: CGPoint(), size: CGSize(width: width, height: UIScreenPixel)))
+        return LayoutResult(backgroundHeight: panelHeight, insetHeight: panelHeight, hitTestSlop: .zero)
+    }
+}
