+++ b/submodules/TelegramCore/Sources/AyuGram/AyuPluginMessages.swift
@@ -0,0 +1,81 @@
+import Foundation
+import Postbox
+import SwiftSignalKit
+
+/// Posted when AyuGram's history sees a message deleted or edited on the server; userInfo has
+/// "kind" ("deleted" / "edited"), "peerId", "messageId", "text" and, for edits, "newText".
+/// Code plugins receive it as the `messageDeleted` / `messageEdited` events.
+public let ayuMessageHistoryEventNotification = Notification.Name("AyuGram.MessageHistoryEvent")
+
+func ayuPostHistoryEvent(kind: AyuMessageHistoryRecord.Kind, message: Message, newText: String?, accountPeerId: PeerId?, notifyAllowed: Bool) {
+    var info: [String: Any] = [
+        "kind": kind == .deleted ? "deleted" : "edited",
+        "peerId": String(message.id.peerId.toInt64()),
+        "messageId": String(message.id.id),
+        "text": message.text,
+        "notifyAllowed": notifyAllowed,
+        "outgoing": !message.flags.contains(.Incoming)
+    ]
+    if let accountPeerId { info["accountPeerId"] = String(accountPeerId.toInt64()) }
+    info["namespace"] = message.id.namespace
+    if let threadId = message.threadId { info["threadId"] = threadId }
+    if let newText {
+        info["newText"] = newText
+    }
+    if let author = message.author {
+        info["authorId"] = String(author.id.toInt64())
+    }
+    DispatchQueue.main.async {
+        NotificationCenter.default.post(name: ayuMessageHistoryEventNotification, object: nil, userInfo: info)
+    }
+}
+
+public extension TelegramEngine.Messages {
+    /// The newest locally stored messages of a chat, newest first (for `ayu.messages.get`).
+    /// Stored cloud messages of a chat newer than `since`, newest first (at most `limit`).
+    func ayuMessagesSince(peerId: EnginePeer.Id, since: Int32, limit: Int) -> Signal<[EngineMessage], NoError> {
+        return self.account.postbox.transaction { transaction -> [EngineMessage] in
+            guard let top = transaction.getTopPeerMessageId(peerId: peerId, namespace: Namespaces.Message.Cloud) else {
+                return []
+            }
+            let limit = max(1, min(limit, 20000))
+            var result: [EngineMessage] = []
+            var id = top.id
+            // Private chats share one id sequence, so bound the total lookups, not the misses.
+            var lookups = 0
+            while result.count < limit && id > 0 && lookups < 300000 {
+                lookups += 1
+                if let message = transaction.getMessage(MessageId(peerId: peerId, namespace: Namespaces.Message.Cloud, id: id)) {
+                    if message.timestamp < since {
+                        break
+                    }
+                    result.append(EngineMessage(message))
+                }
+                id -= 1
+            }
+            return result
+        }
+    }
+
+    func ayuRecentMessages(peerId: EnginePeer.Id, limit: Int) -> Signal<[EngineMessage], NoError> {
+        return self.account.postbox.transaction { transaction -> [EngineMessage] in
+            guard let top = transaction.getTopPeerMessageId(peerId: peerId, namespace: Namespaces.Message.Cloud) else {
+                return []
+            }
+            let limit = max(1, min(limit, 100))
+            var result: [EngineMessage] = []
+            var id = top.id
+            var misses = 0
+            // Channel ids are dense; private chats share one id sequence, so allow gaps.
+            while result.count < limit && id > 0 && misses < 5000 {
+                if let message = transaction.getMessage(MessageId(peerId: peerId, namespace: Namespaces.Message.Cloud, id: id)) {
+                    result.append(EngineMessage(message))
+                } else {
+                    misses += 1
+                }
+                id -= 1
+            }
+            return result
+        }
+    }
+}
