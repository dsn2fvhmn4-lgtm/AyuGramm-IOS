+// MARK: - Messages → Local notifications
+func ayuLocalNotificationsController(context: AccountContext) -> ViewController {
+    return ayuPage(context: context, title: { $0 ? "Локальные уведомления" : "Local notifications" }, notifications: [], entries: { ru in
+        let settings = AyuLocalNotificationSettings()
+        return [
+            .header(1, 0, ru ? "ДОСТАВКА" : "DELIVERY"),
+            .toggle(1, 1, symbol("bell.fill", 0xFF3B30), ru ? "Уведомления в фоне" : "Background notifications", ru ? "Пока iOS позволяет приложению работать в фоне" : "While iOS allows the app to run in the background", context.account.network.ayuGhostMode.current.interface.backgroundNotifications),
+            .toggle(1, 2, nil, ru ? "Группировать по чату" : "Group by chat", nil, settings.groupByChat),
+            .toggle(1, 3, nil, ru ? "Аватар отправителя" : "Sender avatar", ru ? "Используется загруженная фотография. При скрытом тексте аватар не показывается." : "Uses the cached photo. Hidden previews also hide the avatar.", settings.avatars),
+            .toggle(1, 4, nil, ru ? "Ответить и прочитать" : "Reply and mark read", ru ? "Действия требуют разблокировки устройства" : "Actions require device authentication", settings.actions),
+            .header(2, 10, ru ? "ТИХИЕ ЧАСЫ" : "QUIET HOURS"),
+            .toggle(2, 11, nil, ru ? "Без звука по расписанию" : "Scheduled silent delivery", nil, settings.quietHours),
+            .link(2, 12, nil, ru ? "Начало и конец" : "Start and end", AyuLocalNotificationSettings.clock(settings.quietStart) + "–" + AyuLocalNotificationSettings.clock(settings.quietEnd)),
+            .info(2, 13, ru ? "Местное время. Одинаковое начало и конец — без звука весь день." : "Local time. Equal start and end means silent all day."),
+            .header(3, 20, ru ? "СОДЕРЖИМОЕ" : "CONTENT"),
+            .toggle(3, 21, nil, ru ? "Уведомлять об удалённых" : "Notify about deletions", nil, AyuExtras.isOn(.notifyDeleted)),
+            .toggle(3, 22, nil, ru ? "Уведомлять об изменённых" : "Notify about edits", nil, UserDefaults.standard.bool(forKey: "ayu.extra.notifyEdited")),
+            .toggle(3, 23, nil, ru ? "Только по ключевым словам" : "Only matching keywords", nil, settings.filterEnabled),
+            .link(3, 24, nil, ru ? "Ключевые слова" : "Keywords", "\(settings.keywords.count)"),
+            .info(3, 25, ru ? "Слова или фразы через запятую. Пустой список при включённом фильтре блокирует все уведомления. Настройки Telegram для чатов и тем сохраняют силу." : "Comma-separated words or phrases. An empty enabled filter blocks all notifications. Telegram chat and topic notification settings still apply.")
+        ]
+    }, open: { id, _, present in
+        let ru = ayuIsRussian(context)
+        let settings = AyuLocalNotificationSettings()
+        guard id == 12 || id == 24 else { return }
+        let alert = UIAlertController(title: id == 12 ? (ru ? "Тихие часы · HH:MM" : "Quiet hours · HH:MM") : (ru ? "Ключевые слова" : "Keywords"), message: nil, preferredStyle: .alert)
+        alert.addTextField { field in
+            field.text = id == 12 ? AyuLocalNotificationSettings.clock(settings.quietStart) : settings.keywords.joined(separator: ", ")
+            field.placeholder = id == 12 ? "23:00" : (ru ? "слово, фраза" : "word, phrase")
+            field.autocapitalizationType = .none
+        }
+        if id == 12 { alert.addTextField { $0.text = AyuLocalNotificationSettings.clock(settings.quietEnd); $0.placeholder = "08:00" } }
+        alert.addAction(UIAlertAction(title: ru ? "Отмена" : "Cancel", style: .cancel))
+        alert.addAction(UIAlertAction(title: ru ? "Сохранить" : "Save", style: .default, handler: { [weak alert] _ in
+            let first = alert?.textFields?.first?.text ?? ""
+            if id == 12 {
+                guard let start = AyuLocalNotificationSettings.minute(first), let end = AyuLocalNotificationSettings.minute(alert?.textFields?.last?.text ?? "") else {
+                    let error = UIAlertController(title: ru ? "Введите время от 00:00 до 23:59" : "Enter a time from 00:00 to 23:59", message: nil, preferredStyle: .alert)
+                    error.addAction(UIAlertAction(title: "OK", style: .default)); present(error); return
+                }
+                UserDefaults.standard.set(start, forKey: AyuLocalNotificationSettings.prefix + "quietStart")
+                UserDefaults.standard.set(end, forKey: AyuLocalNotificationSettings.prefix + "quietEnd")
+            } else {
+                UserDefaults.standard.set(String(first.prefix(4096)), forKey: AyuLocalNotificationSettings.prefix + "keywords")
+            }
+            NotificationCenter.default.post(name: ayuLocalSettingsChanged, object: nil)
+        }))
+        present(alert)
+    }, toggle: { id, value in
+        if id == 1 { try? context.account.network.ayuGhostMode.update { $0.interface.backgroundNotifications = value }; return }
+        if id == 21 { AyuExtras.set(.notifyDeleted, value); return }
+        if id == 22 { UserDefaults.standard.set(value, forKey: "ayu.extra.notifyEdited"); return }
+        if let key = [2: "groupByChat", 3: "avatars", 4: "actions", 11: "quietHours", 23: "filterEnabled"][Int(id)] {
+            UserDefaults.standard.set(value, forKey: AyuLocalNotificationSettings.prefix + key)
+        }
+    })
+}
diff --git a/submodules/SettingsUI/Sources/AyuCodePluginDetailsController.swift b/submodules/SettingsUI/Sources/AyuCodePluginDetailsController.swift
new file mode 100644
index 00000000..cd667259
--- /dev/null
+++ b/submodules/SettingsUI/Sources/AyuCodePluginDetailsController.swift
@@ -0,0 +1,128 @@
+import Foundation
+import UIKit
+import TelegramCore
+import AccountContext
+
+/// A code plugin's details: permissions the user can take back, what it actually called
+/// (privacy report) and how long its hooks take (profiler).
+final class AyuCodePluginDetailsController: UITableViewController {
+    private let pluginId: String
+    private let russian: Bool
+    private var permissions: [String] = []
+    private var calls: [(String, Int)] = []
+    private var hosts: [(String, Int)] = []
+
+    init(pluginId: String, russian: Bool) {
+        self.pluginId = pluginId
+        self.russian = russian
+        super.init(style: .insetGrouped)
+        self.title = AyuScriptRuntime.shared.plugin(id: pluginId)?.name ?? pluginId
+        self.reload()
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    private func reload() {
+        if let plugin = AyuScriptRuntime.shared.plugin(id: self.pluginId) {
+            self.permissions = Array(Set(plugin.permissions ?? []).union(AyuPluginGrants.granted(self.pluginId))).sorted()
+        }
+        let report = AyuPluginPrivacy.shared.report(self.pluginId)
+        self.calls = report.calls.sorted(by: { $0.value > $1.value }).map { ($0.key, $0.value) }
+        self.hosts = report.hosts.sorted(by: { $0.value > $1.value }).map { ($0.key, $0.value) }
+    }
+
+    override func numberOfSections(in tableView: UITableView) -> Int {
+        return 4
+    }
+
+    override func tableView(_ tableView: UITableView, titleForHeaderInSection section: Int) -> String? {
+        switch section {
+        case 0: return self.russian ? "Разрешения" : "Permissions"
+        case 1: return self.russian ? "Вызовы API с запуска" : "API calls since launch"
+        case 2: return self.russian ? "Сетевые адреса" : "Network hosts"
+        default: return self.russian ? "Производительность" : "Performance"
+        }
+    }
+
+    override func tableView(_ tableView: UITableView, titleForFooterInSection section: Int) -> String? {
+        switch section {
+        case 0: return self.russian ? "Выключите разрешение, чтобы забрать его у плагина. Плагин перезапустится." : "Turn a permission off to take it back. The plugin restarts."
+        case 3: return self.russian ? "Если хук работает дольше 100 мс, AyuGram предупредит, что плагин тормозит." : "AyuGram warns when a hook takes longer than 100 ms."
+        default: return nil
+        }
+    }
+
+    override func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int {
+        switch section {
+        case 0: return max(1, self.permissions.count)
+        case 1: return max(1, self.calls.count)
+        case 2: return max(1, self.hosts.count)
+        default: return 3
+        }
+    }
+
+    override func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
+        let cell = UITableViewCell(style: .value1, reuseIdentifier: nil)
+        cell.selectionStyle = .none
+        let empty = self.russian ? "Нет" : "None"
+        switch indexPath.section {
+        case 0:
+            guard !self.permissions.isEmpty else {
+                cell.textLabel?.text = empty
+                cell.textLabel?.textColor = .secondaryLabel
+                return cell
+            }
+            let name = self.permissions[indexPath.row]
+            cell.textLabel?.text = AyuPluginPermission(rawValue: name)?.title(self.russian) ?? name
+            cell.textLabel?.numberOfLines = 0
+            let toggle = UISwitch()
+            toggle.isOn = !AyuPluginGrants.revoked(self.pluginId).contains(name)
+            toggle.tag = indexPath.row
+            toggle.addTarget(self, action: #selector(self.permissionChanged(_:)), for: .valueChanged)
+            cell.accessoryView = toggle
+        case 1:
+            if self.calls.isEmpty {
+                cell.textLabel?.text = empty
+                cell.textLabel?.textColor = .secondaryLabel
+            } else {
+                cell.textLabel?.text = self.calls[indexPath.row].0
+                cell.detailTextLabel?.text = "\(self.calls[indexPath.row].1)"
+            }
+        case 2:
+            if self.hosts.isEmpty {
+                cell.textLabel?.text = empty
+                cell.textLabel?.textColor = .secondaryLabel
+            } else {
+                cell.textLabel?.text = self.hosts[indexPath.row].0
+                cell.detailTextLabel?.text = "\(self.hosts[indexPath.row].1)"
+            }
+        default:
+            let timing = AyuHooks.shared.timing(owner: self.pluginId)
+            let calls = timing?.calls ?? 0
+            switch indexPath.row {
+            case 0:
+                cell.textLabel?.text = self.russian ? "Вызовов хуков" : "Hook calls"
+                cell.detailTextLabel?.text = "\(calls)"
+            case 1:
+                cell.textLabel?.text = self.russian ? "В среднем" : "Average"
+                cell.detailTextLabel?.text = calls == 0 ? "—" : String(format: "%.1f ms", (timing?.total ?? 0.0) / Double(calls) * 1000.0)
+            default:
+                cell.textLabel?.text = self.russian ? "Самый долгий" : "Slowest"
+                cell.detailTextLabel?.text = calls == 0 ? "—" : String(format: "%.1f ms", (timing?.slowest ?? 0.0) * 1000.0)
+            }
+        }
+        return cell
+    }
+
+    @objc private func permissionChanged(_ sender: UISwitch) {
+        guard sender.tag < self.permissions.count else { return }
+        AyuPluginGrants.setRevoked(self.pluginId, self.permissions[sender.tag], !sender.isOn)
+        // Restart so the instance gets the new permission set.
+        if AyuScriptRuntime.shared.plugin(id: self.pluginId)?.enabled == true {
+            AyuScriptRuntime.shared.setEnabled(self.pluginId, false)
+            AyuScriptRuntime.shared.setEnabled(self.pluginId, true)
+        }
+    }
+}
diff --git a/submodules/SettingsUI/Sources/AyuCustomizationController.swift b/submodules/SettingsUI/Sources/AyuCustomizationController.swift
new file mode 100644
index 00000000..ea7105ff
--- /dev/null
+++ b/submodules/SettingsUI/Sources/AyuCustomizationController.swift
@@ -0,0 +1,215 @@
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import PresentationDataUtils
+import ItemListUI
+import AccountContext
+
+// Settings → AyuGram → Customization: palettes, every colour by hand, badges for chats and for you.
+
+private func ayuCustomizationSignal() -> Signal<Void, NoError> {
+    return Signal { subscriber in
+        subscriber.putNext(Void())
+        let observer = NotificationCenter.default.addObserver(forName: AyuCustomization.didChangeNotification, object: nil, queue: .main, using: { _ in
+            subscriber.putNext(Void())
+        })
+        return ActionDisposable {
+            NotificationCenter.default.removeObserver(observer)
+        }
+    }
+}
+
+private let ayuColorRows: [(AyuCustomization.Color, String, String, String)] = [
+    (.accent, "paintpalette.fill", "Акцент (кнопки, ссылки)", "Accent (buttons, links)"),
+    (.outgoingBubble, "bubble.right.fill", "Мои сообщения", "My messages"),
+    (.outgoingText, "textformat", "Текст моих сообщений", "My message text"),
+    (.incomingBubble, "bubble.left.fill", "Чужие сообщения", "Their messages"),
+    (.incomingText, "textformat", "Текст чужих сообщений", "Their message text"),
+    (.wallpaper, "photo.fill", "Фон чата", "Chat background"),
+    (.wallpaperSecond, "circle.lefthalf.filled", "Второй цвет фона (градиент)", "Second background colour (gradient)"),
+    (.listBackground, "list.bullet.rectangle.fill", "Фон списков и настроек", "Lists and settings background"),
+    (.chatTitle, "person.text.rectangle.fill", "Имена в списке чатов", "Names in the chat list")
+]
+
+private let ayuQuickColors: [(String, String, String)] = [
+    ("#FF3B30", "Красный", "Red"), ("#FF9500", "Оранжевый", "Orange"), ("#FFCC00", "Жёлтый", "Yellow"),
+    ("#34C759", "Зелёный", "Green"), ("#00C7BE", "Бирюзовый", "Teal"), ("#007AFF", "Синий", "Blue"),
+    ("#5856D6", "Индиго", "Indigo"), ("#AF52DE", "Фиолетовый", "Purple"), ("#FF2D55", "Розовый", "Pink"),
+    ("#000000", "Чёрный", "Black"), ("#FFFFFF", "Белый", "White"), ("#8E8E93", "Серый", "Gray")
+]
+
+func ayuCustomizationController(context: AccountContext) -> ViewController {
+    var presentNative: ((UIViewController) -> Void)?
+    let russian = context.sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru")
+
+    func editColor(_ color: AyuCustomization.Color, title: String) {
+        let alert = UIAlertController(title: title, message: russian ? "HEX-код цвета, например #8E5CF7, или выберите ниже." : "A HEX colour such as #8E5CF7, or pick one below.", preferredStyle: .alert)
+        alert.addTextField { field in
+            field.placeholder = "#8E5CF7"
+            field.text = AyuCustomization.hex(color)
+            field.autocapitalizationType = .allCharacters
+            field.autocorrectionType = .no
+        }
+        alert.addAction(UIAlertAction(title: russian ? "Сохранить" : "Save", style: .default, handler: { [weak alert] _ in
+            let text = alert?.textFields?.first?.text ?? ""
+            if AyuCustomization.parse(text) != nil {
+                AyuCustomization.set(color, hex: text)
+            }
+        }))
+        alert.addAction(UIAlertAction(title: russian ? "Готовые цвета…" : "Quick colours…", style: .default, handler: { _ in
+            let sheet = UIAlertController(title: title, message: nil, preferredStyle: .actionSheet)
+            for (hex, nameRu, nameEn) in ayuQuickColors {
+                sheet.addAction(UIAlertAction(title: (russian ? nameRu : nameEn) + "  " + hex, style: .default, handler: { _ in AyuCustomization.set(color, hex: hex) }))
+            }
+            sheet.addAction(UIAlertAction(title: russian ? "Отмена" : "Cancel", style: .cancel))
+            presentNative?(sheet)
+        }))
+        if AyuCustomization.hex(color) != nil {
+            alert.addAction(UIAlertAction(title: russian ? "Как в теме" : "Theme default", style: .destructive, handler: { _ in AyuCustomization.set(color, hex: nil) }))
+        }
+        alert.addAction(UIAlertAction(title: russian ? "Отмена" : "Cancel", style: .cancel))
+        presentNative?(alert)
+    }
+
+    func editMyBadge() {
+        let alert = UIAlertController(title: russian ? "Мой бейдж" : "My badge", message: russian ? "Эмодзи или короткий текст после вашего имени в Настройках и профиле. Видите только вы." : "An emoji or short text after your name in Settings and your profile. Only you see it.", preferredStyle: .alert)
+        alert.addTextField { field in
+            field.placeholder = "👑"
+            field.text = AyuCustomization.myBadge
+        }
+        alert.addAction(UIAlertAction(title: russian ? "Сохранить" : "Save", style: .default, handler: { [weak alert] _ in
+            AyuCustomization.myBadge = alert?.textFields?.first?.text ?? ""
+        }))
+        alert.addAction(UIAlertAction(title: russian ? "Отмена" : "Cancel", style: .cancel))
+        presentNative?(alert)
+    }
+
+    func addBadge(peerId existing: Int64?) {
+        let alert = UIAlertController(title: russian ? "Бейдж чата" : "Chat badge", message: russian ? "Метка рядом с названием чата в списке: например «VIP», «⭐», «работа». Видите только вы." : "A label beside the chat's name in the list, such as “VIP”, “⭐” or “work”. Only you see it.", preferredStyle: .alert)
+        if existing == nil {
+            alert.addTextField { field in
+                field.placeholder = russian ? "@username или ID" : "@username or ID"
+                field.autocapitalizationType = .none
+                field.autocorrectionType = .no
+            }
+        }
+        alert.addTextField { field in
+            field.placeholder = russian ? "Бейдж" : "Badge"
+            field.text = existing.flatMap { AyuCustomization.badge(peerId: $0) }
+        }
+        alert.addAction(UIAlertAction(title: russian ? "Сохранить" : "Save", style: .default, handler: { [weak alert] _ in
+            let fields = alert?.textFields ?? []
+            let badge = fields.last?.text ?? ""
+            if let existing {
+                AyuCustomization.setBadge(badge, peerId: existing)
+                return
+            }
+            let target = (fields.first?.text ?? "").trimmingCharacters(in: .whitespacesAndNewlines)
+            if let id = Int64(target) {
+                let _ = (context.engine.data.get(TelegramEngine.EngineData.Item.Peer.Peer(id: EnginePeer.Id(id)))
+                |> deliverOnMainQueue).startStandalone(next: { peer in
+                    AyuCustomization.setBadge(badge, peerId: id, title: peer?.debugDisplayTitle ?? target)
+                })
+                return
+            }
+            let name = target.hasPrefix("@") ? String(target.dropFirst()) : target
+            guard !name.isEmpty else { return }
+            let _ = (context.engine.peers.resolvePeerByName(name: name, referrer: nil)
+            |> mapToSignal { result -> Signal<EnginePeer?, NoError> in
+                if case let .result(peer) = result { return .single(peer) }
+                return .complete()
+            }
+            |> take(1)
+            |> deliverOnMainQueue).startStandalone(next: { peer in
+                guard let peer else {
+                    let failed = UIAlertController(title: "AyuGram", message: russian ? "Не нашёл @\(name)." : "Could not find @\(name).", preferredStyle: .alert)
+                    failed.addAction(UIAlertAction(title: "OK", style: .default))
+                    presentNative?(failed)
+                    return
+                }
+                AyuCustomization.setBadge(badge, peerId: peer.id.toInt64(), title: peer.debugDisplayTitle)
+            })
+        }))
+        if let existing, AyuCustomization.badge(peerId: existing) != nil {
+            alert.addAction(UIAlertAction(title: russian ? "Убрать бейдж" : "Remove badge", style: .destructive, handler: { _ in AyuCustomization.setBadge(nil, peerId: existing) }))
+        }
+        alert.addAction(UIAlertAction(title: russian ? "Отмена" : "Cancel", style: .cancel))
+        presentNative?(alert)
+    }
+
+    var badgeRows: [Int32: Int64] = [:]
+
+    let arguments = AyuSectionedArguments(open: { id in
+        switch id {
+        case 1 ... 15:
+            let index = Int(id - 1)
+            if AyuCustomization.presets.indices.contains(index) {
+                AyuCustomization.apply(AyuCustomization.presets[index])
+            }
+        case 17 ... 25:
+            let index = Int(id - 17)
+            if ayuColorRows.indices.contains(index) {
+                let row = ayuColorRows[index]
+                editColor(row.0, title: russian ? row.2 : row.3)
+            }
+        case 31:
+            editMyBadge()
+        case 32:
+            addBadge(peerId: nil)
+        case 99:
+            let alert = UIAlertController(title: russian ? "Сбросить кастомизацию?" : "Reset customization?", message: russian ? "Все цвета вернутся к теме, бейджи удалятся." : "All colours return to the theme and badges are removed.", preferredStyle: .alert)
+            alert.addAction(UIAlertAction(title: russian ? "Сбросить" : "Reset", style: .destructive, handler: { _ in AyuCustomization.resetAll() }))
+            alert.addAction(UIAlertAction(title: russian ? "Отмена" : "Cancel", style: .cancel))
+            presentNative?(alert)
+        default:
+            if let peerId = badgeRows[id] {
+                addBadge(peerId: peerId)
+            }
+        }
+    }, toggle: { _, _ in })
+
+    func symbol(_ name: String, _ color: UInt32) -> UIImage? {
+        return AyuSettingsIcons.symbol(name, color: UIColor(rgb: color))
+    }
+
+    let signal = combineLatest(context.sharedContext.presentationData, ayuCustomizationSignal())
+    |> deliverOnMainQueue
+    |> map { presentationData, _ -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        var entries: [AyuSectionedEntry] = [.header(1, 0, ru ? "ГОТОВЫЕ ПАЛИТРЫ" : "PALETTES")]
+        for (index, preset) in AyuCustomization.presets.enumerated() where index < 15 {
+            let tint = preset.colors[.accent].flatMap(AyuCustomization.parse) ?? 0x8E5CF7
+            entries.append(.link(1, Int32(1 + index), symbol("circle.hexagongrid.fill", tint), ru ? preset.nameRu : preset.nameEn, ""))
+        }
+        entries.append(.header(2, 16, ru ? "СВОИ ЦВЕТА" : "YOUR COLOURS"))
+        for (index, row) in ayuColorRows.enumerated() {
+            let value = AyuCustomization.rgb(row.0)
+            entries.append(.link(2, Int32(17 + index), symbol(row.1, value ?? 0x8E8E93), ru ? row.2 : row.3, AyuCustomization.hex(row.0) ?? (ru ? "как в теме" : "theme")))
+        }
+        entries.append(.info(2, 26, ru ? "Цвета ложатся поверх любой темы и применяются после перезапуска приложения." : "Colours go on top of any theme and apply after the app is relaunched."))
+        entries.append(.header(3, 30, ru ? "БЕЙДЖИ" : "BADGES"))
+        entries.append(.link(3, 31, symbol("crown.fill", 0xFFCC00), ru ? "Мой бейдж" : "My badge", AyuCustomization.myBadge.isEmpty ? (ru ? "нет" : "none") : AyuCustomization.myBadge))
+        entries.append(.link(3, 32, symbol("plus.circle.fill", 0x34C759), ru ? "Добавить бейдж чату" : "Add a chat badge", ""))
+        badgeRows = [:]
+        var nextId: Int32 = 40
+        for (peerId, badge) in AyuCustomization.peerBadges.sorted(by: { $0.key < $1.key }) where nextId < 95 {
+            entries.append(.link(3, nextId, symbol("tag.fill", 0xAF52DE), AyuCustomization.badgeTitle(peerId: peerId) ?? String(peerId), badge))
+            badgeRows[nextId] = peerId
+            nextId += 1
+        }
+        entries.append(.info(3, 96, ru ? "Бейджи видны только на этом устройстве: в списке чатов рядом с названием и после вашего имени в профиле." : "Badges are only on this device: beside chat names in the list and after your name in your profile."))
+        entries.append(.header(4, 97, ru ? "СБРОС" : "RESET"))
+        entries.append(.link(4, 99, symbol("arrow.counterclockwise", 0xFF3B30), ru ? "Сбросить кастомизацию" : "Reset customization", ""))
+        let data = ItemListPresentationData(presentationData)
+        let state = ItemListControllerState(presentationData: data, title: .text(ru ? "Кастомизация" : "Customization"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        return (state, (ItemListNodeState(presentationData: data, entries: entries, style: .blocks, animateChanges: true), arguments))
+    }
+    let controller = ItemListController(context: context, state: signal)
+    presentNative = { viewController in
+        context.sharedContext.applicationBindings.presentNativeController(viewController)
+    }
+    return controller
+}
