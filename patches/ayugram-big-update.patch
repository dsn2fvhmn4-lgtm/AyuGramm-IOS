+private final class AyuFakeAvatarView: UIView {
+    private let gradient = CAGradientLayer()
+    private let label = UILabel()
+
+    init(title: String, colors: (UInt32, UInt32), size: CGFloat) {
+        super.init(frame: CGRect(x: 0.0, y: 0.0, width: size, height: size))
+        self.gradient.colors = [ayuFakeColor(colors.0).cgColor, ayuFakeColor(colors.1).cgColor]
+        self.gradient.startPoint = CGPoint(x: 0.5, y: 0.0)
+        self.gradient.endPoint = CGPoint(x: 0.5, y: 1.0)
