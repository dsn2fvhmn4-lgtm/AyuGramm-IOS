+private func ayuToolsSignal() -> Signal<Void, NoError> {
+    return Signal { subscriber in
+        subscriber.putNext(Void())
+        let observers = [AyuTools.didChangeNotification, AyuHotReload.didChangeNotification].map { name in
+            NotificationCenter.default.addObserver(forName: name, object: nil, queue: .main, using: { _ in
