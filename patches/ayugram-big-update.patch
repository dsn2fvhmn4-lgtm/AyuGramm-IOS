+#ifdef SMALLMAP_T__SOURCE
+/* Implementation */
+
+void METHOD(ctor)(NAME* self) {
+    c11_vector__ctor(self, sizeof(KV));
+    c11_vector__reserve(self, 4);
+}
+
+void METHOD(dtor)(NAME* self) { c11_vector__dtor(self); }
