+import Foundation
+import Postbox
+import SwiftSignalKit
+
+/// Which of the 12 activity statuses ("typing…", "recording a voice message…") are never sent,
+/// independent of Ghost Mode's on/off switches.
+public enum AyuActivityFilter {
+    public enum Kind: String, CaseIterable {
+        case typing, uploadingFile, recordingVoice, uploadingPhoto, uploadingVideo, playingGame
+        case recordingVideoMessage, uploadingVideoMessage, speakingInCall, choosingSticker, interactingWithEmoji, watchingEmoji
+
+        public func title(_ ru: Bool) -> String {
+            switch self {
+            case .typing: return ru ? "Печатает" : "Typing"
+            case .uploadingFile: return ru ? "Отправляет файл" : "Sending a file"
+            case .recordingVoice: return ru ? "Записывает голосовое" : "Recording a voice message"
+            case .uploadingPhoto: return ru ? "Отправляет фото" : "Sending a photo"
+            case .uploadingVideo: return ru ? "Отправляет видео" : "Sending a video"
+            case .playingGame: return ru ? "Играет" : "Playing a game"
+            case .recordingVideoMessage: return ru ? "Записывает кружок" : "Recording a video message"
+            case .uploadingVideoMessage: return ru ? "Отправляет кружок" : "Sending a video message"
+            case .speakingInCall: return ru ? "Говорит в звонке" : "Speaking in a call"
+            case .choosingSticker: return ru ? "Выбирает стикер" : "Choosing a sticker"
+            case .interactingWithEmoji: return ru ? "Нажимает на эмодзи" : "Tapping an emoji"
+            case .watchingEmoji: return ru ? "Смотрит эмодзи-анимацию" : "Watching an emoji animation"
+            }
+        }
+    }
+
+    private static let key = "ayu.activity.hidden"
+    private static let lock = NSLock()
+    private static var cache: Set<String>?
+
+    public static var hidden: Set<Kind> {
+        lock.lock(); defer { lock.unlock() }
+        if cache == nil {
+            cache = Set(UserDefaults.standard.stringArray(forKey: key) ?? [])
+        }
+        return Set((cache ?? []).compactMap(Kind.init(rawValue:)))
+    }
+
+    public static func setHidden(_ kind: Kind, _ value: Bool) {
+        lock.lock()
+        var set = cache ?? Set(UserDefaults.standard.stringArray(forKey: key) ?? [])
+        if value { set.insert(kind.rawValue) } else { set.remove(kind.rawValue) }
+        cache = set
+        lock.unlock()
+        UserDefaults.standard.set(Array(set), forKey: key)
+    }
+
+    static func kind(_ activity: PeerInputActivity) -> Kind {
+        switch activity {
+        case .typingText: return .typing
+        case .uploadingFile: return .uploadingFile
+        case .recordingVoice: return .recordingVoice
+        case .uploadingPhoto: return .uploadingPhoto
+        case .uploadingVideo: return .uploadingVideo
+        case .playingGame: return .playingGame
+        case .recordingInstantVideo: return .recordingVideoMessage
+        case .uploadingInstantVideo: return .uploadingVideoMessage
+        case .speakingInGroupCall: return .speakingInCall
+        case .choosingSticker: return .choosingSticker
+        case .interactingWithEmoji: return .interactingWithEmoji
+        case .seeingEmojiInteraction: return .watchingEmoji
+        }
+    }
+
+    static func isHidden(_ activity: PeerInputActivity) -> Bool {
+        guard !AyuDecoyState.isActive else { return false }
+        lock.lock(); defer { lock.unlock() }
+        if cache == nil {
+            cache = Set(UserDefaults.standard.stringArray(forKey: key) ?? [])
+        }
+        guard let cache, !cache.isEmpty else { return false }
+        return cache.contains(kind(activity).rawValue)
+    }
+}
+
+public extension TelegramEngine.Messages {
+    /// "Read locally": clears unread counters on this device without telling anyone. The server
+    /// state is untouched, so other devices and the senders still see the messages as unread.
+    func ayuReadAllLocally() -> Signal<Int, NoError> {
+        return self.account.postbox.transaction { transaction -> Int in
+            var count = 0
+            for groupId in [PeerGroupId.root, Namespaces.PeerGroup.archive] {
+                for peerId in transaction.getUnreadChatListPeerIds(groupId: groupId, filterPredicate: nil, additionalFilter: nil, stopOnFirstMatch: false) {
+                    guard let top = transaction.getTopPeerMessageId(peerId: peerId, namespace: Namespaces.Message.Cloud) else { continue }
+                    transaction.applyIncomingReadMaxId(top)
+                    count += 1
+                }
+            }
+            return count
+        }
+    }
+}
+
+/// Story views under Ghost Mode: with read receipts hidden and "Hide story views" on, viewing a
+/// story sends neither the read mark nor the view.
+public enum AyuStoryPrivacy {
+    public static let key = "ayu.ghost.hideStoryViews"
+
+    public static var isEnabled: Bool {
+        get { return UserDefaults.standard.bool(forKey: key) }
+        set { UserDefaults.standard.set(newValue, forKey: key) }
+    }
+
+    public static func hidesViews(_ network: Network) -> Bool {
+        return isEnabled && !AyuDecoyState.isActive && network.ayuGhostMode.current.hideReadReceipts
+    }
+}
