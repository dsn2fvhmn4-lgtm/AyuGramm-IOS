diff --git a/submodules/TelegramUI/Sources/AyuSystemIntegration.swift b/submodules/TelegramUI/Sources/AyuSystemIntegration.swift
new file mode 100644
index 00000000..df7c9885
--- /dev/null
+++ b/submodules/TelegramUI/Sources/AyuSystemIntegration.swift
@@ -0,0 +1,262 @@
+import Foundation
+import UIKit
+import SwiftSignalKit
+import Display
+import TelegramCore
+import AccountContext
+import WidgetKit
+import LocalizedPeerData
+@_weakLinked import ActivityKit
+
+/// The app side of AyuGram's system integration:
+/// - answers App Intents (Shortcuts, Siri) sent through NotificationCenter by the AyuAppIntents module;
+/// - keeps the shared app-group state the Control Center toggle and widgets read;
+/// - applies a Ghost Mode change requested from Control Center;
+/// - shows the music player's track as a Live Activity (Extras toggle).
+enum AyuSystemIntegration {
+    static let requestName = Notification.Name("AyuGram.Intent.Request")
+    static let replyName = Notification.Name("AyuGram.Intent.Reply")
+    /// Darwin notification the widget extension posts after a Control Center tap.
+    static let controlDarwinName = "one.ayugram.control.ghost"
+
+    private static weak var sharedContext: SharedAccountContext?
+    private static var installed = false
+
+    static var groupDefaults: UserDefaults? {
+        guard let bundleId = Bundle.main.bundleIdentifier else { return nil }
+        return UserDefaults(suiteName: "group." + bundleId)
+    }
+
+    static func install(sharedContext: SharedAccountContext) {
+        guard !installed else { return }
+        installed = true
+        self.sharedContext = sharedContext
+
+        let _ = NotificationCenter.default.addObserver(forName: requestName, object: nil, queue: .main, using: { notification in
+            guard let info = notification.userInfo as? [String: Any], let id = info["id"] as? String, let action = info["action"] as? String else { return }
+            handle(action: action, info: info, reply: { result in
+                var payload = result
+                payload["id"] = id
+                NotificationCenter.default.post(name: replyName, object: nil, userInfo: payload)
+            })
+        })
+        let _ = NotificationCenter.default.addObserver(forName: UIApplication.didBecomeActiveNotification, object: nil, queue: .main, using: { _ in
+            applyControlRequest()
+            publishGhostState()
+        })
+        CFNotificationCenterAddObserver(CFNotificationCenterGetDarwinNotifyCenter(), nil, { _, _, _, _, _ in
+            DispatchQueue.main.async {
+                AyuSystemIntegration.applyControlRequest()
+            }
+        }, controlDarwinName as CFString, nil, .deliverImmediately)
+
+        AyuGhostFolders.install(sharedContext: sharedContext)
+
+        // Mirror the Ghost Mode state for the Control Center toggle whenever the app comes and goes.
+        let _ = NotificationCenter.default.addObserver(forName: UIApplication.willResignActiveNotification, object: nil, queue: .main, using: { _ in
+            publishGhostState()
+        })
+        applyControlRequest()
+    }
+
+    static func publishGhostState() {
+        primaryContext({ context in
+            let active = (context?.account.network.ayuGhostMode.current.isActive ?? false) && !AyuDecoyMode.isActive
+            groupDefaults?.set(active, forKey: "ayu.ghost.active")
+            if #available(iOS 18.0, *) {
+                ControlCenter.shared.reloadAllControls()
+            }
+        })
+    }
+
+    private static func primaryContext(_ completion: @escaping (AccountContext?) -> Void) {
+        guard let sharedContext else {
+            completion(nil)
+            return
+        }
+        let _ = (sharedContext.activeAccountContexts
+        |> map { primary, _, _ in primary }
+        |> filter { $0 != nil }
+        |> take(1)
+        |> timeout(15.0, queue: .mainQueue(), alternate: .single(nil))
+        |> deliverOnMainQueue).startStandalone(next: { context in
+            completion(context)
+        })
+    }
+
+    static func setGhost(_ enabled: Bool, completion: @escaping (Bool) -> Void) {
+        guard !AyuDecoyMode.isActive else {
+            completion(false)
+            return
+        }
+        primaryContext({ context in
+            guard let context else {
+                completion(false)
+                return
+            }
+            try? context.account.network.ayuGhostMode.update { settings in
+                settings.hideReadReceipts = enabled
+                settings.hideOnline = enabled
+                settings.hideTyping = enabled
+                settings.hideUploadProgress = enabled
+            }
+            publishGhostState()
+            completion(true)
+        })
+    }
+
+    /// A Control Center tap stores the wanted state; the app applies it when it next runs.
+    static func applyControlRequest() {
+        guard let defaults = groupDefaults, defaults.object(forKey: "ayu.ghost.request") != nil else { return }
+        let wanted = defaults.bool(forKey: "ayu.ghost.request")
+        defaults.removeObject(forKey: "ayu.ghost.request")
+        setGhost(wanted, completion: { _ in })
+    }
+
+    private static func handle(action: String, info: [String: Any], reply: @escaping ([String: Any]) -> Void) {
+        switch action {
+        case "ghost.set":
+            setGhost(info["enabled"] as? Bool ?? true, completion: { ok in reply(["ok": ok]) })
+        case "unread.count":
+            primaryContext({ context in
+                guard let context else {
+                    reply(["ok": false])
+                    return
+                }
+                let _ = (context.engine.data.get(TelegramEngine.EngineData.Item.Messages.TotalReadCounters())
+                |> deliverOnMainQueue).startStandalone(next: { counters in
+                    reply(["ok": true, "messages": Int(counters.count(for: .filtered, in: .messages, with: .all)), "chats": Int(counters.count(for: .filtered, in: .chats, with: .all))])
+                })
+            })
+        case "message.send":
+            let recipient = (info["recipient"] as? String ?? "").trimmingCharacters(in: .whitespacesAndNewlines)
+            let text = info["text"] as? String ?? ""
+            guard !recipient.isEmpty, !text.isEmpty, !AyuDecoyMode.isActive else {
+                reply(["ok": false])
+                return
+            }
+            primaryContext({ context in
+                guard let context else {
+                    reply(["ok": false])
+                    return
+                }
+                let ru = context.sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru")
+                let send: (EnginePeer) -> Void = { peer in
+                    let _ = enqueueMessages(account: context.account, peerId: peer.id, messages: [.message(text: text, attributes: [], inlineStickers: [:], mediaReference: nil, threadId: nil, replyToMessageId: nil, replyToStoryId: nil, localGroupingKey: nil, correlationId: nil, bubbleUpEmojiOrStickersets: [])]).startStandalone()
+                    reply(["ok": true, "title": peer.compactDisplayTitle])
+                }
+                if recipient.hasPrefix("@") || !recipient.contains(" ") {
+                    let name = recipient.hasPrefix("@") ? String(recipient.dropFirst()) : recipient
+                    let _ = (context.engine.peers.resolvePeerByName(name: name, referrer: nil)
+                    |> mapToSignal { result -> Signal<EnginePeer?, NoError> in
+                        guard case let .result(peer) = result else { return .complete() }
+                        return .single(peer)
+                    }
+                    |> take(1)
+                    |> deliverOnMainQueue).startStandalone(next: { peer in
+                        if let peer {
+                            send(peer)
+                        } else {
+                            searchAndSend(context: context, query: recipient, ru: ru, send: send, reply: reply)
+                        }
+                    })
+                } else {
+                    searchAndSend(context: context, query: recipient, ru: ru, send: send, reply: reply)
+                }
+            })
+        default:
+            reply(["ok": false])
+        }
+    }
+
+    private static func searchAndSend(context: AccountContext, query: String, ru: Bool, send: @escaping (EnginePeer) -> Void, reply: @escaping ([String: Any]) -> Void) {
+        let _ = (context.engine.contacts.searchLocalPeers(query: query)
+        |> take(1)
+        |> deliverOnMainQueue).startStandalone(next: { peers in
+            if let peer = peers.first?.peer {
+                send(peer)
+            } else {
+                reply(["ok": false, "error": ru ? "Чат «\(query)» не найден." : "No chat named “\(query)”."])
+            }
+        })
+    }
+}
+
+// MARK: - Live Activity: now playing
+
+/// Must match the widget extension's AyuNowPlayingAttributes field for field.
+@available(iOS 16.1, *)
+struct AyuNowPlayingAttributes: ActivityAttributes {
+    public struct ContentState: Codable, Hashable {
+        var title: String
+        var artist: String
+        var playing: Bool
+    }
+    var appName: String
+}
+
+enum AyuNowPlayingActivity {
+    private static var current: Any?
+
+    static var isEnabled: Bool {
+        return AyuExtras.isOn(.nowPlayingLiveActivity) && !AyuDecoyMode.isActive
+    }
+
+    static func update(title: String, artist: String?, playing: Bool) {
+        guard #available(iOS 16.2, *), isEnabled, ActivityAuthorizationInfo().areActivitiesEnabled else { return }
+        let state = AyuNowPlayingAttributes.ContentState(title: String(title.prefix(80)), artist: String((artist ?? "").prefix(80)), playing: playing)
+        if let activity = current as? Activity<AyuNowPlayingAttributes>, activity.activityState == .active {
+            Task {
+                await activity.update(ActivityContent(state: state, staleDate: nil))
+            }
+        } else {
+            current = try? Activity.request(attributes: AyuNowPlayingAttributes(appName: "AyuGram"), content: ActivityContent(state: state, staleDate: nil), pushType: nil)
+        }
+    }
+
+    static func end() {
+        guard #available(iOS 16.2, *), let activity = current as? Activity<AyuNowPlayingAttributes> else { return }
+        current = nil
+        Task {
+            await activity.end(nil, dismissalPolicy: .immediate)
+        }
+    }
+}
+
+/// Ghost Mode exceptions by folder: the chats of the chosen folders ("ayu.ghost.exceptFolders",
+/// folder ids) are written to "ayu.ghost.exceptFolderPeers" whenever the folders change.
+enum AyuGhostFolders {
+    private static var disposable: Disposable?
+
+    static func install(sharedContext: SharedAccountContext) {
+        guard disposable == nil else { return }
+        let folders = sharedContext.activeAccountContexts
+        |> map { primary, _, _ in primary }
+        |> mapToSignal { context -> Signal<[ChatListFilter], NoError> in
+            guard let context else { return .single([]) }
+            return context.engine.peers.updatedChatListFilters()
+        }
+        disposable = combineLatest(folders, ayuNotificationSignal(Notification.Name("AyuGram.GhostFoldersChanged")))
+        .startStrict(next: { filters, _ in
+            let chosen = Set(UserDefaults.standard.array(forKey: "ayu.ghost.exceptFolders") as? [Int32] ?? [])
+            var peers = Set<Int64>()
+            for filter in filters {
+                if case let .filter(id, _, _, data) = filter, chosen.contains(id) {
+                    for peerId in data.includePeers.peers + data.includePeers.pinnedPeers {
+                        peers.insert(peerId.toInt64())
+                    }
+                }
+            }
+            UserDefaults.standard.set(peers.map { NSNumber(value: $0) }, forKey: "ayu.ghost.exceptFolderPeers")
+        })
+    }
+}
+
+/// Fires once now and on every post of the notification.
+func ayuNotificationSignal(_ name: Notification.Name) -> Signal<Void, NoError> {
+    return Signal { subscriber in
+        subscriber.putNext(Void())
+        let observer = NotificationCenter.default.addObserver(forName: name, object: nil, queue: nil, using: { _ in subscriber.putNext(Void()) })
+        return ActionDisposable { NotificationCenter.default.removeObserver(observer) }
+    }
+}
