+/// AyuGram Slow-Motion: one factor for every animation in the client, on device as well as in
+/// the simulator. Telegram's own animations already scale their durations by this function;
+/// UIKit block animations are scaled by the swizzles below once Slow-Motion is first enabled.
+static double ayuSlowMotionFactorValue = 1.0;
+
+@interface UIView (AyuSlowMotion)
+@end
+
+@implementation UIView (AyuSlowMotion)
+
++ (void)_ayu_animateWithDuration:(NSTimeInterval)duration delay:(NSTimeInterval)delay options:(UIViewAnimationOptions)options animations:(void (^)(void))animations completion:(void (^ _Nullable)(BOOL))completion {
+    [self _ayu_animateWithDuration:duration * ayuSlowMotionFactorValue delay:delay * ayuSlowMotionFactorValue options:options animations:animations completion:completion];
+}
+
++ (void)_ayu_animateWithDuration:(NSTimeInterval)duration delay:(NSTimeInterval)delay usingSpringWithDamping:(CGFloat)dampingRatio initialSpringVelocity:(CGFloat)velocity options:(UIViewAnimationOptions)options animations:(void (^)(void))animations completion:(void (^ _Nullable)(BOOL))completion {
+    [self _ayu_animateWithDuration:duration * ayuSlowMotionFactorValue delay:delay * ayuSlowMotionFactorValue usingSpringWithDamping:dampingRatio initialSpringVelocity:velocity / ayuSlowMotionFactorValue options:options animations:animations completion:completion];
+}
+
+@end
+
+void ayuSetAnimationSlowMotionFactor(double factor) {
+    ayuSlowMotionFactorValue = MAX(1.0, MIN(20.0, factor));
+    if (ayuSlowMotionFactorValue > 1.0) {
+        static dispatch_once_t onceToken;
+        dispatch_once(&onceToken, ^{
+            [RuntimeUtils swizzleClassMethodOfClass:[UIView class] currentSelector:@selector(animateWithDuration:delay:options:animations:completion:) newSelector:@selector(_ayu_animateWithDuration:delay:options:animations:completion:)];
+            [RuntimeUtils swizzleClassMethodOfClass:[UIView class] currentSelector:@selector(animateWithDuration:delay:usingSpringWithDamping:initialSpringVelocity:options:animations:completion:) newSelector:@selector(_ayu_animateWithDuration:delay:usingSpringWithDamping:initialSpringVelocity:options:animations:completion:)];
+        });
+    }
+}
+
+double ayuAnimationSlowMotionFactor(void) {
+    return ayuSlowMotionFactorValue;
+}
+
 double animationDurationFactorImpl() {
 #if TARGET_IPHONE_SIMULATOR
-    return (double)UIAnimationDragCoefficient();
-#endif   
-    return 1.0f;
+    return (double)UIAnimationDragCoefficient() * ayuSlowMotionFactorValue;
+#endif
+    return ayuSlowMotionFactorValue;
