+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import AccountContext
+
+/// Word-level difference between two texts (LCS over words and the spaces between them).
+enum AyuTextDiff {
+    enum Part: Equatable {
+        case same(String)
+        case removed(String)
+        case added(String)
+    }
+
+    static func tokens(_ text: String) -> [String] {
+        var result: [String] = []
+        var current = ""
+        var currentIsSpace: Bool?
+        for character in text {
+            let isSpace = character.isWhitespace
+            if let state = currentIsSpace, state != isSpace {
+                result.append(current)
+                current = ""
+            }
+            current.append(character)
+            currentIsSpace = isSpace
+        }
+        if !current.isEmpty {
+            result.append(current)
+        }
+        return result
+    }
+
+    static func diff(_ old: String, _ new: String) -> [Part] {
+        let a = tokens(old)
+        let b = tokens(new)
+        // Very long texts fall back to "all removed / all added" to keep the table small.
+        guard a.count * b.count <= 400_000 else {
+            return [.removed(old), .added(new)]
+        }
+        var table = [[Int]](repeating: [Int](repeating: 0, count: b.count + 1), count: a.count + 1)
+        for i in stride(from: a.count - 1, through: 0, by: -1) {
+            for j in stride(from: b.count - 1, through: 0, by: -1) {
+                table[i][j] = a[i] == b[j] ? table[i + 1][j + 1] + 1 : max(table[i + 1][j], table[i][j + 1])
+            }
+        }
+        var parts: [Part] = []
+        func push(_ part: Part) {
+            switch (parts.last, part) {
+            case let (.same(x)?, .same(y)): parts[parts.count - 1] = .same(x + y)
+            case let (.removed(x)?, .removed(y)): parts[parts.count - 1] = .removed(x + y)
+            case let (.added(x)?, .added(y)): parts[parts.count - 1] = .added(x + y)
+            default: parts.append(part)
+            }
+        }
+        var i = 0
+        var j = 0
+        while i < a.count && j < b.count {
+            if a[i] == b[j] {
+                push(.same(a[i]))
+                i += 1
+                j += 1
+            } else if table[i + 1][j] >= table[i][j + 1] {
+                push(.removed(a[i]))
+                i += 1
+            } else {
+                push(.added(b[j]))
+                j += 1
+            }
+        }
+        while i < a.count {
+            push(.removed(a[i]))
+            i += 1
+        }
+        while j < b.count {
+            push(.added(b[j]))
+            j += 1
+        }
+        return parts
+    }
+
+    static func attributed(_ parts: [Part], font: UIFont) -> NSAttributedString {
+        let result = NSMutableAttributedString()
+        for part in parts {
+            switch part {
+            case let .same(text):
+                result.append(NSAttributedString(string: text, attributes: [.font: font, .foregroundColor: UIColor.label]))
+            case let .removed(text):
+                result.append(NSAttributedString(string: text, attributes: [.font: font, .foregroundColor: UIColor.systemRed, .strikethroughStyle: NSUnderlineStyle.single.rawValue, .backgroundColor: UIColor.systemRed.withAlphaComponent(0.12)]))
+            case let .added(text):
+                result.append(NSAttributedString(string: text, attributes: [.font: font, .foregroundColor: UIColor.systemGreen, .backgroundColor: UIColor.systemGreen.withAlphaComponent(0.14)]))
+            }
+        }
+        return result
+    }
+}
+
+/// Every saved deleted and edited message across chats, with search and filters.
+final class AyuHistoryFeedController: UITableViewController, UISearchResultsUpdating {
+    private let context: AccountContext
+    private let russian: Bool
+    private var records: [AyuMessageHistoryRecord] = []
+    private var shown: [AyuMessageHistoryRecord] = []
+    private var titles: [Int64: String] = [:]
+    private let filter = UISegmentedControl()
+    private let search = UISearchController(searchResultsController: nil)
+    private var disposable: Disposable?
+
+    init(context: AccountContext) {
+        self.context = context
+        self.russian = context.sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru")
+        super.init(style: .insetGrouped)
+        self.title = self.russian ? "Удалённые и изменённые" : "Deleted and edited"
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    deinit {
+        self.disposable?.dispose()
+    }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        for (index, title) in (self.russian ? ["Все", "Удалённые", "Изменённые"] : ["All", "Deleted", "Edited"]).enumerated() {
+            self.filter.insertSegment(withTitle: title, at: index, animated: false)
+        }
+        self.filter.selectedSegmentIndex = 0
+        self.filter.addTarget(self, action: #selector(self.refilter), for: .valueChanged)
+        self.navigationItem.titleView = self.filter
+        self.search.searchResultsUpdater = self
+        self.search.obscuresBackgroundDuringPresentation = false
+        self.search.searchBar.placeholder = self.russian ? "Текст или чат" : "Text or chat"
+        self.navigationItem.searchController = self.search
+        self.navigationItem.hidesSearchBarWhenScrolling = false
+        self.navigationItem.rightBarButtonItem = UIBarButtonItem(barButtonSystemItem: .done, target: self, action: #selector(self.close))
+        self.tableView.register(UITableViewCell.self, forCellReuseIdentifier: "record")
+
+        let context = self.context
+        self.disposable = (context.engine.messages.ayuMessageHistory()
+        |> mapToSignal { state -> Signal<(AyuMessageHistoryState, [Int64: String]), NoError> in
+            let peerIds = Array(Set(state.records.map { EnginePeer.Id($0.peerId) }))
+            return context.engine.data.get(EngineDataMap(peerIds.map(TelegramEngine.EngineData.Item.Peer.Peer.init(id:))))
+            |> map { peers -> (AyuMessageHistoryState, [Int64: String]) in
+                var titles: [Int64: String] = [:]
+                for (id, peer) in peers {
+                    if let peer {
+                        titles[id.toInt64()] = peer.debugDisplayTitle
+                    }
+                }
+                return (state, titles)
+            }
+        }
+        |> deliverOnMainQueue).startStrict(next: { [weak self] state, titles in
+            guard let self else { return }
+            self.records = state.records.sorted(by: { $0.capturedAt > $1.capturedAt })
+            self.titles = titles
+            self.refilter()
+        })
+    }
+
+    @objc private func close() {
+        self.dismiss(animated: true)
+    }
+
+    @objc private func refilter() {
+        let query = (self.search.searchBar.text ?? "").trimmingCharacters(in: .whitespacesAndNewlines).lowercased()
+        let kind: AyuMessageHistoryRecord.Kind? = self.filter.selectedSegmentIndex == 1 ? .deleted : (self.filter.selectedSegmentIndex == 2 ? .edited : nil)
+        self.shown = self.records.filter { record in
+            if let kind, record.kind != kind {
+                return false
+            }
+            if query.isEmpty {
+                return true
+            }
+            return record.text.lowercased().contains(query) || (self.titles[record.peerId]?.lowercased().contains(query) ?? false)
+        }
+        self.tableView.reloadData()
+    }
+
+    func updateSearchResults(for searchController: UISearchController) {
+        self.refilter()
+    }
+
+    override func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int {
+        return max(1, self.shown.count)
+    }
+
+    override func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
+        let cell = UITableViewCell(style: .subtitle, reuseIdentifier: nil)
+        guard !self.shown.isEmpty else {
+            cell.textLabel?.text = self.russian ? "Пока пусто: включите сохранение удалённых и изменённых в AyuGram → История." : "Nothing yet: turn on saving deleted and edited messages in AyuGram → History."
+            cell.textLabel?.numberOfLines = 0
+            cell.textLabel?.textColor = .secondaryLabel
+            cell.selectionStyle = .none
+            return cell
+        }
+        let record = self.shown[indexPath.row]
+        let date = DateFormatter.localizedString(from: Date(timeIntervalSince1970: TimeInterval(record.capturedAt)), dateStyle: .short, timeStyle: .short)
+        let marker = record.kind == .deleted ? "🗑" : "✏️"
+        cell.textLabel?.text = marker + " " + (record.text.isEmpty ? (self.russian ? "(медиа)" : "(media)") : record.text)
+        cell.textLabel?.numberOfLines = 3
+        cell.detailTextLabel?.text = (self.titles[record.peerId] ?? String(record.peerId)) + " · " + date
+        cell.detailTextLabel?.textColor = .secondaryLabel
+        cell.accessoryType = .disclosureIndicator
+        return cell
+    }
+
+    override func tableView(_ tableView: UITableView, didSelectRowAt indexPath: IndexPath) {
+        tableView.deselectRow(at: indexPath, animated: true)
+        guard indexPath.row < self.shown.count else { return }
+        let record = self.shown[indexPath.row]
+        let peerId = EnginePeer.Id(record.peerId)
+        let messageId = EngineMessage.Id(peerId: peerId, namespace: Namespaces.Message.Cloud, id: record.messageId)
+        let _ = (self.context.engine.data.get(TelegramEngine.EngineData.Item.Messages.Message(id: messageId))
+        |> deliverOnMainQueue).startStandalone(next: { [weak self] message in
+            guard let self else { return }
+            self.navigationController?.pushViewController(AyuHistoryRecordDiffController(record: record, currentText: record.kind == .edited ? message?.text : nil, chatTitle: self.titles[record.peerId], russian: self.russian), animated: true)
+        })
+    }
+}
+
+/// One record: the saved text, and for an edit the word-level difference to the current text.
+final class AyuHistoryRecordDiffController: UIViewController {
+    private let record: AyuMessageHistoryRecord
+    private let currentText: String?
+    private let chatTitle: String?
+    private let russian: Bool
+
+    init(record: AyuMessageHistoryRecord, currentText: String?, chatTitle: String?, russian: Bool) {
+        self.record = record
+        self.currentText = currentText
+        self.chatTitle = chatTitle
+        self.russian = russian
+        super.init(nibName: nil, bundle: nil)
+        self.title = chatTitle ?? (russian ? "Сообщение" : "Message")
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        self.view.backgroundColor = .systemGroupedBackground
+        let textView = UITextView()
+        textView.isEditable = false
+        textView.backgroundColor = .secondarySystemGroupedBackground
+        textView.layer.cornerRadius = 12.0
+        textView.textContainerInset = UIEdgeInsets(top: 14.0, left: 12.0, bottom: 14.0, right: 12.0)
+        textView.translatesAutoresizingMaskIntoConstraints = false
+        let font = UIFont.preferredFont(forTextStyle: .body)
+        let header = NSMutableAttributedString(string: (self.record.kind == .deleted ? (self.russian ? "Удалённое сообщение\n\n" : "Deleted message\n\n") : (self.russian ? "Правка: красным — было, зелёным — стало\n\n" : "Edit: red is before, green is after\n\n")), attributes: [.font: UIFont.preferredFont(forTextStyle: .footnote), .foregroundColor: UIColor.secondaryLabel])
+        if self.record.kind == .edited, let currentText = self.currentText {
+            header.append(AyuTextDiff.attributed(AyuTextDiff.diff(self.record.text, currentText), font: font))
+        } else {
+            header.append(NSAttributedString(string: self.record.text, attributes: [.font: font, .foregroundColor: UIColor.label]))
+        }
+        textView.attributedText = header
+        self.view.addSubview(textView)
+        NSLayoutConstraint.activate([
+            textView.topAnchor.constraint(equalTo: self.view.safeAreaLayoutGuide.topAnchor, constant: 16.0),
+            textView.leadingAnchor.constraint(equalTo: self.view.leadingAnchor, constant: 16.0),
+            textView.trailingAnchor.constraint(equalTo: self.view.trailingAnchor, constant: -16.0),
+            textView.bottomAnchor.constraint(equalTo: self.view.safeAreaLayoutGuide.bottomAnchor, constant: -16.0)
+        ])
+        self.navigationItem.rightBarButtonItem = UIBarButtonItem(image: UIImage(systemName: "doc.on.doc"), style: .plain, target: self, action: #selector(self.copyText))
+    }
+
+    @objc private func copyText() {
+        UIPasteboard.general.string = self.record.text
+    }
+}
