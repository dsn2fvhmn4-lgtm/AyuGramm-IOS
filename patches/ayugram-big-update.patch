diff --git a/submodules/TelegramCore/Sources/AyuGram/AyuBotAuthorization.swift b/submodules/TelegramCore/Sources/AyuGram/AyuBotAuthorization.swift
new file mode 100644
index 00000000..3c5a53bf
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuGram/AyuBotAuthorization.swift
@@ -0,0 +1,67 @@
+import Foundation
+import Postbox
+import SwiftSignalKit
+internal import TelegramApi
+import MtProtoKit
+
+public enum AyuBotAuthorizationError: Equatable {
+    case invalidToken
+    case flood
+    case generic(String)
+}
+
+/// Signs this unauthorized account in as a bot with a BotFather token (`auth.importBotAuthorization`),
+/// following the bot's datacenter if the server redirects, then switches to the authorized
+/// account exactly as a phone or QR sign-in does.
+public func ayuAuthorizeWithBotToken(accountManager: AccountManager<TelegramAccountManagerTypes>, account: UnauthorizedAccount, apiId: Int32, apiHash: String, token: String) -> Signal<Void, AyuBotAuthorizationError> {
+    let trimmed = token.trimmingCharacters(in: .whitespacesAndNewlines)
+    // "123456789:AA…" — numeric bot id, colon, secret.
+    guard let colon = trimmed.firstIndex(of: ":"), Int64(trimmed[trimmed.startIndex ..< colon]) != nil, trimmed.count >= 30, trimmed.count <= 120 else {
+        return .fail(.invalidToken)
+    }
+    let request = Api.functions.auth.importBotAuthorization(flags: 0, apiId: apiId, apiHash: apiHash, botAuthToken: trimmed)
+
+    func attempt(_ account: UnauthorizedAccount, followRedirect: Bool) -> Signal<(Api.auth.Authorization, UnauthorizedAccount), AyuBotAuthorizationError> {
+        return account.network.request(request, automaticFloodWait: false)
+        |> map { result -> (Api.auth.Authorization, UnauthorizedAccount) in
+            return (result, account)
+        }
+        |> `catch` { error -> Signal<(Api.auth.Authorization, UnauthorizedAccount), AyuBotAuthorizationError> in
+            let description = error.errorDescription ?? ""
+            if followRedirect, let range = description.range(of: "_MIGRATE_"), let datacenter = Int32(description[range.upperBound...]) {
+                return account.changedMasterDatacenterId(accountManager: accountManager, masterDatacenterId: datacenter)
+                |> castError(AyuBotAuthorizationError.self)
+                |> mapToSignal { updated -> Signal<(Api.auth.Authorization, UnauthorizedAccount), AyuBotAuthorizationError> in
+                    return attempt(updated, followRedirect: false)
+                }
+            }
+            if description.hasPrefix("ACCESS_TOKEN_") || description.hasPrefix("BOT_") || description == "AUTH_KEY_INVALID" {
+                return .fail(.invalidToken)
+            }
+            if description.hasPrefix("FLOOD_WAIT") {
+                return .fail(.flood)
+            }
+            return .fail(.generic(description))
+        }
+    }
+
+    return attempt(account, followRedirect: true)
+    |> mapToSignal { authorization, account -> Signal<Void, AyuBotAuthorizationError> in
+        switch authorization {
+        case let .authorization(authorizationData):
+            return account.postbox.transaction { transaction -> Signal<Void, NoError> in
+                let user = TelegramUser(user: authorizationData.user)
+                let state = AuthorizedAccountState(isTestingEnvironment: account.testingEnvironment, masterDatacenterId: account.masterDatacenterId, peerId: user.id, state: nil, invalidatedChannels: [])
+                initializedAppSettingsAfterLogin(transaction: transaction, appVersion: account.networkArguments.appVersion, syncContacts: false)
+                transaction.setState(state)
+                return accountManager.transaction { transaction -> Void in
+                    switchToAuthorizedAccount(transaction: transaction, account: account, isSupportUser: false)
+                }
+            }
+            |> switchToLatest
+            |> castError(AyuBotAuthorizationError.self)
+        case .authorizationSignUpRequired:
+            return .fail(.generic("SIGN_UP_REQUIRED"))
+        }
+    }
+}
diff --git a/submodules/TelegramCore/Sources/AyuGram/AyuDeveloperSettings.swift b/submodules/TelegramCore/Sources/AyuGram/AyuDeveloperSettings.swift
new file mode 100644
index 00000000..c42d0d1e
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuGram/AyuDeveloperSettings.swift
@@ -0,0 +1,158 @@
+import Foundation
+import SwiftSignalKit
+
+/// App-wide developer switches. Every option defaults to off and nothing here changes
+/// networking or account state; they only expose diagnostics or alter local presentation.
+public struct AyuDeveloperSettingsValue: Codable, Equatable {
+    /// Translucent playback diagnostics in the bottom-right corner of the music player.
+    public var playerDebugOverlay = false
+    /// Frame-rate counter pinned above all app content.
+    public var fpsCounter = false
+    /// Multiplies every Core Animation duration by four, for checking transitions.
+    public var slowAnimations = false
+    /// Opens Telegram's stock audio player instead of the AyuGram music player.
+    public var forceStockMusicPlayer = false
+    /// Shows which lyrics source matched and its score under the lyrics.
+    public var lyricsDiagnostics = false
+    /// Records AyuGram subsystem events (plugins, lyrics, recognition) to a rotating log file.
+    public var verboseLogging = false
+    /// Mirrors plugin runtime output into the log and a console screen.
+    public var pluginConsole = false
+    /// Relaxes code-plugin limits for debugging: longer hook timeout, errors shown as toasts.
+    public var experimentalPluginHooks = false
+    /// Adds raw peer/message identifiers to context menus.
+    public var showInternalIds = false
+    /// Draws coloured borders around AyuGram-owned views.
+    public var highlightAyuViews = false
+
+    public init() {}
+
+    private enum CodingKeys: String, CodingKey {
+        case playerDebugOverlay, fpsCounter, slowAnimations, forceStockMusicPlayer, lyricsDiagnostics
+        case verboseLogging, pluginConsole, experimentalPluginHooks, showInternalIds, highlightAyuViews
+    }
+
+    public init(from decoder: Decoder) throws {
+        let values = try decoder.container(keyedBy: CodingKeys.self)
+        func flag(_ key: CodingKeys) -> Bool { return (try? values.decodeIfPresent(Bool.self, forKey: key)) ?? false }
+        self.playerDebugOverlay = flag(.playerDebugOverlay)
+        self.fpsCounter = flag(.fpsCounter)
+        self.slowAnimations = flag(.slowAnimations)
+        self.forceStockMusicPlayer = flag(.forceStockMusicPlayer)
+        self.lyricsDiagnostics = flag(.lyricsDiagnostics)
+        self.verboseLogging = flag(.verboseLogging)
+        self.pluginConsole = flag(.pluginConsole)
+        self.experimentalPluginHooks = flag(.experimentalPluginHooks)
+        self.showInternalIds = flag(.showInternalIds)
+        self.highlightAyuViews = flag(.highlightAyuViews)
+    }
+
+    public var anyEnabled: Bool {
+        return self != AyuDeveloperSettingsValue()
+    }
+}
+
+public final class AyuDeveloperSettings {
+    public static let shared = AyuDeveloperSettings()
+    public static let didChangeNotification = Notification.Name("AyuGram.DeveloperSettingsChanged")
+
+    private static let defaultsKey = "ayu.developer.settings.v1"
+    private let lock = NSLock()
+    private var value: AyuDeveloperSettingsValue
+
+    private init() {
+        if let data = UserDefaults.standard.data(forKey: AyuDeveloperSettings.defaultsKey),
+           let decoded = try? JSONDecoder().decode(AyuDeveloperSettingsValue.self, from: data) {
+            self.value = decoded
+        } else {
+            self.value = AyuDeveloperSettingsValue()
+        }
+    }
+
+    public var current: AyuDeveloperSettingsValue {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return self.value
+    }
+
+    public func update(_ transform: (inout AyuDeveloperSettingsValue) -> Void) {
+        self.lock.lock()
+        var updated = self.value
+        transform(&updated)
+        let changed = updated != self.value
+        if changed {
+            self.value = updated
+            if let data = try? JSONEncoder().encode(updated) {
+                UserDefaults.standard.set(data, forKey: AyuDeveloperSettings.defaultsKey)
+            }
+        }
+        self.lock.unlock()
+        if changed {
+            let post = { NotificationCenter.default.post(name: AyuDeveloperSettings.didChangeNotification, object: nil) }
+            if Thread.isMainThread { post() } else { DispatchQueue.main.async(execute: post) }
+        }
+    }
+
+    public func resetAll() {
+        self.update { $0 = AyuDeveloperSettingsValue() }
+    }
+
+    /// Current value followed by every committed change, delivered on the main queue.
+    public var signal: Signal<AyuDeveloperSettingsValue, NoError> {
+        return Signal { subscriber in
+            subscriber.putNext(self.current)
+            let observer = NotificationCenter.default.addObserver(forName: AyuDeveloperSettings.didChangeNotification, object: nil, queue: .main, using: { _ in
+                subscriber.putNext(self.current)
+            })
+            return ActionDisposable {
+                NotificationCenter.default.removeObserver(observer)
+            }
+        }
+    }
+
+    public var playerDebugOverlay: Bool { return self.current.playerDebugOverlay }
+    public var verboseLogging: Bool { return self.current.verboseLogging }
+}
+
+/// Small rotating text log for AyuGram subsystems; writes only while verbose logging is on.
+public final class AyuDevLog {
+    public static let shared = AyuDevLog()
+    private let queue = DispatchQueue(label: "AyuGram.DevLog")
+    private let maxBytes = 512 * 1024
+
+    public var fileURL: URL? {
+        return FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first?
+            .appendingPathComponent("AyuGram", isDirectory: true)
+            .appendingPathComponent("ayu-dev.log")
+    }
+
+    public func log(_ subsystem: String, _ message: @autoclosure () -> String) {
+        guard AyuDeveloperSettings.shared.verboseLogging, let url = self.fileURL else { return }
+        let line = "\(ISO8601DateFormatter().string(from: Date())) [\(subsystem)] \(message())\n"
+        self.queue.async {
+            let manager = FileManager.default
+            try? manager.createDirectory(at: url.deletingLastPathComponent(), withIntermediateDirectories: true)
+            if let size = (try? manager.attributesOfItem(atPath: url.path))?[.size] as? Int, size > self.maxBytes {
+                let previous = url.appendingPathExtension("1")
+                try? manager.removeItem(at: previous)
+                try? manager.moveItem(at: url, to: previous)
+            }
+            guard let data = line.data(using: .utf8) else { return }
+            if let handle = try? FileHandle(forWritingTo: url) {
+                handle.seekToEndOfFile()
+                handle.write(data)
+                handle.closeFile()
+            } else {
+                try? data.write(to: url, options: .atomic)
+            }
+        }
+    }
+
+    public func clear() {
+        guard let url = self.fileURL else { return }
+        self.queue.async {
+            try? FileManager.default.removeItem(at: url)
+            try? FileManager.default.removeItem(at: url.appendingPathExtension("1"))
+        }
+    }
+}
