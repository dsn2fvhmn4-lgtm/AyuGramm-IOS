+import Foundation
+import CryptoKit
+import Display
+
+/// The online catalog of code plugins (by default github.com/murk-sus/AyuGramm-Plugins).
+/// Downloads are integrity-checked against the SHA-256 published in the index and must declare
+/// the same @id; installation still goes through the runtime's usual confirmation path.
+public final class AyuScriptCatalog {
+    public struct Entry: Codable, Equatable {
+        public let id: String
+        public let name: String
+        public let author: String
+        public let version: String
+        public let description: String
+        public let tags: [String]?
+        public let url: String
+        public let sha256: String
+        public let size: Int?
+        /// "js", "python" or "wasm" for code plugins, "iosplug" for native plugin cards.
+        public let kind: String?
+        /// Base64 Ed25519 signature of the file by AyuGram; present only for official plugins.
+        public let signature: String?
+        /// The plugin injects into the app (player, lyrics…).
+        public let injects: Bool?
+        /// What changed in this version (shown before an update).
+        public let changelog: String?
+        /// Catalog section, e.g. "privacy", "messages", "media", "fun".
+        public let category: String?
+        /// HTTPS links to screenshots.
+        public let screenshots: [String]?
+
+        public var isNativeCard: Bool {
+            return self.kind == "iosplug"
+        }
+
+        public var fileExtension: String {
+            switch self.kind {
+            case "iosplug": return "iosplug"
+            case "python": return "ayu.py"
+            case "lua": return "ayu.lua"
+            case "wasm": return "wasm"
+            default: return "ayu.js"
+            }
+        }
+
+        public var languageLabel: String {
+            switch self.kind {
+            case "iosplug": return "iOS"
+            case "python": return "Python"
+            case "lua": return "Lua"
+            case "wasm": return "Rust"
+            default: return "JS"
+            }
+        }
+    }
+
+    public enum Failure: LocalizedError {
+        case network
+        case invalidCatalog
+        case tooLarge
+        case checksumMismatch
+        case identityMismatch
+        case injectRefused
+        case injectNeedsConsent
+
+        public var errorDescription: String? {
+            let ru = Locale.preferredLanguages.first?.hasPrefix("ru") == true
+            switch self {
+            case .network: return ru ? "Каталог недоступен. Проверьте подключение." : "The catalog is unreachable. Check the connection."
+            case .invalidCatalog: return ru ? "Каталог повреждён или имеет неизвестный формат." : "The catalog is damaged or in an unknown format."
+            case .tooLarge: return ru ? "Плагин больше 512 КБ." : "The plugin is larger than 512 KB."
+            case .checksumMismatch: return ru ? "Файл не совпадает с каталогом (SHA-256). Установка отменена." : "The file does not match the catalog (SHA-256). Installation cancelled."
+            case .identityMismatch: return ru ? "@id файла не совпадает с каталогом." : "The file's @id does not match the catalog."
+            case .injectRefused: return AyuPluginTrust.refusalText(ru)
+            case .injectNeedsConsent: return AyuPluginTrust.disclaimerText(ru)
+            }
+        }
+    }
+
+    public static let shared = AyuScriptCatalog()
+    public static let defaultURL = "https://raw.githubusercontent.com/murk-sus/AyuGramm-Plugins/main/index.json"
+    private static let urlKey = "ayu.plugins.catalogURL"
+
+    /// The catalog address; a custom one lets anyone host their own collection.
+    public var catalogURL: String {
+        get { return UserDefaults.standard.string(forKey: AyuScriptCatalog.urlKey) ?? AyuScriptCatalog.defaultURL }
+        set {
+            let trimmed = newValue.trimmingCharacters(in: .whitespacesAndNewlines)
+            if trimmed.isEmpty || trimmed == AyuScriptCatalog.defaultURL {
+                UserDefaults.standard.removeObject(forKey: AyuScriptCatalog.urlKey)
+            } else {
+                UserDefaults.standard.set(trimmed, forKey: AyuScriptCatalog.urlKey)
+            }
+        }
+    }
+
+    private let session: URLSession = {
+        let configuration = URLSessionConfiguration.ephemeral
+        configuration.timeoutIntervalForRequest = 15.0
+        configuration.requestCachePolicy = .reloadIgnoringLocalCacheData
+        return URLSession(configuration: configuration)
+    }()
+
+    private init() {}
+
+    private func fetch(_ url: URL, limit: Int, completion: @escaping (Result<Data, Failure>) -> Void) {
+        guard url.scheme?.lowercased() == "https" else {
+            DispatchQueue.main.async { completion(.failure(.network)) }
+            return
+        }
+        self.session.dataTask(with: url, completionHandler: { data, response, _ in
+            let result: Result<Data, Failure>
+            if let http = response as? HTTPURLResponse, http.statusCode == 200, let data {
+                result = data.count <= limit ? .success(data) : .failure(.tooLarge)
+            } else {
+                result = .failure(.network)
+            }
+            DispatchQueue.main.async { completion(result) }
+        }).resume()
+    }
+
+    public func load(completion: @escaping (Result<[Entry], Failure>) -> Void) {
+        guard let url = URL(string: self.catalogURL) else {
+            completion(.failure(.invalidCatalog))
+            return
+        }
+        self.fetch(url, limit: 2 * 1024 * 1024, completion: { result in
+            switch result {
+            case let .success(data):
+                struct Index: Codable { let format: String; let plugins: [Entry] }
+                guard let index = try? JSONDecoder().decode(Index.self, from: data), index.format == "ayugram-plugin-catalog" else {
+                    completion(.failure(.invalidCatalog))
+                    return
+                }
+                let valid = index.plugins.filter { entry in
+                    entry.sha256.count == 64 && URL(string: entry.url)?.scheme?.lowercased() == "https" && !entry.id.isEmpty
+                }
+                completion(.success(valid.sorted(by: { $0.name.localizedCaseInsensitiveCompare($1.name) == .orderedAscending })))
+            case let .failure(error):
+                completion(.failure(error))
+            }
+        })
+    }
+
+    /// Downloads a catalog file and checks it against the index's SHA-256.
+    public func download(_ entry: Entry, completion: @escaping (Result<Data, Failure>) -> Void) {
+        guard let url = URL(string: entry.url) else {
+            completion(.failure(.invalidCatalog))
+            return
+        }
+        self.fetch(url, limit: entry.isNativeCard ? 64 * 1024 : 2 * 1024 * 1024, completion: { result in
+            switch result {
+            case let .success(data):
+                let digest = SHA256.hash(data: data).map { String(format: "%02x", $0) }.joined()
+                completion(digest == entry.sha256.lowercased() ? .success(data) : .failure(.checksumMismatch))
+            case let .failure(error):
+                completion(.failure(error))
+            }
+        })
+    }
+
+    /// Downloads, verifies and installs (or updates) a catalog code plugin. A valid AyuGram
+    /// signature makes it official; an unsigned injecting plugin follows the safe-zone rules
+    /// (`acceptedRisk` after the disclaimer).
+    public func install(_ entry: Entry, acceptedRisk: Bool = false, completion: @escaping (Result<Void, Error>) -> Void) {
+        self.download(entry, completion: { result in
+            switch result {
+            case let .success(data):
+                guard AyuScriptRuntime.shared.preview(data, filename: entry.id + "." + entry.fileExtension)?.id == entry.id else {
+                    completion(.failure(Failure.identityMismatch))
+                    return
+                }
+                // Keep the installed version so the update can be rolled back.
+                AyuScriptCatalog.keepForRollback(id: entry.id)
+                let official = AyuPluginTrust.isOfficial(data: data, signature: entry.signature)
+                do {
+                    try AyuScriptRuntime.shared.install(data, filename: entry.id + "." + entry.fileExtension, official: official, acceptedRisk: acceptedRisk)
+                    completion(.success(()))
+                } catch AyuScriptRuntime.InstallError.injectRefused {
+                    completion(.failure(Failure.injectRefused))
+                } catch AyuScriptRuntime.InstallError.injectNeedsConsent {
+                    completion(.failure(Failure.injectNeedsConsent))
+                } catch {
+                    completion(.failure(error))
+                }
+            case let .failure(error):
+                completion(.failure(error))
+            }
+        })
+    }
+
+    // MARK: Rollback and automatic updates
+
+    private static let rollbackKey = "ayu.plugins.rollback"
+
+    private static var rollbackDirectory: URL? {
+        return FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first?.appendingPathComponent("AyuGram/PluginRollback", isDirectory: true)
+    }
+
+    /// Installed plugins update themselves from the catalog when the app starts.
+    public static var autoUpdate: Bool {
+        return AyuExtras.isOn(.pluginAutoUpdate) && !AyuDecoyMode.isActive
+    }
+
+    static func keepForRollback(id: String) {
+        guard let installed = AyuScriptRuntime.shared.plugin(id: id), let file = AyuScriptRuntime.shared.sourceFile(id: id), let directory = rollbackDirectory else { return }
+        try? FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        let url = directory.appendingPathComponent(file.filename)
+        guard (try? file.data.write(to: url, options: .atomic)) != nil else { return }
+        var versions = (UserDefaults.standard.dictionary(forKey: rollbackKey) as? [String: [String]]) ?? [:]
+        versions[id] = [installed.version, file.filename]
+        UserDefaults.standard.set(versions, forKey: rollbackKey)
+    }
+
+    /// The version an update would roll back to, if one was kept.
+    public static func rollbackVersion(id: String) -> String? {
+        let versions = (UserDefaults.standard.dictionary(forKey: rollbackKey) as? [String: [String]]) ?? [:]
+        return versions[id]?.first
+    }
+
+    /// Puts the previous version back, with the same trust it had (signature re-checked by install).
+    public static func rollback(id: String) throws {
+        var versions = (UserDefaults.standard.dictionary(forKey: rollbackKey) as? [String: [String]]) ?? [:]
+        guard let pair = versions[id], pair.count == 2, let directory = rollbackDirectory else { throw Failure.invalidCatalog }
+        let url = directory.appendingPathComponent(pair[1])
+        let data = try Data(contentsOf: url)
+        // The kept copy has no catalog signature, so it is installed as a community plugin.
+        try AyuScriptRuntime.shared.install(data, filename: pair[1], official: false, acceptedRisk: false)
+        versions[id] = nil
+        UserDefaults.standard.set(versions, forKey: rollbackKey)
+        try? FileManager.default.removeItem(at: url)
+    }
+
+    /// Updates installed plugins that have a newer catalog version. Plugins that would need the
+    /// injection consent again are left for the user. Calls back with the updated names.
+    public func updateInstalled(completion: @escaping ([String]) -> Void) {
+        self.load(completion: { result in
+            guard case let .success(entries) = result else {
+                completion([])
+                return
+            }
+            let pending = entries.filter { entry in
+                guard !entry.isNativeCard, entry.injects != true, let installed = AyuScriptRuntime.shared.plugin(id: entry.id) else { return false }
+                return AyuScriptCatalog.isNewer(entry.version, than: installed.version)
+            }
+            var updated: [String] = []
+            func next(_ index: Int) {
+                guard index < pending.count else {
+                    completion(updated)
+                    return
+                }
+                let entry = pending[index]
+                self.install(entry, completion: { result in
+                    if case .success = result {
+                        updated.append(entry.name + " " + entry.version)
+                    }
+                    next(index + 1)
+                })
+            }
+            next(0)
+        })
+    }
+
+    /// True when `available` is a newer dotted version than `installed` ("1.10" > "1.9").
+    public static func isNewer(_ available: String, than installed: String) -> Bool {
+        let lhs = available.split(separator: ".").map { Int($0.filter(\.isNumber)) ?? 0 }
+        let rhs = installed.split(separator: ".").map { Int($0.filter(\.isNumber)) ?? 0 }
+        for index in 0 ..< max(lhs.count, rhs.count) {
+            let a = index < lhs.count ? lhs[index] : 0
+            let b = index < rhs.count ? rhs[index] : 0
+            if a != b { return a > b }
+        }
+        return false
+    }
+}
