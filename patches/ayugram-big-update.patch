new file mode 100644
index 00000000..62b1c72a
--- /dev/null
+++ b/submodules/SettingsUI/Sources/AyuPluginConsoleController.swift
@@ -0,0 +1,88 @@
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import PresentationDataUtils
+import ItemListUI
+import AccountContext
+
+// Developer → Plugin console: the newest plugin output first, copied on tap.
+
+private enum AyuPluginConsoleEntry: ItemListNodeEntry {
+    case clear(String)
+    case empty(String)
+    case line(Int64, String, String)
+
+    var section: ItemListSectionId {
+        switch self {
+        case .clear: return 0
+        case .empty, .line: return 1
+        }
+    }
+
+    var stableId: Int64 {
+        switch self {
+        case .clear: return Int64.min
+        case .empty: return Int64.min + 1
+        case let .line(id, _, _): return -id
+        }
+    }
+
+    static func < (lhs: AyuPluginConsoleEntry, rhs: AyuPluginConsoleEntry) -> Bool { return lhs.stableId < rhs.stableId }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! AyuPluginConsoleArguments
+        switch self {
+        case let .clear(title):
+            return ItemListActionItem(presentationData: presentationData, systemStyle: .glass, title: title, kind: .destructive, alignment: .natural, sectionId: self.section, style: .blocks, action: { arguments.clear() })
+        case let .empty(text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        case let .line(_, title, text):
+            return ItemListDisclosureItem(presentationData: presentationData, systemStyle: .glass, title: text, label: title, sectionId: self.section, style: .blocks, action: { arguments.copy(text) })
+        }
+    }
+}
+
+private struct AyuPluginConsoleArguments {
+    let clear: () -> Void
+    let copy: (String) -> Void
+}
+
+func ayuPluginConsoleController(context: AccountContext) -> ViewController {
+    var presentController: ((ViewController) -> Void)?
+    let arguments = AyuPluginConsoleArguments(clear: {
+        AyuPluginConsole.shared.clear()
+    }, copy: { text in
+        UIPasteboard.general.string = text
+        let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+        presentController?(textAlertController(context: context, title: nil, text: presentationData.strings.baseLanguageCode.hasPrefix("ru") ? "Скопировано" : "Copied", actions: [TextAlertAction(type: .defaultAction, title: presentationData.strings.Common_OK, action: {})]))
+    })
+    let formatter = DateFormatter()
+    formatter.dateFormat = "HH:mm:ss"
+    let signal = combineLatest(context.sharedContext.presentationData, AyuPluginConsole.shared.signal)
+    |> deliverOnMainQueue
+    |> map { presentationData, lines -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        var entries: [AyuPluginConsoleEntry] = [.clear(ru ? "Очистить" : "Clear")]
+        if lines.isEmpty {
+            entries.append(.empty(ru ? "Вывода пока нет. Включённые плагины пишут сюда print(), ошибки и срабатывания хуков." : "No output yet. Enabled plugins write print(), errors and hook activity here."))
+        }
+        for line in lines.suffix(300) {
+            let marker: String
+            switch line.level {
+            case .info: marker = ""
+            case .warning: marker = "⚠️ "
+            case .error: marker = "⛔️ "
+            }
+            entries.append(.line(line.id, "\(formatter.string(from: line.date)) \(line.pluginId)", marker + line.text))
+        }
+        let data = ItemListPresentationData(presentationData)
+        let state = ItemListControllerState(presentationData: data, title: .text(ru ? "Консоль плагинов" : "Plugin console"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        return (state, (ItemListNodeState(presentationData: data, entries: entries, style: .blocks, animateChanges: false), arguments))
+    }
+    let controller = ItemListController(context: context, state: signal)
+    presentController = { [weak controller] in controller?.present($0, in: .window(.root)) }
+    return controller
+}
