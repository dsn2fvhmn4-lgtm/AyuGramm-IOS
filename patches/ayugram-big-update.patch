@@ -0,0 +1,69 @@
+import Foundation
+
+/// AyuGram Privacy & extras "Clean links": tracking parameters are removed from links in
+/// messages you send. The switch lives in Display (`AyuExtras`), read here by its key.
+public enum AyuLinkCleaner {
+    public static var isEnabled: Bool {
+        return UserDefaults.standard.bool(forKey: "ayu.extra.cleanLinks")
+    }
+
+    private static let exactNames: Set<String> = [
+        "fbclid", "gclid", "gclsrc", "dclid", "msclkid", "yclid", "ysclid", "twclid", "ttclid",
+        "igsh", "igshid", "si", "mc_cid", "mc_eid", "_hsenc", "_hsmi", "mkt_tok", "vero_id",
+        "oly_anon_id", "oly_enc_id", "rb_clickid", "s_cid", "wickedid", "ref_src", "ref_url",
+        "share_id", "sharer_id", "xmt", "_openstat", "srsltid"
+    ]
+    private static let prefixes = ["utm_", "pk_", "mtm_", "hsa_", "ga_"]
+
+    private static let linkPattern = try? NSRegularExpression(pattern: "https?://[^\\s<>\"«»]+", options: [.caseInsensitive])
+
+    /// Returns `text` with every tracking parameter dropped from its links.
+    public static func clean(_ text: String) -> String {
+        guard text.contains("?"), let pattern = AyuLinkCleaner.linkPattern else {
+            return text
+        }
+        let nsText = text as NSString
+        var result = text
+        let matches = pattern.matches(in: text, options: [], range: NSRange(location: 0, length: nsText.length))
+        for match in matches.reversed() {
+            var link = nsText.substring(with: match.range)
+            // Trailing punctuation belongs to the sentence, not the link.
+            var trailing = ""
+            while let last = link.last, ".,!?;:)]".contains(last) {
+                trailing.insert(last, at: trailing.startIndex)
+                link.removeLast()
+            }
+            let cleaned = AyuLinkCleaner.cleanLink(link)
+            guard cleaned != link, let range = Range(match.range, in: result) else {
+                continue
+            }
+            result.replaceSubrange(range, with: cleaned + trailing)
+        }
+        return result
+    }
+
+    static func cleanLink(_ link: String) -> String {
+        guard let questionMark = link.firstIndex(of: "?") else {
+            return link
+        }
+        let base = String(link[..<questionMark])
+        var rest = String(link[link.index(after: questionMark)...])
+        var fragment = ""
+        if let hash = rest.firstIndex(of: "#") {
+            fragment = String(rest[hash...])
+            rest = String(rest[..<hash])
+        }
+        let parameters = rest.split(separator: "&", omittingEmptySubsequences: true)
+        let kept = parameters.filter { parameter in
+            let name = parameter.split(separator: "=", maxSplits: 1).first.map { String($0).lowercased() } ?? ""
+            if AyuLinkCleaner.exactNames.contains(name) {
+                return false
+            }
+            return !AyuLinkCleaner.prefixes.contains(where: { name.hasPrefix($0) })
+        }
+        guard kept.count != parameters.count else {
+            return link
+        }
+        return base + (kept.isEmpty ? "" : "?" + kept.joined(separator: "&")) + fragment
+    }
+}
