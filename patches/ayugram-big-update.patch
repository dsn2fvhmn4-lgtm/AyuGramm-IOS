+    do {                                                                                           \
+        if(!self->data) break;                                                                     \
+        T* p = (T*)(self)->data;                                                                   \
+        T* q = (T*)(self)->data + (self)->length - 1;                                              \
+        while(p < q) {                                                                             \
+            T tmp = *p;                                                                            \
+            *p = *q;                                                                               \
+            *q = tmp;                                                                              \
+            p++;                                                                                   \
+            q--;                                                                                   \
+        }                                                                                          \
+    } while(0)
