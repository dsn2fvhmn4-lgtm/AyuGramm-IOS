+import Foundation
+import UIKit
+import TelegramCore
+import SwiftSignalKit
+import AccountContext
+
+/// What injecting plugins see of the music player (`ayu.player.state()`), kept by the player.
+final class AyuPluginPlayerSnapshot {
+    static let shared = AyuPluginPlayerSnapshot()
+
+    private let lock = NSLock()
+    private var title = ""
+    private var artist: String?
+    private var duration = 0.0
+    private var position = 0.0
+    private var playing = false
+
+    var state: [String: Any] {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return ["title": self.title, "artist": self.artist.map { $0 as Any } ?? NSNull(), "duration": self.duration, "position": self.position, "playing": self.playing]
+    }
+
+    /// A new track: plugins subscribed to `trackChange` hear about it.
+    func trackChanged(title: String, artist: String?, duration: Double) {
+        self.lock.lock()
+        self.title = title
+        self.artist = artist
+        self.duration = duration
+        self.position = 0.0
+        self.lock.unlock()
+        AyuScriptRuntime.shared.emit("trackChange", ["title": title, "artist": artist.map { $0 as Any } ?? NSNull(), "duration": duration])
+        DispatchQueue.main.async {
+            AyuNowPlaying.trackChanged(title: title, artist: artist)
+            AyuLastFM.trackChanged(title: title, artist: artist, duration: duration)
+            AyuNowPlayingActivity.update(title: title, artist: artist, playing: true)
+        }
+    }
+
+    func progress(position: Double, duration: Double, playing: Bool) {
+        self.lock.lock()
+        let changedPlaying = self.playing != playing
+        let title = self.title
+        let artist = self.artist
+        self.position = position.isFinite ? position : 0.0
+        self.duration = duration
+        self.playing = playing
+        self.lock.unlock()
+        if changedPlaying, !title.isEmpty {
+            DispatchQueue.main.async {
+                AyuNowPlayingActivity.update(title: title, artist: artist, playing: playing)
+            }
+        }
+        if AyuLastFM.isConnected, position.isFinite {
+            DispatchQueue.main.async {
+                AyuLastFM.progress(position: position, playing: playing)
+            }
+        }
+    }
+}
+
+/// Connects the plugin runtime to the music player of `sharedContext`.
+func ayuInstallPluginAppBridge(sharedContext: SharedAccountContext) {
+    ayuInstallPluginAppServices(sharedContext: sharedContext)
+    // `ayu.ui.gifts.catalog.list`: the regular gifts of the active account's catalog.
+    AyuPluginUI.shared.loadGiftsCatalog = { [weak sharedContext] completion in
+        guard let sharedContext else { return completion([]) }
+        let _ = (sharedContext.activeAccountContexts
+        |> take(1)
+        |> mapToSignal { primary, _, _ -> Signal<[StarGift]?, NoError> in
+            guard let primary else { return .single(nil) }
+            return primary.engine.payments.cachedStarGifts() |> take(1)
+        }
+        |> deliverOnMainQueue).startStandalone(next: { gifts in
+            var result: [[String: Any]] = []
+            for gift in gifts ?? [] {
+                guard case let .generic(value) = gift else { continue }
+                var item: [String: Any] = [
+                    "giftId": String(value.id),
+                    "title": value.title ?? "",
+                    "stars": value.price,
+                    "fileId": String(value.file.fileId.id),
+                    "limited": value.availability != nil,
+                    "soldOut": value.soldOut != nil
+                ]
+                if let availability = value.availability {
+                    item["remains"] = availability.remains
+                    item["total"] = availability.total
+                }
+                result.append(item)
+            }
+            completion(result)
+        })
+    }
+    // `ayu.ui.alert` / `ayu.ui.sheet`: the app draws them; a plugin only gets the chosen id.
+    AyuPluginUI.shared.presentAlert = { [weak sharedContext] title, message, buttons, completion in
+        guard let sharedContext else { return completion(nil) }
+        let alert = UIAlertController(title: title, message: message, preferredStyle: .alert)
+        for button in buttons {
+            alert.addAction(UIAlertAction(title: button.title, style: button.destructive ? .destructive : .default, handler: { _ in completion(button.id) }))
+        }
+        sharedContext.applicationBindings.presentNativeController(alert)
+    }
+    AyuPluginUI.shared.presentSheet = { [weak sharedContext] title, message, items, completion in
+        guard let sharedContext else { return completion(nil) }
+        let russian = sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru")
+        let sheet = UIAlertController(title: title, message: message, preferredStyle: .actionSheet)
+        for item in items {
+            sheet.addAction(UIAlertAction(title: item.title, style: .default, handler: { _ in completion(item.id) }))
+        }
+        sheet.addAction(UIAlertAction(title: russian ? "Отмена" : "Cancel", style: .cancel, handler: { _ in completion(nil) }))
+        sharedContext.applicationBindings.presentNativeController(sheet)
+    }
+    AyuPluginAppBridge.playerState = {
+        return AyuPluginPlayerSnapshot.shared.state
+    }
+    AyuPluginAppBridge.playerControl = { [weak sharedContext] action in
+        let control: SharedMediaPlayerControlAction
+        switch action {
+        case "play": control = .playback(.play)
+        case "pause": control = .playback(.pause)
+        case "toggle": control = .playback(.togglePlayPause)
+        case "next": control = .next
+        case "previous": control = .previous
+        default: return false
+        }
+        guard let sharedContext else { return false }
+        // Plugins call from their own threads; the player is driven from the main thread.
+        DispatchQueue.main.async {
+            sharedContext.mediaManager.playlistControl(control, type: .music)
+        }
+        return true
+    }
+}
+
+/// Runs `lyrics.text` plugin hooks over found lyrics. Line timings stay: a plugin gets the
+/// lines joined by "\n" and must return the same number of lines (an empty line drops it).
+func ayuApplyLyricsPlugins(_ lyrics: AyuLyrics) -> AyuLyrics {
+    guard AyuHooks.shared.hasHandlers(.lyricsText) else {
+        return lyrics
+    }
+    let context = AyuHooks.TextContext(peerId: 0, isSecret: false)
+    switch lyrics {
+    case let .synced(lines):
+        let text = lines.map { $0.text }.joined(separator: "\n")
+        let result = AyuHooks.shared.run(.lyricsText, text: text, context: context, native: { $0 })
+        guard result != text else { return lyrics }
+        let replaced = result.components(separatedBy: "\n")
+        guard replaced.count == lines.count else {
+            AyuPluginConsole.shared.append(pluginId: "lyrics.text", level: .warning, "A plugin changed the number of lyric lines; its result was ignored.")
+            return lyrics
+        }
+        var output: [AyuLyricsLine] = []
+        for (line, newText) in zip(lines, replaced) {
+            if newText == line.text {
+                output.append(line)
+                continue
+            }
+            let trimmed = newText.trimmingCharacters(in: .whitespaces)
+            if trimmed.isEmpty && !line.text.trimmingCharacters(in: .whitespaces).isEmpty {
+                continue
+            }
+            // New words share the line's time evenly.
+            let parts = trimmed.split(separator: " ").map(String.init)
+            let span = max(0.0, line.endTime - line.time)
+            let step = parts.isEmpty ? 0.0 : span / Double(parts.count)
+            let words = parts.enumerated().map { index, part in
+                AyuLyricsWord(time: line.time + step * Double(index), endTime: line.time + step * Double(index + 1), text: index == parts.count - 1 ? part : part + " ")
+            }
+            output.append(AyuLyricsLine(time: line.time, endTime: line.endTime, text: trimmed, words: words, exactWordTiming: false))
+        }
+        return output.isEmpty ? lyrics : .synced(output)
+    case let .plain(text):
+        let result = AyuHooks.shared.run(.lyricsText, text: text, context: context, native: { $0 })
+        return result.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty ? lyrics : .plain(result)
+    default:
+        return lyrics
+    }
+}
