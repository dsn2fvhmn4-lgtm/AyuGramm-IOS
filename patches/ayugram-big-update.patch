@@ -0,0 +1,54 @@
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import PresentationDataUtils
+import ItemListUI
+import AccountContext
+
+// Appearance+ → Settings rows: show or hide each row of the main Settings page.
+
+private func ayuSettingsVisibilitySignal() -> Signal<Set<String>, NoError> {
+    return Signal { subscriber in
+        subscriber.putNext(AyuSettingsVisibility.hiddenKeys)
+        let observer = NotificationCenter.default.addObserver(forName: AyuAppearancePlus.didChangeNotification, object: nil, queue: .main, using: { _ in
+            subscriber.putNext(AyuSettingsVisibility.hiddenKeys)
+        })
+        return ActionDisposable {
+            NotificationCenter.default.removeObserver(observer)
+        }
+    }
+}
+
+func ayuSettingsVisibilityController(context: AccountContext) -> ViewController {
+    let rows = AyuSettingsVisibility.rows
+    let arguments = AyuSectionedArguments(open: { id in
+        if id == 1000 {
+            AyuSettingsVisibility.hiddenKeys = []
+        }
+    }, toggle: { id, value in
+        let index = Int(id) - 1
+        guard rows.indices.contains(index) else { return }
+        var hidden = AyuSettingsVisibility.hiddenKeys
+        if value { hidden.remove(rows[index].key) } else { hidden.insert(rows[index].key) }
+        AyuSettingsVisibility.hiddenKeys = hidden
+    })
+
+    let signal = combineLatest(context.sharedContext.presentationData, ayuSettingsVisibilitySignal())
+    |> deliverOnMainQueue
+    |> map { presentationData, hidden -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        var entries: [AyuSectionedEntry] = [.header(1, 0, ru ? "ПОКАЗЫВАТЬ В НАСТРОЙКАХ" : "SHOW IN SETTINGS")]
+        for (index, row) in rows.enumerated() {
+            entries.append(.toggle(1, Int32(index + 1), nil, ru ? row.titleRu : row.titleEn, nil, !hidden.contains(row.key)))
+        }
+        entries.append(.info(1, 999, ru ? "Скрытый пункт пропадает со страницы «Настройки»; сами разделы остаются доступны через поиск и ссылки." : "A hidden row disappears from the Settings page; the screens themselves stay reachable through search and links."))
+        entries.append(.link(2, 1000, AyuSettingsIcons.symbol("arrow.counterclockwise", color: UIColor(rgb: 0xFF3B30)), ru ? "Показать все пункты" : "Show all rows", hidden.isEmpty ? "" : "\(hidden.count)"))
+        let data = ItemListPresentationData(presentationData)
+        let state = ItemListControllerState(presentationData: data, title: .text(ru ? "Пункты в Настройках" : "Settings rows"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        return (state, (ItemListNodeState(presentationData: data, entries: entries, style: .blocks, animateChanges: false), arguments))
+    }
+    return ItemListController(context: context, state: signal)
+}
diff --git a/submodules/SettingsUI/Sources/AyuWhiteGramController.swift b/submodules/SettingsUI/Sources/AyuWhiteGramController.swift
