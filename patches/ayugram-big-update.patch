+import Foundation
+import UIKit
+import LocalAuthentication
+import Display
+import SwiftSignalKit
+import TelegramCore
+import AccountContext
+
+/// Chats hidden from the chat list. Opens only after Face ID / Touch ID or the device passcode.
+final class AyuHiddenChatsController: UITableViewController {
+    private let context: AccountContext
+    private let open: (EnginePeer) -> Void
+    private let russian: Bool
+    private var peers: [EnginePeer] = []
+
+    init(context: AccountContext, open: @escaping (EnginePeer) -> Void) {
+        self.context = context
+        self.open = open
+        self.russian = context.sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru")
+        super.init(style: .insetGrouped)
+        self.title = self.russian ? "Скрытые чаты" : "Hidden chats"
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    /// Asks for authentication, then shows the list.
+    static func present(context: AccountContext, open: @escaping (EnginePeer) -> Void) {
+        let russian = context.sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru")
+        let show = {
+            let controller = AyuHiddenChatsController(context: context, open: open)
+            context.sharedContext.applicationBindings.presentNativeController(UINavigationController(rootViewController: controller))
+        }
+        let authentication = LAContext()
+        var error: NSError?
+        guard authentication.canEvaluatePolicy(.deviceOwnerAuthentication, error: &error) else {
+            return show()
+        }
+        authentication.evaluatePolicy(.deviceOwnerAuthentication, localizedReason: russian ? "Покажите скрытые чаты" : "Show hidden chats", reply: { success, _ in
+            if success {
+                DispatchQueue.main.async(execute: show)
+            }
+        })
+    }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        self.navigationItem.rightBarButtonItem = UIBarButtonItem(barButtonSystemItem: .done, target: self, action: #selector(self.close))
+        self.reload()
+    }
+
+    @objc private func close() {
+        self.dismiss(animated: true)
+    }
+
+    private func reload() {
+        let ids = AyuChatPrivacy.hidden.map { EnginePeer.Id($0) }
+        let _ = (self.context.engine.data.get(EngineDataMap(ids.map(TelegramEngine.EngineData.Item.Peer.Peer.init(id:))))
+        |> deliverOnMainQueue).startStandalone(next: { [weak self] peers in
+            guard let self else { return }
+            self.peers = peers.values.compactMap { $0 }.sorted(by: { $0.debugDisplayTitle < $1.debugDisplayTitle })
+            self.tableView.reloadData()
+        })
+    }
+
+    override func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int {
+        return max(1, self.peers.count)
+    }
+
+    override func tableView(_ tableView: UITableView, titleForFooterInSection section: Int) -> String? {
+        return self.russian ? "Скрыть чат: долгое нажатие на чат в списке → «Скрыть чат». Скрытые чаты не показываются в списке, но сообщения в них приходят как обычно." : "To hide a chat, long-press it in the chat list → Hide chat. Hidden chats stay out of the list; their messages arrive as usual."
+    }
+
+    override func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
+        let cell = UITableViewCell(style: .default, reuseIdentifier: nil)
+        if self.peers.isEmpty {
+            cell.textLabel?.text = self.russian ? "Скрытых чатов нет" : "No hidden chats"
+            cell.textLabel?.textColor = .secondaryLabel
+            cell.selectionStyle = .none
+        } else {
+            cell.textLabel?.text = self.peers[indexPath.row].debugDisplayTitle
+            cell.accessoryType = .disclosureIndicator
+        }
+        return cell
+    }
+
+    override func tableView(_ tableView: UITableView, didSelectRowAt indexPath: IndexPath) {
+        tableView.deselectRow(at: indexPath, animated: true)
+        guard indexPath.row < self.peers.count else { return }
+        let peer = self.peers[indexPath.row]
+        let sheet = UIAlertController(title: peer.debugDisplayTitle, message: nil, preferredStyle: .actionSheet)
+        sheet.addAction(UIAlertAction(title: self.russian ? "Открыть чат" : "Open chat", style: .default, handler: { [weak self] _ in
+            self?.dismiss(animated: true, completion: { self?.open(peer) })
+        }))
+        sheet.addAction(UIAlertAction(title: self.russian ? "Вернуть в список чатов" : "Show in the chat list", style: .default, handler: { [weak self] _ in
+            AyuChatPrivacy.setHidden(peer.id.toInt64(), false)
+            self?.reload()
+        }))
+        sheet.addAction(UIAlertAction(title: self.russian ? "Отмена" : "Cancel", style: .cancel))
+        self.present(sheet, animated: true)
+    }
+}
