+static py_TValue* c11_chunked_array2d__new_chunk(c11_chunked_array2d* self, c11_vec2i pos, py_Ref context) {
+    bool exists = c11_chunked_array2d_chunks__contains(&self->chunks, pos);
+    if(exists) {
