@@ -0,0 +1,279 @@
+import Foundation
+import UIKit
+import UniformTypeIdentifiers
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import PresentationDataUtils
+import ItemListUI
+import AccountContext
+
+// Settings → AyuGram → WhiteGram: WhiteGram's local customization in one place.
+
+private enum AyuWhiteGramRow: Int32 {
+    case messageBorder = 1
+    case borderColor = 2
+    case transparentBubbles = 3
+    case semiTransparentBubbles = 4
+    case wideChannelPosts = 5
+    case squareAvatars = 11
+    case oledMode = 12
+    case stickerSize = 13
+    case hideGalleryCamera = 14
+    case hideBusinessBotPanel = 15
+    case disableChatSwipeOptions = 16
+    case showCharCountTyping = 17
+    case showFullViewCount = 18
+    case showCharCountMessages = 19
+    case showActionTime = 20
+    case disableSwipeToRecordStory = 9
+    case hideBottomTabBar = 22
+    case tabBarScale = 23
+    case tabBarWidth = 24
+    case tabsAndGlass = 25
+    case sendLargePhotos = 27
+    case photoQuality = 28
+    case customFontEnabled = 31
+    case importFont = 32
+    case chooseFont = 33
+    case settingsRows = 41
+    case exportSettings = 42
+    case importSettings = 43
+    case relaunchInfo = 50
+    case reset = 51
+}
+
+private func ayuWhiteGramSignal() -> Signal<Void, NoError> {
+    return Signal { subscriber in
+        subscriber.putNext(Void())
+        let observers = [AyuWhiteGram.didChangeNotification, AyuAppearancePlus.didChangeNotification].map { name in
+            NotificationCenter.default.addObserver(forName: name, object: nil, queue: .main, using: { _ in subscriber.putNext(Void()) })
+        }
+        return ActionDisposable {
+            for observer in observers { NotificationCenter.default.removeObserver(observer) }
+        }
+    }
+}
+
+/// Keeps the font picker's delegate alive while the picker is on screen.
+private final class AyuFontPickerDelegate: NSObject, UIDocumentPickerDelegate {
+    let completion: (URL) -> Void
+    init(completion: @escaping (URL) -> Void) { self.completion = completion }
+    func documentPicker(_ controller: UIDocumentPickerViewController, didPickDocumentsAt urls: [URL]) {
+        if let url = urls.first { self.completion(url) }
+        AyuFontPickerDelegate.current = nil
+    }
+    func documentPickerWasCancelled(_ controller: UIDocumentPickerViewController) {
+        AyuFontPickerDelegate.current = nil
+    }
+    static var current: AyuFontPickerDelegate?
+}
+
+func ayuWhiteGramController(context: AccountContext) -> ViewController {
+    var push: ((ViewController) -> Void)?
+    var presentNative: ((UIViewController) -> Void)?
+    let store = context.account.network.ayuGhostMode
+    let russian = context.sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru")
+
+    func alert(_ title: String, _ message: String) {
+        let controller = UIAlertController(title: title, message: message, preferredStyle: .alert)
+        controller.addAction(UIAlertAction(title: "OK", style: .default))
+        presentNative?(controller)
+    }
+
+    func cycle(_ key: String, steps: [Double], current: CGFloat) {
+        let next = steps.first(where: { $0 > Double(current) + 0.001 }) ?? steps[0]
+        AyuWhiteGram.set(next, forKey: key)
+    }
+
+    let arguments = AyuSectionedArguments(open: { id in
+        switch AyuWhiteGramRow(rawValue: id) {
+        case .borderColor?:
+            let controller = UIAlertController(title: russian ? "Цвет рамки" : "Border color", message: russian ? "HEX вида #FF2D55. Пусто — акцентный цвет темы." : "HEX like #FF2D55. Empty uses the theme accent.", preferredStyle: .alert)
+            controller.addTextField { field in
+                field.text = AyuWhiteGram.messageBorderColorHex
+                field.placeholder = "#FF2D55"
+                field.autocapitalizationType = .allCharacters
+                field.autocorrectionType = .no
+            }
+            controller.addAction(UIAlertAction(title: russian ? "Отмена" : "Cancel", style: .cancel))
+            controller.addAction(UIAlertAction(title: russian ? "Сохранить" : "Save", style: .default, handler: { [weak controller] _ in
+                let value = (controller?.textFields?.first?.text ?? "").trimmingCharacters(in: .whitespaces)
+                let hex = value.trimmingCharacters(in: CharacterSet(charactersIn: "#"))
+                guard value.isEmpty || (hex.count == 6 && UInt32(hex, radix: 16) != nil) else {
+                    alert(russian ? "Неверный цвет" : "Invalid color", russian ? "Нужно 6 шестнадцатеричных цифр." : "Six hexadecimal digits are needed.")
+                    return
+                }
+                AyuWhiteGram.set(value.isEmpty ? nil : "#" + hex.uppercased(), forKey: "messageBorderColor")
+            }))
+            presentNative?(controller)
+        case .stickerSize?:
+            cycle("stickerScale", steps: [0.5, 0.75, 1.0, 1.25, 1.5], current: AyuWhiteGram.stickerScale)
+        case .photoQuality?:
+            cycle("photoQuality", steps: [0.6, 0.7, 0.8, 0.9, 0.95], current: AyuWhiteGram.photoQuality)
+        case .tabBarScale?:
+            cycle("tabBarScale", steps: [0.8, 0.9, 1.0, 1.1, 1.2], current: AyuWhiteGram.tabBarScale)
+        case .tabBarWidth?:
+            cycle("tabBarWidth", steps: [0.6, 0.7, 0.8, 0.9, 1.0], current: AyuWhiteGram.tabBarWidth)
+        case .tabsAndGlass?:
+            push?(ayuAppearancePlusController(context: context))
+        case .settingsRows?:
+            push?(ayuSettingsVisibilityController(context: context))
+        case .exportSettings?:
+            do {
+                let url = try AyuSettingsTransfer.exportFile()
+                presentNative?(UIActivityViewController(activityItems: [url], applicationActivities: nil))
+            } catch {
+                alert(russian ? "Не удалось экспортировать" : "Export failed", error.localizedDescription)
+            }
+        case .importSettings?:
+            let delegate = AyuFontPickerDelegate(completion: { url in
+                let scoped = url.startAccessingSecurityScopedResource()
+                defer { if scoped { url.stopAccessingSecurityScopedResource() } }
+                do {
+                    let count = try AyuSettingsTransfer.importData(Data(contentsOf: url))
+                    alert(russian ? "Настройки восстановлены" : "Settings restored", russian ? "Значений: \(count). Перезапустите приложение, чтобы применить всё." : "\(count) values. Relaunch the app to apply everything.")
+                } catch {
+                    alert(russian ? "Не удалось импортировать" : "Import failed", russian ? "Это не файл настроек AyuGram." : "This is not an AyuGram settings file.")
+                }
+            })
+            AyuFontPickerDelegate.current = delegate
+            let picker = UIDocumentPickerViewController(forOpeningContentTypes: [.item], asCopy: true)
+            picker.delegate = delegate
+            presentNative?(picker)
+        case .importFont?:
+            let delegate = AyuFontPickerDelegate(completion: { url in
+                let scoped = url.startAccessingSecurityScopedResource()
+                defer { if scoped { url.stopAccessingSecurityScopedResource() } }
+                do {
+                    let names = try AyuWhiteGram.importFont(from: url)
+                    if let first = names.first {
+                        AyuWhiteGram.set(first, forKey: "customFontName")
+                        AyuWhiteGram.set(true, forKey: "customFontEnabled")
+                    }
+                    alert(russian ? "Шрифт добавлен" : "Font added", (names.first ?? "") + (russian ? "\nПерезапустите приложение, чтобы применить." : "\nRelaunch the app to apply."))
+                } catch {
+                    alert(russian ? "Не удалось добавить шрифт" : "Could not add the font", russian ? "Поддерживаются файлы .ttf, .otf и .ttc." : ".ttf, .otf and .ttc files are supported.")
+                }
+            })
+            AyuFontPickerDelegate.current = delegate
+            var types: [UTType] = []
+            for ext in ["ttf", "otf", "ttc"] { if let type = UTType(filenameExtension: ext) { types.append(type) } }
+            let picker = UIDocumentPickerViewController(forOpeningContentTypes: types.isEmpty ? [.item] : types, asCopy: true)
+            picker.delegate = delegate
+            presentNative?(picker)
+        case .chooseFont?:
+            let names = AyuWhiteGram.importedFontNames
+            let sheet = UIAlertController(title: russian ? "Шрифт" : "Font", message: names.isEmpty ? (russian ? "Сначала добавьте файл шрифта." : "Add a font file first.") : nil, preferredStyle: .actionSheet)
+            for name in names {
+                sheet.addAction(UIAlertAction(title: name + (name == AyuWhiteGram.customFontName ? " ✓" : ""), style: .default, handler: { _ in
+                    AyuWhiteGram.set(name, forKey: "customFontName")
+                    AyuWhiteGram.set(true, forKey: "customFontEnabled")
+                }))
+            }
+            sheet.addAction(UIAlertAction(title: russian ? "Системный шрифт" : "System font", style: .destructive, handler: { _ in
+                AyuWhiteGram.set(false, forKey: "customFontEnabled")
+            }))
+            sheet.addAction(UIAlertAction(title: russian ? "Отмена" : "Cancel", style: .cancel))
+            presentNative?(sheet)
+        case .reset?:
+            AyuWhiteGram.resetAll()
+        default:
+            break
+        }
+    }, toggle: { id, value in
+        switch AyuWhiteGramRow(rawValue: id) {
+        case .messageBorder?: AyuWhiteGram.set(value, forKey: "messageBorder")
+        case .transparentBubbles?:
+            AyuWhiteGram.set(value, forKey: "transparentBubbles")
+            if value { AyuWhiteGram.set(false, forKey: "semiTransparentBubbles") }
+        case .semiTransparentBubbles?:
+            AyuWhiteGram.set(value, forKey: "semiTransparentBubbles")
+            if value { AyuWhiteGram.set(false, forKey: "transparentBubbles") }
+        case .squareAvatars?: AyuWhiteGram.set(value, forKey: "squareAvatars")
+        case .wideChannelPosts?: AyuWhiteGram.set(value, forKey: "wideChannelPosts")
+        case .oledMode?: AyuWhiteGram.set(value, forKey: "oledMode")
+        case .hideGalleryCamera?: AyuWhiteGram.set(value, forKey: "hideGalleryCamera")
+        case .hideBusinessBotPanel?: AyuWhiteGram.set(value, forKey: "hideBusinessBotPanel")
+        case .disableChatSwipeOptions?: AyuWhiteGram.set(value, forKey: "disableChatSwipeOptions")
+        case .showCharCountTyping?: AyuWhiteGram.set(value, forKey: "showCharCountTyping")
+        case .showCharCountMessages?: AyuWhiteGram.set(value, forKey: "showCharCountMessages")
+        case .showActionTime?: AyuWhiteGram.set(value, forKey: "showActionTime")
+        case .disableSwipeToRecordStory?: AyuWhiteGram.set(value, forKey: "disableSwipeToRecordStory")
+        case .showFullViewCount?:
+            // The same switch as exteraGram's "disable number rounding": one setting, two entry points.
+            try? store.update { $0.interface.disableNumberRounding = value }
+            AyuWhiteGram.set(value, forKey: "showFullViewCount")
+        case .hideBottomTabBar?: AyuWhiteGram.set(value, forKey: "hideBottomTabBar")
+        case .sendLargePhotos?: AyuWhiteGram.set(value, forKey: "sendLargePhotos")
+        case .customFontEnabled?: AyuWhiteGram.set(value, forKey: "customFontEnabled")
+        default: break
+        }
+    })
+
+    func symbol(_ name: String, _ color: UInt32) -> UIImage? {
+        return AyuSettingsIcons.symbol(name, color: UIColor(rgb: color))
+    }
+    func percent(_ value: CGFloat) -> String { return "\(Int((value * 100.0).rounded()))%" }
+
+    let signal = combineLatest(context.sharedContext.presentationData, ayuWhiteGramSignal(), store.signal)
+    |> deliverOnMainQueue
+    |> map { presentationData, _, settings -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        func row(_ section: Int32, _ row: AyuWhiteGramRow, _ icon: UIImage?, _ title: String, _ text: String?, _ value: Bool) -> AyuSectionedEntry {
+            return .toggle(section, row.rawValue, icon, title, text, value)
+        }
+        func link(_ section: Int32, _ row: AyuWhiteGramRow, _ icon: UIImage?, _ title: String, _ label: String) -> AyuSectionedEntry {
+            return .link(section, row.rawValue, icon, title, label)
+        }
+        let fontLabel = AyuWhiteGram.customFontEnabled ? AyuWhiteGram.customFontName : (ru ? "системный" : "system")
+        let entries: [AyuSectionedEntry] = [
+            .header(1, 0, ru ? "ПУЗЫРИ" : "BUBBLES"),
+            row(1, .messageBorder, symbol("square.dashed", 0x5856D6), ru ? "Рамка сообщений" : "Message border", ru ? "Применяется после перезапуска" : "Applies after relaunch", AyuWhiteGram.messageBorder),
+            link(1, .borderColor, symbol("paintpalette.fill", 0xFF2D55), ru ? "Цвет рамки" : "Border color", AyuWhiteGram.messageBorderColorHex.isEmpty ? (ru ? "акцент" : "accent") : AyuWhiteGram.messageBorderColorHex),
+            row(1, .transparentBubbles, symbol("circle.dashed", 0x32ADE6), ru ? "Прозрачные пузыри" : "Transparent bubbles", nil, AyuWhiteGram.transparentBubbles),
+            row(1, .semiTransparentBubbles, symbol("circle.lefthalf.filled", 0x007AFF), ru ? "Полупрозрачные пузыри" : "Semi-transparent bubbles", nil, AyuWhiteGram.semiTransparentBubbles),
+            row(1, .wideChannelPosts, symbol("rectangle.expand.vertical", 0x34C759), ru ? "Широкие посты в каналах" : "Wide channel posts", nil, AyuWhiteGram.wideChannelPosts),
+            .header(2, 7, ru ? "ИНТЕРФЕЙС" : "INTERFACE"),
+            row(2, .disableSwipeToRecordStory, symbol("camera.badge.ellipsis", 0xFF9500), ru ? "Без камеры историй по свайпу" : "No story camera on pull", ru ? "Оттягивание списка чатов не открывает камеру" : "Pulling the chat list does not open the camera", AyuWhiteGram.disableSwipeToRecordStory),
+            row(2, .squareAvatars, symbol("square.fill", 0xFF9500), ru ? "Квадратные аватары" : "Square avatars", nil, AyuWhiteGram.squareAvatars),
+            row(2, .oledMode, symbol("moon.fill", 0x000000), ru ? "OLED-режим" : "OLED mode", ru ? "Тёмная тема — чистый чёрный (после перезапуска)" : "Dark theme in true black (after relaunch)", AyuWhiteGram.oledMode),
+            link(2, .stickerSize, symbol("face.smiling.inverse", 0xFFCC00), ru ? "Размер стикеров" : "Sticker size", percent(AyuWhiteGram.stickerScale)),
+            row(2, .hideGalleryCamera, symbol("camera.fill", 0x8E8E93), ru ? "Без камеры в галерее" : "No camera in gallery", ru ? "Плитка камеры при выборе вложений" : "Camera tile when attaching", AyuWhiteGram.hideGalleryCamera),
