+        let secondary = self.palette?.secondary ?? .secondaryLabel
+        let accent = self.palette?.accent ?? .systemBlue
+        cell.backgroundColor = self.palette?.panel ?? .secondarySystemGroupedBackground
+        cell.textLabel?.numberOfLines = 2
+        cell.detailTextLabel?.numberOfLines = 0
+        cell.textLabel?.attributedText = NSAttributedString(string: font.name, attributes: [.font: UIFont.systemFont(ofSize: 17.0, weight: .semibold), .foregroundColor: primary])
+        let detail = NSMutableAttributedString(string: font.author.isEmpty ? "—" : font.author, attributes: [.font: UIFont.systemFont(ofSize: 14.0, weight: .medium), .foregroundColor: accent])
+        if let description = font.description, !description.isEmpty {
+            detail.append(NSAttributedString(string: "\n" + description, attributes: [.font: UIFont.systemFont(ofSize: 14.0), .foregroundColor: secondary]))
+        }
+        cell.detailTextLabel?.attributedText = detail
+        if self.installingFont == font.id {
+            let spinner = UIActivityIndicatorView(style: .medium)
+            spinner.startAnimating()
+            cell.accessoryView = spinner
+        } else {
+            var configuration = UIButton.Configuration.plain()
+            configuration.attributedTitle = AttributedString(self.russian ? "Выбрать" : "Use", attributes: AttributeContainer([.font: UIFont.systemFont(ofSize: 14.0, weight: .semibold)]))
+            configuration.baseForegroundColor = accent
+            configuration.background.backgroundColor = accent.withAlphaComponent(0.14)
+            configuration.background.cornerRadius = 14.0
+            configuration.contentInsets = NSDirectionalEdgeInsets(top: 5.0, leading: 12.0, bottom: 5.0, trailing: 12.0)
+            let button = UIButton(configuration: configuration, primaryAction: UIAction(handler: { [weak self] _ in
+                self?.confirmFont(font)
+            }))
+            button.sizeToFit()
+            cell.accessoryView = button
+        }
+        return cell
+    }
+
+    private func confirmFont(_ font: AyuFontCatalog.Entry) {
+        guard self.installingFont == nil else { return }
+        var message = font.author.isEmpty ? font.id : font.author
+        if let size = font.size {
+            message += " · " + ByteCountFormatter.string(fromByteCount: Int64(size), countStyle: .file)
+        }
+        if let description = font.description, !description.isEmpty {
+            message += "\n\n" + description
+        }
+        message += self.russian
+            ? "\n\nШрифт скачается, проверится по SHA-256 и станет шрифтом приложения после перезапуска."
+            : "\n\nThe font is downloaded, checked against its SHA-256 and becomes the app font after a relaunch."
+        self.showAlert(title: font.name, message: message, actions: [
+            AyuPluginAlertAction(title: self.russian ? "Отмена" : "Cancel", style: .cancel, handler: nil),
+            AyuPluginAlertAction(title: self.russian ? "Выбрать шрифт" : "Use font", style: .default, handler: { [weak self] in
+                self?.installFont(font)
+            })
+        ])
+    }
+
+    private func installFont(_ font: AyuFontCatalog.Entry) {
+        self.installingFont = font.id
+        self.reload()
+        AyuFontCatalog.shared.install(font, completion: { [weak self] result in
+            guard let self else { return }
+            self.installingFont = nil
+            self.reload()
+            switch result {
+            case .success:
+                self.alert(title: font.name, message: self.russian ? "Шрифт выбран. Перезапустите приложение, чтобы он применился везде." : "Font selected. Relaunch the app to apply it everywhere.")
+            case let .failure(error):
+                self.alert(title: self.russian ? "Не удалось установить" : "Could not install", message: error.localizedDescription)
+            }
+        })
+    }
+
+    override func tableView(_ tableView: UITableView, didSelectRowAt indexPath: IndexPath) {
+        tableView.deselectRow(at: indexPath, animated: true)
+        if indexPath.section == 1 {
+            let fonts = self.visibleFonts
+            if indexPath.row < fonts.count {
+                self.confirmFont(fonts[indexPath.row])
+            }
+            return
+        }
+        let entries = self.entries
+        guard indexPath.row < entries.count else { return }
+        self.confirm(entries[indexPath.row])
+    }
+
+    private func confirm(_ entry: AyuScriptCatalog.Entry) {
+        guard !self.installing.contains(entry.id) else { return }
+        if entry.isNativeCard {
+            // The plugin list shows its own confirmation for native cards.
+            self.installNativeCard(entry)
+            return
+        }
+        let status = self.status(entry)
+        var message = entry.author + "\n" + entry.id + " · " + entry.version
+        if case let .update(version) = status {
+            message += (self.russian ? " (установлена \(version))" : " (installed \(version))")
+        }
+        if let size = entry.size {
+            message += " · " + ByteCountFormatter.string(fromByteCount: Int64(size), countStyle: .file)
+        }
+        if !entry.description.isEmpty {
+            message += "\n\n" + entry.description
+        }
+        if let category = entry.category, !category.isEmpty {
+            message += (self.russian ? "\nКатегория: " : "\nCategory: ") + category
+        }
+        if let changelog = entry.changelog, !changelog.isEmpty {
+            message += (self.russian ? "\n\nЧто нового:\n" : "\n\nWhat's new:\n") + String(changelog.prefix(800))
+        }
+        if let version = AyuScriptCatalog.rollbackVersion(id: entry.id) {
+            message += self.russian ? "\n\nПредыдущая версия \(version) сохранена — её можно вернуть в списке плагинов." : "\n\nThe previous version \(version) is kept and can be restored from the plugin list."
+        }
+        if entry.signature != nil {
+            message += self.russian ? "\n\n✓ Официальный плагин: подпись AyuGram проверяется при установке." : "\n\n✓ Official plugin: the AyuGram signature is checked on install."
+        }
+        if entry.injects == true {
+            message += self.russian ? "\nВнедряется в приложение (плеер, тексты песен)." : "\nInjects into the app (player, lyrics)."
+        }
+        message += self.russian
+            ? "\n\nПлагин выполняется как код на этом устройстве. Он сможет изменять или полностью заменять обработку исходящего текста и отключать функции приложения. Доступа к сети и аккаунту у него нет."
+            : "\n\nThe plugin runs as code on this device. It can change or fully replace outgoing-text handling and switch app features off. It has no network or account access."
+        let title: String
+        let action: String
+        switch status {
+        case .available:
+            title = self.russian ? "Установить плагин?" : "Install plugin?"
+            action = self.russian ? "Установить" : "Install"
+        case .update:
+            title = self.russian ? "Обновить плагин?" : "Update plugin?"
+            action = self.russian ? "Обновить" : "Update"
+        case .installed:
+            title = entry.name
+            action = self.russian ? "Переустановить" : "Reinstall"
+        }
+        var actions = [
+            AyuPluginAlertAction(title: self.russian ? "Отмена" : "Cancel", style: .cancel, handler: nil),
+            AyuPluginAlertAction(title: action, style: .default, handler: { [weak self] in
+                self?.install(entry)
+            })
+        ]
+        if let screenshot = entry.screenshots?.first, let url = URL(string: screenshot), url.scheme == "https" {
+            actions.insert(AyuPluginAlertAction(title: self.russian ? "Скриншоты" : "Screenshots", style: .default, handler: {
+                UIApplication.shared.open(url)
+            }), at: 1)
+        }
+        if let version = AyuScriptCatalog.rollbackVersion(id: entry.id) {
+            actions.insert(AyuPluginAlertAction(title: (self.russian ? "Откатить на " : "Roll back to ") + version, style: .default, handler: { [weak self] in
+                guard let self else { return }
+                do {
+                    try AyuScriptCatalog.rollback(id: entry.id)
+                    self.alert(title: entry.name, message: self.russian ? "Возвращена версия \(version)." : "Version \(version) restored.")
+                } catch {
+                    self.alert(title: entry.name, message: error.localizedDescription)
+                }
+            }), at: 1)
+        }
+        self.showAlert(title: title, message: message, actions: actions)
+    }
+
+    private func install(_ entry: AyuScriptCatalog.Entry, acceptedRisk: Bool = false) {
+        self.installing.insert(entry.id)
+        self.reload()
+        AyuScriptCatalog.shared.install(entry, acceptedRisk: acceptedRisk, completion: { [weak self] result in
+            guard let self else { return }
+            self.installing.remove(entry.id)
+            self.reload()
+            switch result {
+            case .success:
+                break
+            case let .failure(error):
+                if let failure = error as? AyuScriptCatalog.Failure, case .injectNeedsConsent = failure {
+                    self.showAlert(title: self.russian ? "Плагин вне безопасной зоны" : "Plugin outside the safe zone", message: entry.name + "\n\n" + error.localizedDescription, actions: [
+                        AyuPluginAlertAction(title: self.russian ? "Отмена" : "Cancel", style: .cancel, handler: nil),
+                        AyuPluginAlertAction(title: self.russian ? "Я беру ответственность на себя" : "I take full responsibility", style: .default, handler: { [weak self] in
+                            self?.install(entry, acceptedRisk: true)
+                        })
+                    ])
+                } else {
+                    self.alert(title: self.russian ? "Не удалось установить" : "Could not install", message: error.localizedDescription)
+                }
+            }
+        })
+    }
+
+    private func installNativeCard(_ entry: AyuScriptCatalog.Entry) {
+        guard let importFile = self.importFile else { return }
+        self.installing.insert(entry.id)
+        self.reload()
+        AyuScriptCatalog.shared.download(entry, completion: { [weak self] result in
+            guard let self else { return }
+            self.installing.remove(entry.id)
+            self.reload()
+            switch result {
+            case let .success(data):
+                let filename = entry.id + "." + entry.fileExtension
+                let url = FileManager.default.temporaryDirectory.appendingPathComponent("ayu-catalog", isDirectory: true).appendingPathComponent(filename)
+                do {
+                    try FileManager.default.createDirectory(at: url.deletingLastPathComponent(), withIntermediateDirectories: true)
+                    try data.write(to: url, options: .atomic)
+                    importFile(url, filename)
+                } catch {
+                    self.alert(title: self.russian ? "Не удалось установить" : "Could not install", message: error.localizedDescription)
+                }
+            case let .failure(error):
+                self.alert(title: self.russian ? "Не удалось установить" : "Could not install", message: error.localizedDescription)
+            }
+        })
+    }
+
+    private func alert(title: String, message: String) {
+        self.showAlert(title: title, message: message, actions: [AyuPluginAlertAction(title: "OK", style: .default, handler: nil)])
+    }
+
+    private func showAlert(title: String?, message: String, actions: [AyuPluginAlertAction]) {
+        if let presentAlert = self.presentAlert {
+            presentAlert(title, message, actions)
+            return
+        }
+        let alert = UIAlertController(title: title, message: message, preferredStyle: .alert)
+        for action in actions {
+            alert.addAction(UIAlertAction(title: action.title, style: action.style == .cancel ? .cancel : .default, handler: { _ in action.handler?() }))
+        }
+        self.present(alert, animated: true)
+    }
+}
diff --git a/submodules/SettingsUI/Sources/AyuScriptCodePluginSource.swift b/submodules/SettingsUI/Sources/AyuScriptCodePluginSource.swift
