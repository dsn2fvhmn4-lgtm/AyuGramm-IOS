+func ayuExtrasController(context: AccountContext) -> ViewController {
+    // 27.0.1 had one switch for both; it becomes the two new ones.
+    if UserDefaults.standard.bool(forKey: "ayu.extra.skipOwnMessagesHistory") {
+        AyuExtras.set(.skipOwnDeleted, true)
+        AyuExtras.set(.skipOwnEdited, true)
+        UserDefaults.standard.removeObject(forKey: "ayu.extra.skipOwnMessagesHistory")
+    }
+    var push: ((ViewController) -> Void)?
+    var navigation: (() -> NavigationController?)?
+    let arguments = AyuSectionedArguments(open: { id in
+        if id == 7 {
+            push?(ayuDecoySettingsController(context: context))
+            return
+        }
+        if id == 8 {
+            AyuHiddenChatsController.present(context: context, open: { peer in
+                guard let navigationController = navigation?() else { return }
+                context.sharedContext.navigateToChatController(NavigateToChatControllerParams(navigationController: navigationController, context: context, chatLocation: .peer(peer)))
+            })
+            return
+        }
+        let ru = context.sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru")
+        // Saved deleted / edited messages: clear one kind, or export everything as JSON.
+        if id == 36 || id == 37 {
+            let kind: AyuMessageHistoryRecord.Kind = id == 36 ? .deleted : .edited
+            let alert = UIAlertController(title: id == 36 ? (ru ? "Очистить удалённые?" : "Clear deleted?") : (ru ? "Очистить изменённые?" : "Clear edited?"), message: ru ? "Сохранённые копии удалятся навсегда." : "The saved copies are removed for good.", preferredStyle: .alert)
+            alert.addAction(UIAlertAction(title: ru ? "Отмена" : "Cancel", style: .cancel))
+            alert.addAction(UIAlertAction(title: ru ? "Очистить" : "Clear", style: .destructive, handler: { _ in
+                let _ = context.engine.messages.ayuClearHistory(kind: kind).startStandalone()
+            }))
+            context.sharedContext.applicationBindings.presentNativeController(alert)
+            return
+        }
+        if id == 39 {
+            context.sharedContext.applicationBindings.presentNativeController(UINavigationController(rootViewController: AyuHistoryFeedController(context: context)))
+            return
+        }
+        if id == 35 {
+            let steps = [0, 3, 5, 7, 10]
+            let current = UserDefaults.standard.integer(forKey: "ayu.extra.undoSendSeconds")
+            UserDefaults.standard.set(steps[((steps.firstIndex(of: current) ?? 0) + 1) % steps.count], forKey: "ayu.extra.undoSendSeconds")
+            NotificationCenter.default.post(name: AyuExtras.didChangeNotification, object: nil)
+            return
+        }
+        if id == 38 {
+            let _ = (context.engine.messages.ayuExportHistory() |> deliverOnMainQueue).startStandalone(next: { data in
+                guard let data else { return }
+                let url = FileManager.default.temporaryDirectory.appendingPathComponent("AyuGram-messages.json")
+                guard (try? data.write(to: url, options: .atomic)) != nil else { return }
+                context.sharedContext.applicationBindings.presentNativeController(UIActivityViewController(activityItems: [url], applicationActivities: nil))
+            })
+            return
+        }
+        // Download speed: Telegram's default, then 2, 4, 6, 8, 16 parallel parts.
+        if id == 12 {
+            let steps = [0, 2, 4, 6, 8, 16]
+            let current = UserDefaults.standard.integer(forKey: "ayu.extra.downloadThreads")
+            let next = steps[((steps.firstIndex(of: current) ?? 0) + 1) % steps.count]
+            UserDefaults.standard.set(next, forKey: "ayu.extra.downloadThreads")
+            NotificationCenter.default.post(name: AyuExtras.didChangeNotification, object: nil)
+        }
+    }, toggle: { id, value in
+        guard let row = ayuExtraRows.first(where: { $0.id == id }) else { return }
+        AyuExtras.set(row.key, value)
+    })
+
+    let signal = combineLatest(context.sharedContext.presentationData, ayuExtrasSignal())
+    |> deliverOnMainQueue
+    |> map { presentationData, _ -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        var entries: [AyuSectionedEntry] = []
+        let headers: [Int32: String] = [
+            1: ru ? "ПРИВАТНОСТЬ" : "PRIVACY",
+            2: ru ? "ИНТЕРФЕЙС" : "INTERFACE",
+            3: ru ? "МУЗЫКА" : "MUSIC",
+            4: ru ? "СООБЩЕНИЯ" : "MESSAGES"
+        ]
+        var lastSection: Int32 = 0
+        for row in ayuExtraRows {
+            if row.section != lastSection {
+                lastSection = row.section
+                entries.append(.header(row.section, (row.section - 1) * 10, headers[row.section] ?? ""))
+            }
+            entries.append(.toggle(row.section, row.id, AyuSettingsIcons.symbol(row.symbol, color: UIColor(rgb: row.color)), ru ? row.titleRu : row.titleEn, ru ? row.infoRu : row.infoEn, AyuExtras.isOn(row.key)))
+        }
+        entries.insert(.link(1, 7, AyuSettingsIcons.symbol("theatermasks.fill", color: UIColor(rgb: 0x8E8E93)), ru ? "Фейк-режим" : "Decoy mode", AyuDecoyState.isConfigured ? (ru ? "вкл." : "on") : ""), at: entries.firstIndex(where: { $0.stableId > 7 }) ?? entries.count)
+        let hiddenCount = AyuChatPrivacy.hidden.count
+        entries.insert(.link(1, 8, AyuSettingsIcons.symbol("eye.slash.circle.fill", color: UIColor(rgb: 0x5856D6)), ru ? "Скрытые чаты" : "Hidden chats", hiddenCount > 0 ? "\(hiddenCount)" : ""), at: entries.firstIndex(where: { $0.stableId > 8 }) ?? entries.count)
+        let threads = UserDefaults.standard.integer(forKey: "ayu.extra.downloadThreads")
+        entries.insert(.link(2, 12, AyuSettingsIcons.symbol("arrow.down.circle.fill", color: UIColor(rgb: 0x007AFF)), ru ? "Скорость загрузки (потоки)" : "Download speed (threads)", threads == 0 ? (ru ? "стандарт" : "default") : "\(threads)"), at: entries.firstIndex(where: { $0.stableId > 12 }) ?? entries.count)
+        entries.insert(.info(3, 29, ru ? "В меню плеера (⋯ у текста) также есть таймер сна и эквалайзер." : "The player menu (⋯ next to the lyrics) also has a sleep timer and the equalizer."), at: entries.firstIndex(where: { $0.stableId > 29 }) ?? entries.count)
+        let undoSeconds = UserDefaults.standard.integer(forKey: "ayu.extra.undoSendSeconds")
+        entries.append(.link(4, 35, AyuSettingsIcons.symbol("arrow.uturn.backward.circle.fill", color: UIColor(rgb: 0x34C759)), ru ? "Отмена отправки" : "Undo send", undoSeconds == 0 ? (ru ? "выкл." : "off") : (ru ? "\(undoSeconds) с" : "\(undoSeconds) s")))
+        entries.append(.link(4, 36, AyuSettingsIcons.symbol("trash.fill", color: UIColor(rgb: 0xFF3B30)), ru ? "Очистить сохранённые удалённые" : "Clear saved deleted", ""))
+        entries.append(.link(4, 37, AyuSettingsIcons.symbol("eraser.fill", color: UIColor(rgb: 0xFF9500)), ru ? "Очистить сохранённые изменённые" : "Clear saved edits", ""))
+        entries.append(.link(4, 38, AyuSettingsIcons.symbol("square.and.arrow.up.fill", color: UIColor(rgb: 0x007AFF)), ru ? "Экспорт удалённых и изменённых" : "Export deleted and edited", "JSON"))
+        entries.append(.link(4, 39, AyuSettingsIcons.symbol("list.bullet.rectangle.portrait.fill", color: UIColor(rgb: 0xAF52DE)), ru ? "Лента удалённых и изменённых" : "Deleted and edited feed", ru ? "поиск" : "search"))
+        let data = ItemListPresentationData(presentationData)
+        let state = ItemListControllerState(presentationData: data, title: .text(ru ? "Приватность и мелочи" : "Privacy & extras"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        return (state, (ItemListNodeState(presentationData: data, entries: entries, style: .blocks, animateChanges: true), arguments))
+    }
+    let controller = ItemListController(context: context, state: signal)
+    push = { [weak controller] c in
+        (controller?.navigationController as? NavigationController)?.pushViewController(c)
+    }
+    navigation = { [weak controller] in
+        return controller?.navigationController as? NavigationController
+    }
+    return controller
+}
