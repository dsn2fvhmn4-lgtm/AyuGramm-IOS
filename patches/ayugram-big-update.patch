diff --git a/tools/ayu-tests/lua/main.c b/tools/ayu-tests/lua/main.c
new file mode 100644
index 00000000..68271ff4
--- /dev/null
+++ b/tools/ayu-tests/lua/main.c
@@ -0,0 +1,56 @@
+#include <AyuPluginEngines/AyuPluginEngines.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define CHECK(value, message) do { if (!(value)) { fprintf(stderr, "FAIL: %s\n", message); exit(1); } } while (0)
+
+static char *host(void *context, const char *request) {
+    (void)context;
+    (void)request;
+    return NULL;
+}
+
+static void rejects(const char *source, const char *expected) {
+    char *error = NULL;
+    AyuLuaPlugin *plugin = ayu_lua_create(source, "regression.lua", 100, host, NULL, &error);
+    CHECK(plugin == NULL, "invalid or over-budget plugin must fail");
+    CHECK(error != NULL && strstr(error, expected) != NULL, "failure must explain the reason");
+    free(error);
+}
+
+int main(void) {
+    rejects("io.open('file')", "nil");
+    rejects("load('return 1')", "nil");
+    rejects("while true do end", "out of time");
+    // Each allocation is below 32 MiB; the total must still be bounded.
+    rejects("local t = {}; for i = 1, 160 do t[i] = string.rep(tostring(i), 512 * 1024) end", "memory");
+
+    char *error = NULL;
+    AyuLuaPlugin *plugin = ayu_lua_create(
+        "ayu.hooks.before(ayu.points.outgoing_text, function(text, ctx) return text:upper() end)\n",
+        "hook.lua", 1000, host, NULL, &error);
+    CHECK(plugin != NULL && error == NULL, "a normal plugin must start after an allocation failure");
+    for (int i = 0; i < 20000; i++) {
+        char *result = ayu_lua_dispatch(plugin, "{\"op\":\"hook\",\"handler\":1,\"text\":\"hello\",\"ctx\":{}}", 100, &error);
+        CHECK(error == NULL && result != NULL && strcmp(result, "{\"text\":\"HELLO\"}") == 0, "repeated hooks must keep returning the correct result");
+        free(result);
+    }
+    // Creating the Lua request string also allocates. It must happen inside pcall.
+    size_t length = 33 * 1024 * 1024;
+    char *oversized = malloc(length + 1);
+    CHECK(oversized != NULL, "test request allocation");
+    memset(oversized, 'x', length);
+    oversized[length] = '\0';
+    char *result = ayu_lua_dispatch(plugin, oversized, 100, &error);
+    CHECK(result == NULL && error != NULL && strstr(error, "memory") != NULL, "oversized dispatch must return an error without aborting the process");
+    free(error);
+    free(oversized);
+    error = NULL;
+    result = ayu_lua_dispatch(plugin, "{\"op\":\"hook\",\"handler\":1,\"text\":\"ok\",\"ctx\":{}}", 100, &error);
+    CHECK(error == NULL && result != NULL && strcmp(result, "{\"text\":\"OK\"}") == 0, "dispatch recovers after memory failure");
+    free(result);
+    ayu_lua_destroy(plugin);
+    puts("PASS: Lua hooks, sandbox, timeout, aggregate memory cap and recovery");
+    return 0;
+}
