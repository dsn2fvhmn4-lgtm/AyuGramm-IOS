@@ -0,0 +1,99 @@
+import Foundation
+import UIKit
+import Display
+import TelegramCore
+import AccountContext
+
+/// Saved messages with tags: search, filter by #tag, open the chat, delete.
+final class AyuBookmarksController: UITableViewController, UISearchResultsUpdating {
+    private let russian: Bool
+    private let open: (Int64) -> Void
+    private let search = UISearchController(searchResultsController: nil)
+    private var shown: [AyuBookmarks.Bookmark] = []
+
+    init(russian: Bool, open: @escaping (Int64) -> Void) {
+        self.russian = russian
+        self.open = open
+        super.init(style: .insetGrouped)
+        self.title = russian ? "Закладки" : "Bookmarks"
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        self.search.searchResultsUpdater = self
+        self.search.obscuresBackgroundDuringPresentation = false
+        self.search.searchBar.placeholder = self.russian ? "Текст или #тег" : "Text or #tag"
+        self.navigationItem.searchController = self.search
+        self.navigationItem.hidesSearchBarWhenScrolling = false
+        self.navigationItem.leftBarButtonItem = UIBarButtonItem(barButtonSystemItem: .close, target: self, action: #selector(UIViewController.ayuDismissSelf))
+        self.refilter()
+    }
+
+    private func refilter() {
+        let query = (self.search.searchBar.text ?? "").trimmingCharacters(in: .whitespaces).lowercased()
+        let items = AyuBookmarks.all
+        if query.hasPrefix("#") {
+            let tag = String(query.dropFirst())
+            self.shown = items.filter { $0.tag.lowercased().hasPrefix(tag) }
+        } else if query.isEmpty {
+            self.shown = items
+        } else {
+            self.shown = items.filter { $0.text.lowercased().contains(query) || $0.chatTitle.lowercased().contains(query) || $0.tag.lowercased().contains(query) }
+        }
+        self.tableView.reloadData()
+    }
+
+    func updateSearchResults(for searchController: UISearchController) {
+        self.refilter()
+    }
+
+    override func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int {
+        return max(1, self.shown.count)
+    }
+
+    override func tableView(_ tableView: UITableView, titleForFooterInSection section: Int) -> String? {
+        let tags = AyuBookmarks.tags
+        return (self.russian ? "Добавить: долгое нажатие на сообщение → «В закладки»." : "To add: long-press a message → Bookmark.") + (tags.isEmpty ? "" : "\n" + tags.map { "#" + $0 }.joined(separator: " "))
+    }
+
+    override func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
+        let cell = UITableViewCell(style: .subtitle, reuseIdentifier: nil)
+        guard !self.shown.isEmpty else {
+            cell.textLabel?.text = self.russian ? "Закладок пока нет" : "No bookmarks yet"
+            cell.textLabel?.textColor = .secondaryLabel
+            cell.selectionStyle = .none
+            return cell
+        }
+        let item = self.shown[indexPath.row]
+        cell.textLabel?.text = item.text.isEmpty ? (self.russian ? "(медиа)" : "(media)") : item.text
+        cell.textLabel?.numberOfLines = 3
+        let date = DateFormatter.localizedString(from: Date(timeIntervalSince1970: TimeInterval(item.savedAt)), dateStyle: .short, timeStyle: .none)
+        cell.detailTextLabel?.text = (item.tag.isEmpty ? "" : "#" + item.tag + " · ") + item.chatTitle + " · " + date
+        cell.detailTextLabel?.textColor = .secondaryLabel
+        cell.accessoryType = .disclosureIndicator
+        return cell
+    }
+
+    override func tableView(_ tableView: UITableView, didSelectRowAt indexPath: IndexPath) {
+        tableView.deselectRow(at: indexPath, animated: true)
+        guard indexPath.row < self.shown.count else { return }
+        let item = self.shown[indexPath.row]
+        let sheet = UIAlertController(title: item.chatTitle, message: String(item.text.prefix(300)), preferredStyle: .actionSheet)
+        sheet.addAction(UIAlertAction(title: self.russian ? "Открыть чат" : "Open chat", style: .default, handler: { [weak self] _ in
+            self?.dismiss(animated: true, completion: { self?.open(item.peerId) })
+        }))
+        sheet.addAction(UIAlertAction(title: self.russian ? "Скопировать текст" : "Copy text", style: .default, handler: { _ in
+            UIPasteboard.general.string = item.text
+        }))
+        sheet.addAction(UIAlertAction(title: self.russian ? "Удалить" : "Delete", style: .destructive, handler: { [weak self] _ in
+            AyuBookmarks.all = AyuBookmarks.all.filter { !($0.peerId == item.peerId && $0.messageId == item.messageId) }
+            self?.refilter()
+        }))
+        sheet.addAction(UIAlertAction(title: self.russian ? "Отмена" : "Cancel", style: .cancel))
+        self.present(sheet, animated: true)
+    }
+}
