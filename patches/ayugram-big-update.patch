+            "🎵 Music from the player to your profile",
+            "🗣 On-device voice transcription, \"What did I miss\" with AI",
+            "🧩 Plugins: network, messages, commands, pages, cloud builds and SDKs in 7 languages"
+        ]
+        let alert = UIAlertController(title: (ru ? "Что нового в AyuGram " : "What's new in AyuGram ") + version, message: lines.joined(separator: "\n"), preferredStyle: .alert)
+        alert.addAction(UIAlertAction(title: ru ? "Отлично" : "Great", style: .default))
+        DispatchQueue.main.asyncAfter(deadline: .now() + 1.6) {
