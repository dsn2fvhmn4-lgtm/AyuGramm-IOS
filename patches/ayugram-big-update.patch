new file mode 100644
index 00000000..a9f3c1f0
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuGram/AyuHooks.swift
@@ -0,0 +1,162 @@
+import Foundation
+
+/// Hook points code plugins can intercept. TelegramCore only knows the registry; the
+/// JavaScript runtime that fills it lives in AccountContext.
+///
+/// For a text point the chain is: every `before` handler in registration order, then the
+/// native handler (or the first `replace` handler, which disables the native one), then
+/// every `after` handler. A handler that returns nil leaves the text unchanged.
+public final class AyuHooks {
+    public enum TextPoint: String, CaseIterable {
+        /// Plain outgoing text right before it is enqueued (JSON outgoing-replace plugins are
+        /// the native handler here).
+        case outgoingText = "message.outgoing.text"
+    }
+
+    public enum Mode: String {
+        case before, replace, after
+    }
+
+    public struct TextContext {
+        public let peerId: Int64
+        public let isSecret: Bool
+        public init(peerId: Int64, isSecret: Bool) {
+            self.peerId = peerId
+            self.isSecret = isSecret
+        }
+    }
+
+    public typealias TextHandler = (String, TextContext) -> String?
+
+    private struct Registration {
+        let owner: String
+        let mode: Mode
+        let handler: TextHandler
+    }
+
+    /// Native features a plugin may switch off. Each maps onto an existing AyuGram interface
+    /// setting so every call site that already honours that setting honours the plugin too.
+    public enum Feature: String, CaseIterable {
+        case fastShare, messageShot, reactionPicker, readSummary, editedInfo, messageDetails
+        case stories, similarChannels, premiumStatuses, unreadCounters, greetingSticker
+        case openLinkWarning, doubleTapToEdit, formattingToolbar, keyboardHideOnScroll
+    }
+
+    public static let shared = AyuHooks()
+    public static let didChangeNotification = Notification.Name("AyuGram.HooksChanged")
+
+    private let lock = NSLock()
+    private var textHandlers: [TextPoint: [Registration]] = [:]
+    private var disabledFeatures: [String: Set<Feature>] = [:]
+    /// Union of `disabledFeatures`, kept current on every change: the settings store asks for
+    /// it on each read, which happens many times per frame while lists scroll.
+    private var disabledUnion: Set<Feature> = []
+    private var revision: Int = 0
+
+    private init() {}
+
+    public func register(point: TextPoint, mode: Mode, owner: String, handler: @escaping TextHandler) {
+        self.lock.lock()
+        self.textHandlers[point, default: []].append(Registration(owner: owner, mode: mode, handler: handler))
+        self.revision += 1
+        self.lock.unlock()
+        self.notify()
+    }
+
+    public func setFeature(_ feature: Feature, disabled: Bool, owner: String) {
+        self.lock.lock()
+        var set = self.disabledFeatures[owner] ?? []
+        if disabled { set.insert(feature) } else { set.remove(feature) }
+        self.disabledFeatures[owner] = set.isEmpty ? nil : set
+        self.disabledUnion = self.disabledFeatures.values.reduce(into: Set<Feature>()) { $0.formUnion($1) }
+        self.revision += 1
+        self.lock.unlock()
+        self.notify()
+    }
+
+    /// Drops every hook and feature override a plugin installed (on disable, unload or hang).
+    public func removeAll(owner: String) {
+        self.lock.lock()
+        for (point, list) in self.textHandlers {
+            self.textHandlers[point] = list.filter { $0.owner != owner }
+        }
+        self.disabledFeatures.removeValue(forKey: owner)
+        self.disabledUnion = self.disabledFeatures.values.reduce(into: Set<Feature>()) { $0.formUnion($1) }
+        self.revision += 1
+        self.lock.unlock()
+        self.notify()
+    }
+
+    public func hasHandlers(_ point: TextPoint) -> Bool {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return !(self.textHandlers[point]?.isEmpty ?? true)
+    }
+
+    /// Who currently replaces the native handler of `point`, for the plugin screen.
+    public func replacingOwner(_ point: TextPoint) -> String? {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return self.textHandlers[point]?.first(where: { $0.mode == .replace })?.owner
+    }
+
+    public func run(_ point: TextPoint, text: String, context: TextContext, native: (String) -> String) -> String {
+        self.lock.lock()
+        let registrations = self.textHandlers[point] ?? []
+        self.lock.unlock()
+        if registrations.isEmpty {
+            return native(text)
+        }
+        var result = text
+        for registration in registrations where registration.mode == .before {
+            if let value = registration.handler(result, context) { result = value }
+        }
+        if let replacement = registrations.first(where: { $0.mode == .replace }) {
+            if let value = replacement.handler(result, context) { result = value }
+        } else {
+            result = native(result)
+        }
+        for registration in registrations where registration.mode == .after {
+            if let value = registration.handler(result, context) { result = value }
+        }
+        return result
+    }
+
+    public var activeDisabledFeatures: Set<Feature> {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return self.disabledUnion
+    }
+
+    /// The account policy as the app should see it with plugin feature overrides applied.
+    func applyingOverrides(to settings: AyuGhostModeSettings) -> AyuGhostModeSettings {
+        let disabled = self.activeDisabledFeatures
+        guard !disabled.isEmpty else { return settings }
+        var settings = settings
+        for feature in disabled {
+            switch feature {
+            case .fastShare: settings.interface.hideFastShare = true
+            case .messageShot: settings.interface.showMessageShot = false
+            case .reactionPicker: settings.interface.showReactionPicker = false
+            case .readSummary: settings.interface.showReadSummary = false
+            case .editedInfo: settings.interface.showEditedInfo = false
+            case .messageDetails: settings.interface.showMessageDetails = false
+            case .stories: settings.interface.hideStories = true
+            case .similarChannels: settings.interface.hideSimilarChannels = true
+            case .premiumStatuses: settings.interface.hidePremiumStatuses = true
+            case .unreadCounters: settings.interface.hideUnreadCounters = true
+            case .greetingSticker: settings.interface.disableGreetingSticker = true
+            case .openLinkWarning: settings.interface.disableOpenLinkWarning = true
+            case .doubleTapToEdit: settings.interface.doubleTapToEdit = false
+            case .formattingToolbar: settings.interface.formattingToolbar = false
+            case .keyboardHideOnScroll: settings.interface.hideKeyboardOnScroll = false
+            }
+        }
+        return settings
+    }
+
+    private func notify() {
+        let post = { NotificationCenter.default.post(name: AyuHooks.didChangeNotification, object: nil) }
+        if Thread.isMainThread { post() } else { DispatchQueue.main.async(execute: post) }
+    }
+}
diff --git a/submodules/TelegramCore/Sources/AyuGram/AyuLyricsProviderSettings.swift b/submodules/TelegramCore/Sources/AyuGram/AyuLyricsProviderSettings.swift
new file mode 100644
