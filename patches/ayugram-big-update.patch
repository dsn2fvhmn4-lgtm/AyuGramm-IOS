@@ -0,0 +1,49 @@
+import Foundation
+import UIKit
+import SwiftSignalKit
+import Display
+import AccountContext
+
+/// "In-call statistics" (Media & Calls → Calls): while a call runs, the engine's debug line
+/// (bitrate, latency, loss) is shown at the top of the screen and refreshed every two seconds.
+enum AyuCallStatistics {
+    private static var callDisposable: Disposable?
+    private static var timer: SwiftSignalKit.Timer?
+    private static let overlayId = "ayu.callStats"
+
+    static func install(sharedContext: SharedAccountContext) {
+        guard callDisposable == nil, let callManager = sharedContext.callManager else { return }
+        callDisposable = (callManager.currentCallSignal
+        |> deliverOnMainQueue).startStrict(next: { call in
+            timer?.invalidate()
+            timer = nil
+            AyuOverlayEffects.shared.removeText(id: overlayId)
+            guard let call, AyuMediaSettings.callStatistics else { return }
+            let update = {
+                let _ = (call.debugInfo() |> take(1) |> deliverOnMainQueue).startStandalone(next: { _, info in
+                    guard AyuMediaSettings.callStatistics else {
+                        AyuOverlayEffects.shared.removeText(id: overlayId)
+                        return
+                    }
+                    AyuOverlayEffects.shared.setText(id: overlayId, text: summary(info), anchor: "topLeft", color: .white, size: 11.0)
+                })
+            }
+            update()
+            let newTimer = SwiftSignalKit.Timer(timeout: 2.0, repeat: true, completion: update, queue: .mainQueue())
+            timer = newTimer
+            newTimer.start()
+        })
+    }
+
+    /// The interesting numbers from the engine's debug text, three lines at most.
+    static func summary(_ info: String) -> String {
+        let wanted = ["bitrate", "rtt", "ping", "loss", "jitter", "codec", "packet", "send", "recv", "network"]
+        let lines = info.components(separatedBy: CharacterSet.newlines)
+            .map { $0.trimmingCharacters(in: .whitespaces) }
+            .filter { line in !line.isEmpty && wanted.contains(where: { line.lowercased().contains($0) }) }
+        if lines.isEmpty {
+            return String(info.prefix(120))
+        }
+        return lines.prefix(3).map { String($0.prefix(60)) }.joined(separator: "\n")
+    }
+}
