--- /dev/null
+++ b/submodules/TelegramUI/Sources/AyuNameGuard.swift
@@ -0,0 +1,70 @@
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import UndoUI
+
+/// Anti-scam for people, not only links: a non-contact whose name mixes alphabets, poses as
+/// Telegram staff, or whose account looks very new gets one quiet warning per chat and launch.
+enum AyuNameGuard {
+    private static var warned = Set<Int64>()
+    /// User ids grow over time; ids above this were registered recently.
+    private static let freshAccountId: Int64 = 8_500_000_000
+    private static let impersonated = ["telegram", "телеграм", "support", "поддержк", "durov", "дуров", "admin", "админ", "модератор", "moderator", "security", "безопасност", "ayugram"]
+
+    static func warning(firstName: String, lastName: String, userId: Int64, isVerified: Bool, russian: Bool) -> String? {
+        var reasons: [String] = []
+        let name = (firstName + " " + lastName).trimmingCharacters(in: .whitespaces)
+        for word in name.split(whereSeparator: { $0 == " " || $0 == "_" || $0 == "-" }) {
+            var latin = false
+            var cyrillic = false
+            for scalar in word.unicodeScalars {
+                let value = scalar.value
+                if (0x41 ... 0x5A).contains(value) || (0x61 ... 0x7A).contains(value) { latin = true }
+                if (0x0400 ... 0x04FF).contains(value) { cyrillic = true }
+            }
+            if latin && cyrillic {
+                reasons.append(russian ? "в имени смешаны латинские и русские буквы" : "the name mixes Latin and Cyrillic letters")
+                break
+            }
+        }
+        let lowered = name.lowercased()
+        if !isVerified, userId != 777000, impersonated.contains(where: { lowered.contains($0) }) {
+            reasons.append(russian ? "имя похоже на официальную поддержку — настоящая поддержка Telegram не пишет первой" : "the name looks like official support, and real Telegram support never writes first")
+        }
+        if userId > freshAccountId {
+            reasons.append(russian ? "аккаунт, похоже, создан недавно" : "the account looks recently created")
+        }
+        guard !reasons.isEmpty else { return nil }
+        return (russian ? "Осторожно: " : "Careful: ") + reasons.joined(separator: "; ") + "."
+    }
+
+    static func isWarned(_ peerId: Int64) -> Bool {
+        return warned.contains(peerId)
+    }
+
+    static func markWarned(_ peerId: Int64) {
+        warned.insert(peerId)
+    }
+}
+
+extension ChatControllerImpl {
+    func ayuCheckPeerName() {
+        guard !AyuDecoyMode.isActive, !UserDefaults.standard.bool(forKey: AyuAntiScam.disabledKey),
+              let peerId = self.chatLocation.peerId, peerId.namespace == Namespaces.Peer.CloudUser else { return }
+        let value = peerId.toInt64()
+        guard !AyuNameGuard.isWarned(value) else { return }
+        let _ = (self.context.engine.data.get(
+            TelegramEngine.EngineData.Item.Peer.Peer(id: peerId),
+            TelegramEngine.EngineData.Item.Peer.IsContact(id: peerId)
+        )
+        |> deliverOnMainQueue).startStandalone(next: { [weak self] peer, isContact in
+            guard let self, !isContact, case let .user(user)? = peer, user.botInfo == nil, user.id != self.context.account.peerId else { return }
+            let ru = self.presentationData.strings.baseLanguageCode.hasPrefix("ru")
+            guard let text = AyuNameGuard.warning(firstName: user.firstName ?? "", lastName: user.lastName ?? "", userId: value, isVerified: user.isVerified, russian: ru) else { return }
+            AyuNameGuard.markWarned(value)
+            self.present(UndoOverlayController(presentationData: self.presentationData, content: .info(title: nil, text: text, timeout: 8.0, customUndoText: nil), elevatedLayout: true, action: { _ in return false }), in: .current)
+        })
+    }
+}
