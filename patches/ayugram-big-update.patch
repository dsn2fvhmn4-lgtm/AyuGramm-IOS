+CompExpr* CompExpr__new(int line, Opcode op0, Opcode op1) {
+    const static ExprVt Vt = {.dtor = CompExpr__dtor, .emit_ = CompExpr__emit_};
+    CompExpr* self = PK_MALLOC(sizeof(CompExpr));
+    self->vt = &Vt;
+    self->line = line;
+    self->op0 = op0;
+    self->op1 = op1;
+    self->expr = NULL;
+    self->vars = NULL;
+    self->iter = NULL;
+    self->cond = NULL;
+    return self;
+}
