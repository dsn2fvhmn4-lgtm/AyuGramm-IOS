diff --git a/submodules/TelegramUI/Sources/AyuVisionTools.swift b/submodules/TelegramUI/Sources/AyuVisionTools.swift
new file mode 100644
index 00000000..352232f8
--- /dev/null
+++ b/submodules/TelegramUI/Sources/AyuVisionTools.swift
@@ -0,0 +1,87 @@
+import Foundation
+import UIKit
+import Vision
+import CoreImage
+import CoreImage.CIFilterBuiltins
+
+/// On-device Vision helpers: cut the subject out of a photo for a sticker, and describe a photo
+/// for VoiceOver. Nothing leaves the device.
+enum AyuVisionTools {
+    static var canCutOut: Bool {
+        if #available(iOS 17.0, *) {
+            return true
+        }
+        return false
+    }
+
+    /// The photo's foreground subjects on a transparent background, cropped to them.
+    static func cutOut(path: String, completion: @escaping (UIImage?) -> Void) {
+        DispatchQueue.global(qos: .userInitiated).async {
+            let result = cutOutSync(path: path)
+            DispatchQueue.main.async {
+                completion(result)
+            }
+        }
+    }
+
+    private static func cutOutSync(path: String) -> UIImage? {
+        guard #available(iOS 17.0, *), let image = UIImage(contentsOfFile: path), let cgImage = image.cgImage else { return nil }
+        let request = VNGenerateForegroundInstanceMaskRequest()
+        let handler = VNImageRequestHandler(cgImage: cgImage, orientation: cgOrientation(image.imageOrientation))
+        do {
+            try handler.perform([request])
+            guard let observation = request.results?.first, !observation.allInstances.isEmpty else { return nil }
+            let buffer = try observation.generateMaskedImage(ofInstances: observation.allInstances, from: handler, croppedToInstancesExtent: true)
+            let ciImage = CIImage(cvPixelBuffer: buffer)
+            let context = CIContext()
+            guard let output = context.createCGImage(ciImage, from: ciImage.extent) else { return nil }
+            return UIImage(cgImage: output)
+        } catch {
+            return nil
+        }
+    }
+
+    /// A short description: what Vision sees (top labels) and any text in the picture.
+    static func describe(path: String, russian: Bool, completion: @escaping (String?) -> Void) {
+        DispatchQueue.global(qos: .utility).async {
+            let result = describeSync(path: path, russian: russian)
+            DispatchQueue.main.async {
+                completion(result)
+            }
+        }
+    }
+
+    private static func describeSync(path: String, russian: Bool) -> String? {
+        guard let image = UIImage(contentsOfFile: path), let cgImage = image.cgImage else { return nil }
+        let classify = VNClassifyImageRequest()
+        let text = VNRecognizeTextRequest()
+        text.recognitionLevel = .fast
+        text.recognitionLanguages = russian ? ["ru-RU", "en-US"] : ["en-US"]
+        let handler = VNImageRequestHandler(cgImage: cgImage, orientation: cgOrientation(image.imageOrientation))
+        try? handler.perform([classify, text])
+        let labels = (classify.results ?? []).filter { $0.confidence > 0.3 }.prefix(4).map { $0.identifier.replacingOccurrences(of: "_", with: " ") }
+        let lines = (text.results ?? []).compactMap { $0.topCandidates(1).first?.string }.prefix(5)
+        var parts: [String] = []
+        if !labels.isEmpty {
+            parts.append((russian ? "На фото: " : "Photo of: ") + labels.joined(separator: ", "))
+        }
+        if !lines.isEmpty {
+            parts.append((russian ? "Текст: " : "Text: ") + lines.joined(separator: " "))
+        }
+        return parts.isEmpty ? nil : parts.joined(separator: ". ")
+    }
+
+    private static func cgOrientation(_ orientation: UIImage.Orientation) -> CGImagePropertyOrientation {
+        switch orientation {
+        case .up: return .up
+        case .down: return .down
+        case .left: return .left
+        case .right: return .right
+        case .upMirrored: return .upMirrored
+        case .downMirrored: return .downMirrored
+        case .leftMirrored: return .leftMirrored
+        case .rightMirrored: return .rightMirrored
+        @unknown default: return .up
+        }
+    }
+}
diff --git a/submodules/TelegramUI/Sources/AyuVoiceChanger.swift b/submodules/TelegramUI/Sources/AyuVoiceChanger.swift
new file mode 100644
index 00000000..536bf25c
--- /dev/null
+++ b/submodules/TelegramUI/Sources/AyuVoiceChanger.swift
@@ -0,0 +1,76 @@
+import Foundation
+import Display
+
+/// AyuGram Voice Changer: processes the 16 kHz mono samples of a voice message before they are
+/// encoded. Pitch moves with two crossfaded read heads on a delay line, so the duration stays the
+/// same; "Robot" is a ring modulator.
+final class AyuVoiceChanger {
+    private static let bufferSize = 4096
+    private static let window = 960.0
+    private static let sampleRate = 16000.0
+
+    private let pitch: Double
+    private let robot: Bool
+    private var buffer = [Float](repeating: 0.0, count: AyuVoiceChanger.bufferSize)
+    private var writeIndex = 0
+    private var phase = 0.0
+    private var robotPhase = 0.0
+
+    /// nil when the voice changer is off.
+    static func makeIfEnabled() -> AyuVoiceChanger? {
+        let voice = AyuTools.voice
+        if voice == .off {
+            return nil
+        }
+        return AyuVoiceChanger(pitch: voice.pitch, robot: voice == .robot)
+    }
+
+    private init(pitch: Double, robot: Bool) {
+        self.pitch = pitch
+        self.robot = robot
+    }
+
+    private func read(delay: Double) -> Float {
+        let size = AyuVoiceChanger.bufferSize
+        var position = Double(self.writeIndex) - delay
+        while position < 0.0 {
+            position += Double(size)
+        }
+        let index = Int(position) % size
+        let next = (index + 1) % size
+        let fraction = Float(position - Double(Int(position)))
+        return self.buffer[index] * (1.0 - fraction) + self.buffer[next] * fraction
+    }
+
+    func process(_ samples: UnsafeMutablePointer<Int16>, count: Int) {
+        let size = AyuVoiceChanger.bufferSize
+        let window = AyuVoiceChanger.window
+        for i in 0 ..< count {
+            let input = Float(samples[i]) / 32768.0
+            self.buffer[self.writeIndex] = input
+            let output: Float
+            if self.robot {
+                output = input * Float(sin(self.robotPhase)) * 1.6
+                self.robotPhase += 2.0 * Double.pi * 70.0 / AyuVoiceChanger.sampleRate
+                if self.robotPhase > 2.0 * Double.pi {
+                    self.robotPhase -= 2.0 * Double.pi
+                }
+            } else {
+                let firstPhase = self.phase
+                var secondPhase = self.phase + 0.5
+                if secondPhase >= 1.0 {
+                    secondPhase -= 1.0
+                }
+                let first = self.read(delay: firstPhase * window + 1.0)
+                let second = self.read(delay: secondPhase * window + 1.0)
+                let firstGain = Float(sin(Double.pi * firstPhase) * sin(Double.pi * firstPhase))
+                let secondGain = Float(sin(Double.pi * secondPhase) * sin(Double.pi * secondPhase))
+                output = first * firstGain + second * secondGain
+                self.phase += (1.0 - self.pitch) / window
+                self.phase -= floor(self.phase)
+            }
+            self.writeIndex = (self.writeIndex + 1) % size
+            samples[i] = Int16(max(-32768.0, min(32767.0, output * 32767.0)))
+        }
+    }
+}
