@@ -0,0 +1,44 @@
+import Foundation
+import UIKit
+import AccountContext
+
+/// Bridges the plugin list to the JavaScript code-plugin runtime in AccountContext.
+final class AyuScriptCodePluginSource: AyuCodePluginSource {
+    private let runtime = AyuScriptRuntime.shared
+
+    var items: [AyuCodePluginItem] {
+        return self.runtime.plugins.map { self.item($0, activity: $0.enabled ? self.runtime.activitySummary(id: $0.id) : []) }
+    }
+
+    var fileExtensions: Set<String> {
+        return AyuScriptRuntime.fileExtensions
+    }
+
+    func setEnabled(_ id: String, _ enabled: Bool) {
+        self.runtime.setEnabled(id, enabled)
+    }
+
+    func remove(_ id: String) {
+        self.runtime.remove(id)
+    }
+
+    func lineCount(id: String) -> Int {
+        return self.runtime.source(id: id)?.components(separatedBy: .newlines).count ?? 0
+    }
+
+    func preview(_ data: Data, filename: String) -> AyuCodePluginItem? {
+        return self.runtime.preview(data, filename: filename).map { self.item($0, activity: []) }
+    }
+
+    func install(_ data: Data, filename: String) throws {
+        try self.runtime.install(data, filename: filename)
+    }
+
+    func makeCatalogController(russian: Bool, palette: AyuPreferencesPalette?, presentAlert: ((_ title: String?, _ message: String, _ actions: [AyuPluginAlertAction]) -> Void)?) -> UIViewController? {
+        return AyuScriptCatalogController(russian: russian, palette: palette, presentAlert: presentAlert)
+    }
+
+    private func item(_ plugin: AyuScriptRuntime.Plugin, activity: [String]) -> AyuCodePluginItem {
+        return AyuCodePluginItem(id: plugin.id, name: plugin.name, author: plugin.author, version: plugin.version, description: plugin.description, enabled: plugin.enabled, timedOut: plugin.disabledReason == "timeout", activity: activity)
+    }
+}
