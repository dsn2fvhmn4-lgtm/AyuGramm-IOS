+static void
+    cpy11__divmod_int_uint(int a, int b_log2, int b_mask, int* restrict q, int* restrict r) {
+    if(a >= 0) {
+        *q = a >> b_log2;
+        *r = a & b_mask;
+    } else {
+        *q = -1 - ((-a - 1) >> b_log2);
+        *r = b_mask - ((-a - 1) & b_mask);
+    }
+}
