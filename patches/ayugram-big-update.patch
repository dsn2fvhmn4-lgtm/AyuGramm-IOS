--- /dev/null
+++ b/submodules/Display/Source/AyuWhiteGram.swift
@@ -0,0 +1,141 @@
+import Foundation
+import UIKit
+import CoreText
+
+/// WhiteGram-style local customization (Settings → AyuGram → WhiteGram). App-wide, stored in
+/// UserDefaults; nothing here touches the network. Values that feed cached graphics (bubble
+/// borders, fonts) apply after a relaunch, the rest at once.
+public enum AyuWhiteGram {
+    public static let didChangeNotification = Notification.Name("AyuGram.WhiteGramChanged")
+
+    private static func bool(_ key: String) -> Bool { return UserDefaults.standard.bool(forKey: "ayu.wg." + key) }
+    private static func double(_ key: String, _ fallback: Double) -> Double {
+        return UserDefaults.standard.object(forKey: "ayu.wg." + key) as? Double ?? fallback
+    }
+    private static func string(_ key: String) -> String { return UserDefaults.standard.string(forKey: "ayu.wg." + key) ?? "" }
+
+    public static func set(_ value: Any?, forKey key: String) {
+        if let value { UserDefaults.standard.set(value, forKey: "ayu.wg." + key) } else { UserDefaults.standard.removeObject(forKey: "ayu.wg." + key) }
+        AyuWhiteGram.refreshCaches()
+        NotificationCenter.default.post(name: AyuWhiteGram.didChangeNotification, object: nil)
+    }
+
+    // MARK: Bubbles
+
+    public static var messageBorder: Bool { return bool("messageBorder") }
+    /// `#RRGGBB`; empty uses the theme accent.
+    public static var messageBorderColorHex: String { return string("messageBorderColor") }
+    public static var transparentBubbles: Bool { return bool("transparentBubbles") }
+    public static var semiTransparentBubbles: Bool { return bool("semiTransparentBubbles") }
+    public static var wideChannelPosts: Bool { return bool("wideChannelPosts") }
+
+    /// Opacity of bubble fills, wallpaper backdrop and shadow.
+    public static var bubbleFillAlpha: CGFloat {
+        if AyuWhiteGram.transparentBubbles { return 0.0 }
+        if AyuWhiteGram.semiTransparentBubbles { return 0.65 }
+        return 1.0
+    }
+
+    public static func borderColor(accent: UIColor) -> UIColor {
+        let hex = AyuWhiteGram.messageBorderColorHex.trimmingCharacters(in: CharacterSet(charactersIn: "# "))
+        if hex.count == 6, let value = UInt32(hex, radix: 16) {
+            return UIColor(rgb: value)
+        }
+        return accent
+    }
+
+    // MARK: Interface
+
+    public static var squareAvatars: Bool { return bool("squareAvatars") }
+    public static var oledMode: Bool { return bool("oledMode") }
+    /// Sticker scale, 0.5…1.5.
+    public static var stickerScale: CGFloat { return CGFloat(max(0.5, min(1.5, double("stickerScale", 1.0)))) }
+    public static var showCharCountTyping: Bool { return bool("showCharCountTyping") }
+    public static var showCharCountMessages: Bool { return bool("showCharCountMessages") }
+    public static var showActionTime: Bool { return bool("showActionTime") }
+    public static var hideBusinessBotPanel: Bool { return bool("hideBusinessBotPanel") }
+    public static var disableChatSwipeOptions: Bool { return bool("disableChatSwipeOptions") }
+    public static var hideGalleryCamera: Bool { return bool("hideGalleryCamera") }
+    public static var showFullViewCount: Bool { return bool("showFullViewCount") }
+    public static var compactChatList: Bool { return bool("compactChatList") }
+    public static var disableSwipeToRecordStory: Bool { return bool("disableSwipeToRecordStory") }
+
+    // MARK: Sending
+
+    /// Compressed photos at up to 2560 px instead of 1280 px.
+    public static var sendLargePhotos: Bool { return bool("sendLargePhotos") }
+    /// JPEG quality of compressed photos, 0.5…0.95 (Telegram uses 0.6).
+    public static var photoQuality: CGFloat { return CGFloat(max(0.5, min(0.95, double("photoQuality", 0.6)))) }
+
+    // MARK: Tab bar
+
+    public static var hideBottomTabBar: Bool { return bool("hideBottomTabBar") }
+    /// Tab bar scale 0.8…1.2 and width share 0.6…1.0.
+    public static var tabBarScale: CGFloat { return CGFloat(max(0.8, min(1.2, double("tabBarScale", 1.0)))) }
+    public static var tabBarWidth: CGFloat { return CGFloat(max(0.6, min(1.0, double("tabBarWidth", 1.0)))) }
+
+    // MARK: Fonts
+
+    /// PostScript name of the custom font, registered from Application Support at launch.
+    public static var customFontName: String { return string("customFontName") }
+    public static var customFontEnabled: Bool { return bool("customFontEnabled") && !AyuWhiteGram.customFontName.isEmpty }
+
+    public static var fontsDirectory: URL? {
+        return FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first?
+            .appendingPathComponent("AyuGram", isDirectory: true)
+            .appendingPathComponent("fonts", isDirectory: true)
+    }
+
+    /// Copies a .ttf/.otf into the app and registers it; returns its PostScript names.
+    public static func importFont(from url: URL) throws -> [String] {
+        guard let directory = AyuWhiteGram.fontsDirectory else { throw CocoaError(.fileWriteUnknown) }
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        let target = directory.appendingPathComponent(url.lastPathComponent)
+        if FileManager.default.fileExists(atPath: target.path) { try FileManager.default.removeItem(at: target) }
+        try FileManager.default.copyItem(at: url, to: target)
+        guard let descriptors = CTFontManagerCreateFontDescriptorsFromURL(target as CFURL) as? [CTFontDescriptor], !descriptors.isEmpty else {
+            try? FileManager.default.removeItem(at: target)
+            throw CocoaError(.fileReadCorruptFile)
+        }
+        CTFontManagerRegisterFontsForURL(target as CFURL, .process, nil)
+        return descriptors.compactMap { CTFontDescriptorCopyAttribute($0, kCTFontNameAttribute) as? String }
+    }
+
+    /// Registers every imported font so the chosen one resolves by name.
+    public static func registerImportedFonts() {
+        guard let directory = AyuWhiteGram.fontsDirectory, let files = try? FileManager.default.contentsOfDirectory(at: directory, includingPropertiesForKeys: nil) else { return }
+        for file in files where ["ttf", "otf", "ttc"].contains(file.pathExtension.lowercased()) {
+            CTFontManagerRegisterFontsForURL(file as CFURL, .process, nil)
+        }
+    }
+
+    public static var importedFontNames: [String] {
+        guard let directory = AyuWhiteGram.fontsDirectory, let files = try? FileManager.default.contentsOfDirectory(at: directory, includingPropertiesForKeys: nil) else { return [] }
+        var names: [String] = []
+        for file in files {
+            if let descriptors = CTFontManagerCreateFontDescriptorsFromURL(file as CFURL) as? [CTFontDescriptor] {
+                names.append(contentsOf: descriptors.compactMap { CTFontDescriptorCopyAttribute($0, kCTFontNameAttribute) as? String })
+            }
+        }
+        return names.sorted()
+    }
+
+    // MARK: Cached flags for hot paths
+
+    /// Read on every layout of avatars, fonts and bubbles; refreshed when a value changes.
+    public private(set) static var cachedSquareAvatars = AyuWhiteGram.squareAvatars
+    public private(set) static var cachedCustomFont: String? = AyuWhiteGram.customFontEnabled ? AyuWhiteGram.customFontName : nil
+
+    private static func refreshCaches() {
+        AyuWhiteGram.cachedSquareAvatars = AyuWhiteGram.squareAvatars
+        // Fonts are cached by Font; a new choice applies after relaunch.
+    }
+
+    public static func resetAll() {
+        for key in UserDefaults.standard.dictionaryRepresentation().keys where key.hasPrefix("ayu.wg.") {
+            UserDefaults.standard.removeObject(forKey: key)
+        }
+        AyuWhiteGram.refreshCaches()
+        NotificationCenter.default.post(name: AyuWhiteGram.didChangeNotification, object: nil)
+    }
+}
