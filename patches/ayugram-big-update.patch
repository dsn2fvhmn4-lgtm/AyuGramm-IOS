+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import PresentationDataUtils
+import ItemListUI
+import AccountContext
+import LocalizedPeerData
+
+// Settings → AyuGram → Privacy & extras → Decoy mode.
+
+private let ayuDecoyChanged = Notification.Name("AyuGram.DecoySettingsChanged")
+
+private enum AyuDecoyRow: Int32 {
+    case header = 0
+    case enabled = 1
+    case codes = 2
+    case account = 3
+    case info = 4
+    case howHeader = 10
+    case how = 11
+}
+
+func ayuDecoySettingsController(context: AccountContext) -> ViewController {
+    let changed = Signal<Void, NoError> { subscriber in
+        subscriber.putNext(Void())
+        let observer = NotificationCenter.default.addObserver(forName: ayuDecoyChanged, object: nil, queue: .main, using: { _ in subscriber.putNext(Void()) })
+        return ActionDisposable { NotificationCenter.default.removeObserver(observer) }
+    }
+    func notify() {
+        NotificationCenter.default.post(name: ayuDecoyChanged, object: nil)
+    }
+
+    let arguments = AyuSectionedArguments(open: { id in
+        let ru = context.sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru")
+        switch AyuDecoyRow(rawValue: id) {
+        case .codes?:
+            let alert = UIAlertController(title: ru ? "Коды" : "Codes", message: ru ? "Настоящий код возвращает в ваш аккаунт. Фейковый показывает «AyuGram больше не работает» и стирает все локальные данные. Минимум 4 символа, коды должны различаться." : "The real code returns to your account. The fake code shows \"AyuGram no longer works\" and wipes all local data. At least 4 characters; the codes must differ.", preferredStyle: .alert)
+            alert.addTextField { field in
+                field.placeholder = ru ? "Настоящий код" : "Real code"
+                field.isSecureTextEntry = true
+                field.keyboardType = .numberPad
+            }
+            alert.addTextField { field in
+                field.placeholder = ru ? "Фейковый код" : "Fake code"
+                field.isSecureTextEntry = true
+                field.keyboardType = .numberPad
+            }
+            alert.addAction(UIAlertAction(title: ru ? "Отмена" : "Cancel", style: .cancel))
+            alert.addAction(UIAlertAction(title: ru ? "Сохранить" : "Save", style: .default, handler: { [weak alert] _ in
+                let real = alert?.textFields?.first?.text ?? ""
+                let fake = alert?.textFields?.last?.text ?? ""
+                if !AyuDecoyState.setCodes(real: real, fake: fake) {
+                    let error = UIAlertController(title: nil, message: ru ? "Коды не сохранены: минимум 4 символа, и они должны различаться." : "Codes not saved: at least 4 characters, and they must differ.", preferredStyle: .alert)
+                    error.addAction(UIAlertAction(title: "OK", style: .default))
+                    context.sharedContext.applicationBindings.presentNativeController(error)
+                }
+                notify()
+            }))
+            context.sharedContext.applicationBindings.presentNativeController(alert)
+        case .account?:
+            let _ = (context.sharedContext.activeAccountsWithInfo
+            |> take(1)
+            |> deliverOnMainQueue).startStandalone(next: { primary, accounts in
+                let sheet = UIAlertController(title: ru ? "Что показывать" : "What to show", message: ru ? "Второй аккаунт: основной полностью скрыт. Встроенный: обычный на вид Telegram с готовыми чатами." : "A second account hides the main one. The built-in one is an ordinary-looking Telegram with ready-made chats.", preferredStyle: .actionSheet)
+                sheet.addAction(UIAlertAction(title: (ru ? "Встроенный (липовый)" : "Built-in stand-in") + (AyuDecoyState.decoyAccountId == nil ? " ✓" : ""), style: .default, handler: { _ in
+                    AyuDecoyState.decoyAccountId = nil
+                    notify()
+                }))
+                for info in accounts where info.account.id != primary {
+                    let name = info.peer.compactDisplayTitle
+                    sheet.addAction(UIAlertAction(title: name + (AyuDecoyState.decoyAccountId == info.account.id.int64 ? " ✓" : ""), style: .default, handler: { _ in
+                        AyuDecoyState.decoyAccountId = info.account.id.int64
+                        notify()
+                    }))
+                }
+                sheet.addAction(UIAlertAction(title: ru ? "Отмена" : "Cancel", style: .cancel))
+                context.sharedContext.applicationBindings.presentNativeController(sheet)
+            })
+        default:
+            break
+        }
+    }, toggle: { id, value in
+        if id == AyuDecoyRow.enabled.rawValue {
+            AyuDecoyState.isEnabled = value
+            notify()
+        }
+    })
+
+    let signal = combineLatest(context.sharedContext.presentationData, changed, context.sharedContext.activeAccountsWithInfo)
+    |> deliverOnMainQueue
+    |> map { presentationData, _, accountsInfo -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        let decoyName: String
+        if let decoyId = AyuDecoyState.decoyAccountId, let info = accountsInfo.accounts.first(where: { $0.account.id.int64 == decoyId }) {
+            decoyName = info.peer.compactDisplayTitle
+        } else {
+            decoyName = ru ? "встроенный" : "built-in"
+        }
+        let codesSet = AyuDecoyState.hasCodes
+        let entries: [AyuSectionedEntry] = [
+            .header(1, AyuDecoyRow.header.rawValue, ru ? "ФЕЙК-РЕЖИМ" : "DECOY MODE"),
+            .toggle(1, AyuDecoyRow.enabled.rawValue, AyuSettingsIcons.symbol("theatermasks.fill", color: UIColor(rgb: 0x8E8E93)), ru ? "Фейк-режим" : "Decoy mode", ru ? "Двойной тап по заставке при запуске" : "Double tap the launch splash", AyuDecoyState.isEnabled),
+            .link(1, AyuDecoyRow.codes.rawValue, AyuSettingsIcons.symbol("lock.fill", color: UIColor(rgb: 0xFF9500)), ru ? "Настоящий и фейковый код" : "Real and fake code", codesSet ? (ru ? "заданы" : "set") : (ru ? "не заданы" : "not set")),
+            .link(1, AyuDecoyRow.account.rawValue, AyuSettingsIcons.symbol("person.2.fill", color: UIColor(rgb: 0x007AFF)), ru ? "Что показывать" : "What to show", decoyName),
+            .info(1, AyuDecoyRow.info.rawValue, ru ? "Работает, когда включено и заданы оба кода." : "Works when it is on and both codes are set."),
+            .header(2, AyuDecoyRow.howHeader.rawValue, ru ? "КАК ЭТО РАБОТАЕТ" : "HOW IT WORKS"),
+            .info(2, AyuDecoyRow.how.rawValue, ru ? "При запуске появляется иконка AyuGram. Два быстрых нажатия по ней — и открывается фейк: второй аккаунт или встроенный липовый Telegram. В фейке нет раздела AyuGram, все функции AyuGram выключены.\n\nПосле полного закрытия приложения AyuGram спросит код. Настоящий код вернёт ваш аккаунт и больше не будет спрашиваться до следующего фейка. Фейковый код покажет «AyuGram больше не работает» и сотрёт все локальные данные — понадобится переустановка." : "At launch the AyuGram icon appears. Two quick taps on it open the decoy: a second account or a built-in stand-in Telegram. The decoy has no AyuGram section and every AyuGram feature is off.\n\nAfter the app is fully closed, AyuGram asks for a code. The real code brings your account back and is not asked again until the next decoy. The fake code shows \"AyuGram no longer works\" and wipes all local data — a reinstall is needed.")
+        ]
+        let data = ItemListPresentationData(presentationData)
+        let state = ItemListControllerState(presentationData: data, title: .text(ru ? "Фейк-режим" : "Decoy mode"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        return (state, (ItemListNodeState(presentationData: data, entries: entries, style: .blocks, animateChanges: true), arguments))
+    }
+    return ItemListController(context: context, state: signal)
+}
diff --git a/submodules/SettingsUI/Sources/AyuDesktopImport.swift b/submodules/SettingsUI/Sources/AyuDesktopImport.swift
new file mode 100644
index 00000000..7976ce86
--- /dev/null
+++ b/submodules/SettingsUI/Sources/AyuDesktopImport.swift
@@ -0,0 +1,125 @@
+import Foundation
+import UIKit
+import UniformTypeIdentifiers
+import SwiftSignalKit
+import TelegramCore
+import AccountContext
+import sqlcipher
+
+/// Imports deleted and edited messages from AyuGram Desktop's database (`ayugram.db` in the
+/// Desktop data folder). Column names differ between Desktop versions, so they are matched by
+/// name; rows without a chat, message id or text are skipped.
+enum AyuDesktopImport {
+    private static func columnIndex(_ names: [String], _ candidates: [String]) -> Int? {
+        let lowered = names.map { $0.lowercased() }
+        for candidate in candidates {
+            if let index = lowered.firstIndex(of: candidate.lowercased()) {
+                return index
+            }
+        }
+        return nil
+    }
+
+    static func read(url: URL) -> [AyuDesktopHistoryRow]? {
+        var db: OpaquePointer?
+        guard sqlite3_open_v2(url.path, &db, SQLITE_OPEN_READONLY, nil) == SQLITE_OK, let db else { return nil }
+        defer { sqlite3_close(db) }
+
+        var tables: [String] = []
+        var statement: OpaquePointer?
+        if sqlite3_prepare_v2(db, "SELECT name FROM sqlite_master WHERE type='table'", -1, &statement, nil) == SQLITE_OK {
+            while sqlite3_step(statement) == SQLITE_ROW {
+                if let name = sqlite3_column_text(statement, 0) {
+                    tables.append(String(cString: name))
+                }
+            }
+        }
+        sqlite3_finalize(statement)
+
+        var rows: [AyuDesktopHistoryRow] = []
+        for table in tables {
+            let lowered = table.lowercased()
+            let kind: AyuMessageHistoryRecord.Kind
+            if lowered.contains("deleted") {
+                kind = .deleted
+            } else if lowered.contains("edited") {
+                kind = .edited
+            } else {
+                continue
+            }
+            let safe = table.replacingOccurrences(of: "\"", with: "")
+            var query: OpaquePointer?
+            guard sqlite3_prepare_v2(db, "SELECT * FROM \"\(safe)\" LIMIT 200000", -1, &query, nil) == SQLITE_OK else {
+                sqlite3_finalize(query)
+                continue
+            }
+            let count = Int(sqlite3_column_count(query))
+            let names = (0 ..< count).map { String(cString: sqlite3_column_name(query, Int32($0))) }
+            guard let dialog = columnIndex(names, ["dialogId", "dialog_id", "peerId", "peer_id", "chatId"]),
+                  let message = columnIndex(names, ["messageId", "message_id", "msgId", "id"]),
+                  let text = columnIndex(names, ["text", "message", "messageText"]) else {
+                sqlite3_finalize(query)
+                continue
+            }
+            let date = columnIndex(names, ["date", "messageDate", "editDate"])
+            while sqlite3_step(query) == SQLITE_ROW {
+                let dialogId = sqlite3_column_int64(query, Int32(dialog))
+                let messageId = Int32(truncatingIfNeeded: sqlite3_column_int64(query, Int32(message)))
+                guard let raw = sqlite3_column_text(query, Int32(text)) else { continue }
+                let value = String(cString: raw)
+                let timestamp = date.map { Int32(truncatingIfNeeded: sqlite3_column_int64(query, Int32($0))) } ?? 0
+                rows.append(AyuDesktopHistoryRow(dialogId: dialogId, messageId: messageId, date: timestamp, kind: kind, text: value))
+            }
+            sqlite3_finalize(query)
+        }
+        return rows
+    }
+
+    static func present(context: AccountContext, russian ru: Bool) {
+        let picker = UIDocumentPickerViewController(forOpeningContentTypes: [.item], asCopy: true)
+        let delegate = AyuDesktopImportPicker(picked: { url in
+            DispatchQueue.global(qos: .userInitiated).async {
+                let rows = read(url: url)
+                DispatchQueue.main.async {
+                    guard let rows, !rows.isEmpty else {
+                        alert(context, ru ? "Это не база AyuGram Desktop или в ней нет удалённых и изменённых сообщений." : "This is not an AyuGram Desktop database, or it has no deleted or edited messages.")
+                        return
+                    }
+                    let _ = (context.engine.messages.ayuImportDesktopHistory(rows)
+                    |> deliverOnMainQueue).startStandalone(next: { added in
+                        alert(context, ru ? "Найдено \(rows.count), добавлено \(added). Сообщения появятся в истории AyuGram для этих чатов. Сохранение удалённых/изменённых должно быть включено." : "Found \(rows.count), added \(added). They appear in AyuGram history for those chats. Saving deleted/edited messages must be on.")
+                    })
+                }
+            }
+        })
+        AyuDesktopImportPicker.current = delegate
+        picker.delegate = delegate
+        context.sharedContext.applicationBindings.presentNativeController(picker)
+    }
+
+    private static func alert(_ context: AccountContext, _ message: String) {
+        let alert = UIAlertController(title: "AyuGram Desktop", message: message, preferredStyle: .alert)
+        alert.addAction(UIAlertAction(title: "OK", style: .default))
+        context.sharedContext.applicationBindings.presentNativeController(alert)
+    }
+}
+
+private final class AyuDesktopImportPicker: NSObject, UIDocumentPickerDelegate {
+    static var current: AyuDesktopImportPicker?
+    private let picked: (URL) -> Void
+
+    init(picked: @escaping (URL) -> Void) {
+        self.picked = picked
+    }
+
+    func documentPicker(_ controller: UIDocumentPickerViewController, didPickDocumentsAt urls: [URL]) {
+        if let url = urls.first {
+            self.picked(url)
+        }
+        AyuDesktopImportPicker.current = nil
+    }
+
+    func documentPickerWasCancelled(_ controller: UIDocumentPickerViewController) {
+        AyuDesktopImportPicker.current = nil
+    }
+}
diff --git a/submodules/SettingsUI/Sources/AyuDeveloperSettingsController.swift b/submodules/SettingsUI/Sources/AyuDeveloperSettingsController.swift
