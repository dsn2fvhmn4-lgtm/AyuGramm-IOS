diff --git a/Telegram/AyuIntents/AyuAppIntents.swift b/Telegram/AyuIntents/AyuAppIntents.swift
new file mode 100644
index 00000000..6195b04c
--- /dev/null
+++ b/Telegram/AyuIntents/AyuAppIntents.swift
@@ -0,0 +1,128 @@
+import Foundation
+@_weakLinked import AppIntents
+
+// AyuGram App Intents (Shortcuts, Siri, Spotlight, the Action button). They run in the app
+// process and talk to TelegramUI only through NotificationCenter (AyuSystemIntegration answers),
+// so this module links nothing but system frameworks.
+
+@available(iOS 16.0, *)
+private enum AyuIntentChannel {
+    static let request = Notification.Name("AyuGram.Intent.Request")
+    static let reply = Notification.Name("AyuGram.Intent.Reply")
+
+    /// Sends a request to the app and waits (up to `timeout` s) for its answer.
+    static func ask(_ action: String, _ payload: [String: Any] = [:], timeout: Double = 20.0) async -> [String: Any]? {
+        let id = UUID().uuidString
+        return await withCheckedContinuation { continuation in
+            let lock = NSLock()
+            var finished = false
+            var observer: NSObjectProtocol?
+            let finish: ([String: Any]?) -> Void = { value in
+                lock.lock()
+                let first = !finished
+                finished = true
+                lock.unlock()
+                guard first else { return }
+                if let observer {
+                    NotificationCenter.default.removeObserver(observer)
+                }
+                continuation.resume(returning: value)
+            }
+            observer = NotificationCenter.default.addObserver(forName: reply, object: nil, queue: .main, using: { notification in
+                guard let info = notification.userInfo as? [String: Any], info["id"] as? String == id else { return }
+                finish(info)
+            })
+            DispatchQueue.main.async {
+                var info = payload
+                info["id"] = id
+                info["action"] = action
+                NotificationCenter.default.post(name: request, object: nil, userInfo: info)
+            }
+            DispatchQueue.main.asyncAfter(deadline: .now() + timeout) {
+                finish(nil)
+            }
+        }
+    }
+}
+
+@available(iOS 16.0, *)
+struct AyuIntentError: Error, CustomLocalizedStringResourceConvertible {
+    let message: String
+    var localizedStringResource: LocalizedStringResource { LocalizedStringResource(stringLiteral: self.message) }
+}
+
+private var ayuRussian: Bool {
+    return Locale.preferredLanguages.first?.hasPrefix("ru") == true
+}
+
+@available(iOS 16.0, *)
+struct AyuSetGhostModeIntent: AppIntent {
+    static let title: LocalizedStringResource = "Ghost Mode"
+    static let description = IntentDescription("Turns AyuGram Ghost Mode on or off: no read receipts, online status, typing or upload progress.")
+
+    @Parameter(title: "Enabled", default: true)
+    var enabled: Bool
+
+    static var parameterSummary: some ParameterSummary {
+        Summary("Set Ghost Mode to \(\.$enabled)")
+    }
+
+    func perform() async throws -> some IntentResult & ProvidesDialog {
+        guard let answer = await AyuIntentChannel.ask("ghost.set", ["enabled": self.enabled]), answer["ok"] as? Bool == true else {
+            throw AyuIntentError(message: ayuRussian ? "AyuGram ещё не готов. Откройте приложение и попробуйте снова." : "AyuGram is not ready yet. Open the app and try again.")
+        }
+        let text = self.enabled ? (ayuRussian ? "Режим призрака включён" : "Ghost Mode is on") : (ayuRussian ? "Режим призрака выключен" : "Ghost Mode is off")
+        return .result(dialog: IntentDialog(stringLiteral: text))
+    }
+}
+
+@available(iOS 16.0, *)
+struct AyuSendMessageIntent: AppIntent {
+    static let title: LocalizedStringResource = "Send a Message with AyuGram"
+    static let description = IntentDescription("Sends a text message to a username (@name) or to a chat by its title.")
+
+    @Parameter(title: "Recipient", description: "A @username or a chat title")
+    var recipient: String
+
+    @Parameter(title: "Text")
+    var text: String
+
+    static var parameterSummary: some ParameterSummary {
+        Summary("Send \(\.$text) to \(\.$recipient)")
+    }
+
+    func perform() async throws -> some IntentResult & ProvidesDialog {
+        let answer = await AyuIntentChannel.ask("message.send", ["recipient": self.recipient, "text": self.text], timeout: 30.0)
+        guard let answer, answer["ok"] as? Bool == true else {
+            let reason = answer?["error"] as? String
+            throw AyuIntentError(message: reason ?? (ayuRussian ? "Не удалось отправить." : "Could not send."))
+        }
+        let name = answer["title"] as? String ?? self.recipient
+        return .result(dialog: IntentDialog(stringLiteral: (ayuRussian ? "Отправлено: " : "Sent to ") + name))
+    }
+}
+
+@available(iOS 16.0, *)
+struct AyuUnreadCountIntent: AppIntent {
+    static let title: LocalizedStringResource = "Unread Chats in AyuGram"
+    static let description = IntentDescription("Tells how many unread messages and chats there are.")
+
+    func perform() async throws -> some IntentResult & ReturnsValue<Int> & ProvidesDialog {
+        guard let answer = await AyuIntentChannel.ask("unread.count") else {
+            throw AyuIntentError(message: ayuRussian ? "AyuGram ещё не готов." : "AyuGram is not ready yet.")
+        }
+        let messages = answer["messages"] as? Int ?? 0
+        let chats = answer["chats"] as? Int ?? 0
+        let text = ayuRussian ? "Непрочитанных сообщений: \(messages), чатов: \(chats)" : "Unread messages: \(messages), chats: \(chats)"
+        return .result(value: messages, dialog: IntentDialog(stringLiteral: text))
+    }
+}
+
+@available(iOS 17.0, *)
+struct AyuAppShortcuts: AppShortcutsProvider {
+    static var appShortcuts: [AppShortcut] {
+        AppShortcut(intent: AyuSetGhostModeIntent(), phrases: ["Turn on Ghost Mode in \(.applicationName)", "Ghost Mode in \(.applicationName)"], shortTitle: "Ghost Mode", systemImageName: "eye.slash.fill")
+        AppShortcut(intent: AyuUnreadCountIntent(), phrases: ["Unread in \(.applicationName)", "How many unread in \(.applicationName)"], shortTitle: "Unread", systemImageName: "envelope.badge.fill")
+        AppShortcut(intent: AyuSendMessageIntent(), phrases: ["Send a message with \(.applicationName)"], shortTitle: "Send Message", systemImageName: "paperplane.fill")
+    }
+}
