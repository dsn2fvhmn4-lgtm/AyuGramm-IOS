+import Foundation
+import UIKit
+import AccountContext
+import Display
+
+/// Bridges the plugin list to the code-plugin runtime (JavaScript, Python, Rust/WASM) in AccountContext.
+final class AyuScriptCodePluginSource: AyuCodePluginSource {
+    private let runtime = AyuScriptRuntime.shared
+
+    var items: [AyuCodePluginItem] {
+        return self.runtime.plugins.map { self.item($0, activity: $0.enabled ? self.runtime.activitySummary(id: $0.id) : []) }
+    }
+
+    var fileExtensions: Set<String> {
+        return AyuScriptRuntime.fileExtensions
+    }
+
+    func setEnabled(_ id: String, _ enabled: Bool) {
+        self.runtime.setEnabled(id, enabled)
+    }
+
+    func remove(_ id: String) {
+        self.runtime.remove(id)
+    }
+
+    func lineCount(id: String) -> Int {
+        return self.runtime.source(id: id)?.components(separatedBy: .newlines).count ?? 0
+    }
+
+    func preview(_ data: Data, filename: String) -> AyuCodePluginItem? {
+        return self.runtime.preview(data, filename: filename).map { self.item($0, activity: []) }
+    }
+
+    func install(_ data: Data, filename: String) throws {
+        try self.runtime.install(data, filename: filename)
+    }
+
+    func installCheck(_ item: AyuCodePluginItem, official: Bool) -> AyuCodePluginInstallCheck {
+        let russian = Locale.preferredLanguages.first?.hasPrefix("ru") == true
+        switch AyuPluginTrust.decision(injects: item.injects, official: official) {
+        case .allowed: return .allowed
+        case .needsDisclaimer: return .needsDisclaimer(AyuPluginTrust.disclaimerText(russian))
+        case .refused: return .refused(AyuPluginTrust.refusalText(russian))
+        }
+    }
+
+    func installAcceptingRisk(_ data: Data, filename: String) throws {
+        try self.runtime.install(data, filename: filename, official: false, acceptedRisk: true)
+    }
+
+    func makeDetailsController(id: String, russian: Bool) -> UIViewController? {
+        return AyuCodePluginDetailsController(pluginId: id, russian: russian)
+    }
+
+    func makeSettingsController(id: String, russian: Bool, palette: AyuPreferencesPalette?) -> UIViewController? {
+        guard let plugin = self.runtime.plugin(id: id), !AyuPluginSettings.items(pluginId: id).isEmpty else { return nil }
+        return AyuPluginSettingsController(pluginId: id, title: plugin.name, russian: russian, palette: palette)
+    }
+
+    func makeCatalogController(russian: Bool, palette: AyuPreferencesPalette?, presentAlert: ((_ title: String?, _ message: String, _ actions: [AyuPluginAlertAction]) -> Void)?, importFile: @escaping (URL, String) -> Void, nativeState: @escaping (String) -> AyuCatalogNativeState) -> UIViewController? {
+        return AyuScriptCatalogController(russian: russian, palette: palette, presentAlert: presentAlert, importFile: importFile, nativeState: nativeState)
+    }
+
+    private func item(_ plugin: AyuScriptRuntime.Plugin, activity: [String]) -> AyuCodePluginItem {
+        var item = AyuCodePluginItem(id: plugin.id, name: plugin.name, author: plugin.author, version: plugin.version, description: plugin.description, enabled: plugin.enabled, timedOut: plugin.disabledReason == "timeout", activity: activity)
+        switch plugin.engine {
+        case .javascript: item.languageLabel = "JS"
+        case .python: item.languageLabel = "Python"
+        case .wasm: item.languageLabel = "Rust/WASM"
+        case .lua: item.languageLabel = "Lua"
+        }
+        item.injects = plugin.injects == true
+        item.official = plugin.official == true
+        item.hasSettings = !AyuPluginSettings.items(pluginId: plugin.id).isEmpty
+        let russian = Locale.preferredLanguages.first?.hasPrefix("ru") == true
+        item.permissions = (plugin.permissions ?? []).compactMap { AyuPluginPermission(rawValue: $0)?.title(russian) }
+        return item
+    }
+}
+
+/// Settings a plugin declared with `ayu.settings.declare`: switches and text fields.
+final class AyuPluginSettingsController: UITableViewController, UITextFieldDelegate {
+    private let pluginId: String
+    private let russian: Bool
+    private let palette: AyuPreferencesPalette?
+    private var items: [AyuPluginSettings.Item] = []
+
+    init(pluginId: String, title: String, russian: Bool, palette: AyuPreferencesPalette?) {
+        self.pluginId = pluginId
+        self.russian = russian
+        self.palette = palette
+        super.init(style: .insetGrouped)
+        self.title = title
+    }
+
+    required init?(coder: NSCoder) { return nil }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        self.items = AyuPluginSettings.items(pluginId: self.pluginId)
+        self.tableView.backgroundColor = self.palette?.background ?? .systemGroupedBackground
+        self.tableView.rowHeight = UITableView.automaticDimension
+        self.tableView.estimatedRowHeight = 56.0
+        self.tableView.keyboardDismissMode = .onDrag
+        let back = UIBarButtonItem(image: UIImage(systemName: "chevron.backward", withConfiguration: UIImage.SymbolConfiguration(weight: .semibold)), style: .plain, target: self, action: #selector(self.backTapped))
+        back.accessibilityLabel = self.russian ? "Назад" : "Back"
+        self.navigationItem.leftBarButtonItem = back
+    }
+
+    @objc private func backTapped() {
+        self.view.endEditing(true)
+        self.navigationController?.popViewController(animated: true)
+    }
+
+    override func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int {
+        return self.items.count
+    }
+
+    override func tableView(_ tableView: UITableView, titleForFooterInSection section: Int) -> String? {
+        return self.russian ? "Эти настройки объявил сам плагин. Изменения применяются сразу." : "These settings were declared by the plugin. Changes apply at once."
+    }
+
+    override func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
+        let item = self.items[indexPath.row]
+        let cell = UITableViewCell(style: .subtitle, reuseIdentifier: nil)
+        cell.backgroundColor = self.palette?.panel ?? .secondarySystemGroupedBackground
+        cell.selectionStyle = .none
+        cell.textLabel?.text = item.title
+        cell.textLabel?.textColor = self.palette?.text ?? .label
+        cell.textLabel?.numberOfLines = 0
+        cell.detailTextLabel?.text = item.subtitle
+        cell.detailTextLabel?.textColor = self.palette?.secondary ?? .secondaryLabel
+        cell.detailTextLabel?.numberOfLines = 0
+        let value = AyuPluginSettings.value(pluginId: self.pluginId, key: item.key) ?? item.defaultValue
+        switch item.kind {
+        case .toggle:
+            let toggle = UISwitch()
+            toggle.isOn = value == "1" || value.lowercased() == "true"
+            toggle.onTintColor = self.palette?.accent
+            toggle.tag = indexPath.row
+            toggle.addTarget(self, action: #selector(self.toggleChanged(_:)), for: .valueChanged)
+            cell.accessoryView = toggle
+        case .slider:
+            let slider = UISlider(frame: CGRect(x: 0.0, y: 0.0, width: 150.0, height: 32.0))
+            slider.minimumValue = Float(item.minimum)
+            slider.maximumValue = Float(item.maximum)
+            slider.value = Float(Double(value) ?? item.minimum)
+            slider.minimumTrackTintColor = self.palette?.accent
+            slider.tag = indexPath.row
+            slider.addTarget(self, action: #selector(self.sliderChanged(_:)), for: .valueChanged)
+            slider.addTarget(self, action: #selector(self.sliderFinished(_:)), for: [.touchUpInside, .touchUpOutside])
+            cell.accessoryView = slider
+            cell.detailTextLabel?.text = [item.subtitle, AyuPluginSettingsController.format(Double(value) ?? item.minimum, step: item.step)].compactMap { $0 }.joined(separator: " · ")
+        case .color:
+            let field = UITextField(frame: CGRect(x: 0.0, y: 0.0, width: 110.0, height: 32.0))
+            field.text = value
+            field.placeholder = "#8E5CF7"
+            field.textAlignment = .right
+            field.autocapitalizationType = .allCharacters
+            field.autocorrectionType = .no
+            field.returnKeyType = .done
+            field.tag = indexPath.row
+            field.delegate = self
+            field.addTarget(self, action: #selector(self.textChanged(_:)), for: .editingDidEnd)
+            let swatch = UIView(frame: CGRect(x: 0.0, y: 0.0, width: 22.0, height: 22.0))
+            swatch.layer.cornerRadius = 11.0
+            swatch.layer.borderWidth = 1.0
+            swatch.layer.borderColor = UIColor.separator.cgColor
+            if let rgb = AyuCustomization.parse(value) { swatch.backgroundColor = UIColor(rgb: rgb) }
+            let stack = UIStackView(arrangedSubviews: [field, swatch])
+            stack.spacing = 8.0
+            stack.alignment = .center
+            stack.frame = CGRect(x: 0.0, y: 0.0, width: 140.0, height: 32.0)
+            cell.accessoryView = stack
+        case .select:
+            let button = UIButton(type: .system)
+            let current = item.options.first(where: { $0.value == value })?.title ?? value
+            button.setTitle(current + " ▾", for: .normal)
+            button.setTitleColor(self.palette?.accent ?? .systemBlue, for: .normal)
+            let key = item.key
+            button.menu = UIMenu(children: item.options.map { option in
+                UIAction(title: option.title, state: option.value == value ? .on : .off, handler: { [weak self] _ in
+                    guard let self else { return }
+                    AyuPluginSettings.setValue(pluginId: self.pluginId, key: key, value: option.value)
+                    self.tableView.reloadData()
+                })
+            })
+            button.showsMenuAsPrimaryAction = true
+            button.sizeToFit()
+            cell.accessoryView = button
+        case .preview:
+            cell.detailTextLabel?.text = value.isEmpty ? item.subtitle : value
+            cell.accessoryView = nil
+        case .text:
+            let field = UITextField(frame: CGRect(x: 0.0, y: 0.0, width: 150.0, height: 32.0))
+            field.text = value
+            field.textAlignment = .right
+            field.textColor = self.palette?.accent ?? .systemBlue
+            field.returnKeyType = .done
+            field.tag = indexPath.row
+            field.delegate = self
+            field.addTarget(self, action: #selector(self.textChanged(_:)), for: .editingDidEnd)
+            cell.accessoryView = field
+        }
+        return cell
+    }
+
+    @objc private func toggleChanged(_ toggle: UISwitch) {
+        guard toggle.tag < self.items.count else { return }
+        AyuPluginSettings.setValue(pluginId: self.pluginId, key: self.items[toggle.tag].key, value: toggle.isOn ? "1" : "0")
+    }
+
+    private static func format(_ value: Double, step: Double) -> String {
+        return step >= 1.0 ? String(Int(value.rounded())) : String(format: "%.2f", value)
+    }
+
+    @objc private func sliderChanged(_ slider: UISlider) {
+        guard slider.tag < self.items.count else { return }
+        let item = self.items[slider.tag]
+        let snapped = (Double(slider.value) / item.step).rounded() * item.step
+        if let cell = self.tableView.cellForRow(at: IndexPath(row: slider.tag, section: 0)) {
+            cell.detailTextLabel?.text = [item.subtitle, AyuPluginSettingsController.format(snapped, step: item.step)].compactMap { $0 }.joined(separator: " · ")
+        }
+    }
+
+    @objc private func sliderFinished(_ slider: UISlider) {
+        guard slider.tag < self.items.count else { return }
+        let item = self.items[slider.tag]
+        let snapped = (Double(slider.value) / item.step).rounded() * item.step
+        AyuPluginSettings.setValue(pluginId: self.pluginId, key: item.key, value: String(snapped))
+    }
+
+    @objc private func textChanged(_ field: UITextField) {
+        guard field.tag < self.items.count else { return }
+        AyuPluginSettings.setValue(pluginId: self.pluginId, key: self.items[field.tag].key, value: field.text ?? "")
+    }
+
+    func textFieldShouldReturn(_ textField: UITextField) -> Bool {
+        textField.resignFirstResponder()
+        return true
+    }
+}
