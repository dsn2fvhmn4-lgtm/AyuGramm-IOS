diff --git a/submodules/SettingsUI/Sources/AyuLyricsSourcesController.swift b/submodules/SettingsUI/Sources/AyuLyricsSourcesController.swift
new file mode 100644
index 00000000..57a63bcd
--- /dev/null
+++ b/submodules/SettingsUI/Sources/AyuLyricsSourcesController.swift
@@ -0,0 +1,191 @@
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import PresentationDataUtils
+import ItemListUI
+import AccountContext
+
+// Settings → AyuGram → Lyrics sources: built-in services, a self-hosted LRCLIB and the user's
+// own lyrics APIs (URL templates), with short setup instructions on the page itself.
+
+private enum AyuLyricsSourceRow: Int32 {
+    case lrclib = 1
+    case lrclibServer = 2
+    case netEase = 3
+    case lyricsOvh = 4
+    /// Custom sources use 11 + 2i (switch) and 12 + 2i (edit), at most eight of them.
+    case addCustom = 29
+    case timeout = 40
+    case reset = 50
+}
+
+private let ayuLyricsSourcesChanged = Notification.Name("AyuGram.LyricsSourcesChanged")
+
+private func ayuLyricsSourcesSignal() -> Signal<AyuLyricsProviderSettings, NoError> {
+    return Signal { subscriber in
+        subscriber.putNext(AyuLyricsProviderSettings.current)
+        let observer = NotificationCenter.default.addObserver(forName: ayuLyricsSourcesChanged, object: nil, queue: .main, using: { _ in
+            subscriber.putNext(AyuLyricsProviderSettings.current)
+        })
+        return ActionDisposable {
+            NotificationCenter.default.removeObserver(observer)
+        }
+    }
+}
+
+private func ayuUpdateLyricsSources(_ transform: (inout AyuLyricsProviderSettings) -> Void) {
+    var settings = AyuLyricsProviderSettings.current
+    transform(&settings)
+    AyuLyricsProviderSettings.current = settings
+    NotificationCenter.default.post(name: ayuLyricsSourcesChanged, object: nil)
+}
+
+func ayuLyricsSourcesController(context: AccountContext) -> ViewController {
+    var presentNative: ((UIViewController) -> Void)?
+    let russian = context.sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru")
+
+    func editProvider(index: Int?) {
+        let existing = index.flatMap { AyuLyricsProviderSettings.current.customProviders.indices.contains($0) ? AyuLyricsProviderSettings.current.customProviders[$0] : nil }
+        let alert = UIAlertController(
+            title: existing == nil ? (russian ? "Свой источник" : "Custom source") : existing?.name,
+            message: russian
+                ? "Адрес API с подстановками {artist}, {title}, {album}, {duration} (секунды) или {query} (исполнитель и название). Сервер может вернуть LRC, обычный текст или JSON с полем syncedLyrics, lrc, lyrics или plainLyrics."
+                : "API address with {artist}, {title}, {album}, {duration} (seconds) or {query} (artist and title). The server may return LRC, plain text, or JSON with syncedLyrics, lrc, lyrics or plainLyrics.",
+            preferredStyle: .alert)
+        alert.addTextField { field in
+            field.placeholder = russian ? "Название" : "Name"
+            field.text = existing?.name
+        }
+        alert.addTextField { field in
+            field.placeholder = "https://example.com/lyrics?q={query}&d={duration}"
+            field.text = existing?.urlTemplate
+            field.keyboardType = .URL
+            field.autocapitalizationType = .none
+            field.autocorrectionType = .no
+        }
+        alert.addAction(UIAlertAction(title: russian ? "Отмена" : "Cancel", style: .cancel))
+        if let index, existing != nil {
+            alert.addAction(UIAlertAction(title: russian ? "Удалить" : "Delete", style: .destructive, handler: { _ in
+                ayuUpdateLyricsSources { settings in
+                    if settings.customProviders.indices.contains(index) { settings.customProviders.remove(at: index) }
+                }
+            }))
+        }
+        alert.addAction(UIAlertAction(title: russian ? "Сохранить" : "Save", style: .default, handler: { [weak alert] _ in
+            let name = (alert?.textFields?.first?.text ?? "").trimmingCharacters(in: .whitespacesAndNewlines)
+            let template = (alert?.textFields?.last?.text ?? "").trimmingCharacters(in: .whitespacesAndNewlines)
+            guard AyuLyricsProviderSettings.isValidTemplate(template) else {
+                let error = UIAlertController(title: russian ? "Неверный адрес" : "Invalid address", message: russian ? "Адрес должен начинаться с https:// и содержать {title} или {query}." : "The address must start with https:// and contain {title} or {query}.", preferredStyle: .alert)
+                error.addAction(UIAlertAction(title: "OK", style: .default))
+                presentNative?(error)
+                return
+            }
+            let provider = AyuLyricsProviderSettings.CustomProvider(name: name.isEmpty ? (URL(string: template)?.host ?? "API") : String(name.prefix(40)), urlTemplate: template, enabled: existing?.enabled ?? true)
+            ayuUpdateLyricsSources { settings in
+                if let index, settings.customProviders.indices.contains(index) {
+                    settings.customProviders[index] = provider
+                } else if settings.customProviders.count < 8 {
+                    settings.customProviders.append(provider)
+                }
+            }
+        }))
+        presentNative?(alert)
+    }
+
+    func editServer() {
+        let alert = UIAlertController(title: russian ? "Сервер LRCLIB" : "LRCLIB server", message: russian ? "Адрес своего сервера LRCLIB (например, развёрнутого через Docker). Пусто — lrclib.net." : "Your own LRCLIB server (for example, run with Docker). Empty — lrclib.net.", preferredStyle: .alert)
+        alert.addTextField { field in
+            field.placeholder = "https://lrclib.net"
+            field.text = AyuLyricsProviderSettings.current.lrclibBaseURL
+            field.keyboardType = .URL
+            field.autocapitalizationType = .none
+            field.autocorrectionType = .no
+        }
+        alert.addAction(UIAlertAction(title: russian ? "Отмена" : "Cancel", style: .cancel))
+        alert.addAction(UIAlertAction(title: russian ? "Сохранить" : "Save", style: .default, handler: { [weak alert] _ in
+            var value = (alert?.textFields?.first?.text ?? "").trimmingCharacters(in: .whitespacesAndNewlines)
+            if value.isEmpty { value = "https://lrclib.net" }
+            guard value.lowercased().hasPrefix("https://") || value.lowercased().hasPrefix("http://"), URL(string: value) != nil else { return }
+            ayuUpdateLyricsSources { $0.lrclibBaseURL = value }
+        }))
+        presentNative?(alert)
+    }
+
+    let arguments = AyuSectionedArguments(open: { id in
+        if id >= 12 && id <= 26 && id % 2 == 0 {
+            editProvider(index: Int(id - 12) / 2)
+            return
+        }
+        switch AyuLyricsSourceRow(rawValue: id) {
+        case .lrclibServer?: editServer()
+        case .addCustom?: editProvider(index: nil)
+        case .timeout?:
+            ayuUpdateLyricsSources { settings in
+                let steps: [Double] = [8.0, 12.0, 20.0, 30.0]
+                let next = steps.first(where: { $0 > settings.timeout + 0.5 }) ?? steps[0]
+                settings.timeout = next
+            }
+        case .reset?:
+            ayuUpdateLyricsSources { $0 = AyuLyricsProviderSettings() }
+        default:
+            break
+        }
+    }, toggle: { id, value in
+        ayuUpdateLyricsSources { settings in
+            if id >= 11 && id <= 25 && id % 2 == 1 {
+                let index = Int(id - 11) / 2
+                if settings.customProviders.indices.contains(index) { settings.customProviders[index].enabled = value }
+                return
+            }
+            switch AyuLyricsSourceRow(rawValue: id) {
+            case .lrclib?: settings.lrclibEnabled = value
+            case .netEase?: settings.netEaseEnabled = value
+            case .lyricsOvh?: settings.lyricsOvhEnabled = value
+            default: break
+            }
+        }
+    })
+
+    func symbol(_ name: String, _ color: UInt32) -> UIImage? {
+        return AyuSettingsIcons.symbol(name, color: UIColor(rgb: color))
+    }
+
+    let signal = combineLatest(context.sharedContext.presentationData, ayuLyricsSourcesSignal())
+    |> deliverOnMainQueue
+    |> map { presentationData, settings -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        var entries: [AyuSectionedEntry] = [
+            .header(1, 0, ru ? "ВСТРОЕННЫЕ ИСТОЧНИКИ" : "BUILT-IN SOURCES"),
+            .toggle(1, AyuLyricsSourceRow.lrclib.rawValue, symbol("text.quote", 0x5856D6), "LRCLIB", ru ? "Синхронные тексты, большая база" : "Synced lyrics, large catalogue", settings.lrclibEnabled),
+            .link(1, AyuLyricsSourceRow.lrclibServer.rawValue, symbol("server.rack", 0x8E8E93), ru ? "Сервер LRCLIB" : "LRCLIB server", URL(string: settings.lrclibBaseURL)?.host ?? settings.lrclibBaseURL),
+            .toggle(1, AyuLyricsSourceRow.netEase.rawValue, symbol("waveform", 0xFF3B30), "NetEase", ru ? "Тайминг по словам для многих песен" : "Word timing for many songs", settings.netEaseEnabled),
+            .toggle(1, AyuLyricsSourceRow.lyricsOvh.rawValue, symbol("doc.plaintext", 0x34C759), "lyrics.ovh", ru ? "Только текст, запасной вариант" : "Plain text fallback", settings.lyricsOvhEnabled),
+            .header(2, 10, ru ? "СВОИ API" : "YOUR APIS")
+        ]
+        for (index, provider) in settings.customProviders.enumerated() {
+            entries.append(.toggle(2, Int32(11 + 2 * index), symbol("link", 0x007AFF), provider.name, URL(string: provider.urlTemplate.replacingOccurrences(of: "{", with: "").replacingOccurrences(of: "}", with: ""))?.host ?? provider.urlTemplate, provider.enabled))
+            entries.append(.link(2, Int32(12 + 2 * index), nil, ru ? "   Изменить «\(provider.name)»" : "   Edit “\(provider.name)”", ""))
+        }
+        if settings.customProviders.count < 8 {
+            entries.append(.link(2, AyuLyricsSourceRow.addCustom.rawValue, symbol("plus", 0x007AFF), ru ? "Добавить источник" : "Add source", ""))
+        }
+        entries.append(.info(2, 30, ru
+            ? "Как настроить:\n1. Нажмите «Добавить источник».\n2. Вставьте адрес API, подставив {query} или {artist} и {title}, например:\nhttps://ваш-сервер/api/get?artist_name={artist}&track_name={title}&duration={duration}\n3. Сохраните — источник опрашивается вместе со встроенными, побеждает лучший результат (по словам → по строкам → текст).\nСвой LRCLIB: запустите сервер lrclib (Docker-образ tranxuanthang/lrclib) и укажите его адрес в «Сервер LRCLIB»."
+            : "Setup:\n1. Tap Add source.\n2. Paste the API address with {query} or {artist} and {title}, e.g.\nhttps://your-server/api/get?artist_name={artist}&track_name={title}&duration={duration}\n3. Save — it is asked alongside the built-in sources and the best result wins (word → line → text).\nOwn LRCLIB: run the lrclib server (Docker image tranxuanthang/lrclib) and enter its address under LRCLIB server."))
+        entries.append(.header(3, 39, ru ? "ПОИСК" : "LOOKUP"))
+        entries.append(.link(3, AyuLyricsSourceRow.timeout.rawValue, symbol("timer", 0xFF9500), ru ? "Ждать ответа не дольше" : "Wait at most", ru ? "\(Int(settings.timeout)) с" : "\(Int(settings.timeout)) s"))
+        entries.append(.link(3, AyuLyricsSourceRow.reset.rawValue, symbol("arrow.counterclockwise", 0xFF3B30), ru ? "Сбросить источники" : "Reset sources", ""))
+        entries.append(.info(3, 51, ru ? "Отправляются только исполнитель, название и длительность трека; звук никуда не отправляется." : "Only artist, title and duration are sent; audio never leaves the device."))
+        let data = ItemListPresentationData(presentationData)
+        let state = ItemListControllerState(presentationData: data, title: .text(ru ? "Источники текстов" : "Lyrics sources"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        return (state, (ItemListNodeState(presentationData: data, entries: entries, style: .blocks, animateChanges: true), arguments))
+    }
+    let controller = ItemListController(context: context, state: signal)
+    presentNative = { viewController in
+        context.sharedContext.applicationBindings.presentNativeController(viewController)
+    }
+    return controller
+}
