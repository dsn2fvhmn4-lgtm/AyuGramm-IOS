+static bool boundmethod__ne__(int argc, py_Ref argv) {
+    bool ok = boundmethod__eq__(argc, argv);
+    if(!ok) return false;
+    bool res = py_tobool(py_retval());
+    py_newbool(py_retval(), !res);
+    return true;
+}
