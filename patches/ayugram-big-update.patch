+        let state = ItemListControllerState(presentationData: data, title: .text(ru ? "Призрак по чатам" : "Ghost Mode by chat"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        return (state, (ItemListNodeState(presentationData: data, entries: entries, style: .blocks, animateChanges: true), arguments))
+    }
