+            c11_serializer__write_i32(s, sv.size);
+            c11_serializer__write_bytes(s, sv.data, sv.size);
+            break;
+        }
+        case tp_bool: {
+            bool value = py_tobool(val);
+            c11_serializer__write_i8(s, value ? 1 : 0);
+            break;
