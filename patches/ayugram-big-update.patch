+}
diff --git a/submodules/SettingsUI/Sources/AyuBackup.swift b/submodules/SettingsUI/Sources/AyuBackup.swift
new file mode 100644
index 00000000..3c24b434
--- /dev/null
+++ b/submodules/SettingsUI/Sources/AyuBackup.swift
@@ -0,0 +1,102 @@
+import Foundation
+import UIKit
+import CryptoKit
+import UniformTypeIdentifiers
+import SwiftSignalKit
+import TelegramCore
+import AccountContext
+
+/// Encrypted backup of AyuGram: its settings, plugins and the saved deleted/edited messages,
+/// sealed with AES-GCM under a key derived from the user's password. Restoring brings back
+/// settings and plugins (the message history stays in the file for reading).
+enum AyuBackup {
+    private static let magic = Data("AYUBK1".utf8)
+    /// Keys that must never travel: decoy codes and their salt, the broken mark.
+    private static let excludedPrefixes = ["ayu.decoy."]
+
+    private static func key(password: String, salt: Data) -> SymmetricKey {
+        let base = SymmetricKey(data: SHA256.hash(data: Data(password.utf8)))
+        return HKDF<SHA256>.deriveKey(inputKeyMaterial: base, salt: salt, info: Data("AyuGram backup".utf8), outputByteCount: 32)
+    }
+
+    static func make(context: AccountContext, password: String, completion: @escaping (URL?) -> Void) {
+        var defaults: [String: Any] = [:]
+        for (key, value) in UserDefaults.standard.dictionaryRepresentation() where key.hasPrefix("ayu.") && !excludedPrefixes.contains(where: { key.hasPrefix($0) }) {
+            if JSONSerialization.isValidJSONObject([key: value]) {
+                defaults[key] = value
+            } else if let data = value as? Data {
+                defaults[key] = ["$data": data.base64EncodedString()]
+            }
+        }
+        let plugins = AyuScriptRuntime.shared.exportPlugins().map { ["filename": $0.filename, "data": $0.data.base64EncodedString(), "enabled": $0.enabled] as [String: Any] }
+        let _ = (context.engine.messages.ayuExportHistory()
+        |> deliverOnMainQueue).startStandalone(next: { history in
+            var payload: [String: Any] = ["format": "ayugram-backup", "version": 1, "created": Int(Date().timeIntervalSince1970), "defaults": defaults, "plugins": plugins]
+            if let history, let records = try? JSONSerialization.jsonObject(with: history) {
+                payload["history"] = records
+            }
+            guard let plain = try? JSONSerialization.data(withJSONObject: payload) else { return completion(nil) }
+            var salt = Data(count: 16)
+            let status = salt.withUnsafeMutableBytes { SecRandomCopyBytes(kSecRandomDefault, 16, $0.baseAddress!) }
+            guard status == errSecSuccess, let sealed = try? AES.GCM.seal(plain, using: key(password: password, salt: salt)).combined else { return completion(nil) }
+            let formatter = DateFormatter()
+            formatter.dateFormat = "yyyy-MM-dd"
+            let url = FileManager.default.temporaryDirectory.appendingPathComponent("AyuGram-backup-\(formatter.string(from: Date())).ayubackup")
+            do {
+                try (magic + salt + sealed).write(to: url, options: .atomic)
+                completion(url)
+            } catch {
+                completion(nil)
+            }
+        })
+    }
+
+    /// Restores settings and plugins; returns how many plugins came back, or nil for a wrong password.
+    static func restore(data: Data, password: String) -> Int? {
+        guard data.count > magic.count + 16, data.prefix(magic.count) == magic else { return nil }
+        let salt = data.subdata(in: magic.count ..< magic.count + 16)
+        let sealed = data.subdata(in: magic.count + 16 ..< data.count)
+        guard let box = try? AES.GCM.SealedBox(combined: sealed),
+              let plain = try? AES.GCM.open(box, using: key(password: password, salt: salt)),
+              let payload = try? JSONSerialization.jsonObject(with: plain) as? [String: Any], payload["format"] as? String == "ayugram-backup" else { return nil }
+        for (key, value) in payload["defaults"] as? [String: Any] ?? [:] where key.hasPrefix("ayu.") && !excludedPrefixes.contains(where: { key.hasPrefix($0) }) {
+            if let wrapped = value as? [String: Any], let encoded = wrapped["$data"] as? String, let data = Data(base64Encoded: encoded) {
+                UserDefaults.standard.set(data, forKey: key)
+            } else {
+                UserDefaults.standard.set(value, forKey: key)
+            }
+        }
+        var restored = 0
+        for item in payload["plugins"] as? [[String: Any]] ?? [] {
+            guard let filename = item["filename"] as? String, let encoded = item["data"] as? String, let data = Data(base64Encoded: encoded) else { continue }
+            if let plugin = try? AyuScriptRuntime.shared.install(data, filename: filename, official: false, acceptedRisk: AyuDeveloperSettings.unlocked) {
+                restored += 1
+                if item["enabled"] as? Bool == false {
+                    AyuScriptRuntime.shared.setEnabled(plugin.id, false)
+                }
+            }
+        }
+        return restored
+    }
+}
+
+/// Picks a backup file to restore.
+final class AyuBackupPicker: NSObject, UIDocumentPickerDelegate {
+    static var current: AyuBackupPicker?
+    let picked: (Data) -> Void
+
+    init(picked: @escaping (Data) -> Void) {
+        self.picked = picked
+    }
+
+    func documentPicker(_ controller: UIDocumentPickerViewController, didPickDocumentsAt urls: [URL]) {
+        if let url = urls.first, let data = try? Data(contentsOf: url) {
+            self.picked(data)
+        }
+        AyuBackupPicker.current = nil
+    }
+
+    func documentPickerWasCancelled(_ controller: UIDocumentPickerViewController) {
+        AyuBackupPicker.current = nil
+    }
+}
