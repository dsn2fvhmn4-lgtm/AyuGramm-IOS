new file mode 100644
index 00000000..8e070628
--- /dev/null
+++ b/submodules/TelegramUI/Sources/AyuPlayerDebugOverlay.swift
@@ -0,0 +1,102 @@
+import Foundation
+import UIKit
+import TelegramCore
+import UniversalMediaPlayer
+
+/// Developer-only playback diagnostics shown in the music player's bottom-right corner.
+/// Enabled from Settings → AyuGram → Developer; hidden and idle otherwise.
+final class AyuPlayerDebugOverlay: UIView {
+    private let label = UILabel()
+    private var events: [String] = []
+    private var lastRender: Double = 0.0
+    private var frameTimes: [Double] = []
+    private var observer: NSObjectProtocol?
+
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+        self.isUserInteractionEnabled = false
+        self.backgroundColor = UIColor(white: 0.0, alpha: 0.55)
+        self.layer.cornerRadius = 8.0
+        self.layer.borderWidth = 0.5
+        self.layer.borderColor = UIColor(white: 1.0, alpha: 0.2).cgColor
+        self.label.numberOfLines = 0
+        self.label.font = UIFont.monospacedSystemFont(ofSize: 9.0, weight: .medium)
+        self.label.textColor = UIColor(red: 0.6, green: 1.0, blue: 0.7, alpha: 1.0)
+        self.addSubview(self.label)
+        self.accessibilityElementsHidden = true
+        self.observer = NotificationCenter.default.addObserver(forName: AyuDeveloperSettings.didChangeNotification, object: nil, queue: .main, using: { [weak self] _ in
+            guard let self else { return }
+            self.isHidden = !AyuDeveloperSettings.shared.playerDebugOverlay
+            self.superview?.setNeedsLayout()
+        })
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    deinit {
+        if let observer = self.observer {
+            NotificationCenter.default.removeObserver(observer)
+        }
+    }
+
+    func note(_ event: String) {
+        let stamp = String(format: "%.2f", CACurrentMediaTime().truncatingRemainder(dividingBy: 1000.0))
+        self.events.append("\(stamp) \(event)")
+        if self.events.count > 4 {
+            self.events.removeFirst(self.events.count - 4)
+        }
+        AyuDevLog.shared.log("player", event)
+    }
+
+    func update(status: MediaPlayerStatus, timestamp: Double, trackKey: String?, lyricsOffset: Double, haptics: Bool, fps: Double) {
+        let now = CACurrentMediaTime()
+        self.frameTimes.append(now)
+        self.frameTimes.removeAll(where: { now - $0 > 1.0 })
+        // Text layout is the expensive part; four refreshes a second is plenty to read.
+        guard now - self.lastRender > 0.25 else { return }
+        self.lastRender = now
+
+        let state: String
+        switch status.status {
+        case .playing:
+            state = "playing"
+        case .paused:
+            state = "paused"
+        case let .buffering(_, whilePlaying, progress, _):
+            state = String(format: "buffering %@ %.0f%%", whilePlaying ? "(play)" : "(pause)", Double(progress) * 100.0)
+        }
+        var lines: [String] = [
+            "AYU PLAYER DEBUG",
+            "state  \(state)",
+            String(format: "time   %.2f / %.2f", timestamp, status.duration),
+            String(format: "rate   %.2fx  gen %.2f", status.baseRate, status.generationTimestamp),
+            String(format: "fps    %d (target %.0f)", self.frameTimes.count, fps),
+            String(format: "lyrics %+.1fs  haptics %@", lyricsOffset, haptics ? "on" : "off"),
+            "track  \(trackKey.map { String($0.prefix(18)) } ?? "-")"
+        ]
+        lines.append(contentsOf: self.events)
+        self.label.text = lines.joined(separator: "\n")
+        // Grow from the bottom-right corner in place; relaying out the whole player
+        // (artwork, blurred backdrop) four times a second would cost far more.
+        if let superview = self.superview {
+            let size = self.sizeThatFits(superview.bounds.size)
+            if size != self.bounds.size {
+                let corner = CGPoint(x: self.frame.maxX, y: self.frame.maxY)
+                self.frame = CGRect(x: corner.x - size.width, y: corner.y - size.height, width: size.width, height: size.height)
+            }
+        }
+    }
+
+    override func sizeThatFits(_ size: CGSize) -> CGSize {
+        let maxWidth = min(220.0, size.width * 0.6)
+        let fitted = self.label.sizeThatFits(CGSize(width: maxWidth - 12.0, height: .greatestFiniteMagnitude))
+        return CGSize(width: min(maxWidth, ceil(fitted.width) + 12.0), height: ceil(fitted.height) + 10.0)
+    }
+
+    override func layoutSubviews() {
+        super.layoutSubviews()
+        self.label.frame = self.bounds.insetBy(dx: 6.0, dy: 5.0)
+    }
+}
diff --git a/submodules/TelegramUI/Sources/AyuPlayerVisuals.swift b/submodules/TelegramUI/Sources/AyuPlayerVisuals.swift
new file mode 100644
index 00000000..5696876c
--- /dev/null
+++ b/submodules/TelegramUI/Sources/AyuPlayerVisuals.swift
@@ -0,0 +1,240 @@
+import Foundation
+import UIKit
+import Display
+import AccountContext
+import UniversalMediaPlayer
+
+/// The look of the player visualizer: the user's choice, or a plugin's (`ayu.player.visualizer.set`).
+struct AyuPlayerVisualizerStyle: Equatable {
+    enum Kind: String, CaseIterable {
+        case none, bars, mirror, wave, circle, dots
+
+        func title(_ ru: Bool) -> String {
+            switch self {
+            case .none: return ru ? "Выключен" : "Off"
+            case .bars: return ru ? "Столбики" : "Bars"
+            case .mirror: return ru ? "Зеркальные столбики" : "Mirrored bars"
+            case .wave: return ru ? "Волна" : "Wave"
+            case .circle: return ru ? "Круг вокруг обложки" : "Circle around the cover"
+            case .dots: return ru ? "Точки" : "Dots"
+            }
+        }
+    }
+
+    var kind: Kind
+    var color: UIColor
+    var bands: Int
+    var opacity: CGFloat
+    /// Gain applied to the 0…1 levels (sensitivity), 0.5…3.
+    var gain: CGFloat
+
+    static let userKey = "ayu.player.visualizer"
+
+    /// A plugin's style wins over the user's own while the plugin runs.
+    static var current: AyuPlayerVisualizerStyle {
+        if let config = AyuPluginUI.shared.playerVisualizer, let kind = Kind(rawValue: config["style"] as? String ?? "") {
+            let color = (config["color"] as? String).flatMap(AyuCustomization.parse).map { UIColor(rgb: $0) } ?? .white
+            return AyuPlayerVisualizerStyle(kind: kind, color: color, bands: max(8, min(96, (config["bands"] as? NSNumber)?.intValue ?? 32)), opacity: CGFloat(max(0.1, min(1.0, (config["opacity"] as? NSNumber)?.doubleValue ?? 0.85))), gain: CGFloat(max(0.5, min(3.0, (config["gain"] as? NSNumber)?.doubleValue ?? 1.0))))
+        }
+        let kind = AyuDecoyMode.isActive ? .none : (Kind(rawValue: UserDefaults.standard.string(forKey: userKey) ?? "") ?? .none)
+        return AyuPlayerVisualizerStyle(kind: kind, color: .white, bands: 32, opacity: 0.8, gain: 1.0)
+    }
+}
+
+/// Draws the live spectrum (AyuAudioSpectrum) in the player at the display rate. It listens to
+/// the spectrum only while it is on screen and a style is chosen.
+final class AyuPlayerVisualizerView: UIView {
+    private let shape = CAShapeLayer()
+    private var link: CADisplayLink?
+    private var listening = false
+    private var style = AyuPlayerVisualizerStyle.current
+    private var observers: [NSObjectProtocol] = []
+    /// The cover's frame in this view's coordinates; bars sit under it, the circle around it.
+    var artworkFrame: CGRect = .zero {
+        didSet { self.setNeedsLayout() }
+    }
+
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+        self.isUserInteractionEnabled = false
+        self.layer.addSublayer(self.shape)
+        for name in [AyuPluginUI.didChangeNotification, Notification.Name("AyuGram.PlayerVisualizerChanged")] {
+            self.observers.append(NotificationCenter.default.addObserver(forName: name, object: nil, queue: .main, using: { [weak self] _ in
+                self?.restyle()
+            }))
+        }
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    deinit {
+        for observer in self.observers {
+            NotificationCenter.default.removeObserver(observer)
+        }
+        self.link?.invalidate()
+        if self.listening {
+            AyuAudioSpectrum.shared.removeListener()
+        }
+    }
+
+    override func didMoveToWindow() {
+        super.didMoveToWindow()
+        self.restyle()
+    }
+
+    private func restyle() {
+        self.style = AyuPlayerVisualizerStyle.current
+        let wanted = self.window != nil && self.style.kind != .none
+        if wanted && !self.listening {
+            AyuAudioSpectrum.shared.addListener()
+            self.listening = true
+            let link = CADisplayLink(target: AyuDisplayLinkTarget(self), selector: #selector(AyuDisplayLinkTarget.tick))
+            if #available(iOS 15.0, *) {
+                link.preferredFrameRateRange = CAFrameRateRange(minimum: 30.0, maximum: 60.0, preferred: 60.0)
+            }
+            link.add(to: .main, forMode: .common)
+            self.link = link
+        } else if !wanted && self.listening {
+            AyuAudioSpectrum.shared.removeListener()
+            self.listening = false
+            self.link?.invalidate()
+            self.link = nil
+            self.shape.path = nil
+        }
+        self.shape.fillColor = self.style.kind == .wave || self.style.kind == .circle ? UIColor.clear.cgColor : self.style.color.cgColor
+        self.shape.strokeColor = self.style.kind == .wave || self.style.kind == .circle ? self.style.color.cgColor : nil
+        self.shape.lineWidth = 3.0
+        self.shape.lineCap = .round
+        self.shape.lineJoin = .round
+        self.shape.opacity = Float(self.style.opacity)
+    }
+
+    fileprivate func tick() {
+        let levels = AyuAudioSpectrum.shared.bands(count: self.style.bands).map { min(1.0, CGFloat($0) * self.style.gain) }
+        let path = UIBezierPath()
+        let area = self.artworkFrame.isEmpty ? self.bounds.insetBy(dx: 24.0, dy: self.bounds.height * 0.3) : self.artworkFrame
+        switch self.style.kind {
+        case .none:
+            break
+        case .bars, .mirror:
+            let count = CGFloat(levels.count)
+            let gap: CGFloat = 3.0
+            let width = max(1.5, (area.width - gap * (count - 1.0)) / count)
+            let baseline = self.style.kind == .mirror ? area.midY : area.maxY + 64.0
+            let maxHeight = self.style.kind == .mirror ? area.height * 0.45 : 56.0
+            for (index, level) in levels.enumerated() {
+                let height = max(2.0, level * maxHeight)
+                let x = area.minX + CGFloat(index) * (width + gap)
+                let rect = self.style.kind == .mirror ? CGRect(x: x, y: baseline - height, width: width, height: height * 2.0) : CGRect(x: x, y: baseline - height, width: width, height: height)
+                path.append(UIBezierPath(roundedRect: rect, cornerRadius: width / 2.0))
+            }
+        case .wave:
+            let baseline = area.maxY + 40.0
+            for (index, level) in levels.enumerated() {
+                let x = area.minX + area.width * CGFloat(index) / CGFloat(max(1, levels.count - 1))
+                let y = baseline - level * 36.0 * (index % 2 == 0 ? 1.0 : -1.0)
+                if index == 0 { path.move(to: CGPoint(x: x, y: y)) } else { path.addLine(to: CGPoint(x: x, y: y)) }
+            }
+        case .circle:
+            let center = CGPoint(x: area.midX, y: area.midY)
+            let radius = max(area.width, area.height) / 2.0 + 10.0
+            for (index, level) in levels.enumerated() {
+                let angle = CGFloat(index) / CGFloat(levels.count) * 2.0 * .pi - .pi / 2.0
+                let inner = CGPoint(x: center.x + cos(angle) * radius, y: center.y + sin(angle) * radius)
+                let outer = CGPoint(x: center.x + cos(angle) * (radius + 6.0 + level * 34.0), y: center.y + sin(angle) * (radius + 6.0 + level * 34.0))
+                path.move(to: inner)
+                path.addLine(to: outer)
+            }
+        case .dots:
+            let baseline = area.maxY + 64.0
+            for (index, level) in levels.enumerated() {
+                let x = area.minX + area.width * (CGFloat(index) + 0.5) / CGFloat(levels.count)
+                let size = 3.0 + level * 9.0
+                path.append(UIBezierPath(ovalIn: CGRect(x: x - size / 2.0, y: baseline - level * 48.0 - size / 2.0, width: size, height: size)))
+            }
+        }
+        CATransaction.begin()
+        CATransaction.setDisableActions(true)
+        self.shape.frame = self.bounds
+        self.shape.path = path.cgPath
+        CATransaction.commit()
+    }
+}
+
+/// CADisplayLink keeps its target strongly; this breaks the cycle.
+private final class AyuDisplayLinkTarget: NSObject {
+    weak var view: AyuPlayerVisualizerView?
+    init(_ view: AyuPlayerVisualizerView) { self.view = view }
+    @objc func tick() { self.view?.tick() }
+}
+
+/// Shapes plugins draw in the player (`ayu.player.canvas.draw`). Coordinates are 0…1 of the
+/// canvas (the player's content area); colours are hex. Supported: rect, circle, line, text.
+final class AyuPlayerCanvasView: UIView {
+    private var observer: NSObjectProtocol?
+
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+        self.isUserInteractionEnabled = false
+        self.isOpaque = false
+        self.backgroundColor = .clear
+        self.contentMode = .redraw
+        self.observer = NotificationCenter.default.addObserver(forName: AyuPluginUI.didChangeNotification, object: nil, queue: .main, using: { [weak self] _ in
+            self?.setNeedsDisplay()
+        })
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    deinit {
+        if let observer = self.observer {
+            NotificationCenter.default.removeObserver(observer)
+        }
+    }
+
+    private static func color(_ value: Any?, _ fallback: UIColor) -> UIColor {
+        guard let text = value as? String, let rgb = AyuCustomization.parse(text) else { return fallback }
+        return UIColor(rgb: rgb)
+    }
+
+    override func draw(_ rect: CGRect) {
+        guard !AyuDecoyMode.isActive, let context = UIGraphicsGetCurrentContext() else { return }
+        let size = self.bounds.size
+        func number(_ item: [String: Any], _ key: String, _ fallback: CGFloat = 0.0) -> CGFloat {
+            return CGFloat((item[key] as? NSNumber)?.doubleValue ?? Double(fallback))
+        }
+        for item in AyuPluginUI.shared.playerCanvas.prefix(500) {
+            let color = AyuPlayerCanvasView.color(item["color"], .white)
+            let alpha = number(item, "alpha", 1.0)
+            let frame = CGRect(x: number(item, "x") * size.width, y: number(item, "y") * size.height, width: number(item, "w") * size.width, height: number(item, "h") * size.height)
+            context.saveGState()
+            context.setAlpha(max(0.0, min(1.0, alpha)))
+            switch item["type"] as? String {
+            case "rect":
+                color.setFill()
+                UIBezierPath(roundedRect: frame, cornerRadius: number(item, "radius")).fill()
+            case "circle":
+                color.setFill()
+                UIBezierPath(ovalIn: frame).fill()
+            case "line":
+                color.setStroke()
+                let path = UIBezierPath()
+                path.move(to: CGPoint(x: number(item, "x") * size.width, y: number(item, "y") * size.height))
+                path.addLine(to: CGPoint(x: number(item, "x2") * size.width, y: number(item, "y2") * size.height))
+                path.lineWidth = max(0.5, min(20.0, number(item, "width", 2.0)))
+                path.lineCapStyle = .round
+                path.stroke()
+            case "text":
+                let text = String((item["text"] as? String ?? "").prefix(200)) as NSString
+                text.draw(at: frame.origin, withAttributes: [.font: UIFont.systemFont(ofSize: max(6.0, min(64.0, number(item, "size", 15.0))), weight: .semibold), .foregroundColor: color])
+            default:
+                break
+            }
+            context.restoreGState()
+        }
+    }
+}
diff --git a/submodules/TelegramUI/Sources/AyuPluginAppServices.swift b/submodules/TelegramUI/Sources/AyuPluginAppServices.swift
new file mode 100644
index 00000000..6380880c
--- /dev/null
+++ b/submodules/TelegramUI/Sources/AyuPluginAppServices.swift
@@ -0,0 +1,330 @@
+import Foundation
+import UIKit
+import SwiftSignalKit
+import Display
+import TelegramCore
+import AccountContext
+import SettingsUI
+import ChatInterfaceState
+import ChatPresentationInterfaceState
+import ChatControllerInteraction
+
+/// AyuGram "Undo send": messages wait a few seconds with an Undo button before they are enqueued.
+enum AyuUndoSend {
+    static let key = "ayu.extra.undoSendSeconds"
+    static let steps = [0, 3, 5, 7, 10]
+    /// Set while the delayed messages are finally sent, so they are not delayed again.
+    static var bypass = false
+
+    static var seconds: Int {
+        return AyuDecoyMode.isActive ? 0 : UserDefaults.standard.integer(forKey: key)
+    }
+}
+
+/// The chat on screen, for `ayu.composer.setText`.
+enum AyuPluginChatTracker {
+    static weak var current: ChatControllerImpl?
+}
+
+extension ChatControllerImpl {
+    /// Replaces the selected text; with no selection, the whole draft.
+    func ayuReplaceSelection(_ text: String) {
+        self.updateChatPresentationInterfaceState(animated: true, interactive: true, { state in
+            return state.updatedInterfaceState { interfaceState in
+                let input = interfaceState.effectiveInputState
+                let range = input.selectionRange
+                let length = input.inputText.length
+                let target = range.isEmpty || range.upperBound > length ? NSRange(location: 0, length: length) : NSRange(location: range.lowerBound, length: range.count)
+                return interfaceState.withUpdatedEffectiveInputState(input.replacingFlatRange(target, with: text))
+            }.updatedInputMode({ _ in .text })
+        })
+    }
+
+    func ayuSetInputText(_ text: String) {
+        self.updateChatPresentationInterfaceState(animated: true, interactive: true, { state in
+            return state.updatedInterfaceState { interfaceState in
+                return interfaceState.withUpdatedEffectiveInputState(ChatTextInputState(inputText: NSAttributedString(string: text)))
+            }.updatedInputMode({ _ in .text })
+        })
+    }
+}
+
+/// A page a plugin describes (`ayu.screens.show`): sections of text, value, link, button and
+/// toggle rows. Taps go back to the plugin as `screenAction` { screenId, rowId, value }.
+final class AyuPluginScreenController: UITableViewController {
+    private struct Row {
+        let id: String
+        let type: String
+        let title: String
+        let subtitle: String?
+        var value: Any?
+        let url: String?
+    }
+
+    private struct Section {
+        let title: String?
+        let footer: String?
+        var rows: [Row]
+    }
+
+    private let owner: String
+    private let screenId: String
+    private var sections: [Section] = []
+    private let openUrl: (String) -> Void
+
+    init(owner: String, screen: [String: Any], openUrl: @escaping (String) -> Void) {
+        self.owner = owner
+        self.screenId = String(((screen["id"] as? String) ?? "screen").prefix(64))
+        self.openUrl = openUrl
+        super.init(style: .insetGrouped)
+        self.title = String(((screen["title"] as? String) ?? "").prefix(60))
+        for rawSection in (screen["sections"] as? [[String: Any]] ?? []).prefix(20) {
+            var rows: [Row] = []
+            for rawRow in (rawSection["rows"] as? [[String: Any]] ?? []).prefix(50) {
+                rows.append(Row(id: String(((rawRow["id"] as? String) ?? "").prefix(64)), type: (rawRow["type"] as? String) ?? "text", title: String(((rawRow["title"] as? String) ?? "").prefix(120)), subtitle: (rawRow["subtitle"] as? String).map { String($0.prefix(300)) }, value: rawRow["value"], url: rawRow["url"] as? String))
+            }
+            self.sections.append(Section(title: (rawSection["title"] as? String).map { String($0.prefix(60)) }, footer: (rawSection["footer"] as? String).map { String($0.prefix(500)) }, rows: rows))
+        }
+        self.navigationItem.rightBarButtonItem = UIBarButtonItem(barButtonSystemItem: .done, target: self, action: #selector(self.close))
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    @objc private func close() {
+        self.dismiss(animated: true)
+    }
+
+    private func send(_ row: Row, value: Any?) {
+        AyuPluginUI.send("screenAction", to: self.owner, ["screenId": self.screenId, "rowId": row.id, "value": value ?? NSNull()])
+    }
+
+    override func numberOfSections(in tableView: UITableView) -> Int {
+        return self.sections.count
+    }
+
+    override func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int {
+        return self.sections[section].rows.count
+    }
+
+    override func tableView(_ tableView: UITableView, titleForHeaderInSection section: Int) -> String? {
+        return self.sections[section].title
+    }
+
+    override func tableView(_ tableView: UITableView, titleForFooterInSection section: Int) -> String? {
+        return self.sections[section].footer
+    }
+
+    override func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
+        let row = self.sections[indexPath.section].rows[indexPath.row]
+        let cell = UITableViewCell(style: row.type == "value" ? .value1 : .subtitle, reuseIdentifier: nil)
+        cell.textLabel?.text = row.title
+        cell.textLabel?.numberOfLines = 0
+        cell.detailTextLabel?.text = row.type == "value" ? (row.value.map { "\($0)" } ?? row.subtitle) : row.subtitle
+        cell.detailTextLabel?.numberOfLines = 0
+        switch row.type {
+        case "toggle":
+            let toggle = UISwitch()
+            toggle.isOn = (row.value as? Bool) ?? false
+            toggle.tag = indexPath.section * 1000 + indexPath.row
+            toggle.addTarget(self, action: #selector(self.toggleChanged(_:)), for: .valueChanged)
+            cell.accessoryView = toggle
+            cell.selectionStyle = .none
+        case "button":
+            cell.textLabel?.textColor = tableView.tintColor
+        case "link":
+            cell.accessoryType = .disclosureIndicator
+        default:
+            cell.selectionStyle = .none
+        }
+        return cell
+    }
+
+    @objc private func toggleChanged(_ sender: UISwitch) {
+        let section = sender.tag / 1000
+        let index = sender.tag % 1000
+        guard section < self.sections.count, index < self.sections[section].rows.count else { return }
+        self.sections[section].rows[index].value = sender.isOn
+        self.send(self.sections[section].rows[index], value: sender.isOn)
+    }
+
+    override func tableView(_ tableView: UITableView, didSelectRowAt indexPath: IndexPath) {
+        tableView.deselectRow(at: indexPath, animated: true)
+        let row = self.sections[indexPath.section].rows[indexPath.row]
+        if row.type == "link", let url = row.url, url.lowercased().hasPrefix("https://") {
+            self.openUrl(url)
+        } else if row.type == "button" || row.type == "link" {
+            self.send(row, value: nil)
+        }
+    }
+}
