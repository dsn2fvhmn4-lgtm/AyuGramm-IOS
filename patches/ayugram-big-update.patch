+import Foundation
+import UIKit
+
+/// Media & Calls settings (video messages, camera, watermark, calls, voice) shared by the
+/// settings screens and the recording code. UserDefaults under "ayu.media.*".
+public enum AyuMediaSettings {
+    public static let didChangeNotification = Notification.Name("AyuGram.MediaSettingsChanged")
+    private static func key(_ name: String) -> String { return "ayu.media." + name }
+
+    private static func string(_ name: String) -> String? {
+        return AyuDecoyMode.isActive ? nil : UserDefaults.standard.string(forKey: key(name))
+    }
+
+    private static func set(_ value: Any?, _ name: String) {
+        UserDefaults.standard.set(value, forKey: key(name))
+        NotificationCenter.default.post(name: didChangeNotification, object: nil)
+    }
+
+    // MARK: Video message masks
+
+    public enum Mask: String, CaseIterable {
+        case none, pixelatedFace, blurredFace, emojiFace, comic, noir, thermal, sketch
+
+        public func title(_ ru: Bool) -> String {
+            switch self {
+            case .none: return ru ? "Без маски" : "No mask"
+            case .pixelatedFace: return ru ? "Пиксели на лице" : "Pixelated face"
+            case .blurredFace: return ru ? "Размытое лицо" : "Blurred face"
+            case .emojiFace: return ru ? "Эмодзи вместо лица" : "Emoji face"
+            case .comic: return ru ? "Комикс" : "Comic"
+            case .noir: return ru ? "Нуар" : "Noir"
+            case .thermal: return ru ? "Тепловизор" : "Thermal"
+            case .sketch: return ru ? "Набросок" : "Sketch"
+            }
+        }
+    }
+
+    public static var masksEnabled: Bool {
+        get { return !AyuDecoyMode.isActive && UserDefaults.standard.bool(forKey: key("masks")) }
+        set { set(newValue, "masks") }
+    }
+
+    public static var mask: Mask {
+        get { return masksEnabled ? (Mask(rawValue: string("mask") ?? "") ?? .none) : .none }
+        set { set(newValue.rawValue, "mask") }
+    }
+
+    public static var maskEmoji: String {
+        get { return string("maskEmoji") ?? "😎" }
+        set { set(String(newValue.prefix(4)), "maskEmoji") }
+    }
+
+    /// Mask studio: an ordered list of Core Image filter layers, e.g. ["CIPhotoEffectNoir", "CIBloom"].
+    public static var studioLayers: [String] {
+        get { return AyuDecoyMode.isActive ? [] : (UserDefaults.standard.stringArray(forKey: key("studio")) ?? []) }
+        set { set(Array(newValue.prefix(8)), "studio") }
+    }
+
+    public static let studioFilters: [(name: String, ru: String, en: String)] = [
+        ("CIPhotoEffectNoir", "Ч/б", "Black & white"), ("CIPhotoEffectChrome", "Хром", "Chrome"),
+        ("CIPhotoEffectInstant", "Полароид", "Instant"), ("CISepiaTone", "Сепия", "Sepia"),
+        ("CIComicEffect", "Комикс", "Comic"), ("CIBloom", "Свечение", "Bloom"),
+        ("CIVignette", "Виньетка", "Vignette"), ("CIColorInvert", "Инверсия", "Invert"),
+        ("CIPixellate", "Пиксели", "Pixels"), ("CIGaussianBlur", "Размытие", "Blur"),
+        ("CIFalseColor", "Тепловизор", "Thermal"), ("CILineOverlay", "Набросок", "Sketch")
+    ]
+
+    // MARK: Video message quality
+
+    /// Side in pixels; 0 = as in Telegram.
+    public static var resolution: Int {
+        get { return AyuDecoyMode.isActive ? 0 : UserDefaults.standard.integer(forKey: key("resolution")) }
+        set { set(newValue, "resolution") }
+    }
+
+    /// Bits per second; 0 = as in Telegram.
+    public static var bitrate: Int {
+        get { return AyuDecoyMode.isActive ? 0 : UserDefaults.standard.integer(forKey: key("bitrate")) }
+        set { set(newValue, "bitrate") }
+    }
+
+    public static var hevc: Bool {
+        get { return !AyuDecoyMode.isActive && UserDefaults.standard.bool(forKey: key("hevc")) }
+        set { set(newValue, "hevc") }
+    }
+
+    public static var sixtyFps: Bool {
+        get { return !AyuDecoyMode.isActive && UserDefaults.standard.bool(forKey: key("fps60")) }
+        set { set(newValue, "fps60") }
+    }
+
+    public enum Stabilization: String, CaseIterable {
+        case off, standard, cinematic
+        public func title(_ ru: Bool) -> String {
+            switch self {
+            case .off: return ru ? "Выключена" : "Off"
+            case .standard: return ru ? "Стандартная" : "Standard"
+            case .cinematic: return ru ? "Кинематографическая" : "Cinematic"
+            }
+        }
+    }
+
+    public static var stabilization: Stabilization {
+        get { return Stabilization(rawValue: string("stabilization") ?? "") ?? .standard }
+        set { set(newValue.rawValue, "stabilization") }
+    }
+
+    // MARK: Camera
+
+    public static var startWithRearCamera: Bool {
+        get { return !AyuDecoyMode.isActive && UserDefaults.standard.bool(forKey: key("rear")) }
+        set { set(newValue, "rear") }
+    }
+
+    public static var startingZoom: Double {
+        get { let value = UserDefaults.standard.double(forKey: key("zoom")); return AyuDecoyMode.isActive || value < 1.0 ? 1.0 : value }
+        set { set(max(1.0, min(5.0, newValue)), "zoom") }
+    }
+
+    public static var sendAsVideoMessageInPicker: Bool {
+        get { return !AyuDecoyMode.isActive && UserDefaults.standard.bool(forKey: key("pickerRound")) }
+        set { set(newValue, "pickerRound") }
+    }
+
+    public static var noLivePreview: Bool {
+        get { return !AyuDecoyMode.isActive && UserDefaults.standard.bool(forKey: key("noLivePreview")) }
+        set { set(newValue, "noLivePreview") }
+    }
+
+    // MARK: Photo watermark
+
+    public static var watermarkEnabled: Bool {
+        get { return !AyuDecoyMode.isActive && UserDefaults.standard.bool(forKey: key("watermark")) && !watermarkText.isEmpty }
+        set { set(newValue, "watermark") }
+    }
+
+    public static var watermarkText: String {
+        get { return string("watermarkText") ?? "" }
+        set { set(String(newValue.prefix(60)), "watermarkText") }
+    }
+
+    /// Draws the watermark in the bottom-right corner of an outgoing photo.
+    public static func watermarked(_ image: UIImage) -> UIImage {
+        guard watermarkEnabled else { return image }
+        let text = watermarkText as NSString
+        let size = image.size
+        let fontSize = max(12.0, min(size.width, size.height) * 0.035)
+        let attributes: [NSAttributedString.Key: Any] = [
+            .font: UIFont.systemFont(ofSize: fontSize, weight: .semibold),
+            .foregroundColor: UIColor.white.withAlphaComponent(0.85),
+            .strokeColor: UIColor.black.withAlphaComponent(0.35),
+            .strokeWidth: -2.0
+        ]
+        let textSize = text.size(withAttributes: attributes)
+        let format = UIGraphicsImageRendererFormat()
+        format.scale = image.scale
+        return UIGraphicsImageRenderer(size: size, format: format).image { _ in
+            image.draw(in: CGRect(origin: .zero, size: size))
+            text.draw(at: CGPoint(x: size.width - textSize.width - fontSize, y: size.height - textSize.height - fontSize * 0.8), withAttributes: attributes)
+        }
+    }
+
+    // MARK: Voice
+
+    public enum Bleep: String, CaseIterable {
+        case off, beep, silence
+        public func title(_ ru: Bool) -> String {
+            switch self {
+            case .off: return ru ? "Выключено" : "Off"
+            case .beep: return ru ? "Бип" : "Beep"
+            case .silence: return ru ? "Тишина" : "Silence"
+            }
+        }
+    }
+
+    /// Profanity in voice and video messages is covered by a beep or silence.
+    public static var bleep: Bleep {
+        get { return Bleep(rawValue: string("bleep") ?? "") ?? .off }
+        set { set(newValue.rawValue, "bleep") }
+    }
+
+    /// Voice message equalizer: gain in dB for low, mid and high bands (-12…12).
+    public static var voiceEqualizer: [Double] {
+        get {
+            let values = (UserDefaults.standard.array(forKey: key("voiceEq")) as? [Double]) ?? [0, 0, 0]
+            return AyuDecoyMode.isActive || values.count != 3 ? [0, 0, 0] : values
+        }
+        set { set(newValue.prefix(3).map { max(-12.0, min(12.0, $0)) }, "voiceEq") }
+    }
+
+    // MARK: Calls
+
+    public static var silentMute: Bool {
+        get { return !AyuDecoyMode.isActive && UserDefaults.standard.bool(forKey: key("silentMute")) }
+        set { set(newValue, "silentMute") }
+    }
+
+    public static var callStatistics: Bool {
+        get { return !AyuDecoyMode.isActive && UserDefaults.standard.bool(forKey: key("callStats")) }
+        set { set(newValue, "callStats") }
+    }
+
+    public static var recordCalls: Bool {
+        get { return !AyuDecoyMode.isActive && UserDefaults.standard.bool(forKey: key("recordCalls")) }
+        set { set(newValue, "recordCalls") }
+    }
+
+    // MARK: Anonymous mode
+
+    /// One tap: a face mask on video messages and a changed voice, restored when turned off.
+    public static var anonymousMode: Bool {
+        return !AyuDecoyMode.isActive && UserDefaults.standard.bool(forKey: key("anonymous"))
+    }
+
+    public static func setAnonymousMode(_ value: Bool) {
+        let defaults = UserDefaults.standard
+        if value {
+            defaults.set(UserDefaults.standard.bool(forKey: key("masks")), forKey: key("anonymous.masks"))
+            defaults.set(defaults.string(forKey: key("mask")), forKey: key("anonymous.mask"))
+            defaults.set(AyuTools.voice.rawValue, forKey: key("anonymous.voice"))
+            defaults.set(true, forKey: key("masks"))
+            defaults.set(Mask.pixelatedFace.rawValue, forKey: key("mask"))
+            AyuTools.voice = .low
+        } else if anonymousMode {
+            defaults.set(defaults.bool(forKey: key("anonymous.masks")), forKey: key("masks"))
+            defaults.set(defaults.string(forKey: key("anonymous.mask")), forKey: key("mask"))
+            AyuTools.voice = AyuTools.Voice(rawValue: defaults.string(forKey: key("anonymous.voice")) ?? "") ?? .off
+        }
+        set(value, "anonymous")
+    }
+}
diff --git a/submodules/Display/Source/AyuOverlayEffects.swift b/submodules/Display/Source/AyuOverlayEffects.swift
new file mode 100644
index 00000000..c26d9b92
--- /dev/null
+++ b/submodules/Display/Source/AyuOverlayEffects.swift
@@ -0,0 +1,526 @@
+import Foundation
+import UIKit
+
+/// Decorations drawn over the whole app: falling snow, autumn leaves, rain, stars, confetti, and
+/// plugin text overlays. Particles come from `CAEmitterLayer`, rendered by the system without
+/// per-frame app work. Nothing here takes touches. Reduce Motion pauses everything.
+public final class AyuOverlayEffects {
+    public enum Effect: String, CaseIterable {
+        case none
+        case snow
+        case leaves
+        case rain
+        case stars
+        case confetti
+
+        public func title(_ russian: Bool) -> String {
+            switch self {
+            case .none: return russian ? "Выключено" : "Off"
+            case .snow: return russian ? "Снег" : "Snow"
+            case .leaves: return russian ? "Осенние листья" : "Autumn leaves"
+            case .rain: return russian ? "Дождь" : "Rain"
+            case .stars: return russian ? "Звёзды" : "Stars"
+            case .confetti: return russian ? "Конфетти" : "Confetti"
+            }
+        }
+    }
+
+    /// One layer of falling particles.
+    public struct Particles: Equatable {
+        public var effect: Effect
+        /// 0.1…3: how many at once.
+        public var amount: Double
+        /// 0.2…3: how fast they fall.
+        public var speed: Double
+        public var color: UIColor?
+
+        public init(effect: Effect, amount: Double = 1.0, speed: Double = 1.0, color: UIColor? = nil) {
+            self.effect = effect
+            self.amount = amount
+            self.speed = speed
+            self.color = color
+        }
+    }
+
+    public static let shared = AyuOverlayEffects()
+    public static let didChangeNotification = Notification.Name("AyuGram.OverlayEffectsChanged")
+
+    private let rootView = AyuPassthroughView()
+    private var emitters: [String: CAEmitterLayer] = [:]
+    private var particles: [String: Particles] = [:]
+    private var labels: [String: UILabel] = [:]
+    private var clocks: [String: Timer] = [:]
+    private var fpsCounters: [String: AyuFPSCounter] = [:]
+    private var buttons: [String: AyuFloatingButton] = [:]
+    private var observers: [NSObjectProtocol] = []
+
+    private init() {
+        // Touches reach only floating buttons (see AyuPassthroughView.hitTest).
+        self.rootView.isUserInteractionEnabled = true
+        self.rootView.backgroundColor = .clear
+        self.rootView.autoresizingMask = [.flexibleWidth, .flexibleHeight]
+        for name in [UIAccessibility.reduceMotionStatusDidChangeNotification, UIApplication.didBecomeActiveNotification] {
+            self.observers.append(NotificationCenter.default.addObserver(forName: name, object: nil, queue: .main, using: { [weak self] _ in
+                self?.relayout()
+            }))
+        }
+    }
+
+    // MARK: Settings (Settings → AyuGram → Appearance+ → Effects)
+
+    private static let key = "ayu.overlay."
+
+    public static var effect: Effect {
+        get { return AyuDecoyMode.isActive ? .none : (Effect(rawValue: UserDefaults.standard.string(forKey: key + "effect") ?? "") ?? .none) }
+        set { UserDefaults.standard.set(newValue.rawValue, forKey: key + "effect"); AyuOverlayEffects.shared.applySettings() }
+    }
+
+    public static var amount: Double {
+        get { let value = UserDefaults.standard.double(forKey: key + "amount"); return value > 0 ? value : 1.0 }
+        set { UserDefaults.standard.set(max(0.1, min(3.0, newValue)), forKey: key + "amount"); AyuOverlayEffects.shared.applySettings() }
+    }
+
+    public static var speed: Double {
+        get { let value = UserDefaults.standard.double(forKey: key + "speed"); return value > 0 ? value : 1.0 }
+        set { UserDefaults.standard.set(max(0.2, min(3.0, newValue)), forKey: key + "speed"); AyuOverlayEffects.shared.applySettings() }
+    }
+
+    /// The user's own effect, kept apart from plugin overlays.
+    public func applySettings() {
+        // Snow is drawn in the chat background, under the messages (AyuChatBackgroundSnowView).
+        if AyuOverlayEffects.effect == .none || AyuOverlayEffects.effect == .snow {
+            self.removeParticles(id: "ayu.settings")
+        } else {
+            self.setParticles(id: "ayu.settings", Particles(effect: AyuOverlayEffects.effect, amount: AyuOverlayEffects.amount, speed: AyuOverlayEffects.speed))
+        }
+        NotificationCenter.default.post(name: AyuOverlayEffects.didChangeNotification, object: nil)
+        NotificationCenter.default.post(name: AyuAppearancePlus.didChangeNotification, object: nil)
+    }
+
+    // MARK: Hosting
+
+    public func attach(to container: UIView) {
+        if self.rootView.superview !== container {
+            self.rootView.frame = container.bounds
+            container.addSubview(self.rootView)
+        }
+        container.bringSubviewToFront(self.rootView)
+        self.applySettings()
+    }
+
+    // MARK: Particles
+
+    public func setParticles(id: String, _ value: Particles) {
+        DispatchQueue.main.async {
+            self.particles[id] = value
+            self.emitters[id]?.removeFromSuperlayer()
+            self.emitters[id] = nil
+            guard value.effect != .none else { return }
+            let emitter = CAEmitterLayer()
+            emitter.emitterShape = .line
+            emitter.renderMode = .unordered
+            emitter.emitterCells = [self.cell(value)]
+            self.emitters[id] = emitter
+            self.rootView.layer.addSublayer(emitter)
+            self.relayout()
+        }
+    }
+
+    public func removeParticles(id: String) {
+        DispatchQueue.main.async {
+            self.particles[id] = nil
+            self.emitters.removeValue(forKey: id)?.removeFromSuperlayer()
+        }
+    }
+
+    // MARK: Text overlays
+
+    /// Text pinned to a corner or the centre of the screen.
+    public func setText(id: String, text: String, anchor: String, color: UIColor?, size: CGFloat) {
+        DispatchQueue.main.async {
+            let label = self.labels[id] ?? UILabel()
+            label.text = String(text.prefix(200))
+            label.numberOfLines = 3
+            label.font = .systemFont(ofSize: max(8.0, min(48.0, size)), weight: .semibold)
+            label.textColor = color ?? .white
+            label.layer.shadowColor = UIColor.black.cgColor
+            label.layer.shadowOpacity = 0.5
+            label.layer.shadowRadius = 2.0
+            label.layer.shadowOffset = .zero
+            label.accessibilityIdentifier = anchor
+            if label.superview == nil { self.rootView.addSubview(label) }
+            self.labels[id] = label
+            self.relayout()
+        }
+    }
+
+    public func removeText(id: String) {
+        DispatchQueue.main.async {
+            self.labels.removeValue(forKey: id)?.removeFromSuperview()
+            self.clocks.removeValue(forKey: id)?.invalidate()
+            self.fpsCounters.removeValue(forKey: id)?.stop()
+        }
+    }
+
+    /// A live clock (DateFormatter format, "HH:mm:ss" by default) pinned like a text overlay.
+    public func setClock(id: String, format: String, anchor: String, color: UIColor?, size: CGFloat) {
+        let formatter = DateFormatter()
+        formatter.dateFormat = format.isEmpty ? "HH:mm:ss" : format
+        self.setText(id: id, text: formatter.string(from: Date()), anchor: anchor.isEmpty ? "topRight" : anchor, color: color, size: size)
+        DispatchQueue.main.async { [weak self] in
+            guard let self else { return }
+            self.clocks[id]?.invalidate()
+            let timer = Timer(timeInterval: 1.0, repeats: true, block: { [weak self] _ in
+                guard let self, let label = self.labels[id] else { return }
+                label.text = formatter.string(from: Date())
+            })
+            timer.tolerance = 0.2
+            RunLoop.main.add(timer, forMode: .common)
+            self.clocks[id] = timer
+        }
+    }
+
+    /// A live frames-per-second counter pinned like a text overlay (`ayu.ui.overlay.showFPS`).
+    public func setFPS(id: String, anchor: String, color: UIColor?, size: CGFloat) {
+        self.setText(id: id, text: "— FPS", anchor: anchor.isEmpty ? "topLeft" : anchor, color: color, size: size)
+        DispatchQueue.main.async { [weak self] in
+            guard let self else { return }
+            self.fpsCounters[id]?.stop()
+            let counter = AyuFPSCounter(update: { [weak self] fps in
+                self?.labels[id]?.text = "\(fps) FPS"
+            })
+            self.fpsCounters[id] = counter
+        }
+    }
+
+    // MARK: Floating buttons, progress and one-shot animations
+
+    /// A round button over the app, bottom-right by default (`ayu.ui.floatingButton.add`).
+    public func setFloatingButton(id: String, symbol: String, title: String, anchor: String, color: UIColor?, tap: @escaping () -> Void) {
+        DispatchQueue.main.async {
+            self.buttons[id]?.removeFromSuperview()
+            let button = AyuFloatingButton(type: .system)
+            var configuration = UIButton.Configuration.filled()
+            configuration.cornerStyle = .capsule
+            configuration.image = UIImage(systemName: symbol.isEmpty ? "puzzlepiece.extension.fill" : symbol)
+            configuration.title = title.isEmpty ? nil : String(title.prefix(20))
+            configuration.imagePadding = 6.0
+            configuration.baseBackgroundColor = color ?? .systemBlue
+            button.configuration = configuration
+            button.accessibilityIdentifier = anchor.isEmpty ? "bottomRight" : anchor
+            button.addAction(UIAction(handler: { _ in tap() }), for: .touchUpInside)
+            button.layer.shadowColor = UIColor.black.cgColor
+            button.layer.shadowOpacity = 0.25
+            button.layer.shadowRadius = 6.0
+            button.layer.shadowOffset = CGSize(width: 0.0, height: 2.0)
+            self.rootView.addSubview(button)
+            self.buttons[id] = button
+            self.relayout()
+        }
+    }
+
+    public func removeFloatingButton(id: String) {
+        DispatchQueue.main.async {
+            self.buttons.removeValue(forKey: id)?.removeFromSuperview()
+        }
+    }
+
+    /// A progress line ("Title ▓▓▓▓░░░░ 50%") pinned like a text overlay; nil value hides it.
+    public func setProgress(id: String, title: String, value: Double?, anchor: String) {
+        guard let value else {
+            self.removeText(id: id)
+            return
+        }
+        let fraction = max(0.0, min(1.0, value))
+        let filled = Int((fraction * 12.0).rounded())
+        let bar = String(repeating: "▓", count: filled) + String(repeating: "░", count: 12 - filled)
+        self.setText(id: id, text: (title.isEmpty ? "" : title + "\n") + bar + " \(Int((fraction * 100.0).rounded()))%", anchor: anchor.isEmpty ? "center" : anchor, color: nil, size: 14.0)
+    }
+
+    /// Runs particles for a few seconds and stops (`ayu.ui.animation.play`).
+    public func play(id: String, effect: Effect, seconds: Double) {
+        self.setParticles(id: id, Particles(effect: effect, amount: 2.0, speed: 1.2))
+        DispatchQueue.main.asyncAfter(deadline: .now() + max(0.5, min(10.0, seconds))) { [weak self] in
+            self?.removeParticles(id: id)
+        }
+    }
+
+    /// Everything a plugin created (ids are prefixed with the plugin id).
+    public func removeAll(prefix: String) {
+        DispatchQueue.main.async {
+            for id in self.emitters.keys where id.hasPrefix(prefix) { self.emitters.removeValue(forKey: id)?.removeFromSuperlayer(); self.particles[id] = nil }
+            for id in self.labels.keys where id.hasPrefix(prefix) { self.labels.removeValue(forKey: id)?.removeFromSuperview() }
+            for id in self.clocks.keys where id.hasPrefix(prefix) { self.clocks.removeValue(forKey: id)?.invalidate() }
+            for id in self.fpsCounters.keys where id.hasPrefix(prefix) { self.fpsCounters.removeValue(forKey: id)?.stop() }
+            for id in self.buttons.keys where id.hasPrefix(prefix) { self.buttons.removeValue(forKey: id)?.removeFromSuperview() }
+        }
+    }
+
+    private func relayout() {
+        let bounds = self.rootView.bounds
+        let paused = UIAccessibility.isReduceMotionEnabled
+        for emitter in self.emitters.values {
+            emitter.frame = bounds
+            emitter.emitterPosition = CGPoint(x: bounds.midX, y: -20.0)
+            emitter.emitterSize = CGSize(width: bounds.width * 1.3, height: 1.0)
+            emitter.birthRate = paused ? 0.0 : 1.0
+            emitter.isHidden = paused
+        }
+        let safe = self.rootView.safeAreaInsets
+        for label in self.labels.values {
+            let size = label.sizeThatFits(CGSize(width: bounds.width - 32.0, height: 200.0))
+            let anchor = label.accessibilityIdentifier ?? "topRight"
+            var origin = CGPoint(x: bounds.width - size.width - 16.0, y: safe.top + 8.0)
+            switch anchor {
+            case "topLeft": origin = CGPoint(x: 16.0, y: safe.top + 8.0)
+            case "bottomLeft": origin = CGPoint(x: 16.0, y: bounds.height - safe.bottom - size.height - 60.0)
+            case "bottomRight": origin = CGPoint(x: bounds.width - size.width - 16.0, y: bounds.height - safe.bottom - size.height - 60.0)
+            case "center": origin = CGPoint(x: (bounds.width - size.width) / 2.0, y: (bounds.height - size.height) / 2.0)
+            default: break
+            }
+            label.frame = CGRect(origin: origin, size: size)
+        }
+        for button in self.buttons.values {
+            let size = button.sizeThatFits(CGSize(width: 220.0, height: 56.0))
+            let width = max(52.0, size.width)
+            let height = max(52.0, size.height)
+            let anchor = button.accessibilityIdentifier ?? "bottomRight"
+            let bottom = bounds.height - safe.bottom - height - 90.0
+            var origin = CGPoint(x: bounds.width - width - 16.0, y: bottom)
+            switch anchor {
+            case "bottomLeft": origin = CGPoint(x: 16.0, y: bottom)
+            case "topRight": origin = CGPoint(x: bounds.width - width - 16.0, y: safe.top + 60.0)
+            case "topLeft": origin = CGPoint(x: 16.0, y: safe.top + 60.0)
+            default: break
+            }
+            button.frame = CGRect(origin: origin, size: CGSize(width: width, height: height))
+        }
+    }
+
+    fileprivate func cell(_ value: Particles) -> CAEmitterCell {
+        let cell = CAEmitterCell()
+        let amount = Float(max(0.1, min(3.0, value.amount)))
+        let speed = CGFloat(max(0.2, min(3.0, value.speed)))
+        cell.contents = AyuOverlayEffects.image(value.effect, color: value.color)?.cgImage
+        cell.lifetime = 14.0 / Float(speed)
+        cell.emissionLongitude = .pi
+        cell.emissionRange = .pi / 8.0
+        switch value.effect {
+        case .snow:
+            // Plain soft white dots of different sizes, drifting slowly.
+            cell.birthRate = 10.0 * amount
+            cell.velocity = 35.0 * speed
+            cell.velocityRange = 18.0 * speed
+            cell.yAcceleration = 6.0 * speed
+            cell.xAcceleration = 2.0
+            cell.emissionRange = .pi / 6.0
+            cell.scale = 0.5
+            cell.scaleRange = 0.35
+            cell.color = UIColor(white: 1.0, alpha: 0.85).cgColor
+            cell.alphaRange = 0.4
+        case .leaves:
+            cell.birthRate = 2.0 * amount
+            cell.velocity = 40.0 * speed
+            cell.velocityRange = 15.0 * speed
+            cell.yAcceleration = 10.0 * speed
+            cell.xAcceleration = 6.0
+            cell.scale = 0.55
+            cell.scaleRange = 0.25
+            cell.spin = 1.2
+            cell.spinRange = 2.4
+            cell.emissionRange = .pi / 4.0
+        case .rain:
+            cell.birthRate = 30.0 * amount
+            cell.velocity = 420.0 * speed
+            cell.velocityRange = 80.0 * speed
+            cell.yAcceleration = 120.0 * speed
+            cell.scale = 0.5
+            cell.alphaRange = 0.3
+            cell.emissionRange = .pi / 40.0
+            cell.lifetime = 4.0 / Float(speed)
+        case .stars:
+            cell.birthRate = 3.0 * amount
+            cell.velocity = 25.0 * speed
+            cell.velocityRange = 10.0
+            cell.scale = 0.3
+            cell.scaleRange = 0.2
+            cell.alphaSpeed = -0.05
+            cell.spin = 0.5
+            cell.spinRange = 1.0
+        case .confetti:
+            cell.birthRate = 8.0 * amount
+            cell.velocity = 90.0 * speed
+            cell.velocityRange = 40.0 * speed
+            cell.yAcceleration = 40.0 * speed
+            cell.scale = 0.4
+            cell.scaleRange = 0.2
+            cell.spin = 3.0
+            cell.spinRange = 6.0
+            cell.color = UIColor(hue: 0.0, saturation: 0.8, brightness: 1.0, alpha: 1.0).cgColor
+            cell.redRange = 1.0
+            cell.greenRange = 1.0
+            cell.blueRange = 1.0
+        case .none:
+            break
+        }
+        return cell
+    }
+
+    private static func image(_ effect: Effect, color: UIColor?) -> UIImage? {
+        let symbol: String
+        let tint: UIColor
+        switch effect {
+        case .snow:
+            let size = CGSize(width: 10.0, height: 10.0)
+            let dotColor = color ?? .white
+            return UIGraphicsImageRenderer(size: size).image { context in
+                let colors = [dotColor.cgColor, dotColor.withAlphaComponent(0.0).cgColor] as CFArray
+                if let gradient = CGGradient(colorsSpace: CGColorSpaceCreateDeviceRGB(), colors: colors, locations: [0.45, 1.0]) {
+                    context.cgContext.drawRadialGradient(gradient, startCenter: CGPoint(x: 5.0, y: 5.0), startRadius: 0.0, endCenter: CGPoint(x: 5.0, y: 5.0), endRadius: 5.0, options: [])
+                }
+            }
+        case .leaves: symbol = "leaf.fill"; tint = color ?? UIColor(red: 0.95, green: 0.55, blue: 0.15, alpha: 0.9)
+        case .rain:
+            let size = CGSize(width: 2.0, height: 18.0)
+            return UIGraphicsImageRenderer(size: size).image { _ in
+                (color ?? UIColor(red: 0.6, green: 0.75, blue: 1.0, alpha: 0.55)).setFill()
+                UIBezierPath(roundedRect: CGRect(origin: .zero, size: size), cornerRadius: 1.0).fill()
+            }
+        case .stars: symbol = "star.fill"; tint = color ?? UIColor(red: 1.0, green: 0.9, blue: 0.4, alpha: 0.9)
+        case .confetti:
+            let size = CGSize(width: 10.0, height: 6.0)
+            return UIGraphicsImageRenderer(size: size).image { _ in
+                UIColor.white.setFill()
+                UIBezierPath(rect: CGRect(origin: .zero, size: size)).fill()
+            }
+        case .none: return nil
+        }
+        return UIImage(systemName: symbol, withConfiguration: UIImage.SymbolConfiguration(pointSize: 28.0, weight: .regular))?.withTintColor(tint, renderingMode: .alwaysOriginal)
+    }
+}
+
+/// Never takes touches, whatever is on it.
+private final class AyuPassthroughView: UIView {
+    override func hitTest(_ point: CGPoint, with event: UIEvent?) -> UIView? {
+        for view in self.subviews.reversed() where view is AyuFloatingButton && !view.isHidden {
+            if view.frame.contains(point) {
+                return view
+            }
+        }
+        return nil
+    }
+
+    override func layoutSubviews() {
+        super.layoutSubviews()
+        AyuOverlayEffects.shared.layoutChanged()
+    }
+}
+
+extension AyuOverlayEffects {
+    fileprivate func layoutChanged() {
+        self.relayout()
+    }
+}
+
+/// The "Snow" effect as plain white dots in a chat's wallpaper, below the messages.
+/// Added into the chat background view; follows its size, never takes touches.
+public final class AyuChatBackgroundSnowView: UIView {
+    private let emitter = CAEmitterLayer()
+    private var observers: [NSObjectProtocol] = []
+
+    public override init(frame: CGRect) {
+        super.init(frame: frame)
+        self.isUserInteractionEnabled = false
+        self.backgroundColor = .clear
+        self.autoresizingMask = [.flexibleWidth, .flexibleHeight]
+        self.emitter.emitterShape = .line
+        self.emitter.renderMode = .unordered
+        self.layer.addSublayer(self.emitter)
+        for name in [AyuOverlayEffects.didChangeNotification, UIAccessibility.reduceMotionStatusDidChangeNotification] {
+            self.observers.append(NotificationCenter.default.addObserver(forName: name, object: nil, queue: .main, using: { [weak self] _ in
+                self?.update()
+            }))
+        }
+        self.update()
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    deinit {
+        for observer in self.observers {
+            NotificationCenter.default.removeObserver(observer)
+        }
+    }
+
+    public override func hitTest(_ point: CGPoint, with event: UIEvent?) -> UIView? {
+        return nil
+    }
+
+    private var isOn = false
+
+    private func update() {
+        let on = AyuOverlayEffects.effect == .snow && !UIAccessibility.isReduceMotionEnabled
+        self.isHidden = !on
+        if on {
+            self.emitter.emitterCells = [AyuOverlayEffects.shared.cell(AyuOverlayEffects.Particles(effect: .snow, amount: AyuOverlayEffects.amount, speed: AyuOverlayEffects.speed))]
+            if !self.isOn {
+                // Start already filled instead of waiting for the first dots to fall in.
+                self.emitter.beginTime = CACurrentMediaTime() - 10.0
+            }
+            self.emitter.birthRate = 1.0
+        } else {
+            self.emitter.birthRate = 0.0
+            self.emitter.emitterCells = nil
+        }
+        self.isOn = on
+    }
+
+    public override func layoutSubviews() {
+        super.layoutSubviews()
+        let bounds = self.bounds
+        CATransaction.begin()
+        CATransaction.setDisableActions(true)
+        self.emitter.frame = bounds
+        self.emitter.emitterPosition = CGPoint(x: bounds.midX, y: -10.0)
+        self.emitter.emitterSize = CGSize(width: bounds.width * 1.3, height: 1.0)
+        CATransaction.commit()
+    }
+}
+
+/// Counts display frames and reports once a second.
+private final class AyuFPSCounter: NSObject {
+    private var link: CADisplayLink?
+    private var frames = 0
+    private var start: CFTimeInterval = 0.0
+    private let update: (Int) -> Void
+
+    init(update: @escaping (Int) -> Void) {
+        self.update = update
+        super.init()
+        let link = CADisplayLink(target: self, selector: #selector(self.tick(_:)))
+        link.add(to: .main, forMode: .common)
+        self.link = link
+    }
+
+    @objc private func tick(_ link: CADisplayLink) {
+        if self.start == 0.0 {
+            self.start = link.timestamp
+        }
+        self.frames += 1
+        let elapsed = link.timestamp - self.start
+        if elapsed >= 1.0 {
+            self.update(Int((Double(self.frames) / elapsed).rounded()))
+            self.frames = 0
+            self.start = link.timestamp
+        }
+    }
+
+    func stop() {
+        self.link?.invalidate()
+        self.link = nil
+    }
+}
