new file mode 100644
index 00000000..22d26bc4
--- /dev/null
+++ b/submodules/TelegramUI/Sources/AyuLyricsAligner.swift
@@ -0,0 +1,131 @@
+import Foundation
+
+/// Offline timing for plain-text lyrics: places lines on the stretches of the track where a
+/// voice is singing, using only a per-frame vocal-activity envelope computed on the device.
+/// Pure arithmetic, no audio APIs, so it is tested on its own.
+enum AyuLyricsAligner {
+    struct Segment: Equatable {
+        var start: Double
+        var end: Double
+        var length: Double { return self.end - self.start }
+    }
+
+    /// Syllables approximated by vowel groups; Latin, Cyrillic and a few common scripts.
+    static func syllables(_ word: String) -> Int {
+        let vowels = Set("aeiouyæøåäöüéèêëáàâíìîïóòôúùûаеёиоуыэюяіїєaeiou")
+        var count = 0
+        var previousVowel = false
+        for character in word.lowercased() {
+            let isVowel = vowels.contains(character)
+            if isVowel && !previousVowel { count += 1 }
+            previousVowel = isVowel
+        }
+        // Scripts without these vowels (CJK, digits…) count per character.
+        if count == 0 { count = max(1, word.filter { $0.isLetter || $0.isNumber }.count / 2) }
+        return max(1, count)
+    }
+
+    /// Voiced stretches: above an adaptive threshold between the quiet floor (20th percentile)
+    /// and the loud level (90th), robust whether a voice fills a tenth or most of the track;
+    /// short dips bridged, blips dropped.
+    static func segments(activity: [Float], frameDuration: Double, minimumGap: Double = 0.45, minimumLength: Double = 0.35) -> [Segment] {
+        guard activity.count > 4, frameDuration > 0.0 else { return [] }
+        let sorted = activity.sorted()
+        let floor = sorted[sorted.count / 5]
+        let upper = sorted[min(sorted.count - 1, sorted.count * 9 / 10)]
+        guard upper > floor * 1.15 else { return [] }
+        let threshold = floor + (upper - floor) * 0.35
+        var result: [Segment] = []
+        var start: Int?
+        for (index, value) in activity.enumerated() {
+            if value >= threshold {
+                if start == nil { start = index }
+            } else if let open = start {
+                result.append(Segment(start: Double(open) * frameDuration, end: Double(index) * frameDuration))
+                start = nil
+            }
+        }
+        if let open = start {
+            result.append(Segment(start: Double(open) * frameDuration, end: Double(activity.count) * frameDuration))
+        }
+        var merged: [Segment] = []
+        for segment in result {
+            if let last = merged.last, segment.start - last.end < minimumGap {
+                merged[merged.count - 1].end = segment.end
+            } else {
+                merged.append(segment)
+            }
+        }
+        return merged.filter { $0.length >= minimumLength }
+    }
+
+    /// Lines laid along the voiced time in proportion to their syllables; a boundary that falls
+    /// near a real pause moves onto it. Words inside a line share it by syllables.
+    static func align(lines: [String], activity: [Float], frameDuration: Double, duration: Double) -> [AyuLyricsLine] {
+        let texts = lines.map { $0.trimmingCharacters(in: .whitespaces) }
+        let sung = texts.enumerated().filter { !$0.element.isEmpty }
+        guard !sung.isEmpty else { return [] }
+        var voiced = self.segments(activity: activity, frameDuration: frameDuration)
+        if voiced.isEmpty, duration > 0.0 {
+            // No usable envelope: spread over the middle of the track.
+            voiced = [Segment(start: duration * 0.08, end: duration * 0.92)]
+        }
+        guard !voiced.isEmpty else { return [] }
+        let totalVoiced = voiced.reduce(0.0) { $0 + $1.length }
+        let weights = sung.map { pair in Double(pair.element.split(separator: " ").reduce(0) { $0 + self.syllables(String($1)) }) + 1.0 }
+        let totalWeight = weights.reduce(0.0, +)
+
+        // Map a position along the voiced time back to track time.
+        func trackTime(_ voicedPosition: Double) -> Double {
+            var remaining = voicedPosition
+            for segment in voiced {
+                if remaining < segment.length { return segment.start + remaining }
+                remaining -= segment.length
+            }
+            return voiced[voiced.count - 1].end
+        }
+        func snapToPause(_ time: Double) -> Double {
+            // Prefer the start of a voiced segment within 1.5 s: lines usually begin after a breath.
+            var best = time
+            var bestDistance = 1.5
+            for segment in voiced {
+                let distance = abs(segment.start - time)
+                if distance < bestDistance { best = segment.start; bestDistance = distance }
+            }
+            return best
+        }
+
+        var starts: [Double] = []
+        var cumulative = 0.0
+        for weight in weights {
+            starts.append(starts.isEmpty ? voiced[0].start : snapToPause(trackTime(cumulative / totalWeight * totalVoiced)))
+            cumulative += weight
+        }
+        // Keep times strictly increasing even when two lines snapped to the same pause.
+        for index in starts.indices.dropFirst() where starts[index] <= starts[index - 1] + 0.3 {
+            starts[index] = starts[index - 1] + 0.3
+        }
+        var result: [AyuLyricsLine] = []
+        for (position, pair) in sung.enumerated() {
+            let start = starts[position]
+            let nextStart = position + 1 < starts.count ? starts[position + 1] : max(start + 2.0, voiced[voiced.count - 1].end)
+            // A line ends where its singing stops, not at the next line, if there is a pause.
+            var end = nextStart
+            if let segment = voiced.first(where: { $0.start <= start + 0.05 && $0.end > start }), segment.end < nextStart - 0.4 {
+                end = max(start + 0.6, segment.end)
+            }
+            let words = pair.element.split(separator: " ").map(String.init)
+            let wordWeights = words.map { Double(self.syllables($0)) }
+            let wordTotal = max(1.0, wordWeights.reduce(0.0, +))
+            var cursor = start
+            var timed: [AyuLyricsWord] = []
+            for (word, weight) in zip(words, wordWeights) {
+                let length = (end - start) * weight / wordTotal
+                timed.append(AyuLyricsWord(time: cursor, endTime: cursor + length, text: word))
+                cursor += length
+            }
+            result.append(AyuLyricsLine(time: start, endTime: end, text: pair.element, words: timed, exactWordTiming: false))
+        }
+        return result
+    }
+}
