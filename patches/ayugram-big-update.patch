index 00000000..a0a94b43
--- /dev/null
+++ b/submodules/AccountContext/Sources/AyuScriptCatalog.swift
@@ -0,0 +1,145 @@
+import Foundation
+import CryptoKit
+
+/// The online catalog of code plugins (by default github.com/murk-sus/AyuGramm-Plugins).
+/// Downloads are integrity-checked against the SHA-256 published in the index and must declare
+/// the same @id; installation still goes through the runtime's usual confirmation path.
+public final class AyuScriptCatalog {
+    public struct Entry: Codable, Equatable {
+        public let id: String
+        public let name: String
+        public let author: String
+        public let version: String
+        public let description: String
+        public let tags: [String]?
+        public let url: String
+        public let sha256: String
+        public let size: Int?
+    }
+
+    public enum Failure: LocalizedError {
+        case network
+        case invalidCatalog
+        case tooLarge
+        case checksumMismatch
+        case identityMismatch
+
+        public var errorDescription: String? {
+            let ru = Locale.preferredLanguages.first?.hasPrefix("ru") == true
+            switch self {
+            case .network: return ru ? "Каталог недоступен. Проверьте подключение." : "The catalog is unreachable. Check the connection."
+            case .invalidCatalog: return ru ? "Каталог повреждён или имеет неизвестный формат." : "The catalog is damaged or in an unknown format."
+            case .tooLarge: return ru ? "Плагин больше 512 КБ." : "The plugin is larger than 512 KB."
+            case .checksumMismatch: return ru ? "Файл не совпадает с каталогом (SHA-256). Установка отменена." : "The file does not match the catalog (SHA-256). Installation cancelled."
+            case .identityMismatch: return ru ? "@id файла не совпадает с каталогом." : "The file's @id does not match the catalog."
+            }
+        }
+    }
+
+    public static let shared = AyuScriptCatalog()
+    public static let defaultURL = "https://raw.githubusercontent.com/murk-sus/AyuGramm-Plugins/main/index.json"
+    private static let urlKey = "ayu.plugins.catalogURL"
+
+    /// The catalog address; a custom one lets anyone host their own collection.
+    public var catalogURL: String {
+        get { return UserDefaults.standard.string(forKey: AyuScriptCatalog.urlKey) ?? AyuScriptCatalog.defaultURL }
+        set {
+            let trimmed = newValue.trimmingCharacters(in: .whitespacesAndNewlines)
+            if trimmed.isEmpty || trimmed == AyuScriptCatalog.defaultURL {
+                UserDefaults.standard.removeObject(forKey: AyuScriptCatalog.urlKey)
+            } else {
+                UserDefaults.standard.set(trimmed, forKey: AyuScriptCatalog.urlKey)
+            }
+        }
+    }
+
+    private let session: URLSession = {
+        let configuration = URLSessionConfiguration.ephemeral
+        configuration.timeoutIntervalForRequest = 15.0
+        configuration.requestCachePolicy = .reloadIgnoringLocalCacheData
+        return URLSession(configuration: configuration)
+    }()
+
+    private init() {}
+
+    private func fetch(_ url: URL, limit: Int, completion: @escaping (Result<Data, Failure>) -> Void) {
+        guard url.scheme?.lowercased() == "https" else {
+            DispatchQueue.main.async { completion(.failure(.network)) }
+            return
+        }
+        self.session.dataTask(with: url, completionHandler: { data, response, _ in
+            let result: Result<Data, Failure>
+            if let http = response as? HTTPURLResponse, http.statusCode == 200, let data {
+                result = data.count <= limit ? .success(data) : .failure(.tooLarge)
+            } else {
+                result = .failure(.network)
+            }
+            DispatchQueue.main.async { completion(result) }
+        }).resume()
+    }
+
+    public func load(completion: @escaping (Result<[Entry], Failure>) -> Void) {
+        guard let url = URL(string: self.catalogURL) else {
+            completion(.failure(.invalidCatalog))
+            return
+        }
+        self.fetch(url, limit: 2 * 1024 * 1024, completion: { result in
+            switch result {
+            case let .success(data):
+                struct Index: Codable { let format: String; let plugins: [Entry] }
+                guard let index = try? JSONDecoder().decode(Index.self, from: data), index.format == "ayugram-plugin-catalog" else {
+                    completion(.failure(.invalidCatalog))
+                    return
+                }
+                let valid = index.plugins.filter { entry in
+                    entry.sha256.count == 64 && URL(string: entry.url)?.scheme?.lowercased() == "https" && !entry.id.isEmpty
+                }
+                completion(.success(valid.sorted(by: { $0.name.localizedCaseInsensitiveCompare($1.name) == .orderedAscending })))
+            case let .failure(error):
+                completion(.failure(error))
+            }
+        })
+    }
+
+    /// Downloads, verifies and installs (or updates) a catalog plugin.
+    public func install(_ entry: Entry, completion: @escaping (Result<Void, Error>) -> Void) {
+        guard let url = URL(string: entry.url) else {
+            completion(.failure(Failure.invalidCatalog))
+            return
+        }
+        self.fetch(url, limit: 512 * 1024, completion: { result in
+            switch result {
+            case let .success(data):
+                let digest = SHA256.hash(data: data).map { String(format: "%02x", $0) }.joined()
+                guard digest == entry.sha256.lowercased() else {
+                    completion(.failure(Failure.checksumMismatch))
+                    return
+                }
+                guard AyuScriptRuntime.shared.preview(data, filename: entry.id + ".ayu.js")?.id == entry.id else {
+                    completion(.failure(Failure.identityMismatch))
+                    return
+                }
+                do {
+                    try AyuScriptRuntime.shared.install(data, filename: entry.id + ".ayu.js")
+                    completion(.success(()))
+                } catch {
+                    completion(.failure(error))
+                }
+            case let .failure(error):
+                completion(.failure(error))
+            }
+        })
+    }
+
+    /// True when `available` is a newer dotted version than `installed` ("1.10" > "1.9").
+    public static func isNewer(_ available: String, than installed: String) -> Bool {
+        let lhs = available.split(separator: ".").map { Int($0.filter(\.isNumber)) ?? 0 }
+        let rhs = installed.split(separator: ".").map { Int($0.filter(\.isNumber)) ?? 0 }
+        for index in 0 ..< max(lhs.count, rhs.count) {
+            let a = index < lhs.count ? lhs[index] : 0
+            let b = index < rhs.count ? rhs[index] : 0
+            if a != b { return a > b }
+        }
+        return false
+    }
+}
