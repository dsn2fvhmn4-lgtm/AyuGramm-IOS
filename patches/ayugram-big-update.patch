diff --git a/submodules/SettingsUI/SnapshotTests/AyuSettingsSnapshotTests.swift b/submodules/SettingsUI/SnapshotTests/AyuSettingsSnapshotTests.swift
new file mode 100644
index 00000000..eec3dc67
--- /dev/null
+++ b/submodules/SettingsUI/SnapshotTests/AyuSettingsSnapshotTests.swift
@@ -0,0 +1,82 @@
+import XCTest
+import UIKit
+import Display
+import AsyncDisplayKit
+import ItemListUI
+import TelegramCore
+import TelegramPresentationData
+import AccountContext
+@testable import SettingsUI
+@testable import TelegramUI
+
+/// Baselines must be captured/reviewed on the pinned simulator, never synthesized on Linux.
+final class AyuSettingsSnapshotTests: XCTestCase {
+    @MainActor
+    func testSettingsPreviews() throws {
+        ayuRegisterMessageShotPreview()
+        XCTAssertNotNil(ayuMessageShotPreviewRenderer)
+        for dark in [false, true] {
+            let theme = dark ? makeDefaultDarkPresentationTheme(preview: true) : makeDefaultDayPresentationTheme(serviceBackgroundColor: nil, day: true, preview: true)
+            for ru in [false, true] {
+                for width: CGFloat in [320.0, 390.0, 768.0] {
+                    let suffix = "\(Int(width))-\(dark ? "dark" : "light")-\(ru ? "ru" : "en")"
+                    try self.check(AyuSettingsPreviews.contextMenu(width: width, theme: theme, interface: AyuInterfaceSettings(), ru: ru), name: "menu-" + suffix)
+                    for (name, picture) in [("history", AyuPreviewPicture.chatHistory), ("ghost", .chatGhost(true)), ("visible", .chatGhost(false)), ("shot", .messageShot(AyuMessageShotSettings()))] {
+                        // Exercise the actual list item/node, including its insets and mask.
+                        let item = picture.item(theme: theme, ru: ru, sectionId: 1)
+                        let node = AyuPreviewImageItemNode()
+                        let (layout, apply) = node.asyncLayout()(item, ListViewItemLayoutParams(width: width, leftInset: 16.0, rightInset: 16.0, availableHeight: 900.0), ItemListNeighbors(top: .none, bottom: .none))
+                        node.frame = CGRect(origin: .zero, size: layout.contentSize)
+                        apply()
+                        node.view.layoutIfNeeded()
+                        node.recursivelyEnsureDisplaySynchronously(true)
+                        let image = UIGraphicsImageRenderer(size: layout.contentSize).image { node.layer.render(in: $0.cgContext) }
+                        try self.check(image, name: name + "-" + suffix)
+                    }
+                }
+            }
+        }
+    }
+
+    private func check(_ image: UIImage?, name: String, file: StaticString = #filePath, line: UInt = #line) throws {
+        let image = try XCTUnwrap(image, name, file: file, line: line)
+        let actual = try XCTUnwrap(image.cgImage, file: file, line: line)
+        let attachment = XCTAttachment(image: image)
+        attachment.name = name
+        attachment.lifetime = .keepAlways
+        self.add(attachment)
+        let testBundle = Bundle(for: Self.self)
+        let resource = testBundle.url(forResource: "AyuSettingsSnapshotBaselines", withExtension: "bundle")
+        let bundle = resource.flatMap(Bundle.init(url:)) ?? testBundle
+        guard let path = bundle.path(forResource: name, ofType: "png"), let expected = UIImage(contentsOfFile: path)?.cgImage else {
+            XCTFail("Missing reviewed baseline: \(name).png. Actual image is attached to the test result.", file: file, line: line)
+            return
+        }
+        XCTAssertEqual(actual.width, expected.width, name, file: file, line: line)
+        XCTAssertEqual(actual.height, expected.height, name, file: file, line: line)
+        guard actual.width == expected.width, actual.height == expected.height else { return }
+        let lhs = try self.pixels(actual)
+        let rhs = try self.pixels(expected)
+        var totalError: UInt64 = 0
+        var changedPixels = 0
+        for i in stride(from: 0, to: lhs.count, by: 4) {
+            var error = 0
+            for channel in 0..<4 { error += abs(Int(lhs[i + channel]) - Int(rhs[i + channel])) }
+            totalError += UInt64(error)
+            if error > 80 { changedPixels += 1 }
+        }
+        // Allow minor anti-aliasing changes, but reject lost text, clipped bubbles or wrong colours.
+        XCTAssertLessThanOrEqual(Double(totalError) / Double(lhs.count * 255), 0.006, name, file: file, line: line)
+        XCTAssertLessThanOrEqual(Double(changedPixels) / Double(actual.width * actual.height), 0.01, name, file: file, line: line)
+    }
+
+    private func pixels(_ image: CGImage) throws -> [UInt8] {
+        var result = [UInt8](repeating: 0, count: image.width * image.height * 4)
+        let colorSpace = try XCTUnwrap(CGColorSpace(name: CGColorSpace.sRGB))
+        try result.withUnsafeMutableBytes { storage in
+            let context = try XCTUnwrap(CGContext(data: storage.baseAddress, width: image.width, height: image.height, bitsPerComponent: 8, bytesPerRow: image.width * 4, space: colorSpace, bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue | CGBitmapInfo.byteOrder32Big.rawValue))
+            context.draw(image, in: CGRect(x: 0, y: 0, width: image.width, height: image.height))
+        }
+        return result
+    }
+}
