diff --git a/submodules/TelegramUI/Sources/AyuDeveloperOverlays.swift b/submodules/TelegramUI/Sources/AyuDeveloperOverlays.swift
new file mode 100644
index 00000000..84ec4f86
--- /dev/null
+++ b/submodules/TelegramUI/Sources/AyuDeveloperOverlays.swift
@@ -0,0 +1,140 @@
+import Foundation
+import UIKit
+import TelegramCore
+
+/// App-wide developer overlays: FPS counter, slowed animations and outlines around
+/// AyuGram-owned views. Each is driven by `AyuDeveloperSettings` and fully inert when off.
+final class AyuDeveloperOverlays {
+    static let shared = AyuDeveloperOverlays()
+
+    private weak var container: UIView?
+    private var fpsLabel: UILabel?
+    private var displayLink: CADisplayLink?
+    private var frameCount = 0
+    private var windowStart: CFTimeInterval = 0.0
+    private var highlightTimer: Timer?
+    private var outlinedLayers: [CALayer] = []
+    private var observer: NSObjectProtocol?
+
+    private init() {}
+
+    func attach(to container: UIView) {
+        self.container = container
+        if self.observer == nil {
+            self.observer = NotificationCenter.default.addObserver(forName: AyuDeveloperSettings.didChangeNotification, object: nil, queue: .main, using: { [weak self] _ in
+                self?.apply()
+            })
+        }
+        self.apply()
+    }
+
+    private func apply() {
+        let settings = AyuDeveloperSettings.shared.current
+        self.container?.window?.layer.speed = settings.slowAnimations ? 0.25 : 1.0
+        self.setFpsCounter(enabled: settings.fpsCounter)
+        self.setHighlight(enabled: settings.highlightAyuViews)
+    }
+
+    private func setFpsCounter(enabled: Bool) {
+        guard enabled, let container = self.container else {
+            self.displayLink?.invalidate()
+            self.displayLink = nil
+            self.fpsLabel?.removeFromSuperview()
+            self.fpsLabel = nil
+            return
+        }
+        if self.fpsLabel == nil {
+            let label = UILabel()
+            label.font = UIFont.monospacedDigitSystemFont(ofSize: 11.0, weight: .semibold)
+            label.textColor = .white
+            label.textAlignment = .center
+            label.backgroundColor = UIColor(white: 0.0, alpha: 0.6)
+            label.layer.cornerRadius = 6.0
+            label.clipsToBounds = true
+            label.isUserInteractionEnabled = false
+            label.text = "-- fps"
+            self.fpsLabel = label
+        }
+        if let label = self.fpsLabel {
+            let top = container.safeAreaInsets.top
+            label.frame = CGRect(x: container.bounds.width - 70.0, y: max(top, 20.0) + 2.0, width: 62.0, height: 18.0)
+            label.autoresizingMask = [.flexibleLeftMargin, .flexibleBottomMargin]
+            container.addSubview(label)
+        }
+        if self.displayLink == nil {
+            let link = CADisplayLink(target: AyuOverlayTickTarget(self), selector: #selector(AyuOverlayTickTarget.tick(_:)))
+            if #available(iOS 15.0, *) {
+                link.preferredFrameRateRange = CAFrameRateRange(minimum: 30.0, maximum: 120.0, preferred: 120.0)
+            }
+            link.add(to: .main, forMode: .common)
+            self.displayLink = link
+            self.windowStart = CACurrentMediaTime()
+            self.frameCount = 0
+        }
+    }
+
+    fileprivate func tick(_ link: CADisplayLink) {
+        self.frameCount += 1
+        let elapsed = link.timestamp - self.windowStart
+        guard elapsed >= 0.5 else { return }
+        let fps = Double(self.frameCount) / elapsed
+        self.frameCount = 0
+        self.windowStart = link.timestamp
+        guard let label = self.fpsLabel else { return }
+        label.text = String(format: "%.0f fps", fps)
+        let maximum = Double(UIScreen.main.maximumFramesPerSecond)
+        label.textColor = fps > maximum * 0.9 ? UIColor(red: 0.5, green: 1.0, blue: 0.6, alpha: 1.0) : (fps > maximum * 0.6 ? .yellow : UIColor(red: 1.0, green: 0.45, blue: 0.45, alpha: 1.0))
+        label.superview?.bringSubviewToFront(label)
+    }
+
+    private func setHighlight(enabled: Bool) {
+        self.highlightTimer?.invalidate()
+        self.highlightTimer = nil
+        self.clearOutlines()
+        guard enabled else { return }
+        let timer = Timer(timeInterval: 1.0, repeats: true, block: { [weak self] _ in
+            self?.refreshOutlines()
+        })
+        RunLoop.main.add(timer, forMode: .common)
+        self.highlightTimer = timer
+        self.refreshOutlines()
+    }
+
+    private func clearOutlines() {
+        for layer in self.outlinedLayers {
+            layer.borderWidth = 0.0
+            layer.borderColor = nil
+        }
+        self.outlinedLayers = []
+    }
+
+    private func refreshOutlines() {
+        self.clearOutlines()
+        guard let root = self.container?.window else { return }
+        var stack: [UIView] = [root]
+        var visited = 0
+        // Bounded walk: the chat list alone can hold thousands of views.
+        while let view = stack.popLast(), visited < 4000 {
+            visited += 1
+            if String(describing: type(of: view)).hasPrefix("Ayu") {
+                view.layer.borderWidth = 1.0
+                view.layer.borderColor = UIColor.systemPink.cgColor
+                self.outlinedLayers.append(view.layer)
+            }
+            stack.append(contentsOf: view.subviews)
+        }
+    }
+}
+
+/// CADisplayLink retains its target strongly.
+private final class AyuOverlayTickTarget: NSObject {
+    private weak var owner: AyuDeveloperOverlays?
+
+    init(_ owner: AyuDeveloperOverlays) {
+        self.owner = owner
+    }
+
+    @objc func tick(_ link: CADisplayLink) {
+        self.owner?.tick(link)
+    }
+}
