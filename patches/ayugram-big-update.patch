+/// Results under Telegram's search bar, in the same grouped rows as the settings page.
+private final class AyuSettingsSearchContainerNode: SearchDisplayControllerContentNode {
+    private let entries: [AyuSettingsSearchEntry]
+    private let ru: Bool
+    private let openPage: (ViewController) -> Void
+    private let listNode: ListView
+    private var presentationData: PresentationData
+    private var query = ""
+    private var itemCount = 0
+    private var hasValidLayout = false
+
+    init(context: AccountContext, openPage: @escaping (ViewController) -> Void) {
+        let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+        self.presentationData = presentationData
+        let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        self.ru = ru
+        self.entries = ayuSettingsSearchEntries(context: context, ru: ru)
+        self.openPage = openPage
+        self.listNode = ListViewImpl()
+        self.listNode.isHidden = true
+        self.listNode.accessibilityPageScrolledString = { row, count in
+            return presentationData.strings.VoiceOver_ScrollStatus(row, count).string
+        }
+
+        super.init()
+
+        self.backgroundColor = presentationData.theme.list.blocksBackgroundColor
+        self.addSubnode(self.listNode)
+        self.listNode.beganInteractiveDragging = { [weak self] _ in
+            self?.dismissInput?()
+        }
+    }
+
+    override func updatePresentationData(_ presentationData: PresentationData) {
+        self.presentationData = presentationData
+        self.backgroundColor = presentationData.theme.list.blocksBackgroundColor
+        self.reload()
+    }
+
+    override func searchTextUpdated(text: String) {
+        self.query = text
+        self.reload()
+    }
+
+    private func items() -> [ListViewItem] {
+        let query = self.query.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !query.isEmpty else { return [] }
+        let found = self.entries.filter { AyuLocalSearch.matches(query, fields: [$0.title, $0.path, $0.keywords]) }
+        let data = ItemListPresentationData(self.presentationData)
+        var items: [ListViewItem] = []
+        let switches = found.filter { $0.read != nil }
+        let pages = found.filter { $0.page != nil }
+        if !switches.isEmpty {
+            items.append(ItemListSectionHeaderItem(presentationData: data, text: self.ru ? "ПЕРЕКЛЮЧАТЕЛИ" : "SWITCHES", sectionId: 0))
+            for entry in switches {
+                guard let read = entry.read, let write = entry.write else { continue }
+                items.append(ItemListSwitchItem(presentationData: data, systemStyle: .glass, title: entry.title, text: entry.path, value: read(), sectionId: 0, style: .blocks, updated: { [weak self] value in
+                    do {
+                        try write(value)
+                    } catch {
+                        // The switch already moved; put it back to what is actually stored.
+                        self?.reload()
+                    }
+                }))
+            }
+        }
+        if !pages.isEmpty {
+            items.append(ItemListSectionHeaderItem(presentationData: data, text: self.ru ? "РАЗДЕЛЫ" : "PAGES", sectionId: 1))
+            for entry in pages {
+                guard let page = entry.page else { continue }
+                items.append(ItemListDisclosureItem(presentationData: data, systemStyle: .glass, title: entry.title, label: "", sectionId: 1, style: .blocks, action: { [weak self] in
+                    self?.dismissInput?()
+                    self?.openPage(page())
+                }))
+            }
+        }
+        if items.isEmpty {
+            items.append(ItemListTextItem(presentationData: data, text: .plain(self.ru ? "Ничего не найдено" : "No results"), sectionId: 0))
+        }
+        return items
+    }
+
+    /// The lists are a few dozen rows: rebuilding them per keystroke is cheaper than diffing.
+    private func reload() {
+        guard self.hasValidLayout else { return }
+        let items = self.items()
+        let deletions = (0 ..< self.itemCount).map { ListViewDeleteItem(index: $0, directionHint: nil) }
+        let insertions = items.enumerated().map { ListViewInsertItem(index: $0.offset, previousIndex: nil, item: $0.element, directionHint: nil) }
+        self.itemCount = items.count
+        var options = ListViewDeleteAndInsertOptions()
+        options.insert(.Synchronous)
+        options.insert(.PreferSynchronousDrawing)
+        let isEmpty = items.isEmpty
+        let toTop: ListViewScrollToItem? = isEmpty ? nil : ListViewScrollToItem(index: 0, position: .top(0.0), animated: false, curve: .Default(duration: nil), directionHint: .Up)
+        self.listNode.transaction(deleteIndices: deletions, insertIndicesAndItems: insertions, updateIndicesAndItems: [], options: options, scrollToItem: toTop, updateSizeAndInsets: nil, stationaryItemRange: nil, updateOpaqueState: nil, completion: { [weak self] _ in
+            self?.listNode.isHidden = isEmpty
+        })
+    }
+
+    override func containerLayoutUpdated(_ layout: ContainerViewLayout, navigationBarHeight: CGFloat, transition: ContainedViewLayoutTransition) {
+        super.containerLayoutUpdated(layout, navigationBarHeight: navigationBarHeight, transition: transition)
+        let (duration, curve) = listViewAnimationDurationAndCurve(transition: transition)
+        var insets = layout.insets(options: [.input])
+        insets.top += navigationBarHeight
+        insets.left += layout.safeInsets.left
+        insets.right += layout.safeInsets.right
+        self.listNode.frame = CGRect(origin: CGPoint(), size: layout.size)
+        self.listNode.transaction(deleteIndices: [], insertIndicesAndItems: [], updateIndicesAndItems: [], options: [.Synchronous], scrollToItem: nil, updateSizeAndInsets: ListViewUpdateSizeAndInsets(size: layout.size, insets: insets, duration: duration, curve: curve), stationaryItemRange: nil, updateOpaqueState: nil, completion: { _ in })
+        if !self.hasValidLayout {
+            self.hasValidLayout = true
+            self.reload()
+        }
+    }
+
+    override func scrollToTop() {
+        guard self.itemCount > 0 else { return }
+        self.listNode.transaction(deleteIndices: [], insertIndicesAndItems: [], updateIndicesAndItems: [], options: [.Synchronous, .LowLatency], scrollToItem: ListViewScrollToItem(index: 0, position: .top(0.0), animated: true, curve: .Default(duration: nil), directionHint: .Up), updateSizeAndInsets: nil, stationaryItemRange: nil, updateOpaqueState: nil, completion: { _ in })
+    }
+}
+
+/// The AyuGram settings page, which also lays out the search over it.
+final class AyuGramSettingsListController: ItemListController {
+    var searchLayoutUpdated: ((ContainerViewLayout, CGFloat, ContainedViewLayoutTransition) -> Void)?
+
+    override func containerLayoutUpdated(_ layout: ContainerViewLayout, transition: ContainedViewLayoutTransition) {
+        super.containerLayoutUpdated(layout, transition: transition)
+        self.searchLayoutUpdated?(layout, self.cleanNavigationHeight, transition)
+    }
+}
+
+/// Telegram's pull-to-reveal search on the AyuGram settings page: the field waits under the
+/// navigation bar, pulling the page down brings it out, and once it is out the list scrolls
+/// as usual. Tapping it searches every AyuGram setting.
+final class AyuSettingsSearch {
+    let contentNode: NavigationBarSearchContentNode
+    private let context: AccountContext
+    private weak var controller: AyuGramSettingsListController?
+    private var display: SearchDisplayController?
+    private var layout: (ContainerViewLayout, CGFloat)?
+
+    init(context: AccountContext) {
+        self.context = context
+        let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+        var activate: (() -> Void)?
+        self.contentNode = NavigationBarSearchContentNode(theme: presentationData.theme, placeholder: presentationData.strings.Common_Search, activate: {
+            activate?()
+        })
+        activate = { [weak self] in
+            self?.activate()
+        }
+    }
+
+    /// Fully out: the next pull goes past the field.
+    var isRevealed: Bool {
+        return self.contentNode.expansionProgress >= 0.99
+    }
+
+    func attach(to controller: AyuGramSettingsListController) {
+        self.controller = controller
+        controller.navigationBar?.setContentNode(self.contentNode, animated: false)
+        controller.searchLayoutUpdated = { [weak self] layout, navigationBarHeight, transition in
+            guard let self else { return }
+            self.layout = (layout, navigationBarHeight)
+            self.display?.containerLayoutUpdated(layout, navigationBarHeight: navigationBarHeight, transition: transition)
+        }
+        controller.contentScrollingEnded = { [weak self] listView in
+            guard let self else { return false }
+            return fixNavigationSearchableListNodeScrolling(listView, searchNode: self.contentNode)
+        }
+    }
+
+    func updatePresentationData(_ presentationData: PresentationData) {
+        self.contentNode.updateThemeAndPlaceholder(theme: presentationData.theme, placeholder: presentationData.strings.Common_Search)
+        self.display?.updatePresentationData(presentationData)
+    }
+
+    func listOffsetChanged(_ offset: ListViewVisibleContentOffset) {
+        self.contentNode.updateListVisibleContentOffset(offset)
+    }
+
+    private func activate() {
+        guard let controller = self.controller, let (layout, navigationBarHeight) = self.layout, self.display == nil else {
+            return
+        }
+        let placeholderNode = self.contentNode.placeholderNode
+        let presentationData = self.context.sharedContext.currentPresentationData.with { $0 }
+        let content = AyuSettingsSearchContainerNode(context: self.context, openPage: { [weak controller] page in
+            controller?.push(page)
+        })
+        let display = SearchDisplayController(presentationData: presentationData, contentNode: content, cancel: { [weak self] in
+            self?.deactivate()
+        }, fieldStyle: placeholderNode.fieldStyle)
+        self.display = display
+        display.containerLayoutUpdated(layout, navigationBarHeight: navigationBarHeight, transition: .immediate)
+        display.activate(insertSubnode: { [weak controller, weak placeholderNode] subnode, isSearchBar in
+            guard let controller else { return }
+            if isSearchBar {
+                if let placeholderNode {
+                    placeholderNode.supernode?.insertSubnode(subnode, aboveSubnode: placeholderNode)
+                }
+            } else if let navigationBar = controller.navigationBar, navigationBar.supernode === controller.displayNode {
+                controller.displayNode.insertSubnode(subnode, belowSubnode: navigationBar)
+            } else {
+                controller.displayNode.addSubnode(subnode)
+            }
+        }, placeholder: placeholderNode)
+        controller.setDisplayNavigationBar(false, transition: .animated(duration: 0.5, curve: .spring))
+    }
+
+    private func deactivate() {
+        guard let display = self.display else { return }
+        self.display = nil
+        self.controller?.setDisplayNavigationBar(true, transition: .animated(duration: 0.5, curve: .spring))
+        display.deactivate(placeholder: self.contentNode.placeholderNode)
+    }
+}
