+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import ItemListUI
+import AccountContext
+
+/// Settings → AyuGram is organised in six categories (Privacy, Messages, Media & Calls,
+/// Appearance, Security, More). Each category page links the screens that belong to it.
+enum AyuCategory: Int32, CaseIterable {
+    case privacy = 51
+    case messages = 52
+    case media = 53
+    case appearance = 54
+    case security = 55
+    case more = 56
+
+    func title(_ ru: Bool) -> String {
+        switch self {
+        case .privacy: return ru ? "Приватность" : "Privacy"
+        case .messages: return ru ? "Сообщения" : "Messages"
+        case .media: return ru ? "Медиа и звонки" : "Media & Calls"
+        case .appearance: return ru ? "Оформление" : "Appearance"
+        case .security: return ru ? "Безопасность" : "Security"
+        case .more: return ru ? "Ещё" : "More"
+        }
+    }
+
+    func subtitle(_ ru: Bool) -> String {
+        switch self {
+        case .privacy: return ru ? "Что о вас видят другие" : "What others see about you"
+        case .messages: return ru ? "Что хранится, отправляется и показывается" : "What is kept, sent and shown"
+        case .media: return ru ? "Голос, кружки, звонки и загрузки" : "Voice, video messages, calls and downloads"
+        case .appearance: return ru ? "Сообщения, список чатов, панели и иконки" : "Messages, chat list, panels and icons"
+        case .security: return ru ? "Защита чатов, код-пароль и аккаунты" : "Chat protection, passcode and accounts"
+        case .more: return ru ? "Плагины, инструменты, бейджи, настройки AyuGram" : "Plugins, tools, badges, AyuGram settings"
+        }
+    }
+
+    var icon: UIImage? {
+        switch self {
+        case .privacy: return AyuSettingsIcons.ghost(color: UIColor(rgb: 0x8E5CF7))
+        case .messages: return AyuSettingsIcons.symbol("bubble.left.fill", color: UIColor(rgb: 0x007AFF))
+        case .media: return AyuSettingsIcons.symbol("photo.on.rectangle.angled", color: UIColor(rgb: 0x34C759))
+        case .appearance: return AyuSettingsIcons.symbol("paintbrush.pointed.fill", color: UIColor(rgb: 0xFF2D55))
+        case .security: return AyuSettingsIcons.symbol("lock.fill", color: UIColor(rgb: 0xFF9500))
+        case .more: return AyuSettingsIcons.symbol("ellipsis.circle.fill", color: UIColor(rgb: 0x8E8E93))
+        }
+    }
+}
+
+/// One row of a category page: a title, a subtitle and what it opens.
+struct AyuCategoryItem {
+    let id: Int32
+    let symbol: String
+    let color: UInt32
+    let titleRu: String
+    let titleEn: String
+    let subtitleRu: String
+    let subtitleEn: String
+    let open: (AccountContext, @escaping (ViewController) -> Void) -> Void
+}
+
+func ayuIsRussian(_ context: AccountContext) -> Bool {
+    return context.sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru")
+}
+
+private func page(_ make: @escaping (AccountContext) -> ViewController) -> (AccountContext, @escaping (ViewController) -> Void) -> Void {
+    return { context, push in push(make(context)) }
+}
+
+/// Where everything lives. New screens are added here, never as loose top-level buttons.
+func ayuCategoryItems(_ category: AyuCategory) -> [AyuCategoryItem] {
+    switch category {
+    case .privacy:
+        return [
+            AyuCategoryItem(id: 1, symbol: "eye.slash.fill", color: 0x8E5CF7, titleRu: "Режим призрака", titleEn: "Ghost Mode", subtitleRu: "Прочтения, онлайн, набор, загрузка", subtitleEn: "Read receipts, online, typing, uploads", open: page { ayuGhostModeController(context: $0) }),
+            AyuCategoryItem(id: 2, symbol: "eye.trianglebadge.exclamationmark.fill", color: 0x5856D6, titleRu: "Режим призрака+", titleEn: "Ghost Mode+", subtitleRu: "Тонкая настройка", subtitleEn: "Fine-tuning", open: page { ayuGhostModePlusController(context: $0) }),
+            AyuCategoryItem(id: 3, symbol: "person.crop.circle.badge.checkmark", color: 0x8E5CF7, titleRu: "Призрак по чатам", titleEn: "Ghost Mode by chat", subtitleRu: "Включить или выключить в отдельных чатах", subtitleEn: "On or off in single chats", open: page { ayuGhostExceptionsController(context: $0) }),
+            AyuCategoryItem(id: 4, symbol: "figure.walk.motion", color: 0x34C759, titleRu: "Активность и следы", titleEn: "Activity & traces", subtitleRu: "Статусы, всегда онлайн, прочитать локально, истории, номер", subtitleEn: "Statuses, always online, read locally, stories, number", open: page { ayuPrivacyPlusController(context: $0) }),
+            AyuCategoryItem(id: 5, symbol: "hand.raised.fill", color: 0x34C759, titleRu: "Приватность и мелочи", titleEn: "Privacy & extras", subtitleRu: "Метаданные фото, чистые ссылки, анти-скам, звонки", subtitleEn: "Photo metadata, clean links, anti-scam, calls", open: page { ayuExtrasController(context: $0) })
+        ]
+    case .messages:
+        return [
+            AyuCategoryItem(id: 11, symbol: "trash.fill", color: 0xFF9500, titleRu: "Удалённые и изменённые", titleEn: "Deleted & edited", subtitleRu: "Сохранять удалённые сообщения и историю правок", subtitleEn: "Keep deleted messages and edit history", open: page { ayuMessageHistoryController(context: $0) }),
+            AyuCategoryItem(id: 12, symbol: "photo.stack.fill", color: 0x34C759, titleRu: "Архив медиа", titleEn: "Media archive", subtitleRu: "Сохранённые фото и видео из удалённых", subtitleEn: "Saved photos and videos from deleted messages", open: page { AyuMediaArchiveScreen(context: $0) }),
