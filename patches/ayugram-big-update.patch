+import Foundation
+import UIKit
+import SwiftSignalKit
+import TelegramCore
+import AccountContext
+
+/// Native offline browser: no chat controller, network requests, or mark-as-read operations.
+final class AyuAccountArchivesController: UITableViewController {
+    private let store: AyuAccountArchiveStore
+    private let ru: Bool
+    private let disposable = MetaDisposable()
+    private let operation = MetaDisposable()
+    private var records: [(AccountRecordId, AyuArchivedAccountInfo)] = []
+
+    init(context: AccountContext, russian: Bool) {
+        self.store = context.sharedContext.ayuAccountArchives
+        self.ru = russian
+        super.init(style: .insetGrouped)
+        self.title = russian ? "Архив аккаунтов" : "Account archives"
+    }
+    required init?(coder: NSCoder) { fatalError("init(coder:) has not been implemented") }
+    deinit { self.disposable.dispose(); self.operation.dispose() }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        self.navigationItem.leftBarButtonItem = UIBarButtonItem(barButtonSystemItem: .done, target: self, action: #selector(close))
+        self.disposable.set((self.store.list() |> deliverOnMainQueue).start(next: { [weak self] records in
+            guard let self else { return }
+            self.records = records
+            self.tableView.reloadData()
+        }))
+    }
+    @objc private func close() { self.dismiss(animated: true) }
+    override func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int { self.records.count }
+    override func tableView(_ tableView: UITableView, titleForFooterInSection section: Int) -> String? {
+        return self.ru ? "Только переписки, сохранённые на этом устройстве. Архив не восстанавливает вход. Смахните аккаунт влево, чтобы удалить его архив." : "Only conversations cached on this device. Archives do not restore sign-in. Swipe an account left to delete its archive."
+    }
+    override func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
+        let info = self.records[indexPath.row].1
+        let cell = UITableViewCell(style: .subtitle, reuseIdentifier: nil)
+        cell.textLabel?.text = info.title
+        cell.detailTextLabel?.text = DateFormatter.localizedString(from: Date(timeIntervalSince1970: Double(info.timestamp)), dateStyle: .medium, timeStyle: .short)
+        cell.accessoryType = .disclosureIndicator
+        return cell
+    }
+    override func tableView(_ tableView: UITableView, didSelectRowAt indexPath: IndexPath) {
+        tableView.deselectRow(at: indexPath, animated: true)
+        let record = self.records[indexPath.row]
+        self.operation.set((self.store.open(id: record.0) |> deliverOnMainQueue).start(next: { [weak self] archive in
+            guard let self else { return }
+            if let archive {
+                self.navigationController?.pushViewController(AyuArchiveChatsController(archive: archive, title: record.1.title, russian: self.ru), animated: true)
+            } else {
+                let alert = UIAlertController(title: self.ru ? "Архив не открыт" : "Archive unavailable", message: self.ru ? "База недоступна или требует другой версии приложения. Данные сохранены." : "The database is unavailable or needs a compatible app version. Its data has been retained.", preferredStyle: .alert)
+                alert.addAction(UIAlertAction(title: "OK", style: .default))
+                self.present(alert, animated: true)
+            }
+        }))
+    }
+    override func tableView(_ tableView: UITableView, commit editingStyle: UITableViewCell.EditingStyle, forRowAt indexPath: IndexPath) {
+        guard editingStyle == .delete else { return }
+        let record = self.records[indexPath.row]
+        let alert = UIAlertController(title: self.ru ? "Удалить архив?" : "Delete archive?", message: record.1.title, preferredStyle: .alert)
+        alert.addAction(UIAlertAction(title: self.ru ? "Отмена" : "Cancel", style: .cancel))
+        alert.addAction(UIAlertAction(title: self.ru ? "Удалить" : "Delete", style: .destructive, handler: { [weak self] _ in
+            guard let self else { return }
+            self.operation.set(self.store.remove(id: record.0).start())
+        }))
+        self.present(alert, animated: true)
+    }
+}
+
+private final class AyuArchiveChatsController: UITableViewController {
+    private let archive: AyuAccountArchive
+    private let ru: Bool
+    private let disposable = MetaDisposable()
+    private var chats: [EnginePeer] = []
+    init(archive: AyuAccountArchive, title: String, russian: Bool) {
+        self.archive = archive; self.ru = russian
+        super.init(style: .plain)
+        self.title = title
+    }
+    required init?(coder: NSCoder) { fatalError("init(coder:) has not been implemented") }
+    deinit { self.disposable.dispose() }
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        self.disposable.set((self.archive.chats() |> deliverOnMainQueue).start(next: { [weak self] chats in
+            self?.chats = chats.sorted { $0.debugDisplayTitle.localizedCaseInsensitiveCompare($1.debugDisplayTitle) == .orderedAscending }
+            self?.tableView.reloadData()
+        }))
+    }
+    override func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int { self.chats.count }
+    override func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
+        let cell = UITableViewCell(style: .default, reuseIdentifier: nil)
+        cell.textLabel?.text = self.chats[indexPath.row].debugDisplayTitle
+        cell.accessoryType = .disclosureIndicator
+        return cell
+    }
+    override func tableView(_ tableView: UITableView, didSelectRowAt indexPath: IndexPath) {
+        tableView.deselectRow(at: indexPath, animated: true)
+        self.navigationController?.pushViewController(AyuArchiveMessagesController(archive: self.archive, peer: self.chats[indexPath.row], russian: self.ru), animated: true)
+    }
+}
+
+private final class AyuArchiveMessagesController: UITableViewController {
+    private let archive: AyuAccountArchive
+    private let peer: EnginePeer
+    private let ru: Bool
+    private let disposable = MetaDisposable()
+    private let exportDisposable = MetaDisposable()
+    private var messages: [EngineMessage] = []
+    private var cursor: EngineMessage.Index?
+    private var loading = false
+    private var hasMore = true
+    private var exportDirectory: URL?
+    init(archive: AyuAccountArchive, peer: EnginePeer, russian: Bool) {
+        self.archive = archive; self.peer = peer; self.ru = russian
+        super.init(style: .plain)
+        self.title = peer.debugDisplayTitle
+    }
+    required init?(coder: NSCoder) { fatalError("init(coder:) has not been implemented") }
+    deinit {
+        self.disposable.dispose(); self.exportDisposable.dispose()
+        if let url = self.exportDirectory { try? FileManager.default.removeItem(at: url) }
+    }
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        self.tableView.register(UITableViewCell.self, forCellReuseIdentifier: "message")
+        self.tableView.allowsSelection = false
+        self.navigationItem.rightBarButtonItem = UIBarButtonItem(title: "JSON", style: .plain, target: self, action: #selector(exportJSON))
+        self.loadMore()
+    }
+    private func loadMore() {
+        guard !self.loading, self.hasMore else { return }
+        self.loading = true
+        self.disposable.set((self.archive.messages(peerId: self.peer.id, before: self.cursor) |> deliverOnMainQueue).start(next: { [weak self] page in
+            guard let self else { return }
+            self.loading = false
+            self.hasMore = page.count == 100
+            self.cursor = page.map { $0.index }.min() ?? self.cursor
+            self.messages.append(contentsOf: page.sorted { $0.index > $1.index })
+            self.tableView.reloadData()
+        }))
+    }
+    override func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int { self.messages.count }
+    override func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
+        let message = self.messages[indexPath.row]
+        let cell = tableView.dequeueReusableCell(withIdentifier: "message", for: indexPath)
+        var content = cell.defaultContentConfiguration()
+        content.text = message.text.isEmpty ? (self.ru ? "Медиа (только текстовый просмотр)" : "Media (text-only viewer)") : message.text
+        content.textProperties.numberOfLines = 0
+        let date = DateFormatter.localizedString(from: Date(timeIntervalSince1970: Double(message.timestamp)), dateStyle: .short, timeStyle: .short)
+        content.secondaryText = (message.author?.debugDisplayTitle ?? "") + " · " + date
+        content.secondaryTextProperties.color = .secondaryLabel
+        cell.contentConfiguration = content
+        return cell
+    }
+    override func tableView(_ tableView: UITableView, willDisplay cell: UITableViewCell, forRowAt indexPath: IndexPath) {
+        if indexPath.row >= self.messages.count - 10 { self.loadMore() }
+    }
+    @objc private func exportJSON() {
+        self.navigationItem.rightBarButtonItem?.isEnabled = false
+        self.exportDisposable.set((self.archive.export(peerId: self.peer.id, title: self.peer.debugDisplayTitle) |> deliverOnMainQueue).start(next: { [weak self] event in
+            guard let self else { return }
+            if case let .completed(directory) = event {
+                self.navigationItem.rightBarButtonItem?.isEnabled = true
+                if let old = self.exportDirectory { try? FileManager.default.removeItem(at: old) }
+                self.exportDirectory = directory
+                let share = UIActivityViewController(activityItems: [directory.appendingPathComponent("result.json")], applicationActivities: nil)
+                share.popoverPresentationController?.barButtonItem = self.navigationItem.rightBarButtonItem
+                share.completionWithItemsHandler = { [weak self] _, _, _, _ in
+                    try? FileManager.default.removeItem(at: directory)
+                    self?.exportDirectory = nil
+                }
+                self.present(share, animated: true)
+            }
+        }, error: { [weak self] _ in
+            guard let self else { return }
+            self.navigationItem.rightBarButtonItem?.isEnabled = true
+            let alert = UIAlertController(title: self.ru ? "Экспорт недоступен" : "Export unavailable", message: self.ru ? "Секретные и защищённые чаты не экспортируются. Также проверьте свободное место." : "Secret and protected chats cannot be exported. Also check available storage.", preferredStyle: .alert)
+            alert.addAction(UIAlertAction(title: "OK", style: .default))
+            self.present(alert, animated: true)
+        }))
+    }
+}
