diff --git a/submodules/Camera/CameraNeo/Sources/AyuRoundVideoMask.swift b/submodules/Camera/CameraNeo/Sources/AyuRoundVideoMask.swift
new file mode 100644
index 00000000..814bde09
--- /dev/null
+++ b/submodules/Camera/CameraNeo/Sources/AyuRoundVideoMask.swift
@@ -0,0 +1,141 @@
+import Foundation
+import UIKit
+import CoreImage
+import CoreVideo
+import Vision
+
+/// AyuGram video message masks and quality, read from Settings → AyuGram → Media & Calls →
+/// Video messages ("ayu.media.*"; this module cannot see the settings types). Masks are drawn on
+/// the recorded frames, before encoding: faces are found with Vision every few frames.
+final class AyuRoundVideoMask {
+    private let mask: String
+    private let studio: [String]
+    private let emoji: String
+    private let context = CIContext(options: [.cacheIntermediates: false])
+    private var faces: [CGRect] = []
+    private var frameIndex = 0
+    private var emojiImage: CIImage?
+
+    /// nil when no mask is on (the common case costs nothing).
+    static func makeIfEnabled() -> AyuRoundVideoMask? {
+        let defaults = UserDefaults.standard
+        guard defaults.bool(forKey: "ayu.media.masks"), !defaults.bool(forKey: "ayu.decoy.active") else { return nil }
+        let mask = defaults.string(forKey: "ayu.media.mask") ?? "none"
+        let studio = defaults.stringArray(forKey: "ayu.media.studio") ?? []
+        guard mask != "none" || !studio.isEmpty else { return nil }
+        return AyuRoundVideoMask(mask: mask, studio: studio, emoji: defaults.string(forKey: "ayu.media.maskEmoji") ?? "😎")
+    }
+
+    private init(mask: String, studio: [String], emoji: String) {
+        self.mask = mask
+        self.studio = studio
+        self.emoji = emoji
+    }
+
+    private var needsFaces: Bool {
+        return ["pixelatedFace", "blurredFace", "emojiFace"].contains(self.mask)
+    }
+
+    private func updateFaces(_ buffer: CVPixelBuffer) {
+        let request = VNDetectFaceRectanglesRequest()
+        let handler = VNImageRequestHandler(cvPixelBuffer: buffer, options: [:])
+        try? handler.perform([request])
+        let width = CGFloat(CVPixelBufferGetWidth(buffer))
+        let height = CGFloat(CVPixelBufferGetHeight(buffer))
+        let found = (request.results ?? []).map { observation -> CGRect in
+            let box = observation.boundingBox
+            // Grow the box a little so hair and chin are covered too.
+            return CGRect(x: box.minX * width, y: box.minY * height, width: box.width * width, height: box.height * height).insetBy(dx: -box.width * width * 0.18, dy: -box.height * height * 0.25)
+        }
+        if !found.isEmpty || self.frameIndex % 30 == 0 {
+            self.faces = found
+        }
+    }
+
+    private func emojiOverlay(size: CGFloat) -> CIImage? {
+        if let emojiImage = self.emojiImage, emojiImage.extent.width == size {
+            return emojiImage
+        }
+        let image = UIGraphicsImageRenderer(size: CGSize(width: size, height: size)).image { _ in
+            (self.emoji as NSString).draw(in: CGRect(x: 0.0, y: 0.0, width: size, height: size), withAttributes: [.font: UIFont.systemFont(ofSize: size * 0.85)])
+        }
+        self.emojiImage = image.cgImage.map { CIImage(cgImage: $0) }
+        return self.emojiImage
+    }
+
+    /// Draws the mask into `output` (same size and format as `input`); false leaves the frame as is.
+    func render(_ input: CVPixelBuffer, into output: CVPixelBuffer) -> Bool {
+        self.frameIndex += 1
+        if self.needsFaces, self.frameIndex % 4 == 1 {
+            self.updateFaces(input)
+        }
+        let source = CIImage(cvPixelBuffer: input)
+        var image = source
+        switch self.mask {
+        case "pixelatedFace", "blurredFace", "emojiFace":
+            for face in self.faces {
+                let region = face.intersection(source.extent)
+                guard !region.isEmpty else { continue }
+                let covered: CIImage
+                if self.mask == "pixelatedFace" {
+                    covered = source.applyingFilter("CIPixellate", parameters: [kCIInputScaleKey: max(8.0, region.width / 12.0), kCIInputCenterKey: CIVector(x: region.midX, y: region.midY)]).cropped(to: region)
+                } else if self.mask == "blurredFace" {
+                    covered = source.clampedToExtent().applyingFilter("CIGaussianBlur", parameters: [kCIInputRadiusKey: max(10.0, region.width / 10.0)]).cropped(to: region)
+                } else if let overlay = self.emojiOverlay(size: max(region.width, region.height).rounded()) {
+                    covered = overlay.transformed(by: CGAffineTransform(translationX: region.midX - overlay.extent.width / 2.0, y: region.midY - overlay.extent.height / 2.0))
+                } else {
+                    continue
+                }
+                image = covered.composited(over: image)
+            }
+        case "comic":
+            image = image.applyingFilter("CIComicEffect")
+        case "noir":
+            image = image.applyingFilter("CIPhotoEffectNoir")
+        case "thermal":
+            image = image.applyingFilter("CIFalseColor", parameters: ["inputColor0": CIColor(red: 0.1, green: 0.0, blue: 0.6), "inputColor1": CIColor(red: 1.0, green: 0.9, blue: 0.1)])
+        case "sketch":
+            image = image.applyingFilter("CILineOverlay")
+        default:
+            break
+        }
+        for name in self.studio {
+            guard let filter = CIFilter(name: name) else { continue }
+            filter.setValue(image, forKey: kCIInputImageKey)
+            if name == "CIGaussianBlur" || name == "CIPixellate" {
+                image = (filter.outputImage ?? image).cropped(to: source.extent)
+            } else {
+                image = filter.outputImage ?? image
+            }
+        }
+        if image === source {
+            return false
+        }
+        self.context.render(image.cropped(to: source.extent), to: output)
+        return true
+    }
+}
+
+/// Quality settings for the round video writer.
+enum AyuRoundVideoQuality {
+    /// Telegram's own limit for a video message; above it the file would arrive as a plain video.
+    static let maximumBitrate = 4_000_000
+
+    static var bitrate: Int {
+        let value = UserDefaults.standard.integer(forKey: "ayu.media.bitrate")
+        return value > 0 ? min(value, maximumBitrate) : 1_200_000
+    }
+
+    static var hevc: Bool {
+        return UserDefaults.standard.bool(forKey: "ayu.media.hevc")
+    }
+
+    static var side: Int {
+        let value = UserDefaults.standard.integer(forKey: "ayu.media.resolution")
+        return [400, 480, 560, 640].contains(value) ? value : 480
+    }
+
+    static var stabilization: String {
+        return UserDefaults.standard.string(forKey: "ayu.media.stabilization") ?? "standard"
+    }
+}
