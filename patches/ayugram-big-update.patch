index 00000000..033c4fe7
--- /dev/null
+++ b/submodules/SettingsUI/Sources/AyuGhostExceptionsController.swift
@@ -0,0 +1,157 @@
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import PresentationDataUtils
+import ItemListUI
+import AccountContext
+
+// Settings → AyuGram → Ghost Mode exceptions: chats where Ghost Mode never applies.
+// The chat header's ghost button adds or removes the open chat from the same list.
+
+private enum AyuGhostExceptionsEntry: ItemListNodeEntry {
+    case add(String)
+    case peer(Int32, Int64, String, String)
+    case removeAll(String)
+    case info(String)
+
+    var section: ItemListSectionId {
+        switch self {
+        case .add: return 0
+        case .peer: return 1
+        case .removeAll, .info: return 2
+        }
+    }
+
+    var stableId: Int64 {
+        switch self {
+        case .add: return 0
+        case let .peer(index, _, _, _): return 100 + Int64(index)
+        case .removeAll: return 1_000_000
+        case .info: return 1_000_001
+        }
+    }
+
+    static func < (lhs: AyuGhostExceptionsEntry, rhs: AyuGhostExceptionsEntry) -> Bool { return lhs.stableId < rhs.stableId }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! AyuGhostExceptionsArguments
+        switch self {
+        case let .add(title):
+            return ItemListActionItem(presentationData: presentationData, systemStyle: .glass, title: title, kind: .generic, alignment: .natural, sectionId: self.section, style: .blocks, action: { arguments.add() })
+        case let .peer(_, peerId, title, label):
+            return ItemListDisclosureItem(presentationData: presentationData, systemStyle: .glass, title: title, label: label, sectionId: self.section, style: .blocks, action: { arguments.remove(peerId) })
+        case let .removeAll(title):
+            return ItemListActionItem(presentationData: presentationData, systemStyle: .glass, title: title, kind: .destructive, alignment: .natural, sectionId: self.section, style: .blocks, action: { arguments.removeAll() })
+        case let .info(text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        }
+    }
+}
+
+private struct AyuGhostExceptionsArguments {
+    let add: () -> Void
+    let remove: (Int64) -> Void
+    let removeAll: () -> Void
+}
+
+func ayuGhostExceptionsController(context: AccountContext) -> ViewController {
+    let store = context.account.network.ayuGhostMode
+    var push: ((ViewController) -> Void)?
+    var presentController: ((ViewController) -> Void)?
+
+    let update: ((inout AyuGhostModeSettings) -> Void) -> Void = { transform in
+        do {
+            try store.update { transform(&$0) }
+        } catch {
+            let data = context.sharedContext.currentPresentationData.with { $0 }
+            presentController?(textAlertController(context: context, title: "AyuGram", text: data.strings.baseLanguageCode.hasPrefix("ru") ? "Не удалось сохранить настройки." : "Settings could not be saved.", actions: [TextAlertAction(type: .defaultAction, title: data.strings.Common_OK, action: {})]))
+        }
+    }
+
+    let arguments = AyuGhostExceptionsArguments(add: {
+        let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+        let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        let filter: ChatListNodePeersFilter = [.excludeRecent, .doNotSearchMessages, .removeSearchHeader, .excludeSavedMessages, .excludeSecretChats]
+        let controller = context.sharedContext.makePeerSelectionController(PeerSelectionControllerParams(context: context, filter: filter, hasContactSelector: false, title: ru ? "Добавить исключение" : "Add exception"))
+        controller.peerSelected = { [weak controller] peer, _ in
+            update { $0.setException(true, peerId: peer.id.toInt64()) }
+            controller?.dismiss()
+        }
+        push?(controller)
+    }, remove: { peerId in
+        let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+        let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        let actionSheet = ActionSheetController(presentationData: presentationData)
+        actionSheet.setItemGroups([ActionSheetItemGroup(items: [
+            ActionSheetButtonItem(title: ru ? "Убрать из исключений" : "Remove exception", color: .destructive, action: { [weak actionSheet] in
+                actionSheet?.dismissAnimated()
+                update { $0.setException(false, peerId: peerId) }
+            })
+        ]), ActionSheetItemGroup(items: [
+            ActionSheetButtonItem(title: presentationData.strings.Common_Cancel, color: .accent, font: .bold, action: { [weak actionSheet] in
+                actionSheet?.dismissAnimated()
+            })
+        ])])
+        presentController?(actionSheet)
+    }, removeAll: {
+        update { $0.exceptionPeerIds = [] }
+    })
+
+    let peers: Signal<(AyuGhostModeSettings, [Int64: EnginePeer]), NoError> = store.signal
+    |> mapToSignal { settings -> Signal<(AyuGhostModeSettings, [Int64: EnginePeer]), NoError> in
+        let ids = settings.exceptionPeerIds.map { EnginePeer.Id($0) }
+        if ids.isEmpty {
+            return .single((settings, [:]))
+        }
+        return context.engine.data.subscribe(EngineDataMap(ids.map(TelegramEngine.EngineData.Item.Peer.Peer.init(id:))))
+        |> map { result -> (AyuGhostModeSettings, [Int64: EnginePeer]) in
+            var mapped: [Int64: EnginePeer] = [:]
+            for (id, peer) in result {
+                if let peer { mapped[id.toInt64()] = peer }
+            }
+            return (settings, mapped)
+        }
+    }
+
+    let signal = combineLatest(context.sharedContext.presentationData, peers)
+    |> deliverOnMainQueue
+    |> map { presentationData, value -> (ItemListControllerState, (ItemListNodeState, Any)) in
