+    }
+
+    static func merge(previous: TelegramChannel, banned: TelegramChannel) -> TelegramChannel {
+        return TelegramChannel(id: previous.id, accessHash: banned.accessHash ?? previous.accessHash, title: previous.title, username: previous.username, photo: previous.photo, creationDate: previous.creationDate, version: previous.version, participationStatus: .kicked, info: previous.info, flags: previous.flags, restrictionInfo: previous.restrictionInfo, adminRights: nil, bannedRights: banned.bannedRights, defaultBannedRights: previous.defaultBannedRights, usernames: previous.usernames, storiesHidden: previous.storiesHidden, nameColor: previous.nameColor, backgroundEmojiId: previous.backgroundEmojiId, profileColor: previous.profileColor, profileBackgroundEmojiId: previous.profileBackgroundEmojiId, emojiStatus: previous.emojiStatus, approximateBoostLevel: previous.approximateBoostLevel, subscriptionUntilDate: previous.subscriptionUntilDate, verificationIconFileId: previous.verificationIconFileId, sendPaidMessageStars: previous.sendPaidMessageStars, linkedMonoforumId: previous.linkedMonoforumId, linkedCommunityId: previous.linkedCommunityId)
+    }
+}
diff --git a/submodules/TelegramCore/Sources/AyuGram/AyuTLHooks.swift b/submodules/TelegramCore/Sources/AyuGram/AyuTLHooks.swift
new file mode 100644
index 00000000..8ae42f4b
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuGram/AyuTLHooks.swift
@@ -0,0 +1,88 @@
+import Foundation
+
+/// TL hooks for official (signed, injecting) plugins.
+/// - pre_request is declarative: a plugin blocks methods from `blockableMethods`; a blocked call
+///   completes at once without reaching the server (no JavaScript runs on the network path).
+/// - post_request and on_update are observations: method and constructor names (never
+///   arguments or contents), delivered off the network queue.
+public enum AyuTLHooks {
+    /// Only calls whose silent absence cannot break the client: presence, typing, read marks, views.
+    public static let blockableMethods: Set<String> = [
+        "messages.setTyping",
+        "messages.readHistory",
+        "channels.readHistory",
+        "messages.readMessageContents",
+        "channels.readMessageContents",
+        "messages.readDiscussion",
+        "stories.readStories",
+        "stories.incrementStoryViews",
+        "messages.getMessagesViews",
+        "account.updateStatus",
+        "messages.readReactions",
+        "messages.readMentions"
+    ]
+
+    private static let lock = NSLock()
+    private static var blocked: [String: Set<String>] = [:]
+    private static var blockedUnion: Set<String> = []
+    /// Read on every request without the lock; written under it.
+    public private(set) static var isActive = false
+
+    /// Observers set by the plugin runtime; called on a background queue.
+    public static var onRequest: ((String, Int32?) -> Void)?
+    public static var onUpdates: (([String]) -> Void)?
+    public static var observesTraffic = false
+
+    private static let queue = DispatchQueue(label: "ayu.tlHooks", qos: .utility)
+
+    @discardableResult
+    public static func block(_ method: String, owner: String, _ value: Bool) -> Bool {
+        guard blockableMethods.contains(method) else { return false }
+        lock.lock()
+        var set = blocked[owner] ?? []
+        if value { set.insert(method) } else { set.remove(method) }
+        blocked[owner] = set.isEmpty ? nil : set
+        blockedUnion = blocked.values.reduce(into: Set<String>()) { $0.formUnion($1) }
+        isActive = !blockedUnion.isEmpty || observesTraffic
+        lock.unlock()
+        return true
+    }
+
+    public static func setObserving(_ value: Bool) {
+        lock.lock()
+        observesTraffic = value
+        isActive = !blockedUnion.isEmpty || value
+        lock.unlock()
+    }
+
+    public static func removeAll(owner: String) {
+        lock.lock()
+        blocked[owner] = nil
+        blockedUnion = blocked.values.reduce(into: Set<String>()) { $0.formUnion($1) }
+        isActive = !blockedUnion.isEmpty || observesTraffic
+        lock.unlock()
+    }
+
+    static func shouldBlock(_ method: String) -> Bool {
+        guard !AyuDecoyState.isActive else { return false }
+        lock.lock()
+        defer { lock.unlock() }
+        return blockedUnion.contains(method)
+    }
+
+    static func requestFinished(_ method: String, errorCode: Int32?) {
+        guard observesTraffic, let onRequest else { return }
+        queue.async {
+            onRequest(method, errorCode)
+        }
+    }
+
+    static func updatesReceived(_ updates: [Any]) {
+        guard observesTraffic, let onUpdates, !updates.isEmpty else { return }
+        // Api values print their constructor name only (no field values), see TelegramApi.
+        let names = updates.prefix(100).map { String(describing: $0) }
+        queue.async {
+            onUpdates(Array(names))
+        }
+    }
+}
