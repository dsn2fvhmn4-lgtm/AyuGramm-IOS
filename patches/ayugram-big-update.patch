index 00000000..ab6788ff
--- /dev/null
+++ b/submodules/AccountContext/Sources/AyuScriptRuntime.swift
@@ -0,0 +1,557 @@
+import Foundation
+import JavaScriptCore
+import TelegramCore
+
+/// Code plugins: JavaScript files that run in their own JavaScriptCore virtual machine on a
+/// private thread and change app behaviour through `AyuHooks` — wrapping or replacing native
+/// handlers (for example the outgoing-text handler) and switching native features off.
+///
+/// iOS cannot spawn processes or load downloaded native code, so a separate VM per plugin is
+/// the isolation boundary: an exception stays inside its plugin, and a plugin that does not
+/// answer a hook within the time limit is disabled and its hooks removed while the app keeps
+/// running. Declarative `.plugin`/`.iosplug` (JSON) plugins are untouched and keep working.
+///
+/// Plugins get no network, account or message-sending API; they see only the text handed to
+/// their hooks.
+public final class AyuScriptRuntime {
+    public struct Plugin: Codable, Equatable {
+        public var id: String
+        public var name: String
+        public var author: String
+        public var version: String
+        public var description: String
+        public var enabled: Bool
+        public var disabledReason: String?
+    }
+
+    public enum InstallError: LocalizedError {
+        case invalidFile
+        case tooLarge
+        case invalidIdentifier
+
+        public var errorDescription: String? {
+            let ru = Locale.preferredLanguages.first?.hasPrefix("ru") == true
+            switch self {
+            case .invalidFile: return ru ? "Файл не является текстовым JavaScript-плагином." : "The file is not a text JavaScript plugin."
+            case .tooLarge: return ru ? "Плагин больше 512 КБ." : "The plugin is larger than 512 KB."
+            case .invalidIdentifier: return ru ? "Укажите @id из латинских букв, цифр, «-» и «_»." : "Use an @id of latin letters, digits, - and _."
+            }
+        }
+    }
+
+    public static let shared = AyuScriptRuntime()
+    public static let didChangeNotification = Notification.Name("AyuGram.ScriptPluginsChanged")
+    public static let fileExtensions: Set<String> = ["js", "ayujs"]
+
+    /// Presents short host messages (`ayu.toast`); installed by the app on launch.
+    public var toastHandler: ((String) -> Void)?
+
+    private let lock = NSRecursiveLock()
+    private var index: [Plugin] = []
+    private var instances: [String: AyuScriptInstance] = [:]
+    private var bootstrapped = false
+
+    private init() {
+        self.index = self.loadIndex()
+    }
+
+    // MARK: Storage
+
+    private var directory: URL? {
+        return FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first?
+            .appendingPathComponent("AyuGram", isDirectory: true)
+            .appendingPathComponent("scripts", isDirectory: true)
+    }
+
+    private func sourceURL(id: String) -> URL? {
+        return self.directory?.appendingPathComponent(id + ".js")
+    }
+
+    private func loadIndex() -> [Plugin] {
+        guard let url = self.directory?.appendingPathComponent("index.json"), let data = try? Data(contentsOf: url),
+              let decoded = try? JSONDecoder().decode([Plugin].self, from: data) else { return [] }
+        return decoded
+    }
+
+    private func saveIndex() {
+        guard let directory = self.directory, let data = try? JSONEncoder().encode(self.index) else { return }
+        try? FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        try? data.write(to: directory.appendingPathComponent("index.json"), options: .atomic)
+    }
+
+    public var plugins: [Plugin] {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return self.index
+    }
+
+    // MARK: Install
+
+    /// Reads the `// @key value` header (an optional `==AyuPlugin==` block) without running code.
+    public func preview(_ data: Data, filename: String) -> Plugin? {
+        guard data.count <= 512 * 1024, let source = String(data: data, encoding: .utf8), !source.contains("\u{0}") else { return nil }
+        var fields: [String: String] = [:]
+        for line in source.components(separatedBy: .newlines).prefix(80) {
+            let trimmed = line.trimmingCharacters(in: .whitespaces)
+            guard trimmed.hasPrefix("//") else { continue }
+            let body = trimmed.dropFirst(2).trimmingCharacters(in: .whitespaces)
+            guard body.hasPrefix("@") else { continue }
+            let parts = body.dropFirst().split(separator: " ", maxSplits: 1, omittingEmptySubsequences: true)
+            guard let key = parts.first else { continue }
+            fields[String(key).lowercased()] = parts.count > 1 ? String(parts[1]).trimmingCharacters(in: .whitespaces) : ""
+        }
+        let fallbackId = ((filename as NSString).deletingPathExtension).lowercased().map { ch -> Character in
+            return (ch.isLetter && ch.isASCII) || ch.isNumber || ch == "-" || ch == "_" ? ch : "-"
+        }
+        let id = (fields["id"] ?? String(fallbackId)).lowercased()
+        return Plugin(
+            id: id,
+            name: String((fields["name"] ?? (filename as NSString).deletingPathExtension).prefix(64)),
+            author: String((fields["author"] ?? "").prefix(128)),
+            version: String((fields["version"] ?? "1.0").prefix(32)),
+            description: String((fields["description"] ?? "").prefix(1024)),
+            enabled: false,
+            disabledReason: nil
+        )
+    }
+
+    @discardableResult
+    public func install(_ data: Data, filename: String) throws -> Plugin {
+        guard data.count <= 512 * 1024 else { throw InstallError.tooLarge }
+        guard var plugin = self.preview(data, filename: filename) else { throw InstallError.invalidFile }
+        guard !plugin.id.isEmpty, plugin.id.utf8.count <= 64,
+              plugin.id.unicodeScalars.allSatisfy({ (97...122).contains($0.value) || (48...57).contains($0.value) || $0 == "-" || $0 == "_" }) else {
+            throw InstallError.invalidIdentifier
+        }
+        guard let directory = self.directory, let url = self.sourceURL(id: plugin.id) else { throw InstallError.invalidFile }
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        self.stop(id: plugin.id)
+        try data.write(to: url, options: .atomic)
+        plugin.enabled = true
+        self.lock.lock()
+        self.index.removeAll(where: { $0.id == plugin.id })
+        self.index.append(plugin)
+        self.saveIndex()
+        self.lock.unlock()
+        self.start(plugin)
+        self.notify()
+        return plugin
+    }
+
+    public func setEnabled(_ id: String, _ enabled: Bool) {
+        self.lock.lock()
+        guard let position = self.index.firstIndex(where: { $0.id == id }) else {
+            self.lock.unlock()
+            return
+        }
+        self.index[position].enabled = enabled
+        self.index[position].disabledReason = nil
+        let plugin = self.index[position]
+        self.saveIndex()
+        self.lock.unlock()
+        if enabled { self.start(plugin) } else { self.stop(id: id) }
+        self.notify()
+    }
+
+    public func remove(_ id: String) {
+        self.stop(id: id)
+        self.lock.lock()
+        self.index.removeAll(where: { $0.id == id })
+        self.saveIndex()
+        self.lock.unlock()
+        if let url = self.sourceURL(id: id) { try? FileManager.default.removeItem(at: url) }
+        UserDefaults.standard.removeObject(forKey: AyuScriptInstance.storageKey(id))
+        self.notify()
+    }
+
+    public func source(id: String) -> String? {
+        guard let url = self.sourceURL(id: id), let data = try? Data(contentsOf: url) else { return nil }
+        return String(data: data, encoding: .utf8)
+    }
+
+    /// Starts every enabled plugin once per launch.
+    public func bootstrap() {
+        self.lock.lock()
+        guard !self.bootstrapped else {
+            self.lock.unlock()
+            return
+        }
+        self.bootstrapped = true
+        let enabled = self.index.filter { $0.enabled }
+        self.lock.unlock()
+        for plugin in enabled { self.start(plugin) }
+    }
+
+    /// What a running plugin registered, for its details screen.
+    public func activitySummary(id: String) -> [String] {
+        self.lock.lock()
+        let instance = self.instances[id]
+        self.lock.unlock()
+        return instance?.summary ?? []
+    }
+
+    // MARK: Events
+
+    /// Broadcasts an app event (`chatOpen`, `appForeground`, …) to every running plugin.
+    public func emit(_ event: String, _ payload: [String: Any] = [:]) {
+        self.lock.lock()
+        let running = Array(self.instances.values)
+        self.lock.unlock()
+        for instance in running { instance.emit(event, payload) }
+    }
+
+    // MARK: Lifecycle
+
+    private func start(_ plugin: Plugin) {
+        guard let url = self.sourceURL(id: plugin.id), let data = try? Data(contentsOf: url), let source = String(data: data, encoding: .utf8) else { return }
+        self.stop(id: plugin.id)
+        let instance = AyuScriptInstance(id: plugin.id, source: source, runtime: self)
+        self.lock.lock()
+        self.instances[plugin.id] = instance
+        self.lock.unlock()
+        instance.load()
+    }
+
+    private func stop(id: String) {
+        self.lock.lock()
+        let instance = self.instances.removeValue(forKey: id)
+        self.lock.unlock()
+        AyuHooks.shared.removeAll(owner: id)
+        instance?.unload()
+    }
+
+    /// A plugin missed a hook deadline: switch it off so it can never stall the app again.
+    fileprivate func pluginHung(_ id: String) {
+        self.lock.lock()
+        let instance = self.instances.removeValue(forKey: id)
+        if let position = self.index.firstIndex(where: { $0.id == id }) {
+            self.index[position].enabled = false
+            self.index[position].disabledReason = "timeout"
+        }
+        self.saveIndex()
+        self.lock.unlock()
+        AyuHooks.shared.removeAll(owner: id)
+        instance?.abandon()
+        AyuPluginConsole.shared.append(pluginId: id, level: .error, "Plugin did not answer in time and was disabled.")
+        let ru = Locale.preferredLanguages.first?.hasPrefix("ru") == true
+        self.toast(ru ? "Плагин «\(id)» завис и был отключён" : "Plugin \"\(id)\" stopped responding and was disabled")
+        self.notify()
+    }
+
+    fileprivate func toast(_ text: String) {
+        DispatchQueue.main.async {
+            self.toastHandler?(text)
+        }
+    }
+
+    private func notify() {
+        DispatchQueue.main.async {
+            NotificationCenter.default.post(name: AyuScriptRuntime.didChangeNotification, object: nil)
+        }
+    }
+}
+
+/// One plugin: a JavaScriptCore VM confined to a serial queue.
+private final class AyuScriptInstance {
+    static func storageKey(_ id: String) -> String { return "ayu.script.storage." + id }
+
+    let id: String
+    private let source: String
+    private weak var runtime: AyuScriptRuntime?
+    private let queue: DispatchQueue
+    private let queueKey = DispatchSpecificKey<String>()
+    private var vm: JSVirtualMachine?
+    private var context: JSContext?
+    private var events: [String: [JSValue]] = [:]
+    private var timers: [Int: DispatchWorkItem] = [:]
+    private var nextTimer = 1
+    private var stopped = false
+    private let summaryLock = NSLock()
+    private var summaryItems: [String] = []
+
+    init(id: String, source: String, runtime: AyuScriptRuntime) {
+        self.id = id
+        self.source = source
+        self.runtime = runtime
+        self.queue = DispatchQueue(label: "AyuGram.Script." + id, qos: .userInitiated)
+        self.queue.setSpecific(key: self.queueKey, value: id)
+    }
+
+    var summary: [String] {
+        self.summaryLock.lock()
+        defer { self.summaryLock.unlock() }
+        return self.summaryItems
+    }
+
+    private func addSummary(_ item: String) {
+        self.summaryLock.lock()
+        if !self.summaryItems.contains(item) { self.summaryItems.append(item) }
+        self.summaryLock.unlock()
+    }
+
+    private var hookTimeout: DispatchTimeInterval {
+        return AyuDeveloperSettings.shared.current.experimentalPluginHooks ? .seconds(2) : .milliseconds(250)
+    }
+
+    private func log(_ level: AyuPluginConsole.Line.Level, _ text: String) {
+        AyuPluginConsole.shared.append(pluginId: self.id, level: level, text)
+        if level == .error, AyuDeveloperSettings.shared.current.experimentalPluginHooks {
+            self.runtime?.toast("\(self.id): \(text)")
+        }
+    }
+
+    // MARK: Lifecycle
+
+    func load() {
+        self.queue.async { [weak self] in
+            guard let self, !self.stopped else { return }
+            guard let vm = JSVirtualMachine(), let context = JSContext(virtualMachine: vm) else {
+                self.log(.error, "JavaScriptCore is unavailable.")
+                return
+            }
+            self.vm = vm
+            self.context = context
+            context.name = "AyuGram plugin " + self.id
+            context.exceptionHandler = { [weak self] _, exception in
+                self?.log(.error, exception?.toString() ?? "Unknown exception")
+            }
+            self.installHost(in: context)
+            context.evaluateScript(AyuScriptInstance.prelude, withSourceURL: URL(string: "ayu://prelude.js"))
+            context.evaluateScript(self.source, withSourceURL: URL(string: "ayu://plugins/\(self.id).js"))
+            self.emitOnQueue("load", [:])
+            self.log(.info, "Loaded.")
+        }
+    }
+
+    func unload() {
+        self.queue.async {
+            guard !self.stopped else { return }
+            self.emitOnQueue("unload", [:])
+            self.teardown()
+        }
+    }
+
+    /// The queue may be stuck in an endless loop; drop everything reachable without it.
+    func abandon() {
+        self.stopped = true
+    }
+
+    private func teardown() {
+        self.stopped = true
+        for item in self.timers.values { item.cancel() }
+        self.timers = [:]
+        self.events = [:]
+        self.context?.exceptionHandler = nil
+        self.context = nil
+        self.vm = nil
+    }
+
+    // MARK: Events
+
+    func emit(_ event: String, _ payload: [String: Any]) {
+        self.queue.async {
+            self.emitOnQueue(event, payload)
+        }
+    }
+
+    private func emitOnQueue(_ event: String, _ payload: [String: Any]) {
+        guard !self.stopped, let handlers = self.events[event] else { return }
+        for handler in handlers {
+            handler.call(withArguments: [payload])
+        }
+    }
+
+    // MARK: Hooks
+
+    /// Runs `handler(text, context)` on the plugin queue and waits for it, within the limit.
+    private func callTextHandler(_ handler: JSValue, text: String, context: AyuHooks.TextContext) -> String? {
+        if DispatchQueue.getSpecific(key: self.queueKey) == self.id {
+            return self.invokeText(handler, text: text, context: context)
+        }
+        var result: String?
+        let semaphore = DispatchSemaphore(value: 0)
+        self.queue.async {
+            result = self.invokeText(handler, text: text, context: context)
+            semaphore.signal()
+        }
+        if semaphore.wait(timeout: .now() + self.hookTimeout) == .timedOut {
+            self.runtime?.pluginHung(self.id)
+            return nil
+        }
+        return result
+    }
+
+    private func invokeText(_ handler: JSValue, text: String, context: AyuHooks.TextContext) -> String? {
+        guard !self.stopped else { return nil }
+        let info: [String: Any] = ["peerId": String(context.peerId), "isSecret": context.isSecret]
+        guard let value = handler.call(withArguments: [text, info]), value.isString else { return nil }
+        let string = value.toString() ?? ""
+        return string.utf16.count <= 8192 ? string : nil
+    }
+
+    // MARK: Host API
+
+    private func installHost(in context: JSContext) {
+        guard let host = JSValue(newObjectIn: context) else { return }
+
+        let log: @convention(block) (String, String) -> Void = { [weak self] level, text in
+            self?.log(AyuPluginConsole.Line.Level(rawValue: level) ?? .info, text)
+        }
+        let hook: @convention(block) (String, String, JSValue) -> Bool = { [weak self] pointName, modeName, handler in
+            guard let self else { return false }
+            let aliases: [String: AyuHooks.TextPoint] = ["outgoingText": .outgoingText, "outgoing": .outgoingText]
+            guard let point = AyuHooks.TextPoint(rawValue: pointName) ?? aliases[pointName], let mode = AyuHooks.Mode(rawValue: modeName) else {
+                self.log(.warning, "Unknown hook \(pointName) (\(modeName)).")
+                return false
+            }
+            if mode == .replace, let owner = AyuHooks.shared.replacingOwner(point), owner != self.id {
+                self.log(.warning, "\(point.rawValue) is already replaced by \(owner); registering as 'after'.")
+                AyuHooks.shared.register(point: point, mode: .after, owner: self.id, handler: { [weak self] text, context in
+                    return self?.callTextHandler(handler, text: text, context: context)
+                })
+                self.addSummary("\(point.rawValue): after")
+                return true
+            }
+            AyuHooks.shared.register(point: point, mode: mode, owner: self.id, handler: { [weak self] text, context in
+                return self?.callTextHandler(handler, text: text, context: context)
+            })
+            self.addSummary("\(point.rawValue): \(mode.rawValue)")
+            return true
+        }
+        let feature: @convention(block) (String, Bool) -> Bool = { [weak self] name, disabled in
+            guard let self else { return false }
+            guard let value = AyuHooks.Feature(rawValue: name) else {
+                self.log(.warning, "Unknown feature \(name).")
+                return false
+            }
+            AyuHooks.shared.setFeature(value, disabled: disabled, owner: self.id)
+            if disabled { self.addSummary("feature off: \(name)") }
+            return true
+        }
+        let on: @convention(block) (String, JSValue) -> Void = { [weak self] event, handler in
+            self?.events[event, default: []].append(handler)
+        }
+        let storageGet: @convention(block) (String) -> String? = { [weak self] key in
+            guard let self else { return nil }
+            let storage = UserDefaults.standard.dictionary(forKey: AyuScriptInstance.storageKey(self.id)) as? [String: String]
+            return storage?[key]
+        }
+        let storageSet: @convention(block) (String, String?) -> Void = { [weak self] key, value in
+            guard let self else { return }
+            var storage = (UserDefaults.standard.dictionary(forKey: AyuScriptInstance.storageKey(self.id)) as? [String: String]) ?? [:]
+            storage[key] = value
+            // 64 KiB per plugin keeps UserDefaults small.
+            let size = storage.reduce(0) { $0 + $1.key.utf8.count + $1.value.utf8.count }
+            guard size <= 64 * 1024 else {
+                self.log(.warning, "Storage limit (64 KB) reached; \(key) was not saved.")
+                return
+            }
+            UserDefaults.standard.set(storage, forKey: AyuScriptInstance.storageKey(self.id))
+        }
+        let toast: @convention(block) (String) -> Void = { [weak self] text in
+            self?.runtime?.toast(String(text.prefix(200)))
+        }
+        let setTimer: @convention(block) (JSValue, Double, Bool) -> Int = { [weak self] handler, milliseconds, repeats in
+            guard let self, !self.stopped else { return 0 }
+            let id = self.nextTimer
+            self.nextTimer += 1
+            self.schedule(id: id, handler: handler, milliseconds: min(86_400_000.0, max(repeats ? 100.0 : 0.0, milliseconds.isFinite ? milliseconds : 0.0)), repeats: repeats)
+            return id
+        }
+        let clearTimer: @convention(block) (Int) -> Void = { [weak self] id in
+            self?.timers.removeValue(forKey: id)?.cancel()
+        }
+
+        // Passed as `Any`, a Swift closure would be boxed and JavaScript could not call it;
+        // the bit cast hands JavaScriptCore the real Objective-C block.
+        host.setObject(unsafeBitCast(log, to: AnyObject.self), forKeyedSubscript: "log" as NSString)
+        host.setObject(unsafeBitCast(hook, to: AnyObject.self), forKeyedSubscript: "hook" as NSString)
+        host.setObject(unsafeBitCast(feature, to: AnyObject.self), forKeyedSubscript: "feature" as NSString)
+        host.setObject(unsafeBitCast(on, to: AnyObject.self), forKeyedSubscript: "on" as NSString)
+        host.setObject(unsafeBitCast(storageGet, to: AnyObject.self), forKeyedSubscript: "storageGet" as NSString)
+        host.setObject(unsafeBitCast(storageSet, to: AnyObject.self), forKeyedSubscript: "storageSet" as NSString)
+        host.setObject(unsafeBitCast(toast, to: AnyObject.self), forKeyedSubscript: "toast" as NSString)
+        host.setObject(unsafeBitCast(setTimer, to: AnyObject.self), forKeyedSubscript: "setTimer" as NSString)
+        host.setObject(unsafeBitCast(clearTimer, to: AnyObject.self), forKeyedSubscript: "clearTimer" as NSString)
+        host.setObject(self.id, forKeyedSubscript: "pluginId" as NSString)
+        context.setObject(host, forKeyedSubscript: "__ayuHost" as NSString)
+    }
+
+    private func schedule(id: Int, handler: JSValue, milliseconds: Double, repeats: Bool) {
+        let item = DispatchWorkItem { [weak self] in
+            guard let self, !self.stopped, self.timers[id] != nil else { return }
+            if !repeats { self.timers.removeValue(forKey: id) }
+            handler.call(withArguments: [])
+            if repeats, self.timers[id] != nil {
+                self.schedule(id: id, handler: handler, milliseconds: milliseconds, repeats: true)
+            }
+        }
+        self.timers[id] = item
+        self.queue.asyncAfter(deadline: .now() + .milliseconds(Int(milliseconds)), execute: item)
+    }
+
+    /// The JavaScript side of the API, plus a small WhiteGram (`wg`) compatibility layer.
+    static let prelude = """
+    (function (root) {
+        'use strict';
+        const host = root.__ayuHost;
+        delete root.__ayuHost;
+        const text = (value) => String(value === undefined || value === null ? '' : value);
+        const fmt = (args) => Array.prototype.map.call(args, (v) => typeof v === 'string' ? v : (() => { try { return JSON.stringify(v); } catch (e) { return String(v); } })()).join(' ');
+        function register(point, mode, fn) {
+            if (typeof fn !== 'function') throw new TypeError('Hook handler must be a function');
+            return host.hook(text(point), mode, function (value, ctx) {
+                const result = fn(value, ctx);
+                return typeof result === 'string' ? result : undefined;
+            });
+        }
+        const ayu = Object.freeze({
+            pluginId: host.pluginId,
+            log: function () { host.log('info', fmt(arguments)); },
+            warn: function () { host.log('warning', fmt(arguments)); },
+            error: function () { host.log('error', fmt(arguments)); },
+            toast: (value) => host.toast(text(value)),
+            on: (event, fn) => { if (typeof fn === 'function') host.on(text(event), fn); },
+            hooks: Object.freeze({
+                before: (point, fn) => register(point, 'before', fn),
+                after: (point, fn) => register(point, 'after', fn),
+                replace: (point, fn) => register(point, 'replace', fn),
+                points: Object.freeze({ outgoingText: 'message.outgoing.text' })
+            }),
+            features: Object.freeze({
+                disable: (name) => host.feature(text(name), true),
+                enable: (name) => host.feature(text(name), false)
+            }),
+            storage: Object.freeze({
+                get: (key) => { const v = host.storageGet(text(key)); return v === undefined ? null : v; },
+                set: (key, value) => host.storageSet(text(key), value === null || value === undefined ? null : text(value))
+            })
+        });
+        root.ayu = ayu;
+        root.setTimeout = (fn, ms) => host.setTimer(fn, Number(ms) || 0, false);
+        root.setInterval = (fn, ms) => host.setTimer(fn, Number(ms) || 0, true);
+        root.clearTimeout = (id) => host.clearTimer(Number(id) || 0);
+        root.clearInterval = root.clearTimeout;
+        root.console = Object.freeze({ log: ayu.log, info: ayu.log, warn: ayu.warn, error: ayu.error, debug: ayu.log });
+        root.print = ayu.log;
+        class BasePlugin { onLoad() {} onUnload() {} }
+        let registered = null;
+        root.wg = Object.freeze({
+            BasePlugin: BasePlugin,
+            on: ayu.on,
+            log: ayu.log,
+            toast: ayu.toast,
+            getStorage: ayu.storage.get,
+            setStorage: ayu.storage.set,
+            registerPlugin: (plugin) => {
+                if (!plugin || registered) throw new Error('Only one plugin may be registered');
+                registered = plugin;
+                if (typeof plugin.onLoad === 'function') plugin.onLoad();
+                if (typeof plugin.onUnload === 'function') ayu.on('unload', () => plugin.onUnload());
+            },
+            hooks: ayu.hooks,
+            features: ayu.features
+        });
+    })(globalThis);
+    """
+}
