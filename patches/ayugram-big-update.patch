@@ -0,0 +1,285 @@
+import Foundation
+import Security
+
+/// Small Keychain store: the GitHub token for cloud builds and plugins' `ayu.secrets`.
+public enum AyuKeychain {
+    private static let service = "AyuGram.Secrets"
+
+    public static func get(_ account: String) -> String? {
+        let query: [String: Any] = [kSecClass as String: kSecClassGenericPassword, kSecAttrService as String: service, kSecAttrAccount as String: account, kSecReturnData as String: true, kSecMatchLimit as String: kSecMatchLimitOne]
+        var result: AnyObject?
+        guard SecItemCopyMatching(query as CFDictionary, &result) == errSecSuccess, let data = result as? Data else { return nil }
+        return String(data: data, encoding: .utf8)
+    }
+
+    @discardableResult
+    public static func set(_ account: String, _ value: String?) -> Bool {
+        let base: [String: Any] = [kSecClass as String: kSecClassGenericPassword, kSecAttrService as String: service, kSecAttrAccount as String: account]
+        SecItemDelete(base as CFDictionary)
+        guard let value, !value.isEmpty else { return true }
+        var item = base
+        item[kSecValueData as String] = Data(value.utf8)
+        item[kSecAttrAccessible as String] = kSecAttrAccessibleAfterFirstUnlockThisDeviceOnly
+        return SecItemAdd(item as CFDictionary, nil) == errSecSuccess
+    }
+
+    /// Every key of one plugin, for removal with the plugin.
+    public static func removeAll(prefix: String) {
+        let query: [String: Any] = [kSecClass as String: kSecClassGenericPassword, kSecAttrService as String: service, kSecReturnAttributes as String: true, kSecMatchLimit as String: kSecMatchLimitAll]
+        var result: AnyObject?
+        guard SecItemCopyMatching(query as CFDictionary, &result) == errSecSuccess, let items = result as? [[String: Any]] else { return }
+        for item in items {
+            if let account = item[kSecAttrAccount as String] as? String, account.hasPrefix(prefix) {
+                AyuKeychain.set(account, nil)
+            }
+        }
+    }
+}
+
+/// Cloud builds of plugins in github.com/murk-sus/AyuGramm-Plugins (developers/README.md there):
+/// the source goes to the `beta` branch in the developer's own name, GitHub Actions builds it,
+/// and the result is installed on this device only.
+public final class AyuCloudBuild {
+    public enum Failure: Error {
+        case noToken
+        case notDeveloper
+        case github(Int, String)
+        case build(String)
+        case timeout
+        case invalid
+
+        public func text(_ russian: Bool) -> String {
+            switch self {
+            case .noToken: return russian ? "Добавьте токен GitHub в «Инструменты»." : "Add a GitHub token in Tools."
+            case .notDeveloper: return russian ? "Вашего Telegram ID нет в списке разработчиков. Соберите плагин на компьютере с SDK." : "Your Telegram ID is not in the developer list. Build the plugin on your computer with the SDK."
+            case let .github(code, message): return (russian ? "GitHub ответил \(code): " : "GitHub answered \(code): ") + message
+            case let .build(log): return (russian ? "Сборка не удалась:\n" : "The build failed:\n") + log
+            case .timeout: return russian ? "Сборка не закончилась за 8 минут. Проверьте вкладку Actions в репозитории." : "The build did not finish in 8 minutes. Check the repository's Actions tab."
+            case .invalid: return russian ? "Неверный ответ GitHub." : "Unexpected GitHub answer."
+            }
+        }
+    }
+
+    public static let repository = "murk-sus/AyuGramm-Plugins"
+    public static let tokenKey = "github.token"
+    public static let shared = AyuCloudBuild()
+
+    private let session: URLSession = {
+        let configuration = URLSessionConfiguration.ephemeral
+        configuration.timeoutIntervalForRequest = 30.0
+        configuration.requestCachePolicy = .reloadIgnoringLocalCacheData
+        return URLSession(configuration: configuration)
+    }()
+
+    public static var hasToken: Bool {
+        return !(AyuKeychain.get(tokenKey) ?? "").isEmpty
+    }
+
+    private func api(_ method: String, _ path: String, body: [String: Any]? = nil, completion: @escaping (Int, [String: Any]?) -> Void) {
+        guard let token = AyuKeychain.get(AyuCloudBuild.tokenKey), let url = URL(string: "https://api.github.com/repos/\(AyuCloudBuild.repository)/" + path) else {
+            return completion(0, nil)
+        }
+        var request = URLRequest(url: url)
+        request.httpMethod = method
+        request.setValue("Bearer " + token, forHTTPHeaderField: "Authorization")
+        request.setValue("application/vnd.github+json", forHTTPHeaderField: "Accept")
+        request.setValue("2022-11-28", forHTTPHeaderField: "X-GitHub-Api-Version")
+        if let body {
+            request.httpBody = try? JSONSerialization.data(withJSONObject: body)
+            request.setValue("application/json", forHTTPHeaderField: "Content-Type")
+        }
+        self.session.dataTask(with: request, completionHandler: { data, response, _ in
+            let status = (response as? HTTPURLResponse)?.statusCode ?? 0
+            let json = data.flatMap { try? JSONSerialization.jsonObject(with: $0) as? [String: Any] }
+            completion(status, json)
+        }).resume()
+    }
+
+    private func fileContent(_ json: [String: Any]?) -> Data? {
+        guard let encoded = json?["content"] as? String else { return nil }
+        return Data(base64Encoded: encoded.replacingOccurrences(of: "\n", with: ""))
+    }
+
+    /// Builds `source` in the cloud and returns the built plugin file (name, data).
+    public func build(source: Data, filename: String, telegramId: Int64, progress: @escaping (String) -> Void, completion: @escaping (Result<(String, Data), Failure>) -> Void) {
+        guard AyuCloudBuild.hasToken else { return completion(.failure(.noToken)) }
+        let safeName = String(filename.unicodeScalars.filter { CharacterSet.alphanumerics.contains($0) || $0 == "." || $0 == "-" || $0 == "_" }.prefix(80))
+        guard !safeName.isEmpty else { return completion(.failure(.invalid)) }
+        let id = String(telegramId)
+        progress("ID")
+        self.api("GET", "contents/developers/ID?ref=main", completion: { [weak self] status, json in
+            guard let self else { return }
+            guard status == 200, let data = self.fileContent(json), let text = String(data: data, encoding: .utf8) else {
+                return completion(.failure(.github(status, (json?["message"] as? String) ?? "developers/ID")))
+            }
+            guard text.split(whereSeparator: { $0 == "\n" || $0 == " " || $0 == "\r" }).map(String.init).contains(id) else {
+                return completion(.failure(.notDeveloper))
+            }
+            self.ensureBranch(completion: { ok in
+                guard ok else { return completion(.failure(.github(0, "beta"))) }
+                let path = "beta-src/\(id)/\(safeName)"
+                self.api("GET", "contents/\(path)?ref=beta", completion: { _, existing in
+                    var body: [String: Any] = ["message": "Cloud build: \(safeName)", "content": source.base64EncodedString(), "branch": "beta"]
+                    if let sha = existing?["sha"] as? String {
+                        body["sha"] = sha
+                    }
+                    progress("upload")
+                    let started = Date()
+                    self.api("PUT", "contents/\(path)", body: body, completion: { status, json in
+                        guard status == 200 || status == 201 else {
+                            return completion(.failure(.github(status, (json?["message"] as? String) ?? "")))
+                        }
+                        progress("build")
+                        self.poll(id: id, name: safeName, started: started, attempt: 0, progress: progress, completion: completion)
+                    })
+                })
+            })
+        })
+    }
+
+    private func ensureBranch(completion: @escaping (Bool) -> Void) {
+        self.api("GET", "git/ref/heads/beta", completion: { [weak self] status, _ in
+            guard let self else { return }
+            if status == 200 {
+                return completion(true)
+            }
+            self.api("GET", "git/ref/heads/main", completion: { status, json in
+                guard status == 200, let object = json?["object"] as? [String: Any], let sha = object["sha"] as? String else {
+                    return completion(false)
+                }
+                self.api("POST", "git/refs", body: ["ref": "refs/heads/beta", "sha": sha], completion: { status, _ in
+                    completion(status == 201)
+                })
+            })
+        })
+    }
+
+    private func poll(id: String, name: String, started: Date, attempt: Int, progress: @escaping (String) -> Void, completion: @escaping (Result<(String, Data), Failure>) -> Void) {
+        guard attempt < 60 else { return completion(.failure(.timeout)) }
+        DispatchQueue.global().asyncAfter(deadline: .now() + (attempt == 0 ? 20.0 : 8.0)) { [weak self] in
+            guard let self else { return }
+            self.api("GET", "contents/beta-out/\(id)/\(name).status.json?ref=beta", completion: { status, json in
+                let formatter = ISO8601DateFormatter()
+                formatter.formatOptions = [.withInternetDateTime, .withFractionalSeconds]
+                guard status == 200, let data = self.fileContent(json),
+                      let result = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
+                      let at = (result["at"] as? String).flatMap(formatter.date(from:)), at >= started.addingTimeInterval(-30.0) else {
+                    return self.poll(id: id, name: name, started: started, attempt: attempt + 1, progress: progress, completion: completion)
+                }
+                guard result["ok"] as? Bool == true, let output = result["output"] as? String else {
+                    return completion(.failure(.build((result["error"] as? String) ?? "")))
+                }
+                progress("download")
+                self.api("GET", "contents/beta-out/\(id)/\(output)?ref=beta", completion: { status, json in
+                    if let data = self.fileContent(json) {
+                        completion(.success((output, data)))
+                    } else if let downloadUrl = (json?["download_url"] as? String).flatMap(URL.init(string:)) {
+                        self.session.dataTask(with: downloadUrl, completionHandler: { data, _, _ in
+                            if let data {
+                                completion(.success((output, data)))
+                            } else {
+                                completion(.failure(.invalid))
+                            }
+                        }).resume()
+                    } else {
+                        completion(.failure(.github(status, output)))
+                    }
+                })
+            })
+        }
+    }
+}
+
+/// Hot reload from a computer: `ayu dev plugin.js` serves the file over WebSocket, AyuGram
+/// connects in developer mode and reinstalls the plugin on every save.
+public final class AyuHotReload {
+    public static let shared = AyuHotReload()
+    public static let addressKey = "ayu.dev.hotReloadAddress"
+    public static let didChangeNotification = Notification.Name("AyuGram.HotReloadChanged")
+
+    private var task: URLSessionWebSocketTask?
+    private let session = URLSession(configuration: .ephemeral)
+    public private(set) var status: String = ""
+
+    public var isConnected: Bool {
+        return self.task != nil
+    }
+
+    public static var address: String {
+        get { return UserDefaults.standard.string(forKey: addressKey) ?? "" }
+        set { UserDefaults.standard.set(newValue.trimmingCharacters(in: .whitespacesAndNewlines), forKey: addressKey) }
+    }
+
+    public func connect(acceptedRisk: Bool) {
+        self.disconnect()
+        var text = AyuHotReload.address
+        if !text.contains("://") {
+            text = "ws://" + text
+        }
+        if URL(string: text)?.port == nil {
+            text += ":8765"
+        }
+        guard let url = URL(string: text), url.scheme == "ws" || url.scheme == "wss" else {
+            self.update("invalid address")
+            return
+        }
+        let task = self.session.webSocketTask(with: url)
+        self.task = task
+        task.resume()
+        self.update("connected to \(url.host ?? "")")
+        self.send(["type": "hello", "client": "AyuGram iOS"])
+        self.receive(acceptedRisk: acceptedRisk)
+    }
+
+    public func disconnect() {
+        self.task?.cancel(with: .goingAway, reason: nil)
+        self.task = nil
+        self.update("")
+    }
+
+    private func update(_ status: String) {
+        self.status = status
+        DispatchQueue.main.async {
+            NotificationCenter.default.post(name: AyuHotReload.didChangeNotification, object: nil)
+        }
+    }
+
+    private func send(_ object: [String: Any]) {
+        guard let data = try? JSONSerialization.data(withJSONObject: object), let text = String(data: data, encoding: .utf8) else { return }
+        self.task?.send(.string(text), completionHandler: { _ in })
+    }
+
+    private func receive(acceptedRisk: Bool) {
+        guard let task = self.task else { return }
+        task.receive(completionHandler: { [weak self] result in
+            guard let self, self.task === task else { return }
+            switch result {
+            case let .failure(error):
+                self.task = nil
+                self.update("disconnected: \(error.localizedDescription)")
+            case let .success(message):
+                var payload: Data?
+                switch message {
+                case let .string(text): payload = text.data(using: .utf8)
+                case let .data(data): payload = data
+                @unknown default: payload = nil
+                }
+                if let payload, let json = try? JSONSerialization.jsonObject(with: payload) as? [String: Any], json["type"] as? String == "plugin",
+                   let filename = json["filename"] as? String, let encoded = json["source"] as? String, let data = Data(base64Encoded: encoded) {
+                    DispatchQueue.main.async {
+                        do {
+                            let plugin = try AyuScriptRuntime.shared.install(data, filename: filename, official: false, acceptedRisk: acceptedRisk)
+                            AyuScriptRuntime.shared.setEnabled(plugin.id, true)
+                            self.send(["type": "installed", "id": plugin.id, "name": plugin.name])
+                            self.update("reloaded \(plugin.name)")
+                        } catch {
+                            self.send(["type": "error", "message": String(describing: error)])
+                            self.update("install failed")
+                        }
+                    }
+                }
+                self.receive(acceptedRisk: acceptedRisk)
+            }
+        })
+    }
+}
