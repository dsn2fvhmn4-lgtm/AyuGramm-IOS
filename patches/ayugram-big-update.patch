diff --git a/submodules/AyuPluginEngines/BUILD b/submodules/AyuPluginEngines/BUILD
new file mode 100644
index 00000000..f5ffea51
--- /dev/null
+++ b/submodules/AyuPluginEngines/BUILD
@@ -0,0 +1,62 @@
+load("@rules_cc//cc:cc_library.bzl", "cc_library")
+load("@rules_cc//cc:objc_library.bzl", "objc_library")
+
+# PocketPy 2.1.8 (MIT), vendored verbatim. Built without the os layer (no files, sockets,
+# system() or dlopen) and without threads; the watchdog bounds every plugin call.
+cc_library(
+    name = "pocketpy",
+    srcs = ["Vendor/pocketpy/pocketpy.c"],
+    hdrs = ["Vendor/pocketpy/pocketpy.h"],
+    includes = ["Vendor/pocketpy"],
+    defines = [
+        "PK_ENABLE_OS=0",
+        "PK_ENABLE_THREADS=0",
+        "PK_ENABLE_WATCHDOG=1",
+    ],
+    copts = [
+        "-std=gnu11",
+        "-w",
+    ],
+)
+
+# Lua 5.4.7 (MIT), vendored verbatim: core plus the base, coroutine, string, table, math and
+# utf8 libraries. io, os, package and debug are not built, so plugins cannot reach files.
+cc_library(
+    name = "lua",
+    srcs = glob(["Vendor/lua/*.c"]),
+    hdrs = glob(["Vendor/lua/*.h"]),
+    includes = ["Vendor/lua"],
+    copts = [
+        "-std=gnu11",
+        "-w",
+    ],
+)
+
+objc_library(
+    name = "AyuPluginEngines",
+    enable_modules = True,
+    module_name = "AyuPluginEngines",
+    srcs = glob([
+        "Sources/*.c",
+    ]),
+    hdrs = glob([
+        "PublicHeaders/**/*.h",
+    ]),
+    includes = [
+        "PublicHeaders",
+    ],
+    copts = [
+        "-Ithird-party/wamr/core/iwasm/include",
+    ],
+    deps = [
+        ":pocketpy",
+        ":lua",
+        "//third-party/wamr:wamr",
+    ],
+    sdk_frameworks = [
+        "Foundation",
+    ],
+    visibility = [
+        "//visibility:public",
+    ],
+)
diff --git a/submodules/AyuPluginEngines/PublicHeaders/AyuPluginEngines/AyuPluginEngines.h b/submodules/AyuPluginEngines/PublicHeaders/AyuPluginEngines/AyuPluginEngines.h
new file mode 100644
index 00000000..051262d0
--- /dev/null
+++ b/submodules/AyuPluginEngines/PublicHeaders/AyuPluginEngines/AyuPluginEngines.h
@@ -0,0 +1,65 @@
+#ifndef AYU_PLUGIN_ENGINES_H
+#define AYU_PLUGIN_ENGINES_H
+
+#include <stdint.h>
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/// AyuGram code-plugin engines for Python (PocketPy) and Rust/WebAssembly (WAMR interpreter).
+/// Both talk to the app through one JSON channel: the plugin sends requests to `host`, and the
+/// app sends requests to the plugin with `*_dispatch`. Strings are UTF-8 and NUL-terminated;
+/// every returned string is malloc'ed and freed with `ayu_engine_free`.
+///
+/// Neither engine has file, network, process or native-code access: PocketPy is built without
+/// its `os` layer and file imports are refused; WebAssembly only sees the `ayu.host` import.
+
+/// Answers one plugin request. Returns a malloc'ed JSON string, or NULL for "no answer".
+typedef char *_Nullable (*AyuEngineHostFunction)(void *_Nullable context, const char *_Nonnull request);
+
+void ayu_engine_free(char *_Nullable string);
+
+// MARK: Python
+
+/// All Python calls must come from one serial thread. Returns a handle (>= 1) or -1, with a
+/// malloc'ed message in `error`. At most 15 Python plugins run at once.
+int ayu_python_create(const char *_Nonnull source, const char *_Nonnull filename, int32_t timeout_ms, AyuEngineHostFunction _Nonnull host, void *_Nullable context, char *_Nullable *_Nullable error);
+
+/// Calls the plugin's `__ayu_dispatch(request)`; a loop running longer than `timeout_ms` of CPU
+/// time is stopped with an exception.
+char *_Nullable ayu_python_dispatch(int handle, const char *_Nonnull request, int32_t timeout_ms, char *_Nullable *_Nullable error);
+
+void ayu_python_destroy(int handle);
+
+// MARK: WebAssembly
+
+typedef struct AyuWasmPlugin AyuWasmPlugin;
+
+/// Loads and instantiates a module exporting `memory`, `ayu_alloc(len) -> ptr`,
+/// `ayu_dispatch(ptr, len) -> i64 (ptr << 32 | len)` and optionally `ayu_free(ptr, len)` and
+/// `ayu_init()`. Each plugin must be used from one thread at a time.
+AyuWasmPlugin *_Nullable ayu_wasm_create(const uint8_t *_Nonnull bytes, uint32_t size, AyuEngineHostFunction _Nonnull host, void *_Nullable context, char *_Nullable *_Nullable error);
+
+char *_Nullable ayu_wasm_dispatch(AyuWasmPlugin *_Nonnull plugin, const char *_Nonnull request, char *_Nullable *_Nullable error);
+
+void ayu_wasm_destroy(AyuWasmPlugin *_Nullable plugin);
+
+// MARK: Lua
+
+typedef struct AyuLuaPlugin AyuLuaPlugin;
+
+/// Lua 5.4 with the base (no file loading), coroutine, string, table, math and utf8 libraries.
+/// Each plugin has its own state and must be used from one thread at a time.
+AyuLuaPlugin *_Nullable ayu_lua_create(const char *_Nonnull source, const char *_Nonnull filename, int32_t timeout_ms, AyuEngineHostFunction _Nonnull host, void *_Nullable context, char *_Nullable *_Nullable error);
+
+char *_Nullable ayu_lua_dispatch(AyuLuaPlugin *_Nonnull plugin, const char *_Nonnull request, int32_t timeout_ms, char *_Nullable *_Nullable error);
+
+void ayu_lua_destroy(AyuLuaPlugin *_Nullable plugin);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/submodules/AyuPluginEngines/Sources/AyuLuaEngine.c b/submodules/AyuPluginEngines/Sources/AyuLuaEngine.c
new file mode 100644
index 00000000..ceb1994d
--- /dev/null
+++ b/submodules/AyuPluginEngines/Sources/AyuLuaEngine.c
@@ -0,0 +1,365 @@
+#include <AyuPluginEngines/AyuPluginEngines.h>
+
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#include "lua.h"
+#include "lauxlib.h"
+#include "lualib.h"
+
+// Lua plugins: one lua_State per plugin, only the safe standard libraries (base without file
+// loading, coroutine, string, table, math, utf8). A count hook stops a call that runs longer than
+// its CPU-time limit. The `ayu` API is the same JSON channel as the other engines.
+
+struct AyuLuaPlugin {
+    lua_State *state;
+    AyuEngineHostFunction host;
+    void *context;
+    clock_t deadline;
+    size_t allocated_bytes;
+};
+
+static const char *ayu_lua_prelude =
+    "local host = _ayuhost_call\n"
+    "_ayuhost_call = nil\n"
+    // A compact JSON codec (objects, arrays, strings with escapes, numbers, booleans, null).
+    "local json = {}\n"
+    "local escapes = { ['\"'] = '\\\\\"', ['\\\\'] = '\\\\\\\\', ['\\b'] = '\\\\b', ['\\f'] = '\\\\f', ['\\n'] = '\\\\n', ['\\r'] = '\\\\r', ['\\t'] = '\\\\t' }\n"
+    "local function encode_string(s)\n"
+    "  return '\"' .. s:gsub('[%c\"\\\\]', function(c) return escapes[c] or string.format('\\\\u%04x', c:byte()) end) .. '\"'\n"
+    "end\n"
+    "local function is_array(t)\n"
+    "  local n = 0\n"
+    "  for k in pairs(t) do\n"
+    "    if type(k) ~= 'number' then return false end\n"
+    "    n = n + 1\n"
+    "  end\n"
+    "  for i = 1, n do if t[i] == nil then return false end end\n"
+    "  return true, n\n"
+    "end\n"
+    "function json.encode(v)\n"
+    "  local t = type(v)\n"
+    "  if v == nil or v == json.null then return 'null'\n"
+    "  elseif t == 'boolean' then return tostring(v)\n"
+    "  elseif t == 'number' then\n"
+    "    if v ~= v or v == math.huge or v == -math.huge then return 'null' end\n"
+    "    return math.type(v) == 'integer' and tostring(v) or string.format('%.14g', v)\n"
+    "  elseif t == 'string' then return encode_string(v)\n"
+    "  elseif t == 'table' then\n"
+    "    local array, n = is_array(v)\n"
+    "    local out = {}\n"
+    "    if array and n > 0 then\n"
+    "      for i = 1, n do out[#out + 1] = json.encode(v[i]) end\n"
+    "      return '[' .. table.concat(out, ',') .. ']'\n"
+    "    end\n"
+    "    for k, item in pairs(v) do\n"
+    "      if type(item) ~= 'function' then out[#out + 1] = encode_string(tostring(k)) .. ':' .. json.encode(item) end\n"
+    "    end\n"
+    "    return '{' .. table.concat(out, ',') .. '}'\n"
+    "  end\n"
+    "  return 'null'\n"
+    "end\n"
+    "json.null = setmetatable({}, { __tostring = function() return 'null' end })\n"
+    "local function decode(s, i)\n"
+    "  i = s:find('%S', i) or #s + 1\n"
+    "  local c = s:sub(i, i)\n"
+    "  if c == '{' then\n"
+    "    local obj = {}\n"
+    "    i = s:find('%S', i + 1)\n"
+    "    if s:sub(i, i) == '}' then return obj, i + 1 end\n"
+    "    while true do\n"
+    "      local key\n"
+    "      key, i = decode(s, i)\n"
+    "      i = s:find(':', i) + 1\n"
+    "      obj[key], i = decode(s, i)\n"
+    "      i = s:find('%S', i)\n"
+    "      local d = s:sub(i, i)\n"
+    "      i = i + 1\n"
+    "      if d == '}' then return obj, i end\n"
+    "    end\n"
+    "  elseif c == '[' then\n"
+    "    local arr = {}\n"
+    "    i = s:find('%S', i + 1)\n"
+    "    if s:sub(i, i) == ']' then return arr, i + 1 end\n"
+    "    while true do\n"
+    "      arr[#arr + 1], i = decode(s, i)\n"
+    "      i = s:find('%S', i)\n"
+    "      local d = s:sub(i, i)\n"
+    "      i = i + 1\n"
+    "      if d == ']' then return arr, i end\n"
+    "    end\n"
+    "  elseif c == '\"' then\n"
+    "    local out, j = {}, i + 1\n"
+    "    while true do\n"
+    "      local ch = s:sub(j, j)\n"
+    "      if ch == '\"' then return table.concat(out), j + 1 end\n"
+    "      if ch == '\\\\' then\n"
+    "        local e = s:sub(j + 1, j + 1)\n"
+    "        local map = { b = '\\b', f = '\\f', n = '\\n', r = '\\r', t = '\\t' }\n"
+    "        if e == 'u' then\n"
+    "          local code = tonumber(s:sub(j + 2, j + 5), 16) or 63\n"
+    "          if code >= 0xD800 and code <= 0xDBFF and s:sub(j + 6, j + 7) == '\\\\u' then\n"
+    "            local low = tonumber(s:sub(j + 8, j + 11), 16) or 0xDC00\n"
+    "            code = 0x10000 + (code - 0xD800) * 0x400 + (low - 0xDC00)\n"
+    "            j = j + 6\n"
+    "          end\n"
+    "          out[#out + 1] = utf8.char(code)\n"
+    "          j = j + 6\n"
+    "        else\n"
+    "          out[#out + 1] = map[e] or e\n"
+    "          j = j + 2\n"
+    "        end\n"
+    "      elseif ch == '' then error('unterminated string')\n"
+    "      else\n"
+    "        out[#out + 1] = ch\n"
+    "        j = j + 1\n"
+    "      end\n"
+    "    end\n"
+    "  elseif s:sub(i, i + 3) == 'true' then return true, i + 4\n"
+    "  elseif s:sub(i, i + 4) == 'false' then return false, i + 5\n"
+    "  elseif s:sub(i, i + 3) == 'null' then return nil, i + 4\n"
+    "  else\n"
+    "    local num = s:match('^-?%d+%.?%d*[eE]?[-+]?%d*', i)\n"
+    "    return tonumber(num), i + #num\n"
+    "  end\n"
+    "end\n"
+    "function json.decode(s)\n"
+    "  if s == nil or s == '' then return nil end\n"
+    "  local value = decode(s, 1)\n"
+    "  return value\n"
+    "end\n"
+    // The ayu API.
+    "local handlers, events, pending = {}, {}, {}\n"
+    "local next_handler, next_request = 1, 1\n"
+    "local function req(obj)\n"
+    "  local answer = host(json.encode(obj))\n"
+    "  return answer and json.decode(answer) or nil\n"
+    "end\n"
+    "ayu = { json = json }\n"
+    "function ayu.call(op, args)\n"
+    "  local obj = {}\n"
+    "  for k, v in pairs(args or {}) do obj[k] = v end\n"
+    "  obj.op = op\n"
+    "  return req(obj)\n"
+    "end\n"
+    "function ayu.request(op, options, fn)\n"
+    "  local rid = 'r' .. next_request\n"
+    "  next_request = next_request + 1\n"
+    "  if fn then pending[rid] = fn end\n"
+    "  local opts = {}\n"
+    "  for k, v in pairs(options or {}) do opts[k] = v end\n"
+    "  opts.requestId = rid\n"
+    "  return ayu.call(op, opts)\n"
+    "end\n"
+    "local function say(level, ...)\n"
+    "  local parts = {}\n"
+    "  for i = 1, select('#', ...) do parts[#parts + 1] = tostring(select(i, ...)) end\n"
+    "  req({ op = 'log', level = level, text = table.concat(parts, ' ') })\n"
+    "end\n"
+    "function ayu.log(...) say('info', ...) end\n"
+    "function ayu.warn(...) say('warning', ...) end\n"
+    "function ayu.error(...) say('error', ...) end\n"
+    "print = ayu.log\n"
+    "function ayu.toast(text) req({ op = 'toast', text = tostring(text or '') }) end\n"
+    "function ayu.on(event, fn)\n"
+    "  events[event] = events[event] or {}\n"
+    "  table.insert(events[event], fn)\n"
+    "  req({ op = 'on', event = event })\n"
+    "  return fn\n"
+    "end\n"
+    "ayu.points = { outgoing_text = 'message.outgoing.text', lyrics_text = 'lyrics.text', link_open = 'link.open', message_render = 'message.render', notification = 'notification.beforeShow' }\n"
+    "local function register(point, mode, fn)\n"
+    "  local hid = next_handler\n"
+    "  next_handler = next_handler + 1\n"
+    "  handlers[hid] = fn\n"
+    "  req({ op = 'hook', point = point, mode = mode, handler = hid })\n"
+    "  return fn\n"
+    "end\n"
+    "ayu.hooks = {\n"
+    "  before = function(point, fn) return register(point, 'before', fn) end,\n"
+    "  after = function(point, fn) return register(point, 'after', fn) end,\n"
+    "  replace = function(point, fn) return register(point, 'replace', fn) end\n"
+    "}\n"
+    "ayu.storage = {\n"
+    "  get = function(key) local r = req({ op = 'storage.get', key = tostring(key) }); return r and r.value end,\n"
+    "  set = function(key, value) req({ op = 'storage.set', key = tostring(key), value = value ~= nil and tostring(value) or nil }) end\n"
+    "}\n"
+    // Every other API as ayu.api('messages.send')({ peerId = ..., text = ... }).
+    "function ayu.api(op) return function(args) return ayu.call(op, args) end end\n"
+    "ayu.on('uiResult', function(payload)\n"
+    "  local fn = pending[payload.requestId]\n"
+    "  if fn then pending[payload.requestId] = nil; fn(payload.choice) end\n"
+    "end)\n"
+    "function __ayu_dispatch(request)\n"
+    "  local r = json.decode(request) or {}\n"
+    "  if r.op == 'hook' then\n"
+    "    local fn = handlers[r.handler]\n"
+    "    if not fn then return '{}' end\n"
+    "    local result = fn(r.text or '', r.ctx or {})\n"
+    "    return json.encode({ text = type(result) == 'string' and result or json.null })\n"
+    "  elseif r.op == 'event' then\n"
+    "    for _, fn in ipairs(events[r.event] or {}) do fn(r.payload or {}) end\n"
+    "  end\n"
+    "  return '{}'\n"
+    "end\n";
+
+static char *ayu_lua_strdup(const char *string) {
+    if (string == NULL) {
+        return NULL;
+    }
+    size_t length = strlen(string);
+    char *copy = malloc(length + 1);
+    if (copy != NULL) {
+        memcpy(copy, string, length + 1);
+    }
+    return copy;
+}
+
+static AyuLuaPlugin *ayu_lua_plugin(lua_State *state) {
+    AyuLuaPlugin *plugin = NULL;
+    lua_getallocf(state, (void **)&plugin);
+    return plugin;
+}
+
+// The allocator's user data is the plugin; memory per plugin is capped at 32 MB.
+static void *ayu_lua_alloc(void *ud, void *ptr, size_t osize, size_t nsize) {
+    AyuLuaPlugin *plugin = ud;
+    // For a fresh allocation Lua passes a type tag as osize, not an allocation size.
+    size_t previous_size = ptr != NULL ? osize : 0;
+    if (nsize == 0) {
+        free(ptr);
+        plugin->allocated_bytes -= previous_size;
+        return NULL;
+    }
+    size_t retained_bytes = plugin->allocated_bytes - previous_size;
+    if (nsize > 32 * 1024 * 1024 - retained_bytes) {
+        return NULL;
+    }
+    void *result = realloc(ptr, nsize);
+    if (result != NULL) {
+        plugin->allocated_bytes = retained_bytes + nsize;
+    }
+    return result;
+}
+
+static void ayu_lua_hook(lua_State *state, lua_Debug *debug) {
+    (void)debug;
+    AyuLuaPlugin *plugin = ayu_lua_plugin(state);
+    if (plugin != NULL && plugin->deadline != 0 && clock() > plugin->deadline) {
+        luaL_error(state, "the plugin ran out of time");
+    }
+}
+
+static int ayu_lua_host_call(lua_State *state) {
+    AyuLuaPlugin *plugin = ayu_lua_plugin(state);
+    const char *request = luaL_checkstring(state, 1);
+    char *answer = plugin != NULL && plugin->host != NULL ? plugin->host(plugin->context, request) : NULL;
+    if (answer != NULL) {
+        lua_pushstring(state, answer);
+        free(answer);
+    } else {
+        lua_pushnil(state);
+    }
+    return 1;
+}
+
+static void ayu_lua_set_deadline(AyuLuaPlugin *plugin, int32_t timeout_ms) {
+    plugin->deadline = timeout_ms > 0 ? clock() + (clock_t)((double)timeout_ms / 1000.0 * CLOCKS_PER_SEC) : 0;
+}
+
+AyuLuaPlugin *ayu_lua_create(const char *source, const char *filename, int32_t timeout_ms, AyuEngineHostFunction host, void *context, char **error) {
+    AyuLuaPlugin *plugin = calloc(1, sizeof(AyuLuaPlugin));
+    if (plugin == NULL) {
+        return NULL;
+    }
+    plugin->host = host;
+    plugin->context = context;
+    lua_State *state = lua_newstate(ayu_lua_alloc, plugin);
+    if (state == NULL) {
+        free(plugin);
+        if (error != NULL) {
+            *error = ayu_lua_strdup("Lua could not start.");
+        }
+        return NULL;
+    }
+    plugin->state = state;
+    // Safe libraries only, then remove whatever can reach files or load bytecode.
+    luaL_requiref(state, LUA_GNAME, luaopen_base, 1);
+    luaL_requiref(state, LUA_COLIBNAME, luaopen_coroutine, 1);
+    luaL_requiref(state, LUA_STRLIBNAME, luaopen_string, 1);
+    luaL_requiref(state, LUA_TABLIBNAME, luaopen_table, 1);
+    luaL_requiref(state, LUA_MATHLIBNAME, luaopen_math, 1);
+    luaL_requiref(state, LUA_UTF8LIBNAME, luaopen_utf8, 1);
+    lua_settop(state, 0);
+    const char *removed[] = { "dofile", "loadfile", "load", "collectgarbage", NULL };
+    for (int i = 0; removed[i] != NULL; i++) {
+        lua_pushnil(state);
+        lua_setglobal(state, removed[i]);
+    }
+    lua_pushcfunction(state, ayu_lua_host_call);
+    lua_setglobal(state, "_ayuhost_call");
+    lua_sethook(state, ayu_lua_hook, LUA_MASKCOUNT, 10000);
+
+    ayu_lua_set_deadline(plugin, timeout_ms);
+    int status = luaL_loadbufferx(state, ayu_lua_prelude, strlen(ayu_lua_prelude), "=prelude", "t");
+    if (status == LUA_OK) {
+        status = lua_pcall(state, 0, 0, 0);
+    }
+    if (status == LUA_OK) {
+        // "t": text only, a plugin cannot smuggle in precompiled bytecode.
+        status = luaL_loadbufferx(state, source, strlen(source), filename, "t");
+        if (status == LUA_OK) {
+            status = lua_pcall(state, 0, 0, 0);
+        }
+    }
+    plugin->deadline = 0;
+    if (status != LUA_OK) {
+        if (error != NULL) {
+            *error = ayu_lua_strdup(lua_tostring(state, -1));
+        }
+        lua_close(state);
+        free(plugin);
+        return NULL;
+    }
+    return plugin;
+}
+
+static int ayu_lua_dispatch_protected(lua_State *state) {
+    const char *request = lua_touserdata(state, 1);
+    lua_getglobal(state, "__ayu_dispatch");
+    if (!lua_isfunction(state, -1)) {
+        return luaL_error(state, "__ayu_dispatch is missing.");
+    }
+    // Allocating the request must be protected too: a full plugin heap must not panic/abort iOS.
+    lua_pushstring(state, request);
+    lua_call(state, 1, 1);
+    return 1;
+}
+
+char *ayu_lua_dispatch(AyuLuaPlugin *plugin, const char *request, int32_t timeout_ms, char **error) {
+    lua_State *state = plugin->state;
+    lua_settop(state, 0);
+    lua_pushcfunction(state, ayu_lua_dispatch_protected);
+    lua_pushlightuserdata(state, (void *)request);
+    ayu_lua_set_deadline(plugin, timeout_ms);
+    int status = lua_pcall(state, 1, 1, 0);
+    plugin->deadline = 0;
+    char *result = NULL;
+    if (status == LUA_OK) {
+        const char *text = lua_tostring(state, -1);
+        result = ayu_lua_strdup(text != NULL ? text : "{}");
+    } else if (error != NULL) {
+        *error = ayu_lua_strdup(lua_tostring(state, -1));
+    }
+    lua_settop(state, 0);
+    return result;
+}
+
+void ayu_lua_destroy(AyuLuaPlugin *plugin) {
+    if (plugin == NULL) {
+        return;
+    }
+    lua_close(plugin->state);
+    free(plugin);
+}
diff --git a/submodules/AyuPluginEngines/Sources/AyuPythonEngine.c b/submodules/AyuPluginEngines/Sources/AyuPythonEngine.c
