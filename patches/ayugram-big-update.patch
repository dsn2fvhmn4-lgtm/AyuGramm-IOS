+            py_push(self->f_get(self, i, j));
+            py_push(other->f_get(other, i, j));
+            if(!py_vectorcall(2, 0)) return false;
+            c11_array2d__set(res, i, j, py_retval());
+        }
+    }
+    py_assign(py_retval(), py_peek(-1));
+    py_pop();
+    return true;
