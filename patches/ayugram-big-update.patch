new file mode 100644
index 00000000..0e6ef85b
--- /dev/null
+++ b/submodules/AccountContext/Sources/AyuPluginKillSwitch.swift
@@ -0,0 +1,93 @@
+import Foundation
+import CryptoKit
+
+/// Remote kill switch for harmful plugins: registry/revoked.json in the plugin repository,
+/// signed with the AyuGram team key (the same key as the verification registry). Listed plugins
+/// are turned off and cannot be installed. An entry may name a single build by its SHA-256.
+public final class AyuPluginKillSwitch {
+    public struct Entry: Codable, Equatable {
+        public let id: String
+        public let sha256: String?
+        public let reason: String?
+    }
+
+    private struct List: Codable {
+        let format: String
+        let plugins: [Entry]
+    }
+
+    public static let shared = AyuPluginKillSwitch()
+    private static let publicKey = Data(base64Encoded: "GDJWDwzdxjryMJhA2dS+zM2p3AHK8O35B/cc5VjKcEU=")!
+    private static let baseURL = "https://raw.githubusercontent.com/murk-sus/AyuGramm-Plugins/main/registry/"
+
+    private let lock = NSLock()
+    private var entries: [Entry] = []
+    private var lastFetch: Date?
+
+    private var cacheURL: URL? {
+        return FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first?
+            .appendingPathComponent("AyuGram", isDirectory: true)
+            .appendingPathComponent("revoked.json")
+    }
+
+    private init() {
+        if let url = self.cacheURL, let data = try? Data(contentsOf: url), let signature = try? Data(contentsOf: url.appendingPathExtension("sig")) {
+            self.accept(data: data, signature: signature, save: false)
+        }
+    }
+
+    /// Why the plugin is revoked, or nil.
+    public func revocation(id: String, sha256: String?) -> Entry? {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return self.entries.first(where: { entry in
+            entry.id == id && (entry.sha256 == nil || entry.sha256?.lowercased() == sha256?.lowercased())
+        })
+    }
+
+    public func refresh() {
+        self.lock.lock()
+        if let lastFetch = self.lastFetch, Date().timeIntervalSince(lastFetch) < 60 * 60 {
+            self.lock.unlock()
+            return
+        }
+        self.lastFetch = Date()
+        self.lock.unlock()
+        let session = URLSession(configuration: .ephemeral)
+        func load(_ name: String, _ completion: @escaping (Data?) -> Void) {
+            guard let url = URL(string: AyuPluginKillSwitch.baseURL + name) else { return completion(nil) }
+            session.dataTask(with: url, completionHandler: { data, response, _ in
+                completion((response as? HTTPURLResponse)?.statusCode == 200 ? data : nil)
+            }).resume()
+        }
+        load("revoked.json", { [weak self] data in
+            load("revoked.json.sig", { signature in
+                if let self, let data, let signature {
+                    self.accept(data: data, signature: signature, save: true)
+                }
+                session.finishTasksAndInvalidate()
+            })
+        })
+    }
+
+    private func accept(data: Data, signature: Data, save: Bool) {
+        let text = String(decoding: signature, as: UTF8.self).trimmingCharacters(in: .whitespacesAndNewlines)
+        guard let signatureData = Data(base64Encoded: text),
+              let key = try? Curve25519.Signing.PublicKey(rawRepresentation: AyuPluginKillSwitch.publicKey),
+              key.isValidSignature(signatureData, for: data),
+              let list = try? JSONDecoder().decode(List.self, from: data), list.format == "ayugram-revoked" else {
+            return
+        }
+        self.lock.lock()
+        self.entries = list.plugins
+        self.lock.unlock()
+        if save, let url = self.cacheURL {
+            try? FileManager.default.createDirectory(at: url.deletingLastPathComponent(), withIntermediateDirectories: true)
+            try? data.write(to: url, options: .atomic)
+            try? signature.write(to: url.appendingPathExtension("sig"), options: .atomic)
+        }
+        DispatchQueue.main.async {
+            AyuScriptRuntime.shared.applyRevocations()
+        }
+    }
+}
diff --git a/submodules/AccountContext/Sources/AyuPluginServices.swift b/submodules/AccountContext/Sources/AyuPluginServices.swift
new file mode 100644
index 00000000..2e495f4e
--- /dev/null
+++ b/submodules/AccountContext/Sources/AyuPluginServices.swift
@@ -0,0 +1,118 @@
+import Foundation
+import Display
+
+/// What a plugin actually did: the APIs it called and the hosts it reached, shown on its details
+/// page ("privacy report"). Counts only; no arguments are kept.
+public final class AyuPluginPrivacy {
+    public struct Report {
+        public var calls: [String: Int] = [:]
+        public var hosts: [String: Int] = [:]
+        public var since = Date()
+    }
+
+    public static let shared = AyuPluginPrivacy()
+    private let lock = NSLock()
+    private var reports: [String: Report] = [:]
+
+    public func record(_ pluginId: String, api: String, host: String? = nil) {
+        self.lock.lock()
+        var report = self.reports[pluginId] ?? Report()
+        report.calls[api, default: 0] += 1
+        if let host {
+            report.hosts[host, default: 0] += 1
+        }
+        self.reports[pluginId] = report
+        self.lock.unlock()
+    }
+
+    public func report(_ pluginId: String) -> Report {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return self.reports[pluginId] ?? Report()
+    }
+
+    public func clear(_ pluginId: String) {
+        self.lock.lock()
+        self.reports[pluginId] = nil
+        self.lock.unlock()
+    }
+}
+
+/// Network and AI requests made for plugins.
+enum AyuPluginNetwork {
+    static let session: URLSession = {
+        let configuration = URLSessionConfiguration.ephemeral
+        configuration.timeoutIntervalForRequest = 30.0
+        configuration.httpCookieStorage = nil
+        configuration.urlCache = nil
+        configuration.httpAdditionalHeaders = ["User-Agent": "AyuGram-Plugin/27.5"]
+        return URLSession(configuration: configuration)
+    }()
+
+    /// HTTPS only, to the plugin's `@connect` hosts, redirects included.
+    static func fetch(pluginId: String, hosts: [String], args: [String: Any], completion: @escaping (Any) -> Void) {
+        guard let text = args["url"] as? String, let url = URL(string: text), url.scheme?.lowercased() == "https", let host = url.host else {
+            return completion(["error": "Only https:// URLs are allowed."])
+        }
+        guard AyuPluginGrants.allows(hosts, host: host) else {
+            return completion(["error": "\(host) is not in the plugin's @connect list."])
+        }
+        AyuPluginPrivacy.shared.record(pluginId, api: "net.fetch", host: host)
+        var request = URLRequest(url: url)
+        let method = ((args["method"] as? String) ?? "GET").uppercased()
+        request.httpMethod = ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD"].contains(method) ? method : "GET"
+        if let headers = args["headers"] as? [String: Any] {
+            for (name, value) in headers.prefix(32) where !["cookie", "host"].contains(name.lowercased()) {
+                request.setValue("\(value)", forHTTPHeaderField: name)
+            }
+        }
+        if let body = args["body"] as? String, body.utf8.count <= 1024 * 1024 {
+            request.httpBody = Data(body.utf8)
+        }
+        let task = session.dataTask(with: request, completionHandler: { data, response, error in
+            guard let http = response as? HTTPURLResponse else {
+                return completion(["error": error?.localizedDescription ?? "No response"])
+            }
+            if let finalHost = http.url?.host, !AyuPluginGrants.allows(hosts, host: finalHost) {
+                return completion(["error": "Redirected to \(finalHost), which is not in @connect."])
+            }
+            var headers: [String: String] = [:]
+            for (name, value) in http.allHeaderFields {
+                headers["\(name)".lowercased()] = "\(value)"
+            }
+            let body = data.flatMap { $0.count <= 2 * 1024 * 1024 ? String(data: $0, encoding: .utf8) : nil } ?? ""
+            completion(["status": http.statusCode, "headers": headers, "text": body])
+        })
+        task.resume()
+    }
+
+    /// The OpenAI-compatible service from AyuGram → Tools.
+    static func complete(pluginId: String, args: [String: Any], completion: @escaping (Any) -> Void) {
+        let key = AyuTools.aiKey
+        guard !key.isEmpty, let url = URL(string: AyuTools.aiEndpoint), url.scheme == "https" else {
+            return completion(["error": "No AI service is set up in AyuGram → Tools."])
+        }
+        AyuPluginPrivacy.shared.record(pluginId, api: "ai.complete", host: url.host)
+        var messages: [[String: String]] = []
+        if let system = args["system"] as? String, !system.isEmpty {
+            messages.append(["role": "system", "content": String(system.prefix(4000))])
+        }
+        messages.append(["role": "user", "content": String(((args["prompt"] as? String) ?? "").prefix(16000))])
+        var request = URLRequest(url: url)
+        request.httpMethod = "POST"
+        request.setValue("application/json", forHTTPHeaderField: "Content-Type")
+        request.setValue("Bearer " + key, forHTTPHeaderField: "Authorization")
+        let maxTokens = min(2000, max(16, (args["maxTokens"] as? NSNumber)?.intValue ?? 400))
+        request.httpBody = try? JSONSerialization.data(withJSONObject: ["model": AyuTools.aiModel, "max_tokens": maxTokens, "messages": messages])
+        session.dataTask(with: request, completionHandler: { data, response, _ in
+            let status = (response as? HTTPURLResponse)?.statusCode ?? 0
+            if status == 200, let data, let json = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
+               let choices = json["choices"] as? [[String: Any]], let message = choices.first?["message"] as? [String: Any],
+               let content = message["content"] as? String {
+                completion(["text": content])
+            } else {
+                completion(["error": "The AI service answered \(status)."])
+            }
+        }).resume()
+    }
+}
