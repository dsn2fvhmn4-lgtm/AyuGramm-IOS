--- /dev/null
+++ b/submodules/Display/Source/AyuAppearancePlus.swift
@@ -0,0 +1,100 @@
+import Foundation
+import UIKitRuntimeUtils
+
+/// App-wide appearance options from Settings → AyuGram → Appearance+.
+/// Glass and classic-design choices are read once per launch because glass views are
+/// created with their implementation fixed; tab visibility applies immediately.
+public enum AyuAppearancePlus {
+    public enum GlassStyle: String, CaseIterable {
+        /// iOS 26+ UIGlassEffect (falls back to Telegram's glass on older systems).
+        case system
+        /// Telegram's own glass renderer on every iOS version.
+        case telegram
+    }
+
+    public static let didChangeNotification = Notification.Name("AyuGram.AppearancePlusChanged")
+
+    private static let hideContactsKey = "ayu.appearance.hideContactsTab"
+    private static let hideCallsKey = "ayu.appearance.hideCallsTab"
+    private static let hideTabTitlesKey = "ayu.appearance.hideTabTitles"
+    private static let glassStyleKey = "ayu.appearance.glassStyle"
+    private static let classicDesignKey = "ayu.appearance.classicDesign"
+    private static let slowMotionKey = "ayu.appearance.slowMotion"
+
+    /// Slow-Motion choices for every animation in the client.
+    public static let slowMotionSteps: [Double] = [1.0, 2.0, 3.0, 5.0, 10.0]
+
+    /// 1 = off. Applies at once to Telegram's own animations and UIKit block animations.
+    public static var slowMotionFactor: Double {
+        get {
+            let value = UserDefaults.standard.double(forKey: slowMotionKey)
+            return value >= 1.0 ? value : 1.0
+        }
+        set {
+            set(max(1.0, min(20.0, newValue)), forKey: slowMotionKey)
+            ayuSetAnimationSlowMotionFactor(AyuAppearancePlus.slowMotionFactor)
+        }
+    }
+
+    /// Called once at launch so the saved factor is active before the first transition.
+    public static func applyAtLaunch() {
+        ayuSetAnimationSlowMotionFactor(AyuAppearancePlus.slowMotionFactor)
+    }
+
+    /// Values that only take effect after relaunch, captured at first access.
+    public static let launchGlassStyle: GlassStyle = AyuAppearancePlus.glassStyle
+    public static let launchClassicDesign: Bool = AyuAppearancePlus.classicDesign
+
+    public static var hideContactsTab: Bool {
+        get { return UserDefaults.standard.bool(forKey: hideContactsKey) }
+        set { set(newValue, forKey: hideContactsKey) }
+    }
+
+    public static var hideCallsTab: Bool {
+        get { return UserDefaults.standard.bool(forKey: hideCallsKey) }
+        set { set(newValue, forKey: hideCallsKey) }
+    }
+
+    public static var hideTabTitles: Bool {
+        get { return UserDefaults.standard.bool(forKey: hideTabTitlesKey) }
+        set { set(newValue, forKey: hideTabTitlesKey) }
+    }
+
+    public static var glassStyle: GlassStyle {
+        get { return UserDefaults.standard.string(forKey: glassStyleKey).flatMap(GlassStyle.init(rawValue:)) ?? .system }
+        set { set(newValue.rawValue, forKey: glassStyleKey) }
+    }
+
+    /// The pre-Liquid-Glass look: a full-width opaque tab bar and Telegram's flat glass.
+    public static var classicDesign: Bool {
+        get { return UserDefaults.standard.bool(forKey: classicDesignKey) }
+        set { set(newValue, forKey: classicDesignKey) }
+    }
+
+    /// True when Telegram's own glass renderer must replace the system one this launch.
+    public static var usesTelegramGlassThisLaunch: Bool {
+        return AyuAppearancePlus.launchGlassStyle == .telegram || AyuAppearancePlus.launchClassicDesign
+    }
+
+    public static var needsRelaunch: Bool {
+        return AyuAppearancePlus.glassStyle != AyuAppearancePlus.launchGlassStyle || AyuAppearancePlus.classicDesign != AyuAppearancePlus.launchClassicDesign
+    }
+
+    public static func resetAll() {
+        _ = AyuAppearancePlus.launchGlassStyle
+        _ = AyuAppearancePlus.launchClassicDesign
+        for key in [hideContactsKey, hideCallsKey, hideTabTitlesKey, glassStyleKey, classicDesignKey, slowMotionKey] {
+            UserDefaults.standard.removeObject(forKey: key)
+        }
+        ayuSetAnimationSlowMotionFactor(1.0)
+        NotificationCenter.default.post(name: didChangeNotification, object: nil)
+    }
+
+    private static func set(_ value: Any, forKey key: String) {
+        // Capture launch values before the first write changes what they would read.
+        _ = AyuAppearancePlus.launchGlassStyle
+        _ = AyuAppearancePlus.launchClassicDesign
+        UserDefaults.standard.set(value, forKey: key)
+        NotificationCenter.default.post(name: didChangeNotification, object: nil)
+    }
+}
diff --git a/submodules/Display/Source/AyuSettingsTransfer.swift b/submodules/Display/Source/AyuSettingsTransfer.swift
new file mode 100644
index 00000000..68b9ba65
--- /dev/null
+++ b/submodules/Display/Source/AyuSettingsTransfer.swift
@@ -0,0 +1,59 @@
+import Foundation
+
+/// WhiteGram-style settings portability: device-wide AyuGram preferences (WhiteGram,
+/// Appearance+, developer, lyrics sources, player) to and from a JSON file. Only `ayu.*`
+/// UserDefaults keys are included; account data, plugin storage and caches never are.
+public enum AyuSettingsTransfer {
+    public static let format = "ayugram-ios-settings"
+
+    /// Prefixes worth carrying between devices; plugin storage and remembered track identities stay local.
+    private static func isPortable(_ key: String) -> Bool {
+        guard key.hasPrefix("ayu.") else { return false }
+        let excluded = ["ayu.script.storage.", "ayu.music.identity.", "ayu.lyrics.", "ayu.developer."]
+        if key == "ayu.lyrics.providers.v1" { return true }
+        return !excluded.contains(where: { key.hasPrefix($0) })
+    }
+
+    public static func exportData() throws -> Data {
+        var values: [String: Any] = [:]
+        for (key, value) in UserDefaults.standard.dictionaryRepresentation() where self.isPortable(key) {
+            if let data = value as? Data {
+                values[key] = ["data": data.base64EncodedString()]
+            } else if JSONSerialization.isValidJSONObject([value]) {
+                values[key] = value
+            }
+        }
+        let document: [String: Any] = ["format": self.format, "version": 1, "exported": ISO8601DateFormatter().string(from: Date()), "values": values]
+        return try JSONSerialization.data(withJSONObject: document, options: [.prettyPrinted, .sortedKeys])
+    }
+
+    /// Writes the export to a temporary `.ayusettings` file for the share sheet.
+    public static func exportFile() throws -> URL {
+        let url = FileManager.default.temporaryDirectory.appendingPathComponent("AyuGram-settings.ayusettings")
+        try self.exportData().write(to: url, options: .atomic)
+        return url
+    }
+
+    /// Returns how many values were restored.
+    @discardableResult
+    public static func importData(_ data: Data) throws -> Int {
+        guard data.count <= 2 * 1024 * 1024,
+              let document = try JSONSerialization.jsonObject(with: data) as? [String: Any],
+              document["format"] as? String == self.format,
+              let values = document["values"] as? [String: Any] else {
+            throw CocoaError(.fileReadCorruptFile)
+        }
+        var restored = 0
+        for (key, value) in values where self.isPortable(key) {
+            if let wrapped = value as? [String: Any], let base64 = wrapped["data"] as? String, let data = Data(base64Encoded: base64) {
+                UserDefaults.standard.set(data, forKey: key)
+            } else {
+                UserDefaults.standard.set(value, forKey: key)
+            }
+            restored += 1
+        }
+        NotificationCenter.default.post(name: AyuWhiteGram.didChangeNotification, object: nil)
+        NotificationCenter.default.post(name: AyuAppearancePlus.didChangeNotification, object: nil)
+        return restored
+    }
+}
