diff --git a/submodules/TelegramCore/Sources/AyuGram/AyuAccountArchive.swift b/submodules/TelegramCore/Sources/AyuGram/AyuAccountArchive.swift
new file mode 100644
index 00000000..ee150ac6
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuGram/AyuAccountArchive.swift
@@ -0,0 +1,153 @@
+import Foundation
+import Postbox
+import SwiftSignalKit
+
+/// Opens retained accounts without constructing Account, Network, or any synchronization workers.
+public final class AyuAccountArchiveStore {
+    private let accountManager: AccountManager<TelegramAccountManagerTypes>
+    private let rootPath: String
+    private let encryptionParameters: ValueBoxEncryptionParameters
+
+    public init(accountManager: AccountManager<TelegramAccountManagerTypes>, rootPath: String, encryptionParameters: EngineValueBoxEncryptionParameters) {
+        self.accountManager = accountManager
+        self.rootPath = rootPath
+        self.encryptionParameters = encryptionParameters
+    }
+
+    public func list() -> Signal<[(AccountRecordId, AyuArchivedAccountInfo)], NoError> {
+        return self.accountManager.accountRecords() |> map { view in
+            return view.records.compactMap { record -> (AccountRecordId, AyuArchivedAccountInfo)? in
+                for attribute in record.attributes {
+                    if case let .loggedOut(value) = attribute, let archive = value.archive {
+                        return (record.id, archive)
+                    }
+                }
+                return nil
+            }.sorted { $0.1.timestamp > $1.1.timestamp }
+        }
+    }
+
+    public func open(id: AccountRecordId) -> Signal<AyuAccountArchive?, NoError> {
+        return self.list() |> take(1) |> mapToSignal { records in
+            guard records.contains(where: { $0.0 == id }) else { return .single(nil) }
+            let path = self.rootPath + "/" + accountRecordIdPathName(id) + "/postbox"
+            guard FileManager.default.fileExists(atPath: path + "/db/db_sqlite") else { return .single(nil) }
+            return openPostbox(basePath: path, seedConfiguration: telegramPostboxSeedConfiguration, encryptionParameters: self.encryptionParameters, timestampForAbsoluteTimeBasedOperations: Int32(clamping: Int64(Date().timeIntervalSince1970)), isMainProcess: false, isTemporary: false, isReadOnly: true, useCopy: false, useCaches: false, removeDatabaseOnError: false)
+            |> filter { result in
+                if case .upgrading = result { return false }
+                return true
+            }
+            |> take(1)
+            |> map { result -> AyuAccountArchive? in
+                if case let .postbox(database) = result { return AyuAccountArchive(database: database) }
+                return nil
+            }
+        }
+    }
+
+    /// The caller closes the reader before removing its record; normal cleanup removes the folder.
+    public func remove(id: AccountRecordId) -> Signal<Void, NoError> {
+        return self.accountManager.transaction { transaction in
+            transaction.updateRecord(id, { record in
+                guard let record else { return nil }
+                for attribute in record.attributes {
+                    if case let .loggedOut(value) = attribute, value.archive != nil { return nil }
+                }
+                return record
+            })
+        }
+    }
+}
+
+public final class AyuAccountArchive {
+    private let database: Postbox
+    fileprivate init(database: Postbox) { self.database = database }
+
+    public func chats() -> Signal<[EnginePeer], NoError> {
+        return self.database.transaction { transaction in
+            transaction.chatListGetAllPeerIds().compactMap { transaction.getPeer($0).map(EnginePeer.init) }
+        }
+    }
+
+    public func messages(peerId: EnginePeer.Id, before: EngineMessage.Index? = nil, limit: Int = 100) -> Signal<[EngineMessage], NoError> {
+        return self.database.transaction { transaction in
+            let namespace = peerId.namespace == Namespaces.Peer.SecretChat ? Namespaces.Message.Local : Namespaces.Message.Cloud
+            return transaction.getMessages(peerId: peerId, namespace: namespace, from: before ?? MessageIndex.upperBound(peerId: peerId, namespace: namespace), includeFrom: false, to: MessageIndex.lowerBound(peerId: peerId, namespace: namespace), limit: min(500, max(1, limit))).map(EngineMessage.init)
+        }
+    }
+
+    public func export(peerId: EnginePeer.Id, title: String) -> Signal<AyuChatExportEvent, AyuChatExportError> {
+        return Signal { subscriber in
+            let job = AyuArchiveExportJob(database: self.database, peerId: peerId, title: title, subscriber: subscriber)
+            job.start()
+            return ActionDisposable { job.cancel() }
+        }
+    }
+}
+
+/// Uses the existing disk-backed export format and never downloads missing history or media.
+private final class AyuArchiveExportJob {
+    private let database: Postbox
+    private let peerId: PeerId
+    private let title: String
+    private let subscriber: Subscriber<AyuChatExportEvent, AyuChatExportError>
+    private let queue = Queue(name: "AyuGram.ArchiveExport")
+    private let request = MetaDisposable()
+    private let cancelled = Atomic<Bool>(value: false)
+    private var writer: AyuChatExportWriter?
+    private var finished = false
+
+    init(database: Postbox, peerId: PeerId, title: String, subscriber: Subscriber<AyuChatExportEvent, AyuChatExportError>) {
+        self.database = database
+        self.peerId = peerId
+        self.title = title
+        self.subscriber = subscriber
+    }
+
+    func start() {
+        self.queue.async {
+            guard self.peerId.namespace != Namespaces.Peer.SecretChat else { self.subscriber.putError(.unsupported); return }
+            do {
+                var options = AyuChatExportOptions()
+                options.includeCachedMedia = false
+                self.writer = try AyuChatExportWriter(parent: FileManager.default.temporaryDirectory, options: options)
+                self.next(before: nil)
+            } catch { self.subscriber.putError(.storage) }
+        }
+    }
+
+    func cancel() {
+        let _ = self.cancelled.swap(true)
+        self.request.dispose()
+        self.queue.async { if !self.finished { self.writer?.discard() } }
+    }
+
+    private func next(before: MessageIndex?) {
+        guard !self.cancelled.with({ $0 }) else { return }
+        self.request.set((self.database.transaction { transaction -> [Message]? in
+            guard let peer = transaction.getPeer(self.peerId), !peer.isCopyProtectionEnabled else { return nil }
+            return transaction.getMessages(peerId: self.peerId, namespace: Namespaces.Message.Cloud, from: before ?? MessageIndex.upperBound(peerId: self.peerId, namespace: Namespaces.Message.Cloud), includeFrom: false, to: MessageIndex.lowerBound(peerId: self.peerId, namespace: Namespaces.Message.Cloud), limit: 100)
+        } |> deliverOn(self.queue)).start(next: { [weak self] messages in
+            guard let self, !self.cancelled.with({ $0 }), let writer = self.writer else { return }
+            guard let messages else { writer.discard(); self.subscriber.putError(.unsupported); return }
+            do {
+                let rows = messages.map { message -> AyuChatExportMessage in
+                    let protected = message.flags.contains(.CopyProtected) || message.attributes.contains(where: { $0 is AutoremoveTimeoutMessageAttribute || $0 is AutoclearTimeoutMessageAttribute || $0 is EphemeralMessageAttribute || $0 is EphemeralReplacementMessageAttribute || $0 is EphemeralOutgoingMessageAttribute })
+                    return AyuChatExportMessage(id: message.id.id, timestamp: message.timestamp, author: message.author.map { EnginePeer($0).debugDisplayTitle }, authorId: message.author.map { String($0.id.toInt64()) }, text: protected ? "" : message.text, peerId: String(self.peerId.toInt64()), mediaStatus: protected ? "Protected or expiring content omitted" : (!message.media.isEmpty ? "Offline archive: media omitted" : nil))
+                }
+                try writer.appendPage(rows)
+                self.subscriber.putNext(.progress(messages: writer.count, mediaBytes: 0))
+                if messages.isEmpty || writer.count >= 100000 {
+                    // Every offline archive is partial: the server may have uncached messages.
+                    let url = try writer.finish(title: self.title, peerId: self.peerId.id._internalGetInt64Value(), type: "offline_archive", truncated: true, cancelled: { self.cancelled.with { $0 } })
+                    guard !self.cancelled.with({ $0 }) else { writer.discard(); return }
+                    self.finished = true
+                    self.subscriber.putNext(.completed(url))
+                    self.subscriber.putCompletion()
+                } else if let oldest = messages.map({ $0.index }).min() {
+                    self.queue.async { self.next(before: oldest) }
+                }
+            } catch { writer.discard(); self.subscriber.putError(.storage) }
+        }))
+    }
+}
