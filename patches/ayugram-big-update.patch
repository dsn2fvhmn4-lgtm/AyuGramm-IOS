@@ -0,0 +1,77 @@
+import Foundation
+
+/// App-wide appearance options from Settings → AyuGram → Appearance+.
+/// Glass and classic-design choices are read once per launch because glass views are
+/// created with their implementation fixed; tab visibility applies immediately.
+public enum AyuAppearancePlus {
+    public enum GlassStyle: String, CaseIterable {
+        /// iOS 26+ UIGlassEffect (falls back to Telegram's glass on older systems).
+        case system
+        /// Telegram's own glass renderer on every iOS version.
+        case telegram
+    }
+
+    public static let didChangeNotification = Notification.Name("AyuGram.AppearancePlusChanged")
+
+    private static let hideContactsKey = "ayu.appearance.hideContactsTab"
+    private static let hideCallsKey = "ayu.appearance.hideCallsTab"
+    private static let hideTabTitlesKey = "ayu.appearance.hideTabTitles"
+    private static let glassStyleKey = "ayu.appearance.glassStyle"
+    private static let classicDesignKey = "ayu.appearance.classicDesign"
+
+    /// Values that only take effect after relaunch, captured at first access.
+    public static let launchGlassStyle: GlassStyle = AyuAppearancePlus.glassStyle
+    public static let launchClassicDesign: Bool = AyuAppearancePlus.classicDesign
+
+    public static var hideContactsTab: Bool {
+        get { return UserDefaults.standard.bool(forKey: hideContactsKey) }
+        set { set(newValue, forKey: hideContactsKey) }
+    }
+
+    public static var hideCallsTab: Bool {
+        get { return UserDefaults.standard.bool(forKey: hideCallsKey) }
+        set { set(newValue, forKey: hideCallsKey) }
+    }
+
+    public static var hideTabTitles: Bool {
+        get { return UserDefaults.standard.bool(forKey: hideTabTitlesKey) }
+        set { set(newValue, forKey: hideTabTitlesKey) }
+    }
+
+    public static var glassStyle: GlassStyle {
+        get { return UserDefaults.standard.string(forKey: glassStyleKey).flatMap(GlassStyle.init(rawValue:)) ?? .system }
+        set { set(newValue.rawValue, forKey: glassStyleKey) }
+    }
+
+    /// The pre-Liquid-Glass look: a full-width opaque tab bar and Telegram's flat glass.
+    public static var classicDesign: Bool {
+        get { return UserDefaults.standard.bool(forKey: classicDesignKey) }
+        set { set(newValue, forKey: classicDesignKey) }
+    }
+
+    /// True when Telegram's own glass renderer must replace the system one this launch.
+    public static var usesTelegramGlassThisLaunch: Bool {
+        return AyuAppearancePlus.launchGlassStyle == .telegram || AyuAppearancePlus.launchClassicDesign
+    }
+
+    public static var needsRelaunch: Bool {
+        return AyuAppearancePlus.glassStyle != AyuAppearancePlus.launchGlassStyle || AyuAppearancePlus.classicDesign != AyuAppearancePlus.launchClassicDesign
+    }
+
+    public static func resetAll() {
+        _ = AyuAppearancePlus.launchGlassStyle
+        _ = AyuAppearancePlus.launchClassicDesign
+        for key in [hideContactsKey, hideCallsKey, hideTabTitlesKey, glassStyleKey, classicDesignKey] {
+            UserDefaults.standard.removeObject(forKey: key)
+        }
+        NotificationCenter.default.post(name: didChangeNotification, object: nil)
+    }
+
+    private static func set(_ value: Any, forKey key: String) {
+        // Capture launch values before the first write changes what they would read.
+        _ = AyuAppearancePlus.launchGlassStyle
+        _ = AyuAppearancePlus.launchClassicDesign
+        UserDefaults.standard.set(value, forKey: key)
+        NotificationCenter.default.post(name: didChangeNotification, object: nil)
+    }
+}
diff --git a/submodules/SettingsUI/Sources/AyuAppearancePlusController.swift b/submodules/SettingsUI/Sources/AyuAppearancePlusController.swift
new file mode 100644
index 00000000..81872d3c
--- /dev/null
+++ b/submodules/SettingsUI/Sources/AyuAppearancePlusController.swift
@@ -0,0 +1,91 @@
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import PresentationDataUtils
+import ItemListUI
+import AccountContext
+
+// Settings → AyuGram → Appearance+: tab bar contents, glass renderer and the classic
+// (pre-Liquid-Glass) design. Tab changes apply at once; glass and design after relaunch.
+
+private enum AyuAppearancePlusRow: Int32 {
+    case hideContacts = 1
+    case hideCalls = 2
+    case hideTitles = 3
+    case telegramGlass = 11
+    case classicDesign = 21
+    case relaunchInfo = 30
+    case reset = 41
+}
+
+private func ayuAppearancePlusSignal() -> Signal<Void, NoError> {
+    return Signal { subscriber in
+        subscriber.putNext(Void())
+        let observer = NotificationCenter.default.addObserver(forName: AyuAppearancePlus.didChangeNotification, object: nil, queue: .main, using: { _ in
+            subscriber.putNext(Void())
+        })
+        return ActionDisposable {
+            NotificationCenter.default.removeObserver(observer)
+        }
+    }
+}
+
+func ayuAppearancePlusController(context: AccountContext) -> ViewController {
+    var presentController: ((ViewController) -> Void)?
+
+    let arguments = AyuSectionedArguments(open: { id in
+        guard id == AyuAppearancePlusRow.reset.rawValue else { return }
+        let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+        let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        presentController?(textAlertController(context: context, title: ru ? "Сбросить оформление?" : "Reset appearance?", text: ru ? "Вкладки вернутся, стекло и дизайн станут стандартными." : "Tabs come back; glass and design return to default.", actions: [
+            TextAlertAction(type: .genericAction, title: presentationData.strings.Common_Cancel, action: {}),
+            TextAlertAction(type: .destructiveAction, title: ru ? "Сбросить" : "Reset", action: { AyuAppearancePlus.resetAll() })
+        ]))
+    }, toggle: { id, value in
+        guard let row = AyuAppearancePlusRow(rawValue: id) else { return }
+        switch row {
+        case .hideContacts: AyuAppearancePlus.hideContactsTab = value
+        case .hideCalls: AyuAppearancePlus.hideCallsTab = value
+        case .hideTitles: AyuAppearancePlus.hideTabTitles = value
+        case .telegramGlass: AyuAppearancePlus.glassStyle = value ? .telegram : .system
+        case .classicDesign: AyuAppearancePlus.classicDesign = value
+        default: break
+        }
+    })
+
+    func symbol(_ name: String, _ color: UInt32) -> UIImage? {
+        return AyuSettingsIcons.symbol(name, color: UIColor(rgb: color))
+    }
+
+    let signal = combineLatest(context.sharedContext.presentationData, ayuAppearancePlusSignal())
+    |> deliverOnMainQueue
+    |> map { presentationData, _ -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        let systemGlassAvailable: Bool
+        if #available(iOS 26.0, *) { systemGlassAvailable = true } else { systemGlassAvailable = false }
+        var entries: [AyuSectionedEntry] = [
+            .header(1, 0, ru ? "НИЖНЯЯ ПАНЕЛЬ" : "TAB BAR"),
+            .toggle(1, AyuAppearancePlusRow.hideContacts.rawValue, symbol("person.crop.circle", 0xFF9500), ru ? "Скрыть «Контакты»" : "Hide Contacts", nil, AyuAppearancePlus.hideContactsTab),
+            .toggle(1, AyuAppearancePlusRow.hideCalls.rawValue, symbol("phone.fill", 0x34C759), ru ? "Скрыть «Звонки»" : "Hide Calls", nil, AyuAppearancePlus.hideCallsTab),
+            .toggle(1, AyuAppearancePlusRow.hideTitles.rawValue, symbol("textformat", 0x5856D6), ru ? "Скрыть подписи вкладок" : "Hide tab titles", nil, AyuAppearancePlus.hideTabTitles),
+            .info(1, 4, ru ? "«Чаты» и «Настройки» скрыть нельзя. Подъём панели настраивается в разделе «Навигация и редактор»." : "Chats and Settings cannot be hidden. The bar's lift is in Navigation and composer."),
+            .header(2, 10, ru ? "ЖИДКОЕ СТЕКЛО" : "LIQUID GLASS"),
+            .toggle(2, AyuAppearancePlusRow.telegramGlass.rawValue, symbol("drop.fill", 0x32ADE6), ru ? "Стекло Telegram" : "Telegram glass", ru ? (systemGlassAvailable ? "Выключено — системное стекло iOS" : "Системное стекло требует iOS 26") : (systemGlassAvailable ? "Off: the system iOS glass" : "System glass needs iOS 26"), AyuAppearancePlus.glassStyle == .telegram),
+            .header(3, 20, ru ? "ДИЗАЙН" : "DESIGN"),
+            .toggle(3, AyuAppearancePlusRow.classicDesign.rawValue, symbol("clock.arrow.circlepath", 0xFF2D55), ru ? "Старый дизайн Telegram" : "Classic Telegram design", ru ? "Нижняя панель во всю ширину, как до Liquid Glass" : "Full-width tab bar as before Liquid Glass", AyuAppearancePlus.classicDesign)
+        ]
+        if AyuAppearancePlus.needsRelaunch {
+            entries.append(.info(3, AyuAppearancePlusRow.relaunchInfo.rawValue, ru ? "⚠️ Перезапустите приложение, чтобы применить стекло и дизайн." : "⚠️ Relaunch the app to apply the glass and design changes."))
+        }
+        entries.append(.link(4, AyuAppearancePlusRow.reset.rawValue, symbol("arrow.counterclockwise", 0xFF3B30), ru ? "Сбросить оформление" : "Reset appearance", ""))
+        let data = ItemListPresentationData(presentationData)
+        let state = ItemListControllerState(presentationData: data, title: .text(ru ? "Оформление+" : "Appearance+"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        return (state, (ItemListNodeState(presentationData: data, entries: entries, style: .blocks, animateChanges: true), arguments))
+    }
+    let controller = ItemListController(context: context, state: signal)
+    presentController = { [weak controller] in controller?.present($0, in: .window(.root)) }
+    return controller
+}
