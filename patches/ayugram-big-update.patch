diff --git a/submodules/TelegramUI/Sources/AccountContext.swift b/submodules/TelegramUI/Sources/AccountContext.swift
index ad077f5c..b9aa9653 100644
--- a/submodules/TelegramUI/Sources/AccountContext.swift
+++ b/submodules/TelegramUI/Sources/AccountContext.swift
@@ -30,6 +30,7 @@ import DirectMediaImageCache
 import WalletContext
 import WalletConnectScreen
 import AlertUI
+import LocalizedPeerData
 import MetalEngine
 
 private final class DeviceSpecificContactImportContext {
@@ -1014,6 +1015,29 @@ public final class AccountContextImpl: AccountContext {
     }
     
     public func requestCall(peerId: EnginePeer.Id, isVideo: Bool, completion: @escaping () -> Void) {
+        // AyuGram Privacy & extras: calls start only after a confirmation.
+        guard AyuExtras.isOn(.confirmCalls) else {
+            self.ayuPerformRequestCall(peerId: peerId, isVideo: isVideo, completion: completion)
+            return
+        }
+        let presentationData = self.sharedContext.currentPresentationData.with { $0 }
+        let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        let _ = (self.engine.data.get(TelegramEngine.EngineData.Item.Peer.Peer(id: peerId))
+        |> deliverOnMainQueue).start(next: { [weak self] peer in
+            guard let self else { return }
+            let name = peer?.compactDisplayTitle ?? ""
+            let title = isVideo ? (ru ? "Видеозвонок" : "Video call") : (ru ? "Звонок" : "Call")
+            let text = ru ? "Позвонить \(name)?" : "Call \(name)?"
+            self.sharedContext.mainWindow?.present(textAlertController(context: self, title: title, text: text, actions: [
+                TextAlertAction(type: .genericAction, title: presentationData.strings.Common_Cancel, action: {}),
+                TextAlertAction(type: .defaultAction, title: ru ? "Позвонить" : "Call", action: { [weak self] in
+                    self?.ayuPerformRequestCall(peerId: peerId, isVideo: isVideo, completion: completion)
+                })
+            ]), on: .root)
+        })
+    }
+
+    private func ayuPerformRequestCall(peerId: EnginePeer.Id, isVideo: Bool, completion: @escaping () -> Void) {
         guard let callResult = self.sharedContext.callManager?.requestCall(context: self, peerId: peerId, isVideo: isVideo, endCurrentIfAny: false) else {
             return
         }
