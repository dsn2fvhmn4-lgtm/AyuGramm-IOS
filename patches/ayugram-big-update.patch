+}
+
+/// "ALL CAPS" text (at least 6 letters, none lowercase) in sentence case; anything else unchanged.
+func ayuDecapitalized(_ text: String) -> String? {
+    let letters = text.unicodeScalars.filter { CharacterSet.letters.contains($0) }
+    guard letters.count >= 6, !letters.contains(where: { CharacterSet.lowercaseLetters.contains($0) }) else { return nil }
+    var result = ""
+    var capitalizeNext = true
+    for character in text.lowercased() {
+        if capitalizeNext, character.isLetter {
+            result += character.uppercased()
+            capitalizeNext = false
+        } else {
+            result.append(character)
+        }
+        if ".!?\n".contains(character) {
+            capitalizeNext = true
+        }
+    }
+    return result
+}
