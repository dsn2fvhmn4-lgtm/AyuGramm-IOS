@@ -0,0 +1,159 @@
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import PresentationDataUtils
+import ItemListUI
+import AccountContext
+
+// Settings → AyuGram → Developer. Every switch defaults to off; the page only exposes
+// diagnostics and local presentation toggles, never account or network behaviour.
+
+private enum AyuDeveloperRow: Int32 {
+    case playerDebugOverlay = 1
+    case fpsCounter = 2
+    case slowAnimations = 3
+    case highlightAyuViews = 4
+    case forceStockMusicPlayer = 11
+    case lyricsDiagnostics = 12
+    case pluginConsole = 21
+    case experimentalPluginHooks = 22
+    case openPluginConsole = 23
+    case allowUnofficialInjectPlugins = 24
+    case unofficialInjectInfo = 25
+    case showInternalIds = 31
+    case verboseLogging = 41
+    case shareLog = 42
+    case clearLog = 43
+    case resetAll = 51
+    case developerModeHeader = -10
+    case developerMode = -9
+    case telegramDebug = -8
+}
+
+func ayuDeveloperSettingsController(context: AccountContext) -> ViewController {
+    var presentNative: ((UIViewController) -> Void)?
+    var push: ((ViewController) -> Void)?
+    var presentController: ((ViewController) -> Void)?
+    let store = AyuDeveloperSettings.shared
+
+    let arguments = AyuSectionedArguments(open: { id in
+        guard let row = AyuDeveloperRow(rawValue: id) else { return }
+        let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+        let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        switch row {
+        case .telegramDebug:
+            if let controller = context.sharedContext.makeDebugSettingsController(context: context) {
+                push?(controller)
+            }
+        case .shareLog:
+            guard let url = AyuDevLog.shared.fileURL, FileManager.default.fileExists(atPath: url.path) else {
+                presentController?(textAlertController(context: context, title: "AyuGram", text: ru ? "Журнал пока пуст. Включите подробный журнал и повторите действие." : "The log is empty. Turn on verbose logging and reproduce the issue.", actions: [TextAlertAction(type: .defaultAction, title: presentationData.strings.Common_OK, action: {})]))
+                return
+            }
+            presentNative?(UIActivityViewController(activityItems: [url], applicationActivities: nil))
+        case .clearLog:
+            AyuDevLog.shared.clear()
+        case .openPluginConsole:
+            push?(ayuPluginConsoleController(context: context))
+        case .resetAll:
+            presentController?(textAlertController(context: context, title: ru ? "Сбросить настройки разработчика?" : "Reset developer settings?", text: ru ? "Все переключатели на этой странице будут выключены." : "Every switch on this page will be turned off.", actions: [
+                TextAlertAction(type: .genericAction, title: presentationData.strings.Common_Cancel, action: {}),
+                TextAlertAction(type: .destructiveAction, title: ru ? "Сбросить" : "Reset", action: { store.resetAll() })
+            ]))
+        default:
+            break
+        }
+    }, toggle: { id, value in
+        // Turning the developer mode off hides this page (after a relaunch) and resets it.
+        if id == AyuDeveloperRow.developerMode.rawValue {
+            guard !value else { return }
+            let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+            let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+            presentController?(textAlertController(context: context, title: ru ? "Выключить режим разработчика?" : "Turn off developer mode?", text: ru ? "Все опции разработчика выключатся, а раздел «Отладка» исчезнет после перезапуска. Включить снова — 5 тапов по версии AyuGram." : "Every developer option is turned off and the Debugging section disappears after a relaunch. To turn it back on, tap the AyuGram version 5 times.", actions: [
+                TextAlertAction(type: .genericAction, title: presentationData.strings.Common_Cancel, action: {
+                    // Redraw the switch back on.
+                    NotificationCenter.default.post(name: AyuDeveloperSettings.didChangeNotification, object: nil)
+                }),
+                TextAlertAction(type: .destructiveAction, title: ru ? "Выключить" : "Turn off", action: {
+                    AyuDeveloperSettings.unlocked = false
+                    store.resetAll()
+                })
+            ]))
+            return
+        }
+        guard let row = AyuDeveloperRow(rawValue: id) else { return }
+        store.update { settings in
+            switch row {
+            case .playerDebugOverlay: settings.playerDebugOverlay = value
+            case .fpsCounter: settings.fpsCounter = value
+            case .slowAnimations: settings.slowAnimations = value
+            case .highlightAyuViews: settings.highlightAyuViews = value
+            case .forceStockMusicPlayer: settings.forceStockMusicPlayer = value
+            case .lyricsDiagnostics: settings.lyricsDiagnostics = value
+            case .pluginConsole: settings.pluginConsole = value
+            case .experimentalPluginHooks: settings.experimentalPluginHooks = value
+            case .allowUnofficialInjectPlugins: settings.allowUnofficialInjectPlugins = value
+            case .showInternalIds: settings.showInternalIds = value
+            case .verboseLogging: settings.verboseLogging = value
+            default: break
+            }
+        }
+    })
+
+    func symbol(_ name: String, _ color: UInt32) -> UIImage? {
+        return AyuSettingsIcons.symbol(name, color: UIColor(rgb: color))
+    }
+
+    let signal = combineLatest(context.sharedContext.presentationData, store.signal)
+    |> deliverOnMainQueue
+    |> map { presentationData, settings -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        func toggle(_ section: Int32, _ row: AyuDeveloperRow, _ icon: UIImage?, _ title: String, _ text: String?, _ value: Bool) -> AyuSectionedEntry {
+            return .toggle(section, row.rawValue, icon, title, text, value)
+        }
+        var entries: [AyuSectionedEntry] = [
+            .header(0, AyuDeveloperRow.developerModeHeader.rawValue, ru ? "РЕЖИМ РАЗРАБОТЧИКА" : "DEVELOPER MODE"),
+            .toggle(0, AyuDeveloperRow.developerMode.rawValue, symbol("hammer.fill", 0x8E8E93), ru ? "Режим разработчика" : "Developer mode", ru ? "Выключите, чтобы скрыть эти настройки" : "Turn off to hide these settings", AyuDeveloperSettings.unlocked || AyuDeveloperSettings.unlockedAtLaunch),
+            .link(0, AyuDeveloperRow.telegramDebug.rawValue, symbol("ant.fill", 0xFF9500), ru ? "Отладка Telegram" : "Telegram debug settings", ""),
+            .header(1, 0, ru ? "ИНТЕРФЕЙС" : "INTERFACE"),
+            toggle(1, .playerDebugOverlay, symbol("ladybug.fill", 0xFF3B30), ru ? "Отладка плеера" : "Player debug overlay", ru ? "Состояние воспроизведения в правом нижнем углу плеера" : "Playback state in the player's bottom-right corner", settings.playerDebugOverlay),
+            toggle(1, .fpsCounter, symbol("speedometer", 0x34C759), ru ? "Счётчик FPS" : "FPS counter", nil, settings.fpsCounter),
+            toggle(1, .highlightAyuViews, symbol("square.dashed", 0xAF52DE), ru ? "Подсветить элементы AyuGram" : "Outline AyuGram views", nil, settings.highlightAyuViews),
+            .header(2, 10, ru ? "МУЗЫКА" : "MUSIC"),
+            toggle(2, .forceStockMusicPlayer, symbol("music.note", 0xFF2D55), ru ? "Стандартный плеер Telegram" : "Stock Telegram player", ru ? "Вместо плеера AyuGram" : "Instead of the AyuGram player", settings.forceStockMusicPlayer),
+            toggle(2, .lyricsDiagnostics, symbol("text.quote", 0x5856D6), ru ? "Диагностика текстов" : "Lyrics diagnostics", ru ? "Источник, совпадение и время поиска" : "Source, match score and lookup time", settings.lyricsDiagnostics),
+            .header(3, 20, ru ? "ПЛАГИНЫ" : "PLUGINS"),
+            toggle(3, .pluginConsole, symbol("terminal.fill", 0x8E8E93), ru ? "Консоль плагинов" : "Plugin console", ru ? "Вывод print() и ошибки скриптов" : "Script print() output and errors", settings.pluginConsole),
+            toggle(3, .experimentalPluginHooks, symbol("flask.fill", 0xFF9500), ru ? "Мягкие лимиты плагинов" : "Relaxed plugin limits", ru ? "Таймаут хуков 2 с вместо 0,25 с, ошибки скриптов всплывают сообщением" : "2 s hook timeout instead of 0.25 s; script errors show as toasts", settings.experimentalPluginHooks)
+        ]
+        if settings.pluginConsole {
+            entries.append(.link(3, AyuDeveloperRow.openPluginConsole.rawValue, symbol("list.bullet.rectangle.fill", 0x007AFF), ru ? "Открыть консоль" : "Open console", ""))
+        }
+        entries.append(toggle(3, .allowUnofficialInjectPlugins, symbol("exclamationmark.shield.fill", 0xFF3B30), ru ? "Инжект-плагины не из официального источника" : "Injecting plugins from unofficial sources", ru ? "Разрешить плагины, которые внедряются в приложение, без подписи AyuGram" : "Allow plugins that inject into the app without an AyuGram signature", settings.allowUnofficialInjectPlugins))
+        entries.append(.info(3, AyuDeveloperRow.unofficialInjectInfo.rawValue, ru ? "⚠️ Такие плагины не проверены AyuGram. Перед установкой каждого будет предупреждение, а вся ответственность за последствия лежит полностью на вас." : "⚠️ Such plugins are not reviewed by AyuGram. Each one shows a warning before installing, and the responsibility for the consequences is entirely yours."))
+        entries.append(contentsOf: [
+            .header(4, 30, ru ? "ДАННЫЕ" : "DATA"),
+            toggle(4, .showInternalIds, symbol("number", 0x32ADE6), ru ? "Внутренние ID в меню" : "Internal IDs in menus", nil, settings.showInternalIds),
+            .header(5, 40, ru ? "ЖУРНАЛ" : "LOG"),
+            toggle(5, .verboseLogging, symbol("doc.text.fill", 0x8E8E93), ru ? "Подробный журнал" : "Verbose logging", ru ? "Плагины, тексты, распознавание; хранится только на устройстве" : "Plugins, lyrics, recognition; stays on this device", settings.verboseLogging),
+            .link(5, AyuDeveloperRow.shareLog.rawValue, symbol("square.and.arrow.up", 0x007AFF), ru ? "Поделиться журналом" : "Share log", ""),
+            .link(5, AyuDeveloperRow.clearLog.rawValue, symbol("trash.fill", 0xFF3B30), ru ? "Очистить журнал" : "Clear log", ""),
+            .header(6, 50, ""),
+            .link(6, AyuDeveloperRow.resetAll.rawValue, symbol("arrow.counterclockwise", 0xFF3B30), ru ? "Сбросить всё" : "Reset all", settings.anyEnabled ? "" : (ru ? "всё выключено" : "all off")),
+            .info(6, 52, ru ? "Эти настройки предназначены для отладки и по умолчанию выключены." : "These settings are meant for debugging and are off by default.")
+        ])
+        let data = ItemListPresentationData(presentationData)
+        let state = ItemListControllerState(presentationData: data, title: .text(ru ? "Для разработчиков" : "Developer"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        return (state, (ItemListNodeState(presentationData: data, entries: entries, style: .blocks, animateChanges: true), arguments))
+    }
+    let controller = ItemListController(context: context, state: signal)
+    push = { [weak controller] in controller?.push($0) }
+    presentController = { [weak controller] in controller?.present($0, in: .window(.root)) }
+    presentNative = { viewController in
+        context.sharedContext.applicationBindings.presentNativeController(viewController)
+    }
+    return controller
+}
diff --git a/submodules/SettingsUI/Sources/AyuEblanButton.swift b/submodules/SettingsUI/Sources/AyuEblanButton.swift
new file mode 100644
index 00000000..956e2c6d
--- /dev/null
+++ b/submodules/SettingsUI/Sources/AyuEblanButton.swift
@@ -0,0 +1,95 @@
+import Foundation
+import UIKit
+import Display
+import AccountContext
+
+/// Easter egg on the AyuGram settings page: pull the list down far enough and a «еблан»
+/// button pops out under the navigation bar; it opens the bundled picture.
+final class AyuEblanPullButton: UIButton {
+    private static let threshold: CGFloat = 80.0
+    private var shown = false
+    private var hideWork: DispatchWorkItem?
+    var open: (() -> Void)?
+
+    init() {
+        super.init(frame: CGRect(x: 0.0, y: 0.0, width: 132.0, height: 40.0))
+        var configuration = UIButton.Configuration.filled()
+        configuration.title = "еблан"
+        configuration.cornerStyle = .capsule
+        configuration.baseBackgroundColor = UIColor(rgb: 0xFF3B30)
+        configuration.baseForegroundColor = .white
+        configuration.contentInsets = NSDirectionalEdgeInsets(top: 8.0, leading: 22.0, bottom: 8.0, trailing: 22.0)
+        configuration.titleTextAttributesTransformer = UIConfigurationTextAttributesTransformer { attributes in
+            var attributes = attributes
+            attributes.font = UIFont.systemFont(ofSize: 17.0, weight: .heavy)
+            return attributes
+        }
+        self.configuration = configuration
+        self.alpha = 0.0
+        self.transform = CGAffineTransform(scaleX: 0.4, y: 0.4)
+        self.layer.shadowColor = UIColor.black.cgColor
+        self.layer.shadowOpacity = 0.25
+        self.layer.shadowRadius = 10.0
+        self.layer.shadowOffset = CGSize(width: 0.0, height: 4.0)
+        self.addTarget(self, action: #selector(self.tapped), for: .touchUpInside)
+    }
+
+    required init?(coder: NSCoder) { return nil }
+
+    @objc private func tapped() {
+        UIImpactFeedbackGenerator(style: .rigid).impactOccurred()
+        self.open?()
+    }
+
+    /// `pull` is how far past the top the list is dragged, in points.
+    func update(pull: CGFloat) {
+        if pull >= AyuEblanPullButton.threshold && !self.shown {
+            self.shown = true
+            UIImpactFeedbackGenerator(style: .medium).impactOccurred()
+            UIView.animate(withDuration: 0.55, delay: 0.0, usingSpringWithDamping: 0.55, initialSpringVelocity: 0.8, options: [.allowUserInteraction, .beginFromCurrentState], animations: {
+                self.alpha = 1.0
+                self.transform = .identity
+            })
+        }
+        if self.shown {
+            // Stay a few seconds after the list springs back, so it can be tapped.
+            self.hideWork?.cancel()
+            let work = DispatchWorkItem { [weak self] in self?.hide() }
+            self.hideWork = work
+            DispatchQueue.main.asyncAfter(deadline: .now() + 4.0, execute: work)
+        }
+    }
+
+    private func hide() {
+        guard self.shown else { return }
+        self.shown = false
+        UIView.animate(withDuration: 0.3, delay: 0.0, options: [.beginFromCurrentState, .allowUserInteraction], animations: {
+            self.alpha = 0.0
+            self.transform = CGAffineTransform(scaleX: 0.4, y: 0.4)
+        })
+    }
+}
+
+/// Full-screen viewer for the easter egg picture; tap anywhere to close.
+final class AyuEblanViewController: UIViewController {
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        self.view.backgroundColor = .black
+        let imageView = UIImageView(image: Bundle.main.path(forResource: "AyuEblan", ofType: "png").flatMap(UIImage.init(contentsOfFile:)))
+        imageView.contentMode = .scaleAspectFit
+        imageView.frame = self.view.bounds
+        imageView.autoresizingMask = [.flexibleWidth, .flexibleHeight]
+        self.view.addSubview(imageView)
+        imageView.transform = CGAffineTransform(scaleX: 0.6, y: 0.6)
+        imageView.alpha = 0.0
+        UIView.animate(withDuration: 0.5, delay: 0.05, usingSpringWithDamping: 0.7, initialSpringVelocity: 0.0, options: [], animations: {
+            imageView.transform = .identity
+            imageView.alpha = 1.0
+        })
+        self.view.addGestureRecognizer(UITapGestureRecognizer(target: self, action: #selector(self.close)))
+    }
+
+    @objc private func close() {
+        self.dismiss(animated: true)
+    }
+}
diff --git a/submodules/SettingsUI/Sources/AyuEqualizerController.swift b/submodules/SettingsUI/Sources/AyuEqualizerController.swift
new file mode 100644
index 00000000..eb8ebd67
--- /dev/null
+++ b/submodules/SettingsUI/Sources/AyuEqualizerController.swift
@@ -0,0 +1,263 @@
+import Foundation
+import UIKit
+import Display
+import AccountContext
+import UniversalMediaPlayer
+
+/// Settings → AyuGram → Equalizer (also from the player menu): ten bands, presets, live.
+final class AyuEqualizerViewController: UIViewController {
+    private let russian: Bool
+    private let palette: AyuPreferencesPalette
+    var close: (() -> Void)?
+
+    private let enabledSwitch = UISwitch()
+    private let presetsStack = UIStackView()
+    private var presetButtons: [String: UIButton] = [:]
+    private var sliders: [UISlider] = []
+    private var valueLabels: [UILabel] = []
+    private var observer: NSObjectProtocol?
+
+    init(russian: Bool, palette: AyuPreferencesPalette) {
+        self.russian = russian
+        self.palette = palette
+        super.init(nibName: nil, bundle: nil)
+        self.title = russian ? "Эквалайзер" : "Equalizer"
+    }
+
+    required init?(coder: NSCoder) { return nil }
+
+    deinit {
+        if let observer = self.observer {
+            NotificationCenter.default.removeObserver(observer)
+        }
+    }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        self.view.backgroundColor = self.palette.background
+        let back = UIBarButtonItem(image: UIImage(systemName: "chevron.backward", withConfiguration: UIImage.SymbolConfiguration(weight: .semibold)), style: .plain, target: self, action: #selector(self.backTapped))
+        back.accessibilityLabel = self.russian ? "Назад" : "Back"
+        self.navigationItem.leftBarButtonItem = back
+        self.navigationItem.rightBarButtonItem = UIBarButtonItem(title: self.russian ? "Сброс" : "Reset", style: .plain, target: self, action: #selector(self.resetTapped))
+
+        let scroll = UIScrollView()
+        scroll.alwaysBounceVertical = true
+        scroll.translatesAutoresizingMaskIntoConstraints = false
+        self.view.addSubview(scroll)
+
+        let content = UIStackView()
+        content.axis = .vertical
+        content.spacing = 16.0
+        content.translatesAutoresizingMaskIntoConstraints = false
+        scroll.addSubview(content)
+        NSLayoutConstraint.activate([
+            scroll.topAnchor.constraint(equalTo: self.view.safeAreaLayoutGuide.topAnchor),
+            scroll.bottomAnchor.constraint(equalTo: self.view.bottomAnchor),
+            scroll.leadingAnchor.constraint(equalTo: self.view.leadingAnchor),
+            scroll.trailingAnchor.constraint(equalTo: self.view.trailingAnchor),
+            content.topAnchor.constraint(equalTo: scroll.contentLayoutGuide.topAnchor, constant: 16.0),
+            content.bottomAnchor.constraint(equalTo: scroll.contentLayoutGuide.bottomAnchor, constant: -24.0),
+            content.leadingAnchor.constraint(equalTo: scroll.frameLayoutGuide.leadingAnchor, constant: 16.0),
+            content.trailingAnchor.constraint(equalTo: scroll.frameLayoutGuide.trailingAnchor, constant: -16.0)
+        ])
+
+        content.addArrangedSubview(self.makeSwitchPanel())
+        content.addArrangedSubview(self.makeCaption(self.russian ? "ПРЕСЕТЫ" : "PRESETS"))
+        content.addArrangedSubview(self.makePresets())
+        content.addArrangedSubview(self.makeCaption(self.russian ? "ПОЛОСЫ" : "BANDS"))
+        content.addArrangedSubview(self.makeBands())
+        let footer = self.makeCaption(self.russian
+            ? "Работает для музыки и звука видео во время воспроизведения. Голосовые и кружки не меняются. Громкие пресеты автоматически снижают общий уровень, чтобы не было искажений."
+            : "Applies to music and video sound while playing. Voice and video messages are not changed. Loud presets lower the overall level automatically to avoid distortion.")
+        footer.numberOfLines = 0
+        content.addArrangedSubview(footer)
+
+        self.observer = NotificationCenter.default.addObserver(forName: AyuEqualizer.didChangeNotification, object: nil, queue: .main, using: { [weak self] _ in
+            self?.refresh()
+        })
+        self.refresh()
+    }
+
+    @objc private func backTapped() {
+        if let close = self.close { close() } else { self.dismiss(animated: true) }
+    }
+
+    @objc private func resetTapped() {
+        if let flat = AyuEqualizer.presets.first {
+            AyuEqualizer.apply(preset: flat)
+        }
+    }
+
+    private func makeCaption(_ text: String) -> UILabel {
+        let label = UILabel()
+        label.text = text
+        label.font = .systemFont(ofSize: 13.0)
+        label.textColor = self.palette.secondary
+        return label
+    }
+
+    private func makePanel() -> UIView {
+        let panel = UIView()
+        panel.backgroundColor = self.palette.panel
+        panel.layer.cornerRadius = 12.0
+        return panel
+    }
+
+    private func makeSwitchPanel() -> UIView {
+        let panel = self.makePanel()
+        let label = UILabel()
+        label.text = self.russian ? "Эквалайзер" : "Equalizer"
+        label.font = .systemFont(ofSize: 17.0)
+        label.textColor = self.palette.text
+        self.enabledSwitch.onTintColor = self.palette.accent
+        self.enabledSwitch.addTarget(self, action: #selector(self.switchChanged), for: .valueChanged)
+        for view in [label, self.enabledSwitch] as [UIView] {
+            view.translatesAutoresizingMaskIntoConstraints = false
+            panel.addSubview(view)
+        }
+        NSLayoutConstraint.activate([
+            panel.heightAnchor.constraint(equalToConstant: 52.0),
+            label.leadingAnchor.constraint(equalTo: panel.leadingAnchor, constant: 16.0),
+            label.centerYAnchor.constraint(equalTo: panel.centerYAnchor),
+            self.enabledSwitch.trailingAnchor.constraint(equalTo: panel.trailingAnchor, constant: -16.0),
+            self.enabledSwitch.centerYAnchor.constraint(equalTo: panel.centerYAnchor)
+        ])
+        return panel
+    }
+
+    @objc private func switchChanged() {
+        AyuEqualizer.isEnabled = self.enabledSwitch.isOn
+    }
+
+    private func makePresets() -> UIView {
+        let scroll = UIScrollView()
+        scroll.showsHorizontalScrollIndicator = false
+        self.presetsStack.axis = .horizontal
+        self.presetsStack.spacing = 8.0
+        self.presetsStack.translatesAutoresizingMaskIntoConstraints = false
+        scroll.addSubview(self.presetsStack)
+        for preset in AyuEqualizer.presets {
+            var configuration = UIButton.Configuration.filled()
+            configuration.title = preset.name(self.russian)
+            configuration.cornerStyle = .capsule
+            configuration.contentInsets = NSDirectionalEdgeInsets(top: 7.0, leading: 14.0, bottom: 7.0, trailing: 14.0)
+            let button = UIButton(configuration: configuration, primaryAction: UIAction(handler: { _ in
+                AyuEqualizer.apply(preset: preset)
+                if !AyuEqualizer.isEnabled {
+                    AyuEqualizer.isEnabled = true
+                }
+            }))
+            self.presetButtons[preset.id] = button
+            self.presetsStack.addArrangedSubview(button)
+        }
+        NSLayoutConstraint.activate([
+            scroll.heightAnchor.constraint(equalToConstant: 40.0),
+            self.presetsStack.topAnchor.constraint(equalTo: scroll.contentLayoutGuide.topAnchor),
+            self.presetsStack.bottomAnchor.constraint(equalTo: scroll.contentLayoutGuide.bottomAnchor),
+            self.presetsStack.leadingAnchor.constraint(equalTo: scroll.contentLayoutGuide.leadingAnchor),
+            self.presetsStack.trailingAnchor.constraint(equalTo: scroll.contentLayoutGuide.trailingAnchor),
+            self.presetsStack.heightAnchor.constraint(equalTo: scroll.frameLayoutGuide.heightAnchor)
+        ])
+        return scroll
+    }
+
+    private func makeBands() -> UIView {
+        let panel = self.makePanel()
+        let row = UIStackView()
+        row.axis = .horizontal
+        row.distribution = .fillEqually
+        row.translatesAutoresizingMaskIntoConstraints = false
+        panel.addSubview(row)
+        let sliderLength: CGFloat = 200.0
+        for (index, frequency) in AyuEqualizer.frequencies.enumerated() {
+            let column = UIView()
+            let value = UILabel()
+            value.font = .monospacedDigitSystemFont(ofSize: 11.0, weight: .medium)
+            value.textColor = self.palette.text
+            value.textAlignment = .center
+            let name = UILabel()
+            name.text = frequency >= 1000 ? "\(Int(frequency / 1000))k" : "\(Int(frequency))"
+            name.font = .systemFont(ofSize: 11.0)
+            name.textColor = self.palette.secondary
+            name.textAlignment = .center
+            let slider = UISlider()
+            slider.minimumValue = AyuEqualizer.gainRange.lowerBound
+            slider.maximumValue = AyuEqualizer.gainRange.upperBound
+            slider.minimumTrackTintColor = self.palette.accent
+            slider.tag = index
+            slider.transform = CGAffineTransform(rotationAngle: -CGFloat.pi / 2.0)
+            slider.addTarget(self, action: #selector(self.sliderChanged(_:)), for: .valueChanged)
+            slider.accessibilityLabel = (self.russian ? "Полоса " : "Band ") + (name.text ?? "")
+            for view in [value, slider, name] as [UIView] {
+                view.translatesAutoresizingMaskIntoConstraints = false
+                column.addSubview(view)
+            }
+            NSLayoutConstraint.activate([
+                value.topAnchor.constraint(equalTo: column.topAnchor),
+                value.leadingAnchor.constraint(equalTo: column.leadingAnchor),
+                value.trailingAnchor.constraint(equalTo: column.trailingAnchor),
+                slider.centerXAnchor.constraint(equalTo: column.centerXAnchor),
+                slider.centerYAnchor.constraint(equalTo: column.topAnchor, constant: 22.0 + sliderLength / 2.0),
+                slider.widthAnchor.constraint(equalToConstant: sliderLength),
+                name.topAnchor.constraint(equalTo: column.topAnchor, constant: 30.0 + sliderLength),
+                name.leadingAnchor.constraint(equalTo: column.leadingAnchor),
+                name.trailingAnchor.constraint(equalTo: column.trailingAnchor),
+                name.bottomAnchor.constraint(equalTo: column.bottomAnchor)
+            ])
+            self.sliders.append(slider)
+            self.valueLabels.append(value)
+            row.addArrangedSubview(column)
+        }
+        NSLayoutConstraint.activate([
+            row.topAnchor.constraint(equalTo: panel.topAnchor, constant: 14.0),
+            row.bottomAnchor.constraint(equalTo: panel.bottomAnchor, constant: -14.0),
+            row.leadingAnchor.constraint(equalTo: panel.leadingAnchor, constant: 6.0),
+            row.trailingAnchor.constraint(equalTo: panel.trailingAnchor, constant: -6.0)
+        ])
+        return panel
+    }
+
+    @objc private func sliderChanged(_ slider: UISlider) {
+        var gains = AyuEqualizer.gains
+        guard slider.tag < gains.count else { return }
+        let rounded = (slider.value * 2.0).rounded() / 2.0
+        gains[slider.tag] = rounded
+        AyuEqualizer.presetId = nil
+        AyuEqualizer.gains = gains
+        if !AyuEqualizer.isEnabled {
+            AyuEqualizer.isEnabled = true
+        }
+    }
+
+    private func refresh() {
+        self.enabledSwitch.isOn = AyuEqualizer.isEnabled
+        let gains = AyuEqualizer.gains
+        for (index, slider) in self.sliders.enumerated() where index < gains.count {
+            if !slider.isTracking {
+                slider.value = gains[index]
+            }
+            let gain = gains[index]
+            self.valueLabels[index].text = gain == 0 ? "0" : String(format: gain == gain.rounded() ? "%+.0f" : "%+.1f", gain)
+        }
+        let selected = AyuEqualizer.isEnabled ? AyuEqualizer.presetId : nil
+        for (id, button) in self.presetButtons {
+            var configuration = button.configuration ?? UIButton.Configuration.filled()
+            let isSelected = id == selected
+            configuration.baseBackgroundColor = isSelected ? self.palette.accent : self.palette.panel
+            configuration.baseForegroundColor = isSelected ? .white : self.palette.text
+            button.configuration = configuration
+        }
+    }
+}
+
+/// The equalizer as a page of Telegram's navigation stack.
+public func ayuEqualizerController(context: AccountContext) -> ViewController {
+    let data = context.sharedContext.currentPresentationData.with { $0 }
+    let palette = AyuPreferencesPalette(background: data.theme.list.blocksBackgroundColor, panel: data.theme.list.itemBlocksBackgroundColor, text: data.theme.list.itemPrimaryTextColor, secondary: data.theme.list.itemSecondaryTextColor, accent: data.theme.list.itemAccentColor)
+    let root = AyuEqualizerViewController(russian: data.strings.baseLanguageCode.hasPrefix("ru"), palette: palette)
+    let screen = AyuHostedNavigationScreen(context: context, root: root)
+    root.close = { [weak screen] in
+        screen?.navigationController?.popViewController(animated: true)
+    }
+    return screen
+}
