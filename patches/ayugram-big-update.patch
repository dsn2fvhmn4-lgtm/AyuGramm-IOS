index 00000000..a23cb92a
--- /dev/null
+++ b/submodules/Display/Source/AyuSpeechBleep.swift
@@ -0,0 +1,145 @@
+import Foundation
+import AVFoundation
+import Speech
+
+/// Shared by voice messages (TelegramUI) and video messages (the round camera): swear words are
+/// found with on-device speech recognition and covered by a 1 kHz beep or silence.
+public enum AyuSpeechBleep {
+    private static let roots: [String] = [
+        "хуй", "хуе", "хуё", "хуя", "хуи", "пизд", "бля", "ебан", "ебат", "ебал", "ебу", "ёб", "заеб", "выеб", "наеб", "отъеб", "уеб",
+        "сука", "суки", "сучк", "мудак", "мудил", "пидор", "пидар", "педик", "залуп", "гандон", "шлюх", "дерьм", "говн", "хер",
+        "fuck", "shit", "bitch", "cunt", "dick", "asshole", "motherf", "bastard", "whore", "slut"
+    ]
+
+    public static func isProfanity(_ word: String) -> Bool {
+        let lowered = word.lowercased().trimmingCharacters(in: .punctuationCharacters)
+        return roots.contains(where: { lowered.hasPrefix($0) || (lowered.count > 4 && $0.count >= 4 && lowered.contains($0)) })
+    }
+
+    /// Time ranges (seconds) of swear words in 16 kHz mono samples.
+    public static func recognize(_ samples: [Int16], completion: @escaping ([Range<Double>]) -> Void) {
+        SFSpeechRecognizer.requestAuthorization { status in
+            guard status == .authorized, !samples.isEmpty else { return completion([]) }
+            let localeId = Locale.preferredLanguages.first?.hasPrefix("ru") == true ? "ru-RU" : "en-US"
+            guard let recognizer = SFSpeechRecognizer(locale: Locale(identifier: localeId)), recognizer.isAvailable, recognizer.supportsOnDeviceRecognition,
+                  let format = AVAudioFormat(commonFormat: .pcmFormatFloat32, sampleRate: 16000.0, channels: 1, interleaved: false),
+                  let buffer = AVAudioPCMBuffer(pcmFormat: format, frameCapacity: AVAudioFrameCount(samples.count)), let channel = buffer.floatChannelData?[0] else {
+                return completion([])
+            }
+            buffer.frameLength = AVAudioFrameCount(samples.count)
+            for (index, sample) in samples.enumerated() {
+                channel[index] = Float(sample) / 32768.0
+            }
+            let request = SFSpeechAudioBufferRecognitionRequest()
+            request.requiresOnDeviceRecognition = true
+            request.shouldReportPartialResults = false
+            request.append(buffer)
+            request.endAudio()
+            let lock = NSLock()
+            var finished = false
+            let task = recognizer.recognitionTask(with: request, resultHandler: { result, error in
+                lock.lock()
+                let alreadyFinished = finished
+                if (result?.isFinal ?? false) || error != nil {
+                    finished = true
+                }
+                lock.unlock()
+                guard !alreadyFinished else { return }
+                if let result, result.isFinal {
+                    completion(result.bestTranscription.segments.filter { isProfanity($0.substring) }.map { $0.timestamp ..< ($0.timestamp + max(0.2, $0.duration)) })
+                } else if error != nil {
+                    completion([])
+                }
+            })
+            // A recognizer that never produces a final result must not hold a video send forever.
+            DispatchQueue.global(qos: .userInitiated).asyncAfter(deadline: .now() + 20.0) {
+                lock.lock()
+                let alreadyFinished = finished
+                finished = true
+                lock.unlock()
+                guard !alreadyFinished else { return }
+                task.cancel()
+                completion([])
+            }
+        }
+    }
+
+    /// Covers the ranges in samples at `sampleRate`, with 50 ms of margin.
+    public static func cover(_ samples: inout [Int16], ranges: [Range<Double>], sampleRate: Double, beep: Bool) {
+        let margin = Int(sampleRate * 0.05)
+        for range in ranges {
+            let start = max(0, Int(range.lowerBound * sampleRate) - margin)
+            let end = min(samples.count, Int(range.upperBound * sampleRate) + margin)
+            guard start < end else { continue }
+            for index in start ..< end {
+                samples[index] = beep ? Int16(sin(Double(index) * 2.0 * .pi * 1000.0 / sampleRate) * 9000.0) : 0
+            }
+        }
+    }
+
+    /// Bleeps the audio track of a video file in place (used for video messages). Calls back on
+    /// the main queue; the file is left untouched when nothing was found or something failed.
+    public static func processVideo(path: String, beep: Bool, completion: @escaping () -> Void) {
+        let finish = { DispatchQueue.main.async(execute: completion) }
+        DispatchQueue.global(qos: .userInitiated).async {
+            let url = URL(fileURLWithPath: path)
+            let asset = AVURLAsset(url: url)
+            guard let audioTrack = asset.tracks(withMediaType: .audio).first, let videoTrack = asset.tracks(withMediaType: .video).first,
+                  let reader = try? AVAssetReader(asset: asset) else { return finish() }
+            let output = AVAssetReaderTrackOutput(track: audioTrack, outputSettings: [
+                AVFormatIDKey: kAudioFormatLinearPCM, AVSampleRateKey: 16000, AVNumberOfChannelsKey: 1,
+                AVLinearPCMBitDepthKey: 16, AVLinearPCMIsFloatKey: false, AVLinearPCMIsBigEndianKey: false, AVLinearPCMIsNonInterleaved: false
+            ])
+            guard reader.canAdd(output) else { return finish() }
+            reader.add(output)
+            guard reader.startReading() else { return finish() }
+            var samples: [Int16] = []
+            while let buffer = output.copyNextSampleBuffer() {
+                guard let block = CMSampleBufferGetDataBuffer(buffer) else { continue }
+                var length = 0
+                var pointer: UnsafeMutablePointer<Int8>?
+                guard CMBlockBufferGetDataPointer(block, atOffset: 0, lengthAtOffsetOut: nil, totalLengthOut: &length, dataPointerOut: &pointer) == kCMBlockBufferNoErr, let pointer else { continue }
+                pointer.withMemoryRebound(to: Int16.self, capacity: length / 2) { values in
+                    samples.append(contentsOf: UnsafeBufferPointer(start: values, count: length / 2))
+                }
+            }
+            recognize(samples, completion: { ranges in
+                guard !ranges.isEmpty else { return finish() }
+                var edited = samples
+                cover(&edited, ranges: ranges, sampleRate: 16000.0, beep: beep)
+                // New audio as an AAC file, then video (passthrough) + new audio into the original path.
+                let audioURL = FileManager.default.temporaryDirectory.appendingPathComponent("ayu_bleep_\(Int64.random(in: 1 ... Int64.max)).m4a")
+                guard let format = AVAudioFormat(commonFormat: .pcmFormatInt16, sampleRate: 16000.0, channels: 1, interleaved: true),
+                      let pcm = AVAudioPCMBuffer(pcmFormat: format, frameCapacity: AVAudioFrameCount(edited.count)),
+                      let file = try? AVAudioFile(forWriting: audioURL, settings: [AVFormatIDKey: kAudioFormatMPEG4AAC, AVSampleRateKey: 16000, AVNumberOfChannelsKey: 1], commonFormat: .pcmFormatInt16, interleaved: true) else { return finish() }
+                pcm.frameLength = AVAudioFrameCount(edited.count)
+                edited.withUnsafeBufferPointer { source in
+                    if let target = pcm.int16ChannelData?[0], let base = source.baseAddress {
+                        target.update(from: base, count: edited.count)
+                    }
+                }
+                guard (try? file.write(from: pcm)) != nil else { return finish() }
+                let composition = AVMutableComposition()
+                let range = CMTimeRange(start: .zero, duration: asset.duration)
+                guard let compositionVideo = composition.addMutableTrack(withMediaType: .video, preferredTrackID: kCMPersistentTrackID_Invalid),
+                      let compositionAudio = composition.addMutableTrack(withMediaType: .audio, preferredTrackID: kCMPersistentTrackID_Invalid),
+                      let newAudioTrack = AVURLAsset(url: audioURL).tracks(withMediaType: .audio).first,
+                      (try? compositionVideo.insertTimeRange(range, of: videoTrack, at: .zero)) != nil else { return finish() }
+                compositionVideo.preferredTransform = videoTrack.preferredTransform
+                let audioRange = CMTimeRange(start: .zero, duration: min(asset.duration, AVURLAsset(url: audioURL).duration))
+                guard (try? compositionAudio.insertTimeRange(audioRange, of: newAudioTrack, at: .zero)) != nil,
+                      let export = AVAssetExportSession(asset: composition, presetName: AVAssetExportPresetPassthrough) else { return finish() }
+                let outputURL = FileManager.default.temporaryDirectory.appendingPathComponent("ayu_bleep_\(Int64.random(in: 1 ... Int64.max)).mp4")
+                export.outputURL = outputURL
+                export.outputFileType = .mp4
+                export.exportAsynchronously {
+                    if export.status == .completed {
+                        _ = try? FileManager.default.replaceItemAt(url, withItemAt: outputURL)
+                    }
+                    try? FileManager.default.removeItem(at: audioURL)
+                    finish()
+                }
+            })
+        }
+    }
+}
diff --git a/submodules/Display/Source/AyuTextShortcuts.swift b/submodules/Display/Source/AyuTextShortcuts.swift
new file mode 100644
index 00000000..bf295657
--- /dev/null
+++ b/submodules/Display/Source/AyuTextShortcuts.swift
@@ -0,0 +1,72 @@
+import Foundation
+import UIKit
+
+/// Text shortcuts and templates (Settings → AyuGram → Tools → Shortcuts): a message that is
+/// exactly `;adr` becomes the saved text; {date}, {time}, {clipboard} and {weekday} are filled in
+/// any message that contains them.
+public enum AyuTextShortcuts {
+    public struct Shortcut: Codable, Equatable {
+        public var trigger: String
+        public var text: String
+
+        public init(trigger: String, text: String) {
+            self.trigger = trigger
+            self.text = text
+        }
+    }
+
+    public static let didChangeNotification = Notification.Name("AyuGram.ShortcutsChanged")
+    private static let key = "ayu.shortcuts.items"
+    private static let enabledKey = "ayu.shortcuts.variables"
+
+    public static var shortcuts: [Shortcut] {
+        get {
+            guard let data = UserDefaults.standard.data(forKey: key), let value = try? JSONDecoder().decode([Shortcut].self, from: data) else { return [] }
+            return value
+        }
+        set {
+            UserDefaults.standard.set(try? JSONEncoder().encode(Array(newValue.prefix(100))), forKey: key)
+            NotificationCenter.default.post(name: didChangeNotification, object: nil)
+        }
+    }
+
+    /// Fill {date}, {time}, {weekday}, {clipboard} in outgoing messages.
+    public static var variablesEnabled: Bool {
+        get { return UserDefaults.standard.bool(forKey: enabledKey) }
+        set {
+            UserDefaults.standard.set(newValue, forKey: enabledKey)
+            NotificationCenter.default.post(name: didChangeNotification, object: nil)
+        }
+    }
+
+    public static var isActive: Bool {
+        return !AyuDecoyMode.isActive && (variablesEnabled || !shortcuts.isEmpty)
+    }
+
+    /// The text to send instead, or nil to keep it.
+    public static func apply(_ text: String) -> String? {
+        guard isActive else { return nil }
+        var result = text
+        let trimmed = text.trimmingCharacters(in: .whitespacesAndNewlines)
+        if let shortcut = shortcuts.first(where: { $0.trigger == trimmed }) {
+            result = shortcut.text
+        }
+        if variablesEnabled || result != text, result.contains("{") {
+            let now = Date()
+            let formatter = DateFormatter()
+            formatter.locale = Locale.current
+            formatter.dateStyle = .medium
+            formatter.timeStyle = .none
+            result = result.replacingOccurrences(of: "{date}", with: formatter.string(from: now))
+            formatter.dateStyle = .none
+            formatter.timeStyle = .short
+            result = result.replacingOccurrences(of: "{time}", with: formatter.string(from: now))
+            formatter.dateFormat = "EEEE"
+            result = result.replacingOccurrences(of: "{weekday}", with: formatter.string(from: now))
+            if result.contains("{clipboard}") {
+                result = result.replacingOccurrences(of: "{clipboard}", with: UIPasteboard.general.string ?? "")
+            }
+        }
