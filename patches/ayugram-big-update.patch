+    /// Lowercased, diacritic-free, Cyrillic transliterated, without featured artists, bracketed
+    /// labels and punctuation — so "Кино – Группа крови (Remastered)" and "Kino - Gruppa krovi" meet.
+    static func normalizedKey(_ text: String) -> String {
+        var value = self.searchTitle(text)
+        value = value.replacingOccurrences(of: #"\s*[\(\[]\s*(?:feat\.?|ft\.?|при уч\.?|with)\b.*?[\)\]]|\s+(?:feat\.?|ft\.?)\s+.*$"#, with: "", options: [.regularExpression, .caseInsensitive])
+        value = value.folding(options: [.diacriticInsensitive, .caseInsensitive, .widthInsensitive], locale: Locale(identifier: "en_US_POSIX")).lowercased()
+        var result = ""
+        for character in value {
+            if let latin = self.cyrillic[character] {
+                result += latin
+            } else if character.isLetter || character.isNumber {
+                result.append(character)
+            } else {
+                result.append(" ")
+            }
+        }
+        return result.split(separator: " ").joined(separator: " ")
+    }
+
+    private static func tokens(_ text: String) -> Set<String> {
+        return Set(self.normalizedKey(text).split(separator: " ").map(String.init))
+    }
+
+    /// 0…1: token overlap, with full credit when one normalized form contains the other.
+    static func similarity(_ lhs: String, _ rhs: String) -> Double {
+        let a = self.normalizedKey(lhs), b = self.normalizedKey(rhs)
+        guard !a.isEmpty, !b.isEmpty else { return 0.0 }
+        if a == b { return 1.0 }
+        let compactA = a.replacingOccurrences(of: " ", with: ""), compactB = b.replacingOccurrences(of: " ", with: "")
+        if compactA == compactB { return 1.0 }
+        if compactA.count >= 4 && compactB.count >= 4 && (compactA.contains(compactB) || compactB.contains(compactA)) { return 0.9 }
+        let ta = self.tokens(lhs), tb = self.tokens(rhs)
+        let union = ta.union(tb).count
+        return union == 0 ? 0.0 : Double(ta.intersection(tb).count) / Double(union)
+    }
+
+    /// Overall confidence that a candidate is the playing recording (0…1).
+    /// A duration mismatch beyond a few seconds means a different recording.
+    static func matchScore(candidateTitle: String, candidateArtist: String?, candidateDuration: Double?, title: String, artist: String?, duration: Double) -> Double {
+        let titleScore = self.similarity(candidateTitle, title)
+        var score = titleScore
+        if let artist, !artist.isEmpty {
+            if let candidateArtist, !candidateArtist.isEmpty {
+                let artistScore = max(self.similarity(candidateArtist, artist), self.artistOverlap(candidateArtist, artist))
+                score = titleScore * 0.65 + artistScore * 0.35
+            } else {
+                score = titleScore * 0.8
+            }
+        }
+        if duration > 0.0, let candidateDuration, candidateDuration > 0.0 {
+            let delta = abs(candidateDuration - duration)
+            if delta <= 2.0 { score += 0.1 } else if delta > 6.0 { score -= min(0.4, (delta - 6.0) / 60.0 + 0.15) }
+        }
+        return max(0.0, min(1.0, score))
+    }
+
+    /// Any of the credited artists ("A & B, C feat. D") matching counts.
+    private static func artistOverlap(_ lhs: String, _ rhs: String) -> Double {
+        let separators = CharacterSet(charactersIn: ",;&/")
+        let split: (String) -> [String] = { value in
+            return value.replacingOccurrences(of: #"\s+(?:feat\.?|ft\.?|x|vs\.?|and|и)\s+"#, with: ",", options: [.regularExpression, .caseInsensitive])
+                .components(separatedBy: separators).map { $0.trimmingCharacters(in: .whitespaces) }.filter { !$0.isEmpty }
+        }
+        var best = 0.0
+        for a in split(lhs) { for b in split(rhs) { best = max(best, self.similarity(a, b)) } }
+        return best
+    }
