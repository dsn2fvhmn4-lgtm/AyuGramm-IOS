+/// Permissions granted later (`ayu.permissions.request`) and ones the user took back in the plugin
+/// manager. The effective set is declared + granted − revoked.
+public enum AyuPluginGrants {
+    private static func key(_ kind: String, _ id: String) -> String {
+        return "ayu.plugin.\(kind).\(id)"
+    }
+
+    public static func revoked(_ id: String) -> Set<String> {
+        return Set(UserDefaults.standard.stringArray(forKey: key("revoked", id)) ?? [])
+    }
+
+    public static func granted(_ id: String) -> Set<String> {
+        return Set(UserDefaults.standard.stringArray(forKey: key("granted", id)) ?? [])
+    }
+
+    public static func setRevoked(_ id: String, _ permission: String, _ revoked: Bool) {
+        var value = AyuPluginGrants.revoked(id)
+        if revoked { value.insert(permission) } else { value.remove(permission) }
+        UserDefaults.standard.set(Array(value).sorted(), forKey: key("revoked", id))
+    }
+
+    public static func grant(_ id: String, _ permissions: [String]) {
+        let value = AyuPluginGrants.granted(id).union(permissions)
+        UserDefaults.standard.set(Array(value).sorted(), forKey: key("granted", id))
+        var revoked = AyuPluginGrants.revoked(id)
+        revoked.subtract(permissions)
+        UserDefaults.standard.set(Array(revoked).sorted(), forKey: key("revoked", id))
+    }
+
+    public static func effective(_ plugin: AyuScriptRuntime.Plugin) -> Set<String> {
+        return Set(plugin.permissions ?? []).union(granted(plugin.id)).subtracting(revoked(plugin.id))
+    }
+
+    public static func parseHosts(_ text: String) -> [String] {
+        return text.split(whereSeparator: { $0 == "," || $0 == " " }).map { $0.lowercased() }.filter { host in
+            !host.isEmpty && !host.contains("/") && (!host.contains("*") || host.hasPrefix("*.")) && host.count <= 253
+        }.prefix(32).map { $0 }
+    }
+
+    /// `host` matches `api.example.com` exactly or `*.example.com` by suffix.
+    public static func allows(_ patterns: [String], host: String) -> Bool {
+        let host = host.lowercased()
+        return patterns.contains(where: { pattern in
+            if pattern.hasPrefix("*.") {
+                let suffix = String(pattern.dropFirst(1))
+                return host.hasSuffix(suffix) || host == String(pattern.dropFirst(2))
+            }
+            return host == pattern
+        })
+    }
+}
