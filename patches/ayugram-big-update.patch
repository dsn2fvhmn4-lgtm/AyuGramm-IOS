+import Foundation
+import UIKit
+import SwiftSignalKit
+import TelegramCore
+import AccountContext
+import UrlHandling
+
+/// Proxy tools on top of Telegram's own list: ping every saved proxy and switch to the fastest,
+/// and import many proxy links at once from the clipboard.
+enum AyuProxyManager {
+    private static func currentSettings(_ context: AccountContext) -> Signal<ProxySettings, NoError> {
+        return context.sharedContext.accountManager.sharedData(keys: [SharedDataKeys.proxySettings])
+        |> take(1)
+        |> map { view -> ProxySettings in
+            return view.entries[SharedDataKeys.proxySettings]?.get(ProxySettings.self) ?? ProxySettings.defaultSettings
+        }
+    }
+
+    private static func present(_ context: AccountContext, _ title: String, _ message: String) {
+        let alert = UIAlertController(title: title, message: message, preferredStyle: .alert)
+        alert.addAction(UIAlertAction(title: "OK", style: .default))
+        context.sharedContext.applicationBindings.presentNativeController(alert)
+    }
+
+    /// Pings all saved proxies (up to 15 s), shows the results and turns on the fastest one.
+    static func pickFastest(context: AccountContext, russian ru: Bool) {
+        let _ = (currentSettings(context)
+        |> deliverOnMainQueue).startStandalone(next: { settings in
+            let servers = settings.servers
+            guard !servers.isEmpty else {
+                present(context, ru ? "Прокси" : "Proxy", ru ? "Нет сохранённых прокси. Добавьте их в Данные и память → Прокси или импортируйте из буфера." : "No saved proxies. Add them in Data and Storage → Proxy or import from the clipboard.")
+                return
+            }
+            let statuses = ProxyServersStatuses(network: context.account.network, servers: .single(servers))
+            let done = statuses.statuses()
+            |> filter { value in
+                // Wait until every server answered or failed.
+                return servers.allSatisfy { server in
+                    if let status = value[server], status != .checking { return true }
+                    return false
+                }
+            }
+            |> take(1)
+            |> timeout(15.0, queue: .mainQueue(), alternate: statuses.statuses() |> take(1))
+            let _ = (done |> deliverOnMainQueue).startStandalone(next: { value in
+                withExtendedLifetime(statuses) {}
+                var results: [(ProxyServerSettings, Double)] = []
+                var lines: [String] = []
+                for server in servers {
+                    switch value[server] {
+                    case let .available(rtt)?:
+                        results.append((server, rtt))
+                        lines.append("✅ \(server.host):\(server.port) — \(Int(rtt * 1000)) ms")
+                    default:
+                        lines.append("❌ \(server.host):\(server.port)")
+                    }
+                }
+                guard let best = results.min(by: { $0.1 < $1.1 })?.0 else {
+                    present(context, ru ? "Ни один прокси не отвечает" : "No proxy answers", lines.joined(separator: "\n"))
+                    return
+                }
+                let _ = updateProxySettingsInteractively(accountManager: context.sharedContext.accountManager, { settings in
+                    var settings = settings
+                    settings.activeServer = best
+                    settings.enabled = true
+                    return settings
+                }).startStandalone()
+                present(context, (ru ? "Включён самый быстрый: " : "Fastest enabled: ") + best.host, lines.joined(separator: "\n"))
+            })
+        })
+    }
+
+    /// Every tg://proxy, tg://socks and t.me/proxy link in the clipboard text is added.
+    static func importFromClipboard(context: AccountContext, russian ru: Bool) {
+        let text = UIPasteboard.general.string ?? ""
+        let candidates = text.components(separatedBy: CharacterSet.whitespacesAndNewlines.union(CharacterSet(charactersIn: ",;\"'<>")))
+            .filter { $0.hasPrefix("tg://") || $0.contains("t.me/proxy") || $0.contains("t.me/socks") || $0.contains("telegram.me/proxy") }
+        var found: [ProxyServerSettings] = []
+        for candidate in candidates {
+            let link = candidate.hasPrefix("http") || candidate.hasPrefix("tg://") ? candidate : "https://" + candidate
+            guard let proxy = parseProxyUrl(sharedContext: context.sharedContext, url: link) else { continue }
+            let server: ProxyServerSettings
+            if let secret = proxy.secret {
+                server = ProxyServerSettings(host: proxy.host, port: proxy.port, connection: .mtp(secret: secret))
+            } else {
+                server = ProxyServerSettings(host: proxy.host, port: proxy.port, connection: .socks5(username: proxy.username, password: proxy.password))
+            }
+            if !found.contains(server) {
+                found.append(server)
+            }
+        }
+        guard !found.isEmpty else {
+            present(context, ru ? "Импорт прокси" : "Proxy import", ru ? "В буфере обмена нет ссылок на прокси (tg://proxy, t.me/proxy, tg://socks)." : "No proxy links in the clipboard (tg://proxy, t.me/proxy, tg://socks).")
+            return
+        }
+        let _ = (updateProxySettingsInteractively(accountManager: context.sharedContext.accountManager, { settings in
+            var settings = settings
+            for server in found where !settings.servers.contains(server) {
+                settings.servers.append(server)
+            }
+            return settings
+        }) |> deliverOnMainQueue).startStandalone(completed: {
+            present(context, ru ? "Импорт прокси" : "Proxy import", (ru ? "Добавлено прокси: " : "Proxies added: ") + "\(found.count). " + (ru ? "Нажмите «Выбрать самый быстрый», чтобы включить лучший." : "Tap “Pick the fastest” to turn on the best one."))
+        })
+    }
+}
