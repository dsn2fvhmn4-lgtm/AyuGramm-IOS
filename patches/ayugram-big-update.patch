+/// Downloads a list of media into one folder, one file at a time, then offers to share or save
+/// it. Used by sticker pack export and by "download all media" in a chat.
+final class AyuBulkDownload {
+    struct Item {
+        let reference: MediaResourceReference
+        let resource: EngineMediaResource
+        let fileName: String
+        let contentType: MediaResourceUserContentType
+    }
+
+    private static var running: [AyuBulkDownload] = []
+
+    private let context: AccountContext
+    private let items: [Item]
+    private let folder: URL
+    private let title: String
+    private let disposable = MetaDisposable()
+    private let fetchDisposable = MetaDisposable()
+    private var index = 0
+    private var saved: [URL] = []
+    private var progressController: UndoOverlayController?
+
+    private init(context: AccountContext, items: [Item], folderName: String, title: String) {
+        self.context = context
+        self.items = items
+        self.title = title
+        let safe = folderName.components(separatedBy: CharacterSet(charactersIn: "/\\:?*\"<>|")).joined(separator: "_")
+        self.folder = FileManager.default.temporaryDirectory.appendingPathComponent("AyuExport", isDirectory: true).appendingPathComponent(safe.isEmpty ? "export" : safe, isDirectory: true)
+    }
+
+    static func start(context: AccountContext, items: [Item], folderName: String, title: String) {
+        guard !items.isEmpty else { return }
+        let task = AyuBulkDownload(context: context, items: items, folderName: folderName, title: title)
+        running.append(task)
+        try? FileManager.default.removeItem(at: task.folder)
+        try? FileManager.default.createDirectory(at: task.folder, withIntermediateDirectories: true)
+        task.next()
+    }
+
+    private var ru: Bool {
+        return self.context.sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru")
+    }
+
+    private func showProgress() {
+        let presentationData = self.context.sharedContext.currentPresentationData.with { $0 }
+        let text = (self.ru ? "Скачивание " : "Downloading ") + "\(self.index + 1)/\(self.items.count)"
+        if let progressController = self.progressController {
+            progressController.content = .info(title: self.title, text: text, timeout: nil, customUndoText: nil)
+        } else {
+            let controller = UndoOverlayController(presentationData: presentationData, content: .info(title: self.title, text: text, timeout: nil, customUndoText: self.ru ? "Отмена" : "Cancel"), action: { [weak self] action in
+                if case .undo = action {
+                    self?.cancel()
+                }
+                return true
+            })
+            self.progressController = controller
+            self.context.sharedContext.mainWindow?.present(controller, on: .root)
+        }
+    }
+
+    private func next() {
+        guard self.index < self.items.count else {
+            self.finish()
+            return
+        }
+        self.showProgress()
+        let item = self.items[self.index]
+        // The fetch runs on its own; the export waits for the complete file, or skips it after a minute.
+        self.fetchDisposable.set(self.context.engine.resources.fetch(reference: item.reference, userLocation: .other, userContentType: item.contentType).startStrict())
+        let combined = self.context.engine.resources.data(resource: item.resource)
+        |> filter { $0.isComplete }
+        |> take(1)
+        |> map { _ -> Bool in true }
+        |> timeout(60.0, queue: .mainQueue(), alternate: .single(false))
+        self.disposable.set((combined
+        |> deliverOnMainQueue).startStrict(next: { [weak self] completed in
+            guard let self else { return }
+            if completed, let path = self.context.engine.resources.completedResourcePath(id: item.resource.id) {
+                let target = self.folder.appendingPathComponent(String(format: "%04d_", self.index + 1) + item.fileName)
+                if (try? FileManager.default.copyItem(at: URL(fileURLWithPath: path), to: target)) != nil {
+                    self.saved.append(target)
+                }
+            }
+            self.index += 1
+            self.next()
+        }))
+    }
+
+    private func cancel() {
+        self.disposable.dispose()
+        self.fetchDisposable.dispose()
+        self.progressController = nil
+        AyuBulkDownload.running.removeAll(where: { $0 === self })
+    }
+
+    private func finish() {
+        self.fetchDisposable.dispose()
+        self.progressController?.dismiss()
+        self.progressController = nil
+        AyuBulkDownload.running.removeAll(where: { $0 === self })
+        guard !self.saved.isEmpty else {
+            AyuOnlineTools.present(self.context, title: self.title, message: self.ru ? "Ничего не скачалось." : "Nothing was downloaded.")
+            return
+        }
+        let activity = UIActivityViewController(activityItems: self.saved, applicationActivities: nil)
+        self.context.sharedContext.applicationBindings.presentNativeController(activity)
+    }
+}
+
+extension AyuBulkDownload {
+    /// Every sticker of a pack as files (webp, tgs or webm).
+    static func exportStickerPack(context: AccountContext, reference: StickerPackReference) {
+        let _ = (context.engine.stickers.loadedStickerPack(reference: reference, forceActualized: false)
+        |> filter { result in
+            if case .fetching = result { return false }
+            return true
+        }
+        |> take(1)
+        |> deliverOnMainQueue).startStandalone(next: { result in
+            guard case let .result(info, items, _) = result else { return }
+            let files: [Item] = items.enumerated().map { index, item in
+                let file = item.file._parse()
+                let ext: String
+                if file.isAnimatedSticker {
+                    ext = "tgs"
+                } else if file.isVideoSticker {
+                    ext = "webm"
+                } else {
+                    ext = "webp"
+                }
+                return Item(reference: stickerPackFileReference(file).resourceReference(file.resource), resource: EngineMediaResource(file.resource), fileName: "sticker_\(index + 1).\(ext)", contentType: .sticker)
+            }
+            let ru = context.sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru")
+            start(context: context, items: files, folderName: info.title, title: ru ? "Экспорт стикерпака" : "Sticker pack export")
+        })
+    }
+
+    /// The photos, videos and files stored for a chat (newest first, up to `limit`).
+    static func downloadChatMedia(context: AccountContext, peerId: EnginePeer.Id, title: String, limit: Int = 500) {
+        let _ = (context.engine.messages.ayuMessagesSince(peerId: peerId, since: 0, limit: 5000)
+        |> deliverOnMainQueue).startStandalone(next: { messages in
+            var items: [Item] = []
+            for message in messages {
+                guard items.count < limit else { break }
+                let messageReference = MessageReference(message._asMessage())
+                for media in message.media {
+                    if let image = media as? TelegramMediaImage, let representation = largestImageRepresentation(image.representations) {
+                        let reference = AnyMediaReference.message(message: messageReference, media: image).resourceReference(representation.resource)
+                        items.append(Item(reference: reference, resource: EngineMediaResource(representation.resource), fileName: "photo_\(message.id.id).jpg", contentType: .image))
+                    } else if let file = media as? TelegramMediaFile, !file.isSticker, !file.isAnimatedSticker, !file.isCustomEmoji {
+                        let reference = AnyMediaReference.message(message: messageReference, media: file).resourceReference(file.resource)
+                        let name = file.fileName ?? (file.isVideo ? "video_\(message.id.id).mp4" : file.isVoice ? "voice_\(message.id.id).ogg" : "file_\(message.id.id)")
+                        items.append(Item(reference: reference, resource: EngineMediaResource(file.resource), fileName: name, contentType: file.isVideo ? .video : .file))
+                    }
+                }
+            }
+            let ru = context.sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru")
+            if items.isEmpty {
+                AyuOnlineTools.present(context, title: title, message: ru ? "В загруженной истории нет медиа. Пролистайте чат, чтобы подгрузить сообщения." : "No media in the loaded history. Scroll the chat to load messages.")
+                return
+            }
+            start(context: context, items: items, folderName: title, title: ru ? "Скачивание медиа" : "Downloading media")
+        })
+    }
+}
