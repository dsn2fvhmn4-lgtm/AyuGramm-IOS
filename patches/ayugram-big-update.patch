+/// WhiteGram OLED mode, read once per launch: whatever theme is selected, the app uses
+/// Telegram's true-black night theme with gray bubbles, a dark keyboard and a black wallpaper.
+private let ayuOledModeEnabled: Bool = AyuWhiteGram.oledMode
+private let ayuOledLock = NSLock()
+private var ayuOledThemes: [UInt32: PresentationTheme] = [:]
+
+private func ayuOledTheme(from theme: PresentationTheme) -> PresentationTheme {
+    let accent = theme.list.itemAccentColor.rgb
+    ayuOledLock.lock()
+    defer { ayuOledLock.unlock() }
+    if let cached = ayuOledThemes[accent] {
+        return cached
+    }
+    if ayuOledThemes.values.contains(where: { $0 === theme }) {
+        return theme
+    }
+    let base = makeDefaultDarkPresentationTheme(preview: false)
+    let oled = customizeDefaultDarkPresentationTheme(theme: base, editing: true, title: nil, accentColor: UIColor(rgb: accent), backgroundColors: [], bubbleColors: [0x3a3a3c, 0x3a3a3c], animateBubbleColors: false, wallpaper: .color(0x000000))
+    ayuOledThemes[accent] = oled
+    return oled
+}
+
+/// The Telegram text size nearest to a plugin's requested size in points.
+private func ayuPluginFontSize(_ element: String) -> PresentationFontSize? {
+    guard let size = AyuPluginFonts.size(element: element) else { return nil }
+    let steps: [(Double, PresentationFontSize)] = [(14.0, .extraSmall), (15.0, .small), (16.0, .medium), (17.0, .regular), (19.0, .large), (21.0, .extraLarge), (23.0, .extraLargeX2)]
+    return steps.min(by: { abs($0.0 - size) < abs($1.0 - size) })?.1
+}
