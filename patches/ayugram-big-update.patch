+        entries.append(.link(4, AyuAppearancePlusRow.reset.rawValue, symbol("arrow.counterclockwise", 0xFF3B30), ru ? "Сбросить оформление" : "Reset appearance", ""))
+        entries.append(.header(5, AyuAppearancePlusRow.effectsHeader.rawValue, ru ? "ЭФФЕКТЫ" : "EFFECTS"))
+        entries.append(.link(5, AyuAppearancePlusRow.effect.rawValue, symbol("snowflake", 0x5AC8FA), ru ? "Эффект поверх Telegram" : "Effect over Telegram", AyuOverlayEffects.effect.title(ru)))
+        if AyuOverlayEffects.effect != .none {
+            entries.append(.link(5, AyuAppearancePlusRow.effectAmount.rawValue, symbol("circle.grid.3x3.fill", 0xAF52DE), ru ? "Количество" : "Amount", String(format: "%g×", AyuOverlayEffects.amount)))
+            entries.append(.link(5, AyuAppearancePlusRow.effectSpeed.rawValue, symbol("wind", 0x34C759), ru ? "Скорость" : "Speed", String(format: "%g×", AyuOverlayEffects.speed)))
+        }
+        entries.append(.info(5, AyuAppearancePlusRow.effectsInfo.rawValue, ru ? "Снег — белые точки на фоне чата, под сообщениями. Листья и другие эффекты падают поверх приложения и не мешают нажатиям. При включённом «Уменьшении движения» в iOS эффекты не показываются." : "Snow is white dots in the chat background, under the messages. Leaves and other effects fall over the app and never block taps. With iOS Reduce Motion on, effects are hidden."))
+        let data = ItemListPresentationData(presentationData)
+        let state = ItemListControllerState(presentationData: data, title: .text(ru ? "Оформление+" : "Appearance+"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
