@@ -0,0 +1,83 @@
+import Foundation
+import UIKit
+import LocalAuthentication
+import Display
+import TelegramCore
+
+/// A chat locked with Face ID: its content stays under a blur until the owner authenticates.
+final class AyuChatLockView: UIView {
+    var unlock: (() -> Void)?
+
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+        let blur = UIVisualEffectView(effect: UIBlurEffect(style: .systemThickMaterial))
+        blur.frame = self.bounds
+        blur.autoresizingMask = [.flexibleWidth, .flexibleHeight]
+        self.addSubview(blur)
+        let icon = UIImageView(image: UIImage(systemName: "lock.fill", withConfiguration: UIImage.SymbolConfiguration(pointSize: 40.0, weight: .medium)))
+        icon.tintColor = .label
+        let button = UIButton(type: .system)
+        let ru = Locale.preferredLanguages.first?.hasPrefix("ru") == true
+        button.setTitle(ru ? "Разблокировать" : "Unlock", for: .normal)
+        button.titleLabel?.font = UIFont.systemFont(ofSize: 17.0, weight: .semibold)
+        button.addTarget(self, action: #selector(self.unlockPressed), for: .touchUpInside)
+        let stack = UIStackView(arrangedSubviews: [icon, button])
+        stack.axis = .vertical
+        stack.spacing = 16.0
+        stack.alignment = .center
+        stack.translatesAutoresizingMaskIntoConstraints = false
+        self.addSubview(stack)
+        NSLayoutConstraint.activate([
+            stack.centerXAnchor.constraint(equalTo: self.centerXAnchor),
+            stack.centerYAnchor.constraint(equalTo: self.centerYAnchor)
+        ])
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    @objc private func unlockPressed() {
+        self.unlock?()
+    }
+}
+
+extension ChatControllerImpl {
+    /// Covers a locked chat and asks for Face ID / Touch ID (or the device passcode).
+    func ayuApplyChatLock() {
+        guard let peerId = self.chatLocation.peerId else { return }
+        let value = peerId.toInt64()
+        guard AyuChatPrivacy.isLocked(value), !AyuChatPrivacy.isUnlocked(value) else { return }
+        if self.view.subviews.contains(where: { $0 is AyuChatLockView }) {
+            return
+        }
+        let lockView = AyuChatLockView(frame: self.view.bounds)
+        lockView.autoresizingMask = [.flexibleWidth, .flexibleHeight]
+        self.view.addSubview(lockView)
+        let authenticate = { [weak self, weak lockView] in
+            let context = LAContext()
+            let ru = Locale.preferredLanguages.first?.hasPrefix("ru") == true
+            var error: NSError?
+            guard context.canEvaluatePolicy(.deviceOwnerAuthentication, error: &error) else {
+                // No Face ID and no passcode on the device: nothing to check against.
+                AyuChatPrivacy.markUnlocked(value)
+                lockView?.removeFromSuperview()
+                return
+            }
+            context.evaluatePolicy(.deviceOwnerAuthentication, localizedReason: ru ? "Откройте заблокированный чат" : "Open the locked chat", reply: { success, _ in
+                DispatchQueue.main.async {
+                    if success {
+                        AyuChatPrivacy.markUnlocked(value)
+                        UIView.animate(withDuration: 0.2, animations: { lockView?.alpha = 0.0 }, completion: { _ in lockView?.removeFromSuperview() })
+                    } else if let self {
+                        let _ = self.navigationController?.popViewController(animated: true)
+                    }
+                }
+            })
+        }
+        lockView.unlock = authenticate
+        DispatchQueue.main.async {
+            authenticate()
+        }
+    }
+}
diff --git a/submodules/TelegramUI/Sources/AyuComposerBar.swift b/submodules/TelegramUI/Sources/AyuComposerBar.swift
new file mode 100644
index 00000000..b3421a72
--- /dev/null
+++ b/submodules/TelegramUI/Sources/AyuComposerBar.swift
@@ -0,0 +1,177 @@
+import Foundation
+import UIKit
+import Display
+import AccountContext
+import ChatPresentationInterfaceState
+import SwiftSignalKit
+import TelegramCore
+
+/// A thin row of chips above the composer: plugin buttons (`ayu.composer.addButton`) and dot
+/// commands (`ayu.commands.register`). Buttons send `composerButton` { id, text } to their plugin;
+/// a command chip puts ".command " into the input. Hidden when no plugin adds anything.
+final class AyuComposerBar: UIView {
+    private let scrollView = UIScrollView()
+    private let stack = UIStackView()
+    private weak var controller: ChatControllerImpl?
+    private var observers: [NSObjectProtocol] = []
+    private let translateDisposable = MetaDisposable()
+
+    init(controller: ChatControllerImpl) {
+        self.controller = controller
+        super.init(frame: .zero)
+        self.scrollView.showsHorizontalScrollIndicator = false
+        self.scrollView.translatesAutoresizingMaskIntoConstraints = false
+        self.stack.axis = .horizontal
+        self.stack.spacing = 8.0
+        self.stack.translatesAutoresizingMaskIntoConstraints = false
+        self.addSubview(self.scrollView)
+        self.scrollView.addSubview(self.stack)
+        NSLayoutConstraint.activate([
+            self.scrollView.leadingAnchor.constraint(equalTo: self.leadingAnchor),
+            self.scrollView.trailingAnchor.constraint(equalTo: self.trailingAnchor),
+            self.scrollView.topAnchor.constraint(equalTo: self.topAnchor),
+            self.scrollView.bottomAnchor.constraint(equalTo: self.bottomAnchor),
+            self.stack.leadingAnchor.constraint(equalTo: self.scrollView.contentLayoutGuide.leadingAnchor, constant: 12.0),
+            self.stack.trailingAnchor.constraint(equalTo: self.scrollView.contentLayoutGuide.trailingAnchor, constant: -12.0),
+            self.stack.centerYAnchor.constraint(equalTo: self.scrollView.centerYAnchor),
+            self.stack.heightAnchor.constraint(equalToConstant: 30.0)
+        ])
+        for name in [AyuPluginUI.didChangeNotification, AyuExtras.didChangeNotification] {
+            self.observers.append(NotificationCenter.default.addObserver(forName: name, object: nil, queue: .main, using: { [weak self] _ in
+                self?.rebuild()
+            }))
+        }
+        self.rebuild()
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    deinit {
+        for observer in self.observers {
+            NotificationCenter.default.removeObserver(observer)
+        }
+        self.translateDisposable.dispose()
+    }
+
+    private func chip(_ title: String, symbol: String?) -> UIButton {
+        let button = UIButton(type: .system)
+        var configuration = UIButton.Configuration.tinted()
+        configuration.title = title
+        configuration.cornerStyle = .capsule
+        configuration.buttonSize = .small
+        if let symbol {
+            configuration.image = UIImage(systemName: symbol)
+            configuration.imagePadding = 4.0
+        }
+        button.configuration = configuration
+        return button
+    }
+
+    private func rebuild() {
+        for view in self.stack.arrangedSubviews {
+            view.removeFromSuperview()
+        }
+        let buttons = AyuPluginUI.shared.composerButtons
+        let commands = AyuPluginUI.shared.commands
+        let translate = AyuExtras.isOn(.translateBeforeSend)
+        if translate {
+            self.stack.addArrangedSubview(self.translateButton())
+        }
+        for item in buttons {
+            let button = self.chip(item.title, symbol: item.icon ?? "puzzlepiece.extension")
+            button.addAction(UIAction(handler: { [weak self] _ in
+                guard let state = self?.controller?.presentationInterfaceState.interfaceState.effectiveInputState else { return }
+                let text = state.inputText.string as NSString
+                let range = state.selectionRange
+                let selected = range.isEmpty || range.upperBound > text.length ? "" : text.substring(with: NSRange(location: range.lowerBound, length: range.count))
+                AyuPluginUI.send("composerButton", to: item.owner, ["id": item.id, "text": text as String, "selection": selected, "selectionStart": range.lowerBound, "selectionEnd": range.upperBound])
+            }), for: .touchUpInside)
+            self.stack.addArrangedSubview(button)
+        }
+        for item in AyuPluginUI.shared.toolbarButtons {
+            let button = self.chip(item.title, symbol: item.icon ?? "square.grid.2x2")
+            button.addAction(UIAction(handler: { [weak self] _ in
+                let peerId = self?.controller?.chatLocation.peerId.map { String($0.toInt64()) } ?? ""
+                AyuPluginUI.send("chatToolbar", to: item.owner, ["id": item.id, "peerId": peerId])
+            }), for: .touchUpInside)
+            self.stack.addArrangedSubview(button)
+        }
+        for command in commands {
+            let button = self.chip(command.name, symbol: nil)
+            button.accessibilityHint = command.description
+            button.addAction(UIAction(handler: { [weak self] _ in
+                self?.controller?.ayuSetInputText(command.name + " ")
+            }), for: .touchUpInside)
+            self.stack.addArrangedSubview(button)
+        }
+        self.isHidden = buttons.isEmpty && commands.isEmpty && !translate && AyuPluginUI.shared.toolbarButtons.isEmpty
+    }
+
+    private static let languages: [(code: String, title: String)] = [
+        ("en", "English"), ("ru", "Русский"), ("uk", "Українська"), ("de", "Deutsch"), ("es", "Español"),
+        ("fr", "Français"), ("it", "Italiano"), ("pt", "Português"), ("tr", "Türkçe"), ("pl", "Polski"),
+        ("zh", "中文"), ("ja", "日本語"), ("ko", "한국어"), ("ar", "العربية"), ("kk", "Қазақша")
+    ]
+    private static let targetKey = "ayu.extra.translateTo"
+
+    /// Tap: translate to the last language. Long press: pick another one.
+    private func translateButton() -> UIButton {
+        let target = UserDefaults.standard.string(forKey: AyuComposerBar.targetKey) ?? "en"
+        let button = self.chip("→ " + target.uppercased(), symbol: "globe")
+        button.addAction(UIAction(handler: { [weak self] _ in
+            self?.translateDraft(to: UserDefaults.standard.string(forKey: AyuComposerBar.targetKey) ?? "en")
+        }), for: .touchUpInside)
+        button.menu = UIMenu(children: AyuComposerBar.languages.map { language in
+            return UIAction(title: language.title, state: language.code == target ? .on : .off, handler: { [weak self] _ in
+                UserDefaults.standard.set(language.code, forKey: AyuComposerBar.targetKey)
+                self?.rebuild()
+                self?.translateDraft(to: language.code)
+            })
+        })
+        return button
+    }
+
+    private func translateDraft(to language: String) {
+        guard let controller = self.controller else { return }
+        let text = controller.presentationInterfaceState.interfaceState.effectiveInputState.inputText.string
+        guard !text.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else { return }
+        // On-device Apple translation first (iOS 26+, downloaded languages), then Telegram's.
+        AyuAppleTranslation.translate(text, to: language, completion: { [weak self, weak controller] result in
+            if let result, !result.isEmpty {
+                controller?.ayuSetInputText(result)
+            } else {
+                self?.translateWithTelegram(text, to: language)
+            }
+        })
+    }
+
+    private func translateWithTelegram(_ text: String, to language: String) {
+        guard let controller = self.controller else { return }
+        self.translateDisposable.set((controller.context.engine.messages.translate(text: text, toLang: language)
+        |> deliverOnMainQueue).startStrict(next: { [weak controller] result in
+            if let (translated, _) = result {
+                controller?.ayuSetInputText(translated)
+            }
+        }, error: { _ in
+            UINotificationFeedbackGenerator().notificationOccurred(.error)
+        }))
+    }
+}
+
+extension ChatControllerImpl {
+    /// Adds the composer bar once, pinned just above the input panel and the keyboard.
+    func ayuInstallComposerBar() {
+        guard !AyuDecoyMode.isActive, !self.view.subviews.contains(where: { $0 is AyuComposerBar }) else { return }
+        let bar = AyuComposerBar(controller: self)
+        bar.translatesAutoresizingMaskIntoConstraints = false
+        self.view.addSubview(bar)
+        NSLayoutConstraint.activate([
+            bar.leadingAnchor.constraint(equalTo: self.view.leadingAnchor),
+            bar.trailingAnchor.constraint(equalTo: self.view.trailingAnchor),
+            bar.heightAnchor.constraint(equalToConstant: 36.0),
+            bar.bottomAnchor.constraint(equalTo: self.view.keyboardLayoutGuide.topAnchor, constant: -64.0)
+        ])
+    }
+}
diff --git a/submodules/TelegramUI/Sources/AyuDecoyUI.swift b/submodules/TelegramUI/Sources/AyuDecoyUI.swift
