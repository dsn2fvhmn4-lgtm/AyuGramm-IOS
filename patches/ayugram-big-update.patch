+/// "Verified by the AyuGram for iOS team": the list the team keeps with @ayugram_dev_settings_bot
+/// in github.com/murk-sus/AyuGramm-Plugins (registry/verified.json). The bot signs it with
+/// Ed25519; the app accepts it only when the signature matches the key below, so nobody else —
+/// plugins included — can add a name. Every AyuGram for iOS user sees the same labels.
+public final class AyuVerifiedRegistry {
+    public struct Entry: Codable, Equatable {
+        public let id: String
+        /// "sponsor", "developer", "plugins" or "custom".
+        public let kind: String
+        public let text: String
+        /// Optional https image shown at the top of the profile for AyuGram users.
+        public let banner: String?
+    }
+
+    private struct Registry: Codable {
+        let format: String
+        let entries: [Entry]
+    }
+
+    public static let shared = AyuVerifiedRegistry()
+    public static let didChangeNotification = Notification.Name("AyuGram.VerifiedRegistryChanged")
+
+    public static func bannerURL(_ value: String) -> URL? {
+        guard value.count <= 512, !value.contains("\\"),
+              value.rangeOfCharacter(from: .whitespacesAndNewlines.union(.controlCharacters)) == nil,
+              let components = URLComponents(string: value), components.scheme?.lowercased() == "https",
+              let host = components.host, !host.isEmpty,
+              components.user == nil, components.password == nil, components.fragment == nil,
+              components.port.map({ (1 ... 65535).contains($0) }) ?? true else {
+            return nil
+        }
+        return components.url
+    }
+
+    private static let publicKey = Data(base64Encoded: "GDJWDwzdxjryMJhA2dS+zM2p3AHK8O35B/cc5VjKcEU=")!
+    private static let baseURL = "https://raw.githubusercontent.com/murk-sus/AyuGramm-Plugins/main/registry/"
+    private static let refreshInterval: TimeInterval = 60 * 60
+
+    private let lock = NSLock()
+    private var entries: [Int64: Entry] = [:]
+    private var lastFetch: Date?
+    private var fetching = false
+
+    private var cacheURL: URL? {
+        return FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first?
+            .appendingPathComponent("AyuGram", isDirectory: true)
+            .appendingPathComponent("verified.json")
+    }
+
+    private init() {
+        if let url = self.cacheURL, let data = try? Data(contentsOf: url), let signature = try? Data(contentsOf: url.appendingPathExtension("sig")) {
+            self.accept(data: data, signature: signature, save: false)
+        }
+    }
+
+    /// The team's label for a Telegram user, channel or group id. Labels the repository owner
+    /// gives out (assets/ayugram_ios_badges.json) fill in where the signed list has none.
+    public func entry(peerId: Int64) -> Entry? {
+        self.lock.lock()
+        let signed = self.entries[peerId]
+        self.lock.unlock()
+        if let signed {
+            return signed
+        }
+        if let label = AyuSupportersManager.shared.label(peerId: peerId) {
+            return Entry(id: String(peerId), kind: label.kind, text: label.text, banner: nil)
+        }
+        return nil
+    }
+
+    private static let dismissedPanelsKey = "ayu.teamLabel.dismissedPanels"
+
+    /// Whether the label panel under this chat's title was closed with its cross.
+    public static func isPanelDismissed(peerId: Int64) -> Bool {
+        return (UserDefaults.standard.array(forKey: AyuVerifiedRegistry.dismissedPanelsKey) as? [String])?.contains(String(peerId)) ?? false
+    }
+
+    public static func dismissPanel(peerId: Int64) {
+        var ids = (UserDefaults.standard.array(forKey: AyuVerifiedRegistry.dismissedPanelsKey) as? [String]) ?? []
+        if !ids.contains(String(peerId)) {
+            ids.append(String(peerId))
+            UserDefaults.standard.set(ids, forKey: AyuVerifiedRegistry.dismissedPanelsKey)
+        }
+    }
+
+    public func isVerified(peerId: Int64) -> Bool {
+        return self.entry(peerId: peerId) != nil
+    }
+
+    /// The label for a user, by the plain Telegram user id the bot was given.
+    public func entry(peer: EnginePeer.Id) -> Entry? {
+        guard peer.namespace == Namespaces.Peer.CloudUser else { return nil }
+        return self.entry(peerId: peer.id._internalGetInt64Value())
+    }
+
+    /// Downloads the list when it is older than an hour (or `force`).
+    public func refresh(force: Bool = false) {
+        self.lock.lock()
+        if self.fetching || (!force && self.lastFetch.map { Date().timeIntervalSince($0) < AyuVerifiedRegistry.refreshInterval } == true) {
+            self.lock.unlock()
+            return
+        }
+        self.fetching = true
+        self.lock.unlock()
+        let configuration = URLSessionConfiguration.ephemeral
+        configuration.timeoutIntervalForRequest = 20.0
+        configuration.requestCachePolicy = .reloadIgnoringLocalCacheData
+        let session = URLSession(configuration: configuration)
+        func load(_ name: String, _ completion: @escaping (Data?) -> Void) {
+            guard let url = URL(string: AyuVerifiedRegistry.baseURL + name) else { return completion(nil) }
+            session.dataTask(with: url, completionHandler: { data, response, _ in
+                completion((response as? HTTPURLResponse)?.statusCode == 200 ? data : nil)
+            }).resume()
+        }
+        load("verified.json", { [weak self] data in
+            load("verified.json.sig", { signature in
+                guard let self else { return }
+                if let data, let signature {
+                    self.accept(data: data, signature: signature, save: true)
+                }
+                self.lock.lock()
+                self.fetching = false
+                self.lastFetch = Date()
+                self.lock.unlock()
+                session.finishTasksAndInvalidate()
+            })
+        })
+    }
+
+    private func accept(data: Data, signature: Data, save: Bool) {
+        let text = String(decoding: signature, as: UTF8.self).trimmingCharacters(in: .whitespacesAndNewlines)
+        guard let signatureData = Data(base64Encoded: text),
+              let key = try? Curve25519.Signing.PublicKey(rawRepresentation: AyuVerifiedRegistry.publicKey),
+              key.isValidSignature(signatureData, for: data),
+              let registry = try? JSONDecoder().decode(Registry.self, from: data), registry.format == "ayugram-verified" else {
+            return
+        }
+        var parsed: [Int64: Entry] = [:]
+        for entry in registry.entries {
+            if let id = Int64(entry.id) {
+                parsed[id] = Entry(id: entry.id, kind: entry.kind, text: String(entry.text.prefix(160)), banner: entry.banner.flatMap { Self.bannerURL($0) == nil ? nil : $0 })
+            }
+        }
+        self.lock.lock()
+        let changed = parsed != self.entries
+        self.entries = parsed
+        self.lock.unlock()
+        if save, let url = self.cacheURL {
+            try? FileManager.default.createDirectory(at: url.deletingLastPathComponent(), withIntermediateDirectories: true)
+            try? data.write(to: url, options: .atomic)
+            try? signature.write(to: url.appendingPathExtension("sig"), options: .atomic)
+        }
+        if changed {
+            DispatchQueue.main.async {
+                NotificationCenter.default.post(name: AyuVerifiedRegistry.didChangeNotification, object: nil)
+            }
+        }
+    }
+
+    /// The label line the app shows under the user's name.
+    public static func caption(_ entry: Entry, russian: Bool) -> String {
+        return entry.text + (russian ? " — подтверждено командой AyuGram для iOS." : " — confirmed by the AyuGram for iOS team.")
+    }
+}
