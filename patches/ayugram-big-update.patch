+++ b/submodules/AccountContext/Sources/AyuPluginAppBridge.swift
@@ -0,0 +1,167 @@
+import Foundation
+import CryptoKit
+import TelegramCore
+
+/// What injecting plugins may reach in the app. TelegramUI fills these at launch; a plugin
+/// only gets them when `AyuPluginTrust` says it may inject.
+public enum AyuPluginAppBridge {
+    /// `play`, `pause`, `toggle`, `next`, `previous`; true when the player took the command.
+    public static var playerControl: ((String) -> Bool)?
+    /// Title, artist, duration, position and playing state of the music player.
+    public static var playerState: (() -> [String: Any])?
+}
+
+/// The safe zone. Ordinary plugins (outgoing text, switching features off, storage, toasts) can
+/// come from anywhere. Plugins that inject into the app — player control, lyrics — run only
+/// when signed by AyuGram, or when the user enabled unofficial injecting plugins in the
+/// developer settings and accepted that the responsibility is entirely theirs.
+public enum AyuPluginTrust {
+    /// Ed25519 key of the official plugin catalog (github.com/murk-sus/AyuGramm-Plugins).
+    static let officialPublicKey = Data(base64Encoded: "tpUMidC/xYWQEv9HFXHpSs9/ZskYM+I+IZWLR0ujpX8=")!
+
+    /// True when `signature` (base64 Ed25519 over the plugin file) is from AyuGram.
+    public static func isOfficial(data: Data, signature: String?) -> Bool {
+        guard let signature, let signatureData = Data(base64Encoded: signature), let key = try? Curve25519.Signing.PublicKey(rawRepresentation: AyuPluginTrust.officialPublicKey) else {
+            return false
+        }
+        return key.isValidSignature(signatureData, for: data)
+    }
+
+    public enum InjectDecision {
+        /// Not an injecting plugin, or signed by AyuGram.
+        case allowed
+        /// Unofficial injecting plugin, developer option on: show the disclaimer first.
+        case needsDisclaimer
+        /// Unofficial injecting plugin, developer option off.
+        case refused
+    }
+
+    public static func decision(injects: Bool, official: Bool) -> InjectDecision {
+        if !injects || official {
+            return .allowed
+        }
+        return AyuDeveloperSettings.shared.current.allowUnofficialInjectPlugins ? .needsDisclaimer : .refused
+    }
+
+    public static func refusalText(_ russian: Bool) -> String {
+        return russian
+            ? "Этот плагин внедряется в работу приложения (плеер, тексты песен и т.п.). Такие плагины можно ставить только из официального каталога AyuGram.\n\nЧтобы всё равно поставить его, включите «Инжект-плагины не из официального источника» в настройках разработчика."
+            : "This plugin injects into the app (player, lyrics and so on). Such plugins can only be installed from the official AyuGram catalog.\n\nTo install it anyway, turn on \"Injecting plugins from unofficial sources\" in the developer settings."
+    }
+
+    public static func disclaimerText(_ russian: Bool) -> String {
+        return russian
+            ? "⚠️ Плагин НЕ из официального источника и внедряется в работу приложения.\n\nAyuGram не проверял этот код. Он может сломать плеер, тексты песен или другие функции и вести себя не так, как обещает описание.\n\nВся ответственность за установку и любые последствия лежит полностью на вас. Разработчики AyuGram за это не отвечают."
+            : "⚠️ This plugin is NOT from the official source and injects into the app.\n\nAyuGram has not reviewed this code. It may break the player, lyrics or other features and may not behave as described.\n\nYou take full responsibility for installing it and for any consequences. The AyuGram developers are not responsible."
+    }
+}
+
+/// Settings a plugin declares (`ayu.settings.declare`); the app draws them, the plugin reads them.
+public enum AyuPluginSettings {
+    public struct Item: Equatable {
+        public enum Kind: String {
+            case toggle
+            case text
+            /// A number between `min` and `max` (in steps of `step`).
+            case slider
+            /// A `#RRGGBB` colour.
+            case color
+            /// One of `options`.
+            case select
+            /// Text the plugin shows; nothing to change.
+            case preview
+        }
+
+        public let key: String
+        public let kind: Kind
+        public let title: String
+        public let subtitle: String?
+        public let defaultValue: String
+        public var minimum: Double = 0.0
+        public var maximum: Double = 100.0
+        public var step: Double = 1.0
+        /// (value, title) pairs of a `select`.
+        public var options: [Option] = []
+
+        public struct Option: Equatable {
+            public let value: String
+            public let title: String
+        }
+    }
+
+    public static let didChangeNotification = Notification.Name("AyuGram.PluginSettingsChanged")
+
+    private static let lock = NSLock()
+    private static var schemas: [String: [Item]] = [:]
+
+    static func declare(pluginId: String, items: [[String: Any]]) {
+        let parsed = items.prefix(24).compactMap { item -> Item? in
+            guard let key = item["key"] as? String, !key.isEmpty, key.count <= 64, let title = item["title"] as? String else { return nil }
+            let kind = Item.Kind(rawValue: item["type"] as? String ?? "toggle") ?? .toggle
+            let defaultValue: String
+            switch item["default"] {
+            case let value as Bool: defaultValue = value ? "1" : "0"
+            case let value as String: defaultValue = value
+            case let value as NSNumber: defaultValue = value.boolValue ? "1" : "0"
+            default: defaultValue = kind == .toggle ? "0" : ""
+            }
+            var parsed = Item(key: key, kind: kind, title: String(title.prefix(80)), subtitle: (item["subtitle"] as? String).map { String($0.prefix(200)) }, defaultValue: defaultValue)
+            if let value = item["min"] as? NSNumber { parsed.minimum = value.doubleValue }
+            if let value = item["max"] as? NSNumber { parsed.maximum = value.doubleValue }
+            if let value = item["step"] as? NSNumber, value.doubleValue > 0 { parsed.step = value.doubleValue }
+            if parsed.maximum <= parsed.minimum { parsed.maximum = parsed.minimum + 1.0 }
+            if let options = item["options"] as? [Any] {
+                parsed.options = options.prefix(20).compactMap { option in
+                    if let text = option as? String { return Item.Option(value: text, title: text) }
+                    if let object = option as? [String: Any], let value = object["value"].map({ "\($0)" }) {
+                        return Item.Option(value: value, title: (object["title"] as? String) ?? value)
+                    }
+                    return nil
+                }
+            }
+            if kind == .slider, let number = item["default"] as? NSNumber {
+                parsed = Item(key: parsed.key, kind: .slider, title: parsed.title, subtitle: parsed.subtitle, defaultValue: String(number.doubleValue), minimum: parsed.minimum, maximum: parsed.maximum, step: parsed.step, options: [])
+            }
+            return parsed
+        }
+        AyuPluginSettings.lock.lock()
+        AyuPluginSettings.schemas[pluginId] = parsed
+        AyuPluginSettings.lock.unlock()
+        DispatchQueue.main.async {
+            NotificationCenter.default.post(name: AyuPluginSettings.didChangeNotification, object: nil)
+        }
+    }
+
+    static func clear(pluginId: String) {
+        AyuPluginSettings.lock.lock()
+        AyuPluginSettings.schemas[pluginId] = nil
+        AyuPluginSettings.lock.unlock()
+    }
+
+    public static func items(pluginId: String) -> [Item] {
+        AyuPluginSettings.lock.lock()
+        defer { AyuPluginSettings.lock.unlock() }
+        return AyuPluginSettings.schemas[pluginId] ?? []
+    }
+
+    private static func storageKey(_ pluginId: String) -> String {
+        return "ayu.script.settings." + pluginId
+    }
+
+    public static func value(pluginId: String, key: String) -> String? {
+        let stored = (UserDefaults.standard.dictionary(forKey: AyuPluginSettings.storageKey(pluginId)) as? [String: String])?[key]
+        return stored ?? AyuPluginSettings.items(pluginId: pluginId).first(where: { $0.key == key })?.defaultValue
+    }
+
+    public static func setValue(pluginId: String, key: String, value: String) {
+        var stored = (UserDefaults.standard.dictionary(forKey: AyuPluginSettings.storageKey(pluginId)) as? [String: String]) ?? [:]
+        stored[key] = String(value.prefix(1024))
+        UserDefaults.standard.set(stored, forKey: AyuPluginSettings.storageKey(pluginId))
+        NotificationCenter.default.post(name: AyuPluginSettings.didChangeNotification, object: nil)
+        AyuScriptRuntime.shared.emit("settingsChange", ["pluginId": pluginId, "key": key, "value": value])
+    }
+
+    static func removeValues(pluginId: String) {
+        UserDefaults.standard.removeObject(forKey: AyuPluginSettings.storageKey(pluginId))
+    }
+}
diff --git a/submodules/AccountContext/Sources/AyuPluginBundle.swift b/submodules/AccountContext/Sources/AyuPluginBundle.swift
new file mode 100644
index 00000000..eb246a58
--- /dev/null
+++ b/submodules/AccountContext/Sources/AyuPluginBundle.swift
@@ -0,0 +1,130 @@
+import Foundation
+import Compression
+
+/// `.plugin` bundles: a zip with `plugin.json` ({"main": "main.lua"}) and any number of source
+/// files in the main file's language. The files are joined into one plugin source with a small
+/// `require`, so a bundle installs and runs like a single-file plugin; plugins in different
+/// languages talk through `ayu.bus`.
+public enum AyuPluginBundle {
+    public static func isBundle(_ data: Data) -> Bool {
+        return data.count > 4 && data.starts(with: [0x50, 0x4b, 0x03, 0x04])
+    }
+
+    /// The joined source and a filename whose extension selects the engine.
+    public static func unpack(_ data: Data) -> (data: Data, filename: String)? {
+        guard isBundle(data), data.count <= 4 * 1024 * 1024, let files = readZip(data),
+              let manifestData = files["plugin.json"], let manifest = (try? JSONSerialization.jsonObject(with: manifestData)) as? [String: Any],
+              let main = manifest["main"] as? String, let mainData = files[main], let mainSource = String(data: mainData, encoding: .utf8) else { return nil }
+        let ext = (main as NSString).pathExtension.lowercased()
+        let modules = files.filter { $0.key != main && $0.key != "plugin.json" && ($0.key as NSString).pathExtension.lowercased() == ext }
+            .sorted(by: { $0.key < $1.key })
+            .compactMap { name, data -> (String, String)? in String(data: data, encoding: .utf8).map { (name, $0) } }
+        // The main file's header comments stay on top so the plugin is recognised.
+        let lines = mainSource.components(separatedBy: "\n")
+        let commentPrefix = ext == "py" ? "#" : (ext == "lua" ? "--" : "//")
+        let headerCount = lines.prefix(while: { $0.trimmingCharacters(in: .whitespaces).hasPrefix(commentPrefix) || $0.trimmingCharacters(in: .whitespaces).isEmpty }).count
+        let header = lines.prefix(headerCount).joined(separator: "\n")
+        let body = lines.dropFirst(headerCount).joined(separator: "\n")
+        var joined = header + "\n"
+        switch ext {
+        case "js":
+            joined += "const __ayuModules = {}; const __ayuCache = {};\n"
+            joined += "function require(name) { const key = name.replace(/^\\.\\//, '').replace(/\\.js$/, ''); if (__ayuCache[key]) return __ayuCache[key].exports; const fn = __ayuModules[key]; if (!fn) throw new Error('No module ' + name); const module = { exports: {} }; __ayuCache[key] = module; fn(module, module.exports, require); return module.exports; }\n"
+            for (name, source) in modules {
+                let key = (name as NSString).deletingPathExtension
+                joined += "__ayuModules[\(jsonString(key))] = function (module, exports, require) {\n\(source)\n};\n"
+            }
+        case "lua":
+            joined += "local __ayu_modules, __ayu_cache = {}, {}\n"
+            joined += "function require(name) local key = name:gsub('%.lua$', ''):gsub('%.', '/'); if __ayu_cache[key] == nil then local fn = __ayu_modules[key]; if not fn then error('no module ' .. name) end; __ayu_cache[key] = fn() or true end; return __ayu_cache[key] end\n"
+            for (name, source) in modules {
+                let key = (name as NSString).deletingPathExtension
+                joined += "__ayu_modules[\(jsonString(key))] = function()\n\(source)\nend\n"
+            }
+        case "py":
+            // PocketPy runs one source: helper files come first, in name order.
+            for (name, source) in modules {
+                joined += "# --- \(name)\n\(source)\n"
+            }
+        default:
+            return nil
+        }
+        joined += body
+        let filename = (manifest["id"] as? String).map { $0 + "." + ext } ?? ("bundle." + ext)
+        return (Data(joined.utf8), filename)
+    }
+
+    private static func jsonString(_ value: String) -> String {
+        guard let data = try? JSONSerialization.data(withJSONObject: [value]), let text = String(data: data, encoding: .utf8) else { return "\"\"" }
+        return String(text.dropFirst().dropLast())
+    }
+
+    // MARK: A minimal zip reader (stored and deflated entries, central directory)
+
+    private static func readUInt16(_ data: Data, _ offset: Int) -> Int {
+        guard offset + 2 <= data.count else { return 0 }
+        return Int(data[data.startIndex + offset]) | Int(data[data.startIndex + offset + 1]) << 8
+    }
+
+    private static func readUInt32(_ data: Data, _ offset: Int) -> Int {
+        return readUInt16(data, offset) | readUInt16(data, offset + 2) << 16
+    }
+
+    private static func readZip(_ data: Data) -> [String: Data]? {
+        // End of central directory: signature 0x06054b50 within the last 64 KiB.
+        var end = -1
+        var position = data.count - 22
+        while position >= max(0, data.count - 65_557) {
+            if readUInt32(data, position) == 0x06054b50 {
+                end = position
+                break
+            }
+            position -= 1
+        }
+        guard end >= 0 else { return nil }
+        let count = readUInt16(data, end + 10)
+        var offset = readUInt32(data, end + 16)
+        var files: [String: Data] = [:]
+        var total = 0
+        for _ in 0 ..< min(count, 200) {
+            guard readUInt32(data, offset) == 0x02014b50 else { return nil }
+            let method = readUInt16(data, offset + 10)
+            let compressedSize = readUInt32(data, offset + 20)
+            let size = readUInt32(data, offset + 24)
+            let nameLength = readUInt16(data, offset + 28)
+            let extraLength = readUInt16(data, offset + 30)
+            let commentLength = readUInt16(data, offset + 32)
+            let localOffset = readUInt32(data, offset + 42)
+            guard offset + 46 + nameLength <= data.count, let name = String(data: data.subdata(in: (offset + 46) ..< (offset + 46 + nameLength)), encoding: .utf8) else { return nil }
+            offset += 46 + nameLength + extraLength + commentLength
+            guard !name.hasSuffix("/"), !name.contains(".."), size <= 1024 * 1024 else { continue }
+            total += size
+            guard total <= 4 * 1024 * 1024, readUInt32(data, localOffset) == 0x04034b50 else { return nil }
+            let start = localOffset + 30 + readUInt16(data, localOffset + 26) + readUInt16(data, localOffset + 28)
+            guard start + compressedSize <= data.count else { return nil }
+            let compressed = data.subdata(in: start ..< (start + compressedSize))
+            switch method {
+            case 0:
+                files[name] = compressed
+            case 8:
+                guard let inflated = inflate(compressed, size: size) else { return nil }
+                files[name] = inflated
+            default:
+                continue
+            }
+        }
+        return files
+    }
+
+    private static func inflate(_ data: Data, size: Int) -> Data? {
+        guard size > 0 else { return Data() }
+        var output = Data(count: size)
+        let written = output.withUnsafeMutableBytes { target -> Int in
+            data.withUnsafeBytes { source -> Int in
+                guard let targetBase = target.bindMemory(to: UInt8.self).baseAddress, let sourceBase = source.bindMemory(to: UInt8.self).baseAddress else { return 0 }
+                return compression_decode_buffer(targetBase, size, sourceBase, data.count, nil, COMPRESSION_ZLIB)
+            }
+        }
+        return written == size ? output : nil
+    }
+}
diff --git a/submodules/AccountContext/Sources/AyuPluginEngineInstance.swift b/submodules/AccountContext/Sources/AyuPluginEngineInstance.swift
new file mode 100644
index 00000000..a9c651fd
--- /dev/null
+++ b/submodules/AccountContext/Sources/AyuPluginEngineInstance.swift
@@ -0,0 +1,334 @@
+import Foundation
+import TelegramCore
+import AyuPluginEngines
+
+/// A Python (PocketPy) or Rust/WebAssembly (WAMR) plugin. Both engines talk JSON: the plugin's
+/// requests arrive in `handle(_:)`, and hooks and events go to it through `dispatch`.
+final class AyuPluginEngineInstance: AyuPluginInstance {
+    enum Engine {
+        case python
+        case wasm
+        case lua
+    }
+
+    /// PocketPy keeps its current VM in a global, so every Python plugin shares one thread.
+    private static let pythonQueue = DispatchQueue(label: "AyuGram.Plugins.Python", qos: .userInitiated)
+    private static let pythonQueueKey = DispatchSpecificKey<Bool>()
+    private static let pythonQueueSetup: Void = {
+        AyuPluginEngineInstance.pythonQueue.setSpecific(key: AyuPluginEngineInstance.pythonQueueKey, value: true)
+    }()
+
+    let id: String
+    private let engine: Engine
+    private let data: Data
+    private let canInject: Bool
+    private let permissions: Set<String>
+    private weak var runtime: AyuScriptRuntime?
+    private let queue: DispatchQueue
+    private let ownQueueKey = DispatchSpecificKey<Bool>()
+    private var pythonHandle: Int32 = -1
+    private var wasmPlugin: OpaquePointer?
+    private var luaPlugin: OpaquePointer?
+    private var events = Set<String>()
+    private var stopped = false
+    private let summaryLock = NSLock()
+    private var summaryItems: [String] = []
+
+    init(id: String, engine: Engine, data: Data, canInject: Bool, permissions: Set<String>, runtime: AyuScriptRuntime) {
+        self.id = id
+        self.engine = engine
+        self.data = data
+        self.canInject = canInject
+        self.permissions = permissions
+        self.runtime = runtime
+        switch engine {
+        case .python:
+            _ = AyuPluginEngineInstance.pythonQueueSetup
+            self.queue = AyuPluginEngineInstance.pythonQueue
+        case .wasm, .lua:
+            self.queue = DispatchQueue(label: "AyuGram.Plugins." + (engine == .lua ? "Lua." : "Wasm.") + id, qos: .userInitiated)
+            self.queue.setSpecific(key: self.ownQueueKey, value: true)
+        }
+    }
+
+    var summary: [String] {
+        self.summaryLock.lock()
+        defer { self.summaryLock.unlock() }
+        return self.summaryItems
+    }
+
+    private func addSummary(_ item: String) {
+        self.summaryLock.lock()
+        if !self.summaryItems.contains(item) { self.summaryItems.append(item) }
+        self.summaryLock.unlock()
+    }
+
+    private var timeoutMilliseconds: Int32 {
+        return AyuDeveloperSettings.shared.current.experimentalPluginHooks ? 2000 : 250
+    }
+
+    private var isOnQueue: Bool {
+        switch self.engine {
+        case .python: return DispatchQueue.getSpecific(key: AyuPluginEngineInstance.pythonQueueKey) == true
+        case .wasm, .lua: return DispatchQueue.getSpecific(key: self.ownQueueKey) == true
+        }
+    }
+
+    private func log(_ level: AyuPluginConsole.Line.Level, _ text: String) {
+        AyuPluginConsole.shared.append(pluginId: self.id, level: level, text)
+        if level == .error, AyuDeveloperSettings.shared.current.experimentalPluginHooks {
+            self.runtime?.toast("\(self.id): \(text)")
+        }
+    }
+
+    // MARK: Lifecycle
+
+    /// exteraGram-style Python plugins: their SDK modules are provided by the prelude, so the
+    /// imports are commented out, and the BasePlugin subclass is started after the module runs.
+    /// Java/Android imports are commented out too; plugins that need them still fail when used.
+    static func exteraCompatible(_ source: String) -> String {
+        let prefixes = ["from base_plugin", "import base_plugin", "from ui.", "import ui.", "from android_utils", "import android_utils", "from client_utils", "import client_utils", "from markdown_utils", "import markdown_utils", "from hook_utils", "import hook_utils", "from java", "import java", "from android", "from org.telegram", "from com.exteragram", "from de.robv"]
+        var lines: [String] = []
+        for line in source.components(separatedBy: "\n") {
+            let trimmed = line.trimmingCharacters(in: .whitespaces)
+            if prefixes.contains(where: { trimmed.hasPrefix($0) }) {
+                let indent = String(line.prefix(while: { $0 == " " || $0 == "\t" }))
+                lines.append(indent + "pass  # AyuGram: " + trimmed)
+            } else {
+                lines.append(line)
+            }
+        }
+        return lines.joined(separator: "\n") + "\n_ayu_extera_boot(globals())\n"
+    }
+
+    func load() {
+        self.queue.async { [weak self] in
+            guard let self, !self.stopped else { return }
+            let context = Unmanaged.passUnretained(self).toOpaque()
+            var error: UnsafeMutablePointer<CChar>?
+            switch self.engine {
+            case .python:
+                var source = String(decoding: self.data, as: UTF8.self)
+                if source.contains("BasePlugin") {
+                    source = AyuPluginEngineInstance.exteraCompatible(source)
+                }
+                self.pythonHandle = ayu_python_create(source, self.id + ".py", self.timeoutMilliseconds * 4, ayuPluginEngineHost, context, &error)
+                if self.pythonHandle < 0 {
+                    self.log(.error, error.map { String(cString: $0) } ?? "Could not start the Python plugin.")
+                }
+            case .wasm:
+                self.wasmPlugin = self.data.withUnsafeBytes { buffer -> OpaquePointer? in
+                    guard let base = buffer.bindMemory(to: UInt8.self).baseAddress else { return nil }
+                    return ayu_wasm_create(base, UInt32(buffer.count), ayuPluginEngineHost, context, &error)
+                }
+                if self.wasmPlugin == nil {
+                    self.log(.error, error.map { String(cString: $0) } ?? "Could not start the WebAssembly plugin.")
+                }
+            case .lua:
+                let source = String(decoding: self.data, as: UTF8.self)
+                self.luaPlugin = ayu_lua_create(source, self.id + ".lua", self.timeoutMilliseconds * 4, ayuPluginEngineHost, context, &error)
+                if self.luaPlugin == nil {
+                    self.log(.error, error.map { String(cString: $0) } ?? "Could not start the Lua plugin.")
+                }
+            }
+            ayu_engine_free(error)
+            if self.pythonHandle >= 0 || self.wasmPlugin != nil || self.luaPlugin != nil {
+                self.dispatchOnQueue(["op": "event", "event": "load", "payload": [String: Any]()])
+                self.log(.info, "Loaded.")
+            }
+        }
+    }
+
+    func unload() {
+        self.queue.async {
+            guard !self.stopped else { return }
+            self.dispatchOnQueue(["op": "event", "event": "unload", "payload": [String: Any]()])
+            self.teardown()
+        }
+    }
+
+    func abandon() {
+        self.stopped = true
+    }
+
+    private func teardown() {
+        self.stopped = true
+        if self.pythonHandle >= 0 {
+            ayu_python_destroy(self.pythonHandle)
+            self.pythonHandle = -1
+        }
+        if let wasmPlugin = self.wasmPlugin {
+            ayu_wasm_destroy(wasmPlugin)
+            self.wasmPlugin = nil
+        }
+        if let luaPlugin = self.luaPlugin {
+            ayu_lua_destroy(luaPlugin)
+            self.luaPlugin = nil
+        }
+        AyuPluginSettings.clear(pluginId: self.id)
+    }
+
+    // MARK: Calls into the plugin
+
+    @discardableResult
+    private func dispatchOnQueue(_ message: [String: Any]) -> [String: Any]? {
+        guard !self.stopped, let data = try? JSONSerialization.data(withJSONObject: message, options: [.withoutEscapingSlashes]), let request = String(data: data, encoding: .utf8) else { return nil }
+        var error: UnsafeMutablePointer<CChar>?
+        let answer: UnsafeMutablePointer<CChar>?
+        switch self.engine {
+        case .python:
+            guard self.pythonHandle >= 0 else { return nil }
+            answer = ayu_python_dispatch(self.pythonHandle, request, self.timeoutMilliseconds, &error)
+        case .wasm:
+            guard let wasmPlugin = self.wasmPlugin else { return nil }
+            answer = ayu_wasm_dispatch(wasmPlugin, request, &error)
+        case .lua:
+            guard let luaPlugin = self.luaPlugin else { return nil }
+            answer = ayu_lua_dispatch(luaPlugin, request, self.timeoutMilliseconds, &error)
+        }
+        if let error {
+            self.log(.error, String(cString: error))
+            ayu_engine_free(error)
+        }
+        guard let answer else { return nil }
+        let text = String(cString: answer)
+        ayu_engine_free(answer)
+        return (try? JSONSerialization.jsonObject(with: Data(text.utf8))) as? [String: Any]
+    }
+
+    func emit(_ event: String, _ payload: [String: Any]) {
+        if event == "trackChange" && !self.canInject { return }
+        self.queue.async {
+            // `events` is only touched on the plugin queue.
+            guard self.events.contains(event) else { return }
+            self.dispatchOnQueue(["op": "event", "event": event, "payload": payload])
+        }
+    }
+
+    /// Runs a text hook on the plugin's queue and waits for it within the time limit.
+    private func callTextHandler(_ handler: Int, text: String, context: AyuHooks.TextContext) -> String? {
+        let message: [String: Any] = ["op": "hook", "handler": handler, "text": text, "ctx": ["peerId": String(context.peerId), "isSecret": context.isSecret]]
+        let run: () -> String? = {
+            guard let answer = self.dispatchOnQueue(message), let result = answer["text"] as? String else { return nil }
+            return result.utf16.count <= 65536 ? result : nil
+        }
+        if self.isOnQueue {
+            return run()
+        }
+        var result: String?
+        let semaphore = DispatchSemaphore(value: 0)
+        self.queue.async {
+            result = run()
+            semaphore.signal()
+        }
+        // Python stops itself at the limit; allow it time to report before calling it hung.
+        let limit = Int(self.timeoutMilliseconds) * (self.engine == .wasm ? 1 : 2)
+        if semaphore.wait(timeout: .now() + .milliseconds(limit)) == .timedOut {
+            self.runtime?.pluginHung(self.id)
+            return nil
+        }
+        return result
+    }
+
+    // MARK: Requests from the plugin
+
+    fileprivate func handle(_ request: String) -> String? {
+        guard let object = (try? JSONSerialization.jsonObject(with: Data(request.utf8))) as? [String: Any], let op = object["op"] as? String else {
+            return nil
+        }
+        let answer: Any?
+        switch op {
+        case "log":
+            let level = AyuPluginConsole.Line.Level(rawValue: object["level"] as? String ?? "info") ?? .info
+            self.log(level, String((object["text"] as? String ?? "").prefix(4000)))
+            answer = nil
+        case "toast":
+            self.runtime?.toast(String((object["text"] as? String ?? "").prefix(200)))
+            answer = nil
+        case "hook":
+            answer = ["ok": self.registerHook(object)]
+        case "feature":
+            guard let name = object["name"] as? String, let feature = AyuHooks.Feature(rawValue: name) else {
+                self.log(.warning, "Unknown feature \(object["name"] ?? "").")
+                return nil
+            }
+            let disabled = object["disabled"] as? Bool ?? true
+            AyuHooks.shared.setFeature(feature, disabled: disabled, owner: self.id)
+            if disabled { self.addSummary("feature off: \(name)") }
+            answer = nil
+        case "on":
+            if let event = object["event"] as? String { self.events.insert(event) }
+            answer = nil
+        case "storage.get":
+            let key = object["key"] as? String ?? ""
+            let value: Any = AyuScriptRuntime.storageValue(pluginId: self.id, key: key).map { $0 as Any } ?? NSNull()
+            answer = ["value": value]
+        case "storage.set":
+            let key = object["key"] as? String ?? ""
+            if !AyuScriptRuntime.setStorageValue(pluginId: self.id, key: key, value: object["value"] as? String) {
+                self.log(.warning, "Storage limit (64 KB) reached; \(key) was not saved.")
+            }
+            answer = nil
+        case "settings":
+            AyuPluginSettings.declare(pluginId: self.id, items: object["items"] as? [[String: Any]] ?? [])
+            self.addSummary("settings")
+            answer = nil
+        case "setting.get":
+            let value: Any = AyuPluginSettings.value(pluginId: self.id, key: object["key"] as? String ?? "").map { $0 as Any } ?? NSNull()
+            answer = ["value": value]
+        case "player.state":
+            guard self.requireInject("ayu.player") else { return nil }
+            answer = AyuPluginAppBridge.playerState?() ?? [:]
+        case "player.control":
+            guard self.requireInject("ayu.player"), let action = object["action"] as? String else { return nil }
+            answer = ["ok": AyuPluginAppBridge.playerControl?(action) ?? false]
+        default:
+            // The extended API shared with JavaScript (ui, menu, profile, overlay, fonts, …).
+            answer = AyuPluginHostAPI.handle(pluginId: self.id, permissions: self.permissions, op: op, args: object, log: { level, text in self.log(level, text) })
+            if answer == nil && !op.contains(".") {
+                self.log(.warning, "Unknown request \(op).")
+            }
+        }
+        guard let answer, let data = try? JSONSerialization.data(withJSONObject: answer, options: [.withoutEscapingSlashes]) else { return nil }
+        return String(data: data, encoding: .utf8)
+    }
+
+    private func requireInject(_ what: String) -> Bool {
+        if self.canInject { return true }
+        self.log(.error, "\(what) is an injection API: only official plugins (or ones allowed in the developer settings) may use it.")
+        return false
+    }
+
+    private func registerHook(_ object: [String: Any]) -> Bool {
+        guard let pointName = object["point"] as? String, let modeName = object["mode"] as? String, let handler = (object["handler"] as? NSNumber)?.intValue else { return false }
+        let aliases: [String: AyuHooks.TextPoint] = ["outgoingText": .outgoingText, "outgoing": .outgoingText, "lyrics": .lyricsText, "lyricsText": .lyricsText, "linkOpen": .linkOpen, "messageRender": .messageRender, "notificationBeforeShow": .notificationBeforeShow]
+        guard let point = AyuHooks.TextPoint(rawValue: pointName) ?? aliases[pointName], var mode = AyuHooks.Mode(rawValue: modeName) else {
+            self.log(.warning, "Unknown hook \(pointName) (\(modeName)).")
+            return false
+        }
+        if point.isInject && !self.requireInject(point.rawValue) {
+            return false
+        }
+        if let permission = point.permission, !self.permissions.contains(permission) {
+            self.log(.error, "\(point.rawValue) needs the '\(permission)' permission: add it to the manifest's permissions.")
+            return false
+        }
+        if mode == .replace, let owner = AyuHooks.shared.replacingOwner(point), owner != self.id {
+            self.log(.warning, "\(point.rawValue) is already replaced by \(owner); registering as 'after'.")
+            mode = .after
+        }
+        AyuHooks.shared.register(point: point, mode: mode, owner: self.id, handler: { [weak self] text, context in
+            return self?.callTextHandler(handler, text: text, context: context)
+        })
+        self.addSummary("\(point.rawValue): \(mode.rawValue)")
+        return true
+    }
+}
+
+/// The C engines' host callback: `context` is the instance, the answer is malloc'ed.
+private func ayuPluginEngineHost(_ context: UnsafeMutableRawPointer?, _ request: UnsafePointer<CChar>) -> UnsafeMutablePointer<CChar>? {
+    guard let context else { return nil }
+    let instance = Unmanaged<AyuPluginEngineInstance>.fromOpaque(context).takeUnretainedValue()
+    guard let answer = instance.handle(String(cString: request)) else { return nil }
+    return strdup(answer)
+}
