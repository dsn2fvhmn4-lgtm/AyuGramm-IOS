+static int c11__wcwidth(int c) {
+    if(c >= 32 && c < 0x7f) return 1;
+    if(c < 32) return 0;
+    const char* w = c11__u32_east_asian_width(c);
+    bool fullwidth = (w[0] == 'F' && w[1] == '\0') || (w[0] == 'W' && w[1] == '\0');
+    return fullwidth ? 2 : 1;
+}
