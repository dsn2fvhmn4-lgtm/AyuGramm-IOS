@@ -0,0 +1,53 @@
+import Foundation
+
+public struct AyuLocalNotificationSettings {
+    public static let prefix = "ayu.notifications."
+    public var groupByChat: Bool
+    public var avatars: Bool
+    public var actions: Bool
+    public var quietHours: Bool
+    public var quietStart: Int
+    public var quietEnd: Int
+    public var filterEnabled: Bool
+    public var keywords: [String]
+
+    public init(defaults: UserDefaults = .standard) {
+        func flag(_ name: String, fallback: Bool = false) -> Bool {
+            return defaults.object(forKey: Self.prefix + name) as? Bool ?? fallback
+        }
+        self.groupByChat = flag("groupByChat", fallback: true)
+        self.avatars = flag("avatars")
+        self.actions = flag("actions")
+        self.quietHours = flag("quietHours")
+        self.quietStart = min(1439, max(0, defaults.object(forKey: Self.prefix + "quietStart") as? Int ?? 23 * 60))
+        self.quietEnd = min(1439, max(0, defaults.object(forKey: Self.prefix + "quietEnd") as? Int ?? 8 * 60))
+        self.filterEnabled = flag("filterEnabled")
+        self.keywords = String((defaults.string(forKey: Self.prefix + "keywords") ?? "").prefix(4096)).components(separatedBy: CharacterSet(charactersIn: ",\n")).map { $0.trimmingCharacters(in: .whitespacesAndNewlines) }.filter { !$0.isEmpty }
+    }
+
+    public func isQuiet(at date: Date = Date(), calendar: Calendar = .current) -> Bool {
+        guard self.quietHours else { return false }
+        let minute = calendar.component(.hour, from: date) * 60 + calendar.component(.minute, from: date)
+        // Equal endpoints mean a full day; the UI explains this choice.
+        if self.quietStart == self.quietEnd { return true }
+        if self.quietStart < self.quietEnd { return minute >= self.quietStart && minute < self.quietEnd }
+        return minute >= self.quietStart || minute < self.quietEnd
+    }
+
+    public func matches(_ text: String) -> Bool {
+        guard self.filterEnabled else { return true }
+        return self.keywords.contains { text.range(of: $0, options: [.caseInsensitive, .diacriticInsensitive]) != nil }
+    }
+
+    public static func clock(_ minute: Int) -> String {
+        return String(format: "%02d:%02d", minute / 60, minute % 60)
+    }
+
+    public static func minute(_ value: String) -> Int? {
+        let parts = value.split(separator: ":", omittingEmptySubsequences: false)
+        guard parts.count == 2, parts[0].count == 2, parts[1].count == 2,
+              value.utf8.allSatisfy({ $0 == 58 || (48...57).contains($0) }),
+              let hour = Int(parts[0]), let minute = Int(parts[1]), (0...23).contains(hour), (0...59).contains(minute) else { return nil }
+        return hour * 60 + minute
+    }
+}
