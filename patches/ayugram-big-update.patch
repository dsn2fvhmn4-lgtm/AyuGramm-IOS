+++ b/submodules/TelegramUI/Sources/AyuLyricsProviders.swift
@@ -0,0 +1,138 @@
+import Foundation
+
+/// A lyrics result from one source, with how sure we are it belongs to the playing track.
+struct AyuLyricsCandidate {
+    let lyrics: AyuLyrics
+    let source: String
+    /// 0…1 match confidence (title/artist/duration).
+    let score: Double
+
+    /// Word timing beats line timing beats plain text; instrumental is a definite answer.
+    var quality: Int {
+        switch self.lyrics {
+        case let .synced(lines):
+            return lines.contains(where: { $0.exactWordTiming }) ? 3 : 2
+        case .plain:
+            return 1
+        case .instrumental:
+            return 1
+        case .notFound:
+            return 0
+        }
+    }
+
+    /// Best candidate: higher quality first; among equals the better match. A much better
+    /// match (≥ 0.25) wins over one quality level, so a word-synced wrong song never beats
+    /// the right song with line sync.
+    static func best(_ candidates: [AyuLyricsCandidate]) -> AyuLyricsCandidate? {
+        return candidates.filter { $0.quality > 0 }.max(by: { lhs, rhs in
+            let lhsValue = Double(lhs.quality) + lhs.score * 4.0
+            let rhsValue = Double(rhs.quality) + rhs.score * 4.0
+            return lhsValue < rhsValue
+        })
+    }
+}
+
+/// Credit lines lyrics services put first ("作词 : …", "Composed by : …").
+func ayuIsLyricsCredit(_ text: String) -> Bool {
+    let trimmed = text.trimmingCharacters(in: .whitespaces)
+    return trimmed.range(of: #"^(作词|作曲|编曲|制作人|监制|混音|母带|和声|吉他|贝斯|鼓|录音|出品|演唱|原唱|翻唱|词|曲|Lyrics by|Composed by|Arranged by|Produced by|Written by|Composer|Lyricist)\s*[:：]"#, options: [.regularExpression, .caseInsensitive]) != nil
+}
+
+/// NetEase YRC: `[lineStartMs,lineDurMs](wordStartMs,wordDurMs,0)word(…)word…` per line,
+/// absolute milliseconds. JSON metadata lines (`{"t":…}`) and credits are skipped.
+func ayuParseYrc(_ text: String) -> [AyuLyricsLine] {
+    var lines: [AyuLyricsLine] = []
+    for raw in text.components(separatedBy: .newlines) {
+        let line = raw.trimmingCharacters(in: .whitespaces)
+        guard line.hasPrefix("["), let close = line.firstIndex(of: "]") else { continue }
+        let header = line[line.index(after: line.startIndex) ..< close].split(separator: ",")
+        guard header.count == 2, let start = Double(header[0]), let length = Double(header[1]), start >= 0, length >= 0 else { continue }
+        var words: [AyuLyricsWord] = []
+        var rest = line[line.index(after: close)...]
+        while let open = rest.firstIndex(of: "("), let shut = rest[open...].firstIndex(of: ")") {
+            let fields = rest[rest.index(after: open) ..< shut].split(separator: ",")
+            let afterParen = rest.index(after: shut)
+            let next = rest[afterParen...].firstIndex(of: "(") ?? rest.endIndex
+            let word = String(rest[afterParen ..< next])
+            rest = rest[next...]
+            guard fields.count >= 2, let wordStart = Double(fields[0]), let wordLength = Double(fields[1]) else { continue }
+            let clean = word.trimmingCharacters(in: .whitespaces)
+            guard !clean.isEmpty else { continue }
+            words.append(AyuLyricsWord(time: wordStart / 1000.0, endTime: (wordStart + wordLength) / 1000.0, text: clean))
+        }
+        let text = words.map { $0.text }.joined(separator: " ")
+        guard !words.isEmpty, !ayuIsLyricsCredit(text) else { continue }
+        lines.append(AyuLyricsLine(time: start / 1000.0, endTime: (start + length) / 1000.0, text: text, words: words, exactWordTiming: true))
+    }
+    return lines.sorted(by: { $0.time < $1.time })
+}
+
+/// Fills a user URL template; every value is percent-encoded as a single component.
+func ayuFillLyricsTemplate(_ template: String, artist: String?, title: String, album: String?, duration: Double) -> URL? {
+    var allowed = CharacterSet.urlQueryAllowed
+    allowed.remove(charactersIn: "&=?/#+%")
+    func encode(_ value: String) -> String {
+        return value.addingPercentEncoding(withAllowedCharacters: allowed) ?? ""
+    }
+    let query = [artist ?? "", title].filter { !$0.isEmpty }.joined(separator: " ")
+    let filled = template.trimmingCharacters(in: .whitespacesAndNewlines)
+        .replacingOccurrences(of: "{artist}", with: encode(artist ?? ""))
+        .replacingOccurrences(of: "{title}", with: encode(title))
+        .replacingOccurrences(of: "{album}", with: encode(album ?? ""))
+        .replacingOccurrences(of: "{duration}", with: duration > 0.0 ? String(Int(duration.rounded())) : "")
+        .replacingOccurrences(of: "{query}", with: encode(query))
+    guard let url = URL(string: filled), let scheme = url.scheme?.lowercased(), scheme == "https" || scheme == "http" else { return nil }
+    return url
+}
+
+/// A user server's answer: JSON (LRCLIB-shaped or `{lrc|lyrics|text}`, possibly an array of
+/// such records, taking the first) or a bare LRC / plain-text body.
+func ayuParseCustomLyrics(_ data: Data, duration: Double) -> AyuLyrics? {
+    if let json = try? JSONSerialization.jsonObject(with: data) {
+        let record: [String: Any]?
+        if let dictionary = json as? [String: Any] {
+            record = (dictionary["data"] as? [String: Any]) ?? (dictionary["result"] as? [String: Any]) ?? dictionary
+        } else if let array = json as? [[String: Any]] {
+            record = array.first
+        } else {
+            record = nil
+        }
+        guard let record else { return nil }
+        if record["instrumental"] as? Bool == true { return .instrumental }
+        for key in ["yrc"] {
+            if let value = record[key] as? String { let lines = ayuParseYrc(value); if !lines.isEmpty { return .synced(lines) } }
+        }
+        for key in ["lyricsfile"] {
+            if let value = record[key] as? String { let lines = ayuParseLyricsfile(value, duration: duration); if !lines.isEmpty { return .synced(lines) } }
+        }
+        for key in ["syncedLyrics", "synced", "lrc", "lyrics", "plainLyrics", "plain", "text"] {
+            guard let value = record[key] as? String, !value.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else { continue }
+            let lines = ayuParseLrc(value, duration: duration)
+            if !lines.isEmpty { return .synced(lines) }
+            return .plain(value)
+        }
+        return nil
+    }
+    guard let text = String(data: data, encoding: .utf8), !text.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty, text.count < 200_000 else { return nil }
+    let yrc = ayuParseYrc(text)
+    if !yrc.isEmpty { return .synced(yrc) }
+    let lines = ayuParseLrc(text, duration: duration)
+    if !lines.isEmpty { return .synced(lines) }
+    // Refuse HTML error pages masquerading as text.
+    if text.range(of: "<html", options: .caseInsensitive) != nil { return nil }
+    return .plain(text)
+}
+
+/// NetEase cloudsearch songs → (id, score, |duration delta|), best first, at least 0.6.
+func ayuRankNetEaseSongs(_ songs: [[String: Any]], title: String, artist: String?, duration: Double) -> [(id: Int64, score: Double, delta: Double)] {
+    return songs.compactMap { song -> (id: Int64, score: Double, delta: Double)? in
+        guard let id = (song["id"] as? NSNumber)?.int64Value, let name = song["name"] as? String else { return nil }
+        let artistList = (song["ar"] as? [[String: Any]]) ?? (song["artists"] as? [[String: Any]]) ?? []
+        let artists = artistList.compactMap { $0["name"] as? String }.joined(separator: ", ")
+        let milliseconds = (song["dt"] as? NSNumber)?.doubleValue ?? (song["duration"] as? NSNumber)?.doubleValue ?? 0.0
+        let seconds = milliseconds / 1000.0
+        let score = AyuMusicMetadata.matchScore(candidateTitle: name, candidateArtist: artists.isEmpty ? nil : artists, candidateDuration: seconds > 0.0 ? seconds : nil, title: title, artist: artist, duration: duration)
+        return (id, score, seconds > 0.0 && duration > 0.0 ? abs(seconds - duration) : 0.0)
+    }.filter { $0.score >= 0.6 }.sorted(by: { $0.score > $1.score })
+}
