+    let unread: Int
+    let muted: Bool
+    let isChannel: Bool
+}
+
+private func ayuFakeColor(_ rgb: UInt32) -> UIColor {
+    return UIColor(red: CGFloat((rgb >> 16) & 0xff) / 255.0, green: CGFloat((rgb >> 8) & 0xff) / 255.0, blue: CGFloat(rgb & 0xff) / 255.0, alpha: 1.0)
