@@ -0,0 +1,34 @@
+import Foundation
+import NaturalLanguage
+#if canImport(Translation)
+@_weakLinked import Translation
+#endif
+
+/// Apple's on-device translation (iOS 26+, languages downloaded in Settings → Translate).
+/// Nothing leaves the device; callers fall back to Telegram's translator when it fails.
+enum AyuAppleTranslation {
+    static func translate(_ text: String, to language: String, completion: @escaping (String?) -> Void) {
+        #if canImport(Translation)
+        if #available(iOS 26.0, *) {
+            let recognizer = NLLanguageRecognizer()
+            recognizer.processString(text)
+            guard let source = recognizer.dominantLanguage?.rawValue, source != language else {
+                completion(nil)
+                return
+            }
+            Task {
+                do {
+                    let session = TranslationSession(installedSource: Locale.Language(identifier: source), target: Locale.Language(identifier: language))
+                    let response = try await session.translate(text)
+                    let result = response.targetText
+                    DispatchQueue.main.async { completion(result) }
+                } catch {
+                    DispatchQueue.main.async { completion(nil) }
+                }
+            }
+            return
+        }
+        #endif
+        completion(nil)
+    }
+}
diff --git a/submodules/TelegramUI/Sources/AyuAudioToVoice.swift b/submodules/TelegramUI/Sources/AyuAudioToVoice.swift
new file mode 100644
index 00000000..5efaf49d
--- /dev/null
+++ b/submodules/TelegramUI/Sources/AyuAudioToVoice.swift
@@ -0,0 +1,126 @@
+import Foundation
+import AVFoundation
+import TelegramCore
+import OpusBinding
+
+/// "Audio → voice": decodes a music or audio file to 16 kHz mono PCM, encodes it with the same
+/// Ogg Opus writer the voice recorder uses (60 ms packets), and sends it as a voice message
+/// with a waveform. Long files are cut at 10 minutes.
+enum AyuAudioToVoice {
+    private static let packetBytes = 16000 / 1000 * 60 * 2
+    private static let maxSeconds = 600.0
+
+    static func convert(path: String, completion: @escaping (Data?, Double, Data?) -> Void) {
+        DispatchQueue.global(qos: .userInitiated).async {
+            let result = convertSync(path: path)
+            DispatchQueue.main.async {
+                completion(result?.0, result?.1 ?? 0.0, result?.2)
+            }
+        }
+    }
+
+    private static func convertSync(path: String) -> (Data, Double, Data)? {
+        let asset = AVURLAsset(url: URL(fileURLWithPath: path))
+        guard let track = asset.tracks(withMediaType: .audio).first, let reader = try? AVAssetReader(asset: asset) else { return nil }
+        let settings: [String: Any] = [
+            AVFormatIDKey: kAudioFormatLinearPCM,
+            AVSampleRateKey: 16000,
+            AVNumberOfChannelsKey: 1,
+            AVLinearPCMBitDepthKey: 16,
+            AVLinearPCMIsFloatKey: false,
+            AVLinearPCMIsBigEndianKey: false,
+            AVLinearPCMIsNonInterleaved: false
+        ]
+        let output = AVAssetReaderTrackOutput(track: track, outputSettings: settings)
+        guard reader.canAdd(output) else { return nil }
+        reader.add(output)
+        reader.timeRange = CMTimeRange(start: .zero, duration: CMTime(seconds: maxSeconds, preferredTimescale: 600))
+        guard reader.startReading() else { return nil }
+
+        let dataItem = TGDataItem()
+        let writer = TGOggOpusWriter()
+        guard writer.begin(with: dataItem) else { return nil }
+        var pending = Data()
+        // One peak per 100 ms for the waveform.
+        var peaks: [Int16] = []
+        var peak: Int16 = 0
+        var samplesInPeak = 0
+        while let buffer = output.copyNextSampleBuffer() {
+            guard let block = CMSampleBufferGetDataBuffer(buffer) else { continue }
+            var length = 0
+            var pointer: UnsafeMutablePointer<Int8>?
+            guard CMBlockBufferGetDataPointer(block, atOffset: 0, lengthAtOffsetOut: nil, totalLengthOut: &length, dataPointerOut: &pointer) == kCMBlockBufferNoErr, let pointer else { continue }
+            let chunk = Data(bytes: pointer, count: length)
+            chunk.withUnsafeBytes { raw in
+                for sample in raw.bindMemory(to: Int16.self) {
+                    let magnitude = sample == Int16.min ? Int16.max : abs(sample)
+                    peak = max(peak, magnitude)
+                    samplesInPeak += 1
+                    if samplesInPeak == 1600 {
+                        peaks.append(peak)
+                        peak = 0
+                        samplesInPeak = 0
+                    }
+                }
+            }
+            pending.append(chunk)
+            while pending.count >= packetBytes {
+                var packet = pending.prefix(packetBytes)
+                pending.removeFirst(packetBytes)
+                packet.withUnsafeMutableBytes { raw in
+                    _ = writer.writeFrame(raw.bindMemory(to: UInt8.self).baseAddress, frameByteCount: UInt(packetBytes))
+                }
+            }
+        }
+        if !pending.isEmpty {
+            pending.append(Data(count: packetBytes - pending.count))
+            pending.withUnsafeMutableBytes { raw in
+                _ = writer.writeFrame(raw.bindMemory(to: UInt8.self).baseAddress, frameByteCount: UInt(packetBytes))
+            }
+        }
+        guard writer.writeFrame(nil, frameByteCount: 0) else { return nil }
+        let duration = writer.encodedDuration()
+        guard duration > 0.0 else { return nil }
+        let waveform = makeWaveform(peaks)
+        return (dataItem.data(), duration, waveform)
+    }
+
+    /// Telegram's voice waveform: 100 values of 5 bits, packed.
+    private static func makeWaveform(_ peaks: [Int16]) -> Data {
+        let count = 100
+        var values = [Int](repeating: 0, count: count)
+        if !peaks.isEmpty {
+            let top = max(1, Int(peaks.max() ?? 1))
+            for index in 0 ..< count {
+                let from = index * peaks.count / count
+                let to = max(from + 1, (index + 1) * peaks.count / count)
+                let slice = peaks[from ..< min(to, peaks.count)]
+                let value = Int(slice.max() ?? 0)
+                values[index] = min(31, value * 31 / top)
+            }
+        }
+        var data = Data(count: (count * 5 + 7) / 8)
+        for (index, value) in values.enumerated() {
+            for bit in 0 ..< 5 where value & (1 << bit) != 0 {
+                let position = index * 5 + bit
+                data[position / 8] |= UInt8(1 << (position % 8))
+            }
+        }
+        return data
+    }
+
+    static func send(path: String, to chat: ChatControllerImpl) {
+        let ru = chat.presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        convert(path: path, completion: { [weak chat] data, duration, waveform in
+            guard let chat else { return }
+            guard let data else {
+                AyuOnlineTools.present(chat.context, title: ru ? "Голосовое" : "Voice message", message: ru ? "Не удалось перекодировать аудио." : "Could not convert the audio.")
+                return
+            }
+            let resource = LocalFileMediaResource(fileId: Int64.random(in: Int64.min ... Int64.max), size: Int64(data.count))
+            chat.context.engine.resources.storeResourceData(id: EngineMediaResource.Id(resource.id), data: data)
+            let file = TelegramMediaFile(fileId: EngineMedia.Id(namespace: Namespaces.Media.LocalFile, id: Int64.random(in: Int64.min ... Int64.max)), partialReference: nil, resource: resource, previewRepresentations: [], videoThumbnails: [], immediateThumbnailData: nil, mimeType: "audio/ogg", size: Int64(data.count), attributes: [.Audio(isVoice: true, duration: Int(duration), title: nil, performer: nil, waveform: waveform)], alternativeRepresentations: [])
+            chat.sendMessages([.message(text: "", attributes: [], inlineStickers: [:], mediaReference: .standalone(media: file), threadId: chat.chatLocation.threadId, replyToMessageId: nil, replyToStoryId: nil, localGroupingKey: nil, correlationId: nil, bubbleUpEmojiOrStickersets: [])])
+        })
+    }
+}
