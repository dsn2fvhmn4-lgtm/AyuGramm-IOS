@@ -0,0 +1,69 @@
+import Foundation
+
+func check(_ condition: @autoclosure () -> Bool, _ message: String) {
+    if !condition() { fatalError(message) }
+}
+let suite = "AyuGram.PolicyTests." + UUID().uuidString
+let defaults = UserDefaults(suiteName: suite)!
+defer { defaults.removePersistentDomain(forName: suite) }
+let prefix = AyuLocalNotificationSettings.prefix
+var settings = AyuLocalNotificationSettings(defaults: defaults)
+check(settings.groupByChat && !settings.avatars && !settings.actions, "default notification policy")
+var calendar = Calendar(identifier: .gregorian)
+calendar.timeZone = TimeZone(secondsFromGMT: 0)!
+func time(_ hour: Int, _ minute: Int) -> Date {
+    return calendar.date(from: DateComponents(year: 2026, month: 11, day: 1, hour: hour, minute: minute))!
+}
+check(!settings.isQuiet(at: time(23, 30), calendar: calendar), "quiet hours default off")
+settings.quietHours = true
+for (hour, minute, quiet) in [(22, 59, false), (23, 0, true), (0, 0, true), (7, 59, true), (8, 0, false)] {
+    check(settings.isQuiet(at: time(hour, minute), calendar: calendar) == quiet, "overnight interval \(hour):\(minute)")
+}
+settings.quietStart = 9 * 60
+settings.quietEnd = 17 * 60
+check(settings.isQuiet(at: time(9, 0), calendar: calendar), "day interval start inclusive")
+check(!settings.isQuiet(at: time(17, 0), calendar: calendar), "day interval end exclusive")
+settings.quietEnd = settings.quietStart
+check(settings.isQuiet(at: time(0, 0), calendar: calendar), "equal endpoints silent all day")
+for invalid in ["24:00", "12:60", "-1:00", "8:00", "08:0", "08:00:00", " 08:00", "08:00\n", "٠٨:٠٠"] {
+    check(AyuLocalNotificationSettings.minute(invalid) == nil, "invalid clock accepted: \(invalid)")
+}
+for minute in 0..<1440 {
+    check(AyuLocalNotificationSettings.minute(AyuLocalNotificationSettings.clock(minute)) == minute, "clock roundtrip")
+}
+defaults.set(true, forKey: prefix + "filterEnabled")
+defaults.set(" CAFE,Важно\n release notes ,", forKey: prefix + "keywords")
+settings = AyuLocalNotificationSettings(defaults: defaults)
+check(settings.matches("Café") && settings.matches("ВАЖНО!") && settings.matches("new release notes"), "keyword matching")
+check(!settings.matches("unrelated"), "keyword allowlist")
+defaults.set("", forKey: prefix + "keywords")
+check(!AyuLocalNotificationSettings(defaults: defaults).matches("anything"), "empty enabled allowlist must deny")
+
+let legacy = try JSONDecoder().decode(LoggedOutAccountAttribute.self, from: Data("{}".utf8))
+check(legacy.archive == nil, "legacy logout must not retain account")
+let metadata = AyuArchivedAccountInfo(peerId: Int64.max, title: "Профиль", timestamp: 1793491200)
+let marker = LoggedOutAccountAttribute(archive: metadata)
+let roundtripped = try JSONDecoder().decode(LoggedOutAccountAttribute.self, from: JSONEncoder().encode(marker))
+check(roundtripped == marker, "archive metadata roundtrip")
+check(marker != legacy, "metadata must participate in account attribute equality")
+
+AyuPluginChatFilter.set(owner: "first", words: ["[test].*", "ВАЖНО"], authors: [42])
+check(AyuPluginChatFilter.hides(text: "prefix [test].* suffix", authorId: nil), "literal punctuation")
+check(!AyuPluginChatFilter.hides(text: "testanything", authorId: nil), "must not interpret words as regex")
+check(AyuPluginChatFilter.hides(text: "важно!", authorId: nil), "case normalization")
+check(AyuPluginChatFilter.hides(text: "", authorId: 42), "author filter")
+AyuPluginChatFilter.set(owner: "second", words: ["second"], authors: [])
+AyuPluginChatFilter.removeAll(owner: "first")
