+        Row(key: "wallet", titleRu: "Кошелёк", titleEn: "Wallet", section: 4, itemId: 0),
+        Row(key: "proxy", titleRu: "Прокси", titleEn: "Proxy", section: 5, itemId: 0),
+        Row(key: "favorites", titleRu: "Избранное", titleEn: "Saved Messages", section: 7, itemId: 1),
+        Row(key: "recentCalls", titleRu: "Недавние звонки", titleEn: "Recent calls", section: 7, itemId: 2),
+        Row(key: "devices", titleRu: "Устройства", titleEn: "Devices", section: 7, itemId: 3),
+        Row(key: "folders", titleRu: "Папки с чатами", titleEn: "Chat folders", section: 7, itemId: 4),
+        Row(key: "notifications", titleRu: "Уведомления и звуки", titleEn: "Notifications and sounds", section: 8, itemId: 0),
+        Row(key: "privacy", titleRu: "Конфиденциальность", titleEn: "Privacy and security", section: 8, itemId: 1),
+        Row(key: "dataAndStorage", titleRu: "Данные и память", titleEn: "Data and storage", section: 8, itemId: 2),
+        Row(key: "appearance", titleRu: "Оформление", titleEn: "Appearance", section: 8, itemId: 3),
+        Row(key: "language", titleRu: "Язык", titleEn: "Language", section: 8, itemId: 4),
+        Row(key: "energySaving", titleRu: "Энергосбережение", titleEn: "Power saving", section: 8, itemId: 6),
+        Row(key: "premium", titleRu: "Telegram Premium", titleEn: "Telegram Premium", section: 9, itemId: 100),
+        Row(key: "stars", titleRu: "Звёзды", titleEn: "Stars", section: 9, itemId: 102),
+        Row(key: "ton", titleRu: "TON", titleEn: "TON", section: 9, itemId: 103),
+        Row(key: "business", titleRu: "Telegram для бизнеса", titleEn: "Telegram Business", section: 9, itemId: 104),
+        Row(key: "sendGift", titleRu: "Отправить подарок", titleEn: "Send a gift", section: 9, itemId: 105),
+        Row(key: "passport", titleRu: "Telegram Passport", titleEn: "Telegram Passport", section: 10, itemId: 0),
+        Row(key: "appleWatch", titleRu: "Apple Watch", titleEn: "Apple Watch", section: 10, itemId: 1),
+        Row(key: "support", titleRu: "Задать вопрос", titleEn: "Ask a question", section: 11, itemId: 0),
+        Row(key: "faq", titleRu: "Вопросы о Telegram", titleEn: "Telegram FAQ", section: 11, itemId: 1),
+        Row(key: "tips", titleRu: "Возможности Telegram", titleEn: "Telegram features", section: 11, itemId: 2)
+    ]
+
+    private static let defaultsKey = "ayu.appearance.hiddenSettingsRows"
+
+    public static var hiddenKeys: Set<String> {
+        get { return Set(UserDefaults.standard.stringArray(forKey: defaultsKey) ?? []) }
+        set {
+            UserDefaults.standard.set(Array(newValue).sorted(), forKey: defaultsKey)
+            NotificationCenter.default.post(name: AyuAppearancePlus.didChangeNotification, object: nil)
+        }
+    }
+
+    /// Whether the Settings row at (section, item id) is hidden.
+    public static func isHidden(section: Int, itemId: AnyHashable) -> Bool {
+        let hidden = self.hiddenKeys
+        guard !hidden.isEmpty else { return false }
+        return self.rows.contains(where: { row in
+            row.section == section && hidden.contains(row.key) && (itemId == AnyHashable(Int(row.itemId)) || itemId == AnyHashable(row.itemId))
+        })
+    }
+}
diff --git a/submodules/Display/Source/AyuWhiteGram.swift b/submodules/Display/Source/AyuWhiteGram.swift
new file mode 100644
