+// Settings → AyuGram → Glass and bubbles.
+
+private func ayuGlassSignal() -> Signal<Void, NoError> {
+    return Signal { subscriber in
+        subscriber.putNext(Void())
+        var observers: [NSObjectProtocol] = []
+        for name in [AyuGlass.didChangeNotification, AyuAppearancePlus.didChangeNotification] {
+            observers.append(NotificationCenter.default.addObserver(forName: name, object: nil, queue: .main, using: { _ in
+                subscriber.putNext(Void())
+            }))
+        }
+        return ActionDisposable {
+            for observer in observers {
+                NotificationCenter.default.removeObserver(observer)
+            }
+        }
+    }
+}
+
+private enum AyuGlassRow: Int32 {
+    case messagesHeader = 0
+    case bubbleStyle = 1
+    case tinted = 2
+    case outline = 3
+    case buttons = 4
+    case messagesInfo = 5
+    case interfaceHeader = 10
+    case lists = 11
+    case gifts = 12
+    case blurGlass = 13
+    case interfaceInfo = 14
+}
+
+func ayuGlassController(context: AccountContext) -> ViewController {
+    let arguments = AyuSectionedArguments(open: { id in
+        guard id == AyuGlassRow.bubbleStyle.rawValue else { return }
+        let ru = context.sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru")
+        let sheet = UIAlertController(title: ru ? "Пузыри сообщений" : "Message bubbles", message: nil, preferredStyle: .actionSheet)
+        for style in AyuGlass.BubbleStyle.allCases {
+            sheet.addAction(UIAlertAction(title: style.title(ru) + (style == AyuGlass.bubbleStyle ? " ✓" : ""), style: .default, handler: { _ in
+                AyuGlass.bubbleStyle = style
+            }))
+        }
+        sheet.addAction(UIAlertAction(title: ru ? "Отмена" : "Cancel", style: .cancel))
+        context.sharedContext.applicationBindings.presentNativeController(sheet)
+    }, toggle: { id, value in
+        switch AyuGlassRow(rawValue: id) {
+        case .tinted?: AyuGlass.tinted = value
+        case .outline?: AyuGlass.outline = value
+        case .buttons?: AyuGlass.buttons = value
+        case .lists?: AyuGlass.lists = value
+        case .gifts?: AyuGlass.gifts = value
+        case .blurGlass?:
+            AyuAppearancePlus.blurGlass = value
+            if value { AyuAppearancePlus.noGlass = false }
+        default: break
+        }
+    })
+
+    let signal = combineLatest(context.sharedContext.presentationData, ayuGlassSignal())
+    |> deliverOnMainQueue
+    |> map { presentationData, _ -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        func symbol(_ name: String, _ color: UInt32) -> UIImage? {
+            return AyuSettingsIcons.symbol(name, color: UIColor(rgb: color))
+        }
+        var entries: [AyuSectionedEntry] = [
+            .header(1, AyuGlassRow.messagesHeader.rawValue, ru ? "СООБЩЕНИЯ" : "MESSAGES"),
+            .link(1, AyuGlassRow.bubbleStyle.rawValue, symbol("bubble.left.and.bubble.right.fill", 0x32ADE6), ru ? "Пузыри" : "Bubbles", AyuGlass.bubbleStyle.title(ru))
+        ]
+        if AyuGlass.bubbleStyle == .glass || AyuGlass.bubbleStyle == .cold {
+            entries.append(.toggle(1, AyuGlassRow.tinted.rawValue, symbol("paintpalette.fill", 0xAF52DE), ru ? "Тонированное стекло" : "Tinted glass", ru ? "Цвет пузыря просвечивает сквозь стекло" : "The bubble colour shows through the glass", AyuGlass.tinted))
+        }
+        entries.append(.toggle(1, AyuGlassRow.outline.rawValue, symbol("square.dashed", 0x8E8E93), ru ? "Обводка сообщений" : "Message outline", ru ? "Тонкая линия вокруг каждого пузыря" : "A thin line around every bubble", AyuGlass.outline))
+        entries.append(.toggle(1, AyuGlassRow.buttons.rawValue, symbol("rectangle.grid.1x2.fill", 0x007AFF), ru ? "Стеклянные кнопки" : "Glass inline buttons", ru ? "Кнопки под сообщениями из стекла" : "Inline buttons under messages drawn as glass", AyuGlass.buttons))
+        entries.append(.info(1, AyuGlassRow.messagesInfo.rawValue, ru ? "Стекло — Liquid Glass iOS 26 (на старых iOS — матовый материал). Холодное стекло — яркое матовое с холодным оттенком. Размытие фона — обои размываются под пузырём. Применяется к новым и прокрученным сообщениям." : "Glass is iOS 26 Liquid Glass (a frosted material on older iOS). Cold glass is a vivid frosted surface with a cold tint. Background blur blurs the wallpaper behind the bubble. Applies to messages as they are laid out."))
+        entries.append(.header(2, AyuGlassRow.interfaceHeader.rawValue, ru ? "ИНТЕРФЕЙС" : "INTERFACE"))
+        entries.append(.toggle(2, AyuGlassRow.lists.rawValue, symbol("list.bullet.rectangle.fill", 0x34C759), ru ? "Стеклянные настройки и профиль" : "Glass settings and profile", ru ? "Полупрозрачные панели на цветной подложке" : "Translucent panels on a tinted backdrop", AyuGlass.lists))
+        entries.append(.toggle(2, AyuGlassRow.gifts.rawValue, symbol("gift.fill", 0xFF9500), ru ? "Подарки на стекле" : "Glass gifts", ru ? "Подарки в профиле на стеклянном фоне" : "Profile gifts on glass backgrounds", AyuGlass.gifts))
+        entries.append(.toggle(2, AyuGlassRow.blurGlass.rawValue, symbol("aqi.medium", 0x5AC8FA), ru ? "Размытие вместо стекла" : "Blur instead of glass", ru ? "Панели и кнопки — простое размытие. Не сочетается с «Без стекла»" : "Panels and buttons become a plain blur. Not combined with No glass", AyuAppearancePlus.blurGlass))
