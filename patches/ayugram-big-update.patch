+import Foundation
+import JavaScriptCore
+import CryptoKit
+import Display
+import TelegramCore
+
+/// Code plugins: JavaScript files that run in their own JavaScriptCore virtual machine on a
+/// private thread and change app behaviour through `AyuHooks` — wrapping or replacing native
+/// handlers (for example the outgoing-text handler) and switching native features off.
+///
+/// iOS cannot spawn processes or load downloaded native code, so a separate VM per plugin is
+/// the isolation boundary: an exception stays inside its plugin, and a plugin that does not
+/// answer a hook within the time limit is disabled and its hooks removed while the app keeps
+/// running. Declarative `.plugin`/`.iosplug` (JSON) plugins are untouched and keep working.
+///
+/// Plugins get no network, account or message-sending API; they see only the text handed to
+/// their hooks.
+public final class AyuScriptRuntime {
+    public struct Plugin: Codable, Equatable {
+        public var id: String
+        public var name: String
+        public var author: String
+        public var version: String
+        public var description: String
+        public var enabled: Bool
+        public var disabledReason: String?
+        /// "js" (or nil, older installs), "python" or "wasm".
+        public var language: String?
+        /// Declared `@inject` / `"inject": true`: wants the player, lyrics and other app internals.
+        public var injects: Bool?
+        /// Installed from the official catalog with a valid AyuGram signature.
+        public var official: Bool?
+        /// Declared `@permissions` (ui, menu, profile, overlay, fonts, badges, clipboard, device, haptics).
+        public var permissions: [String]?
+        /// Declared `@connect` hosts for `ayu.net.fetch` (api.example.com or *.example.com).
+        public var connect: [String]? = nil
+        /// Declared `@requires other >=1.2, another`: plugins that must be installed first.
+        public var requires: [String]? = nil
+
+        public var engine: Language {
+            return Language(rawValue: self.language ?? "js") ?? .javascript
+        }
+
+        /// May use injection APIs right now (official, or allowed by the developer option).
+        public var canInject: Bool {
+            if self.official == true { return true }
+            return self.injects == true && AyuDeveloperSettings.shared.current.allowUnofficialInjectPlugins
+        }
+    }
+
+    public enum Language: String {
+        case javascript = "js"
+        case python
+        case wasm
+        case lua
+
+        var fileExtension: String {
+            switch self {
+            case .javascript: return "js"
+            case .python: return "py"
+            case .wasm: return "wasm"
+            case .lua: return "lua"
+            }
+        }
+    }
+
+    public enum InstallError: LocalizedError {
+        case invalidFile
+        case tooLarge
+        case invalidIdentifier
+        case injectRefused
+        case injectNeedsConsent
+        case missingDependency(String)
+        case revoked(String)
+
+        public var errorDescription: String? {
+            let ru = Locale.preferredLanguages.first?.hasPrefix("ru") == true
+            switch self {
+            case let .missingDependency(requirement): return ru ? "Сначала установите плагин \(requirement)." : "Install \(requirement) first."
+            case let .revoked(reason): return (ru ? "Команда AyuGram отозвала этот плагин." : "The AyuGram team revoked this plugin.") + (reason.isEmpty ? "" : " " + reason)
+            case .invalidFile: return ru ? "Файл не является плагином на JavaScript, Python или WebAssembly." : "The file is not a JavaScript, Python or WebAssembly plugin."
+            case .tooLarge: return ru ? "Плагин слишком большой (код — до 512 КБ, WebAssembly — до 2 МБ)." : "The plugin is too large (512 KB for code, 2 MB for WebAssembly)."
+            case .invalidIdentifier: return ru ? "Укажите @id из латинских букв, цифр, «-» и «_»." : "Use an @id of latin letters, digits, - and _."
+            case .injectRefused: return AyuPluginTrust.refusalText(ru)
+            case .injectNeedsConsent: return AyuPluginTrust.disclaimerText(ru)
+            }
+        }
+    }
+
+    public static let shared = AyuScriptRuntime()
+    public static let didChangeNotification = Notification.Name("AyuGram.ScriptPluginsChanged")
+    public static let fileExtensions: Set<String> = ["js", "ayujs", "py", "ayupy", "wasm"]
+
+    /// Presents short host messages (`ayu.toast`); installed by the app on launch.
+    public var toastHandler: ((String) -> Void)?
+
+    private let lock = NSRecursiveLock()
+    private var index: [Plugin] = []
+    private var instances: [String: AyuPluginInstance] = [:]
+    private var bootstrapped = false
+
+    private init() {
+        self.index = self.loadIndex()
+    }
+
+    // MARK: Storage
+
+    private var directory: URL? {
+        return FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first?
+            .appendingPathComponent("AyuGram", isDirectory: true)
+            .appendingPathComponent("scripts", isDirectory: true)
+    }
+
+    private func sourceURL(id: String, language: Language = .javascript) -> URL? {
+        return self.directory?.appendingPathComponent(id + "." + language.fileExtension)
+    }
+
+    private func sourceURL(_ plugin: Plugin) -> URL? {
+        return self.sourceURL(id: plugin.id, language: plugin.engine)
+    }
+
+    // MARK: Plugin storage (shared by every engine)
+
+    static func storageKey(_ id: String) -> String { return "ayu.script.storage." + id }
+
+    static func storageValue(pluginId: String, key: String) -> String? {
+        return (UserDefaults.standard.dictionary(forKey: AyuScriptRuntime.storageKey(pluginId)) as? [String: String])?[key]
+    }
+
+    /// False when the 64 KiB per-plugin limit would be exceeded.
+    static func setStorageValue(pluginId: String, key: String, value: String?) -> Bool {
+        var storage = (UserDefaults.standard.dictionary(forKey: AyuScriptRuntime.storageKey(pluginId)) as? [String: String]) ?? [:]
+        storage[key] = value
+        let size = storage.reduce(0) { $0 + $1.key.utf8.count + $1.value.utf8.count }
+        guard size <= 64 * 1024 else { return false }
+        UserDefaults.standard.set(storage, forKey: AyuScriptRuntime.storageKey(pluginId))
+        return true
+    }
+
+    private func loadIndex() -> [Plugin] {
+        guard let url = self.directory?.appendingPathComponent("index.json"), let data = try? Data(contentsOf: url),
+              let decoded = try? JSONDecoder().decode([Plugin].self, from: data) else { return [] }
+        return decoded
+    }
+
+    private func saveIndex() {
+        guard let directory = self.directory, let data = try? JSONEncoder().encode(self.index) else { return }
+        try? FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        try? data.write(to: directory.appendingPathComponent("index.json"), options: .atomic)
+    }
+
+    public var plugins: [Plugin] {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return self.index
+    }
+
+    // MARK: Install
+
+    /// Reads the `// @key value` header (an optional `==AyuPlugin==` block) without running code.
+    public func preview(_ data: Data, filename: String) -> Plugin? {
+        // A `.plugin` bundle is previewed as the source it joins into.
+        if AyuPluginBundle.isBundle(data) {
+            guard let bundle = AyuPluginBundle.unpack(data) else { return nil }
+            return self.preview(bundle.data, filename: bundle.filename)
+        }
+        let fileExtension = (filename as NSString).pathExtension.lowercased()
+        if data.starts(with: [0x00, 0x61, 0x73, 0x6d]) {
+            return self.previewWasm(data, filename: filename)
+        }
+        let language: Language = (fileExtension == "py" || fileExtension == "ayupy") ? .python : (fileExtension == "lua" ? .lua : .javascript)
+        guard data.count <= 512 * 1024, let source = String(data: data, encoding: .utf8), !source.contains("\u{0}") else { return nil }
+        let commentPrefix = language == .python ? "#" : (language == .lua ? "--" : "//")
+        var fields: [String: String] = [:]
+        for line in source.components(separatedBy: .newlines).prefix(80) {
+            let trimmed = line.trimmingCharacters(in: .whitespaces)
+            guard trimmed.hasPrefix(commentPrefix) else { continue }
+            let body = trimmed.dropFirst(commentPrefix.count).trimmingCharacters(in: .whitespaces)
+            guard body.hasPrefix("@") else { continue }
+            let parts = body.dropFirst().split(separator: " ", maxSplits: 1, omittingEmptySubsequences: true)
+            guard let key = parts.first else { continue }
+            fields[String(key).lowercased()] = parts.count > 1 ? String(parts[1]).trimmingCharacters(in: .whitespaces) : ""
+        }
+        let fallbackId = ((filename as NSString).deletingPathExtension).lowercased().map { ch -> Character in
+            return (ch.isLetter && ch.isASCII) || ch.isNumber || ch == "-" || ch == "_" ? ch : "-"
+        }
+        // exteraGram-style Python metadata: __id__ = "…", __name__ = "…", …
+        if language == .python {
+            for line in source.components(separatedBy: .newlines).prefix(150) {
+                let trimmed = line.trimmingCharacters(in: .whitespaces)
+                guard trimmed.hasPrefix("__"), let equals = trimmed.firstIndex(of: "=") else { continue }
+                let name = trimmed[..<equals].trimmingCharacters(in: .whitespaces)
+                guard name.hasSuffix("__"), name.count > 4 else { continue }
+                let key = String(name.dropFirst(2).dropLast(2)).lowercased()
+                let value = trimmed[trimmed.index(after: equals)...].trimmingCharacters(in: .whitespaces).trimmingCharacters(in: CharacterSet(charactersIn: "\"'"))
+                if ["id", "name", "description", "author", "version"].contains(key), fields[key] == nil {
+                    fields[key] = value
+                }
+            }
+        }
+        let id = (fields["id"] ?? String(fallbackId)).lowercased()
+        // `@name:ru` / `@description:ru` win for that interface language.
+        let language2 = String((Locale.preferredLanguages.first ?? "en").prefix(2)).lowercased()
+        let localizedName = fields["name:" + language2] ?? fields["name"]
+        let localizedDescription = fields["description:" + language2] ?? fields["description"]
+        return Plugin(
+            id: id,
+            name: String((localizedName ?? (filename as NSString).deletingPathExtension).prefix(64)),
+            author: String((fields["author"] ?? "").prefix(128)),
+            version: String((fields["version"] ?? "1.0").prefix(32)),
+            description: String((localizedDescription ?? "").prefix(1024)),
+            enabled: false,
+            disabledReason: nil,
+            language: language.rawValue,
+            injects: ["true", "yes", "1"].contains((fields["inject"] ?? "").lowercased()),
+            official: nil,
+            permissions: AyuPluginPermission.parse(fields["permissions"] ?? ""),
+            connect: AyuPluginGrants.parseHosts(fields["connect"] ?? ""),
+            requires: AyuScriptRuntime.parseRequires(fields["requires"] ?? "")
+        )
+    }
+
+    /// A WebAssembly plugin describes itself in its `ayu.manifest` custom section (JSON).
+    private func previewWasm(_ data: Data, filename: String) -> Plugin? {
+        guard data.count <= 2 * 1024 * 1024, let manifest = AyuScriptRuntime.wasmCustomSection(data, name: "ayu.manifest"),
+              let fields = (try? JSONSerialization.jsonObject(with: manifest)) as? [String: Any] else { return nil }
+        let fallbackId = ((filename as NSString).deletingPathExtension).lowercased()
+        return Plugin(
+            id: ((fields["id"] as? String) ?? fallbackId).lowercased(),
+            name: String(((fields["name"] as? String) ?? fallbackId).prefix(64)),
+            author: String(((fields["author"] as? String) ?? "").prefix(128)),
+            version: String(((fields["version"] as? String) ?? "1.0").prefix(32)),
+            description: String(((fields["description"] as? String) ?? "").prefix(1024)),
+            enabled: false,
+            disabledReason: nil,
+            language: Language.wasm.rawValue,
+            injects: fields["inject"] as? Bool ?? false,
+            official: nil,
+            permissions: AyuPluginPermission.parse((fields["permissions"] as? [String] ?? []).joined(separator: ",")),
+            connect: AyuPluginGrants.parseHosts((fields["connect"] as? [String] ?? []).joined(separator: ",")),
+            requires: AyuScriptRuntime.parseRequires((fields["requires"] as? [String] ?? []).joined(separator: ","))
+        )
+    }
+
+    /// Payload of the first custom section called `name`, read without running the module.
+    static func wasmCustomSection(_ data: Data, name: String) -> Data? {
+        let bytes = [UInt8](data)
+        guard bytes.count >= 8 else { return nil }
+        func leb(_ index: inout Int) -> Int? {
+            var result = 0
+            var shift = 0
+            while index < bytes.count, shift < 35 {
+                let byte = bytes[index]
+                index += 1
+                result |= Int(byte & 0x7f) << shift
+                if byte < 0x80 { return result }
+                shift += 7
+            }
+            return nil
+        }
+        var index = 8
+        while index < bytes.count {
+            let id = bytes[index]
+            index += 1
+            guard let size = leb(&index), index + size <= bytes.count else { return nil }
+            let end = index + size
+            if id == 0 {
+                var cursor = index
+                guard let nameLength = leb(&cursor), cursor + nameLength <= end else { return nil }
+                if String(bytes: bytes[cursor ..< cursor + nameLength], encoding: .utf8) == name {
+                    return Data(bytes[(cursor + nameLength) ..< end])
+                }
+            }
+            index = end
+        }
+        return nil
+    }
+
+    /// `official`: verified against the catalog signature. `acceptedRisk`: the user confirmed the
+    /// disclaimer for an unofficial injecting plugin.
+    @discardableResult
+    public func install(_ data: Data, filename: String, official: Bool = false, acceptedRisk: Bool = false) throws -> Plugin {
+        if AyuPluginBundle.isBundle(data) {
+            guard let bundle = AyuPluginBundle.unpack(data) else { throw InstallError.invalidFile }
+            return try self.install(bundle.data, filename: bundle.filename, official: official, acceptedRisk: acceptedRisk)
+        }
+        guard data.count <= 2 * 1024 * 1024 else { throw InstallError.tooLarge }
+        guard var plugin = self.preview(data, filename: filename) else { throw InstallError.invalidFile }
+        switch AyuPluginTrust.decision(injects: plugin.injects == true, official: official) {
+        case .allowed:
+            break
+        case .refused:
+            throw InstallError.injectRefused
+        case .needsDisclaimer:
+            guard acceptedRisk else { throw InstallError.injectNeedsConsent }
+        }
+        plugin.official = official
+        guard !plugin.id.isEmpty, plugin.id.utf8.count <= 64,
+              plugin.id.unicodeScalars.allSatisfy({ (97...122).contains($0.value) || (48...57).contains($0.value) || $0 == "-" || $0 == "_" }) else {
+            throw InstallError.invalidIdentifier
+        }
+        if let revoked = AyuPluginKillSwitch.shared.revocation(id: plugin.id, sha256: AyuScriptRuntime.sha256(data)) {
+            throw InstallError.revoked(revoked.reason ?? "")
+        }
+        for requirement in plugin.requires ?? [] where !self.satisfies(requirement) {
+            throw InstallError.missingDependency(requirement)
+        }
+        guard let directory = self.directory, let url = self.sourceURL(plugin) else { throw InstallError.invalidFile }
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        self.stop(id: plugin.id)
+        // A plugin replaced by one in another language leaves no old file behind.
+        for language in [Language.javascript, .python, .wasm, .lua] where language != plugin.engine {
+            if let old = self.sourceURL(id: plugin.id, language: language) { try? FileManager.default.removeItem(at: old) }
+        }
+        try data.write(to: url, options: .atomic)
+        plugin.enabled = true
+        self.lock.lock()
+        self.index.removeAll(where: { $0.id == plugin.id })
+        self.index.append(plugin)
+        self.saveIndex()
+        self.lock.unlock()
+        self.start(plugin)
+        self.notify()
+        return plugin
+    }
+
+    static func sha256(_ data: Data) -> String {
+        return SHA256.hash(data: data).map { String(format: "%02x", $0) }.joined()
+    }
+
+    /// "other >=1.2, another" → ["other >=1.2", "another"].
+    static func parseRequires(_ text: String) -> [String] {
+        return text.split(separator: ",").map { $0.trimmingCharacters(in: .whitespaces).lowercased() }.filter { !$0.isEmpty }.prefix(8).map { $0 }
+    }
+
+    private static func versionParts(_ version: String) -> [Int] {
+        return version.split(separator: ".").map { Int($0.filter(\.isNumber)) ?? 0 }
+    }
+
+    /// An installed plugin `id` at or above the minimum version, if one is given.
+    func satisfies(_ requirement: String) -> Bool {
+        let parts = requirement.split(separator: " ", omittingEmptySubsequences: true)
+        guard let id = parts.first.map(String.init), let plugin = self.plugin(id: id) else { return false }
+        guard parts.count > 1, parts[1].hasPrefix(">=") else { return true }
+        let minimum = AyuScriptRuntime.versionParts(String(parts[1].dropFirst(2)))
+        let installed = AyuScriptRuntime.versionParts(plugin.version)
+        for index in 0 ..< max(minimum.count, installed.count) {
+            let a = index < installed.count ? installed[index] : 0
+            let b = index < minimum.count ? minimum[index] : 0
+            if a != b { return a > b }
+        }
+        return true
+    }
+
+    /// Every installed plugin file (for the encrypted backup), with the name it installs under.
+    /// The installed file of one plugin.
+    public func sourceFile(id: String) -> (filename: String, data: Data)? {
+        guard let plugin = self.plugin(id: id), let url = self.sourceURL(plugin), let data = try? Data(contentsOf: url) else { return nil }
+        let suffix: String
+        switch plugin.engine {
+        case .javascript: suffix = ".ayu.js"
+        case .python: suffix = ".ayu.py"
+        case .wasm: suffix = ".wasm"
+        case .lua: suffix = ".ayu.lua"
+        }
+        return (plugin.id + suffix, data)
+    }
+
+    public func exportPlugins() -> [(filename: String, data: Data, enabled: Bool)] {
+        var result: [(filename: String, data: Data, enabled: Bool)] = []
+        for plugin in self.plugins {
+            guard let url = self.sourceURL(plugin), let data = try? Data(contentsOf: url) else { continue }
+            let suffix: String
+            switch plugin.engine {
+            case .javascript: suffix = ".js"
+            case .python: suffix = ".py"
+            case .wasm: suffix = ".wasm"
+            case .lua: suffix = ".lua"
+            }
+            result.append((plugin.id + suffix, data, plugin.enabled))
+        }
+        return result
+    }
+
+    /// Turns off installed plugins on the team's revocation list.
+    public func applyRevocations() {
+        for plugin in self.plugins where plugin.enabled {
+            var hash: String?
+            if let url = self.sourceURL(plugin), let data = try? Data(contentsOf: url) {
+                hash = AyuScriptRuntime.sha256(data)
+            }
+            if AyuPluginKillSwitch.shared.revocation(id: plugin.id, sha256: hash) != nil {
+                self.stop(id: plugin.id)
+                self.lock.lock()
+                if let position = self.index.firstIndex(where: { $0.id == plugin.id }) {
+                    self.index[position].enabled = false
+                    self.index[position].disabledReason = "revoked"
+                }
+                self.saveIndex()
+                self.lock.unlock()
+                self.notify()
+            }
+        }
+    }
+
+    public func setEnabled(_ id: String, _ enabled: Bool) {
+        self.lock.lock()
+        guard let position = self.index.firstIndex(where: { $0.id == id }) else {
+            self.lock.unlock()
+            return
+        }
+        self.index[position].enabled = enabled
+        self.index[position].disabledReason = nil
+        let plugin = self.index[position]
+        self.saveIndex()
+        self.lock.unlock()
+        if enabled { self.start(plugin) } else { self.stop(id: id) }
+        self.notify()
+    }
+
+    public func remove(_ id: String) {
+        self.stop(id: id)
+        self.lock.lock()
+        self.index.removeAll(where: { $0.id == id })
+        self.saveIndex()
+        self.lock.unlock()
+        for language in [Language.javascript, .python, .wasm, .lua] {
+            if let url = self.sourceURL(id: id, language: language) { try? FileManager.default.removeItem(at: url) }
+        }
+        UserDefaults.standard.removeObject(forKey: AyuScriptRuntime.storageKey(id))
+        AyuPluginSettings.removeValues(pluginId: id)
+        self.notify()
+    }
+
+    /// Source text of a JavaScript or Python plugin; nil for WebAssembly.
+    public func source(id: String) -> String? {
+        guard let plugin = self.plugins.first(where: { $0.id == id }), plugin.engine != .wasm,
+              let url = self.sourceURL(plugin), let data = try? Data(contentsOf: url) else { return nil }
+        return String(data: data, encoding: .utf8)
+    }
+
+    public func plugin(id: String) -> Plugin? {
+        return self.plugins.first(where: { $0.id == id })
+    }
+
+    /// Runs code typed in the plugin console inside a running JavaScript plugin.
+    public func evaluate(pluginId: String, code: String, completion: @escaping (String) -> Void) {
+        self.lock.lock()
+        let instance = self.instances[pluginId]
+        self.lock.unlock()
+        guard let repl = instance as? AyuReplInstance else {
+            return completion("REPL works with running JavaScript plugins.")
+        }
+        repl.evaluate(code, completion: { result in
+            DispatchQueue.main.async { completion(result) }
+        })
+    }
+
+    /// Stops every running plugin without changing what is enabled (decoy mode).
+    public func stopAll() {
+        self.lock.lock()
+        let ids = Array(self.instances.keys)
+        self.lock.unlock()
+        for id in ids { self.stop(id: id) }
+    }
+
+    /// Starts every enabled plugin once per launch (never in decoy mode).
+    public func bootstrap() {
+        if AyuDecoyState.isActive {
+            return
+        }
+        self.lock.lock()
+        guard !self.bootstrapped else {
+            self.lock.unlock()
+            return
+        }
+        self.bootstrapped = true
+        let enabled = self.index.filter { $0.enabled }
+        self.lock.unlock()
+        // AyuGram's history reports server deletions and edits; plugins get them as events.
+        let _ = NotificationCenter.default.addObserver(forName: ayuMessageHistoryEventNotification, object: nil, queue: .main, using: { notification in
+            guard let info = notification.userInfo as? [String: Any], let kind = info["kind"] as? String else { return }
+            AyuScriptRuntime.shared.emit(kind == "deleted" ? "messageDeleted" : "messageEdited", info)
+        })
+        for plugin in enabled { self.start(plugin) }
+    }
+
+    /// What a running plugin registered, for its details screen.
+    public func activitySummary(id: String) -> [String] {
+        self.lock.lock()
+        let instance = self.instances[id]
+        self.lock.unlock()
+        return instance?.summary ?? []
+    }
+
+    // MARK: Events
+
+    /// Broadcasts an app event (`chatOpen`, `appForeground`, …) to every running plugin.
+    public func emit(_ event: String, _ payload: [String: Any] = [:], only owner: String? = nil) {
+        self.lock.lock()
+        let running = owner.map { id in self.instances[id].map { [$0] } ?? [] } ?? Array(self.instances.values)
+        self.lock.unlock()
+        for instance in running { instance.emit(event, payload) }
+    }
+
+    // MARK: Lifecycle
+
+    private func start(_ plugin: Plugin) {
+        guard let url = self.sourceURL(plugin), let data = try? Data(contentsOf: url) else { return }
+        self.stop(id: plugin.id)
+        let instance: AyuPluginInstance
+        switch plugin.engine {
+        case .javascript:
+            guard let source = String(data: data, encoding: .utf8) else { return }
+            instance = AyuScriptInstance(id: plugin.id, source: source, canInject: plugin.canInject, permissions: AyuPluginGrants.effective(plugin), runtime: self)
+        case .python:
+            instance = AyuPluginEngineInstance(id: plugin.id, engine: .python, data: data, canInject: plugin.canInject, permissions: AyuPluginGrants.effective(plugin), runtime: self)
+        case .wasm:
+            instance = AyuPluginEngineInstance(id: plugin.id, engine: .wasm, data: data, canInject: plugin.canInject, permissions: AyuPluginGrants.effective(plugin), runtime: self)
+        case .lua:
+            instance = AyuPluginEngineInstance(id: plugin.id, engine: .lua, data: data, canInject: plugin.canInject, permissions: AyuPluginGrants.effective(plugin), runtime: self)
+        }
+        self.lock.lock()
+        self.instances[plugin.id] = instance
+        self.lock.unlock()
+        instance.load()
+    }
+
+    private func stop(id: String) {
+        self.lock.lock()
+        let instance = self.instances.removeValue(forKey: id)
+        self.lock.unlock()
+        AyuHooks.shared.removeAll(owner: id)
+        AyuPluginUI.shared.removeAll(owner: id)
+        AyuTLObservers.remove(id)
+        AyuPluginAvatarDecorations.removeAll(owner: id)
+        AyuPluginChatBackground.removeAll(owner: id)
+        instance?.unload()
+    }
+
+    /// A plugin missed a hook deadline: switch it off so it can never stall the app again.
+    func pluginHung(_ id: String) {
+        self.lock.lock()
+        let instance = self.instances.removeValue(forKey: id)
+        if let position = self.index.firstIndex(where: { $0.id == id }) {
+            self.index[position].enabled = false
+            self.index[position].disabledReason = "timeout"
+        }
+        self.saveIndex()
+        self.lock.unlock()
+        AyuHooks.shared.removeAll(owner: id)
+        AyuPluginUI.shared.removeAll(owner: id)
+        AyuTLObservers.remove(id)
+        AyuPluginAvatarDecorations.removeAll(owner: id)
+        AyuPluginChatBackground.removeAll(owner: id)
+        instance?.abandon()
+        AyuPluginConsole.shared.append(pluginId: id, level: .error, "Plugin did not answer in time and was disabled.")
+        let ru = Locale.preferredLanguages.first?.hasPrefix("ru") == true
+        self.toast(ru ? "Плагин «\(id)» завис и был отключён" : "Plugin \"\(id)\" stopped responding and was disabled")
+        self.notify()
+    }
+
+    func toast(_ text: String) {
+        DispatchQueue.main.async {
+            self.toastHandler?(text)
+        }
+    }
+
+    private func notify() {
+        DispatchQueue.main.async {
+            NotificationCenter.default.post(name: AyuScriptRuntime.didChangeNotification, object: nil)
+        }
+    }
+}
+
+/// A plugin VM that can run code typed in the console (JavaScript).
+protocol AyuReplInstance: AnyObject {
+    func evaluate(_ code: String, completion: @escaping (String) -> Void)
+}
+
+/// A running plugin, whatever its language.
+protocol AyuPluginInstance: AnyObject {
+    var summary: [String] { get }
+    func load()
+    func unload()
+    func abandon()
+    func emit(_ event: String, _ payload: [String: Any])
+}
+
+/// One plugin: a JavaScriptCore VM confined to a serial queue.
+private final class AyuScriptInstance: AyuPluginInstance, AyuReplInstance {
+    /// Console REPL: runs `code` in this plugin's VM and returns the result or the exception.
+    func evaluate(_ code: String, completion: @escaping (String) -> Void) {
+        self.queue.async { [weak self] in
+            guard let self, let context = self.context else {
+                return completion("The plugin is not running.")
+            }
+            context.exception = nil
+            let value = context.evaluateScript(code)
+            if let exception = context.exception {
+                context.exception = nil
+                completion("⚠️ " + (exception.toString() ?? "exception"))
+            } else if let value, !value.isUndefined {
+                if value.isObject, let json = value.toObject(), JSONSerialization.isValidJSONObject(json), let data = try? JSONSerialization.data(withJSONObject: json, options: [.prettyPrinted]), let text = String(data: data, encoding: .utf8) {
+                    completion(text)
+                } else {
+                    completion(value.toString() ?? "")
+                }
+            } else {
+                completion("undefined")
+            }
+        }
+    }
+
+    let id: String
+    private let source: String
+    private let canInject: Bool
+    private let permissions: Set<String>
+    private weak var runtime: AyuScriptRuntime?
+    private let queue: DispatchQueue
+    private let queueKey = DispatchSpecificKey<String>()
+    private var vm: JSVirtualMachine?
+    private var context: JSContext?
+    private var events: [String: [JSValue]] = [:]
+    private var timers: [Int: DispatchWorkItem] = [:]
+    private var nextTimer = 1
+    private var stopped = false
+    private let summaryLock = NSLock()
+    private var summaryItems: [String] = []
+
+    init(id: String, source: String, canInject: Bool, permissions: Set<String>, runtime: AyuScriptRuntime) {
+        self.id = id
+        self.source = source
+        self.canInject = canInject
+        self.permissions = permissions
+        self.runtime = runtime
+        self.queue = DispatchQueue(label: "AyuGram.Script." + id, qos: .userInitiated)
+        self.queue.setSpecific(key: self.queueKey, value: id)
+    }
+
+    var summary: [String] {
+        self.summaryLock.lock()
+        defer { self.summaryLock.unlock() }
+        return self.summaryItems
+    }
+
+    private func addSummary(_ item: String) {
+        self.summaryLock.lock()
+        if !self.summaryItems.contains(item) { self.summaryItems.append(item) }
+        self.summaryLock.unlock()
+    }
+
+    private var hookTimeout: DispatchTimeInterval {
+        return AyuDeveloperSettings.shared.current.experimentalPluginHooks ? .seconds(2) : .milliseconds(250)
+    }
+
+    private func log(_ level: AyuPluginConsole.Line.Level, _ text: String) {
+        AyuPluginConsole.shared.append(pluginId: self.id, level: level, text)
+        if level == .error, AyuDeveloperSettings.shared.current.experimentalPluginHooks {
+            self.runtime?.toast("\(self.id): \(text)")
+        }
+    }
+
+    // MARK: Lifecycle
+
+    func load() {
+        self.queue.async { [weak self] in
+            guard let self, !self.stopped else { return }
+            guard let vm = JSVirtualMachine(), let context = JSContext(virtualMachine: vm) else {
+                self.log(.error, "JavaScriptCore is unavailable.")
+                return
+            }
+            self.vm = vm
+            self.context = context
+            context.name = "AyuGram plugin " + self.id
+            // Developer option: Safari → Develop → this device → the plugin's context.
+            if #available(iOS 16.4, *), AyuDeveloperSettings.unlocked, UserDefaults.standard.bool(forKey: "ayu.dev.webInspector") {
+                context.isInspectable = true
+            }
+            context.exceptionHandler = { [weak self] _, exception in
+                self?.log(.error, exception?.toString() ?? "Unknown exception")
+            }
+            self.installHost(in: context)
+            context.evaluateScript(AyuScriptInstance.prelude, withSourceURL: URL(string: "ayu://prelude.js"))
+            context.evaluateScript(self.source, withSourceURL: URL(string: "ayu://plugins/\(self.id).js"))
+            self.emitOnQueue("load", [:])
+            self.log(.info, "Loaded.")
+        }
+    }
+
+    func unload() {
+        self.queue.async {
+            guard !self.stopped else { return }
+            self.emitOnQueue("unload", [:])
+            self.teardown()
+        }
+    }
+
+    /// The queue may be stuck in an endless loop; drop everything reachable without it.
+    func abandon() {
+        self.stopped = true
+    }
+
+    private func teardown() {
+        self.stopped = true
+        for item in self.timers.values { item.cancel() }
+        self.timers = [:]
+        self.events = [:]
+        AyuPluginSettings.clear(pluginId: self.id)
+        self.context?.exceptionHandler = nil
+        self.context = nil
+        self.vm = nil
+    }
+
+    // MARK: Events
+
+    func emit(_ event: String, _ payload: [String: Any]) {
+        self.queue.async {
+            self.emitOnQueue(event, payload)
+        }
+    }
+
+    private func emitOnQueue(_ event: String, _ payload: [String: Any]) {
+        guard !self.stopped, let handlers = self.events[event] else { return }
+        if event == "trackChange" && !self.canInject { return }
+        for handler in handlers {
+            handler.call(withArguments: [payload])
+        }
+    }
+
+    // MARK: Hooks
+
+    /// Runs `handler(text, context)` on the plugin queue and waits for it, within the limit.
+    private func callTextHandler(_ handler: JSValue, text: String, context: AyuHooks.TextContext) -> String? {
+        if DispatchQueue.getSpecific(key: self.queueKey) == self.id {
+            return self.invokeText(handler, text: text, context: context)
+        }
+        var result: String?
+        let semaphore = DispatchSemaphore(value: 0)
+        self.queue.async {
+            result = self.invokeText(handler, text: text, context: context)
+            semaphore.signal()
+        }
+        if semaphore.wait(timeout: .now() + self.hookTimeout) == .timedOut {
+            self.runtime?.pluginHung(self.id)
+            return nil
+        }
+        return result
+    }
+
+    private func invokeText(_ handler: JSValue, text: String, context: AyuHooks.TextContext) -> String? {
+        guard !self.stopped else { return nil }
+        let info: [String: Any] = ["peerId": String(context.peerId), "isSecret": context.isSecret]
+        guard let value = handler.call(withArguments: [text, info]), value.isString else { return nil }
+        let string = value.toString() ?? ""
+        return string.utf16.count <= 8192 ? string : nil
+    }
+
+    // MARK: Host API
+
+    private func installHost(in context: JSContext) {
+        guard let host = JSValue(newObjectIn: context) else { return }
+
+        let log: @convention(block) (String, String) -> Void = { [weak self] level, text in
+            self?.log(AyuPluginConsole.Line.Level(rawValue: level) ?? .info, text)
+        }
+        let hook: @convention(block) (String, String, JSValue) -> Bool = { [weak self] pointName, modeName, handler in
+            guard let self else { return false }
+            let aliases: [String: AyuHooks.TextPoint] = ["outgoingText": .outgoingText, "outgoing": .outgoingText, "lyrics": .lyricsText, "lyricsText": .lyricsText, "linkOpen": .linkOpen, "messageRender": .messageRender, "notificationBeforeShow": .notificationBeforeShow]
+            guard let point = AyuHooks.TextPoint(rawValue: pointName) ?? aliases[pointName], let mode = AyuHooks.Mode(rawValue: modeName) else {
+                self.log(.warning, "Unknown hook \(pointName) (\(modeName)).")
+                return false
+            }
+            if let permission = point.permission, !self.permissions.contains(permission) {
+                self.log(.error, "\(point.rawValue) needs the '\(permission)' permission: add `@permissions \(permission)` to the plugin header.")
+                return false
+            }
+            if point.isInject && !self.canInject {
+                self.log(.error, "\(point.rawValue) is an injection point: only official plugins (or ones allowed in the developer settings) may use it.")
+                return false
+            }
+            if mode == .replace, let owner = AyuHooks.shared.replacingOwner(point), owner != self.id {
+                self.log(.warning, "\(point.rawValue) is already replaced by \(owner); registering as 'after'.")
+                AyuHooks.shared.register(point: point, mode: .after, owner: self.id, handler: { [weak self] text, context in
+                    return self?.callTextHandler(handler, text: text, context: context)
+                })
+                self.addSummary("\(point.rawValue): after")
+                return true
+            }
+            AyuHooks.shared.register(point: point, mode: mode, owner: self.id, handler: { [weak self] text, context in
+                return self?.callTextHandler(handler, text: text, context: context)
+            })
+            self.addSummary("\(point.rawValue): \(mode.rawValue)")
+            return true
+        }
+        let feature: @convention(block) (String, Bool) -> Bool = { [weak self] name, disabled in
+            guard let self else { return false }
+            guard let value = AyuHooks.Feature(rawValue: name) else {
+                self.log(.warning, "Unknown feature \(name).")
+                return false
+            }
+            AyuHooks.shared.setFeature(value, disabled: disabled, owner: self.id)
+            if disabled { self.addSummary("feature off: \(name)") }
+            return true
+        }
+        let on: @convention(block) (String, JSValue) -> Void = { [weak self] event, handler in
+            self?.events[event, default: []].append(handler)
+        }
+        let storageGet: @convention(block) (String) -> String? = { [weak self] key in
+            guard let self else { return nil }
+            return AyuScriptRuntime.storageValue(pluginId: self.id, key: key)
+        }
+        let storageSet: @convention(block) (String, String?) -> Void = { [weak self] key, value in
+            guard let self else { return }
+            // 64 KiB per plugin keeps UserDefaults small.
+            if !AyuScriptRuntime.setStorageValue(pluginId: self.id, key: key, value: value) {
+                self.log(.warning, "Storage limit (64 KB) reached; \(key) was not saved.")
+            }
+        }
+        let settingsDeclare: @convention(block) (JSValue) -> Void = { [weak self] items in
+            guard let self else { return }
+            AyuPluginSettings.declare(pluginId: self.id, items: (items.toArray() as? [[String: Any]]) ?? [])
+            self.addSummary("settings")
+        }
+        let settingGet: @convention(block) (String) -> String? = { [weak self] key in
+            guard let self else { return nil }
+            return AyuPluginSettings.value(pluginId: self.id, key: key)
+        }
+        let playerState: @convention(block) () -> [String: Any]? = { [weak self] in
+            guard let self, self.requireInject("ayu.player") else { return nil }
+            return AyuPluginAppBridge.playerState?() ?? [:]
+        }
+        let playerControl: @convention(block) (String) -> Bool = { [weak self] action in
+            guard let self, self.requireInject("ayu.player") else { return false }
+            return AyuPluginAppBridge.playerControl?(action) ?? false
+        }
+        // The extended API (ui, menu, profile, overlay, fonts, badges, clipboard, device, haptics).
+        let callAPI: @convention(block) (String, JSValue) -> Any? = { [weak self] op, args in
+            guard let self else { return nil }
+            let arguments = args.toDictionary() as? [String: Any] ?? [:]
+            return AyuPluginHostAPI.handle(pluginId: self.id, permissions: self.permissions, op: op, args: arguments, log: { level, text in self.log(level, text) })
+        }
+        let toast: @convention(block) (String) -> Void = { [weak self] text in
+            self?.runtime?.toast(String(text.prefix(200)))
+        }
+        let setTimer: @convention(block) (JSValue, Double, Bool) -> Int = { [weak self] handler, milliseconds, repeats in
+            guard let self, !self.stopped else { return 0 }
+            let id = self.nextTimer
+            self.nextTimer += 1
+            self.schedule(id: id, handler: handler, milliseconds: min(86_400_000.0, max(repeats ? 100.0 : 0.0, milliseconds.isFinite ? milliseconds : 0.0)), repeats: repeats)
+            return id
+        }
+        let clearTimer: @convention(block) (Int) -> Void = { [weak self] id in
+            self?.timers.removeValue(forKey: id)?.cancel()
+        }
+
+        // Passed as `Any`, a Swift closure would be boxed and JavaScript could not call it;
+        // the bit cast hands JavaScriptCore the real Objective-C block.
+        host.setObject(unsafeBitCast(log, to: AnyObject.self), forKeyedSubscript: "log" as NSString)
+        host.setObject(unsafeBitCast(hook, to: AnyObject.self), forKeyedSubscript: "hook" as NSString)
+        host.setObject(unsafeBitCast(feature, to: AnyObject.self), forKeyedSubscript: "feature" as NSString)
+        host.setObject(unsafeBitCast(on, to: AnyObject.self), forKeyedSubscript: "on" as NSString)
