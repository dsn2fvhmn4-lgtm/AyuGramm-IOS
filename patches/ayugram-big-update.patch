+static char* pk_default_importfile(const char* path, int* data_size) {
+#if PK_ENABLE_OS
+    FILE* f = fopen(path, "rb");
+    if(f == NULL) return NULL;
+    fseek(f, 0, SEEK_END);
+    long size = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    char* buffer = PK_MALLOC(size + 1);
+    size = fread(buffer, 1, size, f);
+    buffer[size] = 0;
+    fclose(f);
+    if(data_size) *data_size = (int)size;
+    return buffer;
+#else
+    return NULL;
+#endif
