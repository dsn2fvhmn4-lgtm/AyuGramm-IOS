+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import PresentationDataUtils
+import ItemListUI
+import AccountContext
+
+// Settings → AyuGram → Appearance+: tab bar contents, glass renderer and the classic
+// (pre-Liquid-Glass) design. Tab changes apply at once; glass and design after relaunch.
+
+private enum AyuAppearancePlusRow: Int32 {
+    case hideContacts = 1
+    case hideCalls = 2
+    case hideTitles = 3
+    case telegramGlass = 11
+    case classicDesign = 21
+    case noGlass = 22
+    case slowMotion = 25
+    case relaunchInfo = 30
+    case settingsRows = 35
+    case reset = 41
+    case effectsHeader = 50
+    case effect = 51
+    case effectAmount = 52
+    case effectSpeed = 53
+    case effectsInfo = 54
+}
+
+private func ayuAppearancePlusSignal() -> Signal<Void, NoError> {
+    return Signal { subscriber in
+        subscriber.putNext(Void())
+        let observer = NotificationCenter.default.addObserver(forName: AyuAppearancePlus.didChangeNotification, object: nil, queue: .main, using: { _ in
+            subscriber.putNext(Void())
+        })
+        return ActionDisposable {
+            NotificationCenter.default.removeObserver(observer)
+        }
+    }
+}
+
+func ayuAppearancePlusController(context: AccountContext) -> ViewController {
+    var presentController: ((ViewController) -> Void)?
+    var push: ((ViewController) -> Void)?
+
+    let arguments = AyuSectionedArguments(open: { id in
+        let russianNow = context.sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru")
+        if id == AyuAppearancePlusRow.effect.rawValue {
+            let sheet = UIAlertController(title: russianNow ? "Эффект поверх Telegram" : "Effect over Telegram", message: nil, preferredStyle: .actionSheet)
+            for effect in AyuOverlayEffects.Effect.allCases {
+                sheet.addAction(UIAlertAction(title: effect.title(russianNow) + (effect == AyuOverlayEffects.effect ? " ✓" : ""), style: .default, handler: { _ in
+                    AyuOverlayEffects.effect = effect
+                }))
+            }
+            sheet.addAction(UIAlertAction(title: russianNow ? "Отмена" : "Cancel", style: .cancel))
+            context.sharedContext.applicationBindings.presentNativeController(sheet)
+            return
+        }
+        if id == AyuAppearancePlusRow.effectAmount.rawValue || id == AyuAppearancePlusRow.effectSpeed.rawValue {
+            let steps: [Double] = [0.25, 0.5, 1.0, 1.5, 2.0, 3.0]
+            let amount = id == AyuAppearancePlusRow.effectAmount.rawValue
+            let current = amount ? AyuOverlayEffects.amount : AyuOverlayEffects.speed
+            let next = steps.first(where: { $0 > current + 0.01 }) ?? steps[0]
+            if amount { AyuOverlayEffects.amount = next } else { AyuOverlayEffects.speed = max(0.25, next) }
+            NotificationCenter.default.post(name: AyuAppearancePlus.didChangeNotification, object: nil)
+            return
+        }
+        if id == AyuAppearancePlusRow.settingsRows.rawValue {
+            push?(ayuSettingsVisibilityController(context: context))
+            return
+        }
+        if id == AyuAppearancePlusRow.slowMotion.rawValue {
+            let steps = AyuAppearancePlus.slowMotionSteps
+            let current = AyuAppearancePlus.slowMotionFactor
+            AyuAppearancePlus.slowMotionFactor = steps.first(where: { $0 > current + 0.01 }) ?? steps[0]
+            return
+        }
+        guard id == AyuAppearancePlusRow.reset.rawValue else { return }
+        let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+        let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        presentController?(textAlertController(context: context, title: ru ? "Сбросить оформление?" : "Reset appearance?", text: ru ? "Вкладки вернутся, стекло и дизайн станут стандартными." : "Tabs come back; glass and design return to default.", actions: [
+            TextAlertAction(type: .genericAction, title: presentationData.strings.Common_Cancel, action: {}),
+            TextAlertAction(type: .destructiveAction, title: ru ? "Сбросить" : "Reset", action: { AyuAppearancePlus.resetAll() })
+        ]))
+    }, toggle: { id, value in
+        guard let row = AyuAppearancePlusRow(rawValue: id) else { return }
+        switch row {
+        case .hideContacts: AyuAppearancePlus.hideContactsTab = value
+        case .hideCalls: AyuAppearancePlus.hideCallsTab = value
