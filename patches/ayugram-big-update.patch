+#undef KV
+#undef METHOD
+#undef CONCAT
+#undef CONCAT_
+
+#undef K
+#undef V
+#undef NAME
+#undef less
+#undef partial_less
+#undef equal
+
+#undef SMALLMAP_T__SOURCE
+#undef SMALLMAP_T__HEADER
