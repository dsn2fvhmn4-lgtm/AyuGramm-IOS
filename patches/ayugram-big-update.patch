@@ -0,0 +1,37 @@
+import Foundation
+import SwiftSignalKit
+import AccountContext
+import TelegramUIPreferences
+
+/// The music player's sleep timer: pauses playback after the chosen time, even with the
+/// player closed. One timer for the app; starting a new one replaces it.
+enum AyuSleepTimer {
+    private static var timer: SwiftSignalKit.Timer?
+    private static var fireDate: Date?
+
+    static var remainingMinutes: Int? {
+        guard let fireDate = AyuSleepTimer.fireDate else { return nil }
+        let seconds = fireDate.timeIntervalSinceNow
+        return seconds > 0.0 ? max(1, Int((seconds / 60.0).rounded(.up))) : nil
+    }
+
+    static func start(minutes: Int, context: AccountContext, type: MediaManagerPlayerType) {
+        AyuSleepTimer.cancel()
+        let interval = Double(minutes) * 60.0
+        AyuSleepTimer.fireDate = Date().addingTimeInterval(interval)
+        let mediaManager = context.sharedContext.mediaManager
+        let timer = SwiftSignalKit.Timer(timeout: interval, repeat: false, completion: {
+            mediaManager.playlistControl(.playback(.pause), type: type)
+            AyuSleepTimer.timer = nil
+            AyuSleepTimer.fireDate = nil
+        }, queue: Queue.mainQueue())
+        AyuSleepTimer.timer = timer
+        timer.start()
+    }
+
+    static func cancel() {
+        AyuSleepTimer.timer?.invalidate()
+        AyuSleepTimer.timer = nil
+        AyuSleepTimer.fireDate = nil
+    }
+}
