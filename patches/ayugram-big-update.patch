+import Foundation
+import UIKit
+
+/// Badges plugins put beside chat names in the chat list (`ayu.ui.badge.add`). The user's own
+/// badges (Customization) come first; plugin badges disappear with the plugin.
+public enum AyuPluginBadges {
+    private static let lock = NSLock()
+    private static var badges: [Int64: (owner: String, text: String)] = [:]
+
+    public static func badge(peerId: Int64) -> String? {
+        lock.lock(); defer { lock.unlock() }
+        return badges[peerId]?.text
+    }
+
+    public static func set(_ text: String?, peerId: Int64, owner: String) {
+        lock.lock()
+        if let text, !text.isEmpty {
+            badges[peerId] = (owner, text)
+        } else if badges[peerId]?.owner == owner {
+            badges[peerId] = nil
+        }
+        lock.unlock()
+    }
+
+    public static func removeAll(owner: String) {
+        lock.lock()
+        badges = badges.filter { $0.value.owner != owner }
+        lock.unlock()
+    }
+}
+
+/// Font sizes plugins ask for (`ayu.ui.font.set`): "messages" and "lists" (chat list, profiles,
+/// menus and settings), in points of the body text. Applied when presentation data is rebuilt.
+public enum AyuPluginFonts {
+    public static let didChangeNotification = Notification.Name("AyuGram.PluginFontsChanged")
+    private static let lock = NSLock()
+    private static var sizes: [String: (owner: String, size: Double)] = [:]
+
+    public static func size(element: String) -> Double? {
+        lock.lock(); defer { lock.unlock() }
+        return sizes[element]?.size
+    }
+
+    public static func set(element: String, size: Double?, owner: String) {
+        guard ["messages", "lists"].contains(element) else { return }
+        lock.lock()
+        if let size {
+            sizes[element] = (owner, max(12.0, min(30.0, size)))
+        } else if sizes[element]?.owner == owner {
+            sizes[element] = nil
+        }
+        lock.unlock()
+        NotificationCenter.default.post(name: didChangeNotification, object: nil)
+    }
+
+    /// Weight of regular app text set by a plugin (`ayu.ui.font.set({ weight })`). Read on every
+    /// `Font.regular`, so it is a plain value written only on the main thread.
+    public private(set) static var regularWeight: UIFont.Weight?
+    private static var weightOwner: String?
+
+    /// "rounded", "monospaced" or "italic" for regular text; nil is the system style.
+    public private(set) static var regularStyle: String?
+    private static var styledFonts: [CGFloat: UIFont] = [:]
+
+    /// The styled regular font, cached per size (main thread only, like the setters).
+    public static func styledRegular(_ size: CGFloat) -> UIFont? {
+        guard let style = regularStyle, Thread.isMainThread else { return nil }
+        if let font = styledFonts[size] {
+            return font
+        }
+        let base = UIFont.systemFont(ofSize: size, weight: regularWeight ?? .regular)
+        let descriptor: UIFontDescriptor?
+        switch style {
+        case "rounded": descriptor = base.fontDescriptor.withDesign(.rounded)
+        case "monospaced": descriptor = base.fontDescriptor.withDesign(.monospaced)
+        case "italic": descriptor = base.fontDescriptor.withSymbolicTraits(.traitItalic)
+        default: descriptor = nil
+        }
+        let font = descriptor.map { UIFont(descriptor: $0, size: size) } ?? base
+        styledFonts[size] = font
+        return font
+    }
+
+    public static func setStyle(_ name: String?, owner: String) {
+        DispatchQueue.main.async {
+            if let name, ["rounded", "monospaced", "italic"].contains(name) {
+                regularStyle = name
+                weightOwner = owner
+            } else if weightOwner == owner || name == nil {
+                regularStyle = nil
+            }
+            styledFonts = [:]
+            NotificationCenter.default.post(name: didChangeNotification, object: nil)
+        }
+    }
+
+    public static func setWeight(_ name: String?, owner: String) {
+        let weights: [String: UIFont.Weight] = ["light": .light, "regular": .regular, "medium": .medium, "semibold": .semibold, "bold": .bold]
+        DispatchQueue.main.async {
+            styledFonts = [:]
+            if let name, let weight = weights[name] {
+                regularWeight = weight == .regular ? nil : weight
+                weightOwner = owner
+            } else if weightOwner == owner {
+                regularWeight = nil
+                weightOwner = nil
+            }
+            NotificationCenter.default.post(name: didChangeNotification, object: nil)
+        }
+    }
+
+    public static func removeAll(owner: String) {
+        if weightOwner == owner {
+            setWeight(nil, owner: owner)
+            setStyle(nil, owner: owner)
+        }
+        lock.lock()
+        sizes = sizes.filter { $0.value.owner != owner }
+        lock.unlock()
+        NotificationCenter.default.post(name: didChangeNotification, object: nil)
+    }
+}
+
+/// Small decorations plugins put on avatars in the chat list (`ayu.ui.avatar.decorate`): one
+/// emoji in the bottom-right corner. Gone with the plugin.
+public enum AyuPluginAvatarDecorations {
+    public static let didChangeNotification = Notification.Name("AyuGram.AvatarDecorationsChanged")
+    private static let lock = NSLock()
+    private static var items: [Int64: (owner: String, emoji: String)] = [:]
+
+    public static func decoration(peerId: Int64) -> String? {
+        guard !AyuDecoyMode.isActive else { return nil }
+        lock.lock(); defer { lock.unlock() }
+        return items[peerId]?.emoji
+    }
+
+    public static func set(_ emoji: String?, peerId: Int64, owner: String) {
+        lock.lock()
+        if let emoji, !emoji.isEmpty {
+            items[peerId] = (owner, String(emoji.prefix(4)))
+        } else if items[peerId]?.owner == owner {
+            items[peerId] = nil
+        }
+        lock.unlock()
+        NotificationCenter.default.post(name: didChangeNotification, object: nil)
+    }
+
+    public static func removeAll(owner: String) {
+        lock.lock()
+        items = items.filter { $0.value.owner != owner }
+        lock.unlock()
+        NotificationCenter.default.post(name: didChangeNotification, object: nil)
+    }
+
+    /// Adds, updates or removes the corner label on an avatar view.
+    public static func apply(to view: UIView, peerId: Int64, diameter: CGFloat) {
+        let tag = 0x4159_5544
+        let emoji = decoration(peerId: peerId)
+        let existing = view.viewWithTag(tag) as? UILabel
+        guard let emoji else {
+            existing?.removeFromSuperview()
+            return
+        }
+        let label = existing ?? UILabel()
+        label.tag = tag
+        label.text = emoji
+        let size = max(14.0, floor(diameter * 0.36))
+        label.font = .systemFont(ofSize: size * 0.8)
+        label.textAlignment = .center
+        label.frame = CGRect(x: diameter - size + 2.0, y: diameter - size + 2.0, width: size, height: size)
+        if label.superview == nil {
+            view.addSubview(label)
+        }
+    }
+}
+
+/// A chat background colour or two-colour gradient set by a plugin (`ayu.ui.chatBackground.set`),
+/// drawn above the wallpaper and under the messages.
+public enum AyuPluginChatBackground {
+    public static let didChangeNotification = Notification.Name("AyuGram.PluginChatBackgroundChanged")
+    public private(set) static var colors: [UIColor] = []
+    public private(set) static var alpha: CGFloat = 1.0
+    private static var owner: String?
+
+    public static func set(_ colors: [UIColor], alpha: CGFloat, owner: String) {
+        DispatchQueue.main.async {
+            self.colors = Array(colors.prefix(2))
+            self.alpha = max(0.05, min(1.0, alpha))
+            self.owner = colors.isEmpty ? nil : owner
+            NotificationCenter.default.post(name: didChangeNotification, object: nil)
+        }
+    }
+
+    public static func removeAll(owner: String) {
+        DispatchQueue.main.async {
+            guard self.owner == owner else { return }
+            self.colors = []
+            self.owner = nil
+            NotificationCenter.default.post(name: didChangeNotification, object: nil)
+        }
+    }
+}
+
+/// The view for AyuPluginChatBackground, placed in the chat's wallpaper.
+public final class AyuPluginChatBackgroundView: UIView {
+    private let gradient = CAGradientLayer()
+    private var observer: NSObjectProtocol?
+
+    public override init(frame: CGRect) {
+        super.init(frame: frame)
+        self.isUserInteractionEnabled = false
+        self.autoresizingMask = [.flexibleWidth, .flexibleHeight]
+        self.layer.addSublayer(self.gradient)
+        self.observer = NotificationCenter.default.addObserver(forName: AyuPluginChatBackground.didChangeNotification, object: nil, queue: .main, using: { [weak self] _ in
+            self?.update()
+        })
+        self.update()
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    deinit {
+        if let observer = self.observer {
+            NotificationCenter.default.removeObserver(observer)
+        }
+    }
+
+    private func update() {
+        let colors = AyuDecoyMode.isActive ? [] : AyuPluginChatBackground.colors
+        self.isHidden = colors.isEmpty
+        self.gradient.colors = (colors.count == 1 ? [colors[0], colors[0]] : colors).map { $0.cgColor }
+        self.alpha = AyuPluginChatBackground.alpha
+    }
+
+    public override func layoutSubviews() {
+        super.layoutSubviews()
+        CATransaction.begin()
+        CATransaction.setDisableActions(true)
+        self.gradient.frame = self.bounds
+        CATransaction.commit()
+    }
+}
+
+/// Messages a plugin hides in chats (`ayu.chat.filter.set`): by words in the text or by author.
+public enum AyuPluginChatFilter {
+    private static let lock = NSLock()
+    private static var words: [String: [String]] = [:]
+    private static var authors: [String: Set<Int64>] = [:]
+    private static var matcher: NSRegularExpression?
+    private static var hiddenAuthors = Set<Int64>()
+    public static var isActive: Bool {
+        lock.lock(); defer { lock.unlock() }
+        return matcher != nil || !hiddenAuthors.isEmpty
+    }
+
+    public static func set(owner: String, words newWords: [String], authors newAuthors: [Int64]) {
+        lock.lock(); defer { lock.unlock() }
+        words[owner] = newWords.isEmpty ? nil : newWords.map { $0.lowercased() }.filter { !$0.isEmpty }
+        authors[owner] = newAuthors.isEmpty ? nil : Set(newAuthors)
+        hiddenAuthors = authors.values.reduce(into: Set<Int64>()) { $0.formUnion($1) }
+        let literals = Set(words.values.flatMap { $0 }).sorted().map { NSRegularExpression.escapedPattern(for: $0) }
+        matcher = literals.isEmpty ? nil : try? NSRegularExpression(pattern: literals.joined(separator: "|"))
+    }
+
+    public static func removeAll(owner: String) { set(owner: owner, words: [], authors: []) }
+
+    public static func hides(text: String, authorId: Int64?) -> Bool {
+        guard !AyuDecoyMode.isActive else { return false }
+        lock.lock()
+        let pattern = matcher
+        let isHiddenAuthor = authorId.map { hiddenAuthors.contains($0) } ?? false
+        lock.unlock()
+        if isHiddenAuthor { return true }
+        guard let pattern else { return false }
+        let lowered = text.lowercased()
+        return pattern.firstMatch(in: lowered, range: NSRange(lowered.startIndex..., in: lowered)) != nil
+    }
+}
