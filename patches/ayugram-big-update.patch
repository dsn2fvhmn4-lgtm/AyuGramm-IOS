+        }
+        AyuPluginPrivacy.shared.record(pluginId, api: op)
+        // Asynchronous calls answer with the "uiResult" event { requestId, choice }.
+        func answerLater(_ run: @escaping (@escaping (Any) -> Void) -> Void) -> Any? {
+            let requestId = string("requestId", 64)
+            run { value in
+                AyuPluginUI.send("uiResult", to: pluginId, ["requestId": requestId, "choice": value])
+            }
+            return ["ok": true]
+        }
+        switch op {
+        case "net.fetch":
+            guard allowed(.network) else { return nil }
+            let hosts = AyuScriptRuntime.shared.plugin(id: pluginId)?.connect ?? []
+            return answerLater { done in AyuPluginNetwork.fetch(pluginId: pluginId, hosts: hosts, args: args, completion: done) }
+        case "ai.complete":
+            guard allowed(.ai) else { return nil }
