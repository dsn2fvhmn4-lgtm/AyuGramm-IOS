diff --git a/submodules/TelegramUI/Sources/AyuHistoryNotifications.swift b/submodules/TelegramUI/Sources/AyuHistoryNotifications.swift
new file mode 100644
index 00000000..e7cca1c1
--- /dev/null
+++ b/submodules/TelegramUI/Sources/AyuHistoryNotifications.swift
@@ -0,0 +1,86 @@
+import Foundation
+import UIKit
+import UserNotifications
+import SwiftSignalKit
+import TelegramCore
+import TelegramUIPreferences
+import AccountContext
+import AppLock
+import Display
+
+func ayuNotifyHistoryEvent(context: AccountContext, info: [String: Any]) {
+    guard !AyuDecoyMode.isActive, info["notifyAllowed"] as? Bool == true, info["outgoing"] as? Bool != true,
+          let kind = info["kind"] as? String, kind == "deleted" || kind == "edited",
+          UserDefaults.standard.bool(forKey: kind == "deleted" ? "ayu.extra.notifyDeleted" : "ayu.extra.notifyEdited"),
+          let rawPeerId = (info["peerId"] as? String).flatMap(Int64.init),
+          let messageId = (info["messageId"] as? String).flatMap(Int32.init) else { return }
+    let peerId = EnginePeer.Id(rawPeerId)
+    guard peerId.namespace != Namespaces.Peer.SecretChat else { return }
+    let original = info["text"] as? String ?? ""
+    let settings = AyuLocalNotificationSettings()
+    guard settings.matches(original) else { return }
+    let locked = (context.sharedContext.appLockContext as? AppLockContextImpl).map { $0.isCurrentlyLocked |> take(1) } ?? .single(true)
+    let inApp = context.sharedContext.accountManager.sharedData(keys: [ApplicationSpecificSharedDataKeys.inAppNotificationSettings]) |> take(1) |> map { data in
+        data.entries[ApplicationSpecificSharedDataKeys.inAppNotificationSettings]?.get(InAppNotificationSettings.self) ?? .defaultSettings
+    }
+    let threadId = info["threadId"] as? Int64
+    let data = context.engine.data.get(
+        TelegramEngine.EngineData.Item.Peer.Peer(id: peerId),
+        TelegramEngine.EngineData.Item.Peer.NotificationSettings(id: peerId),
+        TelegramEngine.EngineData.Item.NotificationSettings.Global(),
+        TelegramEngine.EngineData.Item.Peer.ThreadNotificationSettings(id: peerId, threadId: threadId ?? 0)
+    )
+    let _ = (combineLatest(locked, inApp, data) |> deliverOnMainQueue).startStandalone(next: { isLocked, inApp, data in
+        guard !AyuDecoyMode.isActive,
+              UserDefaults.standard.bool(forKey: kind == "deleted" ? "ayu.extra.notifyDeleted" : "ayu.extra.notifyEdited") else { return }
+        let (peer, peerSettings, globalSettings, threadSettings) = data
+        guard let peer else { return }
+        let category: EngineGlobalNotificationSettings.CategorySettings
+        if peerId.namespace == Namespaces.Peer.CloudUser { category = globalSettings.privateChats }
+        else if case let .channel(channel) = peer, case .broadcast = channel.info { category = globalSettings.channels }
+        else { category = globalSettings.groupChats }
+        var enabled = category.enabled
+        var previews = category.displayPreviews
+        var sound = category.sound != .none
+        for override in threadId == nil ? [peerSettings] : [peerSettings, threadSettings] {
+            switch override.muteState {
+            case .default: break
+            case .unmuted: enabled = true
+            case let .muted(until): enabled = Int64(until) <= Int64(Date().timeIntervalSince1970)
+            }
+            switch override.displayPreviews {
+            case .default: break
+            case .show: previews = true
+            case .hide: previews = false
+            }
+            switch override.messageSound {
+            case .default: break
+            case .none: sound = false
+            default: sound = true
+            }
+        }
+        guard enabled else { return }
+        let ru = context.sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru")
+        let visible = !isLocked && previews && inApp.displayPreviews && inApp.displayNameOnLockscreen
+        let label = kind == "deleted" ? (ru ? "Сообщение удалено" : "Message deleted") : (ru ? "Сообщение изменено" : "Message edited")
+        let content = UNMutableNotificationContent()
+        content.title = visible ? peer.debugDisplayTitle + " · " + label : "AyuGram"
+        content.body = visible ? (original.isEmpty ? (ru ? "Медиа" : "Media") : String(original.prefix(300))) : label
+        content.sound = sound && !settings.isQuiet() ? .default : nil
+        content.threadIdentifier = settings.groupByChat ? "\(context.account.id.int64)_\(rawPeerId)" : ""
+        content.userInfo = ["accountId": context.account.id.int64, "peerId": rawPeerId, "messageId.namespace": Namespaces.Message.Cloud, "messageId.id": messageId]
+        if let threadId { content.userInfo["threadId"] = threadId }
+        let identifier = "ayu_\(kind)_\(context.account.id.int64)_\(rawPeerId)_\(messageId)"
+        if UIApplication.shared.applicationState == .active {
+            if visible { AyuToast.shared.show(label + " · " + peer.debugDisplayTitle) }
+        } else {
+            UNUserNotificationCenter.current().add(UNNotificationRequest(identifier: identifier, content: content, trigger: nil), withCompletionHandler: nil)
+        }
+    })
+}
+
+/// Recheck the app lock when an old notification action is used, not only when it is created.
+func ayuNotificationActionAllowed(sharedContext: SharedAccountContext) -> Signal<Bool, NoError> {
+    guard let lock = sharedContext.appLockContext as? AppLockContextImpl else { return .single(false) }
+    return lock.isCurrentlyLocked |> take(1) |> map { !($0 || AyuDecoyMode.isActive) }
+}
diff --git a/submodules/TelegramUI/Sources/AyuLocalTranscription.swift b/submodules/TelegramUI/Sources/AyuLocalTranscription.swift
new file mode 100644
index 00000000..d43d2f38
--- /dev/null
+++ b/submodules/TelegramUI/Sources/AyuLocalTranscription.swift
@@ -0,0 +1,68 @@
+import Foundation
+import Speech
+import SwiftSignalKit
+import ConvertOpusToAAC
+
+/// Voice-message transcription without Premium: the Opus file becomes AAC and Apple's speech
+/// recognizer reads it, on the device whenever the language supports that.
+enum AyuLocalTranscription {
+    enum Failure: Error {
+        case notAuthorized
+        case unsupportedLanguage
+        case conversion
+        case recognition(String)
+
+        func text(_ russian: Bool) -> String {
+            switch self {
+            case .notAuthorized: return russian ? "Разрешите распознавание речи: Настройки → AyuGram." : "Allow speech recognition in Settings → AyuGram."
+            case .unsupportedLanguage: return russian ? "Распознавание этого языка недоступно на устройстве." : "Speech recognition is not available for this language."
+            case .conversion: return russian ? "Не удалось подготовить аудио." : "The audio could not be prepared."
+            case let .recognition(message): return (russian ? "Не удалось распознать: " : "Recognition failed: ") + message
+            }
+        }
+    }
+
+    private static var tasks: [UUID: SFSpeechRecognitionTask] = [:]
+
+    static func transcribe(path: String, languageCode: String, completion: @escaping (Result<String, Failure>) -> Void) {
+        SFSpeechRecognizer.requestAuthorization { status in
+            guard status == .authorized else {
+                return DispatchQueue.main.async { completion(.failure(.notAuthorized)) }
+            }
+            let localeId = languageCode.hasPrefix("ru") ? "ru-RU" : (languageCode.hasPrefix("uk") ? "uk-UA" : Locale.current.identifier)
+            guard let recognizer = SFSpeechRecognizer(locale: Locale(identifier: localeId)) ?? SFSpeechRecognizer(), recognizer.isAvailable else {
+                return DispatchQueue.main.async { completion(.failure(.unsupportedLanguage)) }
+            }
+            let _ = (convertOpusToAAC(sourcePath: path, allocateTempFile: {
+                return NSTemporaryDirectory() + "ayu-transcribe-\(UUID().uuidString).m4a"
+            })
+            |> deliverOnMainQueue).startStandalone(next: { output in
+                guard let output else {
+                    return completion(.failure(.conversion))
+                }
+                let request = SFSpeechURLRecognitionRequest(url: URL(fileURLWithPath: output))
+                request.shouldReportPartialResults = false
+                if recognizer.supportsOnDeviceRecognition {
+                    request.requiresOnDeviceRecognition = true
+                }
+                let id = UUID()
+                tasks[id] = recognizer.recognitionTask(with: request, resultHandler: { result, error in
+                    if let result, result.isFinal {
+                        let text = result.bestTranscription.formattedString
+                        DispatchQueue.main.async {
+                            tasks[id] = nil
+                            try? FileManager.default.removeItem(atPath: output)
+                            completion(.success(text))
+                        }
+                    } else if let error {
+                        DispatchQueue.main.async {
+                            tasks[id] = nil
+                            try? FileManager.default.removeItem(atPath: output)
+                            completion(.failure(.recognition(error.localizedDescription)))
+                        }
+                    }
+                })
+            })
+        }
+    }
+}
