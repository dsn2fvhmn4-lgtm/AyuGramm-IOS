@@ -0,0 +1,50 @@
+import Foundation
+
+/// Local bookmarks of messages with tags ("read later", "recipes"…). This device only.
+public enum AyuBookmarks {
+    public struct Bookmark: Codable, Equatable {
+        public let peerId: Int64
+        public let messageId: Int32
+        public let text: String
+        public let chatTitle: String
+        public let savedAt: Int64
+        public var tag: String
+
+        public init(peerId: Int64, messageId: Int32, text: String, chatTitle: String, savedAt: Int64, tag: String) {
+            self.peerId = peerId
+            self.messageId = messageId
+            self.text = text
+            self.chatTitle = chatTitle
+            self.savedAt = savedAt
+            self.tag = tag
+        }
+    }
+
+    public static let didChangeNotification = Notification.Name("AyuGram.BookmarksChanged")
+    private static let key = "ayu.bookmarks"
+
+    public static var all: [Bookmark] {
+        get {
+            guard let data = UserDefaults.standard.data(forKey: key), let value = try? JSONDecoder().decode([Bookmark].self, from: data) else { return [] }
+            return value
+        }
+        set {
+            UserDefaults.standard.set(try? JSONEncoder().encode(Array(newValue.prefix(1000))), forKey: key)
+            NotificationCenter.default.post(name: didChangeNotification, object: nil)
+        }
+    }
+
+    public static func add(_ bookmark: Bookmark) {
+        var items = all.filter { !($0.peerId == bookmark.peerId && $0.messageId == bookmark.messageId) }
+        items.insert(bookmark, at: 0)
+        all = items
+    }
+
+    public static var tags: [String] {
+        var seen: [String] = []
+        for item in all where !item.tag.isEmpty && !seen.contains(item.tag) {
+            seen.append(item.tag)
+        }
+        return seen
+    }
+}
