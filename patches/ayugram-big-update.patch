+
+func ayuToolsController(context: AccountContext) -> ViewController {
+    var push: ((ViewController) -> Void)?
+    var navigation: (() -> NavigationController?)?
+
+    func ask(_ title: String, _ message: String, _ current: String, secure: Bool, _ save: @escaping (String) -> Void) {
+        let ru = context.sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru")
+        let alert = UIAlertController(title: title, message: message, preferredStyle: .alert)
+        alert.addTextField { field in
+            field.text = current
+            field.isSecureTextEntry = secure
+            field.autocapitalizationType = .none
+            field.autocorrectionType = .no
+        }
+        alert.addAction(UIAlertAction(title: ru ? "Отмена" : "Cancel", style: .cancel))
+        alert.addAction(UIAlertAction(title: ru ? "Сохранить" : "Save", style: .default, handler: { [weak alert] _ in
+            save(alert?.textFields?.first?.text ?? "")
+        }))
+        context.sharedContext.applicationBindings.presentNativeController(alert)
+    }
+
+    func choose<T>(_ title: String, _ items: [T], _ current: T, _ name: @escaping (T) -> String, _ isSame: @escaping (T, T) -> Bool, _ pick: @escaping (T) -> Void) {
+        let ru = context.sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru")
+        let sheet = UIAlertController(title: title, message: nil, preferredStyle: .actionSheet)
+        for item in items {
+            sheet.addAction(UIAlertAction(title: name(item) + (isSame(item, current) ? " ✓" : ""), style: .default, handler: { _ in pick(item) }))
+        }
+        sheet.addAction(UIAlertAction(title: ru ? "Отмена" : "Cancel", style: .cancel))
+        context.sharedContext.applicationBindings.presentNativeController(sheet)
+    }
+
+    let arguments = AyuSectionedArguments(open: { id in
+        let ru = context.sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru")
+        switch AyuToolsRow(rawValue: id) {
+        case .virusTotalKey?:
