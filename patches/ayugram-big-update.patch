new file mode 100644
index 00000000..f2d7892f
--- /dev/null
+++ b/submodules/TelegramUI/Sources/AyuToast.swift
@@ -0,0 +1,58 @@
+import Foundation
+import UIKit
+
+/// Minimal non-interactive toast for host messages (plugin `ayu.toast`, runtime notices).
+/// One at a time; a new message replaces the visible one.
+final class AyuToast {
+    static let shared = AyuToast()
+
+    private weak var container: UIView?
+    private weak var current: UIView?
+
+    private init() {}
+
+    func attach(to container: UIView) {
+        self.container = container
+    }
+
+    func show(_ text: String) {
+        guard let container = self.container, !text.isEmpty else { return }
+        self.current?.removeFromSuperview()
+
+        let label = UILabel()
+        label.text = text
+        label.numberOfLines = 3
+        label.textAlignment = .center
+        label.font = .systemFont(ofSize: 14.0, weight: .medium)
+        label.textColor = .white
+
+        let view = UIView()
+        view.isUserInteractionEnabled = false
+        view.backgroundColor = UIColor(white: 0.1, alpha: 0.88)
+        view.layer.cornerRadius = 14.0
+        view.addSubview(label)
+
+        let maxWidth = min(360.0, container.bounds.width - 40.0)
+        let size = label.sizeThatFits(CGSize(width: maxWidth - 28.0, height: .greatestFiniteMagnitude))
+        let width = min(maxWidth, ceil(size.width) + 28.0)
+        let height = ceil(size.height) + 20.0
+        let top = max(container.safeAreaInsets.top, 20.0) + 8.0
+        view.frame = CGRect(x: floor((container.bounds.width - width) / 2.0), y: top, width: width, height: height)
+        label.frame = view.bounds.insetBy(dx: 14.0, dy: 10.0)
+        view.autoresizingMask = [.flexibleLeftMargin, .flexibleRightMargin, .flexibleBottomMargin]
+        container.addSubview(view)
+        self.current = view
+
+        view.alpha = 0.0
+        view.transform = CGAffineTransform(translationX: 0.0, y: -12.0)
+        UIView.animate(withDuration: 0.25, delay: 0.0, usingSpringWithDamping: 0.85, initialSpringVelocity: 0.0, options: [.beginFromCurrentState], animations: {
+            view.alpha = 1.0
+            view.transform = .identity
+        })
+        UIView.animate(withDuration: 0.25, delay: 2.6, options: [.beginFromCurrentState], animations: {
+            view.alpha = 0.0
+        }, completion: { [weak view] _ in
+            view?.removeFromSuperview()
+        })
+    }
+}
