index 00000000..9d50fda7
--- /dev/null
+++ b/submodules/TelegramUI/Sources/AyuProfanityBleep.swift
@@ -0,0 +1,136 @@
+import Foundation
+import AVFoundation
+import SwiftSignalKit
+import Display
+import AccountContext
+import OpusBinding
+
+/// "Bleep profanity" for voice messages: the recording is decoded, words are recognised on the
+/// device with their timestamps, swear words are replaced by a 1 kHz beep (or silence), and the
+/// audio is encoded again. If recognition is unavailable the original recording is sent.
+enum AyuProfanityBleep {
+    static func process(_ data: RecordedAudioData) -> Signal<RecordedAudioData?, NoError> {
+        let mode = AyuMediaSettings.bleep
+        let equalizer = AyuMediaSettings.voiceEqualizer
+        let equalized = equalizer.contains(where: { abs($0) > 0.01 })
+        guard mode != .off || equalized else { return .single(data) }
+        return Signal { subscriber in
+            let url = FileManager.default.temporaryDirectory.appendingPathComponent("ayu_bleep_\(Int64.random(in: 1 ... Int64.max)).ogg")
+            guard (try? data.compressedData.write(to: url)) != nil, let samples = decode(path: url.path) else {
+                try? FileManager.default.removeItem(at: url)
+                subscriber.putNext(data)
+                subscriber.putCompletion()
+                return EmptyDisposable
+            }
+            try? FileManager.default.removeItem(at: url)
+            let finish: ([Range<Double>]) -> Void = { ranges in
+                guard !ranges.isEmpty || equalized else {
+                    subscriber.putNext(data)
+                    subscriber.putCompletion()
+                    return
+                }
+                var edited = equalized ? applyEqualizer(samples, gains: equalizer) : samples
+                AyuSpeechBleep.cover(&edited, ranges: ranges, sampleRate: 16000.0, beep: mode == .beep)
+                if let encoded = encode(edited) {
+                    subscriber.putNext(RecordedAudioData(compressedData: encoded, resumeData: nil, duration: data.duration, waveform: data.waveform, trimRange: data.trimRange))
+                } else {
+                    subscriber.putNext(data)
+                }
+                subscriber.putCompletion()
+            }
+            if mode == .off {
+                finish([])
+            } else {
+                AyuSpeechBleep.recognize(samples, completion: finish)
+            }
+            return EmptyDisposable
+        }
+        |> runOn(Queue.concurrentDefaultQueue())
+        |> timeout(30.0, queue: .concurrentDefaultQueue(), alternate: .single(data))
+    }
+
+    /// Three bands at 16 kHz: low shelf 250 Hz, peak 1 kHz, high shelf 4 kHz (RBJ biquads).
+    private static func applyEqualizer(_ samples: [Int16], gains: [Double]) -> [Int16] {
+        struct Biquad {
+            var b0, b1, b2, a1, a2: Double
+            var x1 = 0.0, x2 = 0.0, y1 = 0.0, y2 = 0.0
+            mutating func run(_ x: Double) -> Double {
+                let y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2
+                x2 = x1; x1 = x; y2 = y1; y1 = y
+                return y
+            }
+        }
+        func make(kind: Int, frequency: Double, gain: Double) -> Biquad {
+            let a = pow(10.0, gain / 40.0)
+            let w = 2.0 * .pi * frequency / 16000.0
+            let cosw = cos(w)
+            let alpha = sin(w) / 2.0 * sqrt(2.0)
+            var b0 = 1.0, b1 = 0.0, b2 = 0.0, a0 = 1.0, a1 = 0.0, a2 = 0.0
+            switch kind {
+            case 0:
+                let s = 2.0 * sqrt(a) * alpha
+                b0 = a * ((a + 1) - (a - 1) * cosw + s); b1 = 2 * a * ((a - 1) - (a + 1) * cosw); b2 = a * ((a + 1) - (a - 1) * cosw - s)
+                a0 = (a + 1) + (a - 1) * cosw + s; a1 = -2 * ((a - 1) + (a + 1) * cosw); a2 = (a + 1) + (a - 1) * cosw - s
+            case 1:
+                b0 = 1 + alpha * a; b1 = -2 * cosw; b2 = 1 - alpha * a
+                a0 = 1 + alpha / a; a1 = -2 * cosw; a2 = 1 - alpha / a
+            default:
+                let s = 2.0 * sqrt(a) * alpha
+                b0 = a * ((a + 1) + (a - 1) * cosw + s); b1 = -2 * a * ((a - 1) + (a + 1) * cosw); b2 = a * ((a + 1) + (a - 1) * cosw - s)
+                a0 = (a + 1) - (a - 1) * cosw + s; a1 = 2 * ((a - 1) - (a + 1) * cosw); a2 = (a + 1) - (a - 1) * cosw - s
+            }
+            return Biquad(b0: b0 / a0, b1: b1 / a0, b2: b2 / a0, a1: a1 / a0, a2: a2 / a0)
+        }
+        var filters = [make(kind: 0, frequency: 250.0, gain: gains[0]), make(kind: 1, frequency: 1000.0, gain: gains[1]), make(kind: 2, frequency: 4000.0, gain: gains[2])]
+        return samples.map { sample in
+            var value = Double(sample)
+            for index in filters.indices {
+                value = filters[index].run(value)
+            }
+            return Int16(max(-32768.0, min(32767.0, value)))
+        }
+    }
+
+    /// 48 kHz Opus decoder output averaged down to 16 kHz mono.
+    private static func decode(path: String) -> [Int16]? {
+        guard let reader = OggOpusReader(path: path) else { return nil }
+        var result: [Int16] = []
+        var buffer = [Int16](repeating: 0, count: 5760)
+        while true {
+            // op_read takes the buffer size in samples, not bytes.
+            let capacity = Int32(buffer.count)
+            let read = buffer.withUnsafeMutableBytes { raw in
+                reader.read(raw.baseAddress!, bufSize: capacity)
+            }
+            if read <= 0 { break }
+            let count = Int(read)
+            var index = 0
+            while index + 2 < count {
+                result.append(Int16((Int(buffer[index]) + Int(buffer[index + 1]) + Int(buffer[index + 2])) / 3))
+                index += 3
+            }
+        }
+        return result.isEmpty ? nil : result
+    }
+
+    private static func encode(_ samples: [Int16]) -> Data? {
+        let packet = 960
+        let dataItem = TGDataItem()
+        let writer = TGOggOpusWriter()
+        guard writer.begin(with: dataItem) else { return nil }
+        var offset = 0
+        while offset < samples.count {
+            var chunk = Array(samples[offset ..< min(offset + packet, samples.count)])
+            if chunk.count < packet {
+                chunk.append(contentsOf: [Int16](repeating: 0, count: packet - chunk.count))
+            }
+            chunk.withUnsafeMutableBytes { raw in
+                _ = writer.writeFrame(raw.bindMemory(to: UInt8.self).baseAddress, frameByteCount: UInt(raw.count))
+            }
+            offset += packet
+        }
+        guard writer.writeFrame(nil, frameByteCount: 0) else { return nil }
+        return dataItem.data()
+    }
+
+}
