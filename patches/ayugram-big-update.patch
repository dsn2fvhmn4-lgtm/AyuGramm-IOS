+++ b/submodules/AccountContext/Sources/AyuLastFM.swift
@@ -0,0 +1,119 @@
+import Foundation
+import CryptoKit
+import Display
+
+/// Last.fm scrobbling for the music player, with the user's own API account
+/// (last.fm/api/account/create). Keys and the session live in the Keychain.
+/// "Now playing" is sent when a track starts; a track is scrobbled once it has played for half
+/// its length or four minutes, whichever comes first (Last.fm's rule), and is longer than 30 s.
+public enum AyuLastFM {
+    private static let endpoint = URL(string: "https://ws.audioscrobbler.com/2.0/")!
+    private static let usernameKey = "ayu.lastfm.username"
+
+    private struct Track {
+        let title: String
+        let artist: String
+        let duration: Double
+        let startedAt: Int
+        let session: String
+        var played: Double
+        var lastPosition: Double
+        var scrobbled: Bool
+    }
+
+    private static var current: Track?
+
+    public static var username: String? {
+        return UserDefaults.standard.string(forKey: usernameKey)
+    }
+
+    public static var isConnected: Bool {
+        // Called on every player tick: a UserDefaults read, not a Keychain query.
+        return UserDefaults.standard.string(forKey: usernameKey) != nil
+    }
+
+    private static func signature(_ params: [String: String], secret: String) -> String {
+        let base = params.keys.sorted().map { $0 + params[$0]! }.joined() + secret
+        return Insecure.MD5.hash(data: Data(base.utf8)).map { String(format: "%02x", $0) }.joined()
+    }
+
+    private static func call(_ params: [String: String], completion: (([String: Any]?) -> Void)? = nil) {
+        guard let apiKey = AyuKeychain.get("lastfm.apiKey"), let secret = AyuKeychain.get("lastfm.secret") else {
+            completion?(nil)
+            return
+        }
+        var params = params
+        params["api_key"] = apiKey
+        params["api_sig"] = signature(params, secret: secret)
+        params["format"] = "json"
+        var request = URLRequest(url: endpoint)
+        request.httpMethod = "POST"
+        request.timeoutInterval = 20.0
+        request.setValue("application/x-www-form-urlencoded", forHTTPHeaderField: "Content-Type")
+        var allowed = CharacterSet.alphanumerics
+        allowed.insert(charactersIn: "-._~")
+        request.httpBody = params.map { key, value in
+            key + "=" + (value.addingPercentEncoding(withAllowedCharacters: allowed) ?? "")
+        }.joined(separator: "&").data(using: .utf8)
+        URLSession.shared.dataTask(with: request, completionHandler: { data, _, _ in
+            let json = data.flatMap { try? JSONSerialization.jsonObject(with: $0) as? [String: Any] }
+            DispatchQueue.main.async {
+                completion?(json)
+            }
+        }).resume()
+    }
+
+    /// Signs in with the user's API key, secret, Last.fm username and password. The password
+    /// is used once to get a session key and is not stored.
+    public static func connect(apiKey: String, secret: String, username: String, password: String, completion: @escaping (String?) -> Void) {
+        let _ = AyuKeychain.set("lastfm.apiKey", apiKey.trimmingCharacters(in: .whitespaces))
+        let _ = AyuKeychain.set("lastfm.secret", secret.trimmingCharacters(in: .whitespaces))
+        call(["method": "auth.getMobileSession", "username": username, "password": password], completion: { json in
+            if let session = (json?["session"] as? [String: Any])?["key"] as? String {
+                let _ = AyuKeychain.set("lastfm.session", session)
+                UserDefaults.standard.set(username, forKey: usernameKey)
+                completion(nil)
+            } else {
+                completion((json?["message"] as? String) ?? "Last.fm did not answer")
+            }
+        })
+    }
+
+    public static func disconnect() {
+        let _ = AyuKeychain.set("lastfm.session", nil)
+        let _ = AyuKeychain.set("lastfm.apiKey", nil)
+        let _ = AyuKeychain.set("lastfm.secret", nil)
+        UserDefaults.standard.removeObject(forKey: usernameKey)
+        current = nil
+    }
+
+    public static func trackChanged(title: String, artist: String?, duration: Double) {
+        guard isConnected, !AyuDecoyMode.isActive, let session = AyuKeychain.get("lastfm.session") else { return }
+        guard let artist, !artist.isEmpty, !title.isEmpty else {
+            current = nil
+            return
+        }
+        current = Track(title: title, artist: artist, duration: duration, startedAt: Int(Date().timeIntervalSince1970), session: session, played: 0.0, lastPosition: 0.0, scrobbled: false)
+        var params = ["method": "track.updateNowPlaying", "track": title, "artist": artist, "sk": session]
+        if duration > 0 {
+            params["duration"] = String(Int(duration))
+        }
+        call(params)
+    }
+
+    /// Counts only real listening: jumps forward by seeking do not add to the played time.
+    public static func progress(position: Double, playing: Bool) {
+        guard var track = current, !track.scrobbled else { return }
+        let delta = position - track.lastPosition
+        if playing, delta > 0, delta < 3.0 {
+            track.played += delta
+        }
+        track.lastPosition = position
+        let needed = min(240.0, track.duration / 2.0)
+        if track.duration > 30.0, track.played >= needed {
+            track.scrobbled = true
+            call(["method": "track.scrobble", "track": track.title, "artist": track.artist, "timestamp": String(track.startedAt), "sk": track.session, "duration": String(Int(track.duration))])
+        }
+        current = track
+    }
+}
diff --git a/submodules/AccountContext/Sources/AyuMediaProcessing.swift b/submodules/AccountContext/Sources/AyuMediaProcessing.swift
new file mode 100644
index 00000000..95f39830
--- /dev/null
+++ b/submodules/AccountContext/Sources/AyuMediaProcessing.swift
@@ -0,0 +1,68 @@
+import Foundation
+import UIKit
+import CoreImage
+
+/// The Media Processing API (`ayu.media.process`): on-device image operations for plugins, done
+/// with Core Image off the main thread. Input and output are base64 JPEG/PNG, up to 8 MB in and a
+/// 4096 px side.
+public enum AyuMediaProcessing {
+    public static let maxInputBytes = 8 * 1024 * 1024
+    private static let context = CIContext(options: [.useSoftwareRenderer: false])
+
+    /// `ops`: [{op: "filter", name: "mono"|"sepia"|"noir"|"chrome"|"fade"|"instant"|"invert"|"blur"|"sharpen"|"vignette"|"pixellate", amount?}
+    ///        {op: "resize", maxSide}, {op: "cropSquare"}, {op: "rotate", degrees}, {op: "brightness", amount},
+    ///        {op: "contrast", amount}, {op: "saturation", amount}]
+    public static func process(_ data: Data, ops: [[String: Any]], format: String, quality: Double) -> Data? {
+        guard data.count <= maxInputBytes, var image = CIImage(data: data, options: [.applyOrientationProperty: true]) else { return nil }
+        for op in ops.prefix(16) {
+            let amount = (op["amount"] as? NSNumber)?.doubleValue
+            switch op["op"] as? String {
+            case "filter":
+                image = filter(image, name: op["name"] as? String ?? "", amount: amount)
+            case "resize":
+                let maxSide = max(16.0, min(4096.0, (op["maxSide"] as? NSNumber)?.doubleValue ?? 1280.0))
+                let side = max(image.extent.width, image.extent.height)
+                if side > maxSide {
+                    let scale = maxSide / side
+                    image = image.transformed(by: CGAffineTransform(scaleX: scale, y: scale))
+                }
+            case "cropSquare":
+                let extent = image.extent
+                let side = min(extent.width, extent.height)
+                image = image.cropped(to: CGRect(x: extent.midX - side / 2.0, y: extent.midY - side / 2.0, width: side, height: side))
+            case "rotate":
+                let radians = CGFloat((op["degrees"] as? NSNumber)?.doubleValue ?? 90.0) * .pi / 180.0
+                image = image.transformed(by: CGAffineTransform(rotationAngle: -radians))
+            case "brightness", "contrast", "saturation":
+                let key = op["op"] as? String == "brightness" ? kCIInputBrightnessKey : (op["op"] as? String == "contrast" ? kCIInputContrastKey : kCIInputSaturationKey)
+                let defaultValue = key == kCIInputBrightnessKey ? 0.0 : 1.0
+                image = image.applyingFilter("CIColorControls", parameters: [key: amount ?? defaultValue])
+            default:
+                continue
+            }
+        }
+        let extent = image.extent.integral
+        guard extent.width >= 1, extent.height >= 1, extent.width <= 8192, extent.height <= 8192 else { return nil }
+        image = image.transformed(by: CGAffineTransform(translationX: -extent.minX, y: -extent.minY))
+        guard let cgImage = context.createCGImage(image, from: CGRect(origin: .zero, size: extent.size)) else { return nil }
+        let result = UIImage(cgImage: cgImage)
+        return format == "png" ? result.pngData() : result.jpegData(compressionQuality: CGFloat(max(0.1, min(1.0, quality))))
+    }
+
+    private static func filter(_ image: CIImage, name: String, amount: Double?) -> CIImage {
+        switch name {
+        case "mono": return image.applyingFilter("CIPhotoEffectMono")
+        case "noir": return image.applyingFilter("CIPhotoEffectNoir")
+        case "chrome": return image.applyingFilter("CIPhotoEffectChrome")
+        case "fade": return image.applyingFilter("CIPhotoEffectFade")
+        case "instant": return image.applyingFilter("CIPhotoEffectInstant")
+        case "sepia": return image.applyingFilter("CISepiaTone", parameters: [kCIInputIntensityKey: amount ?? 0.8])
+        case "invert": return image.applyingFilter("CIColorInvert")
+        case "blur": return image.clampedToExtent().applyingFilter("CIGaussianBlur", parameters: [kCIInputRadiusKey: max(0.0, min(50.0, amount ?? 8.0))]).cropped(to: image.extent)
+        case "sharpen": return image.applyingFilter("CISharpenLuminance", parameters: [kCIInputSharpnessKey: amount ?? 0.6])
+        case "vignette": return image.applyingFilter("CIVignette", parameters: [kCIInputIntensityKey: amount ?? 1.0, kCIInputRadiusKey: 1.5])
+        case "pixellate": return image.applyingFilter("CIPixellate", parameters: [kCIInputScaleKey: max(2.0, min(100.0, amount ?? 12.0))]).cropped(to: image.extent)
+        default: return image
+        }
+    }
+}
diff --git a/submodules/AccountContext/Sources/AyuPluginAppBridge.swift b/submodules/AccountContext/Sources/AyuPluginAppBridge.swift
new file mode 100644
index 00000000..223c7092
