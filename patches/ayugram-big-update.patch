+import Foundation
+import UIKit
+import Display
+import TelegramCore
+
+// AyuGram Customization: the user's colours on top of whatever theme is active.
+
+private let ayuCustomLock = NSLock()
+/// (input theme, revision, output theme); the input is held so its identity cannot be reused.
+private var ayuCustomThemes: [(input: PresentationTheme, revision: Int, output: PresentationTheme)] = []
+
+private func ayuBubble(_ components: PresentationThemeBubbleColorComponents, fill: UIColor) -> PresentationThemeBubbleColorComponents {
+    return PresentationThemeBubbleColorComponents(
+        fill: [fill],
+        highlightedFill: fill.withMultipliedBrightnessBy(0.9),
+        stroke: components.stroke,
+        shadow: components.shadow,
+        reactionInactiveBackground: components.reactionInactiveBackground,
+        reactionInactiveForeground: components.reactionInactiveForeground,
+        reactionActiveBackground: components.reactionActiveBackground,
+        reactionActiveForeground: components.reactionActiveForeground,
+        reactionStarsInactiveBackground: components.reactionStarsInactiveBackground,
+        reactionStarsInactiveForeground: components.reactionStarsInactiveForeground,
+        reactionStarsActiveBackground: components.reactionStarsActiveBackground,
+        reactionStarsActiveForeground: components.reactionStarsActiveForeground,
+        reactionInactiveMediaPlaceholder: components.reactionInactiveMediaPlaceholder,
+        reactionActiveMediaPlaceholder: components.reactionActiveMediaPlaceholder
+    )
+}
+
+private func ayuParted(_ colors: PresentationThemePartedColors, fill: UIColor?, text: UIColor?) -> PresentationThemePartedColors {
+    var bubble: PresentationThemeBubbleColor?
+    if let fill {
+        bubble = colors.bubble.withUpdated(withWallpaper: ayuBubble(colors.bubble.withWallpaper, fill: fill), withoutWallpaper: ayuBubble(colors.bubble.withoutWallpaper, fill: fill))
+    }
+    return colors.withUpdated(bubble: bubble, primaryTextColor: text, secondaryTextColor: text?.withAlphaComponent(0.6), linkTextColor: nil)
+}
+
+private func ayuApplyCustomization(_ theme: PresentationTheme) -> PresentationTheme {
+    var result = theme
+    if let accent = AyuCustomization.color(.accent) {
+        result = customizePresentationTheme(result, editing: false, accentColor: accent, outgoingAccentColor: nil, backgroundColors: [], bubbleColors: [], animateBubbleColors: nil)
+    }
+    let outgoingFill = AyuCustomization.color(.outgoingBubble)
+    let outgoingText = AyuCustomization.color(.outgoingText)
+    let incomingFill = AyuCustomization.color(.incomingBubble)
+    let incomingText = AyuCustomization.color(.incomingText)
+    if outgoingFill != nil || outgoingText != nil || incomingFill != nil || incomingText != nil {
+        let message = result.chat.message
+        let updated = message.withUpdated(
+            incoming: (incomingFill != nil || incomingText != nil) ? ayuParted(message.incoming, fill: incomingFill, text: incomingText) : nil,
+            outgoing: (outgoingFill != nil || outgoingText != nil) ? ayuParted(message.outgoing, fill: outgoingFill, text: outgoingText) : nil
+        )
+        let chat = result.chat.withUpdated(message: updated)
+        result = PresentationTheme(name: result.name, index: result.index, referenceTheme: result.referenceTheme, overallDarkAppearance: result.overallDarkAppearance, intro: result.intro, passcode: result.passcode, rootController: result.rootController, list: result.list, chatList: result.chatList, chat: chat, actionSheet: result.actionSheet, contextMenu: result.contextMenu, inAppNotification: result.inAppNotification, chart: result.chart, preview: result.preview)
+    }
+    let listBackground = AyuCustomization.color(.listBackground)
+    let chatTitle = AyuCustomization.color(.chatTitle)
+    if listBackground != nil || chatTitle != nil {
+        let list = listBackground.map { result.list.withUpdated(blocksBackgroundColor: $0, plainBackgroundColor: $0) } ?? result.list
+        let chatList = result.chatList.withUpdated(backgroundColor: listBackground, titleColor: chatTitle)
+        result = PresentationTheme(name: result.name, index: result.index, referenceTheme: result.referenceTheme, overallDarkAppearance: result.overallDarkAppearance, intro: result.intro, passcode: result.passcode, rootController: result.rootController, list: list, chatList: chatList, chat: result.chat, actionSheet: result.actionSheet, contextMenu: result.contextMenu, inAppNotification: result.inAppNotification, chart: result.chart, preview: result.preview)
+    }
+    // AyuGlass "Glass settings and profile": an accent-tinted backdrop under translucent,
+    // frosted-looking panels.
+    if AyuGlass.lists {
+        let dark = result.overallDarkAppearance
+        let accent = result.list.itemAccentColor
+        let backdrop = dark ? accent.withMultipliedBrightnessBy(0.18) : accent.mixedWith(.white, alpha: 0.85)
+        let panel = dark ? UIColor(white: 1.0, alpha: 0.09) : UIColor(white: 1.0, alpha: 0.62)
+        let separator = dark ? UIColor(white: 1.0, alpha: 0.12) : UIColor(white: 0.0, alpha: 0.08)
+        let list = result.list.withUpdated(blocksBackgroundColor: backdrop, modalBlocksBackgroundColor: backdrop, itemBlocksBackgroundColor: panel, itemModalBlocksBackgroundColor: panel, itemBlocksSeparatorColor: separator)
+        result = PresentationTheme(name: result.name, index: result.index, referenceTheme: result.referenceTheme, overallDarkAppearance: result.overallDarkAppearance, intro: result.intro, passcode: result.passcode, rootController: result.rootController, list: list, chatList: result.chatList, chat: result.chat, actionSheet: result.actionSheet, contextMenu: result.contextMenu, inAppNotification: result.inAppNotification, chart: result.chart, preview: result.preview)
+    }
+    return result
+}
+
+/// The theme with the user's colours, cached per input theme and settings revision.
+func ayuCustomizedTheme(_ theme: PresentationTheme) -> PresentationTheme {
+    guard AyuCustomization.hasColors || AyuGlass.lists else {
+        return theme
+    }
+    let revision = AyuCustomization.revision * 2 + (AyuGlass.lists ? 1 : 0)
+    ayuCustomLock.lock()
+    defer { ayuCustomLock.unlock() }
+    if let cached = ayuCustomThemes.first(where: { ($0.input === theme || $0.output === theme) && $0.revision == revision }) {
+        return cached.output
+    }
+    let output = ayuApplyCustomization(theme)
+    ayuCustomThemes.append((theme, revision, output))
+    if ayuCustomThemes.count > 6 {
+        ayuCustomThemes.removeFirst(ayuCustomThemes.count - 6)
+    }
+    return output
+}
+
+/// The chat background the user picked: a colour or a two-colour gradient.
+func ayuCustomWallpaper() -> TelegramWallpaper? {
+    guard let first = AyuCustomization.rgb(.wallpaper) else {
+        return nil
+    }
+    if let second = AyuCustomization.rgb(.wallpaperSecond) {
+        return .gradient(TelegramWallpaper.Gradient(id: nil, colors: [first, second], settings: WallpaperSettings()))
+    }
+    return .color(first)
+}
