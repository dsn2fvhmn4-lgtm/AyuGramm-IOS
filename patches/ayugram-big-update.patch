+    public func title(_ russian: Bool) -> String {
+        switch self {
+        case .ui: return russian ? "окна и диалоги" : "alerts and sheets"
+        case .menu: return russian ? "пункты в меню сообщений" : "message menu items"
+        case .profile: return russian ? "блоки и кнопки в профиле" : "profile blocks and buttons"
+        case .overlay: return russian ? "эффекты поверх приложения" : "overlays over the app"
+        case .fonts: return russian ? "размер шрифтов" : "font sizes"
+        case .badges: return russian ? "бейджи у чатов" : "chat badges"
+        case .clipboard: return russian ? "буфер обмена (запись)" : "clipboard (write)"
+        case .device: return russian ? "сведения об устройстве" : "device information"
+        case .haptics: return russian ? "вибрация" : "haptics"
+        case .network: return russian ? "интернет (только домены из @connect)" : "network (@connect hosts only)"
+        case .messages: return russian ? "отправка, правка и реакции от вашего имени" : "send, edit and react as you"
+        case .messagesRead: return russian ? "⚠️ чтение ваших сообщений" : "⚠️ reading your messages"
+        case .ai: return russian ? "запросы к вашему ИИ" : "requests to your AI service"
+        case .secrets: return russian ? "секреты в Keychain" : "Keychain secrets"
+        case .composer: return russian ? "кнопки над клавиатурой" : "buttons above the keyboard"
+        case .notifications: return russian ? "текст уведомлений" : "notification text"
+        case .links: return russian ? "переписывание ссылок" : "link rewriting"
+        case .screens: return russian ? "свои страницы" : "custom pages"
+        case .commands: return russian ? "точечные команды (.calc)" : "dot commands (.calc)"
+        }
+    }
+
+    public static func parse(_ text: String) -> [String] {
+        return text.split(whereSeparator: { $0 == "," || $0 == " " }).map { $0.lowercased() }.filter { AyuPluginPermission(rawValue: $0) != nil }
+    }
+}
