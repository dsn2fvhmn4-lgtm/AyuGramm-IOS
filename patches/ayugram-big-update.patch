diff --git a/submodules/TelegramCore/Tests/AyuAccountArchiveTests.swift b/submodules/TelegramCore/Tests/AyuAccountArchiveTests.swift
new file mode 100644
index 00000000..14880db1
--- /dev/null
+++ b/submodules/TelegramCore/Tests/AyuAccountArchiveTests.swift
@@ -0,0 +1,60 @@
+import Foundation
+import XCTest
+import SwiftSignalKit
+@testable import TelegramCore
+
+final class AyuAccountArchiveTests: XCTestCase {
+    private var path: String!
+    private var manager: AccountManager<TelegramAccountManagerTypes>!
+
+    override func setUp() {
+        super.setUp()
+        self.path = NSTemporaryDirectory() + "ayu-archive-test-" + UUID().uuidString
+        Logger.setSharedLogger(Logger(rootPath: self.path + "/logs"))
+        self.manager = AccountManager(basePath: self.path, isTemporary: true, isReadOnly: false, useCaches: false, removeDatabaseOnError: false, accessChallenge: AccountManagerAccessChallenge(prepare: { _ in }, resolve: { value, _ in value }, finishInitialization: {}))
+    }
+    override func tearDown() {
+        self.manager = nil
+        try? FileManager.default.removeItem(atPath: self.path)
+        super.tearDown()
+    }
+    private func value<T>(_ signal: Signal<T, NoError>) throws -> T {
+        let done = expectation(description: "transaction")
+        var value: T?
+        let disposable = (signal |> take(1)).start(next: { value = $0 }, completed: { done.fulfill() })
+        wait(for: [done], timeout: 10)
+        disposable.dispose()
+        return try XCTUnwrap(value)
+    }
+    func testConfirmedLogoutRetainsRecordAndMetadata() throws {
+        let id = try value(self.manager.transaction { $0.createRecord([]) })
+        let metadata = AyuArchivedAccountInfo(peerId: 123, title: "Local account", timestamp: 12345)
+        try value(logoutFromAccount(id: id, accountManager: self.manager, alreadyLoggedOutRemotely: false, archive: metadata))
+        let record = try XCTUnwrap(try value(self.manager.transaction { $0.getRecords().first(where: { $0.id == id }) }))
+        XCTAssertNil(record.temporarySessionId)
+        guard case let .loggedOut(attribute)? = record.attributes.last else { return XCTFail("No logout marker") }
+        XCTAssertEqual(attribute.archive, metadata)
+        // Real persisted AccountRecord JSON must preserve the retention marker after restart.
+        let restored = try JSONDecoder().decode(AccountRecord<TelegramAccountRecordAttribute>.self, from: JSONEncoder().encode(record))
+        XCTAssertEqual(record.attributes, restored.attributes)
+    }
+    func testManualLogoutIsNotArchivedAndRemoteCompletionRemovesIt() throws {
+        let id = try value(self.manager.transaction { $0.createRecord([]) })
+        try value(logoutFromAccount(id: id, accountManager: self.manager, alreadyLoggedOutRemotely: false))
+        let attributes = try value(self.manager.transaction { $0.getRecords().first(where: { $0.id == id })?.attributes })
+        guard case let .loggedOut(marker)? = attributes?.last else { return XCTFail("No logout marker") }
+        XCTAssertNil(marker.archive)
+        try value(logoutFromAccount(id: id, accountManager: self.manager, alreadyLoggedOutRemotely: true))
+        XCTAssertTrue(try value(self.manager.transaction { $0.getRecords().isEmpty }))
+    }
+    func testExistingManualLogoutCannotBeTurnedIntoAnArchive() throws {
+        let id = try value(self.manager.transaction { $0.createRecord([.loggedOut(LoggedOutAccountAttribute())]) })
+        try value(logoutFromAccount(id: id, accountManager: self.manager, alreadyLoggedOutRemotely: false, archive: AyuArchivedAccountInfo(peerId: 123, title: "Late callback", timestamp: 99)))
+        let attributes = try value(self.manager.transaction { $0.getRecords().first(where: { $0.id == id })?.attributes })
+        guard case let .loggedOut(marker)? = attributes?.last else { return XCTFail("No logout marker") }
+        XCTAssertNil(marker.archive)
+    }
+    func testLegacyEmptyMarkerDecodesWithoutRetention() throws {
+        XCTAssertNil(try JSONDecoder().decode(LoggedOutAccountAttribute.self, from: Data("{}".utf8)).archive)
+    }
+}
