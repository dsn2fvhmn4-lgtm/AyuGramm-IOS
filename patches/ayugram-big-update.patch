+static bool function__doc__(int argc, py_Ref argv) {
+    PY_CHECK_ARGC(1);
+    Function* func = py_touserdata(py_arg(0));
+    if(func->decl->docstring) {
+        py_newstr(py_retval(), func->decl->docstring);
+    } else {
+        py_newnone(py_retval());
+    }
+    return true;
+}
