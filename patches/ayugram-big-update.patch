+/// Adds the chat to the pinned list of AyuGram's "📌 Pinned" folder (created on first use), or
+/// removes it when it is already there. Telegram folders allow far more pins than the main list.
+private func ayuTogglePinnedFolder(context: AccountContext, peerId: EnginePeer.Id, russian: Bool) {
+    let key = "ayu.localPins.folderId"
+    let _ = context.engine.peers.updateChatListFiltersInteractively { filters in
+        var filters = filters
+        let storedId = UserDefaults.standard.object(forKey: key) as? Int32
+        var index = filters.firstIndex(where: { filter in
+            if case let .filter(id, _, _, _) = filter { return id == storedId }
+            return false
+        })
+        if index == nil {
+            let id = context.engine.peers.generateNewChatListFilterId(filters: filters)
+            let data = ChatListFilterData(isShared: false, hasSharedLinks: false, categories: [], excludeMuted: false, excludeRead: false, excludeArchived: false, includePeers: ChatListFilterIncludePeers(), excludePeers: [], color: nil)
+            filters.insert(.filter(id: id, title: ChatFolderTitle(text: russian ? "Закреплённые" : "Pinned", entities: [], enableAnimations: true), emoticon: "📌", data: data), at: 0)
+            UserDefaults.standard.set(id, forKey: key)
+            index = 0
+        }
+        if let index, case let .filter(id, title, emoticon, data) = filters[index] {
+            var data = data
+            if data.includePeers.pinnedPeers.contains(peerId) {
+                data.includePeers.removePinnedPeer(peerId)
+            } else {
+                let _ = data.includePeers.addPinnedPeer(peerId)
+            }
+            filters[index] = .filter(id: id, title: title, emoticon: emoticon, data: data)
+        }
+        return filters
+    }.startStandalone()
+}
