+/// The calls of the extended plugin API, shared by every engine (JavaScript passes them through
+/// `host.call`, Python and Rust through their JSON channel). Returns a JSON-serialisable answer.
+enum AyuPluginHostAPI {
+    private static let snapshotLock = NSLock()
+    private static var snapshot: [String: Any] = [:]
+
+    static func deviceSnapshot() -> [String: Any] {
+        snapshotLock.lock(); defer { snapshotLock.unlock() }
+        return snapshot
+    }
+
+    static func refreshDeviceSnapshot() {
+        UIDevice.current.isBatteryMonitoringEnabled = true
+        let value: [String: Any] = [
+            "battery": UIDevice.current.batteryLevel,
+            "charging": UIDevice.current.batteryState == .charging || UIDevice.current.batteryState == .full,
+            "orientation": UIDevice.current.orientation.isLandscape ? "landscape" : "portrait",
+            "reduceMotion": UIAccessibility.isReduceMotionEnabled
+        ]
+        snapshotLock.lock()
+        snapshot = value
+        snapshotLock.unlock()
+    }
+
+    static func handle(pluginId: String, permissions: Set<String>, op: String, args: [String: Any], log: (AyuPluginConsole.Line.Level, String) -> Void) -> Any? {
+        func allowed(_ permission: AyuPluginPermission) -> Bool {
+            if permissions.contains(permission.rawValue) { return true }
+            log(.error, "\(op) needs the '\(permission.rawValue)' permission: add `@permissions \(permission.rawValue)` to the plugin header.")
+            return false
+        }
+        func string(_ key: String, _ limit: Int = 200) -> String {
+            return String((args[key] as? String ?? "").prefix(limit))
+        }
+        func peerId(_ key: String = "peerId") -> Int64? {
+            if let number = args[key] as? NSNumber { return number.int64Value }
