@@ -0,0 +1,80 @@
+import Foundation
+
+/// Chats locked with Face ID and chats hidden from the chat list (chat list → long press).
+/// The sets are cached in memory: the chat list asks for every row on each update.
+public enum AyuChatPrivacy {
+    public static let didChangeNotification = Notification.Name("AyuGram.ChatPrivacyChanged")
+    private static let lockedKey = "ayu.privacy.lockedChats"
+    private static let hiddenKey = "ayu.privacy.hiddenChats"
+    private static let lock = NSLock()
+    private static var lockedCache: Set<Int64>?
+    private static var hiddenCache: Set<Int64>?
+    /// Chats unlocked since the app last went to the background.
+    private static var unlocked: Set<Int64> = []
+
+    private static func load(_ key: String) -> Set<Int64> {
+        return Set((UserDefaults.standard.array(forKey: key) as? [NSNumber] ?? []).map { $0.int64Value })
+    }
+
+    private static func save(_ key: String, _ value: Set<Int64>) {
+        UserDefaults.standard.set(value.sorted().map { NSNumber(value: $0) }, forKey: key)
+    }
+
+    public static var locked: Set<Int64> {
+        lock.lock(); defer { lock.unlock() }
+        if lockedCache == nil { lockedCache = load(lockedKey) }
+        return AyuDecoyMode.isActive ? [] : lockedCache!
+    }
+
+    public static var hidden: Set<Int64> {
+        lock.lock(); defer { lock.unlock() }
+        if hiddenCache == nil { hiddenCache = load(hiddenKey) }
+        return AyuDecoyMode.isActive ? [] : hiddenCache!
+    }
+
+    public static func isLocked(_ peerId: Int64) -> Bool {
+        return locked.contains(peerId)
+    }
+
+    public static func isHidden(_ peerId: Int64) -> Bool {
+        return hidden.contains(peerId)
+    }
+
+    public static func setLocked(_ peerId: Int64, _ value: Bool) {
+        lock.lock()
+        var set = lockedCache ?? load(lockedKey)
+        if value { set.insert(peerId) } else { set.remove(peerId) }
+        lockedCache = set
+        save(lockedKey, set)
+        lock.unlock()
+        NotificationCenter.default.post(name: didChangeNotification, object: nil)
+    }
+
+    public static func setHidden(_ peerId: Int64, _ value: Bool) {
+        lock.lock()
+        var set = hiddenCache ?? load(hiddenKey)
+        if value { set.insert(peerId) } else { set.remove(peerId) }
+        hiddenCache = set
+        save(hiddenKey, set)
+        lock.unlock()
+        NotificationCenter.default.post(name: didChangeNotification, object: nil)
+    }
+
+    public static func isUnlocked(_ peerId: Int64) -> Bool {
+        lock.lock(); defer { lock.unlock() }
+        return unlocked.contains(peerId)
+    }
+
+    public static func markUnlocked(_ peerId: Int64) {
+        lock.lock()
+        unlocked.insert(peerId)
+        lock.unlock()
+    }
+
+    /// Called when the app goes to the background: locked chats ask again.
+    public static func relock() {
+        lock.lock()
+        unlocked.removeAll()
+        lock.unlock()
+    }
+}
diff --git a/submodules/Display/Source/AyuCustomization.swift b/submodules/Display/Source/AyuCustomization.swift
new file mode 100644
index 00000000..23390366
--- /dev/null
+++ b/submodules/Display/Source/AyuCustomization.swift
@@ -0,0 +1,172 @@
+import Foundation
+import UIKit
+
+/// Settings → AyuGram → Customization: local colours on top of any theme and badges for chats
+/// and for yourself. Only this device sees them. Stored in UserDefaults under "ayu.custom.*".
+public enum AyuCustomization {
+    public static let didChangeNotification = Notification.Name("AyuGram.CustomizationChanged")
+
+    public enum Color: String, CaseIterable {
+        /// Buttons, links, switches, selected tabs.
+        case accent
+        case outgoingBubble
+        case outgoingText
+        case incomingBubble
+        case incomingText
+        /// Solid chat background; with `wallpaperSecond`, a gradient.
+        case wallpaper
+        case wallpaperSecond
+        /// Background of lists and settings.
+        case listBackground
+        /// Chat names in the chat list.
+        case chatTitle
+    }
+
+    private static func key(_ name: String) -> String { return "ayu.custom." + name }
+
+    /// Bumped on every change so cached themes are rebuilt.
+    public private(set) static var revision: Int = 0
+
+    public static func hex(_ color: Color) -> String? {
+        let value = UserDefaults.standard.string(forKey: AyuCustomization.key(color.rawValue)) ?? ""
+        return value.isEmpty ? nil : value
+    }
+
+    public static func color(_ color: Color) -> UIColor? {
+        guard let hex = AyuCustomization.hex(color), let value = AyuCustomization.parse(hex) else { return nil }
+        return UIColor(rgb: value)
+    }
+
+    public static func rgb(_ color: Color) -> UInt32? {
+        return AyuCustomization.hex(color).flatMap(AyuCustomization.parse)
+    }
+
+    /// `#RRGGBB`, `RRGGBB` or `RGB`; nil when not a colour.
+    public static func parse(_ text: String) -> UInt32? {
+        var hex = text.trimmingCharacters(in: CharacterSet(charactersIn: "# \n"))
+        if hex.count == 3 {
+            hex = hex.map { "\($0)\($0)" }.joined()
+        }
+        guard hex.count == 6, let value = UInt32(hex, radix: 16) else { return nil }
+        return value
+    }
+
+    public static func set(_ color: Color, hex: String?) {
+        let normalized = hex.flatMap(AyuCustomization.parse).map { String(format: "#%06X", $0) }
+        if let normalized {
+            UserDefaults.standard.set(normalized, forKey: AyuCustomization.key(color.rawValue))
+        } else {
+            UserDefaults.standard.removeObject(forKey: AyuCustomization.key(color.rawValue))
+        }
+        AyuCustomization.changed()
+    }
+
+    public static var hasColors: Bool {
+        return !AyuDecoyMode.isActive && Color.allCases.contains(where: { AyuCustomization.hex($0) != nil })
+    }
+
+    // MARK: Badges
+
+    /// Shown after your name in Settings and your profile.
+    public static var myBadge: String {
+        get { return UserDefaults.standard.string(forKey: AyuCustomization.key("myBadge")) ?? "" }
+        set {
+            UserDefaults.standard.set(String(newValue.trimmingCharacters(in: .whitespacesAndNewlines).prefix(16)), forKey: AyuCustomization.key("myBadge"))
+            AyuCustomization.changed()
+        }
+    }
+
+    private static var badgeCache: [Int64: String]?
+
+    /// Peer id → badge text shown beside the chat's name in the chat list.
+    public static var peerBadges: [Int64: String] {
+        if let cached = AyuCustomization.badgeCache {
+            return cached
+        }
+        var result: [Int64: String] = [:]
+        if let stored = UserDefaults.standard.dictionary(forKey: AyuCustomization.key("peerBadges")) as? [String: String] {
+            for (key, value) in stored {
+                if let id = Int64(key) { result[id] = value }
+            }
+        }
+        AyuCustomization.badgeCache = result
+        return result
+    }
+
+    public static func badgeFont(size: CGFloat) -> UIFont {
+        let font = UIFont.systemFont(ofSize: size, weight: .heavy)
+        return font.fontDescriptor.withDesign(.rounded).map { UIFont(descriptor: $0, size: size) } ?? font
+    }
+
+    public static func badge(peerId: Int64) -> String? {
+        return AyuCustomization.peerBadges[peerId]
+    }
+
+    public static func setBadge(_ text: String?, peerId: Int64, title: String? = nil) {
+        var badges = AyuCustomization.peerBadges
+        let trimmed = text?.trimmingCharacters(in: .whitespacesAndNewlines) ?? ""
+        badges[peerId] = trimmed.isEmpty ? nil : String(trimmed.prefix(16))
+        UserDefaults.standard.set(Dictionary(uniqueKeysWithValues: badges.map { (String($0.key), $0.value) }), forKey: AyuCustomization.key("peerBadges"))
+        var titles = (UserDefaults.standard.dictionary(forKey: AyuCustomization.key("peerBadgeTitles")) as? [String: String]) ?? [:]
+        titles[String(peerId)] = trimmed.isEmpty ? nil : (title ?? titles[String(peerId)])
+        UserDefaults.standard.set(titles, forKey: AyuCustomization.key("peerBadgeTitles"))
+        AyuCustomization.badgeCache = badges
+        AyuCustomization.changed()
+    }
+
+    /// The chat's name when its badge was set, for the badge list.
+    public static func badgeTitle(peerId: Int64) -> String? {
+        return (UserDefaults.standard.dictionary(forKey: AyuCustomization.key("peerBadgeTitles")) as? [String: String])?[String(peerId)]
+    }
+
+    public static func resetAll() {
+        for color in Color.allCases {
+            UserDefaults.standard.removeObject(forKey: AyuCustomization.key(color.rawValue))
+        }
+        UserDefaults.standard.removeObject(forKey: AyuCustomization.key("myBadge"))
+        UserDefaults.standard.removeObject(forKey: AyuCustomization.key("peerBadges"))
+        UserDefaults.standard.removeObject(forKey: AyuCustomization.key("peerBadgeTitles"))
+        AyuCustomization.badgeCache = nil
+        AyuCustomization.changed()
+    }
+
+    private static func changed() {
+        AyuCustomization.revision += 1
+        NotificationCenter.default.post(name: AyuCustomization.didChangeNotification, object: nil)
+    }
+
+    /// Ready-made palettes for the customization screen.
+    public struct Preset {
+        public let nameRu: String
+        public let nameEn: String
+        public let colors: [Color: String]
+    }
+
+    public static let presets: [Preset] = [
+        // Black and white everywhere: grey accents, black and white bubbles and backgrounds.
+        Preset(nameRu: "Монохром тёмный", nameEn: "Monochrome dark", colors: [.accent: "#FFFFFF", .outgoingBubble: "#FFFFFF", .outgoingText: "#000000", .incomingBubble: "#1C1C1E", .incomingText: "#FFFFFF", .wallpaper: "#000000", .listBackground: "#000000", .chatTitle: "#FFFFFF"]),
