+        other = NULL;
+    }
+    c11_array2d* res = c11_newarray2d(py_pushtmp(), self->n_cols, self->n_rows);
+    for(int j = 0; j < self->n_rows; j++) {
+        for(int i = 0; i < self->n_cols; i++) {
+            py_Ref lhs = self->f_get(self, i, j);
+            py_Ref rhs;
+            if(other != NULL) {
