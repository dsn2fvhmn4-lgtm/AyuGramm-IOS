+    [TK_TRUE] =        { exprLiteral0 },
+    [TK_FALSE] =       { exprLiteral0 },
+    [TK_NONE] =        { exprLiteral0 },
+    [TK_DOTDOTDOT] =   { exprLiteral0 },
+    [TK_LAMBDA] =      { exprLambda,  },
+    [TK_ID] =          { exprName,    },
+    [TK_NUM] =         { exprLiteral, },
+    [TK_STR] =         { exprLiteral, },
+    [TK_FSTR_BEGIN] =  { exprFString, },
+    [TK_IMAG] =        { exprImag,    },
