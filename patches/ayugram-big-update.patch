+import Foundation
+import UIKit
+import ImageIO
+import AsyncDisplayKit
+import Display
+import TelegramPresentationData
+import AccountContext
+
+/// The profile banner of an AyuGram user, from the signed registry (an https image). Everyone who
+/// uses AyuGram sees it in that person's profile; the image is cached for the session.
+final class PeerInfoScreenAyuBannerItem: PeerInfoScreenItem {
+    let id: AnyHashable
+    let url: String
+
+    init(id: AnyHashable, url: String) {
+        self.id = id
+        self.url = url
+    }
+
+    func node() -> PeerInfoScreenItemNode {
+        return PeerInfoScreenAyuBannerItemNode()
+    }
+}
+
+private let ayuBannerCache: NSCache<NSString, UIImage> = {
+    let cache = NSCache<NSString, UIImage>()
+    cache.countLimit = 32
+    cache.totalCostLimit = 24 * 1024 * 1024
+    return cache
+}()
+
+// Data and completion are confined to URLSession's serial delegate queue; UI delivery is on main.
+private final class AyuBannerDownload: NSObject, URLSessionDataDelegate, @unchecked Sendable {
+    private static let maximumBytes = 4 * 1024 * 1024
+    private var session: URLSession?
+    private var data = Data()
+    private var completion: ((UIImage?) -> Void)?
+
+    init(url: URL, completion: @escaping (UIImage?) -> Void) {
+        self.completion = completion
+        super.init()
+        let configuration = URLSessionConfiguration.ephemeral
+        configuration.timeoutIntervalForRequest = 20.0
+        configuration.timeoutIntervalForResource = 30.0
+        configuration.httpShouldSetCookies = false
+        configuration.httpCookieStorage = nil
+        configuration.urlCredentialStorage = nil
+        let session = URLSession(configuration: configuration, delegate: self, delegateQueue: nil)
+        self.session = session
+        session.dataTask(with: url).resume()
+    }
+
+    func cancel() {
+        self.session?.invalidateAndCancel()
+    }
+
+    func urlSession(_ session: URLSession, task: URLSessionTask, willPerformHTTPRedirection response: HTTPURLResponse, newRequest request: URLRequest, completionHandler: @escaping (URLRequest?) -> Void) {
+        guard let url = request.url, AyuVerifiedRegistry.bannerURL(url.absoluteString) != nil else {
+            completionHandler(nil)
+            return
+        }
+        completionHandler(request)
+    }
+
+    func urlSession(_ session: URLSession, dataTask: URLSessionDataTask, didReceive response: URLResponse, completionHandler: @escaping (URLSession.ResponseDisposition) -> Void) {
+        guard let response = response as? HTTPURLResponse, response.statusCode == 200,
+              response.expectedContentLength <= Int64(Self.maximumBytes) else {
+            completionHandler(.cancel)
+            return
+        }
+        completionHandler(.allow)
+    }
+
+    func urlSession(_ session: URLSession, dataTask: URLSessionDataTask, didReceive data: Data) {
+        guard data.count <= Self.maximumBytes - self.data.count else {
+            dataTask.cancel()
+            return
+        }
+        self.data.append(data)
+    }
+
+    func urlSession(_ session: URLSession, task: URLSessionTask, didCompleteWithError error: Error?) {
+        var image: UIImage?
+        if error == nil, let source = CGImageSourceCreateWithData(self.data as CFData, [kCGImageSourceShouldCache: false] as CFDictionary),
+           let thumbnail = CGImageSourceCreateThumbnailAtIndex(source, 0, [
+                kCGImageSourceCreateThumbnailFromImageAlways: true,
+                kCGImageSourceCreateThumbnailWithTransform: true,
+                kCGImageSourceThumbnailMaxPixelSize: 1440
+           ] as CFDictionary) {
+            image = UIImage(cgImage: thumbnail)
+        }
+        let completion = self.completion
+        self.completion = nil
+        self.data.removeAll()
+        session.finishTasksAndInvalidate()
+        let result = image
+        DispatchQueue.main.async {
+            completion?(result)
+        }
+    }
+}
+
+private final class PeerInfoScreenAyuBannerItemNode: PeerInfoScreenItemNode {
+    private let imageView = UIImageView()
+    private var loadingUrl: String?
+    private var download: AyuBannerDownload?
+
+    override init() {
+        super.init()
+        self.imageView.contentMode = .scaleAspectFill
+        self.imageView.clipsToBounds = true
+        self.imageView.layer.cornerRadius = 12.0
+    }
+
+    override func didLoad() {
+        super.didLoad()
+        self.view.addSubview(self.imageView)
+    }
+
+    deinit {
+        self.download?.cancel()
+    }
+
+    private func load(_ url: String) {
+        guard self.loadingUrl != url else { return }
+        self.download?.cancel()
+        self.download = nil
+        self.loadingUrl = url
+        self.imageView.image = nil
+        if let cached = ayuBannerCache.object(forKey: url as NSString) {
+            self.imageView.image = cached
+            return
+        }
+        guard let target = AyuVerifiedRegistry.bannerURL(url) else { return }
+        self.download = AyuBannerDownload(url: target, completion: { [weak self] image in
+            guard let self, self.loadingUrl == url else { return }
+            self.download = nil
+            if let image, let cgImage = image.cgImage {
+                ayuBannerCache.setObject(image, forKey: url as NSString, cost: cgImage.bytesPerRow * cgImage.height)
+            }
+            self.imageView.image = image
+        })
+    }
+
+    override func update(context: AccountContext, width: CGFloat, safeInsets: UIEdgeInsets, presentationData: PresentationData, item: PeerInfoScreenItem, topItem: PeerInfoScreenItem?, bottomItem: PeerInfoScreenItem?, hasCorners: Bool, transition: ContainedViewLayoutTransition) -> CGFloat {
+        guard let item = item as? PeerInfoScreenAyuBannerItem else {
+            return 10.0
+        }
+        self.load(item.url)
+        let sideInset: CGFloat = 16.0 + safeInsets.left
+        let bannerWidth = max(0.0, width - sideInset - 16.0 - safeInsets.right)
+        let height = floor(bannerWidth / 3.0)
+        self.imageView.backgroundColor = presentationData.theme.list.itemBlocksSeparatorColor
+        self.imageView.frame = CGRect(x: sideInset, y: 8.0, width: bannerWidth, height: height)
+        return height + 16.0
+    }
+}
