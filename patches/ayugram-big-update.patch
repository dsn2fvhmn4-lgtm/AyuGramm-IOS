diff --git a/submodules/TelegramUI/Sources/AyuAccountAccent.swift b/submodules/TelegramUI/Sources/AyuAccountAccent.swift
new file mode 100644
index 00000000..67c97ffa
--- /dev/null
+++ b/submodules/TelegramUI/Sources/AyuAccountAccent.swift
@@ -0,0 +1,56 @@
+import Foundation
+import SwiftSignalKit
+import Display
+import TelegramCore
+import TelegramUIPreferences
+import AccountContext
+
+/// "Accent colour per account": every account keeps the theme accent it was last used with.
+/// Switching accounts stores the current accent for the old one and brings back the new one's,
+/// through Telegram's own theme settings, so the change is applied like a normal accent pick.
+enum AyuAccountAccent {
+    private static let key = "ayu.accountAccent"
+    private static var disposable: Disposable?
+
+    private static func load() -> [String: Data] {
+        return (UserDefaults.standard.dictionary(forKey: key) as? [String: Data]) ?? [:]
+    }
+
+    private static func encode(_ accent: PresentationThemeAccentColor) -> Data {
+        let encoder = EnginePostboxEncoder()
+        accent.encode(encoder)
+        return encoder.makeData()
+    }
+
+    private static func decode(_ data: Data) -> PresentationThemeAccentColor {
+        return PresentationThemeAccentColor(decoder: EnginePostboxDecoder(buffer: EngineMemoryBuffer(data: data)))
+    }
+
+    static func install(sharedContext: SharedAccountContext) {
+        guard disposable == nil else { return }
+        var previous: AccountRecordId?
+        disposable = (sharedContext.activeAccountContexts
+        |> map { primary, _, _ in primary?.account.id }
+        |> distinctUntilChanged
+        |> deliverOnMainQueue).startStrict(next: { accountId in
+            defer { previous = accountId }
+            guard AyuExtras.isOn(.accentPerAccount), !AyuDecoyMode.isActive, let accountId else { return }
+            let from = previous
+            let _ = updatePresentationThemeSettingsInteractively(accountManager: sharedContext.accountManager, { settings in
+                var stored = load()
+                let themeIndex = settings.theme.index
+                if let from, let current = settings.themeSpecificAccentColors[themeIndex] {
+                    stored["\(from.int64)"] = encode(current)
+                }
+                var updated = settings
+                if let data = stored["\(accountId.int64)"] {
+                    var colors = settings.themeSpecificAccentColors
+                    colors[themeIndex] = decode(data)
+                    updated = settings.withUpdatedThemeSpecificAccentColors(colors)
+                }
+                UserDefaults.standard.set(stored, forKey: key)
+                return updated
+            }).startStandalone()
+        })
+    }
+}
