diff --git a/submodules/TelegramCore/Sources/AyuGram/AyuHooks.swift b/submodules/TelegramCore/Sources/AyuGram/AyuHooks.swift
new file mode 100644
index 00000000..8d45a581
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuGram/AyuHooks.swift
@@ -0,0 +1,157 @@
+import Foundation
+
+/// Hook points code plugins can intercept. TelegramCore only knows the registry; the
+/// JavaScript runtime that fills it lives in AccountContext.
+///
+/// For a text point the chain is: every `before` handler in registration order, then the
+/// native handler (or the first `replace` handler, which disables the native one), then
+/// every `after` handler. A handler that returns nil leaves the text unchanged.
+public final class AyuHooks {
+    public enum TextPoint: String, CaseIterable {
+        /// Plain outgoing text right before it is enqueued (JSON outgoing-replace plugins are
+        /// the native handler here).
+        case outgoingText = "message.outgoing.text"
+    }
+
+    public enum Mode: String {
+        case before, replace, after
+    }
+
+    public struct TextContext {
+        public let peerId: Int64
+        public let isSecret: Bool
+        public init(peerId: Int64, isSecret: Bool) {
+            self.peerId = peerId
+            self.isSecret = isSecret
+        }
+    }
+
+    public typealias TextHandler = (String, TextContext) -> String?
+
+    private struct Registration {
+        let owner: String
+        let mode: Mode
+        let handler: TextHandler
+    }
+
+    /// Native features a plugin may switch off. Each maps onto an existing AyuGram interface
+    /// setting so every call site that already honours that setting honours the plugin too.
+    public enum Feature: String, CaseIterable {
+        case fastShare, messageShot, reactionPicker, readSummary, editedInfo, messageDetails
+        case stories, similarChannels, premiumStatuses, unreadCounters, greetingSticker
+        case openLinkWarning, doubleTapToEdit, formattingToolbar, keyboardHideOnScroll
+    }
+
+    public static let shared = AyuHooks()
+    public static let didChangeNotification = Notification.Name("AyuGram.HooksChanged")
+
+    private let lock = NSLock()
+    private var textHandlers: [TextPoint: [Registration]] = [:]
+    private var disabledFeatures: [String: Set<Feature>] = [:]
+    private var revision: Int = 0
+
+    private init() {}
+
+    public func register(point: TextPoint, mode: Mode, owner: String, handler: @escaping TextHandler) {
+        self.lock.lock()
+        self.textHandlers[point, default: []].append(Registration(owner: owner, mode: mode, handler: handler))
+        self.revision += 1
+        self.lock.unlock()
+        self.notify()
+    }
+
+    public func setFeature(_ feature: Feature, disabled: Bool, owner: String) {
+        self.lock.lock()
+        var set = self.disabledFeatures[owner] ?? []
+        if disabled { set.insert(feature) } else { set.remove(feature) }
+        self.disabledFeatures[owner] = set.isEmpty ? nil : set
+        self.revision += 1
+        self.lock.unlock()
+        self.notify()
+    }
+
+    /// Drops every hook and feature override a plugin installed (on disable, unload or hang).
+    public func removeAll(owner: String) {
+        self.lock.lock()
+        for (point, list) in self.textHandlers {
+            self.textHandlers[point] = list.filter { $0.owner != owner }
+        }
+        self.disabledFeatures.removeValue(forKey: owner)
+        self.revision += 1
+        self.lock.unlock()
+        self.notify()
+    }
+
+    public func hasHandlers(_ point: TextPoint) -> Bool {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return !(self.textHandlers[point]?.isEmpty ?? true)
+    }
+
+    /// Who currently replaces the native handler of `point`, for the plugin screen.
+    public func replacingOwner(_ point: TextPoint) -> String? {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return self.textHandlers[point]?.first(where: { $0.mode == .replace })?.owner
+    }
+
+    public func run(_ point: TextPoint, text: String, context: TextContext, native: (String) -> String) -> String {
+        self.lock.lock()
+        let registrations = self.textHandlers[point] ?? []
+        self.lock.unlock()
+        if registrations.isEmpty {
+            return native(text)
+        }
+        var result = text
+        for registration in registrations where registration.mode == .before {
+            if let value = registration.handler(result, context) { result = value }
+        }
+        if let replacement = registrations.first(where: { $0.mode == .replace }) {
+            if let value = replacement.handler(result, context) { result = value }
+        } else {
+            result = native(result)
+        }
+        for registration in registrations where registration.mode == .after {
+            if let value = registration.handler(result, context) { result = value }
+        }
+        return result
+    }
+
+    public var activeDisabledFeatures: Set<Feature> {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return self.disabledFeatures.values.reduce(into: Set<Feature>()) { $0.formUnion($1) }
+    }
+
+    /// The account policy as the app should see it with plugin feature overrides applied.
+    func applyingOverrides(to settings: AyuGhostModeSettings) -> AyuGhostModeSettings {
+        let disabled = self.activeDisabledFeatures
+        guard !disabled.isEmpty else { return settings }
+        var settings = settings
+        for feature in disabled {
+            switch feature {
+            case .fastShare: settings.interface.hideFastShare = true
+            case .messageShot: settings.interface.showMessageShot = false
+            case .reactionPicker: settings.interface.showReactionPicker = false
+            case .readSummary: settings.interface.showReadSummary = false
+            case .editedInfo: settings.interface.showEditedInfo = false
+            case .messageDetails: settings.interface.showMessageDetails = false
+            case .stories: settings.interface.hideStories = true
+            case .similarChannels: settings.interface.hideSimilarChannels = true
+            case .premiumStatuses: settings.interface.hidePremiumStatuses = true
+            case .unreadCounters: settings.interface.hideUnreadCounters = true
+            case .greetingSticker: settings.interface.disableGreetingSticker = true
+            case .openLinkWarning: settings.interface.disableOpenLinkWarning = true
+            case .doubleTapToEdit: settings.interface.doubleTapToEdit = false
+            case .formattingToolbar: settings.interface.formattingToolbar = false
+            case .keyboardHideOnScroll: settings.interface.hideKeyboardOnScroll = false
+            }
+        }
+        return settings
+    }
+
+    private func notify() {
+        let post = { NotificationCenter.default.post(name: AyuHooks.didChangeNotification, object: nil) }
+        if Thread.isMainThread { post() } else { DispatchQueue.main.async(execute: post) }
+    }
+}
diff --git a/submodules/TelegramCore/Sources/AyuGram/AyuPeerArchive.swift b/submodules/TelegramCore/Sources/AyuGram/AyuPeerArchive.swift
new file mode 100644
index 00000000..ccd05137
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuGram/AyuPeerArchive.swift
@@ -0,0 +1,187 @@
+import Foundation
+import Postbox
+
+/// Local snapshots of chats, channels and people this account has seen, kept so a saved ID
+/// still resolves to a name and old usernames after the account is deleted, the channel is
+/// removed or the user leaves it. Stored only on this device, per account.
+public final class AyuPeerArchive {
+    public struct Entry: Codable, Equatable {
+        public enum Kind: String, Codable {
+            case user, bot, group, channel
+        }
+        /// `EnginePeer.Id.toInt64()` of the peer.
+        public var peerId: Int64
+        /// The bare server id as users see and share it.
+        public var rawId: Int64
+        public var kind: Kind
+        public var title: String
+        public var usernames: [String]
+        public var firstSeen: Int32
+        public var lastSeen: Int32
+        /// The peer was seen deleted/unavailable after this snapshot was taken.
+        public var goneSince: Int32?
+    }
+
+    private static var instances: [Int64: AyuPeerArchive] = [:]
+    private static let instancesLock = NSLock()
+
+    public static func shared(accountPeerId: Int64) -> AyuPeerArchive {
+        AyuPeerArchive.instancesLock.lock()
+        defer { AyuPeerArchive.instancesLock.unlock() }
+        if let current = AyuPeerArchive.instances[accountPeerId] {
+            return current
+        }
+        let archive = AyuPeerArchive(accountPeerId: accountPeerId)
+        AyuPeerArchive.instances[accountPeerId] = archive
+        return archive
+    }
+
+    private let lock = NSLock()
+    private let fileURL: URL?
+    private var entries: [Int64: Entry] = [:]
+    private var dirty = false
+    private var saveScheduled = false
+    private let saveQueue = DispatchQueue(label: "AyuGram.PeerArchive")
+    private let capacity = 5000
+
+    private init(accountPeerId: Int64) {
+        self.fileURL = FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first?
+            .appendingPathComponent("AyuGram", isDirectory: true)
+            .appendingPathComponent("peer-archive-\(accountPeerId).json")
+        if let url = self.fileURL, let data = try? Data(contentsOf: url), let decoded = try? JSONDecoder().decode([Entry].self, from: data) {
+            for entry in decoded { self.entries[entry.peerId] = entry }
+        }
+    }
+
+    public var count: Int {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return self.entries.count
+    }
+
+    public func entry(peerId: Int64) -> Entry? {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return self.entries[peerId]
+    }
+
+    /// Entries whose bare id equals `rawId` (a user and a channel can share one).
+    public func entries(rawId: Int64) -> [Entry] {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return self.entries.values.filter { $0.rawId == rawId }
+    }
+
+    /// Peers last seen deleted or unavailable, most recent first.
+    public func goneEntries(limit: Int = 50) -> [Entry] {
+        self.lock.lock()
+        let gone = self.entries.values.filter { $0.goneSince != nil }
+        self.lock.unlock()
+        return Array(gone.sorted(by: { ($0.goneSince ?? 0) > ($1.goneSince ?? 0) }).prefix(limit))
+    }
+
+    public func search(_ query: String, limit: Int = 50) -> [Entry] {
+        let needle = query.trimmingCharacters(in: .whitespacesAndNewlines).lowercased()
+        let bare = needle.hasPrefix("@") ? String(needle.dropFirst()) : needle
+        guard !bare.isEmpty else { return [] }
+        self.lock.lock()
+        let all = Array(self.entries.values)
+        self.lock.unlock()
+        let matches = all.filter { entry in
+            if String(entry.rawId) == bare || String(entry.peerId) == bare { return true }
+            if entry.title.lowercased().contains(bare) { return true }
+            return entry.usernames.contains(where: { $0.lowercased().hasPrefix(bare) })
+        }
+        return Array(matches.sorted(by: { $0.lastSeen > $1.lastSeen }).prefix(limit))
+    }
+
+    public func record(_ peer: EnginePeer) {
+        let now = Int32(Date().timeIntervalSince1970)
+        let kind: Entry.Kind
+        let title: String
+        switch peer {
+        case let .user(user):
+            kind = user.botInfo != nil ? .bot : .user
+            title = [user.firstName, user.lastName].compactMap { $0 }.filter { !$0.isEmpty }.joined(separator: " ")
+        case let .legacyGroup(group):
+            kind = .group
+            title = group.title
+        case let .channel(channel):
+            if case .broadcast = channel.info { kind = .channel } else { kind = .group }
+            title = channel.title
+        case .secretChat:
+            return
+        }
+        let usernames = peer.usernames.map { $0.username }.filter { !$0.isEmpty }
+        let gone = peer.isDeleted || title.isEmpty
+        let peerId = peer.id.toInt64()
+
+        self.lock.lock()
+        var entry = self.entries[peerId] ?? Entry(peerId: peerId, rawId: peer.id.id._internalGetInt64Value(), kind: kind, title: title, usernames: [], firstSeen: now, lastSeen: now, goneSince: nil)
+        if gone {
+            // Keep the last real snapshot; only note that the peer is gone now.
+            if entry.goneSince == nil { entry.goneSince = now }
+            if entry.title.isEmpty { entry.title = title }
+        } else {
+            entry.title = title
+            entry.kind = kind
+            entry.goneSince = nil
+            // Old usernames stay listed after the newer ones: they can lead back to the peer.
+            var merged = usernames
+            for old in entry.usernames where !merged.contains(old) { merged.append(old) }
+            entry.usernames = Array(merged.prefix(16))
+        }
+        entry.lastSeen = now
+        let changed = self.entries[peerId] != entry
+        self.entries[peerId] = entry
+        if self.entries.count > self.capacity {
+            let overflow = self.entries.values.sorted(by: { $0.lastSeen < $1.lastSeen }).prefix(self.entries.count - self.capacity)
+            for item in overflow { self.entries.removeValue(forKey: item.peerId) }
+        }
+        if changed { self.dirty = true }
+        let shouldSchedule = changed && !self.saveScheduled
+        if shouldSchedule { self.saveScheduled = true }
+        self.lock.unlock()
+        if shouldSchedule {
+            // Coalesce bursts (a whole chat list) into one write.
+            self.saveQueue.asyncAfter(deadline: .now() + 2.0) { [weak self] in
+                self?.flush()
+            }
+        }
+    }
+
+    public func remove(peerId: Int64) {
+        self.lock.lock()
+        self.entries.removeValue(forKey: peerId)
+        self.dirty = true
+        self.lock.unlock()
+        self.saveQueue.async { [weak self] in self?.flush() }
+    }
+
+    public func clear() {
+        self.lock.lock()
+        self.entries = [:]
+        self.dirty = true
+        self.lock.unlock()
+        self.saveQueue.async { [weak self] in self?.flush() }
+    }
+
+    private func flush() {
+        self.lock.lock()
+        self.saveScheduled = false
+        guard self.dirty, let url = self.fileURL else {
+            self.lock.unlock()
+            return
+        }
+        self.dirty = false
+        let snapshot = Array(self.entries.values)
+        self.lock.unlock()
+        guard let data = try? JSONEncoder().encode(snapshot) else { return }
+        try? FileManager.default.createDirectory(at: url.deletingLastPathComponent(), withIntermediateDirectories: true)
+        #if os(iOS)
+        try? data.write(to: url, options: [.atomic, .completeFileProtectionUntilFirstUserAuthentication])
+        #else
+        try? data.write(to: url, options: .atomic)
+        #endif
+    }
+}
