+import Foundation
+
+/// Local notes about people and chats, shown in their profile. Kept on this device only.
+public enum AyuPeerNotes {
+    public static let didChangeNotification = Notification.Name("AyuGram.PeerNotesChanged")
+    private static let key = "ayu.notes.peers"
+
+    public static func note(_ peerId: Int64) -> String? {
+        guard !AyuDecoyMode.isActive else { return nil }
+        let notes = UserDefaults.standard.dictionary(forKey: key) as? [String: String]
+        let value = notes?[String(peerId)]
+        return value?.isEmpty == false ? value : nil
+    }
+
+    public static func setNote(_ peerId: Int64, _ text: String?) {
+        var notes = (UserDefaults.standard.dictionary(forKey: key) as? [String: String]) ?? [:]
+        let trimmed = text?.trimmingCharacters(in: .whitespacesAndNewlines) ?? ""
+        notes[String(peerId)] = trimmed.isEmpty ? nil : String(trimmed.prefix(2000))
+        UserDefaults.standard.set(notes, forKey: key)
+        NotificationCenter.default.post(name: didChangeNotification, object: nil)
+    }
+
+    public static var all: [Int64: String] {
+        let notes = (UserDefaults.standard.dictionary(forKey: key) as? [String: String]) ?? [:]
+        var result: [Int64: String] = [:]
+        for (key, value) in notes {
+            if let id = Int64(key) {
+                result[id] = value
+            }
+        }
+        return result
+    }
+}
