+private func ayuPeerDcLocationString(peer: EnginePeer?) -> String {
+    guard let peer = peer else { return "DC Unknown" }
+    var dcId: Int? = nil
+    if let small = peer.smallProfileImage, let res = small.resource as? CloudPeerPhotoSizeMediaResource {
+        dcId = res.datacenterId
+    } else if let large = peer.largeProfileImage, let res = large.resource as? CloudPeerPhotoSizeMediaResource {
+        dcId = res.datacenterId
+    }
+    guard let id = dcId else { return "DC Unknown" }
+    let loc: String
+    switch id {
+    case 1, 3: loc = "Miami FL, USA"
+    case 2, 4: loc = "Amsterdam, NL"
+    case 5: loc = "Singapore, SG"
+    default: loc = "Unknown"
+    }
+    return "DC\(id), \(loc)"
+}
