+    // MARK: Presentation
+
+    func animateIn() {
+        self.layer.animatePosition(from: CGPoint(x: 0.0, y: self.bounds.height), to: CGPoint(), duration: 0.45, timingFunction: kCAMediaTimingFunctionSpring, additive: true)
+    }
+
+    func animateOut(completion: @escaping () -> Void) {
+        let offset = self.bounds.height - self.dragOffset
+        self.layer.animatePosition(from: CGPoint(), to: CGPoint(x: 0.0, y: offset), duration: 0.3, timingFunction: CAMediaTimingFunctionName.easeIn.rawValue, removeOnCompletion: false, additive: true, completion: { _ in
+            completion()
+        })
+    }
+
+    override func gestureRecognizerShouldBegin(_ gestureRecognizer: UIGestureRecognizer) -> Bool {
+        guard let pan = gestureRecognizer as? UIPanGestureRecognizer else {
+            return true
+        }
+        let location = pan.location(in: self)
+        if self.scrubber.frame.insetBy(dx: 0.0, dy: -10.0).contains(location) || self.volumeView.frame.insetBy(dx: 0.0, dy: -10.0).contains(location) {
+            return false
+        }
+        if self.showsLyrics && self.lyricsView.frame.contains(location) {
+            return false
+        }
+        let velocity = pan.velocity(in: self)
+        return velocity.y > abs(velocity.x)
+    }
+
+    @objc private func dismissPan(_ recognizer: UIPanGestureRecognizer) {
+        let translation = max(0.0, recognizer.translation(in: self).y)
+        switch recognizer.state {
+        case .changed:
+            self.dragOffset = translation
+            self.transform = CGAffineTransform(translationX: 0.0, y: translation)
+        case .ended, .cancelled:
+            let velocity = recognizer.velocity(in: self).y
+            if translation > 120.0 || velocity > 900.0 {
+                self.requestDismiss?()
+            } else {
+                self.dragOffset = 0.0
+                UIView.animate(withDuration: 0.35, delay: 0.0, usingSpringWithDamping: 0.8, initialSpringVelocity: 0.0, options: [.beginFromCurrentState], animations: {
+                    self.transform = .identity
+                })
+            }
+        default:
+            break
+        }
+    }
+}
