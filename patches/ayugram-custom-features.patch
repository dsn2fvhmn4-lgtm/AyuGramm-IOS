diff --git a/submodules/TelegramUI/Components/Calls/CallScreen/Sources/AyuCallBackdrop.swift b/submodules/TelegramUI/Components/Calls/CallScreen/Sources/AyuCallBackdrop.swift
new file mode 100644
index 00000000..305d8b64
--- /dev/null
+++ b/submodules/TelegramUI/Components/Calls/CallScreen/Sources/AyuCallBackdrop.swift
@@ -0,0 +1,43 @@
+import Foundation
+import UIKit
+import CoreImage
+import Display
+
+/// FaceTime-style call backdrop: the peer's avatar blurred across the whole screen. `glass`
+/// is the lighter copy shown through the frosted call buttons.
+func ayuCallBackdropImage(_ image: UIImage, glass: Bool) -> UIImage? {
+    // Avatars arrive round; zoom into the middle so the transparent corners never show.
+    let side: CGFloat = 96.0
+    guard let square = generateImage(CGSize(width: side, height: side), opaque: true, scale: 1.0, rotatedContext: { size, context in
+        context.setFillColor(UIColor(white: 0.12, alpha: 1.0).cgColor)
+        context.fill(CGRect(origin: CGPoint(), size: size))
+        let zoom: CGFloat = 1.5
+        let drawSize = CGSize(width: size.width * zoom, height: size.height * zoom)
+        UIGraphicsPushContext(context)
+        image.draw(in: CGRect(x: (size.width - drawSize.width) / 2.0, y: (size.height - drawSize.height) / 2.0, width: drawSize.width, height: drawSize.height))
+        UIGraphicsPopContext()
+    }), let squareCgImage = square.cgImage else {
+        return nil
+    }
+
+    let extent = CGRect(origin: CGPoint(), size: CGSize(width: side, height: side))
+    guard let blur = CIFilter(name: "CIGaussianBlur") else {
+        return nil
+    }
+    blur.setValue(CIImage(cgImage: squareCgImage).clampedToExtent(), forKey: kCIInputImageKey)
+    blur.setValue(14.0, forKey: kCIInputRadiusKey)
+    guard let blurred = blur.outputImage?.cropped(to: extent), let blurredCgImage = CIContext().createCGImage(blurred, from: extent) else {
+        return nil
+    }
+    let blurredImage = UIImage(cgImage: blurredCgImage)
+
+    return generateImage(CGSize(width: side, height: side), opaque: true, scale: 1.0, rotatedContext: { size, context in
+        let bounds = CGRect(origin: CGPoint(), size: size)
+        UIGraphicsPushContext(context)
+        blurredImage.draw(in: bounds)
+        UIGraphicsPopContext()
+        // Dim the backdrop so white text stays readable; lighten the glass copy.
+        context.setFillColor(glass ? UIColor(white: 1.0, alpha: 0.22).cgColor : UIColor(white: 0.0, alpha: 0.4).cgColor)
+        context.fill(bounds)
+    })
+}
