+private func ayuEstimatedRegistrationDate(userId: Int64) -> String {
+    let milestones: [(Int64, Int, Int, Int)] = [
+        (100_000, 2013, 8, 14),
+        (5_000_000, 2014, 1, 1),
+        (20_000_000, 2014, 6, 1),
+        (50_000_000, 2015, 1, 1),
+        (100_000_000, 2015, 6, 1),
+        (180_000_000, 2016, 1, 1),
+        (250_000_000, 2016, 6, 1),
+        (330_000_000, 2017, 1, 1),
+        (400_000_000, 2017, 6, 1),
+        (500_000_000, 2018, 1, 1),
+        (600_000_000, 2018, 6, 1),
+        (750_000_000, 2019, 1, 1),
+        (900_000_000, 2019, 6, 1),
+        (1_050_000_000, 2020, 1, 1),
+        (1_250_000_000, 2020, 6, 1),
+        (1_550_000_000, 2021, 1, 1),
+        (1_850_000_000, 2021, 6, 1),
+        (5_100_000_000, 2022, 1, 1),
+        (5_450_000_000, 2022, 6, 1),
+        (5_900_000_000, 2023, 1, 1),
+        (6_300_000_000, 2023, 6, 1),
+        (6_744_993_914, 2023, 10, 31),
+        (6_950_000_000, 2024, 1, 1),
+        (7_300_000_000, 2024, 6, 1),
+        (7_800_000_000, 2025, 1, 1),
+        (8_300_000_000, 2025, 6, 1),
+        (8_800_000_000, 2026, 1, 1),
+        (9_400_000_000, 2026, 10, 1)
+    ]
+    let monthsRu = [
+        "января", "февраля", "марта", "апреля", "мая", "июня",
+        "июля", "августа", "сентября", "октября", "ноября", "декабря"
+    ]
+    if userId <= milestones[0].0 {
+        return "14 августа 2013"
+    } else if userId >= milestones.last!.0 {
+        return "октября 2026"
+    }
+    for i in 0 ..< (milestones.count - 1) {
+        let m1 = milestones[i]
+        let m2 = milestones[i + 1]
+        if userId >= m1.0 && userId <= m2.0 {
+            let progress = Double(userId - m1.0) / Double(m2.0 - m1.0)
+            let cal = Calendar(identifier: .gregorian)
+            var c1 = DateComponents()
+            c1.year = m1.1; c1.month = m1.2; c1.day = m1.3
+            var c2 = DateComponents()
+            c2.year = m2.1; c2.month = m2.2; c2.day = m2.3
+            if let d1 = cal.date(from: c1), let d2 = cal.date(from: c2) {
+                let totalSec = d2.timeIntervalSince(d1)
+                let targetDate = d1.addingTimeInterval(totalSec * progress)
+                let comps = cal.dateComponents([.year, .month, .day], from: targetDate)
+                let day = comps.day ?? 1
+                let month = comps.month ?? 1
+                let year = comps.year ?? 2023
+                let monthName = monthsRu[max(0, min(11, month - 1))]
+                return "\(day) \(monthName) \(year)"
+            }
+            break
+        }
+    }
+    return "неизвестно"
+}
