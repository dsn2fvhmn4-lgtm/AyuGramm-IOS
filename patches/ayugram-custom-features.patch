+
+/// Full-screen music player in the style of Apple Music: blurred artwork backdrop, large cover,
+/// scrubber, transport controls, system volume, AirPlay, and time-synced lyrics. The queue
+/// button opens Telegram's playlist screen, which keeps track picking and saved-music editing.
+final class AyuMusicPlayerController: ViewController, OverlayAudioPlayerController {
+    private let context: AccountContext
+    private let chatLocation: ChatLocation
+    private let type: MediaManagerPlayerType
+    private let initialMessageId: EngineMessage.Id
+    private let initialOrder: MusicPlaybackSettingsOrder
+    private let playlistLocation: SharedMediaPlaylistLocation?
+    private weak var parentNavigationController: NavigationController?
+
+    private var playerView: AyuMusicPlayerView?
+    private var animatedIn = false
+    private var accountInUseDisposable: Disposable?
+
+    init(
+        context: AccountContext,
+        chatLocation: ChatLocation,
+        type: MediaManagerPlayerType,
+        initialMessageId: EngineMessage.Id,
+        initialOrder: MusicPlaybackSettingsOrder,
+        playlistLocation: SharedMediaPlaylistLocation?,
+        parentNavigationController: NavigationController?
+    ) {
+        self.context = context
+        self.chatLocation = chatLocation
+        self.type = type
+        self.initialMessageId = initialMessageId
+        self.initialOrder = initialOrder
+        self.playlistLocation = playlistLocation
+        self.parentNavigationController = parentNavigationController
+
+        super.init(navigationBarPresentationData: nil)
+
+        self.statusBar.statusBarStyle = .White
+        self.accountInUseDisposable = context.sharedContext.setAccountUserInterfaceInUse(context.account.id)
+    }
+
+    required init(coder aDecoder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    deinit {
+        self.accountInUseDisposable?.dispose()
+    }
+
+    override func loadDisplayNode() {
+        self.displayNode = ASDisplayNode()
+        self.displayNode.backgroundColor = .clear
+        self.displayNodeDidLoad()
+
+        let playerView = AyuMusicPlayerView(context: self.context, type: self.type)
+        playerView.requestDismiss = { [weak self] in
+            self?.dismiss()
+        }
+        playerView.openQueue = { [weak self] in
+            self?.openQueue()
+        }
+        self.playerView = playerView
+        self.displayNode.view.addSubview(playerView)
+    }
+
+    override func viewDidAppear(_ animated: Bool) {
+        super.viewDidAppear(animated)
+        if !self.animatedIn {
+            self.animatedIn = true
+            self.playerView?.animateIn()
+        }
+    }
+
+    override func dismiss(completion: (() -> Void)? = nil) {
+        guard let playerView = self.playerView else {
+            self.finishDismiss(completion: completion)
+            return
+        }
+        playerView.animateOut(completion: { [weak self] in
+            self?.finishDismiss(completion: completion)
+        })
+    }
+
+    private func finishDismiss(completion: (() -> Void)?) {
+        if let _ = self.navigationController {
+            self.dismiss(animated: false, completion: nil)
+        } else {
+            self.presentingViewController?.dismiss(animated: false, completion: nil)
+        }
+        completion?()
+    }
+
+    override func containerLayoutUpdated(_ layout: ContainerViewLayout, transition: ContainedViewLayoutTransition) {
+        super.containerLayoutUpdated(layout, transition: transition)
+        guard let playerView = self.playerView else {
+            return
+        }
+        playerView.frame = CGRect(origin: CGPoint(), size: layout.size)
+        playerView.safeInsets = UIEdgeInsets(top: max(layout.statusBarHeight ?? 0.0, layout.safeInsets.top), left: layout.safeInsets.left, bottom: max(layout.intrinsicInsets.bottom, layout.safeInsets.bottom), right: layout.safeInsets.right)
+        playerView.setNeedsLayout()
+    }
+
+    /// Telegram's own playlist screen, for picking another track from the chat.
+    private func openQueue() {
+        guard let navigationController = self.parentNavigationController ?? (self.navigationController as? NavigationController) else {
+            return
+        }
+        let queue = OverlayAudioPlayerControllerImpl(
+            context: self.context,
+            chatLocation: self.chatLocation,
+            type: self.type,
+            initialMessageId: self.initialMessageId,
+            initialOrder: self.initialOrder,
+            playlistLocation: self.playlistLocation,
+            parentNavigationController: navigationController
+        )
+        queue.navigationPresentation = .flatModal
+        navigationController.pushViewController(queue)
+    }
+}
+
+private func ayuFormatTime(_ seconds: Double) -> String {
+    let total = max(0, Int(seconds.isFinite ? seconds.rounded(.down) : 0.0))
+    let hours = total / 3600
+    let minutes = (total % 3600) / 60
+    let secs = total % 60
+    if hours > 0 {
+        return String(format: "%d:%02d:%02d", hours, minutes, secs)
+    }
+    return String(format: "%d:%02d", minutes, secs)
+}
+
+private func ayuSymbol(_ name: String, size: CGFloat, weight: UIImage.SymbolWeight = .regular) -> UIImage? {
+    return UIImage(systemName: name, withConfiguration: UIImage.SymbolConfiguration(pointSize: size, weight: weight))
+}
