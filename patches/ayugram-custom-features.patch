+private func ayuFetchRegistrationDate(
+    context: AccountContext,
+    userId: Int64,
+    isSelf: Bool,
+    userName: String,
+    ru: Bool,
+    completion: @escaping (String) -> Void
+) {
+    let fallbackMessage: () -> String = {
+        let est = ayuEstimatedRegistrationDate(userId: userId)
+        if isSelf {
+            return ru ? "Вы создали свой аккаунт примерно \(est)." : "You created your account approximately on \(est)."
+        } else {
+            return ru ? "\(userName) создал(а) свой аккаунт примерно \(est)." : "\(userName) created their account approximately on \(est)."
+        }
+    }
+
+    let queryBot: (EnginePeer.Id) -> Signal<RequestChatContextResultsResult?, NoError> = { botId in
+        return requestContextResults(
+            engine: context.engine,
+            botId: botId,
+            query: "regdate \(userId)",
+            peerId: context.account.peerId
+        )
+    }
+
+    let parseDateResult: (RequestChatContextResultsResult?) -> String? = { resultsStruct in
+        guard let results = resultsStruct?.results.results else { return nil }
+        for res in results {
+            let msgText: String?
+            switch res {
+            case let .externalReference(external):
+                if case let .text(text, _, _, _, _, _) = external.message {
+                    msgText = text
+                } else {
+                    msgText = nil
+                }
+            case let .internalReference(internalRef):
+                if case let .text(text, _, _, _, _, _) = internalRef.message {
+                    msgText = text
+                } else {
+                    msgText = nil
+                }
+            }
+            guard let text = msgText, !text.isEmpty, text != "failed",
+                  let data = text.data(using: .utf8),
+                  let json = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
+                  let dateStr = json["date"] as? String else {
+                continue
+            }
+            let flag = json["flag"] as? String ?? "EXACT"
+            let parts = dateStr.split(separator: ".")
+            guard parts.count == 3, let day = Int(parts[0]), let month = Int(parts[1]), let year = Int(parts[2]) else {
+                continue
+            }
+            let ruMonths = ["января", "февраля", "марта", "апреля", "мая", "июня", "июля", "августа", "сентября", "октября", "ноября", "декабря"]
+            let enMonths = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]
+            let monthName = (ru && month >= 1 && month <= 12) ? ruMonths[month - 1] : (month >= 1 && month <= 12 ? enMonths[month - 1] : "\(month)")
+            let currentYear = Calendar.current.component(.year, from: Date())
+            let formattedDate: String
+            if year == currentYear {
+                formattedDate = ru ? "\(day) \(monthName)" : "\(monthName) \(day)"
+            } else {
+                formattedDate = ru ? "\(day) \(monthName) \(year)" : "\(monthName) \(day), \(year)"
+            }
+            if isSelf {
+                if flag == "LT" {
+                    return ru ? "Вы создали свой аккаунт ранее \(formattedDate)." : "You created your account earlier than \(formattedDate)."
+                } else if flag == "ET" {
+                    return ru ? "Вы создали свой аккаунт позднее \(formattedDate)." : "You created your account later than \(formattedDate)."
+                } else {
+                    return ru ? "Вы создали свой аккаунт примерно \(formattedDate)." : "You created your account approximately on \(formattedDate)."
+                }
+            } else {
+                if flag == "LT" {
+                    return ru ? "\(userName) создал(а) свой аккаунт ранее \(formattedDate)." : "\(userName) created their account earlier than \(formattedDate)."
+                } else if flag == "ET" {
+                    return ru ? "\(userName) создал(а) свой аккаунт позднее \(formattedDate)." : "\(userName) created their account later than \(formattedDate)."
+                } else {
+                    return ru ? "\(userName) создал(а) свой аккаунт примерно \(formattedDate)." : "\(userName) created their account approximately on \(formattedDate)."
+                }
+            }
+        }
+        return nil
+    }
+
+    let disposable = MetaDisposable()
+    let signal = context.engine.peers.resolvePeerByName(name: "exteraAuthBot", referrer: nil)
+    |> mapToSignal { res -> Signal<RequestChatContextResultsResult?, NoError> in
+        switch res {
+        case .progress:
+            return .complete()
+        case let .result(peer):
+            if let peer = peer {
+                return queryBot(peer.id)
+            } else {
+                return context.engine.peers.resolvePeerByName(name: "ayugrambot", referrer: nil)
+                |> mapToSignal { fallbackRes -> Signal<RequestChatContextResultsResult?, NoError> in
+                    switch fallbackRes {
+                    case .progress:
+                        return .complete()
+                    case let .result(fallbackPeer):
+                        if let fallbackPeer = fallbackPeer {
+                            return queryBot(fallbackPeer.id)
+                        } else {
+                            return .single(nil)
+                        }
+                    }
+                }
+            }
+        }
+    }
+    |> deliverOnMainQueue
+
+    disposable.set(signal.start(next: { result in
+        if let msg = parseDateResult(result) {
+            completion(msg)
+        } else {
+            completion(fallbackMessage())
+        }
+        disposable.dispose()
+    }))
+}
