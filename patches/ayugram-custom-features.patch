diff --git a/submodules/TelegramUI/Sources/AyuLyrics.swift b/submodules/TelegramUI/Sources/AyuLyrics.swift
new file mode 100644
index 00000000..102449e7
--- /dev/null
+++ b/submodules/TelegramUI/Sources/AyuLyrics.swift
@@ -0,0 +1,240 @@
+import Foundation
+import SwiftSignalKit
+
+/// One word of a synced line with the moment it starts.
+struct AyuLyricsWord: Equatable {
+    let time: Double
+    let text: String
+}
+
+/// One line of time-synced lyrics, split into timed words for word-by-word highlighting.
+struct AyuLyricsLine: Equatable {
+    let time: Double
+    let text: String
+    let words: [AyuLyricsWord]
+}
+
+enum AyuLyrics: Equatable {
+    /// Lines with timestamps, sorted by time; highlighted as the track plays.
+    case synced([AyuLyricsLine])
+    /// Lyrics without timing, shown as static text.
+    case plain(String)
+    case instrumental
+    case notFound
+}
+
+private func ayuParseLrcTime(_ tag: Substring) -> Double? {
+    let parts = tag.split(separator: ":")
+    guard parts.count == 2, let minutes = Double(parts[0]), let seconds = Double(parts[1].replacingOccurrences(of: ",", with: ".")) else {
+        return nil
+    }
+    return minutes * 60.0 + seconds
+}
+
+/// Splits a line body into words. Enhanced LRC ("<mm:ss.xx>word") gives each word its own
+/// time; plain words get nil and are timed later from the line's length.
+private func ayuParseLrcWords(_ body: Substring) -> [(time: Double?, text: String)] {
+    var result: [(time: Double?, text: String)] = []
+    var pendingTime: Double?
+    var current = ""
+    func flush() {
+        let trimmed = current.trimmingCharacters(in: .whitespaces)
+        if !trimmed.isEmpty {
+            for (index, piece) in trimmed.split(separator: " ", omittingEmptySubsequences: true).enumerated() {
+                result.append((time: index == 0 ? pendingTime : nil, text: String(piece)))
+            }
+        }
+        current = ""
+        pendingTime = nil
+    }
+    var rest = body
+    while let first = rest.first {
+        if first == "<", let close = rest.firstIndex(of: ">"), let time = ayuParseLrcTime(rest[rest.index(after: rest.startIndex) ..< close]) {
+            flush()
+            pendingTime = time
+            rest = rest[rest.index(after: close)...]
+        } else {
+            current.append(first)
+            rest = rest.dropFirst()
+        }
+    }
+    flush()
+    return result
+}
+
+/// Parses LRC text ("[mm:ss.xx] line"); a line may carry several time tags, and words may
+/// carry enhanced "<mm:ss.xx>" tags. Words without their own time are spread over the line,
+/// longer words taking longer, until the next line starts.
+func ayuParseLrc(_ text: String) -> [AyuLyricsLine] {
+    var raw: [(time: Double, words: [(time: Double?, text: String)])] = []
+    for rawLine in text.components(separatedBy: .newlines) {
+        var rest = Substring(rawLine)
+        var times: [Double] = []
+        while rest.hasPrefix("["), let close = rest.firstIndex(of: "]") {
+            if let time = ayuParseLrcTime(rest[rest.index(after: rest.startIndex) ..< close]) {
+                times.append(time)
+            }
+            rest = rest[rest.index(after: close)...]
+        }
+        let words = ayuParseLrcWords(rest)
+        for time in times {
+            raw.append((time: time, words: words))
+        }
+    }
+    raw.sort(by: { $0.time < $1.time })
+
+    var lines: [AyuLyricsLine] = []
+    for (index, line) in raw.enumerated() {
+        let nextTime = index + 1 < raw.count ? raw[index + 1].time : line.time + 5.0
+        // Sing the line in at most 90% of the gap, and no slower than ~0.6 s per word.
+        let span = max(0.3, min((nextTime - line.time) * 0.9, Double(max(1, line.words.count)) * 0.6))
+        let weights = line.words.map { Double($0.text.count + 2) }
+        let totalWeight = max(1.0, weights.reduce(0.0, +))
+        var words: [AyuLyricsWord] = []
+        var cursor = line.time
+        for (wordIndex, word) in line.words.enumerated() {
+            let time = word.time ?? cursor
+            words.append(AyuLyricsWord(time: time, text: word.text))
+            cursor = max(cursor, time) + span * weights[wordIndex] / totalWeight
+        }
+        lines.append(AyuLyricsLine(time: line.time, text: line.words.map { $0.text }.joined(separator: " "), words: words))
+    }
+    return lines
+}
+
+/// Looks lyrics up on LRCLIB (lrclib.net), an open lyrics database. Only the track title,
+/// artist and duration are sent, and only when the user opens the lyrics view.
+func ayuFetchLyrics(title: String, artist: String?, duration: Double) -> Signal<AyuLyrics, NoError> {
+    return Signal { subscriber in
+        let request = AyuLyricsRequest(title: title, artist: artist, duration: duration, completion: { result in
+            subscriber.putNext(result)
+            subscriber.putCompletion()
+        })
+        request.start()
+        return ActionDisposable {
+            request.cancel()
+        }
+    }
+}
+
+private final class AyuLyricsRequest {
+    private let title: String
+    private let artist: String?
+    private let duration: Double
+    private let completion: (AyuLyrics) -> Void
+    private let session = URLSession(configuration: .ephemeral)
+    private let lock = NSLock()
+    private var cancelled = false
+
+    init(title: String, artist: String?, duration: Double, completion: @escaping (AyuLyrics) -> Void) {
+        self.title = title
+        self.artist = artist
+        self.duration = duration
+        self.completion = completion
+    }
+
+    func start() {
+        var components = URLComponents(string: "https://lrclib.net/api/get")
+        var items = [URLQueryItem(name: "track_name", value: self.title)]
+        if let artist = self.artist, !artist.isEmpty {
+            items.append(URLQueryItem(name: "artist_name", value: artist))
+        }
+        if self.duration > 0.0 {
+            items.append(URLQueryItem(name: "duration", value: "\(Int(self.duration.rounded()))"))
+        }
+        components?.queryItems = items
+        guard let url = components?.url, self.artist != nil else {
+            self.search()
+            return
+        }
+        self.load(url, completion: { [weak self] json in
+            guard let self else {
+                return
+            }
+            if let record = json as? [String: Any], let result = AyuLyricsRequest.lyrics(from: record) {
+                self.finish(result)
+            } else {
+                self.search()
+            }
+        })
+    }
+
+    func cancel() {
+        self.lock.lock()
+        self.cancelled = true
+        self.lock.unlock()
+        self.session.invalidateAndCancel()
+    }
+
+    private var isCancelled: Bool {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return self.cancelled
+    }
+
+    private func finish(_ result: AyuLyrics) {
+        if !self.isCancelled {
+            self.completion(result)
+        }
+    }
+
+    private func search() {
+        var components = URLComponents(string: "https://lrclib.net/api/search")
+        components?.queryItems = [URLQueryItem(name: "q", value: [self.artist, self.title].compactMap { $0 }.joined(separator: " "))]
+        guard let url = components?.url else {
+            self.finish(.notFound)
+            return
+        }
+        let duration = self.duration
+        self.load(url, completion: { [weak self] json in
+            guard let self else {
+                return
+            }
+            let records = json as? [[String: Any]] ?? []
+            // Prefer synced lyrics whose length matches the track.
+            let ranked = records.sorted(by: { lhs, rhs in
+                let lhsSynced = lhs["syncedLyrics"] is String
+                let rhsSynced = rhs["syncedLyrics"] is String
+                if lhsSynced != rhsSynced {
+                    return lhsSynced
+                }
+                let lhsDelta = abs((lhs["duration"] as? Double ?? 0.0) - duration)
+                let rhsDelta = abs((rhs["duration"] as? Double ?? 0.0) - duration)
+                return lhsDelta < rhsDelta
+            })
+            self.finish(ranked.lazy.compactMap(AyuLyricsRequest.lyrics(from:)).first ?? .notFound)
+        })
+    }
+
+    private func load(_ url: URL, completion: @escaping (Any?) -> Void) {
+        if self.isCancelled {
+            return
+        }
+        var request = URLRequest(url: url)
+        request.timeoutInterval = 15.0
+        request.setValue("AyuGramm-IOS (https://github.com/dsn2fvhmn4-lgtm/AyuGramm-IOS)", forHTTPHeaderField: "User-Agent")
+        self.session.dataTask(with: request, completionHandler: { data, response, _ in
+            guard let http = response as? HTTPURLResponse, http.statusCode == 200, let data else {
+                completion(nil)
+                return
+            }
+            completion(try? JSONSerialization.jsonObject(with: data))
+        }).resume()
+    }
+
+    private static func lyrics(from record: [String: Any]) -> AyuLyrics? {
+        if let synced = record["syncedLyrics"] as? String {
+            let lines = ayuParseLrc(synced)
+            if !lines.isEmpty {
+                return .synced(lines)
+            }
+        }
+        if let plain = record["plainLyrics"] as? String, !plain.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty {
+            return .plain(plain)
+        }
+        if record["instrumental"] as? Bool == true {
+            return .instrumental
+        }
+        return nil
+    }
+}
