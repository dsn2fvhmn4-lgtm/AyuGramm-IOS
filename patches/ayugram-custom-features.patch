+        let pan = UIPanGestureRecognizer(target: self, action: #selector(self.dismissPan(_:)))
+        self.addGestureRecognizer(pan)
+
+        self.stateDisposable = (context.sharedContext.mediaManager.musicMediaPlayerState
+        |> deliverOnMainQueue).startStrict(next: { [weak self] value in
+            self?.update(state: value)
+        })
+
+        let displayLink = CADisplayLink(target: AyuWeakTarget(self), selector: #selector(AyuWeakTarget.tick))
+        displayLink.preferredFramesPerSecond = 30
