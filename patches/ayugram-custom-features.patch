+        self.lyricsButton.accessibilityLabel = self.russian ? "Слова" : "Lyrics"
+        self.lyricsButton.addTarget(self, action: #selector(self.lyricsPressed), for: .touchUpInside)
+        self.queueButton.setImage(ayuSymbol("list.bullet", size: 19.0, weight: .medium), for: .normal)
+        self.queueButton.accessibilityLabel = self.russian ? "Очередь" : "Queue"
+        self.queueButton.addTarget(self, action: #selector(self.queuePressed), for: .touchUpInside)
+        self.routePicker.tintColor = UIColor(white: 1.0, alpha: 0.75)
+        self.routePicker.activeTintColor = .white
+        self.addSubview(self.routePicker)
