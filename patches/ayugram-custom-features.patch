+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    @objc private func userScrolled() {
+        self.userScrollUntil = CACurrentMediaTime() + 3.0
+    }
+
+    func set(lyrics: AyuLyrics?, loading: Bool, russian: Bool) {
+        for label in self.lineLabels {
+            label.removeFromSuperview()
+        }
+        self.lineLabels = []
+        self.lines = []
+        self.currentIndex = nil
+        self.currentLitWords = nil
+        self.scrollView.contentOffset = CGPoint()
+
+        var status: String?
+        var texts: [String] = []
+        if loading {
+            status = russian ? "Ищем слова…" : "Looking for lyrics…"
+        } else if let lyrics {
+            switch lyrics {
+            case let .synced(lines):
+                self.lines = lines
+                texts = lines.map { $0.text.isEmpty ? "♪" : $0.text }
+            case let .plain(text):
+                texts = text.components(separatedBy: .newlines)
+            case .instrumental:
+                status = russian ? "Инструментальная композиция" : "Instrumental"
+            case .notFound:
+                status = russian ? "Слова для этого трека не найдены" : "No lyrics found for this track"
+            }
+        }
+        self.statusLabel.text = status
+        self.statusLabel.isHidden = status == nil
+        let synced = !self.lines.isEmpty
+        for (index, text) in texts.enumerated() {
+            let label = UILabel()
+            label.text = text
+            label.numberOfLines = 0
+            label.font = .systemFont(ofSize: synced ? 30.0 : 24.0, weight: .bold)
+            label.textColor = UIColor(white: 1.0, alpha: synced ? 0.32 : 0.85)
+            label.tag = index
+            if synced {
+                label.isUserInteractionEnabled = true
+                label.addGestureRecognizer(UITapGestureRecognizer(target: self, action: #selector(self.lineTapped(_:))))
+            }
+            self.scrollView.addSubview(label)
+            self.lineLabels.append(label)
+            if synced {
+                label.attributedText = self.attributedLine(index, litWords: 0)
+            }
+        }
+        self.setNeedsLayout()
+    }
+
+    /// A synced line with its first `litWords` words lit and the rest dimmed.
+    private func attributedLine(_ index: Int, litWords: Int) -> NSAttributedString {
+        let font = self.lineLabels[index].font ?? .systemFont(ofSize: 30.0, weight: .bold)
+        let words = self.lines[index].words
+        if words.isEmpty {
+            return NSAttributedString(string: "♪", attributes: [.font: font, .foregroundColor: litWords > 0 ? UIColor.white : self.dimColor])
+        }
+        let result = NSMutableAttributedString()
+        for (wordIndex, word) in words.enumerated() {
+            if wordIndex > 0 {
+                result.append(NSAttributedString(string: " ", attributes: [.font: font]))
+            }
+            result.append(NSAttributedString(string: word.text, attributes: [.font: font, .foregroundColor: wordIndex < litWords ? UIColor.white : self.dimColor]))
+        }
+        return result
+    }
+
+    @objc private func lineTapped(_ recognizer: UITapGestureRecognizer) {
+        guard let index = recognizer.view?.tag, index >= 0, index < self.lines.count else {
+            return
+        }
+        self.userScrollUntil = 0.0
+        self.seek?(self.lines[index].time)
+    }
+
+    override func layoutSubviews() {
+        super.layoutSubviews()
+        self.layer.mask?.frame = self.bounds
+        self.scrollView.frame = self.bounds
+        self.statusLabel.frame = self.bounds.insetBy(dx: 32.0, dy: 0.0)
+        let side: CGFloat = 28.0
+        let width = self.bounds.width - side * 2.0
+        var y: CGFloat = self.bounds.height * 0.2
+        for label in self.lineLabels {
+            let size = label.sizeThatFits(CGSize(width: width, height: .greatestFiniteMagnitude))
+            label.bounds = CGRect(origin: CGPoint(), size: CGSize(width: width, height: ceil(size.height)))
+            label.center = CGPoint(x: side + width / 2.0, y: y + ceil(size.height) / 2.0)
+            y += ceil(size.height) + (self.lines.isEmpty ? 6.0 : 22.0)
+        }
+        self.scrollView.contentSize = CGSize(width: self.bounds.width, height: y + self.bounds.height * 0.5)
+    }
+
+    func update(timestamp: Double) {
+        guard !self.lines.isEmpty else {
+            return
+        }
+        var index: Int?
+        for (i, line) in self.lines.enumerated() {
+            if line.time <= timestamp + 0.15 {
+                index = i
+            } else {
+                break
+            }
+        }
+        if index != self.currentIndex {
+            let previous = self.currentIndex
+            self.currentIndex = index
+            self.currentLitWords = nil
+            if let previous, previous < self.lineLabels.count {
+                self.lineLabels[previous].attributedText = self.attributedLine(previous, litWords: 0)
+            }
+            UIView.animate(withDuration: 0.35, delay: 0.0, options: [.beginFromCurrentState, .allowUserInteraction], animations: {
+                if let previous, previous < self.lineLabels.count {
+                    self.lineLabels[previous].transform = .identity
+                }
+                if let index, index < self.lineLabels.count {
+                    self.lineLabels[index].transform = CGAffineTransform(scaleX: 1.03, y: 1.03)
+                }
+            })
+            if let index, index < self.lineLabels.count, CACurrentMediaTime() > self.userScrollUntil {
+                let label = self.lineLabels[index]
+                let targetY = max(0.0, min(label.frame.minY - self.bounds.height * 0.25, self.scrollView.contentSize.height - self.bounds.height))
+                UIView.animate(withDuration: 0.6, delay: 0.0, usingSpringWithDamping: 0.9, initialSpringVelocity: 0.0, options: [.beginFromCurrentState, .allowUserInteraction], animations: {
+                    self.scrollView.contentOffset = CGPoint(x: 0.0, y: targetY)
+                })
+            }
+        }
+        // Light the current line word by word as each word is sung.
+        guard let index, index < self.lineLabels.count else {
+            return
+        }
+        let words = self.lines[index].words
+        var litWords = words.isEmpty ? 1 : 0
+        for word in words {
+            if word.time <= timestamp + 0.05 {
+                litWords += 1
+            } else {
+                break
+            }
+        }
+        if litWords != self.currentLitWords {
+            self.currentLitWords = litWords
+            let label = self.lineLabels[index]
+            let text = self.attributedLine(index, litWords: litWords)
+            UIView.transition(with: label, duration: 0.15, options: [.transitionCrossDissolve, .allowUserInteraction], animations: {
+                label.attributedText = text
+            })
+        }
+    }
+}
