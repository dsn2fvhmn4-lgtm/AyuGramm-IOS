+    // MARK: State
+
+    private func update(state value: (Account, SharedMediaPlayerItemPlaybackStateOrLoading, MediaManagerPlayerType)?) {
+        guard let (account, stateOrLoading, _) = value, account.id == self.context.account.id else {
+            // Playback stopped after a track was shown: close, like the header panel does.
+            if value == nil && self.hadState {
+                self.requestDismiss?()
+            }
+            return
+        }
+        guard case let .state(state) = stateOrLoading else {
+            return
+        }
+        self.hadState = true
+
+        self.status = state.status
+        let isPaused: Bool
+        switch state.status.status {
+        case .playing:
+            isPaused = false
+        case .paused:
+            isPaused = true
+        case let .buffering(_, whilePlaying, _, _):
+            isPaused = !whilePlaying
+        }
+        if isPaused != self.isPaused {
+            self.isPaused = isPaused
+            self.playPauseButton.setImage(ayuSymbol(isPaused ? "play.fill" : "pause.fill", size: 44.0), for: .normal)
+            self.playPauseButton.accessibilityLabel = isPaused ? (self.russian ? "Воспроизвести" : "Play") : (self.russian ? "Пауза" : "Pause")
+            self.updateArtworkScale(animated: true)
+        }
+
+        var title: String?
+        var performer: String?
+        var albumArt: SharedMediaPlaybackAlbumArt?
+        if let displayData = state.item.displayData, case let .music(titleValue, performerValue, albumArtValue, _, _) = displayData {
+            title = titleValue
+            performer = performerValue
+            albumArt = albumArtValue
+        }
+        var fileReference: FileMediaReference?
+        if let source = state.item.playbackData?.source, case let .telegramFile(reference, _, _) = source {
+            fileReference = reference
+            if title == nil {
+                title = reference.media.fileName
+            }
+        }
+
+        let trackKey = "\(state.item.stableId.hashValue)-\(title ?? "")-\(performer ?? "")"
+        if trackKey != self.trackKey {
+            self.trackKey = trackKey
+            self.title = title ?? (self.russian ? "Неизвестный трек" : "Unknown Track")
+            self.artist = performer
+            self.titleLabel.text = self.title
+            self.artistLabel.text = performer ?? (self.russian ? "Неизвестный исполнитель" : "Unknown Artist")
+            let emptyColor = UIColor(white: 0.22, alpha: 1.0)
+            self.artworkNode.setSignal(playerAlbumArt(engine: self.context.engine, fileReference: fileReference, albumArt: albumArt, thumbnail: false, emptyColor: emptyColor))
+            self.backdropNode.setSignal(playerAlbumArt(engine: self.context.engine, fileReference: fileReference, albumArt: albumArt, thumbnail: true, emptyColor: emptyColor, drawPlaceholderWhenEmpty: false))
+            if self.showsLyrics {
+                self.loadLyrics()
+            } else {
+                self.lyricsView.set(lyrics: nil, loading: false, russian: self.russian)
+                self.lyricsTrackKey = nil
+            }
+            self.setNeedsLayout()
+        }
+        self.tick()
+    }
+
+    private func currentTimestamp() -> Double {
+        guard let status = self.status else {
+            return 0.0
+        }
+        var timestamp = status.timestamp
+        if status.generationTimestamp > 0.0, case .playing = status.status {
+            timestamp += (CACurrentMediaTime() - status.generationTimestamp) * status.baseRate
+        }
+        return max(0.0, min(timestamp, status.duration > 0.0 ? status.duration : timestamp))
+    }
+
+    @objc fileprivate func tick() {
+        guard let status = self.status else {
+            return
+        }
+        let timestamp = self.currentTimestamp()
+        if !self.isScrubbing {
+            self.scrubber.progress = status.duration > 0.0 ? CGFloat(timestamp / status.duration) : 0.0
+            self.elapsedLabel.text = ayuFormatTime(timestamp)
+            self.remainingLabel.text = "-" + ayuFormatTime(max(0.0, status.duration - timestamp))
+        }
+        if self.showsLyrics {
+            self.lyricsView.update(timestamp: timestamp)
+        }
+    }
+
+    private func control(_ action: SharedMediaPlayerControlAction) {
+        self.context.sharedContext.mediaManager.playlistControl(action, type: self.type)
+    }
+
+    private func scrubbed(to fraction: CGFloat, finished: Bool) {
+        guard let status = self.status, status.duration > 0.0 else {
+            return
+        }
+        let timestamp = Double(fraction) * status.duration
+        self.isScrubbing = !finished
+        self.elapsedLabel.text = ayuFormatTime(timestamp)
+        self.remainingLabel.text = "-" + ayuFormatTime(max(0.0, status.duration - timestamp))
+        if finished {
+            self.control(.seek(timestamp))
+        }
+    }
+
+    // MARK: Actions
+
+    @objc private func previousPressed() {
+        self.control(.previous)
+    }
+
+    @objc private func playPausePressed() {
+        self.control(.playback(.togglePlayPause))
+    }
+
+    @objc private func nextPressed() {
+        self.control(.next)
+    }
+
+    @objc private func queuePressed() {
+        self.openQueue?()
+    }
+
+    @objc private func lyricsPressed() {
+        self.showsLyrics = !self.showsLyrics
+        self.updateLyricsButton()
+        if self.showsLyrics {
+            self.loadLyrics()
+            self.lyricsView.isHidden = false
+        }
+        UIView.animate(withDuration: 0.45, delay: 0.0, usingSpringWithDamping: 0.86, initialSpringVelocity: 0.0, options: [.beginFromCurrentState], animations: {
+            self.lyricsView.alpha = self.showsLyrics ? 1.0 : 0.0
+            self.layoutContent()
+        }, completion: { _ in
+            if !self.showsLyrics {
+                self.lyricsView.isHidden = true
+            }
+        })
+        self.tick()
+    }
+
+    private func updateLyricsButton() {
+        self.lyricsButton.setImage(ayuSymbol(self.showsLyrics ? "quote.bubble.fill" : "quote.bubble", size: 19.0, weight: .medium), for: .normal)
+        self.lyricsButton.tintColor = self.showsLyrics ? .white : UIColor(white: 1.0, alpha: 0.75)
+    }
+
+    private func loadLyrics() {
+        guard let trackKey = self.trackKey, self.lyricsTrackKey != trackKey else {
+            return
+        }
+        self.lyricsTrackKey = trackKey
+        self.lyricsView.set(lyrics: nil, loading: true, russian: self.russian)
+        let duration = self.status?.duration ?? 0.0
+        self.lyricsDisposable?.dispose()
+        self.lyricsDisposable = (ayuFetchLyrics(title: self.title, artist: self.artist, duration: duration)
+        |> deliverOnMainQueue).startStrict(next: { [weak self] lyrics in
+            guard let self, self.lyricsTrackKey == trackKey else {
+                return
+            }
+            self.lyricsView.set(lyrics: lyrics, loading: false, russian: self.russian)
+            self.tick()
+        })
+    }
