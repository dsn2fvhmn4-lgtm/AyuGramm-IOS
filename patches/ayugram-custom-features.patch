+        self.volumeMaxIcon.frame = CGRect(x: left + contentWidth - 22.0, y: volumeTrackY - 12.0, width: 22.0, height: 24.0)
+
+        let transportCenterY = volumeY - 62.0
+        let transportSpacing = min(110.0, contentWidth / 3.0)
+        self.playPauseButton.frame = CGRect(x: left + contentWidth / 2.0 - 36.0, y: transportCenterY - 36.0, width: 72.0, height: 72.0)
+        self.previousButton.frame = CGRect(x: left + contentWidth / 2.0 - transportSpacing - 30.0, y: transportCenterY - 30.0, width: 60.0, height: 60.0)
