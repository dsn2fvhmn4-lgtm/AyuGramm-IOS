+        self.grabber.frame = CGRect(x: floor((size.width - 36.0) / 2.0), y: insets.top + 6.0, width: 36.0, height: 5.0)
+
+        // Bottom-up: utility row, volume, transport, scrubber, title.
+        let bottomRowY = size.height - insets.bottom - 16.0 - 44.0
