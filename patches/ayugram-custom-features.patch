+        self.lyricsButton.frame = CGRect(x: rowCenters[0] - 22.0, y: bottomRowY, width: 44.0, height: 44.0)
+        self.routePicker.frame = CGRect(x: rowCenters[1] - 22.0, y: bottomRowY, width: 44.0, height: 44.0)
