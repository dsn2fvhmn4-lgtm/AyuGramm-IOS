+
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+        self.scrollView.showsVerticalScrollIndicator = false
+        self.scrollView.alwaysBounceVertical = true
+        self.scrollView.delegate = nil
+        self.addSubview(self.scrollView)
+        self.statusLabel.font = .systemFont(ofSize: 17.0, weight: .semibold)
+        self.statusLabel.textColor = UIColor(white: 1.0, alpha: 0.6)
+        self.statusLabel.textAlignment = .center
+        self.statusLabel.numberOfLines = 0
+        self.addSubview(self.statusLabel)
+        self.scrollView.panGestureRecognizer.addTarget(self, action: #selector(self.userScrolled))
+        // Fade lines out at the top and bottom edges.
+        let mask = CAGradientLayer()
+        mask.colors = [UIColor.clear.cgColor, UIColor.black.cgColor, UIColor.black.cgColor, UIColor.clear.cgColor]
+        mask.locations = [0.0, 0.08, 0.85, 1.0]
