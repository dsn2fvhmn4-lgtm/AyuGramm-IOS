+/// Thin Apple Music style progress bar that thickens while dragged.
+private final class AyuMusicScrubber: UIView {
+    var onScrub: ((CGFloat) -> Void)?
+    var onSeek: ((CGFloat) -> Void)?
+
+    private let track = UIView()
+    private let fill = UIView()
+    private var dragging = false
+    private var dragProgress: CGFloat = 0.0
+
+    var progress: CGFloat = 0.0 {
+        didSet {
+            if !self.dragging {
+                self.layoutBar()
+            }
+        }
+    }
+
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+        self.track.backgroundColor = UIColor(white: 1.0, alpha: 0.22)
+        self.fill.backgroundColor = UIColor(white: 1.0, alpha: 0.8)
+        self.track.clipsToBounds = true
+        self.track.addSubview(self.fill)
+        self.addSubview(self.track)
+        let pan = UIPanGestureRecognizer(target: self, action: #selector(self.panned(_:)))
+        self.addGestureRecognizer(pan)
+        let tap = UITapGestureRecognizer(target: self, action: #selector(self.tapped(_:)))
+        self.addGestureRecognizer(tap)
+        self.isAccessibilityElement = true
+        self.accessibilityTraits = .adjustable
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    override func layoutSubviews() {
+        super.layoutSubviews()
+        self.layoutBar()
+    }
+
+    private func layoutBar() {
+        let height: CGFloat = self.dragging ? 11.0 : 7.0
+        self.track.frame = CGRect(x: 0.0, y: floor((self.bounds.height - height) / 2.0), width: self.bounds.width, height: height)
+        self.track.layer.cornerRadius = height / 2.0
+        let value = max(0.0, min(1.0, self.dragging ? self.dragProgress : self.progress))
+        self.fill.frame = CGRect(x: 0.0, y: 0.0, width: self.bounds.width * value, height: height)
+        self.fill.backgroundColor = UIColor(white: 1.0, alpha: self.dragging ? 1.0 : 0.8)
+    }
+
+    private func fraction(at point: CGPoint) -> CGFloat {
+        guard self.bounds.width > 0.0 else {
+            return 0.0
+        }
+        return max(0.0, min(1.0, point.x / self.bounds.width))
+    }
+
+    @objc private func panned(_ recognizer: UIPanGestureRecognizer) {
+        switch recognizer.state {
+        case .began:
+            self.dragging = true
+            self.dragProgress = self.progress
+            UIView.animate(withDuration: 0.2, animations: { self.layoutBar() })
+        case .changed:
+            let delta = recognizer.translation(in: self).x / max(1.0, self.bounds.width)
+            recognizer.setTranslation(CGPoint(), in: self)
+            self.dragProgress = max(0.0, min(1.0, self.dragProgress + delta))
+            self.layoutBar()
+            self.onScrub?(self.dragProgress)
+        case .ended, .cancelled:
+            self.progress = self.dragProgress
+            self.onSeek?(self.dragProgress)
+            self.dragging = false
+            UIView.animate(withDuration: 0.25, animations: { self.layoutBar() })
+        default:
+            break
+        }
+    }
+
+    @objc private func tapped(_ recognizer: UITapGestureRecognizer) {
+        let value = self.fraction(at: recognizer.location(in: self))
+        self.progress = value
+        self.onSeek?(value)
+    }
+
+    override func accessibilityIncrement() {
+        let value = min(1.0, self.progress + 0.05)
+        self.progress = value
+        self.onSeek?(value)
+    }
+
+    override func accessibilityDecrement() {
+        let value = max(0.0, self.progress - 0.05)
+        self.progress = value
+        self.onSeek?(value)
+    }
+}
