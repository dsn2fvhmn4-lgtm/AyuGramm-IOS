+/// Lyrics list: the current line is bright and kept near the top third, earlier and later
+/// lines are dimmed, and tapping a synced line seeks to it.
+private final class AyuLyricsView: UIView {
+    var seek: ((Double) -> Void)?
+
+    private let scrollView = UIScrollView()
+    private let statusLabel = UILabel()
+    private var lineLabels: [UILabel] = []
