+    private func setArtworkFrame(_ frame: CGRect, cornerRadius: CGFloat) {
+        let transform = self.artworkShadow.transform
+        self.artworkShadow.transform = .identity
+        self.artworkShadow.frame = frame
+        self.artworkShadow.transform = transform
+        self.artworkShadow.layer.shadowPath = UIBezierPath(roundedRect: CGRect(origin: CGPoint(), size: frame.size), cornerRadius: cornerRadius).cgPath
+        self.artworkNode.view.frame = CGRect(origin: CGPoint(), size: frame.size)
+        let applyArtwork = self.artworkNode.asyncLayout()(TransformImageArguments(corners: ImageCorners(radius: cornerRadius), imageSize: frame.size, boundingSize: frame.size, intrinsicInsets: UIEdgeInsets(), emptyColor: UIColor(white: 0.22, alpha: 1.0)))
