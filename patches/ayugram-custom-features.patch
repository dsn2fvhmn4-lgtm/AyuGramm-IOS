+/// Voice message player in the style of Apple's Voice Memos: the waveform scrolls under a
+/// fixed red playhead and can be dragged to scrub, with a large timer, ±15 s skips and a
+/// playback-speed button. Off by default; enabled under AyuGram → Interface.
+final class AyuVoicePlayerController: ViewController, OverlayAudioPlayerController {
+    private let context: AccountContext
+    private let type: MediaManagerPlayerType
+    private var playerView: AyuVoicePlayerView?
+    private var animatedIn = false
+    private var accountInUseDisposable: Disposable?
+
+    init(context: AccountContext, type: MediaManagerPlayerType) {
+        self.context = context
+        self.type = type
+        super.init(navigationBarPresentationData: nil)
+        self.statusBar.statusBarStyle = .White
+        self.accountInUseDisposable = context.sharedContext.setAccountUserInterfaceInUse(context.account.id)
+    }
+
+    required init(coder aDecoder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    deinit {
+        self.accountInUseDisposable?.dispose()
+    }
+
+    override func loadDisplayNode() {
+        self.displayNode = ASDisplayNode()
+        self.displayNode.backgroundColor = .clear
+        self.displayNodeDidLoad()
+
+        let playerView = AyuVoicePlayerView(context: self.context, type: self.type)
+        playerView.requestDismiss = { [weak self] in
+            self?.dismiss()
+        }
+        self.playerView = playerView
+        self.displayNode.view.addSubview(playerView)
+    }
+
+    override func viewDidAppear(_ animated: Bool) {
+        super.viewDidAppear(animated)
+        if !self.animatedIn {
+            self.animatedIn = true
+            self.playerView?.animateIn()
+        }
+    }
+
+    override func dismiss(completion: (() -> Void)? = nil) {
+        guard let playerView = self.playerView else {
+            self.finishDismiss(completion: completion)
+            return
+        }
+        playerView.animateOut(completion: { [weak self] in
+            self?.finishDismiss(completion: completion)
+        })
+    }
+
+    private func finishDismiss(completion: (() -> Void)?) {
+        if let _ = self.navigationController {
+            self.dismiss(animated: false, completion: nil)
+        } else {
+            self.presentingViewController?.dismiss(animated: false, completion: nil)
+        }
+        completion?()
+    }
+
+    override func containerLayoutUpdated(_ layout: ContainerViewLayout, transition: ContainedViewLayoutTransition) {
+        super.containerLayoutUpdated(layout, transition: transition)
+        guard let playerView = self.playerView else {
+            return
+        }
+        playerView.frame = CGRect(origin: CGPoint(), size: layout.size)
+        playerView.safeInsets = UIEdgeInsets(top: max(layout.statusBarHeight ?? 0.0, layout.safeInsets.top), left: layout.safeInsets.left, bottom: max(layout.intrinsicInsets.bottom, layout.safeInsets.bottom), right: layout.safeInsets.right)
+        playerView.setNeedsLayout()
+    }
+}
+
+private func ayuVoiceTime(_ seconds: Double, fraction: Bool) -> String {
+    let value = max(0.0, seconds.isFinite ? seconds : 0.0)
+    let total = Int(value)
+    let minutes = total / 60
+    let secs = total % 60
+    if fraction {
+        let hundredths = Int((value - Double(total)) * 100.0)
+        return String(format: "%02d:%02d,%02d", minutes, secs, hundredths)
+    }
+    return String(format: "%d:%02d", minutes, secs)
+}
+
+private func ayuVoiceSymbol(_ name: String, size: CGFloat, weight: UIImage.SymbolWeight = .regular) -> UIImage? {
+    return UIImage(systemName: name, withConfiguration: UIImage.SymbolConfiguration(pointSize: size, weight: weight))
+}
