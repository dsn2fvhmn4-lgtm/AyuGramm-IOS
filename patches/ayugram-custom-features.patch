+
+    @objc private func dismissPan(_ recognizer: UIPanGestureRecognizer) {
+        let translation = max(0.0, recognizer.translation(in: self).y)
+        switch recognizer.state {
+        case .changed:
+            self.dragOffset = translation
+            self.transform = CGAffineTransform(translationX: 0.0, y: translation)
+        case .ended, .cancelled:
+            if translation > 120.0 || recognizer.velocity(in: self).y > 900.0 {
+                self.requestDismiss?()
+            } else {
+                self.dragOffset = 0.0
+                UIView.animate(withDuration: 0.35, delay: 0.0, usingSpringWithDamping: 0.8, initialSpringVelocity: 0.0, options: [.beginFromCurrentState], animations: {
+                    self.transform = .identity
+                })
+            }
+        default:
+            break
+        }
+    }
+}
+
+private final class AyuVoiceWeakTarget: NSObject {
+    private weak var view: AyuVoicePlayerView?
+
+    init(_ view: AyuVoicePlayerView) {
+        self.view = view
+    }
+
+    @objc func tick() {
+        self.view?.tick()
+    }
+}
+
+/// Voice Memos waveform: bars scroll right-to-left past a red playhead fixed in the middle;
+/// played bars are white, the rest grey. Dragging sideways scrubs.
+private final class AyuVoiceWaveformView: UIView {
+    var onScrub: ((Double) -> Void)?
+    var onScrubEnded: (() -> Void)?
+
+    private static let barWidth: CGFloat = 3.0
+    private static let barSpacing: CGFloat = 2.0
+    private static let pointsPerSecond: CGFloat = 40.0
+
+    var samples: [CGFloat] = [] {
+        didSet {
+            self.setNeedsDisplay()
+        }
+    }
+    var duration: Double = 0.0
+    var timestamp: Double = 0.0 {
+        didSet {
+            if oldValue != self.timestamp {
+                self.setNeedsDisplay()
+            }
+        }
+    }
+
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+        self.backgroundColor = .clear
+        self.isOpaque = false
+        self.contentMode = .redraw
+        self.addGestureRecognizer(UIPanGestureRecognizer(target: self, action: #selector(self.panned(_:))))
+        self.isAccessibilityElement = true
+        self.accessibilityTraits = .adjustable
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    @objc private func panned(_ recognizer: UIPanGestureRecognizer) {
+        switch recognizer.state {
+        case .changed:
+            let dx = recognizer.translation(in: self).x
+            recognizer.setTranslation(CGPoint(), in: self)
+            // Dragging the waveform left moves forward in time, like Voice Memos.
+            self.onScrub?(Double(-dx / AyuVoiceWaveformView.pointsPerSecond))
+        case .ended, .cancelled:
+            self.onScrubEnded?()
+        default:
+            break
+        }
+    }
+
+    override func accessibilityIncrement() {
+        self.onScrub?(5.0)
+        self.onScrubEnded?()
+    }
+
+    override func accessibilityDecrement() {
+        self.onScrub?(-5.0)
+        self.onScrubEnded?()
+    }
+
+    /// Height (0…1) of the bar at a moment of the recording.
+    private func level(at time: Double) -> CGFloat {
+        guard !self.samples.isEmpty, self.duration > 0.0 else {
+            return 0.15
+        }
+        let position = max(0.0, min(1.0, time / self.duration)) * Double(self.samples.count - 1)
+        let index = Int(position)
+        let next = min(index + 1, self.samples.count - 1)
+        let fraction = CGFloat(position - Double(index))
+        return self.samples[index] * (1.0 - fraction) + self.samples[next] * fraction
+    }
+
+    override func draw(_ rect: CGRect) {
+        guard let context = UIGraphicsGetCurrentContext() else {
+            return
+        }
+        let size = self.bounds.size
+        let midX = size.width / 2.0
+        let midY = size.height / 2.0
+        let maxHeight = size.height * 0.8
+        let step = AyuVoiceWaveformView.barWidth + AyuVoiceWaveformView.barSpacing
+        let secondsPerBar = Double(step / AyuVoiceWaveformView.pointsPerSecond)
+
+        // Faint grid line across the middle.
+        context.setFillColor(UIColor(white: 1.0, alpha: 0.08).cgColor)
+        context.fill(CGRect(x: 0.0, y: midY - 0.5, width: size.width, height: 1.0))
+
+        if self.duration > 0.0 {
+            let barCount = Int(ceil(self.duration / secondsPerBar))
+            let firstVisible = max(0, Int(floor((self.timestamp - Double(midX / AyuVoiceWaveformView.pointsPerSecond)) / secondsPerBar)) - 1)
+            let lastVisible = min(barCount - 1, Int(ceil((self.timestamp + Double(midX / AyuVoiceWaveformView.pointsPerSecond)) / secondsPerBar)) + 1)
+            if firstVisible <= lastVisible {
+                for bar in firstVisible ... lastVisible {
+                    let barTime = Double(bar) * secondsPerBar
+                    let x = midX + CGFloat(barTime - self.timestamp) * AyuVoiceWaveformView.pointsPerSecond
+                    let height = max(3.0, self.level(at: barTime) * maxHeight)
+                    let color = barTime <= self.timestamp ? UIColor.white : UIColor(white: 1.0, alpha: 0.3)
+                    context.setFillColor(color.cgColor)
+                    let barRect = CGRect(x: x, y: midY - height / 2.0, width: AyuVoiceWaveformView.barWidth, height: height)
+                    context.addPath(UIBezierPath(roundedRect: barRect, cornerRadius: AyuVoiceWaveformView.barWidth / 2.0).cgPath)
+                    context.fillPath()
+                }
+            }
+        }
+
+        // Red playhead with a dot on top, as in Voice Memos.
+        let playheadColor = UIColor(rgb: 0xFF453A)
+        context.setFillColor(playheadColor.cgColor)
+        context.fill(CGRect(x: midX - 1.0, y: 6.0, width: 2.0, height: size.height - 6.0))
+        context.fillEllipse(in: CGRect(x: midX - 5.0, y: 0.0, width: 10.0, height: 10.0))
+    }
+}
