+        }
+    }
+
+    override func scrollToTop() {
+        guard self.itemCount > 0 else { return }
+        self.listNode.transaction(deleteIndices: [], insertIndicesAndItems: [], updateIndicesAndItems: [], options: [.Synchronous, .LowLatency], scrollToItem: ListViewScrollToItem(index: 0, position: .top(0.0), animated: true, curve: .Default(duration: nil), directionHint: .Up), updateSizeAndInsets: nil, stationaryItemRange: nil, updateOpaqueState: nil, completion: { _ in })
+    }
+}
+
+/// The AyuGram settings page, which also lays out the search over it.
+final class AyuGramSettingsListController: ItemListController {
+    var searchLayoutUpdated: ((ContainerViewLayout, CGFloat, ContainedViewLayoutTransition) -> Void)?
+
+    override func containerLayoutUpdated(_ layout: ContainerViewLayout, transition: ContainedViewLayoutTransition) {
+        super.containerLayoutUpdated(layout, transition: transition)
+        self.searchLayoutUpdated?(layout, self.cleanNavigationHeight, transition)
+    }
+}
+
+/// Telegram's pull-to-reveal search on the AyuGram settings page: the field waits under the
+/// navigation bar, pulling the page down brings it out, and once it is out the list scrolls
+/// as usual. Tapping it searches every AyuGram setting.
+final class AyuSettingsSearch {
+    let contentNode: NavigationBarSearchContentNode
+    private let context: AccountContext
+    private weak var controller: AyuGramSettingsListController?
+    private var display: SearchDisplayController?
+    private var layout: (ContainerViewLayout, CGFloat)?
+
+    init(context: AccountContext) {
+        self.context = context
+        let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+        var activate: (() -> Void)?
+        self.contentNode = NavigationBarSearchContentNode(theme: presentationData.theme, placeholder: presentationData.strings.Common_Search, activate: {
+            activate?()
+        })
+        activate = { [weak self] in
+            self?.activate()
+        }
+    }
+
+    /// Fully out: the next pull goes past the field.
+    var isRevealed: Bool {
+        return self.contentNode.expansionProgress >= 0.99
+    }
+
+    func attach(to controller: AyuGramSettingsListController) {
+        self.controller = controller
+        controller.navigationBar?.setContentNode(self.contentNode, animated: false)
+        controller.searchLayoutUpdated = { [weak self] layout, navigationBarHeight, transition in
+            guard let self else { return }
+            self.layout = (layout, navigationBarHeight)
+            self.display?.containerLayoutUpdated(layout, navigationBarHeight: navigationBarHeight, transition: transition)
+        }
+        controller.contentScrollingEnded = { [weak self] listView in
+            guard let self else { return false }
+            return fixNavigationSearchableListNodeScrolling(listView, searchNode: self.contentNode)
+        }
+    }
+
+    func updatePresentationData(_ presentationData: PresentationData) {
+        self.contentNode.updateThemeAndPlaceholder(theme: presentationData.theme, placeholder: presentationData.strings.Common_Search)
+        self.display?.updatePresentationData(presentationData)
+    }
+
+    func listOffsetChanged(_ offset: ListViewVisibleContentOffset) {
+        self.contentNode.updateListVisibleContentOffset(offset)
+    }
+
+    private func activate() {
+        guard let controller = self.controller, let (layout, navigationBarHeight) = self.layout, self.display == nil else {
+            return
+        }
+        let placeholderNode = self.contentNode.placeholderNode
+        let presentationData = self.context.sharedContext.currentPresentationData.with { $0 }
+        let content = AyuSettingsSearchContainerNode(context: self.context, openPage: { [weak controller] page in
+            controller?.push(page)
+        })
+        let display = SearchDisplayController(presentationData: presentationData, contentNode: content, cancel: { [weak self] in
+            self?.deactivate()
+        }, fieldStyle: placeholderNode.fieldStyle)
+        self.display = display
+        display.containerLayoutUpdated(layout, navigationBarHeight: navigationBarHeight, transition: .immediate)
+        display.activate(insertSubnode: { [weak controller, weak placeholderNode] subnode, isSearchBar in
+            guard let controller else { return }
+            if isSearchBar {
+                if let placeholderNode {
+                    placeholderNode.supernode?.insertSubnode(subnode, aboveSubnode: placeholderNode)
+                }
+            } else if let navigationBar = controller.navigationBar, navigationBar.supernode === controller.displayNode {
+                controller.displayNode.insertSubnode(subnode, belowSubnode: navigationBar)
+            } else {
+                controller.displayNode.addSubnode(subnode)
+            }
+        }, placeholder: placeholderNode)
+        controller.setDisplayNavigationBar(false, transition: .animated(duration: 0.5, curve: .spring))
+    }
+
+    private func deactivate() {
+        guard let display = self.display else { return }
+        self.display = nil
+        self.controller?.setDisplayNavigationBar(true, transition: .animated(duration: 0.5, curve: .spring))
+        display.deactivate(placeholder: self.contentNode.placeholderNode)
+    }
+}
