@@ -0,0 +1,95 @@
+import Foundation
+
+public enum AyuAppearancePreset: String, CaseIterable {
+    case midnight, paper, aurora, classic
+
+    public func title(_ ru: Bool) -> String {
+        switch self {
+        case .midnight: return ru ? "Полночь" : "Midnight"
+        case .paper: return ru ? "Бумага" : "Paper"
+        case .aurora: return ru ? "Северное сияние" : "Aurora"
+        case .classic: return ru ? "Классика" : "Classic"
+        }
+    }
+
+    public func description(_ ru: Bool) -> String {
+        switch self {
+        case .midnight: return ru ? "Тёмные цвета, тонкая обводка, спокойный плеер" : "Dark colors, fine borders and a calm player"
+        case .paper: return ru ? "Тёплый светлый фон, мягкие пузырьки и караоке" : "Warm light colors, soft bubbles and karaoke"
+        case .aurora: return ru ? "Фиолетово-бирюзовая палитра, стекло и свечение слов" : "Purple and teal colors, glass and glowing lyrics"
+        case .classic: return ru ? "Синие акценты, привычный шрифт и каскад слов" : "Blue accents, familiar type and cascading lyrics"
+        }
+    }
+
+    public var strings: [String: String] {
+        let colors: [String: String]
+        let font: String, bubble: String, lyrics: String, backdrop: String
+        switch self {
+        case .midnight:
+            colors = ["accent": "#A6A0FF", "outgoingBubble": "#373252", "outgoingText": "#FFFFFF", "incomingBubble": "#1D1C26", "incomingText": "#F3F1FA", "wallpaper": "#101016", "wallpaperSecond": "#191526", "listBackground": "#101016", "chatTitle": "#F3F1FA"]
+            font = "HelveticaNeue"; bubble = "none"; lyrics = "none"; backdrop = "midnight"
+        case .paper:
+            colors = ["accent": "#9D5B36", "outgoingBubble": "#E5D8C4", "outgoingText": "#302820", "incomingBubble": "#FFFCF5", "incomingText": "#302820", "wallpaper": "#F5EFE3", "wallpaperSecond": "#ECE2D1", "listBackground": "#F5EFE3", "chatTitle": "#302820"]
+            font = "AvenirNext-Regular"; bubble = "none"; lyrics = "karaoke"; backdrop = "artwork"
+        case .aurora:
+            colors = ["accent": "#57DCCF", "outgoingBubble": "#493973", "outgoingText": "#FFFFFF", "incomingBubble": "#20273B", "incomingText": "#E6FAF7", "wallpaper": "#101421", "wallpaperSecond": "#2D1D4D", "listBackground": "#101421", "chatTitle": "#E6FAF7"]
+            font = "AvenirNext-Regular"; bubble = "cold"; lyrics = "glow"; backdrop = "aurora"
+        case .classic:
+            colors = ["accent": "#1876D2", "outgoingBubble": "#D9EDFF", "outgoingText": "#142438", "incomingBubble": "#FFFFFF", "incomingText": "#142438", "wallpaper": "#EDF3F8", "wallpaperSecond": "#DDEAF5", "listBackground": "#EDF3F8", "chatTitle": "#142438"]
+            font = "HelveticaNeue"; bubble = "none"; lyrics = "cascade"; backdrop = "artwork"
+        }
+        var values = Dictionary(uniqueKeysWithValues: colors.map { ("ayu.custom." + $0.key, $0.value) })
+        values["ayu.wg.customFontName"] = font
+        values["ayu.wg.messageBorderColor"] = colors["accent"]
+        values["ayu.glass.bubble"] = bubble
+        values["ayu.player.lyricsStyle"] = lyrics
+        values["ayu.player.backdrop"] = backdrop
+        values["ayu.custom.presetBase"] = self == .midnight || self == .aurora ? "night" : "day"
+        return values
+    }
+
+    public var flags: [String: Bool] {
+        return ["ayu.wg.customFontEnabled": true, "ayu.wg.messageBorder": self == .midnight,
+                "ayu.wg.transparentBubbles": false, "ayu.wg.semiTransparentBubbles": false,
+                "ayu.glass.tinted": self == .aurora, "ayu.glass.outline": self == .aurora,
+                "ayu.glass.buttons": self == .aurora, "ayu.glass.lists": self == .aurora,
+                "ayu.glass.gifts": self == .aurora]
+    }
+}
+
+/// Only this fixed appearance subset participates in a preset or undo. Account policy,
+/// credentials, badges, plugin settings and unrelated preferences are never read or written.
+public enum AyuAppearancePresetStore {
+    private static let undoKey = "ayu.appearance.presetUndo.v1"
+    public static var keys: Set<String> {
+        return Set(AyuAppearancePreset.allCases.flatMap { Array($0.strings.keys) + Array($0.flags.keys) })
+    }
+
+    public static func canUndo(defaults: UserDefaults = .standard) -> Bool { return defaults.data(forKey: undoKey) != nil }
+
+    public static func apply(_ preset: AyuAppearancePreset, defaults: UserDefaults = .standard) throws {
+        guard !self.isApplied(preset, defaults: defaults) else { return }
+        var snapshot: [String: Any] = [:]
+        for key in self.keys { if let value = defaults.object(forKey: key) { snapshot[key] = value } }
+        let data = try PropertyListSerialization.data(fromPropertyList: snapshot, format: .binary, options: 0)
+        defaults.set(data, forKey: undoKey)
+        for key in self.keys { defaults.removeObject(forKey: key) }
+        for (key, value) in preset.strings { defaults.set(value, forKey: key) }
+        for (key, value) in preset.flags { defaults.set(value, forKey: key) }
+    }
+
+    @discardableResult
+    public static func undo(defaults: UserDefaults = .standard) throws -> Bool {
+        guard let data = defaults.data(forKey: undoKey) else { return false }
+        guard let snapshot = try PropertyListSerialization.propertyList(from: data, options: [], format: nil) as? [String: Any], Set(snapshot.keys).isSubset(of: self.keys) else { throw CocoaError(.fileReadCorruptFile) }
+        for key in self.keys { defaults.removeObject(forKey: key) }
+        for (key, value) in snapshot { defaults.set(value, forKey: key) }
+        defaults.removeObject(forKey: undoKey)
+        return true
+    }
+
+    public static func isApplied(_ preset: AyuAppearancePreset, defaults: UserDefaults = .standard) -> Bool {
+        return preset.strings.allSatisfy { defaults.string(forKey: $0.key) == $0.value }
+            && preset.flags.allSatisfy { (defaults.object(forKey: $0.key) as? Bool) == $0.value }
+    }
+}
