new file mode 100644
index 00000000..7006a3b1
--- /dev/null
+++ b/submodules/SettingsUI/Sources/AyuDailyTableController.swift
@@ -0,0 +1,97 @@
+import UIKit
+import Display
+import SwiftSignalKit
+import AccountContext
+import TelegramPresentationData
+
+/// Native searchable lists hosted by Telegram's existing navigation/touch bridge.
+class AyuDailyTableController: AyuPluginTableController {
+    let context: AccountContext
+    var ru: Bool { return self.context.sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru") }
+    var presentation: PresentationData { return self.context.sharedContext.currentPresentationData.with { $0 } }
+    private var themeDisposable: Disposable?
+    var appearanceChanged: ((PresentationData) -> Void)?
+
+    init(context: AccountContext) {
+        self.context = context
+        super.init(style: .insetGrouped)
+    }
+    required init?(coder: NSCoder) { return nil }
+    deinit { self.themeDisposable?.dispose() }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        self.tableView.rowHeight = UITableView.automaticDimension
+        self.tableView.estimatedRowHeight = 76.0
+        self.tableView.keyboardDismissMode = .onDrag
+        self.themeDisposable = (self.context.sharedContext.presentationData |> deliverOnMainQueue).start(next: { [weak self] data in
+            guard let self else { return }
+            self.overrideUserInterfaceStyle = data.theme.overallDarkAppearance ? .dark : .light
+            self.navigationController?.overrideUserInterfaceStyle = self.overrideUserInterfaceStyle
+            self.tableView.backgroundColor = data.theme.list.blocksBackgroundColor
+            self.tableView.tintColor = data.theme.list.itemAccentColor
+            let appearance = UINavigationBarAppearance()
+            appearance.configureWithOpaqueBackground()
+            appearance.backgroundColor = data.theme.list.blocksBackgroundColor
+            appearance.titleTextAttributes = [.foregroundColor: data.theme.list.itemPrimaryTextColor]
+            self.navigationController?.navigationBar.standardAppearance = appearance
+            self.navigationController?.navigationBar.scrollEdgeAppearance = appearance
+            self.navigationController?.navigationBar.compactAppearance = appearance
+            self.navigationController?.navigationBar.tintColor = data.theme.list.itemAccentColor
+            self.appearanceChanged?(data)
+            self.tableView.reloadData()
+        })
+    }
+
+    func cell(title: String, subtitle: String? = nil) -> UITableViewCell {
+        let cell = UITableViewCell(style: .subtitle, reuseIdentifier: nil)
+        let theme = self.presentation.theme.list
+        cell.backgroundColor = theme.itemBlocksBackgroundColor
+        cell.textLabel?.textColor = theme.itemPrimaryTextColor
+        cell.detailTextLabel?.textColor = theme.itemSecondaryTextColor
+        cell.textLabel?.font = .preferredFont(forTextStyle: .body)
+        cell.detailTextLabel?.font = .preferredFont(forTextStyle: .caption1)
+        cell.textLabel?.adjustsFontForContentSizeCategory = true
+        cell.detailTextLabel?.adjustsFontForContentSizeCategory = true
+        cell.textLabel?.numberOfLines = 0
+        cell.detailTextLabel?.numberOfLines = 0
+        cell.textLabel?.text = title
+        cell.detailTextLabel?.text = subtitle
+        return cell
+    }
+
+    func installSearch(_ search: UISearchBar, filter: UISegmentedControl? = nil) {
+        search.searchBarStyle = .minimal
+        search.autocorrectionType = .no
+        let header = UIView(frame: CGRect(x: 0, y: 0, width: 320, height: filter == nil ? 56 : 104))
+        search.frame = CGRect(x: 0, y: 0, width: 320, height: 56)
+        search.autoresizingMask = [.flexibleWidth]
+        header.addSubview(search)
+        if let filter {
+            filter.frame = CGRect(x: 16, y: 60, width: 288, height: 32)
+            filter.autoresizingMask = [.flexibleWidth]
+            header.addSubview(filter)
+        }
+        self.tableView.tableHeaderView = header
+    }
+
+    func showError(_ text: String) {
+        let alert = UIAlertController(title: "AyuGram", message: text, preferredStyle: .alert)
+        alert.addAction(UIAlertAction(title: "OK", style: .default))
+        self.present(alert, animated: true)
+    }
+}
+
+func ayuDailyHost(context: AccountContext, root: AyuDailyTableController) -> AyuHostedNavigationScreen {
+    let host = AyuHostedNavigationScreen(context: context, root: root)
+    root.appearanceChanged = { [weak host] data in
+        guard let host else { return }
+        host.statusBar.statusBarStyle = data.theme.rootController.statusBarStyle.style
+        host.displayNode.backgroundColor = data.theme.list.blocksBackgroundColor
+    }
+    let title = context.sharedContext.currentPresentationData.with { $0 }.strings.Common_Back
+    root.navigationItem.leftBarButtonItem = UIBarButtonItem(title: title, image: UIImage(systemName: "chevron.left"), primaryAction: UIAction(handler: { [weak host] _ in
+        host?.navigationController?.popViewController(animated: true)
+    }), menu: nil)
+    return host
+}
