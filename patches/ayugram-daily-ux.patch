index 00000000..a6620e88
--- /dev/null
+++ b/tools/ayu-tests/daily-ux/main.swift
@@ -0,0 +1,64 @@
+import Foundation
+
+var checks = 0
+func check(_ condition: @autoclosure () -> Bool, _ message: String) {
+    guard condition() else { fatalError(message) }
+    checks += 1
+}
+
+let comparisons = [
+    ("Встреча в 10:00", "Встреча в 11:00"),
+    ("one two one", "one three one"),
+    ("строка\nещё строка", "строка\nновая строка"),
+    ("👨‍👩‍👧‍👦 привет 👩🏽‍🚀", "👨‍👩‍👧‍👦 пока 👩🏽‍🚀"),
+    ("مرحبا بالعالم", "مرحبا يا عالم"),
+    ("", "добавлено"), ("удалено", ""), ("same", "same"),
+    (String(repeating: "слово ", count: 700) + "старое", String(repeating: "слово ", count: 700) + "новое")
+]
+for (before, after) in comparisons {
+    let diff = AyuHistoryTextDiff.compare(before: before, after: after)
+    check(diff.before.map { $0.text }.joined() == before, "Diff must preserve the entire old Unicode text")
+    check(diff.after.map { $0.text }.joined() == after, "Diff must preserve the entire new Unicode text")
+    check(diff.before.filter { !$0.changed }.map { $0.text }.joined() == diff.after.filter { !$0.changed }.map { $0.text }.joined(), "Unchanged text must be identical on both sides")
+}
+let edit = AyuHistoryTextDiff.compare(before: "Встреча завтра", after: "Встреча сегодня")
+check(edit.before.filter { $0.changed }.map { $0.text }.joined() == "завтра", "Only the removed word is marked")
+check(edit.after.filter { $0.changed }.map { $0.text }.joined() == "сегодня", "Only the inserted word is marked")
+check(AyuLocalSearch.matches("ПРИЗРАК набор", fields: ["Призрак", "Скрывать набор текста"]), "Search combines query words across title and category")
+check(AyuLocalSearch.matches("еще", fields: ["Ещё настройки"]), "Russian е/ё search is forgiving")
+check(AyuLocalSearch.matches("  ", fields: []), "An empty query shows the whole list")
+check(!AyuLocalSearch.matches("призрак музыка", fields: ["Призрак"]), "Every query word is required")
+
+let suite = "AyuDailyUXTests." + UUID().uuidString
+let defaults = UserDefaults(suiteName: suite)!
+defer { defaults.removePersistentDomain(forName: suite) }
+defaults.set("#123456", forKey: "ayu.custom.accent")
+defaults.set("user-selected-font", forKey: "ayu.wg.customFontName")
+defaults.set("private-value", forKey: "ayu.script.storage.example")
+defaults.set("test-only-key", forKey: "ayu.tools.aiKey")
+defaults.set(true, forKey: "ayu.appearance.hideCallsTab")
+check(!AyuAppearancePresetStore.canUndo(defaults: defaults), "No undo exists before the first preset")
+try AyuAppearancePresetStore.apply(.aurora, defaults: defaults)
+check(AyuAppearancePresetStore.isApplied(.aurora, defaults: defaults), "The complete preset is applied")
+check(defaults.string(forKey: "ayu.script.storage.example") == "private-value", "Presets leave plugins alone")
+check(defaults.string(forKey: "ayu.tools.aiKey") == "test-only-key", "Presets leave credentials alone")
+check(defaults.bool(forKey: "ayu.appearance.hideCallsTab"), "Presets preserve unrelated navigation choices")
+try AyuAppearancePresetStore.apply(.aurora, defaults: defaults)
+let restored = try AyuAppearancePresetStore.undo(defaults: defaults)
+check(restored, "Repeated taps preserve the original undo snapshot")
+check(defaults.string(forKey: "ayu.custom.accent") == "#123456", "Undo restores a custom color exactly")
+check(defaults.string(forKey: "ayu.wg.customFontName") == "user-selected-font", "Undo restores the previous font")
+check(defaults.object(forKey: "ayu.glass.bubble") == nil, "Undo restores missing preferences as missing")
+check(!AyuAppearancePresetStore.canUndo(defaults: defaults), "Undo is consumed once")
+for preset in AyuAppearancePreset.allCases {
+    try AyuAppearancePresetStore.apply(preset, defaults: defaults)
+    check(AyuAppearancePresetStore.isApplied(preset, defaults: defaults), "Every preset has a complete valid settings set")
+    check(AyuPlayerTextStyle(rawValue: preset.strings["ayu.player.lyricsStyle"] ?? "") != nil, "Every preset uses a supported lyrics animation")
+    check(preset.strings.filter { $0.key.hasPrefix("ayu.custom.") && $0.key != "ayu.custom.presetBase" }.values.allSatisfy { $0.count == 7 && $0.hasPrefix("#") && UInt32($0.dropFirst(), radix: 16) != nil }, "Preset colors are valid RGB values")
+    check(["night", "day"].contains(preset.strings["ayu.custom.presetBase"] ?? ""), "Every preset chooses a base with matching text contrast")
+}
+for style in AyuPlayerTextStyle.allCases {
+    check(style.effective(reduceMotion: true) == .none, "Reduce Motion disables positional lyrics animation")
+    check(style.effective(reduceMotion: false) == style, "Every selected style is retained with motion allowed")
+}
+print("PASS: \(checks) daily UX checks against actual diff, search, preset and lyrics-style implementations")
