+++ b/submodules/Display/Source/AyuPlayerTextStyle.swift
@@ -0,0 +1,39 @@
+import Foundation
+
+public enum AyuPlayerTextStyle: String, CaseIterable {
+    case none, karaoke, wave, glow, cascade
+
+    public static let didChangeNotification = Notification.Name("AyuGram.PlayerTextStyleChanged")
+    public static let defaultsKey = "ayu.player.lyricsStyle"
+    public static var current: AyuPlayerTextStyle {
+        get { return UserDefaults.standard.string(forKey: defaultsKey).flatMap(Self.init(rawValue:)) ?? .cascade }
+        set {
+            UserDefaults.standard.set(newValue.rawValue, forKey: defaultsKey)
+            NotificationCenter.default.post(name: didChangeNotification, object: nil)
+        }
+    }
+
+    public func title(_ ru: Bool) -> String {
+        switch self {
+        case .none: return ru ? "Без анимации" : "No animation"
+        case .karaoke: return ru ? "Караоке" : "Karaoke"
+        case .wave: return ru ? "Волна" : "Wave"
+        case .glow: return ru ? "Свечение" : "Glow"
+        case .cascade: return ru ? "Каскад" : "Cascade"
+        }
+    }
+
+    public func description(_ ru: Bool) -> String {
+        switch self {
+        case .none: return ru ? "Подсветка текущей строки без движения" : "Highlight the current line without motion"
+        case .karaoke: return ru ? "Плавное заполнение слов, без подъёма букв" : "Smooth word fill without moving letters"
+        case .wave: return ru ? "Буквы приподнимаются волной в такт словам" : "Letters rise in a wave as words are sung"
+        case .glow: return ru ? "Мягкое свечение спетых слов" : "Soft light follows the sung words"
+        case .cascade: return ru ? "Пружинная прокрутка и размытие соседних строк" : "Spring scrolling with blurred surrounding lines"
+        }
+    }
+
+    public func effective(reduceMotion: Bool) -> AyuPlayerTextStyle {
+        return reduceMotion ? .none : self
+    }
+}
