+import UIKit
+import Display
+import AccountContext
+
+private final class AyuAppearancePresetsController: AyuDailyTableController {
+    override init(context: AccountContext) {
+        super.init(context: context)
+        self.title = self.ru ? "Готовые оформления" : "Appearance presets"
+    }
+    required init?(coder: NSCoder) { return nil }
+    override func numberOfSections(in tableView: UITableView) -> Int { return 2 }
+    override func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int { return section == 0 ? AyuAppearancePreset.allCases.count : 1 }
+    override func tableView(_ tableView: UITableView, titleForFooterInSection section: Int) -> String? {
+        guard section == 0 else { return nil }
+        return self.ru ? "Нажмите, чтобы применить цвета, пузырьки, шрифт и оформление плеера. Цвета и плеер обновляются сразу; шрифты и некоторые изображения — после перезапуска. Предыдущее оформление можно вернуть кнопкой ниже." : "Tap to apply colors, bubbles, font and player appearance. Colors and the player update immediately; fonts and some cached images need a relaunch. Restore your previous appearance below."
+    }
+    override func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
+        if indexPath.section == 1 {
+            let cell = self.cell(title: self.ru ? "Вернуть предыдущее оформление" : "Restore previous appearance")
+            cell.textLabel?.textColor = AyuAppearancePresetStore.canUndo() ? self.tableView.tintColor : .secondaryLabel
+            cell.selectionStyle = AyuAppearancePresetStore.canUndo() ? .default : .none
+            return cell
+        }
+        let preset = AyuAppearancePreset.allCases[indexPath.row]
+        let cell = self.cell(title: preset.title(self.ru), subtitle: preset.description(self.ru))
+        cell.accessoryType = AyuAppearancePresetStore.isApplied(preset) ? .checkmark : .none
+        if let value = preset.strings["ayu.custom.accent"].flatMap(AyuCustomization.parse) {
+            cell.imageView?.image = UIImage(systemName: "circle.fill")
+            cell.imageView?.tintColor = UIColor(rgb: value)
+        }
+        return cell
+    }
+    override func tableView(_ tableView: UITableView, didSelectRowAt indexPath: IndexPath) {
+        tableView.deselectRow(at: indexPath, animated: true)
+        do {
+            if indexPath.section == 0 {
+                try AyuAppearancePresetStore.apply(AyuAppearancePreset.allCases[indexPath.row])
+            } else {
+                guard try AyuAppearancePresetStore.undo() else { return }
+            }
+            AyuWhiteGram.refreshAppearance()
+            AyuCustomization.changed()
+            NotificationCenter.default.post(name: AyuGlass.didChangeNotification, object: nil)
+            NotificationCenter.default.post(name: AyuPlayerTextStyle.didChangeNotification, object: nil)
+            self.tableView.reloadData()
+        } catch { self.showError(self.ru ? "Не удалось применить оформление." : "Could not apply the appearance.") }
+    }
+}
+
+func ayuAppearancePresetsController(context: AccountContext) -> ViewController {
+    return ayuDailyHost(context: context, root: AyuAppearancePresetsController(context: context))
+}
+
+private final class AyuPlayerTextSettingsController: AyuDailyTableController {
+    override init(context: AccountContext) {
+        super.init(context: context)
+        self.title = self.ru ? "Анимация текста в плеере" : "Player lyrics animation"
+    }
+    required init?(coder: NSCoder) { return nil }
+    override func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int { return AyuPlayerTextStyle.allCases.count }
+    override func tableView(_ tableView: UITableView, titleForFooterInSection section: Int) -> String? {
+        return self.ru ? "Применяется сразу к словам песни. При включённом «Уменьшении движения» используется подсветка без перемещения букв." : "Applies immediately to lyrics. Reduce Motion uses highlighting without moving letters."
+    }
+    override func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
+        let style = AyuPlayerTextStyle.allCases[indexPath.row]
+        let cell = self.cell(title: style.title(self.ru), subtitle: style.description(self.ru))
+        cell.accessoryType = style == AyuPlayerTextStyle.current ? .checkmark : .none
+        return cell
+    }
+    override func tableView(_ tableView: UITableView, didSelectRowAt indexPath: IndexPath) {
+        tableView.deselectRow(at: indexPath, animated: true)
+        AyuPlayerTextStyle.current = AyuPlayerTextStyle.allCases[indexPath.row]
+        self.tableView.reloadData()
+    }
+}
+
+func ayuPlayerTextSettingsController(context: AccountContext) -> ViewController {
+    return ayuDailyHost(context: context, root: AyuPlayerTextSettingsController(context: context))
+}
