+import Foundation
+
+/// Word-level changes with a bounded work budget. Text and composed Unicode characters
+/// are preserved exactly; long inputs fall back to one changed middle section.
+public enum AyuHistoryTextDiff {
+    public struct Span: Equatable {
+        public let text: String
+        public let changed: Bool
+        public init(text: String, changed: Bool) { self.text = text; self.changed = changed }
+    }
+
+    public struct Result: Equatable {
+        public let before: [Span]
+        public let after: [Span]
+    }
+
+    private static func tokens(_ text: String) -> [String] {
+        var result: [String] = []
+        var buffer = ""
+        var previous = -1
+        for character in text {
+            let kind = character.isWhitespace ? 0 : (character.isLetter || character.isNumber ? 1 : 2)
+            if kind != previous || kind == 2 {
+                if !buffer.isEmpty { result.append(buffer) }
+                buffer = ""
+            }
+            buffer.append(character)
+            previous = kind
+        }
+        if !buffer.isEmpty { result.append(buffer) }
+        return result
+    }
+
+    private static func append(_ text: String, changed: Bool, to spans: inout [Span]) {
+        guard !text.isEmpty else { return }
+        if let last = spans.last, last.changed == changed {
+            spans[spans.count - 1] = Span(text: last.text + text, changed: changed)
+        } else { spans.append(Span(text: text, changed: changed)) }
+    }
+
+    public static func compare(before: String, after: String) -> Result {
+        if before == after { return Result(before: [Span(text: before, changed: false)], after: [Span(text: after, changed: false)]) }
+        let a = self.tokens(before), b = self.tokens(after)
+        var left: [Span] = [], right: [Span] = []
+        if a.count > 500 || b.count > 500 {
+            let old = Array(before), new = Array(after)
+            var prefix = 0, suffix = 0
+            while prefix < min(old.count, new.count), old[prefix] == new[prefix] { prefix += 1 }
+            while suffix < min(old.count, new.count) - prefix, old[old.count - suffix - 1] == new[new.count - suffix - 1] { suffix += 1 }
+            for (characters, isBefore) in [(old, true), (new, false)] {
+                var spans: [Span] = []
+                self.append(String(characters.prefix(prefix)), changed: false, to: &spans)
+                self.append(String(characters[prefix..<(characters.count - suffix)]), changed: true, to: &spans)
+                self.append(String(characters.suffix(suffix)), changed: false, to: &spans)
+                if isBefore { left = spans } else { right = spans }
+            }
+            return Result(before: left, after: right)
+        }
+        let width = b.count + 1
+        var lengths = [Int](repeating: 0, count: (a.count + 1) * width)
+        for i in a.indices.reversed() {
+            for j in b.indices.reversed() {
+                lengths[i * width + j] = a[i] == b[j]
+                    ? lengths[(i + 1) * width + j + 1] + 1
+                    : max(lengths[(i + 1) * width + j], lengths[i * width + j + 1])
+            }
+        }
+        var i = 0, j = 0
+        while i < a.count || j < b.count {
+            if i < a.count, j < b.count, a[i] == b[j] {
+                self.append(a[i], changed: false, to: &left)
+                self.append(b[j], changed: false, to: &right)
+                i += 1; j += 1
+            } else if i < a.count && (j == b.count || lengths[(i + 1) * width + j] >= lengths[i * width + j + 1]) {
+                self.append(a[i], changed: true, to: &left); i += 1
+            } else {
+                self.append(b[j], changed: true, to: &right); j += 1
+            }
+        }
+        return Result(before: left, after: right)
+    }
+}
+
+public enum AyuLocalSearch {
+    public static func normalized(_ text: String) -> String {
+        return text.folding(options: [.caseInsensitive, .diacriticInsensitive], locale: Locale(identifier: "ru_RU"))
+            .replacingOccurrences(of: "ё", with: "е")
+    }
+
+    public static func matches(_ query: String, fields: [String]) -> Bool {
+        let words = self.normalized(String(query.prefix(200))).split(whereSeparator: { $0.isWhitespace })
+        let haystack = self.normalized(fields.joined(separator: " "))
+        return words.allSatisfy { haystack.contains($0) }
+    }
+}
