@@ -0,0 +1,202 @@
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import AccountContext
+
+private final class AyuHistoryBrowserController: AyuDailyTableController, UISearchBarDelegate {
+    let messageId: EngineMessage.Id?
+    var openRecord: ((Int32) -> Void)?
+    private let search = UISearchBar()
+    private let filter = UISegmentedControl()
+    private var history = AyuMessageHistoryState()
+    private var records: [AyuMessageHistoryRecord] = []
+    private var disposable: Disposable?
+
+    init(context: AccountContext, messageId: EngineMessage.Id?) {
+        self.messageId = messageId
+        super.init(context: context)
+        self.title = self.ru ? "История сообщений" : "Message history"
+    }
+    required init?(coder: NSCoder) { return nil }
+    deinit { self.disposable?.dispose() }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        self.search.delegate = self
+        self.search.placeholder = self.ru ? "Найти в сохранённых сообщениях" : "Search saved messages"
+        for (i, title) in (self.ru ? ["Все", "Изменённые", "Удалённые"] : ["All", "Edited", "Deleted"]).enumerated() {
+            self.filter.insertSegment(withTitle: title, at: i, animated: false)
+        }
+        self.filter.selectedSegmentIndex = 0
+        self.filter.addTarget(self, action: #selector(self.refresh), for: .valueChanged)
+        self.installSearch(self.search, filter: self.filter)
+        self.navigationItem.rightBarButtonItem = UIBarButtonItem(title: self.ru ? "Очистить" : "Clear", style: .plain, target: self, action: #selector(self.clearArchive))
+        self.disposable = (self.context.engine.messages.ayuMessageHistory() |> deliverOnMainQueue).start(next: { [weak self] history in
+            self?.history = history
+            self?.refresh()
+        })
+    }
+
+    @objc private func clearArchive() {
+        let alert = UIAlertController(title: self.ru ? "Очистить весь архив?" : "Clear the entire archive?", message: self.ru ? "Будут удалены сохранённые версии и вложения всех чатов этого аккаунта, включая скрытые текущим фильтром." : "Saved versions and attachments from all chats in this account will be removed, including records hidden by the current filter.", preferredStyle: .alert)
+        alert.addAction(UIAlertAction(title: self.ru ? "Отмена" : "Cancel", style: .cancel))
+        alert.addAction(UIAlertAction(title: self.ru ? "Очистить" : "Clear", style: .destructive, handler: { [weak self] _ in
+            guard let self else { return }
+            let _ = self.context.engine.messages.updateAyuMessageHistory(clear: true).startStandalone()
+        }))
+        self.present(alert, animated: true)
+    }
+
+    @objc private func refresh() {
+        self.records = self.history.records.filter { record in
+            if let id = self.messageId, record.peerId != id.peerId.toInt64() || record.messageId != id.id { return false }
+            if self.filter.selectedSegmentIndex == 1 && record.kind != .edited { return false }
+            if self.filter.selectedSegmentIndex == 2 && record.kind != .deleted { return false }
+            return AyuLocalSearch.matches(self.search.text ?? "", fields: [record.text, record.afterText ?? ""] + (record.attachments ?? []).map { $0.displayName })
+        }.sorted { $0.id > $1.id }
+        self.tableView.reloadData()
+    }
+
+    func searchBar(_ searchBar: UISearchBar, textDidChange searchText: String) { self.refresh() }
+    func searchBarSearchButtonClicked(_ searchBar: UISearchBar) { searchBar.resignFirstResponder() }
+    override func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int { return max(1, self.records.count) }
+    override func tableView(_ tableView: UITableView, titleForFooterInSection section: Int) -> String? {
+        return self.ru ? "Хранятся последние 100 записей за 7 дней. Поиск выполняется только в локальном архиве этого аккаунта." : "The latest 100 records are kept for 7 days. Search uses only this account's local archive."
+    }
+    override func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
+        guard !self.records.isEmpty else {
+            let cell = self.cell(title: self.ru ? "Ничего не найдено" : "No matches", subtitle: self.ru ? "Измените запрос или фильтр. Новые записи появятся после изменений и удалений." : "Try another query or filter. New edits and deletions add records here.")
+            cell.selectionStyle = .none
+            return cell
+        }
+        let record = self.records[indexPath.row]
+        let date = DateFormatter.localizedString(from: Date(timeIntervalSince1970: TimeInterval(record.capturedAt)), dateStyle: .short, timeStyle: .short)
+        let kind = record.kind == .edited ? (self.ru ? "Изменено" : "Edited") : (self.ru ? "Удалено" : "Deleted")
+        let preview = record.text.isEmpty ? (record.afterText ?? "") : record.text
+        let text = preview.isEmpty ? (record.attachments?.first?.displayName ?? (self.ru ? "Вложение" : "Attachment")) : String(preview.prefix(160))
+        let cell = self.cell(title: text, subtitle: kind + " · " + date)
+        cell.accessoryType = .disclosureIndicator
+        return cell
+    }
+    override func tableView(_ tableView: UITableView, didSelectRowAt indexPath: IndexPath) {
+        tableView.deselectRow(at: indexPath, animated: true)
+        guard indexPath.row < self.records.count else { return }
+        self.search.resignFirstResponder()
+        self.openRecord?(self.records[indexPath.row].id)
+    }
+}
+
+private final class AyuHistoryComparisonController: AyuDailyTableController {
+    private let recordId: Int32
+    private var record: AyuMessageHistoryRecord?
+    private var versions: [AyuMessageHistoryRecord] = []
+    private var difference: AyuHistoryTextDiff.Result?
+    private var after: String?
+    private var comparesSavedVersions = false
+    private var disposable: Disposable?
+    var openVersion: ((Int32) -> Void)?
+    var openDetails: (() -> Void)?
+
+    init(context: AccountContext, recordId: Int32) {
+        self.recordId = recordId
+        super.init(context: context)
+        self.title = self.ru ? "Изменения сообщения" : "Message changes"
+    }
+    required init?(coder: NSCoder) { return nil }
+    deinit { self.disposable?.dispose() }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        self.disposable = (self.context.engine.messages.ayuMessageHistory() |> deliverOnMainQueue).start(next: { [weak self] history in
+            guard let self else { return }
+            self.record = history.records.first { $0.id == self.recordId }
+            if let record = self.record {
+                self.versions = history.records.filter { $0.peerId == record.peerId && $0.messageId == record.messageId }.sorted { $0.id < $1.id }
+                self.after = record.kind == .edited ? (record.afterText ?? self.versions.first(where: { $0.id > record.id })?.text) : nil
+                self.comparesSavedVersions = record.kind == .edited && record.afterText == nil && self.after != nil
+                self.difference = self.after.map { AyuHistoryTextDiff.compare(before: record.text, after: $0) }
+            } else {
+                self.versions = []; self.after = nil; self.difference = nil
+            }
+            self.tableView.reloadData()
+        })
+    }
+
+    override func numberOfSections(in tableView: UITableView) -> Int { return self.record == nil ? 1 : 4 }
+    override func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int { return section == 2 ? self.versions.count : 1 }
+    override func tableView(_ tableView: UITableView, titleForHeaderInSection section: Int) -> String? {
+        guard self.record != nil else { return nil }
+        switch section {
+        case 0: return self.ru ? "Было · удалённое выделено" : "Before · removed text highlighted"
+        case 1: return self.comparesSavedVersions ? (self.ru ? "Следующая сохранённая версия" : "Next saved version") : (self.ru ? "Стало · добавленное выделено" : "After · added text highlighted")
+        case 2: return self.ru ? "Сохранённые версии" : "Saved versions"
+        default: return nil
+        }
+    }
+
+    override func tableView(_ tableView: UITableView, titleForFooterInSection section: Int) -> String? {
+        guard section == 1, self.comparesSavedVersions else { return nil }
+        return self.ru ? "Текст сразу после этой правки не сохранился. Показано сравнение со следующей доступной записью; между ними могли быть другие изменения." : "The immediate replacement was not saved. This compares the next available snapshot; other edits may have occurred in between."
+    }
+
+    private func textCell(_ text: String, spans: [AyuHistoryTextDiff.Span]?, before: Bool) -> UITableViewCell {
+        let cell = self.cell(title: text.isEmpty ? (self.ru ? "Пустой текст" : "Empty text") : text)
+        cell.selectionStyle = .none
+        if let spans, !text.isEmpty {
+            let rendered = NSMutableAttributedString(string: "")
+            for span in spans {
+                var attributes: [NSAttributedString.Key: Any] = [:]
+                if span.changed {
+                    attributes[.backgroundColor] = (before ? UIColor.systemRed : UIColor.systemGreen).withAlphaComponent(0.22)
+                    if before { attributes[.strikethroughStyle] = NSUnderlineStyle.single.rawValue }
+                    else { attributes[.underlineStyle] = NSUnderlineStyle.single.rawValue }
+                }
+                rendered.append(NSAttributedString(string: span.text, attributes: attributes))
+            }
+            cell.textLabel?.attributedText = rendered
+        }
+        return cell
+    }
+
+    override func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
+        guard let record else { return self.cell(title: self.ru ? "Запись удалена или срок хранения истёк" : "This record was cleared or expired") }
+        switch indexPath.section {
+        case 0: return self.textCell(record.text, spans: self.difference?.before, before: true)
+        case 1:
+            if let after { return self.textCell(after, spans: self.difference?.after, before: false) }
+            return self.cell(title: record.kind == .deleted ? (self.ru ? "Сообщение удалено" : "Message deleted") : (self.ru ? "Следующая версия не сохранена" : "The next version was not saved"))
+        case 2:
+            let version = self.versions[indexPath.row]
+            let date = DateFormatter.localizedString(from: Date(timeIntervalSince1970: TimeInterval(version.capturedAt)), dateStyle: .medium, timeStyle: .medium)
+            let cell = self.cell(title: date, subtitle: version.kind == .edited ? (self.ru ? "Редактирование" : "Edit") : (self.ru ? "Удаление" : "Deletion"))
+            cell.accessoryType = version.id == self.recordId ? .checkmark : .disclosureIndicator
+            return cell
+        default:
+            let cell = self.cell(title: self.ru ? "Сведения, форматирование и вложения" : "Details, formatting and attachments")
+            cell.accessoryType = .disclosureIndicator
+            return cell
+        }
+    }
+    override func tableView(_ tableView: UITableView, didSelectRowAt indexPath: IndexPath) {
+        tableView.deselectRow(at: indexPath, animated: true)
+        guard self.record != nil else { return }
+        if indexPath.section == 2, self.versions[indexPath.row].id != self.recordId { self.openVersion?(self.versions[indexPath.row].id) }
+        if indexPath.section == 3 { self.openDetails?() }
+    }
+}
+
+func ayuHistoryBrowserController(context: AccountContext, messageId: EngineMessage.Id?) -> ViewController {
+    let root = AyuHistoryBrowserController(context: context, messageId: messageId)
+    let host = ayuDailyHost(context: context, root: root)
+    root.openRecord = { [weak host] id in host?.push(ayuHistoryRecordController(context: context, recordId: id)) }
+    return host
+}
+
+func ayuHistoryRecordController(context: AccountContext, recordId: Int32) -> ViewController {
+    let root = AyuHistoryComparisonController(context: context, recordId: recordId)
+    let host = ayuDailyHost(context: context, root: root)
+    root.openVersion = { [weak host] id in host?.push(ayuHistoryRecordController(context: context, recordId: id)) }
+    root.openDetails = { [weak host] in host?.push(ayuHistoryRecordDetailsController(context: context, recordId: recordId)) }
+    return host
+}
