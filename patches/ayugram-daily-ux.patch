+}
+
+/// Results under Telegram's search bar, in the same grouped rows as the settings page.
+private final class AyuSettingsSearchContainerNode: SearchDisplayControllerContentNode {
+    private let entries: [AyuSettingsSearchEntry]
+    private let ru: Bool
+    private let openPage: (ViewController) -> Void
+    private let listNode: ListView
+    private var presentationData: PresentationData
+    private var query = ""
+    private var itemCount = 0
+    private var hasValidLayout = false
+
+    init(context: AccountContext, openPage: @escaping (ViewController) -> Void) {
+        let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+        self.presentationData = presentationData
+        let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        self.ru = ru
+        self.entries = ayuSettingsSearchEntries(context: context, ru: ru)
+        self.openPage = openPage
+        self.listNode = ListViewImpl()
+        self.listNode.isHidden = true
+        self.listNode.accessibilityPageScrolledString = { row, count in
+            return presentationData.strings.VoiceOver_ScrollStatus(row, count).string
