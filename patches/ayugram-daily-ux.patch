+private struct AyuSettingsSearchEntry {
+    let id: String
+    let title: String
+    let path: String
+    let keywords: String
+    let read: (() -> Bool)?
+    let write: ((Bool) throws -> Void)?
+    let page: (() -> ViewController)?
+}
+
+private func ayuSettingsSearchEntries(context: AccountContext, ru: Bool) -> [AyuSettingsSearchEntry] {
+    let store = context.account.network.ayuGhostMode
+    var result: [AyuSettingsSearchEntry] = []
+    func toggle(_ id: String, _ russian: String, _ english: String, _ group: String, _ path: WritableKeyPath<AyuGhostModeSettings, Bool>) {
+        result.append(AyuSettingsSearchEntry(id: id, title: ru ? russian : english, path: group, keywords: russian + " " + english, read: { store.current[keyPath: path] }, write: { value in try store.update { $0[keyPath: path] = value } }, page: nil))
+    }
+    func local(_ id: String, _ russian: String, _ english: String, _ group: String, _ read: @escaping () -> Bool, _ write: @escaping (Bool) -> Void) {
+        result.append(AyuSettingsSearchEntry(id: id, title: ru ? russian : english, path: group, keywords: russian + " " + english, read: read, write: write, page: nil))
+    }
+    func page(_ id: String, _ russian: String, _ english: String, _ keywords: String = "", _ create: @escaping () -> ViewController) {
+        result.append(AyuSettingsSearchEntry(id: "page." + id, title: ru ? russian : english, path: "", keywords: russian + " " + english + " " + keywords, read: nil, write: nil, page: create))
+    }
+    let ghost = ru ? "Призрак" : "Ghost Mode"
+    toggle("ghost.read", "Скрывать прочтение", "Hide read receipts", ghost, \AyuGhostModeSettings.hideReadReceipts)
