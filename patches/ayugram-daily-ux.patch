+
+    override func updatePresentationData(_ presentationData: PresentationData) {
+        self.presentationData = presentationData
+        self.backgroundColor = presentationData.theme.list.blocksBackgroundColor
+        self.reload()
+    }
+
+    override func searchTextUpdated(text: String) {
+        self.query = text
+        self.reload()
+    }
+
+    private func items() -> [ListViewItem] {
+        let query = self.query.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !query.isEmpty else { return [] }
+        let found = self.entries.filter { AyuLocalSearch.matches(query, fields: [$0.title, $0.path, $0.keywords]) }
+        let data = ItemListPresentationData(self.presentationData)
+        var items: [ListViewItem] = []
+        let switches = found.filter { $0.read != nil }
+        let pages = found.filter { $0.page != nil }
+        if !switches.isEmpty {
+            items.append(ItemListSectionHeaderItem(presentationData: data, text: self.ru ? "ПЕРЕКЛЮЧАТЕЛИ" : "SWITCHES", sectionId: 0))
+            for entry in switches {
+                guard let read = entry.read, let write = entry.write else { continue }
+                items.append(ItemListSwitchItem(presentationData: data, systemStyle: .glass, title: entry.title, text: entry.path, value: read(), sectionId: 0, style: .blocks, updated: { [weak self] value in
+                    do {
+                        try write(value)
+                    } catch {
+                        // The switch already moved; put it back to what is actually stored.
+                        self?.reload()
+                    }
+                }))
+            }
+        }
+        if !pages.isEmpty {
+            items.append(ItemListSectionHeaderItem(presentationData: data, text: self.ru ? "РАЗДЕЛЫ" : "PAGES", sectionId: 1))
+            for entry in pages {
+                guard let page = entry.page else { continue }
+                items.append(ItemListDisclosureItem(presentationData: data, systemStyle: .glass, title: entry.title, label: "", sectionId: 1, style: .blocks, action: { [weak self] in
+                    self?.dismissInput?()
+                    self?.openPage(page())
+                }))
+            }
+        }
+        if items.isEmpty {
+            items.append(ItemListTextItem(presentationData: data, text: .plain(self.ru ? "Ничего не найдено" : "No results"), sectionId: 0))
+        }
+        return items
+    }
+
+    /// The lists are a few dozen rows: rebuilding them per keystroke is cheaper than diffing.
+    private func reload() {
+        guard self.hasValidLayout else { return }
+        let items = self.items()
+        let deletions = (0 ..< self.itemCount).map { ListViewDeleteItem(index: $0, directionHint: nil) }
+        let insertions = items.enumerated().map { ListViewInsertItem(index: $0.offset, previousIndex: nil, item: $0.element, directionHint: nil) }
