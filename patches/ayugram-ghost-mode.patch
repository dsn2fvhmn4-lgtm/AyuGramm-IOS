@@ -0,0 +1,59 @@
+import Foundation
+
+public struct AyuHiddenMessageReference: Codable, Equatable, Hashable {
+    public enum Kind: String, Codable, Hashable { case user, group, channel }
+    public let kind: Kind
+    public let peerId: Int64
+    public let messageId: Int32
+    public let groupingKey: Int64?
+    public init(kind: Kind, peerId: Int64, messageId: Int32, groupingKey: Int64? = nil) {
+        self.kind = kind
+        self.peerId = peerId
+        self.messageId = messageId
+        self.groupingKey = groupingKey
+    }
+    public var stableKey: String {
+        return "\(self.kind.rawValue):\(self.peerId):\(self.messageId)"
+    }
+}
+
+public struct AyuHiddenMessagesSettings: Codable, Equatable {
+    public static let maximumEntries = 200
+    public var enabled = true
+    public private(set) var references: [AyuHiddenMessageReference] = []
+    public init() {}
+    private enum CodingKeys: String, CodingKey { case enabled, references }
+    public init(from decoder: Decoder) throws {
+        let values = try decoder.container(keyedBy: CodingKeys.self)
+        let references = try values.decodeIfPresent([AyuHiddenMessageReference].self, forKey: .references) ?? []
+        guard self.add(references) else {
+            throw DecodingError.dataCorruptedError(forKey: .references, in: values, debugDescription: "Invalid or oversized hidden-message references")
+        }
+        self.enabled = try values.decodeIfPresent(Bool.self, forKey: .enabled) ?? true
+    }
+    private static func sameItem(_ lhs: AyuHiddenMessageReference, _ rhs: AyuHiddenMessageReference) -> Bool {
+        guard lhs.kind == rhs.kind, lhs.peerId == rhs.peerId else { return false }
+        if lhs.messageId == rhs.messageId { return true }
+        if let group = lhs.groupingKey, group == rhs.groupingKey { return true }
+        return false
+    }
+    /// Atomic batch: an invalid item or capacity failure leaves the original value intact.
+    @discardableResult public mutating func add(_ references: [AyuHiddenMessageReference]) -> Bool {
+        guard references.count <= Self.maximumEntries else { return false }
+        var updated = self.references
+        for reference in references {
+            guard reference.peerId > 0, reference.messageId > 0 else { return false }
+            if !updated.contains(where: { Self.sameItem($0, reference) }) { updated.append(reference) }
+            guard updated.count <= Self.maximumEntries else { return false }
+        }
+        self.references = updated
+        return true
+    }
+    public func contains(_ reference: AyuHiddenMessageReference) -> Bool {
+        return self.enabled && self.references.contains(where: { Self.sameItem($0, reference) })
+    }
+    public mutating func restore(_ reference: AyuHiddenMessageReference) {
+        self.references.removeAll(where: { Self.sameItem($0, reference) })
+    }
+    public mutating func restoreAll() { self.references.removeAll() }
+}
