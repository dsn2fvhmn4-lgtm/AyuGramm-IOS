+++ b/submodules/TelegramUI/Components/VideoMessageCameraScreen/Sources/AyuCameraFlipGestureRecognizer.swift
@@ -0,0 +1,46 @@
+import UIKit
+import UIKit.UIGestureRecognizerSubclass
+import TelegramCore
+
+/// Passive single-finger observer. It never wins over recording controls or pinch.
+final class AyuCameraFlipGestureRecognizer: UIGestureRecognizer {
+    private let configuration: () -> AyuCameraFlipSettings?
+    private let allowsTouch: (CGPoint, UIView?) -> Bool
+    private let flip: (Bool) -> Void
+    private var policy = AyuCameraFlipPolicy()
+    private var activeSettings: AyuCameraFlipSettings?
+    private weak var trackedTouch: UITouch?
+
+    init(configuration: @escaping () -> AyuCameraFlipSettings?, allowsTouch: @escaping (CGPoint, UIView?) -> Bool, flip: @escaping (Bool) -> Void) {
+        self.configuration = configuration; self.allowsTouch = allowsTouch; self.flip = flip
+        super.init(target: nil, action: nil)
+        self.cancelsTouchesInView = false; self.delaysTouchesBegan = false; self.delaysTouchesEnded = false
+    }
+    required init?(coder: NSCoder) { return nil }
+    override func canPrevent(_ preventedGestureRecognizer: UIGestureRecognizer) -> Bool { return false }
+    override func canBePrevented(by preventingGestureRecognizer: UIGestureRecognizer) -> Bool { return false }
+    override func reset() { super.reset(); self.trackedTouch = nil }
+    private func abort() { self.policy.cancel(); self.trackedTouch = nil; if self.state == .possible { self.state = .failed } }
+    override func touchesBegan(_ touches: Set<UITouch>, with event: UIEvent) {
+        super.touchesBegan(touches, with: event)
+        guard self.trackedTouch == nil, touches.count == 1, event.allTouches?.count == 1,
+              let touch = touches.first, let view = self.view, let settings = self.configuration(),
+              self.allowsTouch(touch.location(in: view), touch.view) else { self.abort(); return }
+        if self.activeSettings != settings { self.policy.cancel() }
+        self.activeSettings = settings; self.trackedTouch = touch
+        let point = touch.location(in: view)
+        _ = self.policy.handle(.began, x: Double(point.x), y: Double(point.y), time: touch.timestamp, settings: settings)
+    }
+    private func process(_ phase: AyuCameraFlipPolicy.Phase, touches: Set<UITouch>, event: UIEvent) {
+        guard let touch = self.trackedTouch, touches.contains(touch), let view = self.view,
+              let settings = self.activeSettings, self.configuration() == settings, event.allTouches?.count == 1 else { self.abort(); return }
+        let point = touch.location(in: view)
+        if self.policy.handle(phase, x: Double(point.x), y: Double(point.y), time: touch.timestamp, settings: settings) { self.flip(settings.haptic) }
+    }
+    override func touchesMoved(_ touches: Set<UITouch>, with event: UIEvent) { self.process(.moved, touches: touches, event: event) }
+    override func touchesEnded(_ touches: Set<UITouch>, with event: UIEvent) {
+        self.process(.ended, touches: touches, event: event)
+        self.trackedTouch = nil; if self.state == .possible { self.state = .failed }
+    }
+    override func touchesCancelled(_ touches: Set<UITouch>, with event: UIEvent) { self.abort() }
+}
