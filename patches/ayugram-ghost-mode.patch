+            let types = WKWebsiteDataStore.allWebsiteDataTypes()
+            let records = await store.dataRecords(ofTypes: types)
+            let games = records.filter { record in AyuArcadeGameController.gameHosts.contains(where: { record.displayName == $0 || record.displayName.hasSuffix("." + $0) }) }
+            await store.removeData(ofTypes: types, for: games)
