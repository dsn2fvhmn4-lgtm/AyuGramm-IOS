+import Foundation
+
+/// Bridge to the embedded CPython plugin runtime (`runtime/python/_ayu_host.py`).
+///
+/// The Swift side owns one interpreter for the whole app. It sends operations
+/// to Python as JSON and answers Python's `native(...)` calls on the same
+/// thread. Everything crosses one serial queue, so plugin code never runs
+/// concurrently with itself and the GIL is held only on that queue.
+///
+/// This type has no Python dependency of its own: the actual interpreter is
+/// provided by `AyuPythonInterpreter`, implemented in the TelegramUI layer with
+/// the `Python.xcframework` C API (so TelegramCore, shared with Telegram-Mac,
+/// stays free of the framework). When no interpreter is installed — every
+/// current build, and Telegram-Mac — the runtime reports itself unavailable and
+/// the declarative plugin ABI continues to handle everything.
+public protocol AyuPythonInterpreter: AnyObject {
+    /// Starts CPython, puts `runtime/python` on `sys.path`, imports `_ayu_host`
+    /// and installs `native`. `dataDir` is the per-app-group plugins directory.
+    func start(runtimeURL: URL, dataDir: URL, native: @escaping (String) -> String) throws
+    /// Calls `_ayu_host.call(request)` and returns its JSON response.
+    func call(_ requestJSON: String) -> String
+}
+
+public enum AyuPythonRuntimeError: Error { case unavailable, notStarted, decoding }
+
+public struct AyuPythonConversionError: LocalizedError {
+    public let detail: String
+    public var errorDescription: String? { return self.detail }
+}
+
+public final class AyuPythonRuntime {
+    public static let shared = AyuPythonRuntime()
+
+    private let queue = DispatchQueue(label: "org.ayugram.python", qos: .utility)
+    private var interpreter: AyuPythonInterpreter?
+    private var started = false
+    private var startupError: String?
+    private var lastCallError: String?
+    private var nativeHandler: ((AyuPythonNativeRequest) -> AyuPythonNativeResult)?
+
+    private init() {}
+
+    public var isAvailable: Bool {
+        return self.queue.sync { self.interpreter != nil }
+    }
+
+    /// Installs the platform interpreter. Called once at launch by the app layer.
+    public func install(interpreter: AyuPythonInterpreter) {
+        self.queue.sync { self.interpreter = interpreter }
+    }
+
+    /// Installs the handler for Python's host calls (sending, UI, logging).
+    public func setNativeHandler(_ handler: @escaping (AyuPythonNativeRequest) -> AyuPythonNativeResult) {
+        self.queue.sync { self.nativeHandler = handler }
+    }
+
+    public func startIfNeeded(runtimeURL: URL, dataDir: URL) {
+        self.queue.sync {
+            guard let interpreter = self.interpreter, !self.started else { return }
+            do {
+                try interpreter.start(runtimeURL: runtimeURL, dataDir: dataDir, native: { [weak self] payload in
+                    return self?.handleNative(payload) ?? "{\"ok\":false,\"error\":\"host gone\"}"
+                })
+                self.started = true
+                _ = self.callLocked(op: "configure", args: ["dataDir": dataDir.path])
+            } catch {
+                self.started = false
+                self.startupError = String(describing: error)
+            }
+        }
+    }
+
+    /// Parse the entire source into a persisted native program. This operation never executes plugin code.
+    public func convertSource(_ data: Data, sourceSHA256: String) throws -> AyuPluginManifest {
+        guard data.count <= 65536, String(data: data, encoding: .utf8) != nil else { throw AyuPluginError.invalidFile }
+        return try self.queue.sync {
+            guard self.started else { throw AyuPythonConversionError(detail: self.startupError ?? "Python converter is not ready. Reopen the app and try importing again.") }
+            guard let result = self.callLocked(op: "convert", args: ["sourceData": data.base64EncodedString()]),
+                  JSONSerialization.isValidJSONObject(result) else { throw AyuPythonConversionError(detail: String((self.lastCallError ?? "No native mapping for this plugin").prefix(512))) }
+            let encoded = try JSONSerialization.data(withJSONObject: result)
+            let manifest = try JSONDecoder().decode(AyuPluginManifest.self, from: encoded)
+            guard manifest.convertedFrom == AyuTextProgram.converterID, manifest.sourceSHA256 == sourceSHA256 else { throw AyuPluginError.invalidManifest }
+            try manifest.validate()
+            return manifest
+        }
+    }
+
+    // MARK: - Operations (async, off the caller's thread)
+
+    public func load(path: String, sha256: String?, completion: ((Result<AyuPythonPluginInfo, Error>) -> Void)? = nil) {
+        self.perform(op: "load", args: ["path": path, "sha256": sha256 ?? NSNull()], completion: completion.map { done in { result in
+            done(result.flatMap { value in
+                guard let info = AyuPythonPluginInfo(value) else { return .failure(AyuPythonRuntimeError.decoding) }
+                return .success(info)
+            })
+        } })
+    }
+
+    public func unload(id: String) {
+        self.perform(op: "unload", args: ["id": id], completion: nil)
+    }
+
+    public func appEvent(_ event: String) {
+        self.perform(op: "appEvent", args: ["event": event], completion: nil)
+    }
+
+    /// Synchronous: the send path needs the possibly-modified text before it
+    /// enqueues. Runs on the Python queue and returns within one GIL turn.
+    public func transformOutgoing(account: Int32, peer: Int64, text: String, replyTo: Int64?) -> AyuPythonSendOutcome? {
+        guard self.isAvailable else { return nil }
+        let value = self.queue.sync { () -> Any? in
+            return self.callLocked(op: "sendMessage", args: ["account": Int(account), "peer": peer, "text": text, "replyTo": replyTo ?? NSNull()])
+        }
+        guard let dictionary = value as? [String: Any], let outText = dictionary["text"] as? String else { return nil }
+        return AyuPythonSendOutcome(text: outText, cancel: (dictionary["cancel"] as? Bool) ?? false)
+    }
+
+    public func menuItems(menus: [String], completion: @escaping ([AyuPythonMenuItem]) -> Void) {
+        self.perform(op: "menuItems", args: ["menus": menus]) { result in
+            let items = ((try? result.get()) as? [Any] ?? []).compactMap { AyuPythonMenuItem($0) }
+            completion(items)
+        }
+    }
+
+    public func menuClick(plugin: String, id: String, context: [String: Any]) {
+        self.perform(op: "menuClick", args: ["plugin": plugin, "id": id, "context": context], completion: nil)
+    }
+
+    public func settingsSchema(id: String, completion: @escaping ([[String: Any]]) -> Void) {
+        self.perform(op: "settingsSchema", args: ["id": id]) { result in
+            completion(((try? result.get()) as? [Any] ?? []).compactMap { $0 as? [String: Any] })
+        }
+    }
+
+    public func settingChanged(id: String, index: Int, value: Any?) {
+        var args: [String: Any] = ["id": id, "index": index]
+        if let value { args["value"] = value }
+        self.perform(op: "settingChanged", args: args, completion: nil)
+    }
+
+    public func invokeCallback(id: String, value: Any?) {
+        var args: [String: Any] = ["id": id]
+        if let value { args["value"] = value }
+        self.perform(op: "callback", args: args, completion: nil)
+    }
+
+    // MARK: - Internals
+
+    private func perform(op: String, args: [String: Any], completion: ((Result<Any?, Error>) -> Void)?) {
+        self.queue.async {
+            guard self.interpreter != nil, self.started else {
+                completion?(.failure(AyuPythonRuntimeError.notStarted)); return
+            }
+            let value = self.callLocked(op: op, args: args)
+            if let completion {
+                DispatchQueue.main.async { completion(.success(value)) }
+            }
+        }
+    }
+
+    /// Must run on `self.queue`.
+    private func callLocked(op: String, args: [String: Any]) -> Any? {
+        guard let interpreter = self.interpreter else { return nil }
+        let request: [String: Any] = ["op": op, "args": args]
+        guard let requestData = try? JSONSerialization.data(withJSONObject: request, options: []),
+              let requestJSON = String(data: requestData, encoding: .utf8) else { return nil }
+        let responseJSON = interpreter.call(requestJSON)
+        guard let data = responseJSON.data(using: .utf8),
+              let object = try? JSONSerialization.jsonObject(with: data) as? [String: Any] else { return nil }
+        if (object["ok"] as? Bool) == true { self.lastCallError = nil; return object["result"] }
+        self.lastCallError = object["error"] as? String
+        return nil
+    }
+
+    private func handleNative(_ payload: String) -> String {
+        guard let data = payload.data(using: .utf8),
+              let object = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
+              let op = object["op"] as? String else {
+            return "{\"ok\":false,\"error\":\"bad request\"}"
+        }
+        let args = object["args"] as? [String: Any] ?? [:]
+        let request = AyuPythonNativeRequest(op: op, args: args)
+        let handler = self.nativeHandler
+        let result = handler?(request) ?? .failure("no native handler")
+        let reply: [String: Any]
+        switch result {
+        case let .success(value): reply = ["ok": true, "result": value ?? NSNull()]
+        case let .failure(message): reply = ["ok": false, "error": message]
+        }
+        guard let replyData = try? JSONSerialization.data(withJSONObject: reply),
+              let replyJSON = String(data: replyData, encoding: .utf8) else {
+            return "{\"ok\":false,\"error\":\"encode\"}"
+        }
+        return replyJSON
+    }
+}
+
+public struct AyuPythonNativeRequest {
+    public let op: String
+    public let args: [String: Any]
+    public func string(_ key: String) -> String? { return self.args[key] as? String }
+    public func int(_ key: String) -> Int? { return self.args[key] as? Int }
+    public func int64(_ key: String) -> Int64? { return (self.args[key] as? NSNumber)?.int64Value }
+    public func bool(_ key: String) -> Bool { return (self.args[key] as? Bool) ?? false }
+}
+
+public enum AyuPythonNativeResult {
+    case success(Any?)
+    case failure(String)
+}
+
+public struct AyuPythonSendOutcome {
+    public let text: String
+    public let cancel: Bool
+}
+
+public struct AyuPythonPluginInfo {
+    public let id: String
+    public let name: String
+    public let version: String
+    public let author: String
+    public let hasSendHook: Bool
+    public let menuCount: Int
+    public let errors: [String]
+    public let diagnostics: [String: Any]
+
+    init?(_ value: Any?) {
+        guard let dictionary = value as? [String: Any], let id = dictionary["id"] as? String else { return nil }
+        let metadata = dictionary["metadata"] as? [String: Any] ?? [:]
+        self.id = id
+        self.name = (metadata["name"] as? String) ?? id
+        self.version = (metadata["version"] as? String) ?? ""
+        self.author = (metadata["author"] as? String) ?? ""
+        self.hasSendHook = (dictionary["sendHook"] as? Bool) ?? false
+        self.menuCount = (dictionary["menuItems"] as? [Any])?.count ?? 0
+        self.errors = (dictionary["errors"] as? [String]) ?? []
+        self.diagnostics = dictionary["diagnostics"] as? [String: Any] ?? [:]
+    }
+}
+
+public struct AyuPythonMenuItem {
+    public let plugin: String
+    public let id: String
+    public let menu: String
+    public let text: String
+    public let subtext: String?
+    public let priority: Int
+
+    init?(_ value: Any) {
+        guard let dictionary = value as? [String: Any],
+              let plugin = dictionary["plugin"] as? String, let id = dictionary["id"] as? String,
+              let menu = dictionary["menu"] as? String, let text = dictionary["text"] as? String else { return nil }
+        self.plugin = plugin; self.id = id; self.menu = menu; self.text = text
+        self.subtext = dictionary["subtext"] as? String
+        self.priority = (dictionary["priority"] as? Int) ?? 0
+    }
+}
