+import UIKit
+
+public final class AyuChatColorPickerController: UITableViewController {
+    private let russian: Bool
+    private let current: String?
+    private let save: (String?) throws -> Void
+    private let openWebsite: () -> Void
+    private let presets: [(String, String, String)] = [
+        ("Оранжевый", "Orange", "FF8A00"), ("Синий", "Blue", "2F80ED"),
+        ("Зелёный", "Green", "27AE60"), ("Фиолетовый", "Purple", "9B51E0"),
+        ("Красный", "Red", "EB5757"), ("Жёлтый", "Yellow", "F2C94C"),
+        ("Розовый", "Pink", "FF5FA2"), ("Бирюзовый", "Turquoise", "1ABC9C"),
+        ("Белый", "White", "FFFFFF")
+    ]
+    public init(current: String?, russian: Bool, save: @escaping (String?) throws -> Void, openWebsite: @escaping () -> Void) {
+        self.current = current; self.russian = russian; self.save = save; self.openWebsite = openWebsite
+        super.init(style: .insetGrouped)
+        self.title = russian ? "Цвет чата" : "Chat color"
+    }
+    required public init?(coder: NSCoder) { return nil }
+    override public func viewDidLoad() {
+        super.viewDidLoad()
+        self.navigationItem.rightBarButtonItem = UIBarButtonItem(barButtonSystemItem: .cancel, target: self, action: #selector(self.cancel))
+    }
+    @objc private func cancel() { self.dismiss(animated: true) }
+    override public func numberOfSections(in tableView: UITableView) -> Int { return 2 }
+    override public func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int { return section == 0 ? self.presets.count : 3 }
+    override public func tableView(_ tableView: UITableView, titleForHeaderInSection section: Int) -> String? {
+        return section == 0 ? ((self.russian ? "Текущий: " : "Current: ") + (self.current.map { "#" + $0 } ?? (self.russian ? "не задан" : "none"))) : nil
+    }
+    override public func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
+        let cell = UITableViewCell(style: .subtitle, reuseIdentifier: nil)
+        if indexPath.section == 0 {
+            let preset = self.presets[indexPath.row]
+            cell.textLabel?.text = self.russian ? preset.0 : preset.1
+            cell.detailTextLabel?.text = "#" + preset.2
+            let rgb = UInt32(preset.2, radix: 16) ?? 0
+            let color = UIColor(red: CGFloat((rgb >> 16) & 255) / 255, green: CGFloat((rgb >> 8) & 255) / 255, blue: CGFloat(rgb & 255) / 255, alpha: 1)
+            cell.imageView?.image = UIImage(systemName: "circle.fill")?.withTintColor(color, renderingMode: .alwaysOriginal)
+            if self.current == preset.2 { cell.accessoryType = .checkmark }
+        } else {
+            cell.textLabel?.text = self.russian ? ["Свой цвет (#HEX)", "Подобрать цвет на сайте", "Убрать цвет"][indexPath.row] : ["Custom color (#HEX)", "Choose color on website", "Remove color"][indexPath.row]
+            if indexPath.row == 2 { cell.textLabel?.textColor = .systemRed }
+        }
+        return cell
+    }
+    private func commit(_ hex: String?) {
+        do { try self.save(hex); self.dismiss(animated: true) }
+        catch {
+            let alert = UIAlertController(title: self.russian ? "Цвет не сохранён" : "Color not saved", message: self.russian ? "Проверь HEX: #RGB или #RRGGBB. Плагин должен оставаться установленным. Предыдущие настройки сохранены." : "Use #RGB or #RRGGBB and keep the plugin installed. Previous settings were retained.", preferredStyle: .alert)
+            alert.addAction(UIAlertAction(title: "OK", style: .default)); self.present(alert, animated: true)
+        }
+    }
+    override public func tableView(_ tableView: UITableView, didSelectRowAt indexPath: IndexPath) {
+        tableView.deselectRow(at: indexPath, animated: true)
+        if indexPath.section == 0 { self.commit(self.presets[indexPath.row].2); return }
+        if indexPath.row == 1 { self.openWebsite(); return }
+        if indexPath.row == 2 { self.commit(nil); return }
+        let alert = UIAlertController(title: self.russian ? "Свой цвет" : "Custom color", message: "#RGB / #RRGGBB", preferredStyle: .alert)
+        alert.addTextField { field in
+            field.text = "#" + (self.current ?? "FF8A00"); field.keyboardType = .asciiCapable
+            field.autocapitalizationType = .allCharacters; field.autocorrectionType = .no
+        }
+        alert.addAction(UIAlertAction(title: self.russian ? "Сохранить" : "Save", style: .default, handler: { [weak self, weak alert] _ in
+            guard let self, let value = alert?.textFields?.first?.text else { return }
+            if let alert { alert.dismiss(animated: true, completion: { [weak self] in self?.commit(value) }) }
+            else { self.commit(value) }
+        }))
+        alert.addAction(UIAlertAction(title: self.russian ? "Отмена" : "Cancel", style: .cancel))
+        self.present(alert, animated: true)
+    }
+}
