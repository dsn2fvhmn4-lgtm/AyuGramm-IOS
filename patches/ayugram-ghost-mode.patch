--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuGram/AyuGhostModeSettings.swift
@@ -0,0 +1,95 @@
+import Foundation
+
+/// Per-account, opt-in policy for ordinary cloud chats. Media consumption and secret-chat
+/// receipts deliberately retain the upstream behavior, including expiration handling.
+public struct AyuGhostModeSettings: Codable, Equatable {
+    public var hideReadReceipts: Bool
+    public var hideOnline: Bool
+    public var hideTyping: Bool
+    public var hideUploadProgress: Bool
+
+    public init(hideReadReceipts: Bool = false, hideOnline: Bool = false, hideTyping: Bool = false, hideUploadProgress: Bool = false) {
+        self.hideReadReceipts = hideReadReceipts
+        self.hideOnline = hideOnline
+        self.hideTyping = hideTyping
+        self.hideUploadProgress = hideUploadProgress
+    }
+
+    public var allEnabled: Bool {
+        return self.hideReadReceipts && self.hideOnline && self.hideTyping && self.hideUploadProgress
+    }
+
+    public mutating func setAllEnabled(_ enabled: Bool) {
+        self.hideReadReceipts = enabled
+        self.hideOnline = enabled
+        self.hideTyping = enabled
+        self.hideUploadProgress = enabled
+    }
+}
+
+/// The file lives inside the account directory, so logout/account removal owns its lifetime.
+/// Writes must succeed before policy changes are exposed to UI or networking subscribers.
+public final class AyuGhostModeStore {
+    private let lock = NSRecursiveLock()
+    private let fileURL: URL
+    private var value: AyuGhostModeSettings
+    private var observers: [UUID: (AyuGhostModeSettings) -> Void] = [:]
+    public let hadLoadError: Bool
+
+    public init(accountPath: String) {
+        self.fileURL = URL(fileURLWithPath: accountPath).appendingPathComponent("ayu-ghost-mode.json")
+        if FileManager.default.fileExists(atPath: self.fileURL.path) {
+            do {
+                self.value = try JSONDecoder().decode(AyuGhostModeSettings.self, from: Data(contentsOf: self.fileURL))
+                self.hadLoadError = false
+            } catch {
+                self.value = AyuGhostModeSettings()
+                self.hadLoadError = true
+            }
+        } else {
+            self.value = AyuGhostModeSettings()
+            self.hadLoadError = false
+        }
+    }
+
+    public var current: AyuGhostModeSettings {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return self.value
+    }
+
+    public func update(_ transform: (inout AyuGhostModeSettings) -> Void) throws {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        var updated = self.value
+        transform(&updated)
+        guard updated != self.value else { return }
+        let data = try JSONEncoder().encode(updated)
+        #if os(iOS)
+        try data.write(to: self.fileURL, options: [.atomic, .completeFileProtectionUntilFirstUserAuthentication])
+        #else
+        try data.write(to: self.fileURL, options: .atomic)
+        #endif
+        self.value = updated
+        // Recursive lock also serializes initial observation with updates. Subscribers in the
+        // engine/UI bridge deliver onto their own queues before touching other subsystems.
+        for observer in Array(self.observers.values) {
+            observer(updated)
+        }
+    }
+
+    func observe(_ observer: @escaping (AyuGhostModeSettings) -> Void) -> UUID {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        let id = UUID()
+        self.observers[id] = observer
+        observer(self.value)
+        return id
+    }
+
+    func removeObserver(_ id: UUID) {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        self.observers.removeValue(forKey: id)
+    }
+}
