+import Foundation
+
+public enum AyuTranslationError: Error { case configuration, credentialStorage, network, provider(Int), empty, tooLarge }
+public enum AyuTranslationRequest {
+    public static func endpoint(_ settings: AyuAdvancedSettings) throws -> URL {
+        switch settings.translationProvider {
+        case .telegram: throw AyuTranslationError.configuration
+        case .deepLFree: return URL(string: "https://api-free.deepl.com/v2/translate")!
+        case .deepLPro: return URL(string: "https://api.deepl.com/v2/translate")!
+        case .libreTranslate:
+            try settings.validate()
+            guard !settings.libreTranslateURL.isEmpty, let url = URL(string: settings.libreTranslateURL) else { throw AyuTranslationError.configuration }
+            return url.lastPathComponent == "translate" ? url : url.appendingPathComponent("translate")
+        }
+    }
+    public static func build(settings: AyuAdvancedSettings, text: String, key: String?) throws -> URLRequest {
+        try settings.validate()
+        guard !text.isEmpty, text.utf8.count <= 16384 else { throw AyuTranslationError.tooLarge }
+        let key = key ?? ""
+        // Scalars, not Characters: "\r\n" is one Character, so contains("\r") misses it.
+        guard key.utf8.count <= 1024, !key.unicodeScalars.contains(where: { $0.value < 0x20 || $0.value == 0x7F }) else { throw AyuTranslationError.configuration }
+        var request = URLRequest(url: try self.endpoint(settings), cachePolicy: .reloadIgnoringLocalCacheData, timeoutInterval: 30)
+        request.httpMethod = "POST"; request.setValue("application/json", forHTTPHeaderField: "Content-Type")
+        var body: [String: Any]
+        if settings.translationProvider == .libreTranslate {
+            body = ["q": text, "source": "auto", "target": settings.translationTarget.lowercased(), "format": "text"]
+            if !key.isEmpty { body["api_key"] = key }
+        } else {
+            guard !key.isEmpty else { throw AyuTranslationError.configuration }
+            request.setValue("DeepL-Auth-Key " + key, forHTTPHeaderField: "Authorization")
+            body = ["text": [text], "target_lang": settings.translationTarget.uppercased()]
+        }
+        request.httpBody = try JSONSerialization.data(withJSONObject: body)
+        return request
+    }
+    public static func result(_ data: Data, provider: AyuAdvancedSettings.TranslationProvider) throws -> String {
+        guard data.count <= 262144, let value = try JSONSerialization.jsonObject(with: data) as? [String: Any] else { throw AyuTranslationError.tooLarge }
+        let text: String?
+        if provider == .libreTranslate { text = value["translatedText"] as? String }
+        else { text = (value["translations"] as? [[String: Any]])?.first?["text"] as? String }
+        guard let text, !text.isEmpty, text.utf8.count <= 65536 else { throw AyuTranslationError.empty }
+        return text
+    }
+}
