+import Foundation
+import Postbox
+import SwiftSignalKit
+internal import TelegramApi
+
+public enum AyuChatExportEvent { case progress(messages: Int, mediaBytes: Int64); case completed(URL); case forwarding(messages: Int, total: Int); case savedToSelf(messages: Int, partial: Bool) }
+public enum AyuChatExportError: Error { case unsupported, network, storage, cancelled }
+
+public func ayuExportChat(account: Account, peerId: PeerId, options: AyuChatExportOptions) -> Signal<AyuChatExportEvent, AyuChatExportError> {
+    return Signal { subscriber in
+        let job = AyuChatExportJob(account: account, peerId: peerId, options: options, subscriber: subscriber)
+        job.start()
+        return ActionDisposable { job.cancel() }
+    }
+}
+private final class AyuChatExportJob {
+    private let account: Account
+    private let peerId: PeerId
+    private let options: AyuChatExportOptions
+    private let subscriber: Subscriber<AyuChatExportEvent, AyuChatExportError>
+    private let queue = Queue(name: "AyuGram.ChatExport")
+    private let request = MetaDisposable()
+    private let lock = NSLock()
+    private var cancelled = false
+    private var finished = false
+    private var writer: AyuChatExportWriter?
+    private var peer: Peer?
+    private var inputPeer: Api.InputPeer?
+    private var forwardPage = -1
+    private var forwarded = 0
+    private var forwarding = false
+    private var partial = false
+    private var offset: Int32 = 0
+    private var title = "Chat"
+    init(account: Account, peerId: PeerId, options: AyuChatExportOptions, subscriber: Subscriber<AyuChatExportEvent, AyuChatExportError>) {
+        self.account = account; self.peerId = peerId; self.options = options; self.subscriber = subscriber
+    }
+    private var isCancelled: Bool { self.lock.lock(); defer { self.lock.unlock() }; return self.cancelled }
+    func cancel() {
+        self.lock.lock(); self.cancelled = true; self.lock.unlock()
+        self.request.dispose()
+        self.queue.async { if !self.finished { self.writer?.discard() } }
+    }
+    func start() {
+        self.queue.async { [self] in
+            guard !self.isCancelled else { return }
+            do { self.writer = try AyuChatExportWriter(parent: FileManager.default.temporaryDirectory, options: self.options) }
+            catch { self.fail(.storage); return }
+            self.request.set((self.account.postbox.transaction { transaction -> Peer? in transaction.getPeer(self.peerId) }
+            |> deliverOn(self.queue)).start(next: { [weak self] peer in
+                guard let self, !self.isCancelled else { return }
+                guard let peer, [Namespaces.Peer.CloudUser, Namespaces.Peer.CloudGroup, Namespaces.Peer.CloudChannel].contains(peer.id.namespace), !peer.isCopyProtectionEnabled, let input = apiInputPeer(peer) else { self.fail(.unsupported); return }
+                if self.options.forwardToSaved && self.peerId == self.account.peerId { self.fail(.unsupported); return }
+                self.peer = peer; self.inputPeer = input; self.title = Self.peerTitle(peer)
+                self.queue.async { self.nextPage() }
+            }))
+        }
+    }
+    private static func peerTitle(_ peer: Peer?) -> String {
+        if let user = peer as? TelegramUser { return user.nameOrPhone }
+        if let group = peer as? TelegramGroup { return group.title }
+        if let channel = peer as? TelegramChannel { return channel.title }
+        return "Chat"
+    }
+    private static func rawId(_ message: Api.Message) -> Int32 {
+        switch message { case let .message(value): return value.id; case let .messageService(value): return value.id; case let .messageEmpty(value): return value.id }
+    }
+    private func nextPage() {
+        guard !self.isCancelled, let input = self.inputPeer, let peer = self.peer else { return }
+        self.request.set((self.account.network.request(Api.functions.messages.getHistory(peer: input, offsetId: self.offset, offsetDate: 0, addOffset: 0, limit: 100, maxId: 0, minId: 0, hash: 0), automaticFloodWait: false)
+        |> deliverOn(self.queue)).start(next: { [weak self] result in
+            guard let self, !self.isCancelled else { return }
+            let messages: [Api.Message], users: [Api.User], chats: [Api.Chat]
+            switch result {
+            case let .messages(data): messages = data.messages; users = data.users; chats = data.chats
+            case let .messagesSlice(data): messages = data.messages; users = data.users; chats = data.chats
+            case let .channelMessages(data): messages = data.messages; users = data.users; chats = data.chats
+            case .messagesNotModified: self.fail(.network); return
+            }
+            if messages.isEmpty { self.complete(truncated: false); return }
+            let next = messages.map(Self.rawId).filter { $0 > 0 }.min() ?? 0
+            guard next > 0, self.offset == 0 || next < self.offset else { self.fail(.network); return }
+            let oldOffset = self.offset
+            self.offset = next
+            self.request.set((self.account.postbox.transaction { transaction -> [(StoreMessage, String)]? in
+                let peers = AccumulatedPeers(transaction: transaction, chats: chats, users: users)
+                if (peers.peers[self.peerId] ?? transaction.getPeer(self.peerId))?.isCopyProtectionEnabled != false { return nil }
+                return messages.compactMap { api -> (StoreMessage, String)? in
+                    guard let message = StoreMessage(apiMessage: api, accountPeerId: self.account.peerId, peerIsForum: peer.isForumOrMonoForum), case let .Id(id) = message.id, id.peerId == self.peerId, oldOffset == 0 || id.id < oldOffset else { return nil }
+                    return (message, Self.peerTitle(message.authorId.flatMap { authorId -> Peer? in peers.peers[authorId] ?? peers.users[authorId].map { TelegramUser(user: $0) } ?? transaction.getPeer(authorId) }))
+                }
+            } |> deliverOn(self.queue)).start(next: { [weak self] values in
+                guard let self, !self.isCancelled, let writer = self.writer else { return }
+                guard let values else { self.fail(.unsupported); return }
+                do {
+                    var rows: [AyuChatExportMessage] = []
+                    for (message, author) in values {
+                        if self.isCancelled { return }
+                        guard case let .Id(id) = message.id, message.timestamp >= self.options.fromTimestamp, message.timestamp <= self.options.untilTimestamp else { continue }
+                        if writer.count + rows.count >= self.options.maximumMessages { break }
+                        let excluded = message.flags.contains(.CopyProtected) || message.attributes.contains(where: { $0 is AutoremoveTimeoutMessageAttribute || $0 is AutoclearTimeoutMessageAttribute || $0 is EphemeralMessageAttribute || $0 is EphemeralReplacementMessageAttribute || $0 is EphemeralOutgoingMessageAttribute })
+                        if self.options.forwardToSaved && (excluded || message.media.contains(where: { $0 is TelegramMediaAction })) { continue }
+                        var path: String?, name: String?, photo = false, mediaStatus: String?
+                        if !excluded, !self.options.forwardToSaved, let media = message.media.first(where: { $0 is TelegramMediaFile || $0 is TelegramMediaImage }) {
+                            let resource: MediaResource?
+                            if let file = media as? TelegramMediaFile { resource = file.resource; name = file.fileName ?? "attachment" }
+                            else if let image = media as? TelegramMediaImage { resource = largestImageRepresentation(image.representations)?.resource; name = "photo.jpg"; photo = true }
+                            else { resource = nil }
+                            let source = resource.flatMap { self.account.postbox.mediaBox.completedResourcePath($0) }.map { URL(fileURLWithPath: $0) }
+                            path = try writer.copyMedia(source: source, name: name ?? "attachment")
+                            if path == nil { mediaStatus = self.options.includeCachedMedia ? "Media not cached or exceeds export budget" : "Media excluded by export settings" }
+                        } else if excluded { mediaStatus = "Protected or expiring content omitted" }
+                        else if !message.media.isEmpty { mediaStatus = "Additional media type; no local file exported" }
+                        let entityData = excluded ? nil : message.attributes.compactMap { $0 as? TextEntitiesMessageAttribute }.first.flatMap { try? JSONEncoder().encode($0.entities) }
+                        let reply = message.attributes.compactMap { $0 as? ReplyMessageAttribute }.first?.messageId.id
+                        let authorId = message.authorId.map { ($0.namespace == Namespaces.Peer.CloudUser ? "user" : "channel") + String($0.id._internalGetInt64Value()) }
+                        rows.append(AyuChatExportMessage(id: id.id, timestamp: message.timestamp, author: author, authorId: authorId, text: (excluded || self.options.forwardToSaved) ? "" : message.text, peerId: String(id.peerId.toInt64()), replyId: reply, photo: photo ? path : nil, file: photo ? nil : path, fileName: name, mediaStatus: mediaStatus, entities: entityData, service: message.media.contains(where: { $0 is TelegramMediaAction })))
+                    }
+                    try writer.appendPage(rows)
+                    self.subscriber.putNext(.progress(messages: writer.count, mediaBytes: writer.mediaBytes))
+                    if writer.count >= self.options.maximumMessages { self.complete(truncated: true) }
+                    else if !values.isEmpty && values.allSatisfy({ $0.0.timestamp < self.options.fromTimestamp }) { self.complete(truncated: false) }
+                    else { self.queue.after(0.2, { [weak self] in self?.nextPage() }) }
+                } catch { self.fail(.storage) }
+            }))
+        }, error: { [weak self] _ in self?.fail(.network) }))
+    }
+    private func complete(truncated: Bool) {
+        guard !self.isCancelled, let writer = self.writer else { return }
+        if self.options.forwardToSaved {
+            self.partial = truncated; self.forwarding = true; self.forwardPage = writer.pageCount - 1
+            self.queue.async { self.forwardNextPage() }; return
+        }
+        do {
+            let type: String
+            if let channel = self.peer as? TelegramChannel {
+                let prefix = channel.addressName == nil ? "private_" : "public_"
+                if case .group = channel.info { type = prefix + "supergroup" } else { type = prefix + "channel" }
+            } else if let user = self.peer as? TelegramUser { type = user.botInfo == nil ? "personal_chat" : "bot_chat" }
+            else { type = "private_group" }
+            let url = try writer.finish(title: self.title, peerId: self.peerId.id._internalGetInt64Value(), type: type, truncated: truncated, cancelled: { self.isCancelled })
+            guard !self.isCancelled else { writer.discard(); return }
+            self.finished = true; self.subscriber.putNext(.completed(url)); self.subscriber.putCompletion()
+        } catch { self.fail(self.isCancelled ? .cancelled : .storage) }
+    }
+    private func forwardNextPage() {
+        guard !self.isCancelled, let writer = self.writer, let input = self.inputPeer else { return }
+        if self.forwardPage < 0 {
+            writer.discard(); self.finished = true
+            self.subscriber.putNext(.savedToSelf(messages: self.forwarded, partial: self.partial)); self.subscriber.putCompletion(); return
+        }
+        let ids: [Int32]
+        do { ids = try writer.messageIds(page: self.forwardPage) } catch { self.fail(.storage); return }
+        self.forwardPage -= 1
+        if ids.isEmpty { self.queue.async { self.forwardNextPage() }; return }
+        let flags: Int32 = self.account.network.ayuGhostMode.current.shouldSendSilently ? (1 << 5) : 0
+        self.request.set((self.account.network.request(Api.functions.messages.forwardMessages(flags: flags, fromPeer: input, id: ids, randomId: ids.map { _ in Int64.random(in: Int64.min...Int64.max) }, toPeer: .inputPeerSelf, topMsgId: nil, replyTo: nil, scheduleDate: nil, scheduleRepeatPeriod: nil, sendAs: nil, quickReplyShortcut: nil, effect: nil, videoTimestamp: nil, allowPaidStars: nil, suggestedPost: nil), automaticFloodWait: false)
+        |> deliverOn(self.queue)).start(next: { [weak self] updates in
+            guard let self else { return }
+            self.account.stateManager.addUpdates(updates)
+            self.account.network.ayuReassertOfflineAfterSending()
+            self.forwarded += ids.count
+            self.subscriber.putNext(.forwarding(messages: self.forwarded, total: writer.count))
+            self.queue.after(0.5, { [weak self] in self?.forwardNextPage() })
+        }, error: { [weak self] _ in self?.fail(.network) }))
+    }
+    private func fail(_ error: AyuChatExportError) { self.writer?.discard(); if !self.isCancelled { self.subscriber.putError(error) } }
+}
diff --git a/submodules/TelegramCore/Sources/AyuGram/AyuChatExportModels.swift b/submodules/TelegramCore/Sources/AyuGram/AyuChatExportModels.swift
