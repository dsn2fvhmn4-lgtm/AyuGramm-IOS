+import Foundation
+import TelegramCore
+
+public extension AccountContext {
+    func ayuShouldDisplayReactions(message: EngineRawMessage) -> Bool {
+        if message.id.peerId == self.account.peerId || message.areReactionsTags(accountPeerId: self.account.peerId) || message.adAttribute != nil { return true }
+        guard message.id.namespace == Namespaces.Message.Cloud, let peer = message.peers[message.id.peerId] else { return true }
+        let scope: AyuReactionDisplaySettings.Scope
+        if peer is TelegramUser { scope = .privateChat }
+        else if peer is TelegramGroup { scope = .group }
+        else if let channel = peer as? TelegramChannel {
+            switch channel.info {
+            case .group: scope = .group
+            case .broadcast: scope = .channel
+            }
+        } else { scope = .other }
+        return self.account.network.ayuGhostMode.current.reactionDisplay.allows(scope)
+    }
+
+    /// Presentation values only: never strip attributes from the source message.
+    func ayuVisibleMessageReactions(message: EngineRawMessage) -> ReactionsMessageAttribute? {
+        guard self.ayuShouldDisplayReactions(message: message) else { return nil }
+        return mergedMessageReactions(attributes: message.attributes, isTags: message.areReactionsTags(accountPeerId: self.account.peerId))
+    }
+
+    func ayuVisibleMessageReactionsAndPeers(accountPeer: EnginePeer?, message: EngineRawMessage) -> (reactions: [MessageReaction], peers: [(MessageReaction.Reaction, EnginePeer)]) {
+        guard self.ayuShouldDisplayReactions(message: message) else { return ([], []) }
+        return mergedMessageReactionsAndPeers(accountPeerId: self.account.peerId, accountPeer: accountPeer, message: message)
+    }
+}
