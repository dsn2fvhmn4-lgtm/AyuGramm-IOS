@@ -0,0 +1,35 @@
+import Foundation
+import Postbox
+import SwiftSignalKit
+
+public extension EngineMessage {
+    var ayuCanMessageShot: Bool {
+        guard self.id.namespace == Namespaces.Message.Cloud, [Namespaces.Peer.CloudUser, Namespaces.Peer.CloudGroup, Namespaces.Peer.CloudChannel].contains(self.id.peerId.namespace), self.adAttribute == nil,
+              !self._asMessage().isCopyProtected(), !self._asMessage().containsSecretMedia else { return false }
+        return !self.attributes.contains {
+            $0 is AutoremoveTimeoutMessageAttribute || $0 is AutoclearTimeoutMessageAttribute || $0 is EphemeralMessageAttribute || $0 is EphemeralReplacementMessageAttribute || $0 is EphemeralOutgoingMessageAttribute || $0 is RestrictedContentMessageAttribute
+        } && !self.media.contains { $0 is TelegramMediaAction || $0 is TelegramMediaExpiredContent }
+    }
+}
+
+public extension TelegramEngine.Messages {
+    /// Local reads only. Refuse the entire selection if one item is missing or cannot
+    /// be exported; never silently omit selected content from a screenshot.
+    func ayuMessageShotMessages(ids: [EngineMessage.Id]) -> Signal<[EngineMessage]?, NoError> {
+        return self.account.postbox.transaction { transaction -> [EngineMessage]? in
+            let ids = Set(ids)
+            guard !ids.isEmpty, ids.count <= AyuMessageShotPolicy.maximumMessages else { return nil }
+            var messages: [EngineMessage] = []
+            for id in ids {
+                guard let message = transaction.getMessage(id), let peer = transaction.getPeer(id.peerId), !peer.isCopyProtectionEnabled else { return nil }
+                if let data = transaction.getPeerCachedData(peerId: id.peerId) as? CachedUserData,
+                   data.flags.contains(.copyProtectionEnabled) || data.flags.contains(.myCopyProtectionEnabled) { return nil }
+                let item = EngineMessage(message)
+                guard item.ayuCanMessageShot else { return nil }
+                messages.append(item)
+            }
+            guard Set(messages.map { $0.id.peerId }).count == 1, AyuMessageShotPolicy.accepts(texts: messages.map { $0.text }) else { return nil }
+            return messages.sorted { $0.index < $1.index }
+        }
+    }
+}
diff --git a/submodules/TelegramCore/Sources/AyuGram/AyuMessageShotPolicy.swift b/submodules/TelegramCore/Sources/AyuGram/AyuMessageShotPolicy.swift
new file mode 100644
index 00000000..01703f52
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuGram/AyuMessageShotPolicy.swift
@@ -0,0 +1,34 @@
+import Foundation
+
+public enum AyuMessageShotPolicy {
+    public static let maximumMessages = 20
+    public static let maximumTextBytes = 8192
+    public static let maximumTotalTextBytes = 32768
+    public static let imageWidth = 900
+    public static let maximumImageHeight = 8000
+
+    public static func accepts(texts: [String]) -> Bool {
+        guard !texts.isEmpty, texts.count <= maximumMessages else { return false }
+        var total = 0
+        for text in texts {
+            let size = text.utf8.count
+            guard size <= maximumTextBytes else { return false }
+            total += size
+            if total > maximumTotalTextBytes { return false }
+        }
+        return true
+    }
+
+    /// Entity offsets are UTF-16, like Telegram's text entities. Keep the length
+    /// unchanged so formatting ranges remain valid after masking spoilers.
+    public static func maskingSpoilers(_ text: String, ranges: [Range<Int>]) -> String {
+        let result = NSMutableString(string: text)
+        for range in ranges {
+            guard range.lowerBound >= 0, range.upperBound <= result.length, !range.isEmpty else {
+                return String(repeating: "•", count: result.length)
+            }
+            result.replaceCharacters(in: NSRange(location: range.lowerBound, length: range.count), with: String(repeating: "•", count: range.count))
+        }
+        return result as String
+    }
+}
diff --git a/submodules/TelegramCore/Sources/AyuGram/AyuRegexSettings.swift b/submodules/TelegramCore/Sources/AyuGram/AyuRegexSettings.swift
new file mode 100644
index 00000000..b186c962
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuGram/AyuRegexSettings.swift
@@ -0,0 +1,63 @@
+import Foundation
+
+public struct AyuRegexSettings: Codable, Equatable {
+    public var enabled = false
+    public var includeChats = false
+    public var caseInsensitive = true
+    public var patterns: [String] = []
+    public init() {}
+
+    public func validate() throws {
+        guard self.patterns.count <= 32 else {
+            throw NSError(domain: "AyuRegex", code: 1, userInfo: [NSLocalizedDescriptionKey: "Use at most 32 patterns."])
+        }
+        for (index, pattern) in self.patterns.enumerated() {
+            guard !pattern.isEmpty, pattern.utf8.count <= 512 else {
+                throw NSError(domain: "AyuRegex", code: 2, userInfo: [NSLocalizedDescriptionKey: "Pattern \(index + 1) must contain 1–512 UTF-8 bytes."])
+            }
+            do {
+                let _ = try NSRegularExpression(pattern: pattern, options: .anchorsMatchLines)
+            } catch {
+                throw NSError(domain: "AyuRegex", code: 3, userInfo: [NSLocalizedDescriptionKey: "Invalid pattern \(index + 1): \(error.localizedDescription)"])
+            }
+        }
+    }
+}
+
+/// Immutable compiled expressions are shared; matching never stores message text.
+public final class AyuRegexMatcher {
+    public static let shared = AyuRegexMatcher()
+    private let lock = NSLock()
+    private var cachedSettings: AyuRegexSettings?
+    private var cachedExpressions: [NSRegularExpression] = []
+    private init() {}
+
+    public func matches(_ text: String, settings: AyuRegexSettings, deadline: TimeInterval) -> Bool {
+        guard settings.enabled, !settings.patterns.isEmpty, !text.isEmpty,
+              text.utf8.count <= 16_384, Date.timeIntervalSinceReferenceDate < deadline else { return false }
+        self.lock.lock()
+        if self.cachedSettings != settings {
+            var options: NSRegularExpression.Options = [.anchorsMatchLines]
+            if settings.caseInsensitive { options.insert(.caseInsensitive) }
+            self.cachedExpressions = settings.patterns.compactMap { try? NSRegularExpression(pattern: $0, options: options) }
+            self.cachedSettings = settings
+        }
+        let expressions = self.cachedExpressions
+        self.lock.unlock()
+        let range = NSRange(text.startIndex ..< text.endIndex, in: text)
+        for expression in expressions {
+            guard Date.timeIntervalSinceReferenceDate < deadline else { return false }
+            var matched = false
+            expression.enumerateMatches(in: text, options: [.reportProgress], range: range) { result, _, stop in
+                if Date.timeIntervalSinceReferenceDate >= deadline {
+                    stop.pointee = true
+                } else if result != nil {
+                    matched = true
+                    stop.pointee = true
+                }
+            }
+            if matched { return true }
+        }
+        return false
+    }
+}
