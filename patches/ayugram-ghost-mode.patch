+/// Versioned, declarative plugin ABI. No Android or Python code is executed.
+public struct AyuPluginAction: Codable, Equatable {
+    public enum Kind: String, Codable { case search, searchTerms, replaceText, outgoingReplace, cameraFlip, chatColors, arcadeGame, unlimitedAccounts, groupMentions, petpet, reactionsTotal, formattedCopy }
+    public var id: String
+    public var title: String
+    public var kind: Kind
+    public var find: String?
+    public var replacement: String?
+    public var prefix: String?
+    public var condition: AyuPluginTextCondition?
+    public var replacementCount: Int?
+    public var program: AyuTextProgram?
+    public init(id: String, title: String, kind: Kind, find: String? = nil, replacement: String? = nil, prefix: String? = nil, condition: AyuPluginTextCondition? = nil, replacementCount: Int? = nil, program: AyuTextProgram? = nil) {
+        self.id = id; self.title = title; self.kind = kind; self.find = find; self.replacement = replacement
+        self.prefix = prefix; self.condition = condition; self.replacementCount = replacementCount; self.program = program
+    }
+    public var permission: String {
+        if self.kind == .formattedCopy { return "messages.copy.formatted" }
+        if self.kind == .reactionsTotal { return "messages.reactions.total" }
+        if self.kind == .petpet { return "media.petpet.create" }
+        if self.kind == .groupMentions { return "messages.mentions.expand" }
+        if self.kind == .arcadeGame { return "web.games.open" }
+        if self.kind == .unlimitedAccounts { return "accounts.limit.local" }
+        if self.kind == .chatColors { return "chatlist.appearance.modify" }
+        if self.kind == .cameraFlip { return "camera.switch" }
+        if self.kind == .outgoingReplace { return "messages.outgoing.modify" }
+        return self.kind == .replaceText ? "draft.prepare" : "search.messages"
+    }
+    public func ruleSummary(russian: Bool) -> String {
+        guard self.kind == .outgoingReplace else { return self.title }
+        if self.program != nil { return russian ? "Преобразованная программа обработки текста" : "Converted native text program" }
+        var parts = [String(reflecting: self.find ?? "") + " → " + String(reflecting: self.replacement ?? "")]
+        if let prefix = self.prefix { parts.append((russian ? "Начало: " : "Starts with: ") + String(reflecting: prefix)) }
+        if let condition = self.condition {
+            let label: String
+            switch condition.kind {
+            case .prefix: label = russian ? "Начало" : "Starts with"
+            case .suffix: label = russian ? "Конец" : "Ends with"
+            case .contains: label = russian ? "Содержит" : "Contains"
+            case .equals: label = russian ? "Равно" : "Equals"
+            }
+            parts.append((condition.negated ? (russian ? "НЕ " : "NOT ") : "") + label + ": " + String(reflecting: condition.value))
+        }
+        parts.append((russian ? "Замен: " : "Replacements: ") + (self.replacementCount.map { String($0) } ?? (russian ? "все" : "all")))
+        return parts.joined(separator: "\n")
+    }
+    public func queries(_ input: String) throws -> [String] {
+        guard self.kind == .search || self.kind == .searchTerms, input.utf8.count <= 2048 else { throw AyuPluginError.invalidInput }
+        let parts = self.kind == .searchTerms ? input.components(separatedBy: "|") : [input]
+        guard parts.count <= 6 else { throw AyuPluginError.invalidInput }
+        var result: [String] = []
+        for part in parts {
+            let query = part.trimmingCharacters(in: .whitespacesAndNewlines)
+            guard !query.isEmpty, query.count <= 128 else { throw AyuPluginError.invalidInput }
+            if !result.contains(query) { result.append(query) }
+        }
+        return result
+    }
+    public func transformed(_ input: String) throws -> String {
+        guard self.kind == .replaceText, input.utf8.count <= 8192,
+              let find = self.find, !find.isEmpty, let replacement = self.replacement else { throw AyuPluginError.invalidInput }
+        let text = input.replacingOccurrences(of: find, with: replacement)
+        guard !text.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty,
+              text.utf8.count <= 8192, text.utf16.count <= 4096 else { throw AyuPluginError.invalidInput }
+        return text
+    }
+}
