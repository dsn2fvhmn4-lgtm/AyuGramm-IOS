+            guard action.kind != .formattedCopy || self.apiVersion >= 9 else { throw AyuPluginError.invalidManifest }
+            guard (action.kind != .groupMentions && action.kind != .petpet && action.kind != .reactionsTotal) || self.apiVersion >= 8 else { throw AyuPluginError.invalidManifest }
