+import UIKit
+import TelegramCore
+
+final class AyuGroupMentionsController: UITableViewController {
+    private let store: AyuGhostModeStore
+    private let pluginID: String
+    private let russian: Bool
+    private var settings: AyuGroupMentionSettings {
+        return self.store.current.plugins.installed.first(where: { $0.manifest.id == self.pluginID })?.groupMentionSettings ?? AyuGroupMentionSettings()
+    }
+    init(store: AyuGhostModeStore, pluginID: String, russian: Bool) {
+        self.store = store; self.pluginID = pluginID; self.russian = russian
+        super.init(style: .insetGrouped)
+        self.title = "Group Mentions"
+    }
+    required init?(coder: NSCoder) { return nil }
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        self.navigationItem.rightBarButtonItem = UIBarButtonItem(barButtonSystemItem: .add, target: self, action: #selector(self.addGroup))
+        self.tableView.rowHeight = UITableView.automaticDimension
+        self.tableView.estimatedRowHeight = 60
+    }
+    override func numberOfSections(in tableView: UITableView) -> Int { return 2 }
+    override func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int { return section == 0 ? 3 : self.settings.groups.count }
+    override func tableView(_ tableView: UITableView, titleForHeaderInSection section: Int) -> String? {
+        return section == 0 ? (self.russian ? "Где применять" : "Apply in") : (self.russian ? "Группы упоминаний" : "Mention groups")
+    }
+    override func tableView(_ tableView: UITableView, titleForFooterInSection section: Int) -> String? {
+        if section == 0 { return self.russian ? "Каналы, секретные чаты, запланированные и форматированные сообщения исключены. Для каждого чата кулдаун 60 секунд. Поддерживаются обычный текст и неформатированные подписи." : "Broadcasts, secret chats, scheduled and formatted messages are excluded. Each chat has a 60-second cooldown. Supports plain text and unformatted captions." }
+        return self.russian ? "До 5 групп, по 7 юзернеймов. Команда заменяется целиком: например, команда друзья → @alice @bob. Включи плагин на предыдущем экране." : "Up to 5 groups with 7 usernames each. Whole commands are expanded: friends → @alice @bob. Enable the plugin on the previous screen."
+    }
