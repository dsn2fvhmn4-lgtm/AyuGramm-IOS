+    public var hideFastShare = false
+    public var hideChatsBadge = false
+    public var showMessageShot = true
+    public var showReactionPicker = true
+    public var showReadSummary = true
+    public var showEditedInfo = true
+    public var showMessageDetails = true
+    public var showAuthorSearch = true
+    public init() {}
+
+    private enum CodingKeys: String, CodingKey {
+        case showPeerIds, hideFastShare, hideChatsBadge, showMessageShot
+        case showReactionPicker, showReadSummary, showEditedInfo, showMessageDetails, showAuthorSearch
+    }
+    public init(from decoder: Decoder) throws {
+        let values = try decoder.container(keyedBy: CodingKeys.self)
+        self.showPeerIds = try values.decodeIfPresent(Bool.self, forKey: .showPeerIds) ?? false
+        self.hideFastShare = try values.decodeIfPresent(Bool.self, forKey: .hideFastShare) ?? false
+        self.hideChatsBadge = try values.decodeIfPresent(Bool.self, forKey: .hideChatsBadge) ?? false
+        self.showMessageShot = try values.decodeIfPresent(Bool.self, forKey: .showMessageShot) ?? true
+        self.showReactionPicker = try values.decodeIfPresent(Bool.self, forKey: .showReactionPicker) ?? true
+        self.showReadSummary = try values.decodeIfPresent(Bool.self, forKey: .showReadSummary) ?? true
+        self.showEditedInfo = try values.decodeIfPresent(Bool.self, forKey: .showEditedInfo) ?? true
+        self.showMessageDetails = try values.decodeIfPresent(Bool.self, forKey: .showMessageDetails) ?? true
+        self.showAuthorSearch = try values.decodeIfPresent(Bool.self, forKey: .showAuthorSearch) ?? true
+    }
+}
+
+public enum AyuPeerIdFormat {
+    public enum Kind { case user, group, channel, other }
+    public static func text(id: Int64, kind: Kind) -> String {
+        let raw = String(id)
+        let magnitude = raw.hasPrefix("-") ? String(raw.dropFirst()) : raw
+        switch kind {
+        case .user, .other: return raw
+        case .group: return "-\(magnitude)"
+        case .channel: return "-100\(magnitude)"
+        }
+    }
+}
