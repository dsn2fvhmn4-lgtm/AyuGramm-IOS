diff --git a/submodules/Display/Source/AyuArcadeGameController.swift b/submodules/Display/Source/AyuArcadeGameController.swift
new file mode 100644
index 00000000..40ce1257
--- /dev/null
+++ b/submodules/Display/Source/AyuArcadeGameController.swift
@@ -0,0 +1,233 @@
+import UIKit
+import WebKit
+
+/// Full-screen web game for the Arcade Games plugin, mirroring its Android dialog:
+/// close button, exit confirmation, screen kept awake and the plugin's ad-blocking script.
+public final class AyuArcadeGameController: UIViewController, WKNavigationDelegate {
+    /// Hosts the games may load; all other main-frame navigations open nowhere.
+    public static let gameHosts: Set<String> = ["play2048.co", "flappybird.io", "chromedino.com"]
+
+    private let url: URL
+    private let showCloseButton: Bool
+    private let confirmExit: Bool
+    private let russian: Bool
+    private let keepAwake: (() -> (() -> Void))?
+    private var releaseAwake: (() -> Void)?
+    private var webView: WKWebView?
+    private var injectionTimer: Timer?
+
+    public init(url: URL, showCloseButton: Bool, confirmExit: Bool, russian: Bool, keepAwake: (() -> (() -> Void))?) {
+        self.url = url; self.showCloseButton = showCloseButton; self.confirmExit = confirmExit
+        self.russian = russian; self.keepAwake = keepAwake
+        super.init(nibName: nil, bundle: nil)
+        self.modalPresentationStyle = .fullScreen
+    }
+    required init?(coder: NSCoder) { return nil }
+
+    public override var prefersStatusBarHidden: Bool { return true }
+    public override var prefersHomeIndicatorAutoHidden: Bool { return true }
+    public override var supportedInterfaceOrientations: UIInterfaceOrientationMask { return .portrait }
+
+    public override func viewDidLoad() {
+        super.viewDidLoad()
+        let background = UIColor(red: 0xea / 255.0, green: 0xe8 / 255.0, blue: 0xda / 255.0, alpha: 1.0)
+        self.view.backgroundColor = background
+        let configuration = WKWebViewConfiguration()
+        configuration.mediaTypesRequiringUserActionForPlayback = .all
+        configuration.userContentController.addUserScript(WKUserScript(source: AyuArcadeGameController.adBlockScript, injectionTime: .atDocumentEnd, forMainFrameOnly: true))
+        let webView = WKWebView(frame: self.view.bounds, configuration: configuration)
+        webView.autoresizingMask = [.flexibleWidth, .flexibleHeight]
+        webView.backgroundColor = background
+        webView.isOpaque = false
+        webView.scrollView.showsVerticalScrollIndicator = false
+        webView.scrollView.showsHorizontalScrollIndicator = false
+        webView.scrollView.contentInsetAdjustmentBehavior = .never
+        webView.navigationDelegate = self
+        self.view.addSubview(webView)
+        self.webView = webView
+        webView.load(URLRequest(url: self.url))
+
+        if self.showCloseButton {
+            let button = UIButton(type: .system)
+            button.setTitle("✕", for: .normal)
+            button.titleLabel?.font = .systemFont(ofSize: 22.0, weight: .semibold)
+            button.setTitleColor(.white, for: .normal)
+            button.backgroundColor = UIColor(white: 0.0, alpha: 0.25)
+            button.layer.cornerRadius = 20.0
+            button.accessibilityLabel = self.russian ? "Закрыть игру" : "Close game"
+            button.translatesAutoresizingMaskIntoConstraints = false
+            button.addTarget(self, action: #selector(self.closeTapped), for: .touchUpInside)
+            self.view.addSubview(button)
+            NSLayoutConstraint.activate([
+                button.widthAnchor.constraint(equalToConstant: 40.0),
+                button.heightAnchor.constraint(equalToConstant: 40.0),
+                button.topAnchor.constraint(equalTo: self.view.safeAreaLayoutGuide.topAnchor, constant: 8.0),
+                button.trailingAnchor.constraint(equalTo: self.view.safeAreaLayoutGuide.trailingAnchor, constant: -12.0)
+            ])
+        }
+
+        // The Android plugin re-applies its script every 600 ms; ad scripts keep arriving.
+        // The timer is invalidated when the game is dismissed.
+        self.injectionTimer = Timer.scheduledTimer(timeInterval: 0.6, target: self, selector: #selector(self.reinjectScript), userInfo: nil, repeats: true)
+    }
+
+    @objc private func reinjectScript() {
+        self.webView?.evaluateJavaScript(AyuArcadeGameController.adBlockScript, completionHandler: nil)
+    }
+
+    public override func viewDidAppear(_ animated: Bool) {
+        super.viewDidAppear(animated)
+        if self.releaseAwake == nil { self.releaseAwake = self.keepAwake?() }
+    }
+
+    public override func viewDidDisappear(_ animated: Bool) {
+        super.viewDidDisappear(animated)
+        if self.presentingViewController == nil || self.isBeingDismissed {
+            self.injectionTimer?.invalidate(); self.injectionTimer = nil
+            self.releaseAwake?(); self.releaseAwake = nil
+            self.webView?.stopLoading()
+        }
+    }
+
+    @objc private func closeTapped() {
+        guard self.confirmExit else { self.dismiss(animated: true); return }
+        let alert = UIAlertController(title: self.russian ? "Выйти из игры?" : "Exit the game?", message: nil, preferredStyle: .alert)
+        alert.addAction(UIAlertAction(title: self.russian ? "Выйти" : "Exit", style: .destructive, handler: { [weak self] _ in self?.dismiss(animated: true) }))
+        alert.addAction(UIAlertAction(title: self.russian ? "Отмена" : "Cancel", style: .cancel))
+        self.present(alert, animated: true)
+    }
+
+    public func webView(_ webView: WKWebView, decidePolicyFor navigationAction: WKNavigationAction, decisionHandler: @escaping (WKNavigationActionPolicy) -> Void) {
+        // Like the Android window.open stub: popups and off-site main-frame jumps stay closed.
+        guard navigationAction.targetFrame?.isMainFrame ?? false else {
+            decisionHandler(navigationAction.targetFrame == nil ? .cancel : .allow)
+            return
+        }
+        let host = navigationAction.request.url?.host?.lowercased() ?? ""
+        let allowed = AyuArcadeGameController.gameHosts.contains(where: { host == $0 || host.hasSuffix("." + $0) })
