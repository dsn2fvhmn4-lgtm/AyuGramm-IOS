diff --git a/submodules/SettingsUI/Sources/AyuAppearanceController.swift b/submodules/SettingsUI/Sources/AyuAppearanceController.swift
new file mode 100644
index 00000000..e56a4624
--- /dev/null
+++ b/submodules/SettingsUI/Sources/AyuAppearanceController.swift
@@ -0,0 +1,145 @@
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import PresentationDataUtils
+import ItemListUI
+import AccountContext
+
+private struct AyuAppearanceDraft: Equatable {
+    var deleted: String
+    var edited: String
+}
+
+private struct AyuAppearanceArguments {
+    let toggle: (Int32, Bool) -> Void
+    let text: (Int32, String) -> Void
+    let save: () -> Void
+    let reset: () -> Void
+}
+
+private enum AyuAppearanceEntry: ItemListNodeEntry {
+    case header(Int32, String)
+    case toggle(Int32, String, Bool)
+    case input(Int32, String, String)
+    case action(Int32, String)
+    case info(Int32, String)
+
+    var stableId: Int32 {
+        switch self {
+        case let .header(id, _), let .toggle(id, _, _), let .input(id, _, _), let .action(id, _), let .info(id, _): return id
+        }
+    }
+
+    var section: ItemListSectionId {
+        switch self.stableId {
+        case 0 ... 2: return 0
+        case 3 ... 4: return 1
+        case 5 ... 6: return 2
+        default: return 3
+        }
+    }
+
+    static func < (lhs: AyuAppearanceEntry, rhs: AyuAppearanceEntry) -> Bool { return lhs.stableId < rhs.stableId }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! AyuAppearanceArguments
+        switch self {
+        case let .header(_, text):
+            return ItemListSectionHeaderItem(presentationData: presentationData, text: text, sectionId: self.section)
+        case let .toggle(id, title, value):
+            return ItemListSwitchItem(presentationData: presentationData, systemStyle: .glass, title: title, value: value, sectionId: self.section, style: .blocks, updated: { arguments.toggle(id, $0) })
+        case let .input(id, text, placeholder):
+            return ItemListSingleLineInputItem(presentationData: presentationData, systemStyle: .glass, title: NSAttributedString(string: ""), text: text, placeholder: placeholder, type: .regular(capitalization: false, autocorrection: false), returnKeyType: .done, spacing: 0.0, clearType: .always, maxLength: 24, sectionId: self.section, textUpdated: { arguments.text(id, $0) }, action: arguments.save)
+        case let .action(id, title):
+            return ItemListActionItem(presentationData: presentationData, systemStyle: .glass, title: title, kind: .generic, alignment: .natural, sectionId: self.section, style: .blocks, action: id == 7 ? arguments.save : arguments.reset)
+        case let .info(_, text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        }
+    }
+}
+
+public func ayuAppearanceController(context: AccountContext) -> ViewController {
+    let store = context.account.network.ayuGhostMode
+    let initial = store.current.appearance
+    let initialDraft = AyuAppearanceDraft(deleted: initial.deletedMark, edited: initial.editedMark)
+    let draftText = Atomic(value: initialDraft)
+    let draft = ValuePromise(initialDraft, ignoreRepeated: true)
+    var presentError: ((Error) -> Void)?
+    var finishEditing: (() -> Void)?
+    let arguments = AyuAppearanceArguments(toggle: { id, value in
+        do {
+            try store.update {
+                if id == 1 { $0.appearance.showGhostButton = value }
+                if id == 2 { $0.appearance.showMessageSeconds = value }
+            }
+        } catch { presentError?(error) }
+    }, text: { id, text in
+        let updated = draftText.modify { previous in
+            var updated = previous
+            if id == 4 { updated.deleted = text }
+            if id == 6 { updated.edited = text }
+            return updated
+        }
+        draft.set(updated)
+    }, save: {
+        let text = draftText.with { $0 }
+        do {
+            try store.update {
+                $0.appearance.deletedMark = text.deleted
+                $0.appearance.editedMark = text.edited
+            }
+            let appearance = store.current.appearance
+            let saved = AyuAppearanceDraft(deleted: appearance.deletedMark, edited: appearance.editedMark)
+            let _ = draftText.swap(saved)
+            draft.set(saved)
+            finishEditing?()
+        } catch { presentError?(error) }
+    }, reset: {
+        do {
+            try store.update { $0.appearance = AyuAppearanceSettings() }
+            let cleared = AyuAppearanceDraft(deleted: "", edited: "")
+            let _ = draftText.swap(cleared)
+            draft.set(cleared)
+            finishEditing?()
+        } catch { presentError?(error) }
+    })
+    let signal = combineLatest(context.sharedContext.presentationData, store.signal, draft.get())
+    |> deliverOnMainQueue
+    |> map { presentationData, settings, text -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        let appearance = settings.appearance
+        let unsaved = text.deleted != appearance.deletedMark || text.edited != appearance.editedMark
+        let entries: [AyuAppearanceEntry] = [
+            .header(0, "AYUGRAM"),
+            .toggle(1, ru ? "Призрак в заголовке чата" : "Ghost button in chat header", appearance.showGhostButton),
+            .toggle(2, ru ? "Секунды во времени сообщений" : "Seconds in message timestamps", appearance.showMessageSeconds),
+            .header(3, ru ? "МЕТКА УДАЛЁННЫХ СООБЩЕНИЙ" : "DELETED MESSAGE LABEL"),
+            .input(4, text.deleted, ru ? "Удалено" : "Deleted"),
+            .header(5, ru ? "МЕТКА ИЗМЕНЁННЫХ СООБЩЕНИЙ" : "EDITED MESSAGE LABEL"),
+            .input(6, text.edited, presentationData.strings.Conversation_MessageEditedLabel),
+            .action(7, ru ? (unsaved ? "Сохранить метки •" : "Сохранить метки") : (unsaved ? "Save labels •" : "Save labels")),
+            .action(8, ru ? "Сбросить оформление чатов" : "Reset chat appearance"),
+            .info(9, ru ? "Переключатели применяются сразу. Для текста нажми «Сохранить метки». Пустое поле возвращает стандартную подпись на языке приложения. До 24 символов и 96 байт в одной строке. Сохранение удалённых сообщений включается отдельно в «Истории сообщений». Если спрятать призрака, Ghost Mode по-прежнему доступен в настройках AyuGram." : "Switches apply immediately. Use Save labels for text changes. Empty fields restore the app language's default labels. Up to 24 characters and 96 bytes on one line. Deleted-message capture is enabled separately in Message History. Ghost Mode remains accessible from AyuGram settings when the header button is hidden.")
+        ]
+        let data = ItemListPresentationData(presentationData)
+        let state = ItemListControllerState(presentationData: data, title: .text(ru ? "Оформление чатов" : "Chat Appearance"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        return (state, (ItemListNodeState(presentationData: data, entries: entries, style: .blocks, animateChanges: false), arguments))
+    }
+    let controller = ItemListController(context: context, state: signal)
+    finishEditing = { [weak controller] in let _ = controller?.view.endEditing(true) }
+    presentError = { [weak controller] error in
+        let data = context.sharedContext.currentPresentationData.with { $0 }
+        let ru = data.strings.baseLanguageCode.hasPrefix("ru")
+        let text: String
+        if (error as NSError).domain == "AyuAppearance" {
+            text = ru ? "Используй одну строку до 24 символов и 96 байт, без управляющих символов." : error.localizedDescription
+        } else {
+            text = ru ? "Ошибка сохранения настроек оформления." : "Chat appearance could not be saved."
+        }
+        controller?.present(textAlertController(context: context, title: "AyuGram", text: text, actions: [TextAlertAction(type: .defaultAction, title: data.strings.Common_OK, action: {})]), in: .window(.root))
+    }
+    return controller
+}
diff --git a/submodules/SettingsUI/Sources/AyuChatOptionsController.swift b/submodules/SettingsUI/Sources/AyuChatOptionsController.swift
new file mode 100644
index 00000000..f54ed7b7
--- /dev/null
+++ b/submodules/SettingsUI/Sources/AyuChatOptionsController.swift
@@ -0,0 +1,124 @@
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import PresentationDataUtils
+import ItemListUI
+import AccountContext
+
+private struct AyuOptionsArguments {
+    let toggle: (Int32, Bool) -> Void
+    let text: (String) -> Void
+    let save: () -> Void
+}
+
+private enum AyuOptionsEntry: ItemListNodeEntry {
+    case toggle(Int32, String, Bool)
+    case input(String)
+    case save(String)
+    case info(Int32, String)
+
+    var section: ItemListSectionId { return 0 }
+    var stableId: Int32 {
+        switch self {
+        case let .toggle(id, _, _), let .info(id, _): return id
+        case .input: return 10
+        case .save: return 11
+        }
+    }
+    static func < (lhs: AyuOptionsEntry, rhs: AyuOptionsEntry) -> Bool { return lhs.stableId < rhs.stableId }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! AyuOptionsArguments
+        switch self {
+        case let .toggle(id, title, value):
+            return ItemListSwitchItem(presentationData: presentationData, systemStyle: .glass, title: title, value: value, sectionId: self.section, style: .blocks, updated: { arguments.toggle(id, $0) })
+        case let .input(text):
+            return ItemListMultilineInputItem(presentationData: presentationData, systemStyle: .glass, text: text, placeholder: "pattern", maxLength: ItemListMultilineInputItemTextLimit(value: 16500, display: true), sectionId: self.section, style: .blocks, capitalization: false, autocorrection: false, textUpdated: arguments.text)
+        case let .save(title):
+            return ItemListActionItem(presentationData: presentationData, systemStyle: .glass, title: title, kind: .generic, alignment: .natural, sectionId: self.section, style: .blocks, action: arguments.save)
+        case let .info(_, text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        }
+    }
+}
+
+public func ayuChatOptionsController(context: AccountContext, regex: Bool) -> ViewController {
+    let store = context.account.network.ayuGhostMode
+    let draft = ValuePromise<String>(store.current.regexFilters.patterns.joined(separator: "\n"), ignoreRepeated: true)
+    let draftText = Atomic<String>(value: store.current.regexFilters.patterns.joined(separator: "\n"))
+    var presentError: ((String) -> Void)?
+    let arguments = AyuOptionsArguments(toggle: { id, value in
+        do {
+            try store.update { settings in
+                if regex {
+                    switch id {
+                    case 0: settings.regexFilters.enabled = value
+                    case 1: settings.regexFilters.includeChats = value
+                    case 2: settings.regexFilters.caseInsensitive = value
+                    default: break
+                    }
+                } else {
+                    switch id {
+                    case 0, 1:
+                        let mode: AyuGhostModeSettings.SilentSendMode = id == 0 ? .always : .inGhostMode
+                        if value { settings.silentSendMode = mode }
+                        else if settings.silentSendMode == mode { settings.silentSendMode = .never }
+                    case 2: settings.mediaSend.confirmStickers = value
+                    case 3: settings.mediaSend.confirmGifs = value
+                    case 4: settings.mediaSend.previewVoice = value
+                    case 5: settings.mediaSend.previewRound = value
+                    default: break
+                    }
+                }
+            }
+        } catch { presentError?(error.localizedDescription) }
+    }, text: { text in
+        let _ = draftText.swap(text)
+        draft.set(text)
+    }, save: {
+        do {
+            try store.update { settings in
+                settings.regexFilters.patterns = draftText.with { $0.components(separatedBy: .newlines).filter { !$0.isEmpty } }
+            }
+        } catch { presentError?(error.localizedDescription) }
+    })
+    let signal = combineLatest(context.sharedContext.presentationData, store.signal, draft.get())
+    |> deliverOnMainQueue
+    |> map { presentationData, settings, text -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        let entries: [AyuOptionsEntry]
+        if regex {
+            entries = [
+                .toggle(0, ru ? "Скрывать совпавшие сообщения" : "Hide matching messages", settings.regexFilters.enabled),
+                .toggle(1, ru ? "Также в личных чатах и группах" : "Also in private chats and groups", settings.regexFilters.includeChats),
+                .toggle(2, ru ? "Без учёта регистра" : "Case insensitive", settings.regexFilters.caseInsensitive),
+                .info(3, ru ? "Одно регулярное выражение на строку, до 32 правил по 512 байт. По умолчанию фильтруются только каналы. Сообщения скрываются локально; база и синхронизация сохраняются. Альбом скрывается целиком при совпадении загруженной подписи. Реклама, служебные и секретные сообщения не фильтруются. Поиск и выбор сообщений показывают оригиналы. При исчерпании бюджета обработки часть сообщений может остаться видимой." : "One regular expression per line; up to 32 rules of 512 bytes. Channels only by default. Messages are hidden locally; database and synchronization are unchanged. Albums are hidden when a loaded caption matches. Ads, service and secret messages are excluded. Search/navigation and selection show originals. Messages can remain visible if the processing budget is exceeded."),
+                .input(text),
+                .save(ru ? "Сохранить правила" : "Save rules")
+            ]
+        } else {
+            entries = [
+                .toggle(0, ru ? "Всегда отправлять без звука" : "Always send without sound", settings.silentSendMode == .always),
+                .toggle(1, ru ? "Без звука в Ghost Mode" : "Send silently in Ghost Mode", settings.silentSendMode == .inGhostMode),
+                .toggle(2, ru ? "Подтверждать стикеры" : "Confirm sticker sends", settings.mediaSend.confirmStickers),
+                .toggle(3, ru ? "Подтверждать GIF" : "Confirm GIF sends", settings.mediaSend.confirmGifs),
+                .toggle(4, ru ? "Предпросмотр голосовых" : "Preview voice recordings", settings.mediaSend.previewVoice),
+                .toggle(5, ru ? "Предпросмотр кружков" : "Preview video notes", settings.mediaSend.previewRound),
