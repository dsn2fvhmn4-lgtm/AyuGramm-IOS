+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import AccountContext
+import TelegramPresentationData
+import LocalizedPeerData
+
+final class AyuChatColorsController: UITableViewController {
+    private let context: AccountContext
+    private let pluginID: String
+    private var settings = AyuChatColorSettings()
+    private var keys: [String] = []
+    private var titles: [String: String] = [:]
+    private var pluginPresent = false
+    private let observation = MetaDisposable()
+    private let peerRequest = MetaDisposable()
+    private var russian: Bool { return self.context.sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru") }
+    init(context: AccountContext, pluginID: String) {
+        self.context = context; self.pluginID = pluginID
+        super.init(style: .insetGrouped)
+        self.title = "Chat Colors"
+    }
+    required init?(coder: NSCoder) { return nil }
+    deinit { self.observation.dispose(); self.peerRequest.dispose() }
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        let pluginID = self.pluginID
+        self.observation.set((self.context.account.network.ayuGhostMode.signal
+        |> map { state in state.plugins.installed.first(where: { $0.manifest.id == pluginID }) }
+        |> distinctUntilChanged
+        |> deliverOnMainQueue).startStrict(next: { [weak self] plugin in
+            guard let self else { return }
+            self.pluginPresent = plugin?.manifest.actions.contains(where: { $0.kind == .chatColors }) == true
+            self.settings = plugin?.chatColorSettings ?? AyuChatColorSettings()
+            self.keys = self.settings.colors.keys.sorted()
+            self.tableView.reloadData(); self.loadTitles()
+        }))
+    }
+    private func loadTitles() {
+        let keys = self.keys
+        let data = self.context.sharedContext.currentPresentationData.with { $0 }
+        let ids = keys.compactMap { key -> (String, EnginePeer.Id)? in Int64(key).map { (key, EnginePeer.Id($0)) } }
+        self.peerRequest.set((self.context.engine.data.get(EngineDataMap(ids.map { TelegramEngine.EngineData.Item.Peer.Peer(id: $0.1) }))
+        |> map { peers -> [String: String] in
+            var result: [String: String] = [:]
+            for (key, id) in ids {
+                if let peer = peers[id] ?? nil {
+                    let title = peer.displayTitle(strings: data.strings, displayOrder: data.nameDisplayOrder)
+                    if !title.isEmpty { result[key] = title }
+                }
+            }
+            return result
+        } |> deliverOnMainQueue).startStrict(next: { [weak self] titles in
+            guard let self, self.keys == keys else { return }
+            self.titles = titles; self.tableView.reloadData()
+        }))
+    }
+    private func update(_ transform: (inout AyuChatColorSettings) -> Void) {
+        guard self.pluginPresent else { return }
+        do {
+            try self.context.account.network.ayuGhostMode.update { state in
+                var settings = state.plugins.installed.first(where: { $0.manifest.id == self.pluginID })?.chatColorSettings ?? AyuChatColorSettings()
+                transform(&settings)
+                try state.plugins.setChatColorSettings(id: self.pluginID, settings: settings)
+            }
+            self.settings = self.context.account.network.ayuGhostMode.current.plugins.installed.first(where: { $0.manifest.id == self.pluginID })?.chatColorSettings ?? AyuChatColorSettings()
+            self.keys = self.settings.colors.keys.sorted()
+        } catch { self.showError() }
+        self.tableView.reloadData()
+    }
+    private func showError() {
+        let alert = UIAlertController(title: "Chat Colors", message: self.russian ? "Изменения не сохранены. Предыдущие настройки сохранены." : "Changes were not saved. Previous settings were retained.", preferredStyle: .alert)
+        alert.addAction(UIAlertAction(title: "OK", style: .default)); self.present(alert, animated: true)
+    }
+    @objc private func enabledChanged(_ toggle: UISwitch) { self.update { $0.enabled = toggle.isOn } }
+    override func numberOfSections(in tableView: UITableView) -> Int { return 3 }
+    override func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int { return section == 0 ? 3 : (section == 1 ? max(1, self.keys.count) : 2) }
+    override func tableView(_ tableView: UITableView, titleForHeaderInSection section: Int) -> String? {
+        return self.russian ? ["Основное", "Покрашенные чаты", "Действия"][section] : ["General", "Colored chats", "Actions"][section]
+    }
+    override func tableView(_ tableView: UITableView, titleForFooterInSection section: Int) -> String? {
+        if !self.pluginPresent { return self.russian ? "Плагин удалён." : "Plugin removed." }
+        return section == 1 && self.keys.isEmpty ? (self.russian ? "Удерживай чат в списке или открой меню профиля → Цвет чата." : "Long-press a chat or open its profile menu → Chat color.") : nil
+    }
+    override func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
+        let cell = UITableViewCell(style: .subtitle, reuseIdentifier: nil)
+        cell.textLabel?.numberOfLines = 0; cell.detailTextLabel?.numberOfLines = 0
+        if indexPath.section == 0 {
+            cell.textLabel?.text = self.russian ? ["Включить цвета", "Яркость цвета", "Подобрать цвет на сайте"][indexPath.row] : ["Enable colors", "Color brightness", "Choose color on website"][indexPath.row]
+            if indexPath.row == 0 {
+                let toggle = UISwitch(); toggle.isOn = self.settings.enabled; toggle.isEnabled = self.pluginPresent
+                toggle.accessibilityLabel = cell.textLabel?.text; toggle.addTarget(self, action: #selector(self.enabledChanged(_:)), for: .valueChanged)
+                cell.accessoryView = toggle; cell.selectionStyle = .none
+            } else if indexPath.row == 1 { cell.detailTextLabel?.text = "\((self.settings.brightness + 1) * 10)%"; cell.accessoryType = .disclosureIndicator }
+        } else if indexPath.section == 1 {
+            if self.keys.isEmpty { cell.textLabel?.text = self.russian ? "Пока ни одного чата" : "No colored chats yet"; cell.selectionStyle = .none }
+            else {
+                let key = self.keys[indexPath.row]
+                cell.textLabel?.text = self.titles[key] ?? (self.russian ? "Чат " : "Chat ") + key
+                cell.detailTextLabel?.text = "#" + (self.settings.colors[key] ?? ""); cell.accessoryType = .disclosureIndicator
+            }
+        } else {
+            cell.textLabel?.text = self.russian ? ["Сбросить все цвета", "Канал автора @lerowplug"][indexPath.row] : ["Reset all colors", "Author channel @lerowplug"][indexPath.row]
+            if indexPath.row == 0 { cell.textLabel?.textColor = .systemRed }
+        }
+        return cell
+    }
+    override func tableView(_ tableView: UITableView, didSelectRowAt indexPath: IndexPath) {
+        tableView.deselectRow(at: indexPath, animated: true)
+        guard self.pluginPresent else { return }
+        if indexPath.section == 0 {
+            switch indexPath.row {
+            case 1:
+                let alert = UIAlertController(title: self.russian ? "Яркость цвета" : "Color brightness", message: nil, preferredStyle: .actionSheet)
+                for value in 0...9 { alert.addAction(UIAlertAction(title: "\((value + 1) * 10)%", style: .default, handler: { [weak self] _ in self?.update { $0.brightness = value } })) }
+                alert.addAction(UIAlertAction(title: self.russian ? "Отмена" : "Cancel", style: .cancel))
+                alert.popoverPresentationController?.sourceView = tableView; alert.popoverPresentationController?.sourceRect = tableView.rectForRow(at: indexPath)
+                self.present(alert, animated: true)
+            case 2: self.context.sharedContext.applicationBindings.openUrl("https://htmlcolorcodes.com/color-picker/")
+            default: break
+            }
+        } else if indexPath.section == 1, self.keys.indices.contains(indexPath.row), let raw = Int64(self.keys[indexPath.row]) {
+            ayuPresentChatColorPicker(context: self.context, peerId: EnginePeer.Id(raw), pluginID: self.pluginID)
+        } else if indexPath.section == 2 {
+            if indexPath.row == 1 { self.context.sharedContext.applicationBindings.openUrl("https://t.me/lerowplug"); return }
+            let alert = UIAlertController(title: self.russian ? "Сбросить все цвета?" : "Reset all colors?", message: nil, preferredStyle: .alert)
+            alert.addAction(UIAlertAction(title: self.russian ? "Сбросить" : "Reset", style: .destructive, handler: { [weak self] _ in self?.update { $0.colors.removeAll() } }))
+            alert.addAction(UIAlertAction(title: self.russian ? "Отмена" : "Cancel", style: .cancel)); self.present(alert, animated: true)
+        }
+    }
+}
diff --git a/submodules/SettingsUI/Sources/AyuChatOptionsController.swift b/submodules/SettingsUI/Sources/AyuChatOptionsController.swift
