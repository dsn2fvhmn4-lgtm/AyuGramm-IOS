@@ -0,0 +1,50 @@
+import Foundation
+
+public struct AyuCameraFlipSettings: Codable, Equatable {
+    public var trigger: Int
+    public var haptic: Bool
+    public init(trigger: Int = 0, haptic: Bool = true) { self.trigger = trigger; self.haptic = haptic }
+    public func validate() throws {
+        guard (0...3).contains(self.trigger) else { throw AyuPluginError.invalidManifest }
+    }
+}
+
+/// Native equivalent of Camera Flip 0.2.0's single-finger gesture thresholds.
+public struct AyuCameraFlipPolicy {
+    public enum Phase { case began, moved, ended, cancelled }
+    private var start: (x: Double, y: Double, time: Double)?
+    private var lastTap: Double?
+    private var lastFlip: Double?
+    private var fired = false
+    public init() {}
+    public mutating func cancel() { self.start = nil; self.lastTap = nil; self.fired = false }
+    private mutating func emit(_ time: Double) -> Bool {
+        if let last = self.lastFlip, time - last < 0.8 { return false }
+        self.lastFlip = time
+        return true
+    }
+    public mutating func handle(_ phase: Phase, x: Double, y: Double, time: Double, pointers: Int = 1, settings: AyuCameraFlipSettings) -> Bool {
+        guard x.isFinite, y.isFinite, time.isFinite, (0...3).contains(settings.trigger), pointers == 1 else { self.cancel(); return false }
+        if case .cancelled = phase { self.cancel(); return false }
+        if case .began = phase { self.start = (x, y, time); self.fired = false; return false }
+        guard let start = self.start, time >= start.time else { self.cancel(); return false }
+        let dx = x - start.x, dy = y - start.y
+        switch phase {
+        case .moved:
+            guard settings.trigger != 3, !self.fired, abs(dy) > 60, abs(dy) > 1.5 * abs(dx),
+                  settings.trigger == 0 || (settings.trigger == 1 && dy < 0) || (settings.trigger == 2 && dy > 0) else { return false }
+            self.fired = true
+            return self.emit(time)
+        case .ended:
+            self.start = nil
+            guard settings.trigger == 3, abs(dx) < 12, abs(dy) < 12, time - start.time < 0.25 else { self.lastTap = nil; return false }
+            if let last = self.lastTap, time >= last, time - last < 0.35 {
+                self.lastTap = nil
+                return self.emit(time)
+            }
+            self.lastTap = time
+            return false
+        case .began, .cancelled: return false
+        }
+    }
+}
