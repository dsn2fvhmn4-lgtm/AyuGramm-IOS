+import UIKit
+
+struct AyuPreferencesPalette {
+    let background: UIColor
+    let panel: UIColor
+    let text: UIColor
+    let secondary: UIColor
+    let accent: UIColor
+}
+
+final class AyuPreferencesHeaderView: UIView {
+    init(image: UIImage?, title: String, subtitle: String, text: String, palette: AyuPreferencesPalette? = nil) {
+        super.init(frame: .zero)
+        let logo = UIImageView(image: image)
+        logo.contentMode = .scaleAspectFit
+        logo.layer.cornerRadius = 44; logo.clipsToBounds = true
+        logo.translatesAutoresizingMaskIntoConstraints = false
+        logo.widthAnchor.constraint(equalToConstant: 88).isActive = true
+        logo.heightAnchor.constraint(equalToConstant: 88).isActive = true
+        let heading = UILabel(); heading.text = title; heading.font = .preferredFont(forTextStyle: .title3)
+        let version = UILabel(); version.text = subtitle; version.font = .preferredFont(forTextStyle: .subheadline)
+        let description = UILabel(); description.text = text; description.font = .preferredFont(forTextStyle: .body)
+        for label in [heading, version, description] {
+            label.numberOfLines = 0; label.textAlignment = .center; label.adjustsFontForContentSizeCategory = true
+        }
+        heading.textColor = palette?.text ?? .label
+        version.textColor = palette?.accent ?? .systemBlue
+        description.textColor = palette?.secondary ?? .secondaryLabel
+        let stack = UIStackView(arrangedSubviews: [logo, heading, version, description])
+        stack.axis = .vertical; stack.alignment = .center; stack.spacing = 10
+        stack.translatesAutoresizingMaskIntoConstraints = false
+        self.addSubview(stack)
+        NSLayoutConstraint.activate([
+            stack.leadingAnchor.constraint(equalTo: self.leadingAnchor, constant: 24),
+            stack.trailingAnchor.constraint(equalTo: self.trailingAnchor, constant: -24),
+            stack.topAnchor.constraint(equalTo: self.topAnchor, constant: 24),
+            stack.bottomAnchor.constraint(equalTo: self.bottomAnchor, constant: -24),
+            heading.widthAnchor.constraint(equalTo: stack.widthAnchor),
+            version.widthAnchor.constraint(equalTo: stack.widthAnchor),
+            description.widthAnchor.constraint(equalTo: stack.widthAnchor)
+        ])
+    }
+    required init?(coder: NSCoder) { return nil }
+}
+
+func ayuFitPreferencesHeader(_ tableView: UITableView) {
+    guard let header = tableView.tableHeaderView, tableView.bounds.width > 0 else { return }
+    let size = header.systemLayoutSizeFitting(CGSize(width: tableView.bounds.width, height: UIView.layoutFittingCompressedSize.height), withHorizontalFittingPriority: .required, verticalFittingPriority: .fittingSizeLevel)
+    if abs(header.frame.height - size.height) > 0.5 || header.frame.width != tableView.bounds.width {
+        header.frame = CGRect(x: 0, y: 0, width: tableView.bounds.width, height: size.height)
+        tableView.tableHeaderView = header
+    }
+}
