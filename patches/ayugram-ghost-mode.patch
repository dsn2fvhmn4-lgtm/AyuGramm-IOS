+
+private struct AyuSettingsArguments {
+    let open: (Int32) -> Void
+    let update: (Int32, Bool) -> Void
+    let record: (Int32) -> Void
+    let context: AccountContext?
+    let attachment: (String) -> Void
+    init(open: @escaping (Int32) -> Void, update: @escaping (Int32, Bool) -> Void, record: @escaping (Int32) -> Void, context: AccountContext? = nil, attachment: @escaping (String) -> Void = { _ in }) {
+        self.open = open
+        self.update = update
+        self.record = record
+        self.context = context
+        self.attachment = attachment
+    }
+}
+
+private enum AyuSettingsEntry: ItemListNodeEntry {
+    case link(Int32, String)
+    case toggle(Int32, String, Bool)
+    case info(Int32, String)
+    case clear(String)
+    case record(AyuMessageHistoryRecord)
+    case richText(AyuMessageHistoryRecord)
+    case attachment(Int32, AyuArchivedAttachment)
+
+    var section: ItemListSectionId {
+        switch self {
+        case .record, .attachment: return 1
+        default: return 0
+        }
+    }
+
+    var stableId: Int64 {
+        switch self {
+        case let .link(id, _), let .toggle(id, _, _), let .info(id, _): return Int64(id)
+        case .clear: return 50
+        case let .record(record): return 100 + Int64(record.id)
+        case .richText: return 1
+        case let .attachment(id, _): return 10_000 + Int64(id)
+        }
+    }
+
+    private var order: Int64 {
+        if case let .record(record) = self { return 100_000_000_000 - Int64(record.id) }
+        return self.stableId
+    }
+
+    static func < (lhs: AyuSettingsEntry, rhs: AyuSettingsEntry) -> Bool { return lhs.order < rhs.order }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! AyuSettingsArguments
+        switch self {
+        case let .link(id, title):
+            return ItemListDisclosureItem(presentationData: presentationData, systemStyle: .glass, title: title, label: "", sectionId: self.section, style: .blocks, action: { arguments.open(id) })
+        case let .toggle(id, title, value):
+            return ItemListSwitchItem(presentationData: presentationData, systemStyle: .glass, title: title, value: value, sectionId: self.section, style: .blocks, updated: { arguments.update(id, $0) })
+        case let .info(_, text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        case let .richText(record):
+            guard let context = arguments.context else {
+                return ItemListTextItem(presentationData: presentationData, text: .plain(record.text), sectionId: self.section)
+            }
+            let size = presentationData.fontSize.itemListBaseFontSize
+            let text = stringWithAppliedEntities(record.text, entities: record.formattingEntities, baseColor: presentationData.theme.list.itemPrimaryTextColor, linkColor: presentationData.theme.list.itemAccentColor, baseFont: Font.regular(size), linkFont: Font.regular(size), boldFont: Font.semibold(size), italicFont: Font.italic(size), boldItalicFont: Font.semiboldItalic(size), fixedFont: Font.monospace(size), blockQuoteFont: Font.regular(size), message: nil)
+            return ItemListTextItem(presentationData: presentationData, text: .custom(context: context, string: text), sectionId: self.section)
+        case let .clear(title):
+            return ItemListActionItem(presentationData: presentationData, systemStyle: .glass, title: title, kind: .destructive, alignment: .natural, sectionId: self.section, style: .blocks, action: { arguments.open(10) })
+        case let .record(record):
+            let isRussian = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+            let kind = record.kind == .edited ? (isRussian ? "Правка" : "Edit") : (isRussian ? "Удаление" : "Deletion")
+            let preview = record.text.isEmpty ? (record.attachments?.first?.displayName ?? (isRussian ? "Медиа" : "Media")) : String(record.text.replacingOccurrences(of: "\n", with: " ").prefix(70))
+            return ItemListDisclosureItem(presentationData: presentationData, systemStyle: .glass, title: preview, label: kind, sectionId: self.section, style: .blocks, action: { arguments.record(record.id) })
+        case let .attachment(_, attachment):
+            return ItemListDisclosureItem(presentationData: presentationData, systemStyle: .glass, title: attachment.displayName, label: ByteCountFormatter.string(fromByteCount: attachment.byteCount, countStyle: .file), sectionId: self.section, style: .blocks, action: { arguments.attachment(attachment.id) })
+        }
+    }
+}
+
+public func ayuSettingsController(context: AccountContext) -> ViewController {
+    var push: ((ViewController) -> Void)?
+    let arguments = AyuSettingsArguments(open: { id in
+        switch id {
+        case 0: push?(ayuGhostModeController(context: context))
+        case 1: push?(ayuMessageHistoryController(context: context))
+        case 2: push?(ayuChatOptionsController(context: context, regex: false))
+        case 3: push?(ayuChatOptionsController(context: context, regex: true))
+        case 4: push?(ayuAppearanceController(context: context))
+        case 5: push?(ayuInterfaceSettingsController(context: context))
+        case 6: push?(ayuInterfaceSettingsController(context: context, contextMenu: true))
+        default: break
+        }
+    }, update: { _, _ in }, record: { _ in })
+    let signal = context.sharedContext.presentationData
+    |> deliverOnMainQueue
+    |> map { presentationData -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        let entries: [AyuSettingsEntry] = [
+            .link(0, "Ghost Mode"),
+            .link(1, ru ? "История сообщений" : "Message History"),
+            .link(2, ru ? "Отправка сообщений" : "Sending Options"),
+            .link(3, ru ? "Regex-фильтры" : "Regex Filters"),
+            .link(4, ru ? "Оформление чатов" : "Chat Appearance"),
+            .link(5, ru ? "Интерфейс" : "Interface"),
+            .link(6, ru ? "Меню сообщения" : "Message Menu"),
+            .info(7, ru ? "Неофициальный клиент. Полный набор функций AyuGram ещё переносится." : "Unofficial client. Full AyuGram feature parity is still in progress.")
+        ]
+        let data = ItemListPresentationData(presentationData)
+        return (ItemListControllerState(presentationData: data, title: .text("AyuGram"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back)), (ItemListNodeState(presentationData: data, entries: entries, style: .blocks, animateChanges: false), arguments))
+    }
+    let controller = ItemListController(context: context, state: signal)
+    push = { [weak controller] in controller?.push($0) }
+    return controller
+}
