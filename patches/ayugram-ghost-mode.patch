+    // Verbatim behavior of the Arcade Games plugin's ADBLOCK_JS.
+    static let adBlockScript = """
+    (function() {
+        try {
+            window.adsbygoogle = [];
+            window.adsbygoogle.push = function() {};
+            window.vm = { init: function(){}, push: function(){}, show: function(cb){ if(cb) cb(); } };
+            window.vmax = {};
+            window.primis = {};
+            window.aip = { show: function(cb){ if(cb) cb(); } };
