+    let picker = AyuAppIconPickerController(choices: choices, selected: context.sharedContext.applicationBindings.getAlternateIconName(), russian: ru, change: { name, completion in
+        context.sharedContext.applicationBindings.requestSetAlternateIconName(name, completion)
