+++ b/submodules/TelegramCore/Sources/AyuGram/AyuTranslation.swift
@@ -0,0 +1,99 @@
+import Foundation
+import Security
+import CryptoKit
+import SwiftSignalKit
+
+public enum AyuTranslationKeys {
+    private static func query(accountId: Int64, settings: AyuAdvancedSettings) throws -> [String: Any] {
+        let endpoint = try AyuTranslationRequest.endpoint(settings).absoluteString
+        let hash = SHA256.hash(data: Data(endpoint.utf8)).map { String(format: "%02x", $0) }.joined()
+        return [kSecClass as String: kSecClassGenericPassword, kSecAttrService as String: (Bundle.main.bundleIdentifier ?? "AyuGram") + ".translation", kSecAttrAccount as String: "\(accountId)." + settings.translationProvider.rawValue + "." + hash]
+    }
+    public static func read(accountId: Int64, settings: AyuAdvancedSettings) throws -> String? {
+        var query = try self.query(accountId: accountId, settings: settings)
+        query[kSecReturnData as String] = true; query[kSecMatchLimit as String] = kSecMatchLimitOne
+        var value: CFTypeRef?
+        let status = SecItemCopyMatching(query as CFDictionary, &value)
+        if status == errSecItemNotFound { return nil }
+        guard status == errSecSuccess, let data = value as? Data, let key = String(data: data, encoding: .utf8) else { throw AyuTranslationError.credentialStorage }
+        return key
+    }
+    public static func write(accountId: Int64, settings: AyuAdvancedSettings, key: String) throws {
+        // Scalars, not Characters: "\r\n" is one Character, so contains("\r") misses it.
+        guard key.utf8.count <= 1024, !key.unicodeScalars.contains(where: { $0.value < 0x20 || $0.value == 0x7F }) else { throw AyuTranslationError.configuration }
+        let query = try self.query(accountId: accountId, settings: settings)
+        if key.isEmpty {
+            let status = SecItemDelete(query as CFDictionary)
+            guard status == errSecSuccess || status == errSecItemNotFound else { throw AyuTranslationError.credentialStorage }
+            return
+        }
+        let attributes: [String: Any] = [kSecValueData as String: Data(key.utf8), kSecAttrAccessible as String: kSecAttrAccessibleAfterFirstUnlockThisDeviceOnly]
+        let status = SecItemUpdate(query as CFDictionary, attributes as CFDictionary)
+        if status == errSecItemNotFound {
+            var item = query; attributes.forEach { item[$0.key] = $0.value }
+            guard SecItemAdd(item as CFDictionary, nil) == errSecSuccess else { throw AyuTranslationError.credentialStorage }
+        } else if status != errSecSuccess { throw AyuTranslationError.credentialStorage }
+    }
+}
+private final class AyuTranslationDelegate: NSObject, URLSessionDataDelegate, @unchecked Sendable {
+    // URLSession uses a private serial delegate queue; cancellation does not mutate this state.
+    let provider: AyuAdvancedSettings.TranslationProvider
+    let subscriber: Subscriber<String, AyuTranslationError>
+    private var data = Data()
+    private var done = false
+    init(provider: AyuAdvancedSettings.TranslationProvider, subscriber: Subscriber<String, AyuTranslationError>) { self.provider = provider; self.subscriber = subscriber }
+    private func fail(_ error: AyuTranslationError, session: URLSession) {
+        guard !self.done else { return }; self.done = true
+        self.subscriber.putError(error); session.invalidateAndCancel()
+    }
+    func urlSession(_ session: URLSession, task: URLSessionTask, willPerformHTTPRedirection response: HTTPURLResponse, newRequest request: URLRequest, completionHandler: @escaping (URLRequest?) -> Void) { completionHandler(nil) }
+    func urlSession(_ session: URLSession, dataTask: URLSessionDataTask, didReceive response: URLResponse, completionHandler: @escaping (URLSession.ResponseDisposition) -> Void) {
+        guard let response = response as? HTTPURLResponse, (200...299).contains(response.statusCode), response.expectedContentLength <= 262144 else {
+            completionHandler(.cancel); self.fail(.provider((response as? HTTPURLResponse)?.statusCode ?? 0), session: session); return
+        }
+        completionHandler(.allow)
+    }
+    func urlSession(_ session: URLSession, dataTask: URLSessionDataTask, didReceive data: Data) {
+        guard !self.done else { return }
+        guard self.data.count + data.count <= 262144 else { self.fail(.tooLarge, session: session); return }
+        self.data.append(data)
+    }
+    func urlSession(_ session: URLSession, task: URLSessionTask, didCompleteWithError error: Error?) {
+        guard !self.done else { return }
+        if error != nil { self.fail(.network, session: session); return }
+        do {
+            let result = try AyuTranslationRequest.result(self.data, provider: self.provider)
+            self.done = true; self.subscriber.putNext(result); self.subscriber.putCompletion(); session.finishTasksAndInvalidate()
+        } catch { self.fail(.empty, session: session) }
+    }
+}
+public extension TelegramEngine.Messages {
+    func ayuTranslate(text: String) -> Signal<String, AyuTranslationError> {
+        let settings = self.account.network.ayuGhostMode.current.advanced
+        guard !text.isEmpty, text.utf8.count <= 16384 else { return .fail(.tooLarge) }
+        if settings.translationProvider == .telegram {
+            return self.translate(text: text, toLang: settings.translationTarget)
+            |> mapError { _ -> AyuTranslationError in .network }
+            |> mapToSignal { result -> Signal<String, AyuTranslationError> in
+                guard let result else { return .fail(.empty) }; return .single(result.0)
+            }
+        }
+        let accountId = self.account.id.int64
+        return Signal { subscriber in
+            do {
+                let key = try AyuTranslationKeys.read(accountId: accountId, settings: settings)
+                let request = try AyuTranslationRequest.build(settings: settings, text: text, key: key)
+                let delegate = AyuTranslationDelegate(provider: settings.translationProvider, subscriber: subscriber)
+                let configuration = URLSessionConfiguration.ephemeral
+                configuration.httpCookieStorage = nil; configuration.urlCredentialStorage = nil; configuration.httpShouldSetCookies = false
+                configuration.timeoutIntervalForRequest = 30; configuration.timeoutIntervalForResource = 45
+                let queue = OperationQueue(); queue.maxConcurrentOperationCount = 1
+                let session = URLSession(configuration: configuration, delegate: delegate, delegateQueue: queue)
+                let task = session.dataTask(with: request); task.resume()
+                return ActionDisposable { task.cancel(); session.invalidateAndCancel() }
+            } catch let error as AyuTranslationError { subscriber.putError(error) }
+            catch { subscriber.putError(.configuration) }
+            return EmptyDisposable
+        }
+    }
+}
