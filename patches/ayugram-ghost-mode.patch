+        case 5: push?(ayuInterfaceSettingsController(context: context))
+        case 6: push?(ayuInterfaceSettingsController(context: context, contextMenu: true))
+        case 7: push?(ayuMessageShotSettingsController(context: context))
+        case 8: push?(ayuHiddenMessagesController(context: context))
+        case 9: push?(ayuReactionSettingsController(context: context))
+        case 20: ayuPresentAppIcons(context: context)
+        case 50: ayuPresentAdvancedSettings(context: context, page: .sending)
+        case 51: ayuPresentAdvancedSettings(context: context, page: .translation)
+        case 52: ayuPresentAdvancedSettings(context: context, page: .cosmetics)
