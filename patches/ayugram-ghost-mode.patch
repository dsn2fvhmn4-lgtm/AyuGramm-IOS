+/// Literal code-unit predicates corresponding to Python string tests.
+public struct AyuPluginTextCondition: Codable, Equatable {
+    public enum Kind: String, Codable { case prefix, suffix, contains, equals }
+    public var kind: Kind
+    public var value: String
+    public var negated: Bool
+    public init(kind: Kind, value: String, negated: Bool = false) {
+        self.kind = kind; self.value = value; self.negated = negated
+    }
+    public func matches(_ text: String) -> Bool {
+        let matched: Bool
+        switch self.kind {
+        case .equals: matched = text.utf8.elementsEqual(self.value.utf8)
+        case .prefix: matched = self.value.isEmpty || (text as NSString).range(of: self.value, options: [.literal, .anchored]).location != NSNotFound
+        case .suffix: matched = self.value.isEmpty || (text as NSString).range(of: self.value, options: [.literal, .anchored, .backwards]).location != NSNotFound
+        case .contains: matched = self.value.isEmpty || (text as NSString).range(of: self.value, options: .literal).location != NSNotFound
+        }
+        return self.negated ? !matched : matched
+    }
+}
