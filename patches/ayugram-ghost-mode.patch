+    let resource: EngineMediaResource?
+    if let image = message.media.first(where: { $0 is TelegramMediaImage }) as? TelegramMediaImage,
+       let representation = largestImageRepresentation(image.representations) {
+        resource = EngineMediaResource(representation.resource)
+    } else if let file = message.media.first(where: { $0 is TelegramMediaFile }) as? TelegramMediaFile,
+              let representation = largestImageRepresentation(file.previewRepresentations) {
+        resource = EngineMediaResource(representation.resource)
+    } else { resource = nil }
+    guard let resource else { return .single(nil) }
+    // This observes the local cache and never starts a resource fetch.
+    return context.engine.resources.data(resource: resource, waitUntilFetchStatus: false)
+    |> take(1)
+    |> map { data -> UIImage? in
+        guard data.isComplete, data.availableSize > 0, data.availableSize <= 25_000_000 else { return nil }
+        return ayuMessageShotThumbnailImage(path: data.path)
+    }
+    |> timeout(2.0, queue: Queue.mainQueue(), alternate: .single(nil))
+}
+
+private func ayuMessageShotMediaLabel(_ message: EngineMessage, russian: Bool) -> String {
+    if message.attributes.contains(where: { $0 is MediaSpoilerMessageAttribute }) { return russian ? "Медиа со спойлером" : "Spoiler media" }
+    if message.media.contains(where: { $0 is TelegramMediaImage }) { return russian ? "Фото" : "Photo" }
+    if let file = message.media.first(where: { $0 is TelegramMediaFile }) as? TelegramMediaFile {
+        if file.isVoice { return russian ? "Голосовое сообщение" : "Voice message" }
+        if file.isInstantVideo { return russian ? "Видеосообщение" : "Video note" }
+        if file.isSticker { return russian ? "Стикер" : "Sticker" }
+        if file.isAnimated { return "GIF" }
+        if file.isVideo { return russian ? "Видео" : "Video" }
+        return String((file.fileName ?? (russian ? "Файл" : "File")).prefix(120))
+    }
+    if message.media.contains(where: { !($0 is TelegramMediaWebpage) }) { return russian ? "Вложение" : "Attachment" }
+    return ""
+}
