+import Foundation
+
+// Standalone tests compile the actual Foundation settings/store source, not a copy.
+// Network/UI integration requires the complete Telegram-iOS build and device testing.
+var checks = 0
+func check(_ condition: @autoclosure () -> Bool, _ message: String) {
+    guard condition() else { fatalError(message) }
+    checks += 1
+}
+
+let root = FileManager.default.temporaryDirectory.appendingPathComponent("AyuGhostModeTests-\(UUID().uuidString)")
+try FileManager.default.createDirectory(at: root, withIntermediateDirectories: true)
+defer { try? FileManager.default.removeItem(at: root) }
+let first = root.appendingPathComponent("account-1")
+let second = root.appendingPathComponent("account-2")
+try FileManager.default.createDirectory(at: first, withIntermediateDirectories: true)
+try FileManager.default.createDirectory(at: second, withIntermediateDirectories: true)
+
+let store = AyuGhostModeStore(accountPath: first.path)
+check(store.current == AyuGhostModeSettings(), "Fresh account must use upstream behavior")
+check(!store.hadLoadError, "Missing settings are not corruption")
+var observed: [AyuGhostModeSettings] = []
+let observation = store.observe { observed.append($0) }
+check(observed.count == 1, "Observer must receive an initial snapshot")
+try store.update { $0.setAllEnabled(true) }
+check(store.current.allEnabled, "Master switch must enable every implemented flag")
+check(observed.count == 2 && observed.last!.allEnabled, "Persisted updates must reach observers")
+check(AyuGhostModeStore(accountPath: first.path).current == store.current, "Settings must survive restart")
+check(AyuGhostModeStore(accountPath: second.path).current == AyuGhostModeSettings(), "Account policies must be isolated")
+try store.update { $0.hideTyping = false }
+check(!store.current.allEnabled && store.current.hideReadReceipts && store.current.hideOnline && store.current.hideUploadProgress, "Individual changes must preserve other flags")
+store.removeObserver(observation)
+try store.update { $0.setAllEnabled(false) }
+check(observed.count == 3, "Removed observers must receive no further updates")
+check(AyuGhostModeStore(accountPath: first.path).current == AyuGhostModeSettings(), "Disabling must persist")
+
+let broken = root.appendingPathComponent("missing-parent").appendingPathComponent("account")
+let failingStore = AyuGhostModeStore(accountPath: broken.path)
+var failureReported = false
+do { try failingStore.update { $0.setAllEnabled(true) } } catch { failureReported = true }
+check(failureReported, "Write failure must be reported")
+check(failingStore.current == AyuGhostModeSettings(), "Failed write must not change effective policy")
+
+try Data("broken json".utf8).write(to: second.appendingPathComponent("ayu-ghost-mode.json"))
+let corruptedStore = AyuGhostModeStore(accountPath: second.path)
+check(corruptedStore.hadLoadError, "Corruption must be surfaced")
+check(corruptedStore.current == AyuGhostModeSettings(), "Corruption must preserve upstream behavior")
+
+// Simultaneous transforms must not overwrite each other with stale snapshots.
+let concurrentStore = AyuGhostModeStore(accountPath: first.path)
+DispatchQueue.concurrentPerform(iterations: 20) { _ in
+    try! concurrentStore.update { $0.hideOnline.toggle() }
+}
+check(!concurrentStore.current.hideOnline, "Serialized transforms must preserve even toggle parity")
+check(AyuGhostModeStore(accountPath: first.path).current == concurrentStore.current, "Final disk state must match memory")
+print("PASS: \(checks) AyuGhostMode persistence/observation checks")
