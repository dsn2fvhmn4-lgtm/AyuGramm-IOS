diff --git a/submodules/TelegramCore/Sources/AyuGram/AyuGhostMode.swift b/submodules/TelegramCore/Sources/AyuGram/AyuGhostMode.swift
new file mode 100644
index 00000000..e0aed4d3
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuGram/AyuGhostMode.swift
@@ -0,0 +1,43 @@
+import Foundation
+import SwiftSignalKit
+internal import TelegramApi
+import MtProtoKit
+
+extension AyuGhostModeStore {
+    public var signal: Signal<AyuGhostModeSettings, NoError> {
+        return Signal { subscriber in
+            let id = self.observe { settings in
+                subscriber.putNext(settings)
+            }
+            return ActionDisposable {
+                self.removeObserver(id)
+            }
+        }
+        |> distinctUntilChanged
+    }
+}
+
+extension Network {
+    /// Only used at cloud history/discussion receipt call sites, never secret-chat or
+    /// readMessageContents paths. Completion retires local work without inventing server pts.
+    func requestAyuCloudRead<T>(_ data: (FunctionDescription, Buffer, DeserializeFunctionResponse<T>)) -> Signal<T, MTRpcError> {
+        return deferred {
+            if self.ayuGhostMode.current.hideReadReceipts {
+                return .complete()
+            }
+            return self.request(data)
+        }
+    }
+}
+
+func ayuSuppressInputActivity(_ activity: PeerInputActivity, settings: AyuGhostModeSettings) -> Bool {
+    switch activity {
+    case .uploadingFile, .uploadingPhoto, .uploadingVideo, .uploadingInstantVideo:
+        return settings.hideUploadProgress
+    case .typingText, .recordingVoice, .recordingInstantVideo, .choosingSticker:
+        return settings.hideTyping
+    default:
+        // Group-call speaking indicators and interactive/game actions are preserved.
+        return false
+    }
+}
