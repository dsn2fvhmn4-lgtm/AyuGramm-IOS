+/// The chat header's ghost button, drawn with AyuGram's own ghosts (AyuGram for Android): the
+/// filled Solar ghost while ghost mode is on, the outline ghost crossed out while it is off.
+private func ayuDrawGhostNavigationImage(active: Bool) -> UIImage {
+    return UIGraphicsImageRenderer(size: CGSize(width: 28.0, height: 28.0)).image { rendererContext in
+        let context = rendererContext.cgContext
+        // The Solar ghost leaves a margin in its 30-unit box, the outline ghost almost none.
+        let name = active ? "AyuGram/Ghost" : "AyuGram/GhostOutline"
+        let rect = active ? CGRect(x: 0.0, y: 0.0, width: 28.0, height: 28.0) : CGRect(x: 3.0, y: 3.0, width: 22.0, height: 22.0)
+        if let image = UIImage(bundleImageName: name)?.withTintColor(.white, renderingMode: .alwaysOriginal) {
+            image.draw(in: rect)
+        }
+        guard !active else {
+            return
+        }
+        // A slash with a clear gap around it, as the system draws crossed-out symbols.
+        context.setLineCap(.round)
+        context.setBlendMode(.clear)
+        context.setLineWidth(5.0)
+        context.move(to: CGPoint(x: 4.5, y: 4.5))
+        context.addLine(to: CGPoint(x: 23.5, y: 23.5))
+        context.strokePath()
+        context.setBlendMode(.normal)
+        context.setStrokeColor(UIColor.white.cgColor)
+        context.setLineWidth(2.0)
+        context.move(to: CGPoint(x: 4.5, y: 4.5))
+        context.addLine(to: CGPoint(x: 23.5, y: 23.5))
+        context.strokePath()
+    }.withRenderingMode(.alwaysTemplate)
+}
+
+private let ayuGhostNavigationImage = ayuDrawGhostNavigationImage(active: true)
+private let ayuGhostNavigationOffImage = ayuDrawGhostNavigationImage(active: false)
