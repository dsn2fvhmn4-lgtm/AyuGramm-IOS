+import Foundation
+import Display
+import SwiftSignalKit
+import TelegramCore
+import AccountContext
+import TelegramPresentationData
+import SettingsUI
+import PresentationDataUtils
+import AlertUI
+
+extension ChatControllerImpl {
+    func ayuAddFilterFromMessage(id: EngineMessage.Id) {
+        guard !self.ayuFilterDraftInProgress, self.context.account.network.ayuGhostMode.current.interface.showAddFilter else { return }
+        guard !self.presentationInterfaceState.copyProtectionEnabled else { return }
+        self.ayuFilterDraftInProgress = true
+        // Re-read the source message and current protection/expiry policy before
+        // putting any text into a persistent-rule editor. This performs local reads only.
+        let _ = (self.context.engine.messages.ayuMessageShotMessages(ids: [id])
+        |> timeout(3.0, queue: Queue.mainQueue(), alternate: .single(nil))
+        |> deliverOnMainQueue).startStandalone(next: { [weak self] messages in
+            guard let self else { return }
+            self.ayuFilterDraftInProgress = false
+            let ru = self.presentationData.strings.baseLanguageCode.hasPrefix("ru")
+            guard !self.presentationInterfaceState.copyProtectionEnabled, let message = messages?.first else {
+                self.present(textAlertController(context: self.context, title: "AyuGram", text: ru ? "Сообщение больше недоступно для создания фильтра." : "This message is no longer available for creating a filter.", actions: [TextAlertAction(type: .defaultAction, title: self.presentationData.strings.Common_OK, action: {})]), in: .window(.root))
+                return
+            }
+            do {
+                let patterns = try self.context.account.network.ayuGhostMode.current.regexFilters.draftAddingLiteral(message.text)
+                self.push(ayuChatOptionsController(context: self.context, regex: true, initialPatterns: patterns))
+            } catch {
+                self.present(textAlertController(context: self.context, title: "AyuGram", text: ru ? "Правило не добавлено: максимум 32 правила по 512 байт после экранирования. Для длинного сообщения задай короткую фразу вручную в Regex-фильтрах." : "Rule not added: up to 32 rules of 512 bytes after escaping. For a long message, enter a shorter phrase manually in Regex Filters.", actions: [TextAlertAction(type: .defaultAction, title: self.presentationData.strings.Common_OK, action: {})]), in: .window(.root))
+            }
+        })
+    }
+}
diff --git a/submodules/TelegramUI/Sources/Chat/ChatControllerAyuFormattedCopy.swift b/submodules/TelegramUI/Sources/Chat/ChatControllerAyuFormattedCopy.swift
new file mode 100644
index 00000000..651f4b61
--- /dev/null
+++ b/submodules/TelegramUI/Sources/Chat/ChatControllerAyuFormattedCopy.swift
@@ -0,0 +1,84 @@
+import Foundation
+import UIKit
+import SwiftSignalKit
+import TelegramCore
+import AccountContext
+import ChatControllerInteraction
+import ChatPresentationInterfaceState
+import UndoUI
+
+func ayuCanCopyFormatted(_ message: EngineRawMessage) -> Bool {
+    return message.id.namespace == Namespaces.Message.Cloud && !message.isCopyProtected() && message.adAttribute == nil && !message.media.contains(where: { $0 is TelegramMediaExpiredContent })
+}
+
+private func ayuFormattedCopyBody(_ message: EngineRawMessage, russian: Bool) -> String {
+    var markers: [String] = []
+    for media in message.media {
+        let label: String?
+        if media is TelegramMediaImage { label = russian ? "[фото]" : "[photo]" }
+        else if let file = media as? TelegramMediaFile {
+            if file.isInstantVideo { label = russian ? "[кружок]" : "[video message]" }
+            else if file.isVoice { label = russian ? "[голосовое сообщение]" : "[voice message]" }
+            else if file.isSticker { label = russian ? "[стикер]" : "[sticker]" }
+            else if file.isAnimated { label = "[GIF]" }
+            else if file.isVideo { label = russian ? "[видео]" : "[video]" }
+            else if file.isMusic { label = russian ? "[аудио]" : "[audio]" }
+            else { label = russian ? "[файл]" : "[file]" }
+            markers.append((label ?? (russian ? "[медиа]" : "[media]")) + (file.fileName.map { " " + $0 } ?? ""))
+            continue
+        } else if media is TelegramMediaAction { label = russian ? "[служебное сообщение]" : "[service message]" }
+        else if media is TelegramMediaPoll { label = russian ? "[опрос]" : "[poll]" }
+        else if media is TelegramMediaContact { label = russian ? "[контакт]" : "[contact]" }
+        else if media is TelegramMediaMap { label = russian ? "[геопозиция]" : "[location]" }
+        else { label = nil }
+        if let label { markers.append(label) }
+    }
+    var body = markers.joined(separator: "\n")
+    if !message.text.isEmpty { body += (body.isEmpty ? "" : "\n") + message.text }
+    if let transcription = message.attributes.compactMap({ $0 as? AudioTranscriptionMessageAttribute }).first, !transcription.isPending, transcription.error == nil, !transcription.text.isEmpty, transcription.text != message.text {
+        body += (body.isEmpty ? "" : "\n") + transcription.text
+    }
+    return body
+}
+
+private func ayuFormattedCopyAuthor(_ message: EngineRawMessage) -> String {
+    if let signature = message.attributes.compactMap({ $0 as? AuthorSignatureMessageAttribute }).first, !signature.signature.isEmpty { return signature.signature }
+    return message.author?.debugDisplayTitle ?? message.peers[message.id.peerId]?.debugDisplayTitle ?? ""
+}
+
+extension ChatControllerImpl {
+    func ayuCopyFormattedMessages(_ ids: [EngineMessage.Id]) {
+        guard let includeTimestamp = self.context.account.network.ayuGhostMode.current.plugins.activeFormattedCopyTimestamp,
+              let peerId = self.chatLocation.peerId, !self.presentationInterfaceState.copyProtectionEnabled, !self.presentationInterfaceState.myCopyProtectionEnabled,
+              !ids.isEmpty, ids.count <= 100, ids.allSatisfy({ $0.peerId == peerId }) else { return }
+        let russian = self.presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        let unique = Set(ids)
+        self.ayuFormattedCopyDisposable.set((self.context.account.postbox.transaction { transaction -> Result<String, Error> in
+            return Result {
+                let messages = unique.compactMap { transaction.getMessage($0) }.sorted { $0.timestamp == $1.timestamp ? $0.id.id < $1.id.id : $0.timestamp < $1.timestamp }
+                guard messages.count == unique.count, messages.allSatisfy(ayuCanCopyFormatted) else { throw AyuPluginError.invalidInput }
+                let records = messages.map { message -> AyuFormattedCopyRecord in
+                    var quote: AyuFormattedCopyRecord.Quote?
+                    if let reply = message.attributes.compactMap({ $0 as? ReplyMessageAttribute }).first {
+                        if let source = message.associatedMessages[reply.messageId] ?? transaction.getMessage(reply.messageId), ayuCanCopyFormatted(source) {
+                            quote = .init(author: ayuFormattedCopyAuthor(source), text: ayuFormattedCopyBody(source, russian: russian))
+                        } else { quote = .init(author: "", text: russian ? "[исходное сообщение недоступно]" : "[original message unavailable]") }
+                    }
+                    return AyuFormattedCopyRecord(timestamp: message.timestamp, author: ayuFormattedCopyAuthor(message), text: ayuFormattedCopyBody(message, russian: russian), quote: quote)
+                }
+                return try AyuFormattedCopyRecord.render(records, includeTimestamp: includeTimestamp, russian: russian)
+            }
+        } |> deliverOnMainQueue).start(next: { [weak self] result in
+            guard let self, self.view.window != nil, self.chatLocation.peerId == peerId, self.context.account.network.ayuGhostMode.current.plugins.activeFormattedCopyTimestamp != nil,
+                  !self.presentationInterfaceState.copyProtectionEnabled, !self.presentationInterfaceState.myCopyProtectionEnabled else { return }
+            switch result {
+            case let .success(text):
+                UIPasteboard.general.string = text
+                self.controllerInteraction?.displayUndo(.copy(text: self.presentationData.strings.Conversation_MessageCopied))
+            case .failure:
+                let alert = UIAlertController(title: russian ? "Копирование не выполнено" : "Copy did not complete", message: russian ? "Часть сообщений недоступна или превышен лимит: 100 сообщений и 1 МБ текста." : "Some messages are unavailable, or the limit of 100 messages / 1 MB was exceeded.", preferredStyle: .alert)
+                alert.addAction(UIAlertAction(title: "OK", style: .default)); self.context.sharedContext.applicationBindings.presentNativeController(alert)
+            }
+        }))
+    }
+}
