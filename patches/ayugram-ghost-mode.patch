+++ b/submodules/TelegramCore/Sources/AyuGram/AyuAndroidPluginConverter.swift
@@ -0,0 +1,173 @@
+import Foundation
+
+public struct AyuPluginConversionError: LocalizedError {
+    public let line: Int
+    public let reason: String
+    public var errorDescription: String? { return "Android conversion, line \(self.line): \(self.reason)" }
+}
+
+/// A whole-file grammar, not substring matching or Python execution. Unrecognized statements reject conversion.
+public enum AyuAndroidPluginConverter {
+    public static let templateID = "exteraGram/literal-send-hook-v1"
+    private enum Token: Equatable { case word(String), literal(String), mark(String), integer(Int) }
+    private struct Row { let number: Int; let indent: Int; let tokens: [Token] }
+    private static func fail(_ line: Int, _ reason: String = "No complete iOS template for this syntax") -> AyuPluginConversionError {
+        return AyuPluginConversionError(line: line, reason: reason)
+    }
+    private static func tokens(_ source: String, line: Int) throws -> [Token] {
+        let chars = Array(source.unicodeScalars)
+        var index = 0, result: [Token] = []
+        while index < chars.count {
+            let char = chars[index]
+            if char == " " { index += 1; continue }
+            if char == "#" { break }
+            if char == "\"" || char == "'" {
+                let quote = char; index += 1; var value = ""; var closed = false
+                while index < chars.count {
+                    let current = chars[index]; index += 1
+                    if current == quote { closed = true; break }
+                    if current == "\\" {
+                        guard index < chars.count else { throw self.fail(line) }
+                        let escaped = chars[index]; index += 1
+                        switch escaped {
+                        case "n": value.append("\n")
+                        case "r": value.append("\r")
+                        case "t": value.append("\t")
+                        case "\\", "\"", "'": value.unicodeScalars.append(escaped)
+                        default: throw self.fail(line, "Unsupported string escape")
+                        }
+                    } else { value.unicodeScalars.append(current) }
+                }
+                guard closed else { throw self.fail(line, "Unterminated string") }
+                result.append(.literal(value)); continue
+            }
+            if (65...90).contains(char.value) || (97...122).contains(char.value) || char == "_" {
+                let start = index; index += 1
+                while index < chars.count {
+                    let value = chars[index].value
+                    if (65...90).contains(value) || (97...122).contains(value) || (48...57).contains(value) || value == 95 { index += 1 }
+                    else { break }
+                }
+                var word = ""
+                for scalar in chars[start..<index] { word.unicodeScalars.append(scalar) }
+                result.append(.word(word)); continue
+            }
+            if (48...57).contains(char.value) {
+                var digits = ""
+                while index < chars.count, (48...57).contains(chars[index].value) { digits.unicodeScalars.append(chars[index]); index += 1 }
+                guard digits.count <= 4, let value = Int(digits), value <= 4096, digits == "0" || !digits.hasPrefix("0") else { throw self.fail(line, "Replacement count must be 0...4096") }
+                result.append(.integer(value)); continue
+            }
+            guard ".!=():,->".unicodeScalars.contains(char) else { throw self.fail(line) }
+            result.append(.mark(String(char))); index += 1
+        }
+        return result
+    }
+    private static func pattern(_ text: String) -> [Token] { return (try? self.tokens(text, line: 0)) ?? [] }
+    private static func condition(_ row: Row) throws -> AyuPluginTextCondition {
+        var values = row.tokens
+        guard values.first == .word("if"), values.last == .mark(":"), row.indent == 8 else { throw self.fail(row.number) }
+        values.removeFirst(); values.removeLast()
+        var negated = false
+        if values.first == .word("not") { negated = true; values.removeFirst() }
+        if values.count == 8, values.last == .mark(")"), case let .literal(value) = values[6] {
+            for (method, kind) in [("startswith", AyuPluginTextCondition.Kind.prefix), ("endswith", .suffix)] {
+                if Array(values.prefix(6)) == self.pattern("params.message." + method + "(") {
+                    return AyuPluginTextCondition(kind: kind, value: value, negated: negated)
+                }
+            }
+        }
+        if values.count == 6, Array(values.prefix(3)) == self.pattern("params.message"), case let .literal(value) = values[5] {
+            let operation = Array(values[3...4])
+            guard operation == self.pattern("==") || operation == self.pattern("!=") else { throw self.fail(row.number) }
+            return AyuPluginTextCondition(kind: .equals, value: value, negated: operation == self.pattern("!=") ? !negated : negated)
+        }
+        if values.count >= 5, case let .literal(value) = values[0], Array(values.suffix(3)) == self.pattern("params.message") {
+            let operation = Array(values.dropFirst().dropLast(3))
+            guard operation == self.pattern("in") || operation == self.pattern("not in") else { throw self.fail(row.number) }
+            return AyuPluginTextCondition(kind: .contains, value: value, negated: operation == self.pattern("not in") ? !negated : negated)
+        }
+        throw self.fail(row.number, "Unsupported text condition")
+    }
+    public static func convert(_ data: Data, sourceSHA256: String) throws -> AyuPluginManifest {
+        guard data.count <= 65536, let source = String(data: data, encoding: .utf8), !source.contains("\0"), !source.contains("\t") else { throw self.fail(0, "Template source must be UTF-8, at most 64 KB, with spaces for indentation") }
+        let lines = source.replacingOccurrences(of: "\r\n", with: "\n").components(separatedBy: "\n")
+        guard lines.count <= 512 else { throw self.fail(0, "Template has too many lines") }
+        var rows: [Row] = []
+        for (index, line) in lines.enumerated() {
+            guard line.utf8.count <= 4096 else { throw self.fail(index + 1, "Line exceeds template limit") }
+            let parsed = try self.tokens(line, line: index + 1)
+            if !parsed.isEmpty { rows.append(Row(number: index + 1, indent: line.prefix(while: { $0 == " " }).count, tokens: parsed)) }
+        }
+        var cursor = 0
+        func expect(_ text: String, indent: Int) throws {
+            guard cursor < rows.count, rows[cursor].indent == indent, rows[cursor].tokens == self.pattern(text) else { throw self.fail(cursor < rows.count ? rows[cursor].number : lines.count) }
+            cursor += 1
+        }
+        func expectOne(_ texts: [String], indent: Int) throws {
+            guard cursor < rows.count, rows[cursor].indent == indent, texts.contains(where: { self.pattern($0) == rows[cursor].tokens }) else { throw self.fail(cursor < rows.count ? rows[cursor].number : lines.count) }
+            cursor += 1
+        }
+        guard cursor < rows.count else { throw self.fail(0) }
+        let imports = rows[cursor]
+        guard imports.indent == 0, imports.tokens.count == 8,
+              Array(imports.tokens.prefix(3)) == self.pattern("from base_plugin import"),
+              imports.tokens[4] == .mark(","), imports.tokens[6] == .mark(","),
+              Set([imports.tokens[3], imports.tokens[5], imports.tokens[7]].compactMap { token -> String? in if case let .word(value) = token { return value }; return nil }) == Set(["BasePlugin", "HookResult", "HookStrategy"]) else { throw self.fail(imports.number, "Only the supported base_plugin imports are accepted") }
+        cursor += 1
+        let hasTypingImport = cursor < rows.count && rows[cursor].tokens == self.pattern("from typing import Any") && rows[cursor].indent == 0
+        if hasTypingImport { cursor += 1 }
+        var metadata: [String: String] = [:]
+        let keys = Set(["__id__", "__name__", "__author__", "__version__", "__description__", "__icon__", "__min_version__", "__app_version__", "__sdk_version__"])
+        while cursor < rows.count, rows[cursor].tokens.first != .word("class") {
+            let row = rows[cursor]
+            guard row.indent == 0, row.tokens.count == 3, case let .word(key) = row.tokens[0], keys.contains(key), metadata[key] == nil,
+                  row.tokens[1] == .mark("="), case let .literal(value) = row.tokens[2] else { throw self.fail(row.number, "Metadata must contain literal strings only") }
+            metadata[key] = value; cursor += 1
+        }
+        guard cursor < rows.count else { throw self.fail(lines.count, "Missing plugin class") }
+        let declaration = rows[cursor]
+        guard declaration.indent == 0, declaration.tokens.count == 6, declaration.tokens[0] == .word("class"),
+              case let .word(className) = declaration.tokens[1], Array(declaration.tokens.suffix(4)) == self.pattern("(BasePlugin):") else { throw self.fail(declaration.number) }
+        let reserved = Set(["BasePlugin", "HookResult", "HookStrategy", "Any", "False", "None", "True", "and", "as", "assert", "async", "await", "break", "class", "continue", "def", "del", "elif", "else", "except", "finally", "for", "from", "global", "if", "import", "in", "is", "lambda", "nonlocal", "not", "or", "pass", "raise", "return", "try", "while", "with", "yield"])
