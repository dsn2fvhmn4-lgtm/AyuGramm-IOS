--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuGram/AyuTextToolsPolicy.swift
@@ -0,0 +1,14 @@
+import Foundation
+
+public enum AyuTextToolsPolicy {
+    public static func canRepeat(_ text: String) -> Bool {
+        return !text.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty
+            && text.utf8.count <= 8192 && (text as NSString).length <= 4096
+    }
+    public static func searchQuery(for text: String) -> String? {
+        guard text.utf8.count <= 8192 else { return nil }
+        let query = text.split(whereSeparator: { $0.isWhitespace }).joined(separator: " ")
+        guard !query.isEmpty, query.count <= 128 else { return nil }
+        return query
+    }
+}
