diff --git a/submodules/PasscodeCore/Tests/PasscodeCoreTests/AyuPrivateKeychainTests.swift b/submodules/PasscodeCore/Tests/PasscodeCoreTests/AyuPrivateKeychainTests.swift
new file mode 100644
index 00000000..3ae7bd95
--- /dev/null
+++ b/submodules/PasscodeCore/Tests/PasscodeCoreTests/AyuPrivateKeychainTests.swift
@@ -0,0 +1,37 @@
+import XCTest
+import Security
+@testable import PasscodeCore
+
+final class AyuPrivateKeychainTests: XCTestCase {
+    private func environment(scope: String) throws -> PasscodeEnvironment {
+        let result = PasscodeEnvironment()
+        try result.configure(PasscodeConfiguration(appGroupIdentifier: "group.org.ayugram.tests", processRole: .mainApp, biometricKeychainService: "wallet.biometric", appPrivateKeychainScope: scope), privateAccessGroup: { "TEAM.org.ayugram.tests" })
+        return result
+    }
+
+    func testStandaloneQueriesIsolateCredentialsAndBiometrics() throws {
+        let scope = UUID().uuidString
+        let storage = PasscodeKeychain(environment: try self.environment(scope: scope))
+        let credential = try storage.query("credential")
+        let biometric = try storage.query("biometric.test")
+        XCTAssertNil(credential[kSecAttrAccessGroup as String])
+        XCTAssertNil(biometric[kSecAttrAccessGroup as String])
+        XCTAssertEqual(credential[kSecAttrService as String] as? String, "org.ayugram.private." + scope + "/org.telegram.passcode.v1")
+        XCTAssertEqual(biometric[kSecAttrService as String] as? String, "org.ayugram.private." + scope + "/wallet.biometric")
+        let other = PasscodeKeychain(environment: try self.environment(scope: UUID().uuidString))
+        let otherCredential = try other.query("credential")
+        XCTAssertNotEqual(credential[kSecAttrService as String] as? String, otherCredential[kSecAttrService as String] as? String)
+    }
+
+    func testInvalidScopeAndExtensionAreRejected() throws {
+        XCTAssertThrowsError(try self.environment(scope: ""))
+        XCTAssertThrowsError(try self.environment(scope: "not-a-uuid"))
+        let extensionEnvironment = PasscodeEnvironment()
+        XCTAssertThrowsError(try extensionEnvironment.configure(PasscodeConfiguration(appGroupIdentifier: "group.org.ayugram.tests", processRole: .appExtension, appPrivateKeychainScope: UUID().uuidString)))
+    }
+
+    func testConfiguredScopeCannotBeChangedDuringLaunch() throws {
+        let environment = try self.environment(scope: UUID().uuidString)
+        XCTAssertThrowsError(try environment.configure(PasscodeConfiguration(appGroupIdentifier: "group.org.ayugram.tests", processRole: .mainApp, appPrivateKeychainScope: UUID().uuidString), privateAccessGroup: { "TEAM.org.ayugram.tests" }))
+    }
+}
