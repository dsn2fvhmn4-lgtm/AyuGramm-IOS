+import Foundation
+
+public struct AyuMessageShotSettings: Codable, Equatable {
+    public enum Theme: String, Codable { case automatic, light, dark }
+    public var theme: Theme = .automatic
+    public var showBackground = true
+    public var showAuthors = true
+    public var showDate = true
+    public var showHeader = true
+    public var showMediaPreviews = true
+    public init() {}
+
+    private enum CodingKeys: String, CodingKey {
+        case theme, showBackground, showAuthors, showDate, showHeader, showMediaPreviews
+    }
+    public init(from decoder: Decoder) throws {
+        let values = try decoder.container(keyedBy: CodingKeys.self)
+        self.theme = (try? values.decode(Theme.self, forKey: .theme)) ?? .automatic
+        self.showBackground = try values.decodeIfPresent(Bool.self, forKey: .showBackground) ?? true
+        self.showAuthors = try values.decodeIfPresent(Bool.self, forKey: .showAuthors) ?? true
+        self.showDate = try values.decodeIfPresent(Bool.self, forKey: .showDate) ?? true
+        self.showHeader = try values.decodeIfPresent(Bool.self, forKey: .showHeader) ?? true
+        self.showMediaPreviews = try values.decodeIfPresent(Bool.self, forKey: .showMediaPreviews) ?? true
+    }
+    public func isDark(fallback: Bool) -> Bool {
+        switch self.theme {
+        case .automatic: return fallback
+        case .light: return false
+        case .dark: return true
+        }
+    }
+    public mutating func cycleTheme() {
+        switch self.theme {
+        case .automatic: self.theme = .light
+        case .light: self.theme = .dark
+        case .dark: self.theme = .automatic
+        }
+    }
+}
