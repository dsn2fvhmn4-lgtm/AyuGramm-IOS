@@ -0,0 +1,98 @@
+import Foundation
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import PresentationDataUtils
+import ItemListUI
+import AccountContext
+
+private struct AyuHiddenArguments {
+    let toggle: (Bool) -> Void
+    let restore: (AyuHiddenMessageReference) -> Void
+    let restoreAll: () -> Void
+}
+
+private enum AyuHiddenEntry: ItemListNodeEntry {
+    case toggle(String, Bool)
+    case info(String)
+    case restoreAll(String)
+    case message(AyuHiddenMessageReference, String, String)
+    var section: ItemListSectionId { return 0 }
+    var stableId: String {
+        switch self {
+        case .toggle: return "0-toggle"
+        case .info: return "1-info"
+        case .restoreAll: return "2-all"
+        case let .message(reference, _, _): return "3-" + reference.stableKey
+        }
+    }
+    static func < (lhs: AyuHiddenEntry, rhs: AyuHiddenEntry) -> Bool { return lhs.stableId < rhs.stableId }
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! AyuHiddenArguments
+        switch self {
+        case let .toggle(title, value):
+            return ItemListSwitchItem(presentationData: presentationData, systemStyle: .glass, title: title, value: value, sectionId: self.section, style: .blocks, updated: arguments.toggle)
+        case let .info(text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        case let .restoreAll(title):
+            return ItemListActionItem(presentationData: presentationData, systemStyle: .glass, title: title, kind: .generic, alignment: .natural, sectionId: self.section, style: .blocks, action: arguments.restoreAll)
+        case let .message(reference, title, label):
+            return ItemListDisclosureItem(presentationData: presentationData, systemStyle: .glass, title: title, label: label, sectionId: self.section, style: .blocks, action: { arguments.restore(reference) })
+        }
+    }
+}
+
+public func ayuHiddenMessagesController(context: AccountContext) -> ViewController {
+    let store = context.account.network.ayuGhostMode
+    var presentError: (() -> Void)?
+    var confirmAll: (() -> Void)?
+    let arguments = AyuHiddenArguments(toggle: { value in
+        do { try store.update { $0.hiddenMessages.enabled = value } }
+        catch { presentError?() }
+    }, restore: { reference in
+        do { try store.update { $0.hiddenMessages.restore(reference) } }
+        catch { presentError?() }
+    }, restoreAll: { confirmAll?() })
+    let signal = combineLatest(context.sharedContext.presentationData, store.signal)
+    |> deliverOnMainQueue
+    |> map { presentationData, settings -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        let hidden = settings.hiddenMessages
+        var entries: [AyuHiddenEntry] = [
+            .toggle(ru ? "Применять локальное скрытие" : "Apply local hiding", hidden.enabled),
+            .info(ru ? "Скрыто сообщений/альбомов: \(hidden.references.count)/200. Нажми на запись, чтобы вернуть её в ленту. Выключатель временно показывает всё, сохраняя список. Это не удаление: поиск, выделение, список чатов и другие устройства сохраняют обычное поведение. Скрытые элементы могут дополнительно скрываться Regex-фильтром." : "Hidden messages/albums: \(hidden.references.count)/200. Tap an entry to restore it. Turning this off temporarily shows everything while keeping the list. This does not delete messages: search, selection, chat lists and other devices retain native behavior. Restored items can still be hidden by a regex filter.")
+        ]
+        if !hidden.references.isEmpty { entries.append(.restoreAll(ru ? "Вернуть все сообщения" : "Restore all messages")) }
+        for reference in hidden.references {
+            let kind: AyuPeerIdFormat.Kind
+            switch reference.kind {
+            case .user: kind = .user
+            case .group: kind = .group
+            case .channel: kind = .channel
+            }
+            let peer = AyuPeerIdFormat.text(id: reference.peerId, kind: kind)
+            let title = (ru ? "Чат " : "Chat ") + peer + " · #\(reference.messageId)"
+            let label = reference.groupingKey == nil ? (ru ? "Вернуть" : "Restore") : (ru ? "Вернуть альбом" : "Restore album")
+            entries.append(.message(reference, title, label))
+        }
+        let data = ItemListPresentationData(presentationData)
+        return (ItemListControllerState(presentationData: data, title: .text(ru ? "Скрытые сообщения" : "Hidden Messages"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back)), (ItemListNodeState(presentationData: data, entries: entries.sorted(), style: .blocks, animateChanges: false), arguments))
+    }
+    let controller = ItemListController(context: context, state: signal)
+    presentError = { [weak controller] in
+        let data = context.sharedContext.currentPresentationData.with { $0 }
+        controller?.present(textAlertController(context: context, title: "AyuGram", text: data.strings.baseLanguageCode.hasPrefix("ru") ? "Не удалось сохранить список скрытых сообщений." : "The hidden-message list could not be saved.", actions: [TextAlertAction(type: .defaultAction, title: data.strings.Common_OK, action: {})]), in: .window(.root))
+    }
+    confirmAll = { [weak controller] in
+        let data = context.sharedContext.currentPresentationData.with { $0 }
+        controller?.present(textAlertController(context: context, title: "AyuGram", text: data.strings.baseLanguageCode.hasPrefix("ru") ? "Убрать все отметки скрытия этого аккаунта? Это не восстанавливает сообщения, удалённые на сервере." : "Remove all local hiding marks for this account? This does not recover messages deleted on the server.", actions: [
+            TextAlertAction(type: .genericAction, title: data.strings.Common_Cancel, action: {}),
+            TextAlertAction(type: .defaultAction, title: data.strings.Common_OK, action: {
+                do { try store.update { $0.hiddenMessages.restoreAll() } }
+                catch { presentError?() }
+            })
+        ]), in: .window(.root))
+    }
+    return controller
+}
