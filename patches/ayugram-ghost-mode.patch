+                    if text.length == 0 { text.append(NSAttributedString(string: ru ? "Сообщение" : "Message", attributes: [.font: Font.regular(30.0), .foregroundColor: color])) }
+                    let author = message.author?.displayTitle(strings: data.strings, displayOrder: data.nameDisplayOrder) ?? (ru ? "Автор" : "Author")
+                    let date = DateFormatter.localizedString(from: Date(timeIntervalSince1970: TimeInterval(message.timestamp)), dateStyle: .short, timeStyle: .short)
+                    cards.append(AyuMessageShotCard(author: String(author.prefix(80)), date: date, text: text, photo: photos[index], outgoing: !message.flags.contains(.Incoming)))
+                }
+                guard let image = ayuRenderMessageShot(cards: cards, dark: dark, width: CGFloat(AyuMessageShotPolicy.imageWidth), maximumHeight: CGFloat(AyuMessageShotPolicy.maximumImageHeight)) else { self.ayuMessageShotError(); return }
+                let preview = AyuMessageShotPreview(image: image)
+                preview.share = { [weak exportContext = context] controller in
+                    guard let context = exportContext else { return }
+                    controller.navigationItem.rightBarButtonItem?.isEnabled = false
+                    let _ = (context.engine.messages.ayuMessageShotMessages(ids: ids)
+                    |> timeout(3.0, queue: Queue.mainQueue(), alternate: .single(nil))
+                    |> deliverOnMainQueue).startStandalone(next: { [weak controller] current in
+                        guard let controller else { return }
+                        controller.navigationItem.rightBarButtonItem?.isEnabled = true
+                        guard current != nil else {
+                            let alert = UIAlertController(title: "MessageShot", message: ru ? "Сообщения больше недоступны для экспорта." : "These messages are no longer available for export.", preferredStyle: .alert)
+                            alert.addAction(UIAlertAction(title: data.strings.Common_OK, style: .default, handler: nil))
+                            controller.present(alert, animated: true)
