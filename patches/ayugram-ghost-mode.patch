+        let diagnostics = UITextView()
+        diagnostics.isEditable = false
+        diagnostics.font = .monospacedSystemFont(ofSize: 14.0, weight: .regular)
+        diagnostics.text = self.details
+        diagnostics.backgroundColor = .secondarySystemBackground
+        self.copyButton.setTitle(self.russian ? "Копировать диагностику" : "Copy diagnostics", for: .normal)
+        self.copyButton.addTarget(self, action: #selector(self.copyDetails), for: .touchUpInside)
