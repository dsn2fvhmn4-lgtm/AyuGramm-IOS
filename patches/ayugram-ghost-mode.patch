+import Foundation
+
+public struct AyuReactionDisplaySettings: Codable, Equatable {
+    public enum Scope { case privateChat, group, channel, other }
+    public var privateChats = true
+    public var groups = true
+    public var channels = true
+    public init() {}
+    private enum CodingKeys: String, CodingKey { case privateChats, groups, channels }
+    public init(from decoder: Decoder) throws {
+        let values = try decoder.container(keyedBy: CodingKeys.self)
+        self.privateChats = try values.decodeIfPresent(Bool.self, forKey: .privateChats) ?? true
+        self.groups = try values.decodeIfPresent(Bool.self, forKey: .groups) ?? true
+        self.channels = try values.decodeIfPresent(Bool.self, forKey: .channels) ?? true
+    }
+    public func allows(_ scope: Scope, isTag: Bool = false) -> Bool {
+        if isTag { return true }
+        switch scope {
+        case .privateChat: return self.privateChats
+        case .group: return self.groups
+        case .channel: return self.channels
+        case .other: return true
+        }
+    }
+}
