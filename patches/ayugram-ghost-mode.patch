+private func ayuDrawGhostNavigationImage(filled: Bool) -> UIImage {
+    let renderer = UIGraphicsImageRenderer(size: CGSize(width: 28.0, height: 28.0))
+    return renderer.image { rendererContext in
+        UIColor.white.setStroke()
+        let outline = UIBezierPath()
+        outline.move(to: CGPoint(x: 4.5, y: 24.0))
+        outline.addLine(to: CGPoint(x: 4.5, y: 12.0))
+        outline.addCurve(to: CGPoint(x: 23.5, y: 12.0), controlPoint1: CGPoint(x: 4.5, y: -0.5), controlPoint2: CGPoint(x: 23.5, y: -0.5))
+        outline.addLine(to: CGPoint(x: 23.5, y: 24.0))
+        for point in [CGPoint(x: 19.0, y: 21.0), CGPoint(x: 14.0, y: 24.0), CGPoint(x: 9.0, y: 21.0), CGPoint(x: 4.5, y: 24.0)] {
+            outline.addLine(to: point)
+        }
+        outline.lineWidth = 2.5
+        outline.lineJoinStyle = .round
+        outline.lineCapStyle = .round
+        outline.close()
+        if filled {
+            UIColor.white.setFill()
+            outline.fill()
+            rendererContext.cgContext.setBlendMode(.clear)
+        } else {
+            outline.stroke()
+        }
+        UIColor.white.setFill()
+        UIBezierPath(roundedRect: CGRect(x: 9.0, y: 10.0, width: 3.0, height: 6.0), cornerRadius: 1.5).fill()
+        UIBezierPath(roundedRect: CGRect(x: 16.0, y: 10.0, width: 3.0, height: 6.0), cornerRadius: 1.5).fill()
+    }.withRenderingMode(.alwaysTemplate)
+}
+
+private let ayuGhostNavigationImage = ayuDrawGhostNavigationImage(filled: true)
