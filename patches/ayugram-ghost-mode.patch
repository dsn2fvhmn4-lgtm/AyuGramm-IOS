+private func ayuMessageHistoryController(context: AccountContext, messageId: EngineMessage.Id? = nil) -> ViewController {
+    var push: ((ViewController) -> Void)?
+    var present: ((ViewController) -> Void)?
+    let arguments = AyuSettingsArguments(open: { id in
+        guard id == 10 else { return }
+        let data = context.sharedContext.currentPresentationData.with { $0 }
+        let ru = data.strings.baseLanguageCode.hasPrefix("ru")
+        present?(textAlertController(context: context, title: "AyuGram", text: ru ? "Очистить весь локальный архив этого аккаунта?" : "Clear the entire local archive for this account?", actions: [
+            TextAlertAction(type: .genericAction, title: data.strings.Common_Cancel, action: {}),
+            TextAlertAction(type: .destructiveAction, title: data.strings.Common_OK, action: {
+                let _ = context.engine.messages.updateAyuMessageHistory(clear: true).startStandalone()
+            })
+        ]))
+    }, update: { id, value in
+        let _ = context.engine.messages.updateAyuMessageHistory(saveEdits: id == 0 ? value : nil, saveDeleted: id == 1 ? value : nil, saveFormatting: id == 2 ? value : nil, saveReactions: id == 3 ? value : nil, saveForBots: id == 4 ? value : nil, saveMedia: id == 5 ? value : nil, mediaPrivateChats: id == 6 ? value : nil, mediaPublicChannels: id == 7 ? value : nil, mediaPrivateChannels: id == 8 ? value : nil, mediaPublicGroups: id == 9 ? value : nil, mediaPrivateGroups: id == 10 ? value : nil).startStandalone()
+    }, record: { id in
+        push?(ayuHistoryRecordController(context: context, recordId: id))
+    })
+    let signal = combineLatest(context.sharedContext.presentationData, context.engine.messages.ayuMessageHistory())
+    |> deliverOnMainQueue
+    |> map { presentationData, history -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        var entries: [AyuSettingsEntry] = [
+            .toggle(0, ru ? "Сохранять текст до правки" : "Save text before edits", history.saveEdits),
+            .toggle(1, ru ? "Сохранять удалённый текст" : "Save deleted text", history.saveDeleted),
+            .toggle(2, ru ? "Сохранять форматирование" : "Save formatting", history.saveFormatting),
+            .toggle(3, ru ? "Сохранять реакции" : "Save reactions", history.saveReactions),
+            .toggle(4, ru ? "Сохранять сообщения ботов" : "Save bot messages", history.saveForBots),
+            .toggle(5, ru ? "Копировать загруженные медиа" : "Copy cached media", history.saveMedia),
+            .toggle(6, ru ? "Медиа личных чатов" : "Private-chat media", history.mediaPrivateChats),
+            .toggle(7, ru ? "Медиа публичных каналов" : "Public-channel media", history.mediaPublicChannels),
+            .toggle(8, ru ? "Медиа частных каналов" : "Private-channel media", history.mediaPrivateChannels),
+            .toggle(9, ru ? "Медиа публичных групп" : "Public-group media", history.mediaPublicGroups),
+            .toggle(10, ru ? "Медиа частных групп" : "Private-group media", history.mediaPrivateGroups),
+            .info(11, ru ? "Только уже загруженный текст обычных облачных сообщений. До 100 записей за 7 дней, до 8 КБ каждая. Копирование медиа включается отдельно: только уже загруженные фото и файлы до 25 МБ, до 250 МБ на аккаунт. Недоступные файлы не загружаются. Защищённые, секретные и исчезающие сообщения исключены; неизвестный срок хранения чата также исключает сохранение. Архив находится в базе этого аккаунта на устройстве." : "Only text already received in ordinary cloud messages. Up to 100 entries for 7 days, up to 8 KB each. Media copying is opt-in: cached photos/files only, up to 25 MB each and 250 MB per account. Unavailable files are not downloaded. Protected, secret and disappearing messages are excluded, including chats whose lifetime is unknown. The archive stays in this account's local database.")
+        ]
+        let records = history.records.filter { record in
+            guard let messageId else { return true }
+            return record.peerId == messageId.peerId.toInt64() && record.messageId == messageId.id
+        }
+        if records.isEmpty {
+            entries.append(.info(12, ru ? "Архив пока пуст. Записи появятся после новых правок или удалений при включённых переключателях." : "The archive is empty. Entries are collected from future edits or deletions while enabled."))
+        } else {
+            entries.append(.clear(ru ? "Очистить архив" : "Clear archive"))
