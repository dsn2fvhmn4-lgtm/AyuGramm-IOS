+    }
+}
diff --git a/submodules/TelegramUI/Sources/AyuStartupStorage.swift b/submodules/TelegramUI/Sources/AyuStartupStorage.swift
new file mode 100644
index 00000000..e7c72fa0
--- /dev/null
+++ b/submodules/TelegramUI/Sources/AyuStartupStorage.swift
@@ -0,0 +1,84 @@
+import Foundation
+import Security
+import LocalAuthentication
+
+enum AyuStartupStorageError: Error {
+    case invalidMarker
+    case keychain(OSStatus)
+}
+
+struct AyuStartupStorage {
+    let baseURL: URL
+    let privateKeychainScope: String?
+    var isStandalone: Bool { return self.privateKeychainScope != nil }
+
+    static func resolve(supportURL: URL, sharedURL: URL?, group: String, probe: (String?) -> OSStatus) throws -> AyuStartupStorage {
+        let files = FileManager.default
+        let local = supportURL.appendingPathComponent("AyuGramStandalone", isDirectory: true)
+        let marker = local.appendingPathComponent(".keychain-scope")
+        let hasMarker = files.fileExists(atPath: marker.path)
+        // Never invent new keys for an existing standalone database whose scope was lost.
+        if !hasMarker, files.fileExists(atPath: local.appendingPathComponent("telegram-data").path) {
+            throw AyuStartupStorageError.invalidMarker
+        }
+        if !hasMarker, let sharedURL {
+            let status = probe(group)
+            if status == errSecSuccess { return AyuStartupStorage(baseURL: sharedURL, privateKeychainScope: nil) }
+            // Locked/unavailable keychains are not entitlement failures. Do not reset or switch data.
+            guard status == errSecMissingEntitlement else { throw AyuStartupStorageError.keychain(status) }
+        }
+        let status = probe(nil)
+        guard status == errSecSuccess else { throw AyuStartupStorageError.keychain(status) }
+        let scope: String
+        if hasMarker {
+            let attributes = try files.attributesOfItem(atPath: marker.path)
+            guard let size = attributes[.size] as? NSNumber, size.intValue <= 64,
+                  let text = String(data: try Data(contentsOf: marker), encoding: .utf8), UUID(uuidString: text) != nil else {
+                throw AyuStartupStorageError.invalidMarker
+            }
+            scope = text
+        } else {
+            scope = UUID().uuidString
+            #if os(iOS)
+            try files.createDirectory(at: local, withIntermediateDirectories: true, attributes: [.protectionKey: FileProtectionType.completeUntilFirstUserAuthentication])
+            try Data(scope.utf8).write(to: marker, options: [.atomic, .completeFileProtectionUntilFirstUserAuthentication])
+            #else
+            try files.createDirectory(at: local, withIntermediateDirectories: true)
+            try Data(scope.utf8).write(to: marker, options: .atomic)
+            #endif
+            var values = URLResourceValues()
+            values.isExcludedFromBackup = true
+            var excluded = local
+            try excluded.setResourceValues(values)
+        }
+        return AyuStartupStorage(baseURL: local, privateKeychainScope: scope)
+    }
+
+    /// A disposable, nonsecret record tests access without touching account credentials.
+    static func probeKeychain(bundleIdentifier: String, group: String?) -> OSStatus {
+        var query: [String: Any] = [
+            kSecClass as String: kSecClassGenericPassword,
+            kSecAttrService as String: "org.ayugram.startup.probe." + bundleIdentifier,
+            kSecAttrAccount as String: UUID().uuidString,
+            kSecAttrSynchronizable as String: false
+        ]
+        if let group { query[kSecAttrAccessGroup as String] = group }
+        var insert = query
+        insert[kSecValueData as String] = Data([0x41, 0x59, 0x55])
+        insert[kSecAttrAccessible as String] = kSecAttrAccessibleWhenUnlockedThisDeviceOnly
+        let added = SecItemAdd(insert as CFDictionary, nil)
+        guard added == errSecSuccess else { return added }
+        let identity = query
+        defer { _ = SecItemDelete(identity as CFDictionary) }
+        let authentication = LAContext()
+        authentication.interactionNotAllowed = true
+        query[kSecUseAuthenticationContext as String] = authentication
+        query[kSecReturnData as String] = true
+        query[kSecMatchLimit as String] = kSecMatchLimitOne
+        var value: CFTypeRef?
+        let read = SecItemCopyMatching(query as CFDictionary, &value)
+        guard read == errSecSuccess else { return read }
+        guard let data = value as? Data, data == Data([0x41, 0x59, 0x55]) else { return errSecDecode }
+        return errSecSuccess
+    }
+}
