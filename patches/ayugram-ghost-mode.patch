@@ -0,0 +1,35 @@
+import Foundation
+import Postbox
+import SwiftSignalKit
+
+public extension EngineMessage {
+    var ayuHiddenReference: AyuHiddenMessageReference? {
+        guard self.id.namespace == Namespaces.Message.Cloud, self.adAttribute == nil,
+              !self.media.contains(where: { $0 is TelegramMediaAction }) else { return nil }
+        let kind: AyuHiddenMessageReference.Kind
+        switch self.id.peerId.namespace {
+        case Namespaces.Peer.CloudUser: kind = .user
+        case Namespaces.Peer.CloudGroup: kind = .group
+        case Namespaces.Peer.CloudChannel: kind = .channel
+        default: return nil
+        }
+        let peerId = self.id.peerId.id._internalGetInt64Value()
+        guard peerId > 0, self.id.id > 0 else { return nil }
+        return AyuHiddenMessageReference(kind: kind, peerId: peerId, messageId: self.id.id, groupingKey: self._asMessage().groupingKey)
+    }
+}
+
+public extension TelegramEngine.Messages {
+    func ayuLocalHideReferences(ids: [EngineMessage.Id]) -> Signal<[AyuHiddenMessageReference]?, NoError> {
+        return self.account.postbox.transaction { transaction -> [AyuHiddenMessageReference]? in
+            let ids = Set(ids)
+            guard !ids.isEmpty, ids.count <= 20, Set(ids.map { $0.peerId }).count == 1 else { return nil }
+            var references: [AyuHiddenMessageReference] = []
+            for id in ids.sorted() {
+                guard let message = transaction.getMessage(id), let reference = EngineMessage(message).ayuHiddenReference else { return nil }
+                references.append(reference)
+            }
+            return references
+        }
+    }
+}
