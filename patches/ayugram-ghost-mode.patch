+            if row.tokens.count == 16 {
+                guard row.tokens[13] == .mark(","), case let .integer(value) = row.tokens[14] else { throw self.fail(row.number) }
+                count = value
+            }
+            let prefix = predicate?.kind == .prefix && predicate?.negated == false ? predicate?.value : nil
+            // The complete statement, including an optional bounded count, must match.
+            actions.append(AyuPluginAction(id: "send_\(actions.count)", title: "Outgoing text replacement", kind: .outgoingReplace, find: find, replacement: replacement, prefix: prefix, condition: prefix == nil ? predicate : nil, replacementCount: count))
