+/// exteraGram "Other" (OtherPreferencesActivity): reset the client's display settings and
+/// delete the account. The Android Google analytics toggles have no counterpart in this build.
+private func ayuOtherSettingsController(context: AccountContext, navigation: NavigationController?) -> ViewController {
+    let store = context.account.network.ayuGhostMode
+    var present: ((ViewController) -> Void)?
+    let arguments = AyuSectionedArguments(open: { id in
+        let data = context.sharedContext.currentPresentationData.with { $0 }
+        let ru = data.strings.baseLanguageCode.hasPrefix("ru")
+        switch id {
+        case 1:
+            present?(textAlertController(context: context, title: ru ? "Сбросить настройки" : "Reset Settings", text: ru ? "Настройки интерфейса, оформления, MessageShot и реакций вернутся к стандартным. Ghost Mode, история, фильтры и плагины не меняются." : "Interface, appearance, MessageShot and reaction settings return to their defaults. Ghost Mode, history, filters and plugins are kept.", actions: [TextAlertAction(type: .genericAction, title: data.strings.Common_Cancel, action: {}), TextAlertAction(type: .destructiveAction, title: ru ? "Сбросить" : "Reset", action: {
+                do {
+                    try store.update {
+                        $0.interface = AyuInterfaceSettings()
+                        $0.appearance = AyuAppearanceSettings()
+                        $0.messageShot = AyuMessageShotSettings()
+                        $0.reactionDisplay = AyuReactionDisplaySettings()
+                    }
+                    present?(textAlertController(context: context, title: "AyuGram", text: ru ? "Настройки сброшены." : "Preferences have been reset.", actions: [TextAlertAction(type: .defaultAction, title: data.strings.Common_OK, action: {})]))
+                } catch {
+                    present?(textAlertController(context: context, title: "AyuGram", text: ru ? "Не удалось сбросить настройки." : "Settings could not be reset.", actions: [TextAlertAction(type: .defaultAction, title: data.strings.Common_OK, action: {})]))
+                }
+            })]))
+        case 2:
+            guard let navigation else {
+                return
+            }
+            // Telegram's own deletion flow, with its confirmations and two-step password check.
+            let _ = (context.engine.auth.twoStepVerificationConfiguration()
+            |> take(1)
+            |> deliverOnMainQueue).startStandalone(next: { configuration in
+                let access = TwoStepVerificationAccessConfiguration(configuration: configuration, password: nil)
+                var hasTwoStepAuth = false
+                if case .set = access {
+                    hasTwoStepAuth = true
+                }
+                navigation.pushViewController(deleteAccountOptionsController(context: context, navigationController: navigation, hasTwoStepAuth: hasTwoStepAuth, twoStepAuthData: access))
+            })
+        default:
+            break
+        }
+    }, toggle: { _, _ in })
+    let resetIcon = AyuSettingsIcons.symbol("arrow.counterclockwise", color: UIColor(rgb: 0x8E8E93))
+    let deleteIcon = AyuSettingsIcons.symbol("trash.fill", color: UIColor(rgb: 0xFF3B30))
+    let signal = context.sharedContext.presentationData
+    |> deliverOnMainQueue
+    |> map { presentationData -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        let entries: [AyuSectionedEntry] = [
+            .link(0, 1, resetIcon, ru ? "Сбросить настройки" : "Reset Settings", ""),
+            .link(0, 2, deleteIcon, ru ? "Удалить аккаунт" : "Delete Account", "")
+        ]
+        let data = ItemListPresentationData(presentationData)
+        let state = ItemListControllerState(presentationData: data, title: .text(ru ? "Другое" : "Other"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        return (state, (ItemListNodeState(presentationData: data, entries: entries, style: .blocks, animateChanges: false), arguments))
+    }
+    let controller = ItemListController(context: context, state: signal)
+    present = { [weak controller] in controller?.present($0, in: .window(.root)) }
+    return controller
+}
