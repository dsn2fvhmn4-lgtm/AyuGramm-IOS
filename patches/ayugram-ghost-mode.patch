+import UIKit
+import Display
+import TelegramCore
+
+extension AyuPluginManifest {
+    /// Version as the original plugin states it, without the port's adapter suffix.
+    var displayVersion: String {
+        if let range = self.version.range(of: "-ios.", options: .backwards) { return String(self.version[..<range.lowerBound]) }
+        return self.version
+    }
+    var displayAuthor: String {
+        return self.author.replacingOccurrences(of: " (original)", with: "")
+    }
+}
+
+final class AyuPluginDetailsController: UITableViewController {
+    private enum Row: Equatable {
+        case enable, cameraGesture, cameraHaptic, chatColors, mentionGroups, reactionTotals, formattedTimestamp
+        case game(AyuArcadeGame)
+        case arcadeCloseButton, arcadeConfirmExit, arcadeKeepScreenOn, arcadeReset
+        case export, remove
+    }
+
+    private let store: AyuGhostModeStore
+    private let pluginID: String
+    private let russian: Bool
+    private let palette: AyuPreferencesPalette?
+    private var preparing = false
+    private let settingsController: ((String) -> UIViewController?)?
+    private let keepAwake: (() -> (() -> Void))?
+    private var generation = 0
+    private var exportDirectory: URL?
+    init(store: AyuGhostModeStore, pluginID: String, russian: Bool, palette: AyuPreferencesPalette? = nil, settingsController: ((String) -> UIViewController?)? = nil, keepAwake: (() -> (() -> Void))? = nil) {
+        self.store = store; self.pluginID = pluginID; self.russian = russian; self.palette = palette; self.settingsController = settingsController; self.keepAwake = keepAwake
+        super.init(style: .grouped)
+        self.title = russian ? "Плагин" : "Plugin"
+    }
+    required init?(coder: NSCoder) { return nil }
+    deinit { if let directory = self.exportDirectory { try? FileManager.default.removeItem(at: directory) } }
+    private var plugin: AyuInstalledPlugin? { return self.store.current.plugins.installed.first { $0.manifest.id == self.pluginID } }
+    private func has(_ kind: AyuPluginAction.Kind) -> Bool { return self.plugin?.manifest.actions.contains(where: { $0.kind == kind }) == true }
+    private var cameraSettings: AyuCameraFlipSettings { return self.plugin?.cameraFlipSettings ?? AyuCameraFlipSettings() }
+    private var arcadeSettings: AyuArcadeSettings { return self.plugin?.arcadeSettings ?? AyuArcadeSettings() }
+    private var cameraModes: [String] { return self.russian ? ["Свайп вверх или вниз", "Свайп вверх", "Свайп вниз", "Двойной тап"] : ["Swipe up or down", "Swipe up", "Swipe down", "Double tap"] }
+
+    private var sections: [[Row]] {
+        var settings: [Row] = [.enable]
+        if self.has(.cameraFlip) { settings += [.cameraGesture, .cameraHaptic] }
+        if self.has(.chatColors) { settings.append(.chatColors) }
+        if self.has(.groupMentions) { settings.append(.mentionGroups) }
+        if self.has(.reactionsTotal) { settings.append(.reactionTotals) }
+        if self.has(.formattedCopy) { settings.append(.formattedTimestamp) }
+        if self.has(.arcadeGame) { settings += [.arcadeCloseButton, .arcadeConfirmExit, .arcadeKeepScreenOn] }
+        var result = [settings]
+        if self.has(.arcadeGame) {
+            result.append(AyuArcadeGame.allCases.filter { game in self.plugin?.manifest.actions.contains(where: { $0.id == game.rawValue }) == true }.map { Row.game($0) } + [Row.arcadeReset])
+        }
+        result.append([.export, .remove])
+        return result
+    }
+    private func row(_ indexPath: IndexPath) -> Row? {
+        let sections = self.sections
+        guard sections.indices.contains(indexPath.section), sections[indexPath.section].indices.contains(indexPath.row) else { return nil }
+        return sections[indexPath.section][indexPath.row]
+    }
+
+    private func updateCameraSettings(_ update: (inout AyuCameraFlipSettings) -> Void) {
+        guard !self.preparing else { return }
+        do {
+            try self.store.update { state in
+                var settings = state.plugins.installed.first(where: { $0.manifest.id == self.pluginID })?.cameraFlipSettings ?? AyuCameraFlipSettings()
+                update(&settings)
+                try state.plugins.setCameraFlipSettings(id: self.pluginID, settings: settings)
+            }
+        } catch { self.showError() }
+        self.tableView.reloadData()
+    }
+    private func updateArcadeSettings(_ update: (inout AyuArcadeSettings) -> Void) {
+        guard !self.preparing else { return }
+        do {
+            try self.store.update { state in
+                var settings = state.plugins.installed.first(where: { $0.manifest.id == self.pluginID })?.arcadeSettings ?? AyuArcadeSettings()
+                update(&settings)
+                try state.plugins.setArcadeSettings(id: self.pluginID, settings: settings)
+            }
+        } catch { self.showError() }
+        self.tableView.reloadData()
+    }
+    @objc private func cameraHapticChanged(_ toggle: UISwitch) { self.updateCameraSettings { $0.haptic = toggle.isOn } }
+    @objc private func arcadeToggleChanged(_ toggle: UISwitch) {
+        switch toggle.tag {
+        case 0: self.updateArcadeSettings { $0.showCloseButton = toggle.isOn }
+        case 1: self.updateArcadeSettings { $0.confirmExit = toggle.isOn }
+        default: self.updateArcadeSettings { $0.keepScreenOn = toggle.isOn }
+        }
+    }
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        self.navigationItem.rightBarButtonItem = UIBarButtonItem(barButtonSystemItem: .done, target: self, action: #selector(self.done))
+        self.tableView.rowHeight = UITableView.automaticDimension; self.tableView.estimatedRowHeight = 56
+        self.tableView.backgroundColor = self.palette?.background ?? .systemGroupedBackground
+        if let plugin = self.plugin {
+            self.tableView.tableHeaderView = AyuPreferencesHeaderView(image: ayuPluginAvatar(size: 88), title: plugin.manifest.name, subtitle: "\(plugin.manifest.displayVersion) · \(plugin.manifest.displayAuthor)", text: plugin.manifest.summary, palette: self.palette)
+        }
+    }
+    override func viewDidLayoutSubviews() { super.viewDidLayoutSubviews(); ayuFitPreferencesHeader(self.tableView) }
+    override func viewWillDisappear(_ animated: Bool) {
+        super.viewWillDisappear(animated)
+        if self.isMovingFromParent || self.isBeingDismissed || self.navigationController?.isBeingDismissed == true { self.generation += 1; self.preparing = false }
+    }
+    @objc private func done() { self.generation += 1; self.dismiss(animated: true) }
+    override func numberOfSections(in tableView: UITableView) -> Int { return self.sections.count }
+    override func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int { return self.sections.indices.contains(section) ? self.sections[section].count : 0 }
+    override func tableView(_ tableView: UITableView, titleForHeaderInSection section: Int) -> String? {
+        guard let first = self.sections.indices.contains(section) ? self.sections[section].first : nil else { return nil }
+        switch first {
+        case .enable: return self.russian ? "Настройки плагина" : "Plugin settings"
+        case .game: return self.russian ? "Игры" : "Games"
+        default: return nil
+        }
+    }
+    override func tableView(_ tableView: UITableView, titleForFooterInSection section: Int) -> String? {
+        guard self.has(.arcadeGame), self.sections.indices.contains(section), case .game = self.sections[section].first else { return nil }
+        return self.russian ? "Игры также запускаются командами .2048, .flappy и .dino в любом чате и из меню «Плагины» в чате." : "Games also start with the .2048, .flappy and .dino commands in any chat and from the chat Plugins menu."
+    }
+    private func switchCell(_ cell: UITableViewCell, title: String, value: Bool, tag: Int = 0, action: Selector) {
+        cell.textLabel?.text = title
+        cell.selectionStyle = .none
+        let toggle = UISwitch(); toggle.isOn = value; toggle.isEnabled = !self.preparing; toggle.tag = tag
+        toggle.accessibilityLabel = title
+        toggle.addTarget(self, action: action, for: .valueChanged)
+        cell.accessoryView = toggle
+    }
+    override func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
+        let cell = UITableViewCell(style: .subtitle, reuseIdentifier: nil)
+        cell.backgroundColor = self.palette?.panel ?? .secondarySystemGroupedBackground
+        cell.textLabel?.textColor = self.palette?.text ?? .label
+        cell.textLabel?.numberOfLines = 0
+        guard let row = self.row(indexPath) else { return cell }
+        switch row {
+        case .enable:
+            cell.selectionStyle = .none
+            cell.textLabel?.text = self.russian ? "Включить плагин" : "Enable plugin"
+            if self.preparing {
+                let progress = UIActivityIndicatorView(style: .medium); progress.startAnimating(); cell.accessoryView = progress
+            } else {
+                let toggle = UISwitch(); toggle.isOn = self.plugin?.enabled == true
