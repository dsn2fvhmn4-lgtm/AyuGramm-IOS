+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import ItemListUI
+import AccountContext
+
+private struct AyuGhostModeArguments {
+    let update: (Int32, Bool) -> Void
+}
+
+private enum AyuGhostModeEntry: ItemListNodeEntry {
+    case header(String)
+    case toggle(Int32, String, Bool)
+    case info(String)
+
+    var section: ItemListSectionId { return 0 }
+
+    var stableId: Int32 {
+        switch self {
+        case .header: return 0
+        case let .toggle(id, _, _): return id
+        case .info: return 6
+        }
+    }
+
+    static func < (lhs: AyuGhostModeEntry, rhs: AyuGhostModeEntry) -> Bool {
+        return lhs.stableId < rhs.stableId
+    }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! AyuGhostModeArguments
+        switch self {
+        case let .header(text):
+            return ItemListSectionHeaderItem(presentationData: presentationData, text: text, sectionId: self.section)
+        case let .toggle(id, title, value):
+            return ItemListSwitchItem(presentationData: presentationData, systemStyle: .glass, title: title, value: value, sectionId: self.section, style: .blocks, updated: { value in
+                arguments.update(id, value)
+            })
+        case let .info(text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        }
+    }
+}
+
+public func ayuGhostModeController(context: AccountContext) -> ViewController {
+    let store = context.account.network.ayuGhostMode
+    var presentError: (() -> Void)?
+    let arguments = AyuGhostModeArguments(update: { id, value in
+        do {
+            try store.update { settings in
+                switch id {
+                case 1: settings.setAllEnabled(value)
+                case 2: settings.hideReadReceipts = value
+                case 3: settings.hideOnline = value
+                case 4: settings.hideTyping = value
+                case 5: settings.hideUploadProgress = value
+                default: break
+                }
+            }
+        } catch {
+            presentError?()
+        }
+    })
+    let signal = combineLatest(context.sharedContext.presentationData, store.signal)
+    |> deliverOnMainQueue
+    |> map { presentationData, settings -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let isRussian = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        let titles = isRussian ? ["Все параметры", "Скрывать прочтение чатов", "Скрывать статус онлайн", "Скрывать набор и запись", "Скрывать прогресс загрузки"] : ["All options", "Hide chat read receipts", "Hide online status", "Hide typing and recording", "Hide upload progress"]
+        var info = isRussian
+            ? "Экспериментальный режим для этого аккаунта. Прочтение скрывается в обычных облачных чатах и обсуждениях. Просмотры историй, воспроизведение медиа и прочтение секретных чатов работают как обычно. Самоуничтожение сохраняется. Отправка сообщений и другие устройства могут раскрывать активность. Новое прочтение после отключения режима может отметить предыдущие сообщения прочитанными. Ghost Mode противоречит условиям Telegram API (п. 1.4)."
+            : "Experimental, per account. Hides ordinary cloud chat and discussion read receipts. Story views, media playback receipts and secret-chat reads retain their usual behavior. Content expiration is preserved. Sending messages and other devices may reveal activity. Reading after disabling this mode can acknowledge earlier messages. Ghost Mode conflicts with Telegram API Terms section 1.4."
+        if store.hadLoadError {
+            info += isRussian ? " Предыдущие настройки повреждены; использованы значения по умолчанию." : " Previous settings could not be decoded; defaults were loaded."
+        }
+        let entries: [AyuGhostModeEntry] = [
+            .header("AYUGRAM · GHOST MODE"),
+            .toggle(1, titles[0], settings.allEnabled),
+            .toggle(2, titles[1], settings.hideReadReceipts),
+            .toggle(3, titles[2], settings.hideOnline),
+            .toggle(4, titles[3], settings.hideTyping),
+            .toggle(5, titles[4], settings.hideUploadProgress),
+            .info(info)
+        ]
+        let data = ItemListPresentationData(presentationData)
+        let state = ItemListControllerState(presentationData: data, title: .text("AyuGram · Ghost Mode"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let list = ItemListNodeState(presentationData: data, entries: entries, style: .blocks, animateChanges: false)
+        return (state, (list, arguments))
+    }
+    let controller = ItemListController(context: context, state: signal)
+    presentError = { [weak controller] in
+        let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+        let isRussian = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        controller?.present(textAlertController(context: context, title: "AyuGram", text: isRussian ? "Ошибка сохранения настроек. Изменение не применено." : "Settings could not be saved. The change was not applied.", actions: [TextAlertAction(type: .defaultAction, title: presentationData.strings.Common_OK, action: {})]), in: .window(.root))
+    }
+    return controller
+}
