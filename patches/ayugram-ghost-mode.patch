@@ -0,0 +1,50 @@
+import Foundation
+
+public struct AyuAppearanceSettings: Codable, Equatable {
+    public var showGhostButton = true
+    public var showMessageSeconds = false
+    /// Empty strings use the current language's standard labels.
+    public var deletedMark = ""
+    public var editedMark = ""
+
+    public init() {}
+
+    private enum CodingKeys: String, CodingKey {
+        case showGhostButton, showMessageSeconds, deletedMark, editedMark
+    }
+
+    public init(from decoder: Decoder) throws {
+        let values = try decoder.container(keyedBy: CodingKeys.self)
+        self.showGhostButton = try values.decodeIfPresent(Bool.self, forKey: .showGhostButton) ?? true
+        self.showMessageSeconds = try values.decodeIfPresent(Bool.self, forKey: .showMessageSeconds) ?? false
+        self.deletedMark = try values.decodeIfPresent(String.self, forKey: .deletedMark) ?? ""
+        self.editedMark = try values.decodeIfPresent(String.self, forKey: .editedMark) ?? ""
+        self.normalize()
+        try self.validate()
+    }
+
+    public mutating func normalize() {
+        self.deletedMark = self.deletedMark.trimmingCharacters(in: .whitespacesAndNewlines)
+        self.editedMark = self.editedMark.trimmingCharacters(in: .whitespacesAndNewlines)
+    }
+
+    public func validate() throws {
+        for mark in [self.deletedMark, self.editedMark] {
+            let containsControl = mark.unicodeScalars.contains { scalar in
+                CharacterSet.controlCharacters.contains(scalar) || CharacterSet.newlines.contains(scalar)
+                    || (0x202A ... 0x202E).contains(scalar.value) || (0x2066 ... 0x2069).contains(scalar.value)
+            }
+            guard mark.count <= 24, mark.utf8.count <= 96, !containsControl else {
+                throw NSError(domain: "AyuAppearance", code: 1, userInfo: [NSLocalizedDescriptionKey: "Use a single-line label of at most 24 characters and 96 UTF-8 bytes, without control characters."])
+            }
+        }
+    }
+
+    public func deletedLabel(fallback value: String) -> String {
+        return self.deletedMark.isEmpty ? value : self.deletedMark
+    }
+
+    public func editedLabel(fallback value: String) -> String {
+        return self.editedMark.isEmpty ? value : self.editedMark
+    }
+}
diff --git a/submodules/TelegramCore/Sources/AyuGram/AyuArchiveFileStore.swift b/submodules/TelegramCore/Sources/AyuGram/AyuArchiveFileStore.swift
new file mode 100644
index 00000000..ba034fc4
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuGram/AyuArchiveFileStore.swift
@@ -0,0 +1,103 @@
+import Foundation
+
+public struct AyuArchivedAttachment: Codable, Equatable {
+    public let id: String
+    public let storedName: String
+    public let displayName: String
+    public let byteCount: Int64
+}
+
+/// Only stores explicit archive copies, not Telegram session or credential files.
+public final class AyuArchiveFileStore {
+    private static let registryLock = NSLock()
+    private static var registry: [String: AyuArchiveFileStore] = [:]
+    public static func shared(basePath: String) -> AyuArchiveFileStore {
+        self.registryLock.lock()
+        defer { self.registryLock.unlock() }
+        let path = URL(fileURLWithPath: basePath).deletingLastPathComponent().appendingPathComponent("ayu-history-media").standardizedFileURL.path
+        if let store = self.registry[path] { return store }
+        let store = AyuArchiveFileStore(root: URL(fileURLWithPath: path))
+        self.registry[path] = store
+        return store
+    }
+
+    private let lock = NSRecursiveLock()
+    private let root: URL
+    private let quota: Int64
+    private let perFileLimit: Int64
+    private var pending: [String: Date] = [:]
+
+    public init(root: URL, quota: Int64 = 250_000_000, perFileLimit: Int64 = 25_000_000) {
+        self.root = root.standardizedFileURL
+        self.quota = quota
+        self.perFileLimit = perFileLimit
+    }
+
+    private func files() -> [URL] {
+        return (try? FileManager.default.contentsOfDirectory(at: self.root, includingPropertiesForKeys: [.fileSizeKey], options: .skipsHiddenFiles)) ?? []
+    }
+
+    private func bytes(_ url: URL) -> Int64 {
+        return ((try? FileManager.default.attributesOfItem(atPath: url.path)[.size]) as? NSNumber)?.int64Value ?? 0
+    }
+
+    public func copy(source: URL, displayName: String) throws -> AyuArchivedAttachment {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        let source = source.resolvingSymlinksInPath()
+        let size = self.bytes(source)
+        guard size > 0 && size <= self.perFileLimit else { throw self.error("File is missing or exceeds the per-file archive limit.") }
+        let used = self.files().reduce(Int64(0)) { $0 + self.bytes($1) }
+        guard used + size <= self.quota else { throw self.error("Local media archive quota reached.") }
+        try FileManager.default.createDirectory(at: self.root, withIntermediateDirectories: true)
+        var root = self.root
+        var resourceValues = URLResourceValues()
+        resourceValues.isExcludedFromBackup = true
+        try root.setResourceValues(resourceValues)
+        let id = UUID().uuidString
+        let ext = (displayName as NSString).pathExtension
+        let suffix = !ext.isEmpty && ext.count <= 10 && ext.unicodeScalars.allSatisfy({ CharacterSet.alphanumerics.contains($0) }) ? "." + ext : ""
+        let name = id + suffix
+        let data = try Data(contentsOf: source, options: .mappedIfSafe)
+        guard data.count > 0 && Int64(data.count) <= self.perFileLimit && used + Int64(data.count) <= self.quota else { throw self.error("File size changed while archiving.") }
+        self.pending[name] = Date()
+        do {
+            #if os(iOS)
+            try data.write(to: self.root.appendingPathComponent(name), options: [.atomic, .completeFileProtectionUntilFirstUserAuthentication])
+            #else
+            try data.write(to: self.root.appendingPathComponent(name), options: .atomic)
+            #endif
+        } catch {
+            self.pending.removeValue(forKey: name)
+            throw error
+        }
+        return AyuArchivedAttachment(id: id, storedName: name, displayName: String(displayName.prefix(200)), byteCount: Int64(data.count))
+    }
+
+    public func url(for attachment: AyuArchivedAttachment) -> URL? {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        let name = attachment.storedName
+        guard !name.isEmpty, name != ".", name != "..", !name.contains("/"), !name.contains("\\") else { return nil }
+        let url = self.root.appendingPathComponent(name).standardizedFileURL
+        guard url.deletingLastPathComponent().path == self.root.path, FileManager.default.fileExists(atPath: url.path) else { return nil }
+        return url
+    }
+
+    /// Preference views are emitted after commit. Pending copies protect files from an
+    /// older queued view; abandoned transaction copies are eligible for later cleanup.
+    public func prune(validNames: Set<String>, now: Date = Date()) {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        for name in Array(self.pending.keys) {
+            if validNames.contains(name) || now.timeIntervalSince(self.pending[name]!) > 300 { self.pending.removeValue(forKey: name) }
+        }
+        for file in self.files() where !validNames.contains(file.lastPathComponent) && self.pending[file.lastPathComponent] == nil {
+            try? FileManager.default.removeItem(at: file)
+        }
+    }
+
+    private func error(_ description: String) -> NSError {
+        return NSError(domain: "AyuMediaArchive", code: 1, userInfo: [NSLocalizedDescriptionKey: description])
+    }
+}
