+            guard action.kind != .chatColors || self.apiVersion >= 4 else { throw AyuPluginError.invalidManifest }
+            guard action.kind != .cameraFlip || self.apiVersion >= 3 else { throw AyuPluginError.invalidManifest }
+            guard self.apiVersion >= 2 || (action.condition == nil && action.replacementCount == nil) else { throw AyuPluginError.invalidManifest }
