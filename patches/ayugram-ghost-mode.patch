+    @objc private func addGroup() { self.edit(nil) }
+    override func tableView(_ tableView: UITableView, didSelectRowAt indexPath: IndexPath) {
+        tableView.deselectRow(at: indexPath, animated: true)
+        guard indexPath.section == 1, self.settings.groups.indices.contains(indexPath.row) else { return }
+        self.edit(self.settings.groups[indexPath.row])
+    }
+    private func edit(_ group: AyuMentionGroup?) {
+        let alert = UIAlertController(title: self.russian ? "Группа упоминаний" : "Mention group", message: nil, preferredStyle: .alert)
+        alert.addTextField { field in field.placeholder = self.russian ? "Команда" : "Command"; field.text = group?.command; field.autocorrectionType = .no; field.autocapitalizationType = .none }
+        alert.addTextField { field in field.placeholder = "@alice @bob"; field.text = group?.usernames.joined(separator: " "); field.autocorrectionType = .no; field.autocapitalizationType = .none }
+        alert.addAction(UIAlertAction(title: self.russian ? "Сохранить" : "Save", style: .default, handler: { [weak self, weak alert] _ in
+            guard let self, let fields = alert?.textFields else { return }
+            let command = (fields[0].text ?? "").trimmingCharacters(in: .whitespacesAndNewlines)
+            let users = AyuGroupMentionSettings.usernames(fields[1].text ?? "")
+            self.save { settings in
+                let value = AyuMentionGroup(id: group?.id ?? UUID().uuidString, command: command, usernames: users)
