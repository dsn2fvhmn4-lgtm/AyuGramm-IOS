+import Foundation
+
+public struct AyuMediaSendSettings: Codable, Equatable {
+    public enum Kind: Equatable { case sticker, gif }
+    public var confirmStickers = false
+    public var confirmGifs = false
+    public var previewVoice = false
+    public var previewRound = false
+
+    public init() {}
+
+    private enum CodingKeys: String, CodingKey {
+        case confirmStickers, confirmGifs, previewVoice, previewRound
+    }
+
+    public init(from decoder: Decoder) throws {
+        let values = try decoder.container(keyedBy: CodingKeys.self)
+        self.confirmStickers = try values.decodeIfPresent(Bool.self, forKey: .confirmStickers) ?? false
+        self.confirmGifs = try values.decodeIfPresent(Bool.self, forKey: .confirmGifs) ?? false
+        self.previewVoice = try values.decodeIfPresent(Bool.self, forKey: .previewVoice) ?? false
+        self.previewRound = try values.decodeIfPresent(Bool.self, forKey: .previewRound) ?? false
+    }
+
+    public func needsConfirmation(for kind: Kind) -> Bool {
+        switch kind {
+        case .sticker: return self.confirmStickers
+        case .gif: return self.confirmGifs
+        }
+    }
+
+    public func requiresRecordingPreview(isVideo: Bool, viewOnce: Bool) -> Bool {
+        // A normal draft does not carry the view-once intent. Keep that explicit
+        // native send path intact instead of converting it to an ordinary draft.
+        return !viewOnce && (isVideo ? self.previewRound : self.previewVoice)
+    }
+}
+
+/// One dialog can authorize at most one send. Cancel invalidates later callbacks.
+public final class AyuMediaSendDecision {
+    private let lock = NSLock()
+    private var resolved = false
+    public init() {}
+
+    public func resolve(approved: Bool) -> Bool {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        guard !self.resolved else { return false }
+        self.resolved = true
+        return approved
+    }
+}
diff --git a/submodules/TelegramCore/Sources/AyuGram/AyuMessageHistory.swift b/submodules/TelegramCore/Sources/AyuGram/AyuMessageHistory.swift
new file mode 100644
index 00000000..3fe3c82a
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuGram/AyuMessageHistory.swift
@@ -0,0 +1,240 @@
+import Foundation
+import Postbox
+import SwiftSignalKit
+
+private let ayuHistoryKey = applicationSpecificPreferencesKey(19901)
+
+public extension EngineMessage {
+    var ayuIsDeleted: Bool {
+        return self.attributes.contains(where: { $0 is AyuDeletedMessageAttribute })
+    }
+}
+
+public extension AyuMessageHistoryRecord {
+    var formattingEntities: [MessageTextEntity] {
+        guard let formatting else { return [] }
+        return (try? JSONDecoder().decode([MessageTextEntity].self, from: formatting)) ?? []
+    }
+
+    var reactionSummary: String {
+        guard let reactions, let values = try? JSONDecoder().decode([MessageReaction].self, from: reactions) else { return "" }
+        return values.map { reaction in
+            let label: String
+            switch reaction.value {
+            case let .builtin(value): label = value
+            case let .custom(id): label = "emoji:\(id)"
+            case .stars: label = "⭐"
+            }
+            return "\(label) × \(reaction.count)"
+        }.joined(separator: "  ")
+    }
+}
+
+private func ayuHistoryEntities(_ attributes: [MessageAttribute]) -> [MessageTextEntity] {
+    return (attributes.first(where: { $0 is TextEntitiesMessageAttribute }) as? TextEntitiesMessageAttribute)?.entities ?? []
+}
+
+private func ayuHistorySupportedMedia(_ media: [Media]) -> Bool {
+    return media.allSatisfy { $0 is TelegramMediaWebpage || $0 is TelegramMediaImage || $0 is TelegramMediaFile }
+}
+
+private func ayuCaptureAttachments(transaction: Transaction, mediaBox: MediaBox, message: Message, state: AyuMessageHistoryState) -> [AyuArchivedAttachment] {
+    guard state.saveMedia, mediaBox.isMainProcess, let peer = transaction.getPeer(message.id.peerId) else { return [] }
+    let enabled: Bool
+    if peer is TelegramUser { enabled = state.mediaPrivateChats }
+    else if let channel = peer as? TelegramChannel {
+        let isPublic = channel.addressName != nil
+        switch channel.info {
+        case .broadcast: enabled = isPublic ? state.mediaPublicChannels : state.mediaPrivateChannels
+        case .group: enabled = isPublic ? state.mediaPublicGroups : state.mediaPrivateGroups
+        }
+    } else { enabled = state.mediaPrivateGroups }
+    guard enabled else { return [] }
+    var resources: [(MediaResource, String)] = []
+    for media in message.media {
+        if let file = media as? TelegramMediaFile {
+            resources.append((file.resource, file.fileName ?? "attachment"))
+        } else if let image = media as? TelegramMediaImage, let representation = largestImageRepresentation(image.representations) {
+            resources.append((representation.resource, "photo.jpg"))
+        }
+    }
+    let store = AyuArchiveFileStore.shared(basePath: mediaBox.basePath)
+    var attachments: [AyuArchivedAttachment] = []
+    for (resource, name) in resources.prefix(4) {
+        guard let path = mediaBox.completedResourcePath(resource) else { continue }
+        do { attachments.append(try store.copy(source: URL(fileURLWithPath: path), displayName: name)) }
+        catch { Logger.shared.log("AyuGram", "Cached media copy skipped (file unavailable, archive quota or I/O error)") }
+    }
+    return attachments
+}
+
+func ayuManageArchiveFiles(postbox: Postbox) -> Signal<Void, NoError> {
+    guard postbox.mediaBox.isMainProcess else { return .complete() }
+    let store = AyuArchiveFileStore.shared(basePath: postbox.mediaBox.basePath)
+    return postbox.preferencesView(keys: [ayuHistoryKey])
+    |> map { view -> Set<String> in
+        let state = view.values[ayuHistoryKey]?.get(AyuMessageHistoryState.self) ?? AyuMessageHistoryState()
+        return Set(state.records.flatMap { $0.attachments ?? [] }.map { $0.storedName })
+    }
+    |> distinctUntilChanged
+    |> deliverOn(Queue(name: "AyuGram-ArchiveFiles"))
+    |> map { names -> Void in store.prune(validNames: names) }
+}
+
+private func ayuHistoryPeerAllowsArchiving(transaction: Transaction, peerId: PeerId) -> Bool {
+    guard [Namespaces.Peer.CloudUser, Namespaces.Peer.CloudGroup, Namespaces.Peer.CloudChannel].contains(peerId.namespace),
+          let peer = transaction.getPeer(peerId), !peer.isCopyProtectionEnabled else { return false }
+    let timeout: CachedPeerAutoremoveTimeout
+    switch transaction.getPeerCachedData(peerId: peerId) {
+    case let data as CachedUserData:
+        guard !data.flags.contains(.copyProtectionEnabled), !data.flags.contains(.myCopyProtectionEnabled) else { return false }
+        timeout = data.autoremoveTimeout
+    case let data as CachedGroupData: timeout = data.autoremoveTimeout
+    case let data as CachedChannelData: timeout = data.autoremoveTimeout
+    default: return false
+    }
+    // Unknown chat lifetime is not evidence that content is permanent.
+    if case .known(nil) = timeout { return true }
+    if case let .known(value?) = timeout { return value.effectiveValue == 0 }
+    return false
+}
+
+private func ayuHistoryHasExpiringAttribute(_ attributes: [MessageAttribute]) -> Bool {
+    return attributes.contains { $0 is AutoremoveTimeoutMessageAttribute || $0 is AutoclearTimeoutMessageAttribute || $0 is EphemeralMessageAttribute || $0 is EphemeralReplacementMessageAttribute || $0 is EphemeralOutgoingMessageAttribute }
+}
+
+private func ayuRemoveExpiredTombstones(transaction: Transaction, previous: AyuMessageHistoryState, updated: AyuMessageHistoryState) {
+    let kept = Set(updated.records.filter { $0.kind == .deleted }.map {
+        MessageId(peerId: PeerId($0.peerId), namespace: Namespaces.Message.Cloud, id: $0.messageId)
+    })
+    let removed = Set(previous.records.filter { $0.kind == .deleted }.map {
+        MessageId(peerId: PeerId($0.peerId), namespace: Namespaces.Message.Cloud, id: $0.messageId)
+    }).subtracting(kept)
+    let ids = removed.filter { id in
+        transaction.getMessage(id)?.attributes.contains(where: { $0 is AyuDeletedMessageAttribute }) == true
+    }
+    if !ids.isEmpty { transaction.deleteMessages(Array(ids), forEachMedia: nil) }
+}
+
+@discardableResult
+func ayuPruneHistory(transaction: Transaction) -> AyuMessageHistoryState {
+    let original = transaction.getPreferencesEntry(key: ayuHistoryKey)?.get(AyuMessageHistoryState.self) ?? AyuMessageHistoryState()
+    var state = original
+    state.prune(now: Int64(Date().timeIntervalSince1970))
+    for peerId in Set(state.records.map { $0.peerId }) where !ayuHistoryPeerAllowsArchiving(transaction: transaction, peerId: PeerId(peerId)) {
+        state.remove(peerId: peerId)
+    }
+    if state != original {
+        ayuRemoveExpiredTombstones(transaction: transaction, previous: original, updated: state)
+        transaction.updatePreferencesEntry(key: ayuHistoryKey, { _ in PreferencesEntry(state) })
+    }
+    return state
+}
+
+/// Called only for server edit/delete replay, before the original message is replaced/removed.
+/// The ledger write participates in the same Postbox transaction and never blocks deletion.
+func ayuArchiveMessage(transaction: Transaction, mediaBox: MediaBox, message: Message, kind: AyuMessageHistoryRecord.Kind, updated: StoreMessage? = nil) {
+    let original = transaction.getPreferencesEntry(key: ayuHistoryKey)?.get(AyuMessageHistoryState.self) ?? AyuMessageHistoryState()
+    var state = original
+    let now = Int64(Date().timeIntervalSince1970)
+    state.prune(now: now)
+    let peerAllows = ayuHistoryPeerAllowsArchiving(transaction: transaction, peerId: message.id.peerId)
+    let updateAllows = updated.map { !$0.flags.contains(.CopyProtected) && !ayuHistoryHasExpiringAttribute($0.attributes) && ayuHistorySupportedMedia($0.media) } ?? true
+    let entities = ayuHistoryEntities(message.attributes)
+    let contentChanged = updated.map { $0.text != message.text || !areMediaArraysEqual($0.media, message.media) || (state.saveFormatting && ayuHistoryEntities($0.attributes) != entities) } ?? true
+    let isBot = (transaction.getPeer(message.id.peerId) as? TelegramUser)?.botInfo != nil || (message.author as? TelegramUser)?.botInfo != nil
+    let shouldCapture = kind == .edited ? state.saveEdits : state.saveDeleted
+    if !peerAllows {
+        state.remove(peerId: message.id.peerId.toInt64())
+    } else if message.id.namespace != Namespaces.Message.Cloud || message.isCopyProtected() || ayuHistoryHasExpiringAttribute(message.attributes) || !updateAllows {
+        state.remove(peerId: message.id.peerId.toInt64(), messageId: message.id.id)
+    } else if shouldCapture, state.saveForBots || !isBot, ayuHistorySupportedMedia(message.media), contentChanged, message.text.utf8.count <= AyuMessageHistoryState.maximumTextLength {
+        let encoder = JSONEncoder()
+        encoder.outputFormatting = .sortedKeys
+        let formatting = state.saveFormatting ? (try? encoder.encode(entities)) : nil
+        let reactions = state.saveReactions ? (try? encoder.encode(message.reactionsAttribute?.reactions ?? [])) : nil
+        let attachments = ayuCaptureAttachments(transaction: transaction, mediaBox: mediaBox, message: message, state: state)
+        state.append(peerId: message.id.peerId.toInt64(), messageId: message.id.id, messageTimestamp: message.timestamp, kind: kind, text: message.text, now: now, formatting: formatting, reactions: reactions, attachments: attachments)
+    }
+    if state != original {
+        ayuRemoveExpiredTombstones(transaction: transaction, previous: original, updated: state)
+        transaction.updatePreferencesEntry(key: ayuHistoryKey, { _ in PreferencesEntry(state) })
+    }
+}
+
+/// Retain a bounded, local text tombstone only after the archive accepted this deletion.
+/// Secret/expiring/protected messages still follow the ordinary deletion path above.
+func ayuRetainDeletedMessage(transaction: Transaction, mediaBox: MediaBox, message: Message) -> Bool {
+    let alreadyDeleted = message.attributes.contains(where: { $0 is AyuDeletedMessageAttribute })
+    if alreadyDeleted {
+        ayuPruneHistory(transaction: transaction)
+    } else {
+        ayuArchiveMessage(transaction: transaction, mediaBox: mediaBox, message: message, kind: .deleted)
+    }
+    let state = transaction.getPreferencesEntry(key: ayuHistoryKey)?.get(AyuMessageHistoryState.self) ?? AyuMessageHistoryState()
+    guard !message.text.isEmpty,
+          state.records.contains(where: { $0.kind == .deleted && $0.peerId == message.id.peerId.toInt64() && $0.messageId == message.id.id && $0.text == message.text }) else { return false }
+    if alreadyDeleted { return true }
+    transaction.updateMessage(message.id, update: { previous in
+        var forwardInfo: StoreMessageForwardInfo?
+        if let current = previous.forwardInfo {
+            forwardInfo = StoreMessageForwardInfo(authorId: current.author?.id, sourceId: current.source?.id, sourceMessageId: current.sourceMessageId, date: current.date, authorSignature: current.authorSignature, psaType: current.psaType, flags: current.flags)
+        }
+        var attributes = previous.attributes.filter {
+            !($0 is AyuDeletedMessageAttribute) && !($0 is ReplyMarkupMessageAttribute) && !($0 is ReactionsMessageAttribute)
+        }
+        if state.saveReactions, let reactions = previous.reactionsAttribute { attributes.append(reactions) }
+        attributes.append(AyuDeletedMessageAttribute(timestamp: Int64(Date().timeIntervalSince1970)))
+        var flags = StoreMessageFlags(previous.flags)
+        flags.remove(.TopIndexable)
+        flags.remove(.CountedAsIncoming)
+        flags.remove(.ReactionsArePossible)
+        // Media copies remain in the bounded archive. The inline tombstone is text-only,
+        // so deleting an album never pins an unbounded set of original media resources.
+        return .update(StoreMessage(id: previous.id, customStableId: nil, globallyUniqueId: previous.globallyUniqueId, groupingKey: nil, threadId: previous.threadId, timestamp: previous.timestamp, flags: flags, tags: [], globalTags: [], localTags: [], forwardInfo: forwardInfo, authorId: previous.author?.id, text: previous.text, attributes: attributes, media: []))
+    })
+    return true
+}
+
+public extension TelegramEngine.Messages {
+    func ayuArchivedAttachmentUrl(id: String) -> Signal<URL?, NoError> {
+        return self.account.postbox.transaction { transaction -> URL? in
+            let state = ayuPruneHistory(transaction: transaction)
+            guard let attachment = state.records.flatMap({ $0.attachments ?? [] }).first(where: { $0.id == id }) else { return nil }
+            return AyuArchiveFileStore.shared(basePath: self.account.postbox.mediaBox.basePath).url(for: attachment)
+        }
+    }
+    func ayuMessageHistory() -> Signal<AyuMessageHistoryState, NoError> {
+        return self.account.postbox.preferencesView(keys: [ayuHistoryKey])
+        |> mapToSignal { _ in
+            return self.account.postbox.transaction { transaction -> AyuMessageHistoryState in
+                return ayuPruneHistory(transaction: transaction)
+            }
+        }
+        |> distinctUntilChanged
+    }
+
+    func updateAyuMessageHistory(saveEdits: Bool? = nil, saveDeleted: Bool? = nil, saveFormatting: Bool? = nil, saveReactions: Bool? = nil, saveForBots: Bool? = nil, saveMedia: Bool? = nil, mediaPrivateChats: Bool? = nil, mediaPublicChannels: Bool? = nil, mediaPrivateChannels: Bool? = nil, mediaPublicGroups: Bool? = nil, mediaPrivateGroups: Bool? = nil, clear: Bool = false) -> Signal<Void, NoError> {
+        return self.account.postbox.transaction { transaction -> Void in
+            transaction.updatePreferencesEntry(key: ayuHistoryKey, { entry in
+                var state = entry?.get(AyuMessageHistoryState.self) ?? AyuMessageHistoryState()
+                let previous = state
+                if let saveEdits { state.saveEdits = saveEdits }
+                if let saveDeleted { state.saveDeleted = saveDeleted }
+                if let saveFormatting { state.saveFormatting = saveFormatting }
+                if let saveReactions { state.saveReactions = saveReactions }
+                if let saveForBots { state.saveForBots = saveForBots }
+                if let saveMedia { state.saveMedia = saveMedia }
+                if let mediaPrivateChats { state.mediaPrivateChats = mediaPrivateChats }
+                if let mediaPublicChannels { state.mediaPublicChannels = mediaPublicChannels }
+                if let mediaPrivateChannels { state.mediaPrivateChannels = mediaPrivateChannels }
+                if let mediaPublicGroups { state.mediaPublicGroups = mediaPublicGroups }
+                if let mediaPrivateGroups { state.mediaPrivateGroups = mediaPrivateGroups }
+                if clear { state.clear() }
+                state.prune(now: Int64(Date().timeIntervalSince1970))
+                ayuRemoveExpiredTombstones(transaction: transaction, previous: previous, updated: state)
+                return PreferencesEntry(state)
+            })
+        }
+    }
+}
diff --git a/submodules/TelegramCore/Sources/AyuGram/AyuMessageHistoryState.swift b/submodules/TelegramCore/Sources/AyuGram/AyuMessageHistoryState.swift
new file mode 100644
index 00000000..46e371d9
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuGram/AyuMessageHistoryState.swift
@@ -0,0 +1,151 @@
+import Foundation
+
+public struct AyuMessageHistoryRecord: Codable, Equatable {
+    public enum Kind: String, Codable { case edited, deleted }
+    public let id: Int32
+    public let peerId: Int64
+    public let messageId: Int32
+    public let messageTimestamp: Int32
+    public let capturedAt: Int64
+    public let kind: Kind
+    public let text: String
+    public let formatting: Data?
+    public let reactions: Data?
+    public let attachments: [AyuArchivedAttachment]?
+
+    private enum CodingKeys: String, CodingKey {
+        case id, peerId, messageId, messageTimestamp, capturedAt, kind, text, formatting, reactions, attachments
+    }
+
+    public init(id: Int32, peerId: Int64, messageId: Int32, messageTimestamp: Int32, capturedAt: Int64, kind: Kind, text: String, formatting: Data?, reactions: Data?, attachments: [AyuArchivedAttachment]?) {
+        self.id = id
+        self.peerId = peerId
+        self.messageId = messageId
+        self.messageTimestamp = messageTimestamp
+        self.capturedAt = capturedAt
+        self.kind = kind
+        self.text = text
+        self.formatting = formatting
+        self.reactions = reactions
+        self.attachments = attachments
+    }
+
+    public init(from decoder: Decoder) throws {
+        let values = try decoder.container(keyedBy: CodingKeys.self)
+        self.id = try values.decode(Int32.self, forKey: .id)
+        self.peerId = try values.decode(Int64.self, forKey: .peerId)
+        self.messageId = try values.decode(Int32.self, forKey: .messageId)
+        self.messageTimestamp = try values.decode(Int32.self, forKey: .messageTimestamp)
+        self.capturedAt = try values.decode(Int64.self, forKey: .capturedAt)
+        let rawKind = try values.decode(String.self, forKey: .kind)
+        guard let kind = Kind(rawValue: rawKind) else {
+            throw DecodingError.dataCorruptedError(forKey: .kind, in: values, debugDescription: "Unknown AyuGram history event")
+        }
+        self.kind = kind
+        self.text = try values.decode(String.self, forKey: .text)
+        self.formatting = try values.decodeIfPresent(Data.self, forKey: .formatting)
+        self.reactions = try values.decodeIfPresent(Data.self, forKey: .reactions)
+        self.attachments = try values.decodeIfPresent([AyuArchivedAttachment].self, forKey: .attachments)
+    }
+
+    public func encode(to encoder: Encoder) throws {
+        var values = encoder.container(keyedBy: CodingKeys.self)
+        try values.encode(self.id, forKey: .id)
+        try values.encode(self.peerId, forKey: .peerId)
+        try values.encode(self.messageId, forKey: .messageId)
+        try values.encode(self.messageTimestamp, forKey: .messageTimestamp)
+        try values.encode(self.capturedAt, forKey: .capturedAt)
+        // Postbox deliberately traps in singleValueContainer(). Raw-value enums use it
+        // by default, so persist the primitive through the keyed String overload.
+        try values.encode(self.kind.rawValue, forKey: .kind)
+        try values.encode(self.text, forKey: .text)
+        try values.encodeIfPresent(self.formatting, forKey: .formatting)
+        try values.encodeIfPresent(self.reactions, forKey: .reactions)
+        try values.encodeIfPresent(self.attachments, forKey: .attachments)
+    }
+}
+
+/// A bounded text-only ledger. It is stored inside the account's Postbox transaction.
+public struct AyuMessageHistoryState: Codable, Equatable {
+    public var saveEdits = false
+    public var saveDeleted = false
+    public var saveFormatting = true
+    public var saveReactions = true
+    public var saveForBots = true
+    public var saveMedia = false
+    public var mediaPrivateChats = true
+    public var mediaPublicChannels = false
+    public var mediaPrivateChannels = true
+    public var mediaPublicGroups = false
+    public var mediaPrivateGroups = true
+    public private(set) var records: [AyuMessageHistoryRecord] = []
+    private var nextId: Int32 = 1
+    public static let maximumRecords = 100
+    public static let retentionSeconds: Int64 = 7 * 24 * 60 * 60
+    public static let maximumTextLength = 8192
+
+    public init() {}
+
+    private enum CodingKeys: String, CodingKey {
+        case saveEdits, saveDeleted, saveFormatting, saveReactions, saveForBots, records, nextId
+        case saveMedia, mediaPrivateChats, mediaPublicChannels, mediaPrivateChannels, mediaPublicGroups, mediaPrivateGroups
+    }
+
+    public init(from decoder: Decoder) throws {
+        let values = try decoder.container(keyedBy: CodingKeys.self)
+        self.saveEdits = try values.decodeIfPresent(Bool.self, forKey: .saveEdits) ?? false
+        self.saveDeleted = try values.decodeIfPresent(Bool.self, forKey: .saveDeleted) ?? false
+        self.saveFormatting = try values.decodeIfPresent(Bool.self, forKey: .saveFormatting) ?? true
+        self.saveReactions = try values.decodeIfPresent(Bool.self, forKey: .saveReactions) ?? true
+        self.saveForBots = try values.decodeIfPresent(Bool.self, forKey: .saveForBots) ?? true
+        self.saveMedia = try values.decodeIfPresent(Bool.self, forKey: .saveMedia) ?? false
+        self.mediaPrivateChats = try values.decodeIfPresent(Bool.self, forKey: .mediaPrivateChats) ?? true
+        self.mediaPublicChannels = try values.decodeIfPresent(Bool.self, forKey: .mediaPublicChannels) ?? false
+        self.mediaPrivateChannels = try values.decodeIfPresent(Bool.self, forKey: .mediaPrivateChannels) ?? true
+        self.mediaPublicGroups = try values.decodeIfPresent(Bool.self, forKey: .mediaPublicGroups) ?? false
+        self.mediaPrivateGroups = try values.decodeIfPresent(Bool.self, forKey: .mediaPrivateGroups) ?? true
+        self.records = try values.decodeIfPresent([AyuMessageHistoryRecord].self, forKey: .records) ?? []
+        self.nextId = try values.decodeIfPresent(Int32.self, forKey: .nextId) ?? 1
+        if self.nextId <= 0 || self.records.contains(where: { $0.id >= self.nextId }) {
+            let maximum = self.records.map { $0.id }.max() ?? 0
+            if maximum == Int32.max { self.records.removeAll(); self.nextId = 1 }
+            else { self.nextId = maximum + 1 }
+        }
+    }
+
+    public mutating func clear() { self.records.removeAll() }
+
+    public mutating func remove(peerId: Int64, messageId: Int32? = nil) {
+        self.records.removeAll { record in
+            record.peerId == peerId && (messageId == nil || record.messageId == messageId)
+        }
+    }
+
+    public mutating func prune(now: Int64) {
+        self.records.removeAll { $0.capturedAt <= now - Self.retentionSeconds || $0.capturedAt > now + 300 }
+        if self.records.count > Self.maximumRecords {
+            self.records.removeFirst(self.records.count - Self.maximumRecords)
+        }
+    }
+
+    public mutating func append(peerId: Int64, messageId: Int32, messageTimestamp: Int32, kind: AyuMessageHistoryRecord.Kind, text: String, now: Int64, formatting: Data? = nil, reactions: Data? = nil, attachments: [AyuArchivedAttachment] = []) {
+        self.prune(now: now)
+        let keptAttachments = self.saveMedia ? Array(attachments.prefix(4)) : []
+        guard (kind == .edited ? self.saveEdits : self.saveDeleted), !text.isEmpty || !keptAttachments.isEmpty else { return }
+        // Reject oversized content rather than silently truncating an archived version.
+        guard text.utf8.count <= Self.maximumTextLength else { return }
+        let formatting = self.saveFormatting && (formatting?.count ?? 0) <= 16_384 ? formatting : nil
+        let reactions = self.saveReactions && (reactions?.count ?? 0) <= 16_384 ? reactions : nil
+        let attachments: [AyuArchivedAttachment]? = keptAttachments.isEmpty ? nil : keptAttachments
+        if let last = self.records.last(where: { $0.peerId == peerId && $0.messageId == messageId && $0.kind == kind }), last.text == text && last.formatting == formatting && last.reactions == reactions && last.attachments == attachments {
+            return
+        }
+        if self.nextId == Int32.max {
+            self.records.removeAll()
+            self.nextId = 1
+        }
+        self.records.append(AyuMessageHistoryRecord(id: self.nextId, peerId: peerId, messageId: messageId, messageTimestamp: messageTimestamp, capturedAt: now, kind: kind, text: text, formatting: formatting, reactions: reactions, attachments: attachments))
+        self.nextId += 1
+        self.prune(now: now)
+    }
+}
