diff --git a/submodules/TelegramCore/Sources/AyuGram/AyuLocalPremium.swift b/submodules/TelegramCore/Sources/AyuGram/AyuLocalPremium.swift
new file mode 100644
index 00000000..34f006ec
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuGram/AyuLocalPremium.swift
@@ -0,0 +1,120 @@
+import Foundation
+import Postbox
+import SwiftSignalKit
+
+/// Desktop/Android `localPremium`: the account's own user is treated as Premium by this client
+/// only. Server entitlements, limits and other clients are unchanged, so limit decisions keep
+/// using `isServerPremium`. Custom emoji that the server would strip from a non-Premium sender
+/// are sent as `tg://emoji?id=` text links, which AyuGram clients render back as custom emoji.
+public enum AyuLocalPremium {
+    private struct State {
+        var local = false
+        var server = false
+    }
+
+    private static let lock = NSLock()
+    private static var states: [PeerId: State] = [:]
+
+    public static let emojiUrlPrefix = "tg://emoji?id="
+
+    /// Whether `peerId` is an account of this process with local Premium enabled.
+    public static func contains(_ peerId: PeerId) -> Bool {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return self.states[peerId]?.local ?? false
+    }
+
+    static func update(peerId: PeerId, local: Bool? = nil, server: Bool? = nil) {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        var state = self.states[peerId] ?? State()
+        if let local { state.local = local }
+        if let server { state.server = server }
+        self.states[peerId] = state
+    }
+
+    /// True while local Premium hides a missing server subscription: custom emoji are rewritten
+    /// and Premium-only server features (rich messages) must not be offered as available.
+    public static func rewritesCustomEmoji(accountPeerId: PeerId) -> Bool {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        guard let state = self.states[accountPeerId] else { return false }
+        return state.local && !state.server
+    }
+
+    public static func emojiFileId(url: String) -> Int64? {
+        guard url.hasPrefix(self.emojiUrlPrefix) else { return nil }
+        let digits = url.dropFirst(self.emojiUrlPrefix.count)
+        guard !digits.isEmpty, digits.count <= 19, digits.allSatisfy({ $0.isASCII && $0.isNumber }), let id = Int64(digits), id > 0 else { return nil }
+        return id
+    }
+
+    /// Display-only: a `tg://emoji?id=` link covering exactly one emoji becomes that custom emoji.
+    /// Stored entities are not changed, so edits, quotes and forwards keep the original link.
+    public static func displayEntities(text: String, entities: [MessageTextEntity]) -> [MessageTextEntity] {
+        guard entities.contains(where: { if case let .TextUrl(url) = $0.type { return url.hasPrefix(self.emojiUrlPrefix) } else { return false } }) else {
+            return entities
+        }
+        let nsText = text as NSString
+        return entities.map { entity in
+            guard case let .TextUrl(url) = entity.type, let fileId = self.emojiFileId(url: url) else { return entity }
+            let range = NSRange(location: entity.range.lowerBound, length: entity.range.upperBound - entity.range.lowerBound)
+            guard range.location >= 0, range.length > 0, range.upperBound <= nsText.length, self.isSingleEmoji(nsText.substring(with: range)) else { return entity }
+            return MessageTextEntity(range: entity.range, type: .CustomEmoji(stickerPack: nil, fileId: fileId))
+        }
+    }
+
+    /// Outgoing text and captions: custom emoji become links unless the server already allows them
+    /// (a real subscription or Saved Messages).
+    static func outgoingEntities(_ entities: [MessageTextEntity], accountPeerId: PeerId, peerId: PeerId) -> [MessageTextEntity] {
+        guard peerId != accountPeerId, entities.contains(where: { if case .CustomEmoji = $0.type { return true } else { return false } }), self.rewritesCustomEmoji(accountPeerId: accountPeerId) else {
+            return entities
+        }
+        return entities.map { entity in
+            guard case let .CustomEmoji(_, fileId) = entity.type else { return entity }
+            return MessageTextEntity(range: entity.range, type: .TextUrl(url: self.emojiUrlPrefix + "\(fileId)"))
+        }
+    }
+
+    static func outgoingAttribute(_ attribute: TextEntitiesMessageAttribute, accountPeerId: PeerId, peerId: PeerId) -> TextEntitiesMessageAttribute {
+        let entities = self.outgoingEntities(attribute.entities, accountPeerId: accountPeerId, peerId: peerId)
+        return entities == attribute.entities ? attribute : TextEntitiesMessageAttribute(entities: entities)
+    }
+
+    private static func isSingleEmoji(_ string: String) -> Bool {
+        guard string.count == 1, let first = string.unicodeScalars.first else { return false }
+        return first.properties.isEmojiPresentation || (first.properties.isEmoji && string.unicodeScalars.count > 1)
+    }
+}
+
+/// Keeps the registry in step with this account's setting and its server Premium flag.
+func ayuManageLocalPremium(postbox: Postbox, network: Network, peerId: PeerId) -> Signal<Void, NoError> {
+    AyuLocalPremium.update(peerId: peerId, local: network.ayuGhostMode.current.advanced.localPremium)
+    let local = network.ayuGhostMode.signal
+    |> map { $0.advanced.localPremium }
+    |> distinctUntilChanged
+    |> map { value -> Void in AyuLocalPremium.update(peerId: peerId, local: value) }
+    let server = postbox.peerView(id: peerId)
+    |> map { view -> Bool in view.peers[peerId]?.isServerPremium ?? false }
+    |> distinctUntilChanged
+    |> map { value -> Void in AyuLocalPremium.update(peerId: peerId, server: value) }
+    return combineLatest(local, server) |> map { _ in }
+}
+
+/// Keeps this account's entry of the process-wide display options current.
+func ayuManageDisplayOptions(network: Network, peerId: PeerId) -> Signal<Void, NoError> {
+    func flags(_ interface: AyuInterfaceSettings) -> AyuDisplayOptions.Flags {
+        var flags = AyuDisplayOptions.Flags()
+        flags.revealSpoilers = interface.revealSpoilers
+        flags.filterZalgo = interface.filterZalgo
+        flags.spoofWebAppAsAndroid = interface.spoofWebAppAsAndroid
+        flags.unlimitedRecentStickers = interface.unlimitedRecentStickers
+        flags.disableNumberRounding = interface.disableNumberRounding
+        return flags
+    }
+    AyuDisplayOptions.update(accountPeerId: peerId.toInt64(), flags: flags(network.ayuGhostMode.current.interface))
+    return network.ayuGhostMode.signal
+    |> map { flags($0.interface) }
+    |> distinctUntilChanged
+    |> map { value -> Void in AyuDisplayOptions.update(accountPeerId: peerId.toInt64(), flags: value) }
+}
diff --git a/submodules/TelegramCore/Sources/AyuGram/AyuMediaSendSettings.swift b/submodules/TelegramCore/Sources/AyuGram/AyuMediaSendSettings.swift
