diff --git a/submodules/TelegramUI/Sources/AyuBackgroundNotifications.swift b/submodules/TelegramUI/Sources/AyuBackgroundNotifications.swift
new file mode 100644
index 00000000..c1af8a74
--- /dev/null
+++ b/submodules/TelegramUI/Sources/AyuBackgroundNotifications.swift
@@ -0,0 +1,113 @@
+import Foundation
+import UIKit
+import UserNotifications
+import BackgroundTasks
+import SwiftSignalKit
+import TelegramCore
+import AccountContext
+import AppLock
+import LocalizedPeerData
+
+/// Local notifications for builds without working remote push (sideloaded with another signing
+/// identity, so APNs never reaches this app). While the app is awake in the background — right after
+/// it is closed, during background refresh, a call or audio — new messages that Telegram would
+/// notify about are shown as local notifications. The account's notification settings decide
+/// whether a category notifies and whether text is previewed; muted chats stay silent.
+final class AyuBackgroundNotifications {
+    private let disposable = MetaDisposable()
+
+    init(context: AccountContextImpl) {
+        let accountId = context.account.id
+        let accountPeerId = context.account.peerId
+        let engine = context.engine
+        self.disposable.set((context.account.stateManager.notificationMessages
+        |> deliverOnMainQueue).startStrict(next: { messageList in
+            guard UIApplication.shared.applicationState != .active, !messageList.isEmpty, context.account.network.ayuGhostMode.current.interface.backgroundNotifications else {
+                return
+            }
+            let locked: Signal<Bool, NoError>
+            if let appLockContext = context.sharedContext.appLockContext as? AppLockContextImpl {
+                locked = appLockContext.isCurrentlyLocked |> take(1)
+            } else {
+                locked = .single(false)
+            }
+            let _ = (combineLatest(locked, engine.data.get(TelegramEngine.EngineData.Item.NotificationSettings.Global()))
+            |> deliverOnMainQueue).startStandalone(next: { isLocked, globalSettings in
+                let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+                let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+                for (messages, _, notify, _) in messageList {
+                    guard notify, let message = messages.first, message.author?.id != accountPeerId else {
+                        continue
+                    }
+                    let isMuted = message.attributes.contains(where: { attribute in
+                        if let attribute = attribute as? NotificationInfoMessageAttribute {
+                            return attribute.flags.contains(.muted)
+                        }
+                        return false
+                    })
+                    if isMuted {
+                        continue
+                    }
+                    let peerId = message.id.peerId
+                    let category: EngineGlobalNotificationSettings.CategorySettings
+                    if peerId.namespace == Namespaces.Peer.CloudUser || peerId.namespace == Namespaces.Peer.SecretChat {
+                        category = globalSettings.privateChats
+                    } else if let channel = message.peers[peerId] as? TelegramChannel, case .broadcast = channel.info {
+                        category = globalSettings.channels
+                    } else {
+                        category = globalSettings.groupChats
+                    }
+                    if !category.enabled {
+                        continue
+                    }
+
+                    let content = UNMutableNotificationContent()
+                    if let peer = message.peers[peerId] {
+                        content.title = EnginePeer(peer).displayTitle(strings: presentationData.strings, displayOrder: presentationData.nameDisplayOrder)
+                    } else {
+                        content.title = "AyuGram"
+                    }
+                    // Secret chats, a locked app or disabled previews never put message text on the lock screen.
+                    let showsText = category.displayPreviews && !isLocked && peerId.namespace != Namespaces.Peer.SecretChat
+                    if showsText {
+                        var text = message.text.isEmpty ? (ru ? "Медиа" : "Media") : message.text
+                        if text.count > 300 {
+                            text = String(text.prefix(300)) + "…"
+                        }
+                        if peerId.namespace != Namespaces.Peer.CloudUser, let author = message.author, author.id != peerId {
+                            text = EnginePeer(author).compactDisplayTitle + ": " + text
+                        }
+                        content.body = text
+                    } else {
+                        content.body = ru ? "Новое сообщение" : "New message"
+                    }
+                    content.sound = .default
+                    content.threadIdentifier = "\(accountId.int64)_\(peerId.toInt64())"
+                    var userInfo: [AnyHashable: Any] = ["accountId": accountId.int64, "peerId": peerId.toInt64()]
+                    if let threadId = message.threadId {
+                        userInfo["threadId"] = threadId
+                    }
+                    content.userInfo = userInfo
+                    let request = UNNotificationRequest(identifier: "ayu_\(accountId.int64)_\(peerId.toInt64())_\(message.id.namespace)_\(message.id.id)", content: content, trigger: nil)
+                    UNUserNotificationCenter.current().add(request, withCompletionHandler: nil)
+                }
+            })
+        }))
+    }
+
+    deinit {
+        self.disposable.dispose()
+    }
+}
+
+/// Asks iOS for the next background refresh; a later submission replaces a pending one.
+@available(iOS 13.0, *)
+func ayuScheduleRefreshTask(identifier: String) {
+    let request = BGAppRefreshTaskRequest(identifier: identifier)
+    request.earliestBeginDate = Date(timeIntervalSinceNow: 15.0 * 60.0)
+    do {
+        try BGTaskScheduler.shared.submit(request)
+    } catch let error {
+        Logger.shared.log("AyuGram", "Refresh task not scheduled: \(error)")
+    }
+}
diff --git a/submodules/TelegramUI/Sources/AyuPython/AyuPythonBootstrap.swift b/submodules/TelegramUI/Sources/AyuPython/AyuPythonBootstrap.swift
new file mode 100644
index 00000000..87a624e2
--- /dev/null
+++ b/submodules/TelegramUI/Sources/AyuPython/AyuPythonBootstrap.swift
@@ -0,0 +1,138 @@
+import Foundation
+import UIKit
+import TelegramCore
+import AccountContext
+import AyuPythonBridge
+
+/// App-side wiring of the embedded Python plugin runtime. Resolves the bundled
+/// paths, adapts the Objective-C CPython bridge to `AyuPythonInterpreter`, and
+/// answers Python's host calls (clipboard, logging, account info, and — through
+/// an injected sender — outgoing text). Installed once at launch; a no-op when
+/// the Python framework is absent from the build (`AyuPythonBridgeObjC.isSupported`
+/// is false).
+public final class AyuPythonBootstrap {
+    public static let shared = AyuPythonBootstrap()
+
+    /// The app sets this so plugins can send plain text. Left nil until the send
+    /// path is wired; a nil sender makes `message.send` a reported no-op rather
+    /// than touching the enqueue path. (account, peerId, text, silent, replyTo)
+    public var textSender: ((AccountContext, Int64, String, Bool, Int64?) -> Void)?
+
+    private let bridge = AyuPythonBridgeObjC()
+    private weak var context: AccountContext?
+    private var installed = false
+
+    private init() {}
+
+    public static var runtimeURL: URL? {
+        guard let base = Bundle.main.resourceURL?.appendingPathComponent("ayu-python-runtime", isDirectory: true),
+              FileManager.default.fileExists(atPath: base.appendingPathComponent("python/_ayu_host.py").path) else {
+            return nil
+        }
+        return base
+    }
+
+    fileprivate static func pythonPaths() -> (home: String, stdlib: String, dynload: String)? {
+        guard let resource = Bundle.main.resourceURL else { return nil }
+        let home = resource.appendingPathComponent("python")
+        let lib = home.appendingPathComponent("lib")
+        guard let versioned = (try? FileManager.default.contentsOfDirectory(atPath: lib.path))?.first(where: { $0.hasPrefix("python3") }) else {
+            return nil
+        }
+        let stdlib = lib.appendingPathComponent(versioned)
+        return (home.path, stdlib.path, stdlib.appendingPathComponent("lib-dynload").path)
+    }
+
+    public func install(context: AccountContext) {
+        guard !self.installed, AyuPythonBridgeObjC.isSupported,
+              let runtime = AyuPythonBootstrap.runtimeURL, AyuPythonBootstrap.pythonPaths() != nil else { return }
+        self.installed = true
+        self.context = context
+        AyuPythonRuntime.shared.install(interpreter: AyuPythonInterpreterAdapter(bridge: self.bridge))
+        AyuPythonRuntime.shared.setNativeHandler { [weak self] request in
+            return self?.handleNative(request) ?? .failure("host gone")
+        }
+        let dataDir = AyuPythonBootstrap.dataDirectory()
+        AyuPythonRuntime.shared.startIfNeeded(runtimeURL: runtime, dataDir: dataDir)
+        // Imports are converted to native programs; downloaded Python is not executed.
+    }
+
+    public static func dataDirectory() -> URL {
+        let base = FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first ?? URL(fileURLWithPath: NSTemporaryDirectory())
+        let directory = base.appendingPathComponent("ayu-python-plugins", isDirectory: true)
+        try? FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        return directory
+    }
+
+    private func loadInstalledPlugins() {
+        let sources = AyuPythonBootstrap.dataDirectory().appendingPathComponent("sources", isDirectory: true)
+        guard let files = try? FileManager.default.contentsOfDirectory(at: sources, includingPropertiesForKeys: nil) else { return }
+        for file in files where file.pathExtension == "plugin" {
+            AyuPythonRuntime.shared.load(path: file.path, sha256: nil, completion: nil)
+        }
+    }
+
+    // MARK: - Native host calls
+
+    private func handleNative(_ request: AyuPythonNativeRequest) -> AyuPythonNativeResult {
+        switch request.op {
+        case "log":
+            return .success(nil)
+        case "account.info":
+            return self.accountInfo()
+        case "clipboard.set":
+            if let text = request.string("text") {
+                DispatchQueue.main.async { UIPasteboard.general.string = text }
+            }
+            return .success(nil)
+        case "message.send":
+            return self.sendText(request)
+        case "bulletin.show", "alert.show", "alert.dismiss":
+            // UI surfaces land in a later stage; acknowledge so plugins proceed.
+            return .success(nil)
+        default:
+            return .failure("unknown op \(request.op)")
+        }
+    }
+
+    private func accountInfo() -> AyuPythonNativeResult {
+        guard let context = self.context else { return .success(["account": 0, "userId": 0, "isPremium": false]) }
+        return .success(["account": 0, "userId": context.account.peerId.toInt64(), "isPremium": false])
+    }
+
+    private func sendText(_ request: AyuPythonNativeRequest) -> AyuPythonNativeResult {
+        guard let context = self.context, let peer = request.int64("peer"), let text = request.string("text"), !text.isEmpty else {
+            return .failure("send: missing peer/text")
+        }
+        guard let sender = self.textSender else {
+            return .failure("send: not wired in this build")
+        }
+        let silent = request.bool("silent")
+        let replyTo = request.int64("replyTo")
+        DispatchQueue.main.async { sender(context, peer, text, silent, replyTo) }
+        return .success(nil)
+    }
+}
+
+/// Adapts the Objective-C CPython bridge to the TelegramCore protocol.
+private final class AyuPythonInterpreterAdapter: NSObject, AyuPythonInterpreter {
+    private let bridge: AyuPythonBridgeObjC
+
+    init(bridge: AyuPythonBridgeObjC) {
+        self.bridge = bridge
+    }
+
+    func start(runtimeURL: URL, dataDir: URL, native: @escaping (String) -> String) throws {
+        guard let paths = AyuPythonBootstrap.pythonPaths() else { throw AyuPythonRuntimeError.unavailable }
+        let failure = self.bridge.start(withPythonHome: paths.home, stdlibPath: paths.stdlib, dynloadPath: paths.dynload,
+                                        runtimePath: runtimeURL.appendingPathComponent("python").path, dataDir: dataDir.path,
+                                        handler: { payload in native(payload) })
+        if let failure {
+            throw NSError(domain: "AyuPython", code: 1, userInfo: [NSLocalizedDescriptionKey: failure])
+        }
+    }
+
+    func call(_ requestJSON: String) -> String {
+        return self.bridge.call(requestJSON)
+    }
+}
