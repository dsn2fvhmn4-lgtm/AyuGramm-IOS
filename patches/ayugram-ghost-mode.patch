+++ b/submodules/TelegramCore/Sources/AyuGram/AyuChatExportModels.swift
@@ -0,0 +1,123 @@
+import Foundation
+
+public struct AyuChatExportOptions: Codable, Equatable {
+    public var fromTimestamp: Int32 = 0
+    public var untilTimestamp: Int32 = Int32.max
+    public var forwardToSaved = false
+    public var includeCachedMedia = true
+    public var maximumMessages = 100000
+    public var mediaBudget: Int64 = 1_000_000_000
+    public init() {}
+    public func validate() throws {
+        guard self.fromTimestamp >= 0, self.untilTimestamp >= self.fromTimestamp, (1...1000000).contains(self.maximumMessages), (0...2_000_000_000).contains(self.mediaBudget) else { throw AyuPluginError.invalidInput }
+    }
+}
+public struct AyuChatExportTextEntity: Codable, Equatable { public let type: String; public let text: String }
+public struct AyuChatExportMessage: Codable, Equatable {
+    public let id: Int32
+    public let type: String
+    public let date: String
+    public let date_unixtime: String
+    public let from: String?
+    public let from_id: String?
+    public let text: String
+    public let text_entities: [AyuChatExportTextEntity]
+    public let source_peer_id: String
+    public let reply_to_message_id: Int32?
+    public let photo: String?
+    public let file: String?
+    public let file_name: String?
+    public let media_status: String?
+    public let entities: Data?
+    public init(id: Int32, timestamp: Int32, author: String?, authorId: String?, text: String, peerId: String, replyId: Int32? = nil, photo: String? = nil, file: String? = nil, fileName: String? = nil, mediaStatus: String? = nil, entities: Data? = nil, service: Bool = false) {
+        self.id = id; self.type = service ? "service" : "message"
+        self.date = ISO8601DateFormatter().string(from: Date(timeIntervalSince1970: Double(timestamp)))
+        self.date_unixtime = String(timestamp); self.from = author; self.from_id = authorId; self.text = text; self.text_entities = [AyuChatExportTextEntity(type: "plain", text: text)]
+        self.source_peer_id = peerId; self.reply_to_message_id = replyId; self.photo = photo; self.file = file; self.file_name = fileName; self.media_status = mediaStatus; self.entities = entities
+    }
+}
+/// Disk-backed pages: memory usage does not grow with the whole conversation.
+public final class AyuChatExportWriter {
+    public let root: URL
+    private var pages = 0
+    public private(set) var count = 0
+    public private(set) var mediaBytes: Int64 = 0
+    public private(set) var missingMedia = 0
+    private let options: AyuChatExportOptions
+    public init(parent: URL, options: AyuChatExportOptions) throws {
+        try options.validate(); self.options = options
+        self.root = parent.appendingPathComponent("AyuGram-Chat-" + UUID().uuidString, isDirectory: true)
+        try FileManager.default.createDirectory(at: self.root.appendingPathComponent("pages"), withIntermediateDirectories: true)
+        try FileManager.default.createDirectory(at: self.root.appendingPathComponent("media"), withIntermediateDirectories: true)
+        var root = self.root; var values = URLResourceValues(); values.isExcludedFromBackup = true; try root.setResourceValues(values)
+        #if os(iOS)
+        try FileManager.default.setAttributes([.protectionKey: FileProtectionType.completeUntilFirstUserAuthentication], ofItemAtPath: self.root.path)
+        #endif
+    }
+    public static func html(_ text: String) -> String {
+        return text.replacingOccurrences(of: "&", with: "&amp;").replacingOccurrences(of: "<", with: "&lt;").replacingOccurrences(of: ">", with: "&gt;").replacingOccurrences(of: "\"", with: "&quot;").replacingOccurrences(of: "'", with: "&#39;")
+    }
+    public func copyMedia(source: URL?, name: String) throws -> String? {
+        guard self.options.includeCachedMedia else { return nil }
+        guard let source else { self.missingMedia += 1; return nil }
+        let attributes = try FileManager.default.attributesOfItem(atPath: source.path)
+        let size = (attributes[.size] as? NSNumber)?.int64Value ?? 0
+        guard attributes[.type] as? FileAttributeType == .typeRegular, size > 0, size <= 250_000_000, self.mediaBytes + size <= self.options.mediaBudget else { self.missingMedia += 1; return nil }
+        let ext = (name as NSString).pathExtension.lowercased()
+        let suffix = !ext.isEmpty && ext.count <= 10 && ext.unicodeScalars.allSatisfy({ CharacterSet.alphanumerics.contains($0) }) ? "." + ext : ""
+        let path = "media/" + UUID().uuidString + suffix
+        try FileManager.default.copyItem(at: source, to: self.root.appendingPathComponent(path))
+        self.mediaBytes += size
+        return path
+    }
+    public func appendPage(_ messages: [AyuChatExportMessage]) throws {
+        guard self.count + messages.count <= self.options.maximumMessages else { throw AyuPluginError.capacity }
+        let encoder = JSONEncoder(); encoder.outputFormatting = [.sortedKeys]
+        var page = Data()
+        for message in messages.sorted(by: { left, right in
+            let a = Int64(left.date_unixtime) ?? 0, b = Int64(right.date_unixtime) ?? 0
+            return a == b ? left.id < right.id : a < b
+        }) {
+            page.append(try encoder.encode(message)); page.append(10)
+        }
+        try page.write(to: self.root.appendingPathComponent("pages/\(self.pages).jsonl"), options: .atomic)
+        self.pages += 1; self.count += messages.count
+    }
+    public var pageCount: Int { return self.pages }
+    public func messageIds(page: Int) throws -> [Int32] {
+        guard (0..<self.pages).contains(page) else { throw AyuPluginError.invalidInput }
+        return try Data(contentsOf: self.root.appendingPathComponent("pages/\(page).jsonl")).split(separator: 10).map { try JSONDecoder().decode(AyuChatExportMessage.self, from: Data($0)).id }
+    }
+    public func finish(title: String, peerId: Int64, type: String, truncated: Bool, cancelled: () -> Bool = { false }) throws -> URL {
+        let jsonURL = self.root.appendingPathComponent("result.json"), htmlURL = self.root.appendingPathComponent("messages.html")
+        try Data().write(to: jsonURL); try Data().write(to: htmlURL)
+        let json = try FileHandle(forWritingTo: jsonURL), html = try FileHandle(forWritingTo: htmlURL)
+        defer { try? json.close(); try? html.close() }
+        let header: [String: Any] = ["name": title, "type": type, "id": peerId, "exported_by": "AyuGramm-IOS", "partial": truncated, "missing_media": self.missingMedia]
+        var data = try JSONSerialization.data(withJSONObject: header, options: [.sortedKeys]); data.removeLast(); data.append(contentsOf: ",\"messages\":[".utf8); try json.write(contentsOf: data)
+        let title = Self.html(title)
+        try html.write(contentsOf: Data(("<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width\"><meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; img-src 'self'; media-src 'self'; style-src 'unsafe-inline'\"><title>" + title + "</title><style>body{font:16px system-ui;max-width:900px;margin:auto;padding:20px;background:#101923;color:#e6edf3}article{padding:16px;border-bottom:1px solid #345;white-space:pre-wrap;overflow-wrap:anywhere}small{color:#9ab}a{color:#7cf}img{max-width:100%;max-height:400px}</style></head><body><h1>" + title + "</h1>").utf8))
+        var first = true
+        for index in (0..<self.pages).reversed() {
+            if cancelled() { throw NSError(domain: "AyuChatExport", code: -999) }
+            let lines = try Data(contentsOf: self.root.appendingPathComponent("pages/\(index).jsonl")).split(separator: 10)
+            for line in lines {
+                if !first { try json.write(contentsOf: Data(",".utf8)) }; first = false
+                try json.write(contentsOf: Data(line))
+                let message = try JSONDecoder().decode(AyuChatExportMessage.self, from: Data(line))
+                var block = "<article><b>" + Self.html(message.from ?? "") + "</b> <small>" + Self.html(message.date) + " · #\(message.id)</small><div>" + Self.html(message.text) + "</div>"
+                if let path = message.photo ?? message.file, path.hasPrefix("media/"), !path.contains(".."), !path.contains("\\") {
+                    if message.photo != nil { block += "<img loading=\"lazy\" src=\"" + Self.html(path) + "\" alt=\"photo\">" }
+                    block += "<a download href=\"" + Self.html(path) + "\">" + Self.html(message.file_name ?? "Attachment") + "</a>"
+                } else if let status = message.media_status { block += "<small>" + Self.html(status) + "</small>" }
+                try html.write(contentsOf: Data((block + "</article>").utf8))
+            }
+        }
+        try json.write(contentsOf: Data("]}".utf8)); try html.write(contentsOf: Data("</body></html>".utf8))
+        try FileManager.default.removeItem(at: self.root.appendingPathComponent("pages"))
+        let note = "HTML: messages.html; JSON: result.json; media: media/.\nMessages: \(self.count). Partial: \(truncated). Missing media: \(self.missingMedia).\nCached media only. Service events and formatting use additional JSON metadata; this is not a Telegram Desktop import package.\n"
+        try note.write(to: self.root.appendingPathComponent("README.txt"), atomically: true, encoding: .utf8)
+        return self.root
+    }
+    public func discard() { try? FileManager.default.removeItem(at: self.root) }
+}
