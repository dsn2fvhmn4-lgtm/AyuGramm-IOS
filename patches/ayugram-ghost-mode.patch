@@ -0,0 +1,37 @@
+import Foundation
+import UIKit
+import SwiftSignalKit
+import TelegramCore
+import Display
+import UIKitRuntimeUtils
+
+/// AyuGram streamer mode (Desktop parity): while enabled for the active account, the app's
+/// window content is left out of screenshots, screen recordings and screen sharing, using
+/// the same secure-layer mechanism Telegram applies to secret chats. The person holding
+/// the phone still sees everything; the system keyboard is a separate window and stays visible.
+final class AyuStreamerMode {
+    private let disposable: Disposable
+
+    init(window: Window1, context: AccountContextImpl) {
+        let disposable = MetaDisposable()
+        self.disposable = disposable
+        disposable.set((context.account.network.ayuGhostMode.signal
+        |> map { $0.interface.streamerMode }
+        |> distinctUntilChanged
+        |> deliverOnMainQueue).startStrict(next: { [weak window] enabled in
+            guard let window else {
+                return
+            }
+            // Compared with the layer's own state, so switching to an account with the mode off
+            // also clears what the previous account set; an untouched layer is never toggled.
+            let layer = window.hostView.containerView.layer
+            if getLayerDisableScreenshots(layer) != enabled {
+                setLayerDisableScreenshots(layer, enabled)
+            }
+        }))
+    }
+
+    deinit {
+        self.disposable.dispose()
+    }
+}
