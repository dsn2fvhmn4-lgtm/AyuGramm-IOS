@@ -0,0 +1,161 @@
+import Foundation
+
+/// Per-account, opt-in policy for ordinary cloud chats. Media consumption and secret-chat
+/// receipts deliberately retain the upstream behavior, including expiration handling.
+public struct AyuGhostModeSettings: Codable, Equatable {
+    public enum SilentSendMode: String, Codable { case never, inGhostMode, always }
+    public var hideReadReceipts: Bool
+    public var hideOnline: Bool
+    public var hideTyping: Bool
+    public var hideUploadProgress: Bool
+    public var silentSendMode: SilentSendMode = .never
+    public var regexFilters = AyuRegexSettings()
+    public var appearance = AyuAppearanceSettings()
+    public var mediaSend = AyuMediaSendSettings()
+    public var interface = AyuInterfaceSettings()
+    public var messageShot = AyuMessageShotSettings()
+    public var hiddenMessages = AyuHiddenMessagesSettings()
+    public var reactionDisplay = AyuReactionDisplaySettings()
+    public var plugins = AyuPluginRegistry()
+    public var advanced = AyuAdvancedSettings()
+
+    private enum CodingKeys: String, CodingKey {
+        case hideReadReceipts, hideOnline, hideTyping, hideUploadProgress, silentSendMode, regexFilters, appearance, mediaSend, interface
+        case messageShot
+        case hiddenMessages
+        case reactionDisplay
+        case plugins, advanced
+    }
+
+    public init(from decoder: Decoder) throws {
+        let values = try decoder.container(keyedBy: CodingKeys.self)
+        self.hideReadReceipts = try values.decodeIfPresent(Bool.self, forKey: .hideReadReceipts) ?? false
+        self.hideOnline = try values.decodeIfPresent(Bool.self, forKey: .hideOnline) ?? false
+        self.hideTyping = try values.decodeIfPresent(Bool.self, forKey: .hideTyping) ?? false
+        self.hideUploadProgress = try values.decodeIfPresent(Bool.self, forKey: .hideUploadProgress) ?? false
+        self.silentSendMode = (try? values.decode(SilentSendMode.self, forKey: .silentSendMode)) ?? .never
+        self.regexFilters = (try? values.decode(AyuRegexSettings.self, forKey: .regexFilters)) ?? AyuRegexSettings()
+        do { try self.regexFilters.validate() }
+        catch { self.regexFilters = AyuRegexSettings() }
+        self.appearance = (try? values.decode(AyuAppearanceSettings.self, forKey: .appearance)) ?? AyuAppearanceSettings()
+        self.mediaSend = (try? values.decode(AyuMediaSendSettings.self, forKey: .mediaSend)) ?? AyuMediaSendSettings()
+        self.interface = (try? values.decode(AyuInterfaceSettings.self, forKey: .interface)) ?? AyuInterfaceSettings()
+        self.messageShot = (try? values.decode(AyuMessageShotSettings.self, forKey: .messageShot)) ?? AyuMessageShotSettings()
+        self.hiddenMessages = (try? values.decode(AyuHiddenMessagesSettings.self, forKey: .hiddenMessages)) ?? AyuHiddenMessagesSettings()
+        self.advanced = (try? values.decode(AyuAdvancedSettings.self, forKey: .advanced)) ?? AyuAdvancedSettings()
+        self.reactionDisplay = (try? values.decode(AyuReactionDisplaySettings.self, forKey: .reactionDisplay)) ?? AyuReactionDisplaySettings()
+        do {
+            self.plugins = try values.decodeIfPresent(AyuPluginRegistry.self, forKey: .plugins) ?? AyuPluginRegistry()
+            try self.plugins.validate()
+        } catch {
+            // Corrupt/unknown plugin data must not reset Ghost Mode or other account policy.
+            self.plugins = AyuPluginRegistry()
+        }
+    }
+
+    public init(hideReadReceipts: Bool = false, hideOnline: Bool = false, hideTyping: Bool = false, hideUploadProgress: Bool = false) {
+        self.hideReadReceipts = hideReadReceipts
+        self.hideOnline = hideOnline
+        self.hideTyping = hideTyping
+        self.hideUploadProgress = hideUploadProgress
+    }
+
+    public var allEnabled: Bool {
+        return self.hideReadReceipts && self.hideOnline && self.hideTyping && self.hideUploadProgress
+    }
+
+    public var isActive: Bool {
+        return self.hideReadReceipts || self.hideOnline || self.hideTyping || self.hideUploadProgress
+    }
+
+    public var shouldSendSilently: Bool {
+        switch self.silentSendMode {
+        case .never: return false
+        case .inGhostMode: return self.isActive
+        case .always: return true
+        }
+    }
+
+    public mutating func setAllEnabled(_ enabled: Bool) {
+        self.hideReadReceipts = enabled
+        self.hideOnline = enabled
+        self.hideTyping = enabled
+        self.hideUploadProgress = enabled
+    }
+}
+
+/// The file lives inside the account directory, so logout/account removal owns its lifetime.
+/// Writes must succeed before policy changes are exposed to UI or networking subscribers.
+public final class AyuGhostModeStore {
+    private let lock = NSRecursiveLock()
+    private let fileURL: URL
+    private var value: AyuGhostModeSettings
+    private var observers: [UUID: (AyuGhostModeSettings) -> Void] = [:]
+    private let observationQueue = DispatchQueue(label: "AyuGram.SettingsNotifications")
+    public let hadLoadError: Bool
+
+    public init(accountPath: String) {
+        self.fileURL = URL(fileURLWithPath: accountPath).appendingPathComponent("ayu-ghost-mode.json")
+        if FileManager.default.fileExists(atPath: self.fileURL.path) {
+            do {
+                self.value = try JSONDecoder().decode(AyuGhostModeSettings.self, from: Data(contentsOf: self.fileURL))
+                self.hadLoadError = false
+            } catch {
+                self.value = AyuGhostModeSettings()
+                self.hadLoadError = true
+            }
+        } else {
+            self.value = AyuGhostModeSettings()
+            self.hadLoadError = false
+        }
+    }
+
+    public var current: AyuGhostModeSettings {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return self.value
+    }
+
+    public func update(_ transform: (inout AyuGhostModeSettings) throws -> Void) throws {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        var updated = self.value
+        try transform(&updated)
+        updated.appearance.normalize()
+        try updated.appearance.validate()
+        guard updated != self.value else { return }
+        try updated.regexFilters.validate()
+        try updated.plugins.validate()
+        try updated.advanced.validate()
+        let data = try JSONEncoder().encode(updated)
+        #if os(iOS)
+        try data.write(to: self.fileURL, options: [.atomic, .completeFileProtectionUntilFirstUserAuthentication])
+        #else
+        try data.write(to: self.fileURL, options: .atomic)
+        #endif
+        self.value = updated
+        // Enqueue under the lock to preserve commit order, but never execute subscriber
+        // code while holding the persistence lock (UI/network disposal can re-enter it).
+        let observers = Array(self.observers.values)
+        let committed = updated
+        self.observationQueue.async {
+            for observer in observers { observer(committed) }
+        }
+    }
+
+    func observe(_ observer: @escaping (AyuGhostModeSettings) -> Void) -> UUID {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        let id = UUID()
+        self.observers[id] = observer
+        let initial = self.value
+        self.observationQueue.async { observer(initial) }
+        return id
+    }
+
+    func removeObserver(_ id: UUID) {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        self.observers.removeValue(forKey: id)
+    }
+}
diff --git a/submodules/TelegramCore/Sources/AyuGram/AyuGroupMentions.swift b/submodules/TelegramCore/Sources/AyuGram/AyuGroupMentions.swift
new file mode 100644
index 00000000..9d93e9f3
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuGram/AyuGroupMentions.swift
@@ -0,0 +1,85 @@
+import Foundation
+
+public struct AyuMentionGroup: Codable, Equatable {
+    public var id: String
+    public var command: String
+    public var usernames: [String]
+    public init(id: String = UUID().uuidString, command: String, usernames: [String]) {
+        self.id = id; self.command = command; self.usernames = usernames
+    }
+}
+
+public struct AyuGroupMentionSettings: Codable, Equatable {
+    public var groups: [AyuMentionGroup] = []
+    public var caseSensitive = false
+    public var enabledPrivate = true
+    public var enabledGroups = true
+    public init() {}
+    public static func usernames(_ input: String) -> [String] {
+        let separators = CharacterSet.whitespacesAndNewlines.union(CharacterSet(charactersIn: ",;"))
+        var seen = Set<String>()
+        return input.components(separatedBy: separators).compactMap { token in
+            let value = token.trimmingCharacters(in: CharacterSet(charactersIn: "@.,;"))
+            guard !value.isEmpty, value.utf8.count <= 32, value.unicodeScalars.allSatisfy({
+                (65...90).contains($0.value) || (97...122).contains($0.value) || (48...57).contains($0.value) || $0 == "_"
+            }), seen.insert(value.lowercased()).inserted else { return nil }
+            return value
+        }
+    }
+    public func validate() throws {
+        guard self.groups.count <= 5, Set(self.groups.map(\.id)).count == self.groups.count else { throw AyuPluginError.invalidInput }
+        var commands = Set<String>()
+        for group in self.groups {
+            guard !group.id.isEmpty, group.id.utf8.count <= 64,
+                  !group.command.isEmpty, group.command.count <= 64,
+                  group.command == group.command.trimmingCharacters(in: .whitespacesAndNewlines),
+                  group.command.rangeOfCharacter(from: .controlCharacters) == nil,
+                  commands.insert(self.caseSensitive ? group.command : group.command.lowercased()).inserted,
+                  !group.usernames.isEmpty, group.usernames.count <= 7,
+                  Self.usernames(group.usernames.joined(separator: " ")) == group.usernames else { throw AyuPluginError.invalidInput }
+        }
+    }
+    /// No repeated replacement: inserted mentions are never interpreted as commands.
+    public func expanded(_ text: String, maximumLength: Int = 4096) -> String {
+        guard text.utf8.count <= 8192, !self.groups.isEmpty, (try? self.validate()) != nil else { return text }
+        let sorted = self.groups.sorted { $0.command.count > $1.command.count }
+        let pattern = sorted.map { group -> String in
+            let first = group.command.first!, last = group.command.last!
+            let word: (Character) -> Bool = { $0.isLetter || $0.isNumber || $0 == "_" }
+            let left = word(first) ? "(?<![\\w@])" : "(?<![\\w" + NSRegularExpression.escapedPattern(for: String(first)) + "])"
+            let right = word(last) ? "(?!\\w)" : "(?![\\w" + NSRegularExpression.escapedPattern(for: String(last)) + "])"
+            return left + NSRegularExpression.escapedPattern(for: group.command) + right
+        }.joined(separator: "|")
+        guard let regex = try? NSRegularExpression(pattern: pattern, options: self.caseSensitive ? [] : [.caseInsensitive]) else { return text }
+        let source = text as NSString
+        let matches = regex.matches(in: text, range: NSRange(location: 0, length: source.length))
+        var cursor = 0, output = ""
+        for match in matches {
+            let token = source.substring(with: match.range)
+            guard let group = sorted.first(where: { self.caseSensitive ? $0.command == token : $0.command.lowercased() == token.lowercased() }) else { continue }
+            output += source.substring(with: NSRange(location: cursor, length: match.range.location - cursor))
+            output += group.usernames.map { "@" + $0 }.joined(separator: " ")
+            cursor = NSMaxRange(match.range)
+            guard output.utf16.count <= maximumLength, output.utf8.count <= 8192 else { return text }
+        }
+        output += source.substring(from: cursor)
+        guard output.utf16.count <= maximumLength, output.utf8.count <= 8192 else { return text }
+        return output
+    }
+}
+
+/// Transient cooldown is intentionally absent from exported plugin manifests.
+public final class AyuGroupMentionCooldown {
+    public static let shared = AyuGroupMentionCooldown()
+    private let lock = NSLock()
+    private var sent: [String: TimeInterval] = [:]
+    public init() {}
+    public func consume(key: String, now: TimeInterval = ProcessInfo.processInfo.systemUptime) -> Bool {
+        self.lock.lock(); defer { self.lock.unlock() }
+        if let previous = self.sent[key], now - previous < 60 { return false }
+        if self.sent.count >= 4096 { self.sent = self.sent.filter { now - $0.value < 60 } }
+        if self.sent.count >= 4096 { return false }
+        self.sent[key] = now
+        return true
+    }
+}
