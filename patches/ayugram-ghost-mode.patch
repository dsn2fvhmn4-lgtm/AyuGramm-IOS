+import Foundation
+import Display
+import SwiftSignalKit
+import TelegramCore
+import AccountContext
+import TelegramPresentationData
+import PresentationDataUtils
+import AlertUI
+
+extension ChatControllerImpl {
+    func ayuHideMessages(ids: [EngineMessage.Id]) {
+        guard !self.ayuHideMessageInProgress, self.context.account.network.ayuGhostMode.current.interface.showHideMessage else { return }
+        self.ayuHideMessageInProgress = true
+        let _ = (self.context.engine.messages.ayuLocalHideReferences(ids: ids)
+        |> timeout(3.0, queue: Queue.mainQueue(), alternate: .single(nil))
+        |> deliverOnMainQueue).startStandalone(next: { [weak self] references in
+            guard let self else { return }
+            self.ayuHideMessageInProgress = false
+            let ru = self.presentationData.strings.baseLanguageCode.hasPrefix("ru")
+            guard let references else {
+                self.present(textAlertController(context: self.context, title: "AyuGram", text: ru ? "Сообщение больше недоступно для локального скрытия." : "This message is no longer available for local hiding.", actions: [TextAlertAction(type: .defaultAction, title: self.presentationData.strings.Common_OK, action: {})]), in: .window(.root))
+                return
+            }
+            self.present(textAlertController(context: self.context, title: "AyuGram", text: ru ? "Скрыть сообщение или альбом только в ленте этого аккаунта? Локальное скрытие будет включено. Вернуть можно в «Настройки → AyuGram → Скрытые сообщения»." : "Hide this message or album from this account's chat history? Local hiding will be enabled. Restore it under Settings → AyuGram → Hidden Messages.", actions: [
+                TextAlertAction(type: .genericAction, title: self.presentationData.strings.Common_Cancel, action: {}),
+                TextAlertAction(type: .defaultAction, title: self.presentationData.strings.Common_OK, action: { [weak self] in
+                    guard let self else { return }
+                    do {
+                        var accepted = false
+                        try self.context.account.network.ayuGhostMode.update {
+                            accepted = $0.hiddenMessages.add(references)
+                            if accepted { $0.hiddenMessages.enabled = true }
+                        }
+                        if !accepted {
+                            self.present(textAlertController(context: self.context, title: "AyuGram", text: ru ? "Лимит — 200 сообщений или альбомов. Верни часть скрытых записей и повтори." : "The limit is 200 messages or albums. Restore some entries and try again.", actions: [TextAlertAction(type: .defaultAction, title: self.presentationData.strings.Common_OK, action: {})]), in: .window(.root))
+                        }
+                    } catch {
+                        self.present(textAlertController(context: self.context, title: "AyuGram", text: ru ? "Не удалось сохранить скрытие. Изменение не применено." : "Hiding could not be saved. The change was not applied.", actions: [TextAlertAction(type: .defaultAction, title: self.presentationData.strings.Common_OK, action: {})]), in: .window(.root))
+                    }
+                })
+            ]), in: .window(.root))
+        })
+    }
+}
