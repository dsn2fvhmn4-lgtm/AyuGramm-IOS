--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuGram/AyuPluginCatalog.swift
@@ -0,0 +1,241 @@
+import Foundation
+import CryptoKit
+
+public enum AyuPluginCatalogConfiguration {
+    public static let marker = "ayugram/catalog-v1"
+    public static let format = "ayugram-plugin-catalog-v1"
+    public static let maximumAPI = 9
+    public static let adapterDomain = Data("AyuGram adapter v1\0".utf8)
+    public static let catalogDomain = Data("AyuGram catalog v1\0".utf8)
+    public static let maximumResponseBytes = 2 * 1024 * 1024
+    public static let publicKey = Data(base64Encoded: "qEhrxPcZOm6Aj4YsXJr2OFKp1/lrg/IKUkxZ28Zx8oU=")!
+    public static let url = URL(string: "https://raw.githubusercontent.com/dsn2fvhmn4-lgtm/AyuGramm-IOS/main/plugin-catalog/catalog.json")!
+}
+
+public enum AyuPluginCatalogError: LocalizedError {
+    case invalidCatalog, invalidSignature, rollback, tooLarge, alreadyUpdating, network, http(Int)
+    public var errorDescription: String? {
+        switch self {
+        case .invalidCatalog: return "Invalid plugin catalog. The saved catalog was kept."
+        case .invalidSignature: return "Plugin catalog signature is invalid. The saved catalog was kept."
+        case .rollback: return "An older or conflicting catalog was rejected. The saved catalog was kept."
+        case .tooLarge: return "Plugin catalog exceeds the size limit."
+        case .alreadyUpdating: return "The plugin catalog is already updating."
+        case .network: return "Could not download the plugin catalog. Check your connection."
+        case let .http(status): return "Plugin catalog server returned HTTP \(status)."
+        }
+    }
+}
+
+/// A portable per-adapter proof lets installed/exported plugins keep working
+/// offline, including after their catalog entry is superseded or removed.
+public struct AyuPluginCatalogProof: Codable, Equatable {
+    public var manifestData: Data
+    public var signature: Data
+    public func verify(manifest: AyuPluginManifest) throws {
+        guard self.manifestData.count <= 16384, self.signature.count == 64 else { throw AyuPluginCatalogError.invalidSignature }
+        let key = try Curve25519.Signing.PublicKey(rawRepresentation: AyuPluginCatalogConfiguration.publicKey)
+        guard key.isValidSignature(self.signature, for: AyuPluginCatalogConfiguration.adapterDomain + self.manifestData) else { throw AyuPluginCatalogError.invalidSignature }
+        let signed = try JSONDecoder().decode(AyuPluginManifest.self, from: self.manifestData)
+        guard signed.catalogProof == nil, signed.convertedFrom == AyuPluginCatalogConfiguration.marker,
+              (7...AyuPluginCatalogConfiguration.maximumAPI).contains(signed.apiVersion), let hash = signed.sourceSHA256, ayuCatalogValidHash(hash) else { throw AyuPluginCatalogError.invalidCatalog }
+        var plain = manifest
+        plain.catalogProof = nil
+        let encoder = JSONEncoder()
+        encoder.outputFormatting = [.sortedKeys]
+        // Compare encoded bytes, not Swift String equality: normalization must
+        // not change literal matching while retaining someone else's signature.
+        guard try encoder.encode(plain) == encoder.encode(signed) else { throw AyuPluginCatalogError.invalidSignature }
+    }
+}
+
+private func ayuCatalogValidHash(_ hash: String) -> Bool {
+    return hash.utf8.count == 64 && hash.utf8.allSatisfy { (48...57).contains($0) || (97...102).contains($0) }
+}
+
+private struct AyuPluginCatalogEnvelope: Codable {
+    var format: String
+    var payload: Data
+    var signature: Data
+}
+
+private struct AyuPluginCatalogPayload: Codable {
+    var revision: Int
+    var createdAt: Int64
+    var adapters: [AyuPluginCatalogProof]
+}
+
+private struct AyuPluginCatalogHeader: Decodable {
+    var apiVersion: Int
+    var sourceSHA256: String
+}
+
+public struct AyuPluginCatalogSummary {
+    public let revision: Int
+    public let adapterCount: Int
+    public let requiresNewApp: Int
+    public let unchanged: Bool
+}
+
+private struct AyuPluginCatalogSnapshot {
+    var revision = 0
+    var adapters: [String: AyuPluginManifest] = [:]
+    var requiresNewApp = 0
+    var digest = Data()
+    func summary(unchanged: Bool = false) -> AyuPluginCatalogSummary {
+        return AyuPluginCatalogSummary(revision: self.revision, adapterCount: self.adapters.count, requiresNewApp: self.requiresNewApp, unchanged: unchanged)
+    }
+    static func decode(_ data: Data) throws -> AyuPluginCatalogSnapshot {
+        guard !data.isEmpty, data.count <= AyuPluginCatalogConfiguration.maximumResponseBytes else { throw AyuPluginCatalogError.tooLarge }
+        let envelope = try JSONDecoder().decode(AyuPluginCatalogEnvelope.self, from: data)
+        guard envelope.format == AyuPluginCatalogConfiguration.format,
+              envelope.payload.count <= 1024 * 1024, envelope.signature.count == 64 else { throw AyuPluginCatalogError.invalidCatalog }
+        let key = try Curve25519.Signing.PublicKey(rawRepresentation: AyuPluginCatalogConfiguration.publicKey)
+        guard key.isValidSignature(envelope.signature, for: AyuPluginCatalogConfiguration.catalogDomain + envelope.payload) else { throw AyuPluginCatalogError.invalidSignature }
+        let payload = try JSONDecoder().decode(AyuPluginCatalogPayload.self, from: envelope.payload)
+        guard (1...2147483647).contains(payload.revision), payload.createdAt >= 0, payload.adapters.count <= 128 else { throw AyuPluginCatalogError.invalidCatalog }
+        var snapshot = AyuPluginCatalogSnapshot()
+        snapshot.revision = payload.revision
+        snapshot.digest = Data(SHA256.hash(data: envelope.payload))
+        var hashes = Set<String>()
+        for proof in payload.adapters {
+            guard proof.manifestData.count <= 16384, proof.signature.count == 64,
+                  key.isValidSignature(proof.signature, for: AyuPluginCatalogConfiguration.adapterDomain + proof.manifestData) else { throw AyuPluginCatalogError.invalidSignature }
+            let header = try JSONDecoder().decode(AyuPluginCatalogHeader.self, from: proof.manifestData)
+            guard header.apiVersion >= 1, ayuCatalogValidHash(header.sourceSHA256), hashes.insert(header.sourceSHA256).inserted else { throw AyuPluginCatalogError.invalidCatalog }
+            if header.apiVersion > AyuPluginCatalogConfiguration.maximumAPI {
+                snapshot.requiresNewApp += 1
+                continue
+            }
+            var manifest = try JSONDecoder().decode(AyuPluginManifest.self, from: proof.manifestData)
+            guard manifest.catalogProof == nil else { throw AyuPluginCatalogError.invalidCatalog }
+            manifest.catalogProof = proof
+            try manifest.validate()
+            snapshot.adapters[header.sourceSHA256] = manifest
+        }
+        return snapshot
+    }
+}
+
+/// Catalog data is global to the app. Installed plugin preferences remain per-account.
+public final class AyuPluginCatalogStore {
+    public static let shared: AyuPluginCatalogStore = {
+        let base = FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first ?? URL(fileURLWithPath: NSTemporaryDirectory())
+        return AyuPluginCatalogStore(directory: base.appendingPathComponent("AyuPluginCatalog", isDirectory: true))
+    }()
+    private let lock = NSLock()
+    private let directory: URL
+    private let file: URL
+    private var value = AyuPluginCatalogSnapshot()
+    private var updating = false
+    public init(directory: URL) {
+        self.directory = directory
+        self.file = directory.appendingPathComponent("catalog.json")
+        if let attributes = try? FileManager.default.attributesOfItem(atPath: self.file.path),
+           let size = attributes[.size] as? NSNumber, size.intValue <= AyuPluginCatalogConfiguration.maximumResponseBytes,
+           let data = try? Data(contentsOf: self.file), let snapshot = try? AyuPluginCatalogSnapshot.decode(data) {
+            self.value = snapshot
+        }
+    }
+    public var summary: AyuPluginCatalogSummary {
+        self.lock.lock(); defer { self.lock.unlock() }
+        return self.value.summary()
+    }
+    public func manifest(sourceSHA256: String) -> AyuPluginManifest? {
+        self.lock.lock(); defer { self.lock.unlock() }
+        return self.value.adapters[sourceSHA256]
+    }
+    @discardableResult public func apply(_ data: Data) throws -> AyuPluginCatalogSummary {
+        let snapshot = try AyuPluginCatalogSnapshot.decode(data)
+        self.lock.lock(); defer { self.lock.unlock() }
+        guard snapshot.revision >= self.value.revision else { throw AyuPluginCatalogError.rollback }
+        if snapshot.revision == self.value.revision {
+            guard snapshot.digest == self.value.digest else { throw AyuPluginCatalogError.rollback }
+            return self.value.summary(unchanged: true)
+        }
+        try FileManager.default.createDirectory(at: self.directory, withIntermediateDirectories: true)
+        #if os(iOS)
+        try data.write(to: self.file, options: [.atomic, .completeFileProtectionUntilFirstUserAuthentication])
+        #else
+        try data.write(to: self.file, options: .atomic)
+        #endif
+        var excluded = self.directory
+        var resources = URLResourceValues(); resources.isExcludedFromBackup = true
+        try? excluded.setResourceValues(resources)
+        self.value = snapshot
+        return snapshot.summary()
+    }
+    public func update(completion: @escaping (Result<AyuPluginCatalogSummary, Error>) -> Void) {
+        self.lock.lock()
+        if self.updating {
+            self.lock.unlock()
+            DispatchQueue.main.async { completion(.failure(AyuPluginCatalogError.alreadyUpdating)) }
+            return
+        }
+        self.updating = true
+        self.lock.unlock()
+        let download = AyuPluginCatalogDownload { result in
+            let applied = result.flatMap { data in Result { try self.apply(data) } }
+            self.lock.lock(); self.updating = false; self.lock.unlock()
+            DispatchQueue.main.async { completion(applied) }
+        }
+        download.start()
+    }
+}
