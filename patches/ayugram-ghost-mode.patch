+import Foundation
+import Postbox
+
+/// A local tombstone. Never serialized into Telegram API messages.
+public final class AyuDeletedMessageAttribute: MessageAttribute {
+    public let timestamp: Int64
+
+    public init(timestamp: Int64) { self.timestamp = timestamp }
+
+    public init(decoder: PostboxDecoder) {
+        self.timestamp = decoder.decodeInt64ForKey("t", orElse: 0)
+    }
+
+    public func encode(_ encoder: PostboxEncoder) {
+        encoder.encodeInt64(self.timestamp, forKey: "t")
+    }
+}
