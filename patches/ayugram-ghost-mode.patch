+
+extension ChatControllerImpl {
+    func ayuPresentMessageShotChoice(ids: [EngineMessage.Id], shareNormally: @escaping () -> Void) {
+        guard self.context.account.network.ayuGhostMode.current.interface.showMessageShot else { shareNormally(); return }
+        let ru = self.presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        self.present(textAlertController(context: self.context, title: "AyuGram", text: ru ? "Как поделиться выбранными сообщениями?" : "How would you like to share the selected messages?", actions: [
+            TextAlertAction(type: .genericAction, title: self.presentationData.strings.Common_Cancel, action: {}),
+            TextAlertAction(type: .defaultAction, title: ru ? "Сообщения" : "Messages", action: shareNormally),
+            TextAlertAction(type: .defaultAction, title: "MessageShot", action: { [weak self] in self?.ayuShowMessageShot(ids: ids) })
+        ], actionLayout: .vertical), in: .window(.root))
+    }
+
+    private func ayuMessageShotError() {
+        let ru = self.presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        self.present(textAlertController(context: self.context, title: "MessageShot", text: ru ? "Выбери до 20 доступных обычных сообщений из одного чата. Защищённые и исчезающие сообщения исключены. Если картинка слишком длинная, выбери меньше сообщений." : "Choose up to 20 available ordinary messages from one chat. Protected and disappearing messages are excluded. Select fewer messages if the image is too tall.", actions: [TextAlertAction(type: .defaultAction, title: self.presentationData.strings.Common_OK, action: {})]), in: .window(.root))
+    }
+
+    func ayuShowMessageShot(ids: [EngineMessage.Id]) {
+        guard !self.ayuMessageShotInProgress, self.context.account.network.ayuGhostMode.current.interface.showMessageShot else { return }
+        guard !self.presentationInterfaceState.copyProtectionEnabled else { self.ayuMessageShotError(); return }
+        let shot = self.context.account.network.ayuGhostMode.current.messageShot
+        self.ayuMessageShotInProgress = true
+        let progress = OverlayStatusController(theme: self.presentationData.theme, type: .loading(cancelled: nil))
+        self.present(progress, in: .window(.root))
+        let context = self.context
+        let _ = (context.engine.messages.ayuMessageShotMessages(ids: ids)
+        |> timeout(3.0, queue: Queue.mainQueue(), alternate: .single(nil))
+        |> deliverOnMainQueue).startStandalone(next: { [weak self] messages in
+            guard let self else { progress.dismiss(); return }
+            guard let messages else { self.ayuMessageShotInProgress = false; progress.dismiss(); self.ayuMessageShotError(); return }
+            let _ = (combineLatest(messages.map { message -> Signal<UIImage?, NoError> in
+                if shot.showMediaPreviews { return ayuMessageShotThumbnail(context: context, message: message) }
+                return .single(nil)
+            })
+            |> take(1)
+            |> deliverOnMainQueue).startStandalone(next: { [weak self] photos in
+                progress.dismiss()
+                guard let self else { return }
+                self.ayuMessageShotInProgress = false
+                let data = self.presentationData
+                let ru = data.strings.baseLanguageCode.hasPrefix("ru")
+                let dark = shot.isDark(fallback: data.theme.overallDarkAppearance)
+                let color: UIColor = dark ? .white : UIColor(white: 0.12, alpha: 1.0)
+                var cards: [AyuMessageShotCard] = []
+                for (index, message) in messages.enumerated() {
+                    let entities = (message.attributes.first(where: { $0 is TextEntitiesMessageAttribute }) as? TextEntitiesMessageAttribute)?.entities ?? []
+                    let spoilers = entities.compactMap { entity -> Range<Int>? in if case .Spoiler = entity.type { return entity.range }; return nil }
+                    let safeText = AyuMessageShotPolicy.maskingSpoilers(message.text, ranges: spoilers)
+                    let safeLength = (safeText as NSString).length
+                    let safeEntities = entities.filter { entity in entity.range.lowerBound >= 0 && entity.range.upperBound <= safeLength && !spoilers.contains(where: { $0.overlaps(entity.range) }) }
+                    let text = NSMutableAttributedString(attributedString: stringWithAppliedEntities(safeText, entities: safeEntities, baseColor: color, linkColor: color, baseFont: Font.regular(30.0), linkFont: Font.regular(30.0), boldFont: Font.semibold(30.0), italicFont: Font.italic(30.0), boldItalicFont: Font.semiboldItalic(30.0), fixedFont: Font.monospace(28.0), blockQuoteFont: Font.regular(30.0), message: nil))
+                    let media = ayuMessageShotMediaLabel(message, russian: ru)
+                    if !media.isEmpty { text.append(NSAttributedString(string: (text.length == 0 ? "" : "\n") + "[\(media)]", attributes: [.font: Font.italic(25.0), .foregroundColor: color])) }
+                    if text.length == 0 { text.append(NSAttributedString(string: ru ? "Сообщение" : "Message", attributes: [.font: Font.regular(30.0), .foregroundColor: color])) }
+                    let author = message.author?.displayTitle(strings: data.strings, displayOrder: data.nameDisplayOrder) ?? (ru ? "Автор" : "Author")
+                    let date = DateFormatter.localizedString(from: Date(timeIntervalSince1970: TimeInterval(message.timestamp)), dateStyle: .short, timeStyle: .short)
+                    cards.append(AyuMessageShotCard(author: String(author.prefix(80)), date: date, text: text, photo: photos[index], outgoing: !message.flags.contains(.Incoming)))
+                }
+                guard let image = ayuRenderMessageShot(cards: cards, dark: dark, width: CGFloat(AyuMessageShotPolicy.imageWidth), maximumHeight: CGFloat(AyuMessageShotPolicy.maximumImageHeight), showBackground: shot.showBackground, showAuthors: shot.showAuthors, showDate: shot.showDate, showHeader: shot.showHeader) else { self.ayuMessageShotError(); return }
+                let preview = AyuMessageShotPreview(image: image)
+                preview.share = { [weak exportContext = context] controller in
+                    guard let context = exportContext else { return }
+                    controller.navigationItem.rightBarButtonItem?.isEnabled = false
+                    let _ = (context.engine.messages.ayuMessageShotMessages(ids: ids)
+                    |> timeout(3.0, queue: Queue.mainQueue(), alternate: .single(nil))
+                    |> deliverOnMainQueue).startStandalone(next: { [weak controller] current in
+                        guard let controller else { return }
+                        controller.navigationItem.rightBarButtonItem?.isEnabled = true
+                        guard current != nil else {
+                            let alert = UIAlertController(title: "MessageShot", message: ru ? "Сообщения больше недоступны для экспорта." : "These messages are no longer available for export.", preferredStyle: .alert)
+                            alert.addAction(UIAlertAction(title: data.strings.Common_OK, style: .default, handler: nil))
+                            controller.present(alert, animated: true)
+                            return
+                        }
+                        let activity = UIActivityViewController(activityItems: [image], applicationActivities: nil)
+                        activity.popoverPresentationController?.sourceView = controller.view
+                        activity.popoverPresentationController?.sourceRect = CGRect(x: controller.view.bounds.midX, y: controller.view.bounds.midY, width: 1.0, height: 1.0)
+                        controller.present(activity, animated: true)
+                    })
+                }
+                context.sharedContext.applicationBindings.presentNativeController(UINavigationController(rootViewController: preview))
+            })
+        })
+    }
+}
