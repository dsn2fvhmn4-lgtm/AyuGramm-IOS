+public enum AyuPetpetRenderer {
+    public enum Failure: Error { case invalidImage, invalidOptions, encoding }
+    public static func image(data: Data) throws -> UIImage {
+        guard !data.isEmpty, data.count <= 8 * 1024 * 1024,
+              let source = CGImageSourceCreateWithData(data as CFData, nil),
+              let properties = CGImageSourceCopyPropertiesAtIndex(source, 0, nil) as? [String: Any],
+              let width = properties[kCGImagePropertyPixelWidth as String] as? NSNumber,
+              let height = properties[kCGImagePropertyPixelHeight as String] as? NSNumber,
+              width.doubleValue > 0, height.doubleValue > 0,
+              width.doubleValue * height.doubleValue <= 64000000,
+              let thumbnail = CGImageSourceCreateThumbnailAtIndex(source, 0, [
+                kCGImageSourceCreateThumbnailFromImageAlways: true,
+                kCGImageSourceCreateThumbnailWithTransform: true,
+                kCGImageSourceThumbnailMaxPixelSize: 1024
+              ] as CFDictionary) else { throw Failure.invalidImage }
+        return UIImage(cgImage: thumbnail)
+    }
+    public static func render(image: UIImage, resolution: Int, delay: Int) throws -> (Data, [UIImage]) {
+        guard [64, 128, 256, 512].contains(resolution), [20, 30, 40, 50, 70, 100].contains(delay), image.size.width > 0, image.size.height > 0 else { throw Failure.invalidOptions }
+        let hands = self.handFrames.compactMap { Data(base64Encoded: $0).flatMap { UIImage(data: $0) } }
+        guard hands.count == 10 else { throw Failure.encoding }
+        let size = CGSize(width: CGFloat(resolution), height: CGFloat(resolution))
+        let format = UIGraphicsImageRendererFormat(); format.scale = 1; format.opaque = false
+        let renderer = UIGraphicsImageRenderer(size: size, format: format)
+        let output = NSMutableData()
+        guard let destination = CGImageDestinationCreateWithData(output, UTType.gif.identifier as CFString, 10, nil) else { throw Failure.encoding }
+        CGImageDestinationSetProperties(destination, [kCGImagePropertyGIFDictionary: [kCGImagePropertyGIFLoopCount: 0]] as CFDictionary)
+        var frames: [UIImage] = []
+        for index in 0..<10 {
+            let frame = autoreleasepool { () -> UIImage in
+                let bounce = Double(index < 5 ? index : 10 - index)
+                let width = 0.8 + bounce * 0.02, height = 0.8 - bounce * 0.05
+                return renderer.image { _ in
+                    image.draw(in: CGRect(x: Int(((1 - width) * 0.5 + 0.1) * Double(resolution)), y: Int((1 - height - 0.08) * Double(resolution)), width: Int(width * Double(resolution)), height: Int(height * Double(resolution))))
+                    hands[index].draw(in: CGRect(origin: .zero, size: size))
+                }
+            }
+            guard let cgImage = frame.cgImage else { throw Failure.encoding }
+            CGImageDestinationAddImage(destination, cgImage, [kCGImagePropertyGIFDictionary: [kCGImagePropertyGIFDelayTime: Double(delay) / 1000.0, kCGImagePropertyGIFUnclampedDelayTime: Double(delay) / 1000.0]] as CFDictionary)
+            frames.append(frame)
+        }
+        guard CGImageDestinationFinalize(destination), output.length <= 8 * 1024 * 1024 else { throw Failure.encoding }
+        return (try self.clearAfterFrames(output as Data), frames)
+    }
+    /// A transparent full frame must clear before the next frame, otherwise GIF
+    /// decoders retain the previous squashed avatar and produce visible trails.
+    private static func clearAfterFrames(_ data: Data) throws -> Data {
+        var bytes = [UInt8](data)
+        guard bytes.count >= 14, String(bytes: bytes.prefix(6), encoding: .ascii)?.hasPrefix("GIF8") == true else { throw Failure.encoding }
+        var offset = 13
+        if bytes[10] & 0x80 != 0 { offset += 3 * (1 << (Int(bytes[10] & 7) + 1)) }
+        var controls = 0, images = 0
+        func skipBlocks(_ cursor: inout Int) throws {
+            while cursor < bytes.count {
+                let count = Int(bytes[cursor]); cursor += 1
+                if count == 0 { return }
+                guard cursor + count <= bytes.count else { throw Failure.encoding }
+                cursor += count
+            }
+            throw Failure.encoding
+        }
+        while offset < bytes.count {
+            let marker = bytes[offset]; offset += 1
+            if marker == 0x3b {
+                guard controls == 10, images == 10 else { throw Failure.encoding }
+                return Data(bytes)
+            }
+            if marker == 0x21 {
+                guard offset < bytes.count else { throw Failure.encoding }
+                let label = bytes[offset]; offset += 1
+                if label == 0xf9 {
+                    guard offset + 6 <= bytes.count, bytes[offset] == 4, bytes[offset + 5] == 0 else { throw Failure.encoding }
+                    bytes[offset + 1] = (bytes[offset + 1] & 0xe3) | 0x08
+                    controls += 1
+                }
+                try skipBlocks(&offset)
+            } else if marker == 0x2c {
+                guard offset + 9 <= bytes.count else { throw Failure.encoding }
+                let flags = bytes[offset + 8]; offset += 9
+                if flags & 0x80 != 0 { offset += 3 * (1 << (Int(flags & 7) + 1)) }
+                guard offset < bytes.count else { throw Failure.encoding }
+                offset += 1; try skipBlocks(&offset); images += 1
+            } else { throw Failure.encoding }
+        }
+        throw Failure.encoding
+    }
+    // Original petpet 1.0.6 hand frames by @limeplug, extracted as original single-frame GIF data only.
+    private static let handFrames: [String] = [
+        "",
+        "",
+        "",
+        "",
+        "",
+        "",
+        "",
+        "",
+        "",
+        ""
+    ]
+}
