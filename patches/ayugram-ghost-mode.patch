--- /dev/null
+++ b/submodules/AyuPythonBridge/BUILD
@@ -0,0 +1,24 @@
+load("@rules_cc//cc:objc_library.bzl", "objc_library")
+
+# Objective-C wrapper over the embedded CPython C API. It compiles with no
+# Python dependency: the .m uses __has_include(<Python/Python.h>) and falls back
+# to a stub until Python.xcframework is embedded, so this target stays green
+# before the framework wiring lands.
+objc_library(
+    name = "AyuPythonBridge",
+    enable_modules = True,
+    module_name = "AyuPythonBridge",
+    deps = ["//third-party/ayu-python:Python"],
+    srcs = glob([
+        "Sources/**/*.m",
+    ]),
+    hdrs = glob([
+        "Sources/**/*.h",
+    ]),
+    includes = [
+        "Sources",
+    ],
+    visibility = [
+        "//visibility:public",
+    ],
+)
diff --git a/submodules/AyuPythonBridge/Sources/AyuPythonBridgeObjC.h b/submodules/AyuPythonBridge/Sources/AyuPythonBridgeObjC.h
new file mode 100644
index 00000000..fa6864af
--- /dev/null
+++ b/submodules/AyuPythonBridge/Sources/AyuPythonBridgeObjC.h
@@ -0,0 +1,42 @@
+#ifndef AyuPythonBridgeObjC_h
+#define AyuPythonBridgeObjC_h
+
+#import <Foundation/Foundation.h>
+
+NS_ASSUME_NONNULL_BEGIN
+
+/// Thin Objective-C wrapper over the embedded CPython C API. One interpreter
+/// per process. Every method must be called from the single owning queue
+/// (AyuPythonRuntime's serial queue); the wrapper holds the GIL only for the
+/// duration of each call.
+///
+/// When a build does not embed the Python framework,
+/// `<Python/Python.h>` is absent and this compiles to a stub whose -start
+/// returns an error string, so the runtime reports itself unavailable and the declarative
+/// plugin ABI keeps handling everything. The real implementation is selected
+/// automatically once the framework is on the header search path.
+@interface AyuPythonBridgeObjC : NSObject
+
+/// Returns nil on success, or an error message. Returning a string (rather than
+/// BOOL + NSError**) keeps the Swift import a plain `-> String?` instead of a
+/// throwing Void, so the caller can branch on the message explicitly.
+- (nullable NSString *)startWithPythonHome:(NSString *)pythonHome
+                                stdlibPath:(NSString *)stdlibPath
+                               dynloadPath:(NSString *)dynloadPath
+                               runtimePath:(NSString *)runtimePath
+                                   dataDir:(NSString *)dataDir
+                                   handler:(NSString * _Nonnull (^)(NSString *payload))handler;
+
+- (NSString *)call:(NSString *)requestJSON;
+
+/// YES when CPython is embedded in this build and the interpreter started.
+@property (nonatomic, readonly) BOOL isStarted;
+
+/// YES when this build embeds CPython (i.e. the real implementation is active).
+@property (nonatomic, readonly, class) BOOL isSupported;
+
+@end
+
+NS_ASSUME_NONNULL_END
+
+#endif /* AyuPythonBridgeObjC_h */
diff --git a/submodules/AyuPythonBridge/Sources/AyuPythonBridgeObjC.m b/submodules/AyuPythonBridge/Sources/AyuPythonBridgeObjC.m
new file mode 100644
index 00000000..30e4a8a2
--- /dev/null
+++ b/submodules/AyuPythonBridge/Sources/AyuPythonBridgeObjC.m
@@ -0,0 +1,208 @@
+#import "AyuPythonBridgeObjC.h"
+
+// The real implementation is selected only when the Python support framework is
+// embedded in the build. Until then every build takes the stub below, which
+// supports builds without the framework. Do not gate this on a custom define: __has_include tracks the
+// actual availability of the SDK headers.
+#if __has_include(<Python/Python.h>)
+#define AYU_PYTHON_AVAILABLE 1
+#import <Python/Python.h>
+#else
+#define AYU_PYTHON_AVAILABLE 0
+#endif
+
+#if AYU_PYTHON_AVAILABLE
+
+static NSString * _Nullable (^gAyuNativeHandler)(NSString *payload) = nil;
+
+static PyObject *ayu_native(PyObject *self, PyObject *args) {
+    const char *payload = NULL;
+    if (!PyArg_ParseTuple(args, "s", &payload)) {
+        return NULL;
+    }
+    NSString *request = [NSString stringWithUTF8String:payload];
+    NSString *response = nil;
+    Py_BEGIN_ALLOW_THREADS
+    @autoreleasepool {
+        NSString * _Nullable (^handler)(NSString *) = gAyuNativeHandler;
+        response = handler ? handler(request) : @"{\"ok\":false,\"error\":\"no handler\"}";
+    }
+    Py_END_ALLOW_THREADS
+    if (response == nil) {
+        response = @"{\"ok\":false,\"error\":\"nil response\"}";
+    }
+    return PyUnicode_FromString([response UTF8String]);
+}
+
+static PyMethodDef ayu_methods[] = {
+    {"native", ayu_native, METH_VARARGS, "AyuGram host bridge"},
+    {NULL, NULL, 0, NULL}
+};
+
+static struct PyModuleDef ayu_module = {
+    PyModuleDef_HEAD_INIT, "_ayu_native_bridge", NULL, -1, ayu_methods, NULL, NULL, NULL, NULL
+};
+
+static PyObject *ayu_init_module(void) {
+    return PyModule_Create(&ayu_module);
+}
+
+@implementation AyuPythonBridgeObjC {
+    BOOL _started;
+    PyObject *_hostCall;
+}
+
++ (BOOL)isSupported { return YES; }
+- (BOOL)isStarted { return _started; }
+
+- (nullable NSString *)startWithPythonHome:(NSString *)pythonHome
+                                stdlibPath:(NSString *)stdlibPath
+                               dynloadPath:(NSString *)dynloadPath
+                               runtimePath:(NSString *)runtimePath
+                                   dataDir:(NSString *)dataDir
+                                   handler:(NSString * _Nonnull (^)(NSString *))handler {
+    if (_started) {
+        return nil;
+    }
+    gAyuNativeHandler = [handler copy];
+
+    if (PyImport_AppendInittab("_ayu_native_bridge", ayu_init_module) != 0) {
+        return @"inittab";
+    }
+
+    PyPreConfig preConfig;
+    PyPreConfig_InitIsolatedConfig(&preConfig);
+    preConfig.utf8_mode = 1;
+    PyStatus status = Py_PreInitialize(&preConfig);
+    if (PyStatus_Exception(status)) {
+        return @"preinit";
+    }
+
+    PyConfig config;
+    PyConfig_InitIsolatedConfig(&config);
+    config.buffered_stdio = 0;
+    config.write_bytecode = 0;
+    config.install_signal_handlers = 0;
+    config.module_search_paths_set = 1;
+
+    status = PyConfig_SetBytesString(&config, &config.home, [pythonHome UTF8String]);
+    if (PyStatus_Exception(status)) { PyConfig_Clear(&config); return @"Python home configuration failed"; }
+    for (NSString *path in @[stdlibPath, dynloadPath, runtimePath]) {
+        wchar_t *decoded = Py_DecodeLocale([path UTF8String], NULL);
+        if (decoded == NULL) { PyConfig_Clear(&config); return @"Python path decoding failed"; }
+        status = PyWideStringList_Append(&config.module_search_paths, decoded);
+        PyMem_RawFree(decoded);
+        if (PyStatus_Exception(status)) { PyConfig_Clear(&config); return @"Python search path configuration failed"; }
+    }
+
+    status = Py_InitializeFromConfig(&config);
+    NSString *initializationError = PyStatus_Exception(status) ? [NSString stringWithFormat:@"init: %s", status.err_msg ?: "unknown"] : nil;
+    PyConfig_Clear(&config);
+    if (initializationError != nil) { return initializationError; }
+
+    PyObject *host = PyImport_ImportModule("_ayu_host");
+    if (host == NULL) {
+        NSString *error = [self pythonErrorWithContext:@"import _ayu_host"];
+        PyEval_SaveThread();
+        return error;
+    }
+    PyObject *bridge = PyImport_ImportModule("_ayu_native_bridge");
+    PyObject *installResult = NULL;
+    if (bridge != NULL) {
+        PyObject *nativeFn = PyObject_GetAttrString(bridge, "native");
+        if (nativeFn != NULL) { installResult = PyObject_CallMethod(host, "install_native", "O", nativeFn); }
+        Py_XDECREF(nativeFn);
+        Py_DECREF(bridge);
+    }
+    if (installResult == NULL) {
+        NSString *error = [self pythonErrorWithContext:@"install native handler"];
+        Py_DECREF(host);
+        PyEval_SaveThread();
+        return error;
+    }
+    Py_DECREF(installResult);
+
+    _hostCall = PyObject_GetAttrString(host, "call");
+    Py_DECREF(host);
+    if (_hostCall == NULL || !PyCallable_Check(_hostCall)) {
+        NSString *error = [self pythonErrorWithContext:@"_ayu_host.call"];
+        Py_XDECREF(_hostCall); _hostCall = NULL;
+        PyEval_SaveThread();
+        return error;
+    }
+
+    _started = YES;
+    // A serial GCD queue can hop between OS threads. Release the initialization
+    // GIL and acquire it separately for every subsequent call.
+    PyEval_SaveThread();
+    (void)dataDir;
+    return nil;
+}
+
+- (NSString *)call:(NSString *)requestJSON {
+    if (!_started || _hostCall == NULL) {
+        return @"{\"ok\":false,\"error\":\"not started\"}";
+    }
+    @autoreleasepool {
+        PyGILState_STATE gil = PyGILState_Ensure();
+        PyObject *arg = PyUnicode_FromString([requestJSON UTF8String]);
+        if (arg == NULL) { PyErr_Clear(); PyGILState_Release(gil); return @"{\"ok\":false,\"error\":\"request allocation failed\"}"; }
+        PyObject *result = PyObject_CallFunctionObjArgs(_hostCall, arg, NULL);
+        Py_XDECREF(arg);
+        if (result == NULL) {
+            PyErr_Clear();
+            PyGILState_Release(gil);
+            return @"{\"ok\":false,\"error\":\"python exception in call\"}";
+        }
+        const char *utf8 = PyUnicode_AsUTF8(result);
+        NSString *response = utf8 ? [NSString stringWithUTF8String:utf8] : @"{\"ok\":false,\"error\":\"non-string result\"}";
+        Py_DECREF(result);
+        if (PyErr_Occurred()) { PyErr_Clear(); }
+        PyGILState_Release(gil);
+        return response;
+    }
+}
+
+- (NSString *)pythonErrorWithContext:(NSString *)context {
+    NSString *detail = context;
+    if (PyErr_Occurred()) {
+        PyObject *value = PyErr_GetRaisedException();
+        if (value != NULL) {
+            PyObject *string = PyObject_Str(value);
+            const char *utf8 = string ? PyUnicode_AsUTF8(string) : NULL;
+            if (utf8) { detail = [NSString stringWithFormat:@"%@: %s", context, utf8]; }
+            Py_XDECREF(string);
+            Py_DECREF(value);
+        }
+        PyErr_Clear();
+    }
+    return detail;
+}
+
+@end
+
+#else // AYU_PYTHON_AVAILABLE
+
+@implementation AyuPythonBridgeObjC
+
++ (BOOL)isSupported { return NO; }
+- (BOOL)isStarted { return NO; }
+
+- (nullable NSString *)startWithPythonHome:(NSString *)pythonHome
+                                stdlibPath:(NSString *)stdlibPath
+                               dynloadPath:(NSString *)dynloadPath
+                               runtimePath:(NSString *)runtimePath
+                                   dataDir:(NSString *)dataDir
+                                   handler:(NSString * _Nonnull (^)(NSString *))handler {
+    (void)pythonHome; (void)stdlibPath; (void)dynloadPath; (void)runtimePath; (void)dataDir; (void)handler;
+    return @"Python framework not embedded in this build";
+}
+
+- (NSString *)call:(NSString *)requestJSON {
+    (void)requestJSON;
+    return @"{\"ok\":false,\"error\":\"python unavailable\"}";
+}
+
+@end
+
+#endif // AYU_PYTHON_AVAILABLE
