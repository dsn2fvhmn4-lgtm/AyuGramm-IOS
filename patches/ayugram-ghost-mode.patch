+        if cursor < rows.count, rows[cursor].tokens == self.pattern("def on_send_message_hook(self, account: int, params: Any) -> HookResult:"), !hasTypingImport { throw self.fail(rows[cursor].number, "Typed template requires typing.Any import") }
+        try expectOne(["def on_send_message_hook(self, account, params):", "def on_send_message_hook(self, account: int, params: Any) -> HookResult:"], indent: 4)
+        var predicate: AyuPluginTextCondition?
+        if cursor < rows.count, rows[cursor].tokens.first == .word("if") {
+            predicate = try self.condition(rows[cursor]); cursor += 1
+        }
+        var actions: [AyuPluginAction] = []
+        let bodyIndent = predicate == nil ? 8 : 12
+        while cursor < rows.count, rows[cursor].tokens.first != .word("return") {
+            let row = rows[cursor]
+            guard row.indent == bodyIndent, [14, 16].contains(row.tokens.count),
+                  Array(row.tokens.prefix(10)) == self.pattern("params.message = params.message.replace("),
+                  case let .literal(find) = row.tokens[10], row.tokens[11] == .mark(","),
+                  case let .literal(replacement) = row.tokens[12], row.tokens.last == .mark(")") else { throw self.fail(row.number) }
