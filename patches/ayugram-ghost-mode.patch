+    let arguments = AyuSettingsArguments(open: { _ in
+        push?(ayuMessageHistoryController(context: context, messageId: message.id))
+    }, update: { _, _ in }, record: { _ in })
+    let signal = context.sharedContext.presentationData
+    |> deliverOnMainQueue
+    |> map { presentationData -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        let date = DateFormatter.localizedString(from: Date(timeIntervalSince1970: TimeInterval(message.timestamp)), dateStyle: .medium, timeStyle: .medium)
+        var metadata = "Peer ID: \(message.id.peerId.id._internalGetInt64Value())\nPeer namespace: \(message.id.peerId.namespace)\nMessage ID: \(message.id.id)\nMessage namespace: \(message.id.namespace)\n\(date)"
+        if let author = message.author {
+            metadata += "\nAuthor ID: \(author.id.id._internalGetInt64Value())"
+        }
+        if let threadId = message.threadId {
+            metadata += "\nThread ID: \(threadId)"
+        }
+        let entries: [AyuSettingsEntry] = [.info(0, metadata), .link(1, ru ? "Локальная история этого сообщения" : "Local history for this message")]
+        let data = ItemListPresentationData(presentationData)
+        let state = ItemListControllerState(presentationData: data, title: .text(ru ? "Данные сообщения" : "Message Details"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        return (state, (ItemListNodeState(presentationData: data, entries: entries, style: .blocks, animateChanges: false), arguments))
+    }
+    let controller = ItemListController(context: context, state: signal)
+    push = { [weak controller] in controller?.push($0) }
+    return controller
+}
+
+private func ayuHistoryRecordController(context: AccountContext, recordId: Int32) -> ViewController {
+    var openAttachment: ((String) -> Void)?
+    let signal = combineLatest(context.sharedContext.presentationData, context.engine.messages.ayuMessageHistory())
+    |> deliverOnMainQueue
+    |> map { presentationData, history -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        var entries: [AyuSettingsEntry] = []
+        if let record = history.records.first(where: { $0.id == recordId }) {
+            let date = DateFormatter.localizedString(from: Date(timeIntervalSince1970: TimeInterval(record.capturedAt)), dateStyle: .medium, timeStyle: .medium)
+            entries = [.info(0, "Internal peer ID: \(record.peerId)\nMessage ID: \(record.messageId)\n\(date)"), .richText(record)]
+            if !record.reactionSummary.isEmpty { entries.append(.info(2, record.reactionSummary)) }
+            for (index, attachment) in (record.attachments ?? []).enumerated() {
+                entries.append(.attachment(Int32(index), attachment))
+            }
+        } else {
+            entries = [.info(0, ru ? "Запись удалена или срок хранения истёк." : "This entry was cleared or has expired.")]
+        }
+        let data = ItemListPresentationData(presentationData)
+        let state = ItemListControllerState(presentationData: data, title: .text("AyuGram"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        return (state, (ItemListNodeState(presentationData: data, entries: entries, style: .blocks, animateChanges: false), AyuSettingsArguments(open: { _ in }, update: { _, _ in }, record: { _ in }, context: context, attachment: { openAttachment?($0) })))
+    }
+    let controller = ItemListController(context: context, state: signal)
+    openAttachment = { [weak controller] id in
+        let _ = (context.engine.messages.ayuArchivedAttachmentUrl(id: id)
+        |> take(1)
+        |> deliverOnMainQueue).startStandalone(next: { [weak controller] url in
+            guard let controller else { return }
+            guard let url else {
+                let data = context.sharedContext.currentPresentationData.with { $0 }
+                controller.present(textAlertController(context: context, title: "AyuGram", text: data.strings.baseLanguageCode.hasPrefix("ru") ? "Файл отсутствует в локальном архиве." : "This file is no longer available in the local archive.", actions: [TextAlertAction(type: .defaultAction, title: data.strings.Common_OK, action: {})]), in: .window(.root))
+                return
+            }
+            let activity = UIActivityViewController(activityItems: [url], applicationActivities: nil)
+            activity.popoverPresentationController?.sourceView = controller.view
+            activity.popoverPresentationController?.sourceRect = CGRect(x: controller.view.bounds.midX, y: controller.view.bounds.midY, width: 1.0, height: 1.0)
+            context.sharedContext.applicationBindings.presentNativeController(activity)
+        })
+    }
+    return controller
+}
