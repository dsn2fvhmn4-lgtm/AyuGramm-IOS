+import UIKit
+import Display
+import TelegramCore
+
+public func ayuPresentChatColorPicker(context: AccountContext, peerId: EnginePeer.Id, pluginID: String? = nil) {
+    let store = context.account.network.ayuGhostMode
+    guard let id = pluginID ?? store.current.plugins.chatColorsProviderID,
+          let plugin = store.current.plugins.installed.first(where: { $0.manifest.id == id && $0.manifest.actions.contains(where: { $0.kind == .chatColors }) }) else { return }
+    let data = context.sharedContext.currentPresentationData.with { $0 }
+    let picker = AyuChatColorPickerController(current: plugin.chatColorSettings?.colors[String(peerId.toInt64())], russian: data.strings.baseLanguageCode.hasPrefix("ru"), save: { hex in
+        try store.update { try $0.plugins.setChatColor(id: id, peerKey: String(peerId.toInt64()), hex: hex) }
+    }, openWebsite: { context.sharedContext.applicationBindings.openUrl("https://htmlcolorcodes.com/color-picker/") })
+    let navigation = UINavigationController(rootViewController: picker)
+    navigation.overrideUserInterfaceStyle = data.theme.overallDarkAppearance ? .dark : .light
+    context.sharedContext.applicationBindings.presentNativeController(navigation)
+}
