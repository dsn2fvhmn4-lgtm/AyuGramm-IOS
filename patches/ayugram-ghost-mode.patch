+                guard let self else { return }
+                self.ayuMessageShotInProgress = false
+                let data = self.presentationData
+                let ru = data.strings.baseLanguageCode.hasPrefix("ru")
+                let dark = shot.isDark(fallback: data.theme.overallDarkAppearance)
