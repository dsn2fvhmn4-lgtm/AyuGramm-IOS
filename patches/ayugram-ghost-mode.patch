@@ -0,0 +1,105 @@
+import Foundation
+import UIKit
+import Display
+
+/// 30 pt rounded-square icons matching `renderSettingsIcon`, for AyuGram rows in Settings.
+public enum AyuSettingsIcons {
+    private static let size = CGSize(width: 30.0, height: 30.0)
+    private static let cornerRadius: CGFloat = 8.0
+
+    /// The mod's own full-bleed logo.
+    public static let logo: UIImage? = AyuSettingsIcons.bundleLogo("AyuGram/Brand", fallbackColor: UIColor(rgb: 0x8E5CF7))
+
+    /// exteraGram's logo (white plane on red), for the exteraGram preferences row.
+    public static let exteraLogo: UIImage? = AyuSettingsIcons.bundleLogo("AyuGram/OriginalExtera2", fallbackColor: UIColor(rgb: 0xE83030))
+
+    /// A white glyph from the app bundle on a colored rounded square. Telegram's own settings
+    /// glyphs ("Item List/Icons/…") are drawn at their full 30 pt canvas; the AyuGram ones, 24 pt
+    /// Solar-style artwork, are drawn into a centered square of `side` points.
+    public static func glyph(_ name: String, color: UIColor, side: CGFloat? = nil) -> UIImage? {
+        return generateImage(AyuSettingsIcons.size, rotatedContext: { size, context in
+            let bounds = CGRect(origin: CGPoint(), size: size)
+            context.clear(bounds)
+            context.addPath(UIBezierPath(roundedRect: bounds, cornerRadius: AyuSettingsIcons.cornerRadius).cgPath)
+            context.setFillColor(color.cgColor)
+            context.fillPath()
+            guard let image = UIImage(bundleImageName: name)?.withTintColor(.white, renderingMode: .alwaysOriginal), image.size.width > 0.0, image.size.height > 0.0 else {
+                return
+            }
+            let imageSize = side.map { CGSize(width: $0, height: $0) } ?? image.size
+            UIGraphicsPushContext(context)
+            image.draw(in: CGRect(origin: CGPoint(x: (size.width - imageSize.width) / 2.0, y: (size.height - imageSize.height) / 2.0), size: imageSize))
+            UIGraphicsPopContext()
+        })
+    }
+
+    /// AyuGram's ghost (the Solar ghost from AyuGram for Android) on a colored rounded square.
+    /// With `plus`, the ghost is a little smaller and a "+" badge sits at the bottom right, as
+    /// the Ghost Mode+ icon.
+    public static func ghost(color: UIColor, plus: Bool = false) -> UIImage? {
+        return generateImage(AyuSettingsIcons.size, rotatedContext: { size, context in
+            let bounds = CGRect(origin: CGPoint(), size: size)
+            context.clear(bounds)
+            context.addPath(UIBezierPath(roundedRect: bounds, cornerRadius: AyuSettingsIcons.cornerRadius).cgPath)
+            context.setFillColor(color.cgColor)
+            context.fillPath()
+            guard let image = UIImage(bundleImageName: "AyuGram/Ghost")?.withTintColor(.white, renderingMode: .alwaysOriginal) else {
+                return
+            }
+            let side: CGFloat = plus ? 19.0 : 21.0
+            let inset: CGFloat = plus ? 4.0 : 4.5
+            UIGraphicsPushContext(context)
+            image.draw(in: CGRect(x: inset, y: inset, width: side, height: side))
+            UIGraphicsPopContext()
+            guard plus else {
+                return
+            }
+            // A white badge with a "+" in the square's color, ringed so it stands off the ghost.
+            let center = CGPoint(x: 22.5, y: 22.5)
+            context.setFillColor(color.cgColor)
+            context.fillEllipse(in: CGRect(x: center.x - 6.5, y: center.y - 6.5, width: 13.0, height: 13.0))
+            context.setFillColor(UIColor.white.cgColor)
+            context.fillEllipse(in: CGRect(x: center.x - 5.0, y: center.y - 5.0, width: 10.0, height: 10.0))
+            context.setFillColor(color.cgColor)
+            context.addPath(UIBezierPath(roundedRect: CGRect(x: center.x - 0.9, y: center.y - 2.6, width: 1.8, height: 5.2), cornerRadius: 0.9).cgPath)
+            context.addPath(UIBezierPath(roundedRect: CGRect(x: center.x - 2.6, y: center.y - 0.9, width: 5.2, height: 1.8), cornerRadius: 0.9).cgPath)
+            context.fillPath()
+        })
+    }
+
+    private static func bundleLogo(_ name: String, fallbackColor: UIColor) -> UIImage? {
+        return generateImage(AyuSettingsIcons.size, rotatedContext: { size, context in
+            let bounds = CGRect(origin: CGPoint(), size: size)
+            context.clear(bounds)
+            context.addPath(UIBezierPath(roundedRect: bounds, cornerRadius: AyuSettingsIcons.cornerRadius).cgPath)
+            context.clip()
+            if let image = UIImage(bundleImageName: name) {
+                UIGraphicsPushContext(context)
+                image.draw(in: bounds)
+                UIGraphicsPopContext()
+            } else {
+                context.setFillColor(fallbackColor.cgColor)
+                context.fill(bounds)
+            }
+        })
+    }
+
+    /// A white SF Symbol on a colored rounded square.
+    public static func symbol(_ name: String, color: UIColor) -> UIImage? {
+        return generateImage(AyuSettingsIcons.size, rotatedContext: { size, context in
+            let bounds = CGRect(origin: CGPoint(), size: size)
+            context.clear(bounds)
+            context.addPath(UIBezierPath(roundedRect: bounds, cornerRadius: AyuSettingsIcons.cornerRadius).cgPath)
+            context.setFillColor(color.cgColor)
+            context.fillPath()
+            guard let image = UIImage(systemName: name, withConfiguration: UIImage.SymbolConfiguration(pointSize: 15.0, weight: .semibold))?.withTintColor(.white, renderingMode: .alwaysOriginal), image.size.width > 0.0, image.size.height > 0.0 else {
+                return
+            }
+            let scale = min(18.0 / image.size.width, 18.0 / image.size.height, 1.0)
+            let imageSize = CGSize(width: image.size.width * scale, height: image.size.height * scale)
+            UIGraphicsPushContext(context)
+            image.draw(in: CGRect(origin: CGPoint(x: (size.width - imageSize.width) / 2.0, y: (size.height - imageSize.height) / 2.0), size: imageSize))
+            UIGraphicsPopContext()
+        })
+    }
+}
