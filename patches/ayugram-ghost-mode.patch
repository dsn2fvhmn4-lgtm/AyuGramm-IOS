+    private func searchWithAuthor(_ queries: [String], options: AyuAdvancedSearchOptions, command: (String, AyuPluginAction, String)) {
+        switch options.author {
+        case .any: self.search(queries, command: command, options: options)
+        case let .user(id): self.searchWithCachedAuthor(queries, options: options, command: command, authorId: EnginePeer.Id(namespace: Namespaces.Peer.CloudUser, id: EnginePeer.Id.Id._internalFromInt64Value(id)))
+        case let .username(name):
+            self.generation += 1
+            let generation = self.generation
+            self.messages = []; self.status = self.russian ? "Поиск автора…" : "Resolving author…"; self.tableView.reloadData()
+            let resolverSlot = MetaDisposable(); self.request.set(resolverSlot)
+            resolverSlot.set((self.context.engine.peers.resolvePeerByName(name: name, referrer: nil)
+            |> mapToSignal { result -> Signal<EnginePeer?, NoError> in
+                if case let .result(peer) = result { return .single(peer) }
+                return .complete()
+            }
+            |> take(1)
+            |> timeout(15.0, queue: Queue.mainQueue(), alternate: .single(nil))
+            |> deliverOnMainQueue).start(next: { [weak self] peer in
+                guard let self, self.generation == generation, self.available(command) else { return }
+                guard let peer else { self.status = self.russian ? "Автор не найден или время ожидания истекло. Поиск без автора автоматически не запускается." : "Author not found or request timed out. An unfiltered search was not started."; self.tableView.reloadData(); return }
+                self.searchWithCachedAuthor(queries, options: options, command: command, authorId: peer.id)
+            }))
+        }
+    }
+    private func searchWithCachedAuthor(_ queries: [String], options: AyuAdvancedSearchOptions, command: (String, AyuPluginAction, String), authorId: EnginePeer.Id) {
+        self.generation += 1
+        let generation = self.generation
+        self.messages = []; self.status = self.russian ? "Проверка автора…" : "Checking author…"; self.tableView.reloadData()
+        let authorSlot = MetaDisposable(); self.request.set(authorSlot)
+        authorSlot.set((self.context.engine.data.get(TelegramEngine.EngineData.Item.Peer.Peer(id: authorId))
+        |> take(1)
+        |> deliverOnMainQueue).start(next: { [weak self] peer in
+            guard let self, self.generation == generation, self.available(command) else { return }
+            guard let peer, ayuCanUseSearchAuthor(peer: peer) else {
+                self.status = self.russian ? "Автор недоступен по этому ID. Укажи @username или сначала открой его профиль в Telegram. Поиск без фильтра не выполнялся." : "Author is not available by this ID. Use @username or open their Telegram profile first. No unfiltered search was performed."
+                self.tableView.reloadData(); return
+            }
+            self.search(queries, command: command, options: options, authorId: peer.id)
+        }))
+    }
+    private func search(_ queries: [String], command: (String, AyuPluginAction, String), options: AyuAdvancedSearchOptions? = nil, authorId: EnginePeer.Id? = nil) {
+        self.generation += 1
+        let generation = self.generation
+        self.messages = []
+        self.status = self.russian ? "Поиск…" : "Searching…"
+        self.tableView.reloadData()
+        let tags: EngineMessage.Tags?
+        switch options?.media ?? .all {
+        case .all: tags = nil
+        case .photos: tags = .photo
+        case .videos: tags = .video
+        case .files: tags = .file
+        case .music: tags = .music
+        case .voice: tags = .voiceOrInstantVideo
+        case .gif: tags = .gif
+        }
+        let signals: [Signal<[EngineMessage], NoError>] = queries.map { query in
+            return self.context.engine.messages.searchMessages(location: .peer(peerId: self.peerId, fromId: authorId, tags: tags, reactions: nil, threadId: self.threadId, minDate: options?.minimumDate, maxDate: options?.maximumDate), query: query, state: nil, limit: 40)
+            |> take(1)
+            |> map { result in result.0.messages.map { EngineMessage($0) } }
+        }
+        self.request.set((combineLatest(signals)
+        |> map { Optional($0) }
+        |> timeout(15.0, queue: Queue.mainQueue(), alternate: .single(nil))
+        |> deliverOnMainQueue).start(next: { [weak self] batches in
+            guard let self, self.generation == generation else { return }
+            guard self.available(command) else { self.messages = []; self.status = self.russian ? "Плагин выключен или изменён." : "Plugin disabled or changed."; self.tableView.reloadData(); return }
+            guard let batches else { self.status = self.russian ? "Время ожидания истекло. Попробуй снова." : "Search timed out. Try again."; self.tableView.reloadData(); return }
+            var unique: [EngineMessage.Id: EngineMessage] = [:]
+            for message in batches.flatMap({ $0 }) where message.id.peerId == self.peerId {
+                if let authorId, message.author?.id != authorId { continue }
+                if let minimum = options?.minimumDate, message.timestamp < minimum { continue }
+                if let maximum = options?.maximumDate, message.timestamp > maximum { continue }
+                unique[message.id] = message
+            }
+            self.messages = unique.values.sorted { $0.timestamp == $1.timestamp ? $0.id.id > $1.id.id : $0.timestamp > $1.timestamp }
+            self.status = (self.russian ? "Результатов: " : "Results: ") + String(self.messages.count) + (self.russian ? ". До 40 на фразу; это не вся история." : ". Up to 40 per phrase; this is not the entire history.")
+            self.tableView.reloadData()
+        }))
+    }
+}
