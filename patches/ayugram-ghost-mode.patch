+private func ayuMessageHistoryController(context: AccountContext, messageId: EngineMessage.Id? = nil) -> ViewController {
+    var push: ((ViewController) -> Void)?
+    var present: ((ViewController) -> Void)?
+    let arguments = AyuSettingsArguments(open: { id in
+        guard id == 10 else { return }
+        let data = context.sharedContext.currentPresentationData.with { $0 }
+        let ru = data.strings.baseLanguageCode.hasPrefix("ru")
+        present?(textAlertController(context: context, title: "AyuGram", text: ru ? "Очистить весь локальный архив этого аккаунта?" : "Clear the entire local archive for this account?", actions: [
+            TextAlertAction(type: .genericAction, title: data.strings.Common_Cancel, action: {}),
+            TextAlertAction(type: .destructiveAction, title: data.strings.Common_OK, action: {
+                let _ = context.engine.messages.updateAyuMessageHistory(clear: true).startStandalone()
+            })
+        ]))
+    }, update: { id, value in
+        let _ = context.engine.messages.updateAyuMessageHistory(saveEdits: id == 0 ? value : nil, saveDeleted: id == 1 ? value : nil, saveFormatting: id == 2 ? value : nil, saveReactions: id == 3 ? value : nil, saveForBots: id == 4 ? value : nil, saveMedia: id == 5 ? value : nil, mediaPrivateChats: id == 6 ? value : nil, mediaPublicChannels: id == 7 ? value : nil, mediaPrivateChannels: id == 8 ? value : nil, mediaPublicGroups: id == 9 ? value : nil, mediaPrivateGroups: id == 10 ? value : nil).startStandalone()
+    }, record: { id in
+        push?(ayuHistoryRecordController(context: context, recordId: id))
+    })
+    let signal = combineLatest(context.sharedContext.presentationData, context.engine.messages.ayuMessageHistory())
+    |> deliverOnMainQueue
+    |> map { presentationData, history -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        var entries: [AyuSettingsEntry] = [
