@@ -0,0 +1,14 @@
+import UIKit
+
+public func ayuPluginAvatar(size: CGFloat = 44) -> UIImage {
+    let side = min(96, max(24, size))
+    return UIGraphicsImageRenderer(size: CGSize(width: side, height: side)).image { renderer in
+        UIColor(red: 0.24, green: 0.60, blue: 0.80, alpha: 1).setFill()
+        renderer.cgContext.fillEllipse(in: CGRect(x: 0, y: 0, width: side, height: side))
+        if let icon = UIImage(systemName: "puzzlepiece.fill", withConfiguration: UIImage.SymbolConfiguration(pointSize: side * 0.55, weight: .medium))?.withTintColor(.white, renderingMode: .alwaysOriginal), icon.size.width > 0, icon.size.height > 0 {
+            let scale = min(side * 0.56 / icon.size.width, side * 0.56 / icon.size.height)
+            let width = icon.size.width * scale, height = icon.size.height * scale
+            icon.draw(in: CGRect(x: (side - width) / 2, y: (side - height) / 2, width: width, height: height))
+        }
+    }
+}
