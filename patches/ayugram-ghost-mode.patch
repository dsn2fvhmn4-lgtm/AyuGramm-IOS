+            guard let self else { return }
+            let begin: () -> Void = { [weak self] in self?.apply(manifest, expected: expected) }
+            if let presented = self.presentedViewController { presented.dismiss(animated: true, completion: begin) }
+            else { begin() }
+        }))
+        alert.addAction(UIAlertAction(title: self.russian ? "Отмена" : "Cancel", style: .cancel))
+        self.present(alert, animated: true)
+    }
+    private func apply(_ manifest: AyuPluginManifest, expected: AyuInstalledPlugin?) {
+        guard !self.applying else { return }
+        self.applying = true
+        self.updateCatalogControls()
+        let progress = UIActivityIndicatorView(style: .medium); progress.startAnimating()
+        self.navigationItem.leftBarButtonItem = UIBarButtonItem(customView: progress)
+        self.isModalInPresentation = true
+        self.navigationController?.isModalInPresentation = true
+        DispatchQueue.global(qos: .userInitiated).async { [weak self] in
+            let result = Result { try AyuPluginActivation.prepare(manifest) }
+            DispatchQueue.main.async { [weak self] in
+                guard let self else { return }
+                self.applying = false
+                self.updateCatalogControls()
+                self.navigationItem.leftBarButtonItem = UIBarButtonItem(barButtonSystemItem: .done, target: self, action: #selector(self.done))
+                self.isModalInPresentation = false
+                self.navigationController?.isModalInPresentation = false
+                do {
+                    let prepared = try result.get()
+                    try self.store.update {
+                        guard $0.plugins.installed.first(where: { $0.manifest.id == prepared.id }) == expected else { throw AyuPluginError.invalidManifest }
+                        try $0.plugins.installAndActivate(prepared)
+                    }
+                    self.reload()
+                    self.navigationController?.pushViewController(AyuPluginDetailsController(store: self.store, pluginID: prepared.id, russian: self.russian, palette: self.palette, settingsController: self.settingsController, keepAwake: self.keepAwake), animated: true)
+                } catch { self.error(error) }
+            }
+        }
+    }
+}
