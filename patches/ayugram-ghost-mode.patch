@@ -0,0 +1,112 @@
+import Foundation
+import UIKit
+import ImageIO
+
+final class AyuMessageShotPreview: UIViewController, UIScrollViewDelegate {
+    private let image: UIImage
+    private let scroll = UIScrollView()
+    private let imageView = UIImageView()
+    private var lastWidth: CGFloat = 0.0
+    var share: ((UIViewController) -> Void)?
+
+    init(image: UIImage) {
+        self.image = image
+        super.init(nibName: nil, bundle: nil)
+        self.title = "MessageShot"
+    }
+
+    required init?(coder: NSCoder) { return nil }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        self.view.backgroundColor = .systemBackground
+        self.scroll.delegate = self
+        self.scroll.minimumZoomScale = 1.0
+        self.scroll.maximumZoomScale = 3.0
+        self.imageView.image = self.image
+        self.imageView.contentMode = .scaleAspectFit
+        self.scroll.addSubview(self.imageView)
+        self.view.addSubview(self.scroll)
+        self.navigationItem.leftBarButtonItem = UIBarButtonItem(barButtonSystemItem: .done, target: self, action: #selector(self.closePressed))
+        self.navigationItem.rightBarButtonItem = UIBarButtonItem(barButtonSystemItem: .action, target: self, action: #selector(self.sharePressed))
+    }
+
+    override func viewDidLayoutSubviews() {
+        super.viewDidLayoutSubviews()
+        self.scroll.frame = self.view.bounds.inset(by: self.view.safeAreaInsets)
+        let width = self.scroll.bounds.width
+        if width > 0.0, width != self.lastWidth {
+            self.lastWidth = width
+            self.scroll.zoomScale = 1.0
+            self.imageView.frame = CGRect(x: 0.0, y: 0.0, width: width, height: width * self.image.size.height / self.image.size.width)
+            self.scroll.contentSize = self.imageView.bounds.size
+        }
+    }
+
+    func viewForZooming(in scrollView: UIScrollView) -> UIView? { return self.imageView }
+    @objc private func closePressed() { self.dismiss(animated: true) }
+    @objc private func sharePressed() { self.share?(self) }
+}
+
+struct AyuMessageShotCard {
+    let author: String
+    let date: String
+    let text: NSAttributedString
+    let photo: UIImage?
+    let outgoing: Bool
+}
+
+func ayuRenderMessageShot(cards: [AyuMessageShotCard], dark: Bool, width: CGFloat, maximumHeight: CGFloat) -> UIImage? {
+    guard !cards.isEmpty, width.isFinite, maximumHeight.isFinite, width > 112.0, maximumHeight >= 200.0 else { return nil }
+    let cardWidth = width - 112.0
+    let innerWidth = cardWidth - 40.0
+    var layouts: [(CGRect, CGRect, CGRect?)] = []
+    var y: CGFloat = 90.0
+    for card in cards {
+        let measured = card.text.boundingRect(with: CGSize(width: innerWidth, height: maximumHeight), options: [.usesLineFragmentOrigin, .usesFontLeading], context: nil)
+        guard measured.height.isFinite else { return nil }
+        let textHeight = max(ceil(measured.height), 32.0)
+        let x: CGFloat = card.outgoing ? 88.0 : 24.0
+        let textFrame = CGRect(x: x + 20.0, y: y + 62.0, width: innerWidth, height: textHeight)
+        var photoFrame: CGRect?
+        var bottom = textFrame.maxY
+        if let photo = card.photo, photo.size.width > 0.0, photo.size.height > 0.0 {
+            let scale = min(innerWidth / photo.size.width, 360.0 / photo.size.height)
+            let frame = CGRect(x: x + 20.0, y: bottom + 14.0, width: photo.size.width * scale, height: photo.size.height * scale)
+            photoFrame = frame
+            bottom = frame.maxY
+        }
+        let frame = CGRect(x: x, y: y, width: cardWidth, height: bottom - y + 54.0)
+        layouts.append((frame, textFrame, photoFrame))
+        y = frame.maxY + 20.0
+        if y + 44.0 > maximumHeight { return nil }
+    }
+    let format = UIGraphicsImageRendererFormat()
+    format.scale = 1.0
+    format.opaque = true
+    let background = dark ? UIColor(red: 0.09, green: 0.08, blue: 0.13, alpha: 1.0) : UIColor(red: 0.94, green: 0.93, blue: 0.98, alpha: 1.0)
+    let secondary = dark ? UIColor(white: 0.70, alpha: 1.0) : UIColor(white: 0.40, alpha: 1.0)
+    return UIGraphicsImageRenderer(size: CGSize(width: width, height: ceil(y + 44.0)), format: format).image { _ in
+        background.setFill()
+        UIBezierPath(rect: CGRect(x: 0.0, y: 0.0, width: width, height: ceil(y + 44.0))).fill()
+        ("AyuGram · MessageShot" as NSString).draw(at: CGPoint(x: 28.0, y: 28.0), withAttributes: [.font: UIFont.systemFont(ofSize: 30.0, weight: .semibold), .foregroundColor: secondary])
+        for (index, card) in cards.enumerated() {
+            let (frame, textFrame, photoFrame) = layouts[index]
+            let fill = dark ? UIColor(white: card.outgoing ? 0.23 : 0.16, alpha: 1.0) : (card.outgoing ? UIColor(red: 0.88, green: 0.84, blue: 0.98, alpha: 1.0) : .white)
+            fill.setFill()
+            UIBezierPath(roundedRect: frame, cornerRadius: 24.0).fill()
+            (card.author as NSString).draw(in: CGRect(x: frame.minX + 20.0, y: frame.minY + 16.0, width: innerWidth, height: 36.0), withAttributes: [.font: UIFont.systemFont(ofSize: 27.0, weight: .semibold), .foregroundColor: dark ? UIColor(red: 0.78, green: 0.69, blue: 1.0, alpha: 1.0) : UIColor(red: 0.36, green: 0.22, blue: 0.63, alpha: 1.0)])
+            card.text.draw(with: textFrame, options: [.usesLineFragmentOrigin, .usesFontLeading], context: nil)
+            if let photoFrame, let photo = card.photo { photo.draw(in: photoFrame) }
+            (card.date as NSString).draw(in: CGRect(x: frame.minX + 20.0, y: frame.maxY - 36.0, width: innerWidth, height: 30.0), withAttributes: [.font: UIFont.systemFont(ofSize: 21.0), .foregroundColor: secondary])
+        }
+    }
+}
+
+func ayuMessageShotThumbnailImage(path: String) -> UIImage? {
+    return autoreleasepool {
+        guard let source = CGImageSourceCreateWithURL(URL(fileURLWithPath: path) as CFURL, [kCGImageSourceShouldCache: false] as CFDictionary),
+              let image = CGImageSourceCreateThumbnailAtIndex(source, 0, [kCGImageSourceCreateThumbnailFromImageAlways: true, kCGImageSourceCreateThumbnailWithTransform: true, kCGImageSourceThumbnailMaxPixelSize: 512, kCGImageSourceShouldCacheImmediately: true] as CFDictionary) else { return nil }
+        return UIImage(cgImage: image)
+    }
+}
