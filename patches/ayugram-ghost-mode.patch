@@ -0,0 +1,46 @@
+import Foundation
+
+public struct AyuAdvancedSettings: Codable, Equatable {
+    public enum TranslationProvider: String, Codable, CaseIterable { case telegram, libreTranslate, deepLFree, deepLPro }
+    public var scheduleOutgoing = false
+    public var markReadAfterSend = false
+    public var scheduleDelay: Int32 = 30
+    public var translationProvider: TranslationProvider = .telegram
+    public var translationTarget = "ru"
+    public var libreTranslateURL = ""
+    public var localEmojiStatusEnabled = false
+    public var localEmojiFileId: Int64?
+    public var animateLocalEmoji = true
+    public var localPremium = false
+    public init() {}
+    private enum CodingKeys: String, CodingKey { case scheduleOutgoing, markReadAfterSend, scheduleDelay, translationProvider, translationTarget, libreTranslateURL, localEmojiStatusEnabled, localEmojiFileId, animateLocalEmoji, localPremium }
+    public init(from decoder: Decoder) throws {
+        let c = try decoder.container(keyedBy: CodingKeys.self)
+        self.scheduleOutgoing = try c.decodeIfPresent(Bool.self, forKey: .scheduleOutgoing) ?? false
+        self.markReadAfterSend = try c.decodeIfPresent(Bool.self, forKey: .markReadAfterSend) ?? false
+        self.scheduleDelay = try c.decodeIfPresent(Int32.self, forKey: .scheduleDelay) ?? 30
+        self.translationProvider = try c.decodeIfPresent(TranslationProvider.self, forKey: .translationProvider) ?? .telegram
+        self.translationTarget = try c.decodeIfPresent(String.self, forKey: .translationTarget) ?? "ru"
+        self.libreTranslateURL = try c.decodeIfPresent(String.self, forKey: .libreTranslateURL) ?? ""
+        self.localEmojiStatusEnabled = try c.decodeIfPresent(Bool.self, forKey: .localEmojiStatusEnabled) ?? false
+        self.localEmojiFileId = try c.decodeIfPresent(Int64.self, forKey: .localEmojiFileId)
+        self.animateLocalEmoji = try c.decodeIfPresent(Bool.self, forKey: .animateLocalEmoji) ?? true
+        self.localPremium = try c.decodeIfPresent(Bool.self, forKey: .localPremium) ?? false
+        try self.validate()
+    }
+    public mutating func setScheduling(_ value: Bool) { self.scheduleOutgoing = value; if value { self.markReadAfterSend = false } }
+    public mutating func setReadAfterSend(_ value: Bool) { self.markReadAfterSend = value; if value { self.scheduleOutgoing = false } }
+    public func validate() throws {
+        guard !(self.scheduleOutgoing && self.markReadAfterSend), (10...3600).contains(self.scheduleDelay),
+              (2...16).contains(self.translationTarget.utf8.count), self.translationTarget.unicodeScalars.allSatisfy({ (65...90).contains($0.value) || (97...122).contains($0.value) || $0 == "-" }),
+              self.libreTranslateURL.utf8.count <= 2048, self.localEmojiFileId.map({ $0 > 0 }) ?? true else { throw AyuPluginError.invalidInput }
+        if !self.libreTranslateURL.isEmpty {
+            guard let url = URL(string: self.libreTranslateURL), url.scheme == "https", let host = url.host, !host.isEmpty, url.user == nil, url.password == nil, url.query == nil, url.fragment == nil else { throw AyuPluginError.invalidInput }
+        }
+    }
+    public var localStatusFileId: Int64? { return self.localEmojiStatusEnabled ? self.localEmojiFileId : nil }
+    public func scheduledTimestamp(now: Int32) -> Int32? {
+        guard self.scheduleOutgoing, (10...3600).contains(self.scheduleDelay), now >= 0, now <= Int32.max - self.scheduleDelay else { return nil }
+        return now + self.scheduleDelay
+    }
+}
diff --git a/submodules/TelegramCore/Sources/AyuGram/AyuAfterSendRead.swift b/submodules/TelegramCore/Sources/AyuGram/AyuAfterSendRead.swift
new file mode 100644
index 00000000..a58e7364
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuGram/AyuAfterSendRead.swift
@@ -0,0 +1,35 @@
+import Foundation
+import Postbox
+import SwiftSignalKit
+internal import TelegramApi
+
+/// Explicit opt-in receipt after accepted ordinary cloud sends. Never changes failed/queued sends.
+func ayuMarkReadAfterSending(postbox: Postbox, network: Network, stateManager: AccountStateManager, messages: [Message]) {
+    guard network.ayuGhostMode.current.advanced.markReadAfterSend, let first = messages.first,
+          first.id.peerId.namespace != Namespaces.Peer.SecretChat,
+          messages.allSatisfy({ $0.id.peerId == first.id.peerId && $0.threadId == nil && !$0.attributes.contains(where: { $0 is OutgoingScheduleInfoMessageAttribute }) }) else { return }
+    let peerId = first.id.peerId
+    let _ = (postbox.transaction { transaction -> (Peer, MessageIndex)? in
+        guard let peer = transaction.getPeer(peerId), !peer.isForumOrMonoForum, peerKeepsReadState(peer),
+              let index = transaction.getTopPeerMessageIndex(peerId: peerId, namespace: Namespaces.Message.Cloud) else { return nil }
+        return (peer, index)
+    } |> mapToSignal { value -> Signal<Void, NoError> in
+        guard let (peer, index) = value, network.ayuGhostMode.current.advanced.markReadAfterSend, let input = apiInputPeer(peer) else { return .complete() }
+        let receipt: Signal<Bool, NoError>
+        if let channel = apiInputChannel(peer) {
+            receipt = network.request(Api.functions.channels.readHistory(channel: channel, maxId: index.id.id), automaticFloodWait: false)
+            |> map { _ in true } |> `catch` { _ in .single(false) }
+        } else {
+            receipt = network.request(Api.functions.messages.readHistory(peer: input, maxId: index.id.id), automaticFloodWait: false)
+            |> map { result -> Bool in
+                switch result { case let .affectedMessages(data): stateManager.addUpdateGroups([.updatePts(pts: data.pts, ptsCount: data.ptsCount)]) }
+                return true
+            } |> `catch` { _ in .single(false) }
+        }
+        return receipt |> mapToSignal { accepted -> Signal<Void, NoError> in
+            guard accepted else { return .complete() }
+            network.ayuReassertOfflineAfterSending()
+            return _internal_applyMaxReadIndexInteractively(postbox: postbox, stateManager: stateManager, index: index)
+        }
+    }).startStandalone()
+}
