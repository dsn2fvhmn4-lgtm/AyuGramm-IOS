+private struct AyuSectionedArguments {
+    let open: (Int32) -> Void
+    let toggle: (Int32, Bool) -> Void
+}
+
+/// Rows of an exteraGram-style page: headed sections of rows with icons. Stable ids must
+/// ascend in display order (ItemListController requirement).
+private enum AyuSectionedEntry: ItemListNodeEntry {
+    case logo(Int32, Int32, AyuSettingsHeaderItem.Logo, String, String)
+    case header(Int32, Int32, String)
+    case link(Int32, Int32, UIImage?, String, String)
+    case toggle(Int32, Int32, UIImage?, String, String?, Bool)
+    case info(Int32, Int32, String)
+
+    var section: ItemListSectionId {
+        switch self {
+        case let .logo(section, _, _, _, _), let .header(section, _, _), let .link(section, _, _, _, _), let .toggle(section, _, _, _, _, _), let .info(section, _, _):
+            return section
+        }
+    }
+
+    var stableId: Int32 {
+        switch self {
+        case let .logo(_, id, _, _, _), let .header(_, id, _), let .link(_, id, _, _, _), let .toggle(_, id, _, _, _, _), let .info(_, id, _):
+            return id
+        }
+    }
+
+    static func < (lhs: AyuSectionedEntry, rhs: AyuSectionedEntry) -> Bool { return lhs.stableId < rhs.stableId }
+
+    static func == (lhs: AyuSectionedEntry, rhs: AyuSectionedEntry) -> Bool {
+        switch (lhs, rhs) {
+        case let (.logo(ls, li, ll, lt, lx), .logo(rs, ri, rl, rt, rx)): return ls == rs && li == ri && ll == rl && lt == rt && lx == rx
+        case let (.header(ls, li, lt), .header(rs, ri, rt)): return ls == rs && li == ri && lt == rt
+        case let (.link(ls, li, _, lt, ll), .link(rs, ri, _, rt, rl)): return ls == rs && li == ri && lt == rt && ll == rl
+        case let (.toggle(ls, li, _, lt, lx, lv), .toggle(rs, ri, _, rt, rx, rv)): return ls == rs && li == ri && lt == rt && lx == rx && lv == rv
+        case let (.info(ls, li, lt), .info(rs, ri, rt)): return ls == rs && li == ri && lt == rt
+        default: return false
+        }
+    }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! AyuSectionedArguments
+        switch self {
+        case let .logo(_, _, logo, title, text):
+            return AyuSettingsHeaderItem(theme: presentationData.theme, logo: logo, title: title, text: text, sectionId: self.section)
+        case let .header(_, _, text):
+            return ItemListSectionHeaderItem(presentationData: presentationData, text: text, sectionId: self.section)
+        case let .link(_, id, icon, title, label):
+            return ItemListDisclosureItem(presentationData: presentationData, systemStyle: .glass, icon: icon, title: title, label: label, sectionId: self.section, style: .blocks, action: { arguments.open(id) })
+        case let .toggle(_, id, icon, title, text, value):
+            return ItemListSwitchItem(presentationData: presentationData, systemStyle: .glass, icon: icon, title: title, text: text, value: value, sectionId: self.section, style: .blocks, updated: { arguments.toggle(id, $0) })
+        case let .info(_, _, text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        }
+    }
+}
