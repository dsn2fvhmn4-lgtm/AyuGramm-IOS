+private final class AyuPluginCatalogDownload: NSObject, URLSessionDataDelegate, @unchecked Sendable {
+    private let completion: (Result<Data, Error>) -> Void
+    private var session: URLSession?
+    private var data = Data()
+    private var failure: Error?
+    private var finished = false
+    init(completion: @escaping (Result<Data, Error>) -> Void) { self.completion = completion; super.init() }
+    func start() {
+        let configuration = URLSessionConfiguration.ephemeral
+        configuration.timeoutIntervalForRequest = 30
+        configuration.timeoutIntervalForResource = 45
+        configuration.httpShouldSetCookies = false
+        configuration.httpCookieStorage = nil
+        configuration.urlCredentialStorage = nil
+        configuration.urlCache = nil
+        let queue = OperationQueue(); queue.maxConcurrentOperationCount = 1
+        let session = URLSession(configuration: configuration, delegate: self, delegateQueue: queue)
+        self.session = session
+        var components = URLComponents(url: AyuPluginCatalogConfiguration.url, resolvingAgainstBaseURL: false)!
+        components.queryItems = [URLQueryItem(name: "revisionCheck", value: UUID().uuidString)]
+        var request = URLRequest(url: components.url!, cachePolicy: .reloadIgnoringLocalCacheData)
+        request.setValue("no-cache", forHTTPHeaderField: "Cache-Control")
+        session.dataTask(with: request).resume()
+    }
+    func urlSession(_ session: URLSession, task: URLSessionTask, willPerformHTTPRedirection response: HTTPURLResponse, newRequest request: URLRequest, completionHandler: @escaping (URLRequest?) -> Void) {
+        self.failure = AyuPluginCatalogError.http(response.statusCode)
+        completionHandler(nil)
+    }
+    func urlSession(_ session: URLSession, dataTask: URLSessionDataTask, didReceive response: URLResponse, completionHandler: @escaping (URLSession.ResponseDisposition) -> Void) {
+        guard let response = response as? HTTPURLResponse, response.statusCode == 200 else {
+            self.failure = AyuPluginCatalogError.http((response as? HTTPURLResponse)?.statusCode ?? 0)
+            completionHandler(.cancel); return
+        }
+        if response.expectedContentLength > Int64(AyuPluginCatalogConfiguration.maximumResponseBytes) {
+            self.failure = AyuPluginCatalogError.tooLarge
+            completionHandler(.cancel); return
+        }
+        completionHandler(.allow)
+    }
+    func urlSession(_ session: URLSession, dataTask: URLSessionDataTask, didReceive data: Data) {
+        guard self.data.count + data.count <= AyuPluginCatalogConfiguration.maximumResponseBytes else {
+            self.failure = AyuPluginCatalogError.tooLarge
+            dataTask.cancel(); return
+        }
+        self.data.append(data)
+    }
+    func urlSession(_ session: URLSession, task: URLSessionTask, didCompleteWithError error: Error?) {
+        guard !self.finished else { return }
+        self.finished = true
+        session.finishTasksAndInvalidate()
+        if let failure = self.failure { self.completion(.failure(failure)) }
+        else if error != nil { self.completion(.failure(AyuPluginCatalogError.network)) }
+        else { self.completion(.success(self.data)) }
+        self.session = nil
+    }
+}
