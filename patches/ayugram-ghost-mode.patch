index 00000000..fe76d17d
--- /dev/null
+++ b/submodules/TelegramUI/Sources/Chat/ChatControllerAyuPlugins.swift
@@ -0,0 +1,305 @@
+import Foundation
+import UIKit
+import AvatarNode
+import Display
+import SwiftSignalKit
+import TelegramCore
+import AccountContext
+import ChatControllerInteraction
+import ChatPresentationInterfaceState
+
+private final class AyuPluginRunnerController: UITableViewController {
+    private let context: AccountContext
+    private let peerId: EnginePeer.Id
+    private let threadId: Int64?
+    private let jump: (EngineMessage.Id) -> Void
+    private let draft: (String) -> Void
+    private let petpet: () -> Void
+    private let russian: Bool
+    private let request = MetaDisposable()
+    private var commands: [(String, AyuPluginAction, String)] = []
+    private var messages: [EngineMessage] = []
+    private var status: String
+    private var generation = 0
+    init(context: AccountContext, peerId: EnginePeer.Id, threadId: Int64?, russian: Bool, jump: @escaping (EngineMessage.Id) -> Void, draft: @escaping (String) -> Void, petpet: @escaping () -> Void) {
+        self.context = context; self.peerId = peerId; self.threadId = threadId; self.russian = russian
+        self.jump = jump; self.draft = draft; self.petpet = petpet
+        self.status = russian ? "Выбери действие плагина. Поиск: до 40 результатов на фразу." : "Choose a plugin action. Search: up to 40 results per phrase."
+        super.init(style: .insetGrouped)
+        self.title = russian ? "Плагины" : "Plugins"
+        for plugin in context.account.network.ayuGhostMode.current.plugins.installed where plugin.enabled {
+            for action in plugin.manifest.actions where action.kind == .search || action.kind == .searchTerms || action.kind == .replaceText || action.kind == .chatColors || action.kind == .arcadeGame || action.kind == .petpet { self.commands.append((plugin.manifest.id, action, plugin.manifest.name)) }
+        }
+        if self.commands.isEmpty { self.status = russian ? "Здесь нет ручных действий. Автоматические функции включённых плагинов работают в соответствующих разделах приложения." : "There are no manual actions here. Enabled plugins run automatic features in their corresponding app screens." }
+    }
+    required init?(coder: NSCoder) { return nil }
+    deinit { self.request.dispose() }
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        self.navigationItem.rightBarButtonItem = UIBarButtonItem(barButtonSystemItem: .done, target: self, action: #selector(self.done))
+        self.tableView.rowHeight = UITableView.automaticDimension
+        self.tableView.estimatedRowHeight = 64
+    }
+    @objc private func done() { self.generation += 1; self.request.set(nil); self.dismiss(animated: true) }
+    override func numberOfSections(in tableView: UITableView) -> Int { return 2 }
+    override func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int { return section == 0 ? self.commands.count : self.messages.count }
+    override func tableView(_ tableView: UITableView, titleForFooterInSection section: Int) -> String? {
+        return section == 0 ? self.status : nil
+    }
+    override func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
+        let cell = UITableViewCell(style: .subtitle, reuseIdentifier: nil)
+        cell.textLabel?.numberOfLines = 0; cell.detailTextLabel?.numberOfLines = 0
+        if indexPath.section == 0 {
+            let command = self.commands[indexPath.row]
+            cell.imageView?.image = ayuPluginAvatar()
+            cell.textLabel?.text = command.1.title
+            cell.detailTextLabel?.text = command.2
+        } else {
+            let message = self.messages[indexPath.row]
+            // Do not flatten spoiler/protected text into an unformatted plugin preview.
+            cell.textLabel?.text = (self.russian ? "Сообщение №" : "Message #") + String(message.id.id)
+            cell.detailTextLabel?.text = DateFormatter.localizedString(from: Date(timeIntervalSince1970: Double(message.timestamp)), dateStyle: .medium, timeStyle: .short)
