+import Foundation
+
+public struct AyuAdvancedSearchOptions: Equatable {
+    public enum Media: String, CaseIterable { case all, photos, videos, files, music, voice, gif }
+    public enum Author: Equatable { case any, user(Int64), username(String) }
+    public let author: Author
+    public let minimumDate: Int32?
+    public let maximumDate: Int32?
+    public let media: Media
+    public init(author: String, from: String, until: String, media: Media, timeZone: TimeZone = .current) throws {
+        let value = author.trimmingCharacters(in: .whitespacesAndNewlines)
+        if value.isEmpty { self.author = .any }
+        else if let id = Int64(value), id > 0, id <= 0x00ffffffffffffff { self.author = .user(id) }
+        else {
+            let name = value.hasPrefix("@") ? String(value.dropFirst()) : value
+            guard (4...32).contains(name.utf8.count), name.unicodeScalars.allSatisfy({ (65...90).contains($0.value) || (97...122).contains($0.value) || (48...57).contains($0.value) || $0 == "_" }), name.first?.isLetter == true else { throw AyuPluginError.invalidInput }
+            self.author = .username(name)
+        }
+        var calendar = Calendar(identifier: .gregorian); calendar.timeZone = timeZone
+        func timestamp(_ raw: String, end: Bool) throws -> Int32? {
+            let text = raw.trimmingCharacters(in: .whitespacesAndNewlines)
+            if text.isEmpty { return nil }
+            let formatter = DateFormatter(); formatter.locale = Locale(identifier: "en_US_POSIX"); formatter.calendar = calendar; formatter.timeZone = timeZone; formatter.dateFormat = "yyyy-MM-dd"; formatter.isLenient = false
+            guard text.utf8.count == 10, let date = formatter.date(from: text), formatter.string(from: date) == text else { throw AyuPluginError.invalidInput }
+            let interval: TimeInterval
+            if end {
+                guard let next = calendar.date(byAdding: .day, value: 1, to: date) else { throw AyuPluginError.invalidInput }
+                interval = next.timeIntervalSince1970 - 1
+            } else { interval = date.timeIntervalSince1970 }
+            guard interval >= 0, interval <= Double(Int32.max) else { throw AyuPluginError.invalidInput }
+            return Int32(interval)
+        }
+        self.minimumDate = try timestamp(from, end: false)
+        self.maximumDate = try timestamp(until, end: true)
+        if let minimumDate = self.minimumDate, let maximumDate = self.maximumDate, minimumDate > maximumDate { throw AyuPluginError.invalidInput }
+        self.media = media
+    }
+}
+
+public struct AyuFormattedCopyRecord: Equatable {
+    public struct Quote: Equatable {
+        public var author: String
+        public var text: String
+        public init(author: String, text: String) { self.author = author; self.text = text }
+    }
+    public var timestamp: Int32
+    public var author: String
+    public var text: String
+    public var quote: Quote?
+    public init(timestamp: Int32, author: String, text: String, quote: Quote? = nil) {
+        self.timestamp = timestamp; self.author = author; self.text = text; self.quote = quote
+    }
+    public static func render(_ records: [Self], includeTimestamp: Bool, russian: Bool, timeZone: TimeZone = .current) throws -> String {
+        guard !records.isEmpty, records.count <= 100 else { throw AyuPluginError.invalidInput }
+        let date = DateFormatter(); date.locale = Locale(identifier: "en_US_POSIX"); date.timeZone = timeZone; date.dateFormat = "dd/MM/yyyy HH:mm:ss"
+        func singleLine(_ text: String) -> String { return text.split(whereSeparator: { $0.isWhitespace }).joined(separator: " ") }
+        let unknown = russian ? "неизвестный автор" : "unknown author"
+        var output = ""
+        for record in records {
+            guard record.author.utf8.count <= 4096, record.text.utf8.count <= 1024 * 1024 else { throw AyuPluginError.invalidInput }
+            let author = singleLine(record.author)
+            let body = record.text.isEmpty ? (russian ? "[сообщение без текста]" : "[message without text]") : record.text
+            var row = includeTimestamp ? "[" + (record.timestamp > 0 ? date.string(from: Date(timeIntervalSince1970: Double(record.timestamp))) : (russian ? "неизвестная дата" : "unknown date")) + "] " : ""
+            row += (author.isEmpty ? unknown : author) + ":\n"
+            if let quote = record.quote {
+                guard quote.author.utf8.count <= 4096, quote.text.utf8.count <= 1024 * 1024 else { throw AyuPluginError.invalidInput }
+                let name = singleLine(quote.author)
+                row += "↳ " + (name.isEmpty ? unknown : name) + ": " + singleLine(quote.text) + "\n└ "
+            }
+            row += body
+            if !output.isEmpty { output += "\n\n" }
+            guard output.utf8.count + row.utf8.count <= 1024 * 1024 else { throw AyuPluginError.invalidInput }
+            output += row
+        }
+        return output
+    }
+}
diff --git a/submodules/TelegramCore/Sources/AyuGram/AyuPluginCatalog.swift b/submodules/TelegramCore/Sources/AyuGram/AyuPluginCatalog.swift
new file mode 100644
