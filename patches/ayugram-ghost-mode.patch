+import Foundation
+
+public struct AyuReactionTotalSettings: Codable, Equatable {
+    public var compact = false
+    public var onlyChannels = false
+    public var skipPaid = false
+    public var minimumCount: Int64 = 1
+    public var style = 0
+    public var afterDate = false
+    public init() {}
+    public func validate() throws {
+        guard (1...1000000000).contains(self.minimumCount), (0...2).contains(self.style) else { throw AyuPluginError.invalidInput }
+    }
+    public func label(counts: [(count: Int64, paid: Bool)], isChannel: Bool) -> String? {
+        guard (!self.onlyChannels || isChannel), (try? self.validate()) != nil else { return nil }
+        var total: Int64 = 0
+        for entry in counts where entry.count > 0 && (!self.skipPaid || !entry.paid) {
+            let sum = total.addingReportingOverflow(entry.count)
+            total = sum.overflow ? Int64.max : sum.partialValue
+        }
+        guard total >= self.minimumCount else { return nil }
+        let count: String
+        if self.compact, total >= 1000 {
+            let divisor: Double = total >= 1000000 ? 1000000 : 1000
+            var text = String(format: "%.1f", locale: Locale(identifier: "en_US_POSIX"), Double(total) / divisor)
+            if text.hasSuffix(".0") { text.removeLast(2) }
+            count = text + (total >= 1000000 ? "M" : "K")
+        } else { count = String(total) }
+        return ["♥ ", "Σ ", ""][self.style] + count
+    }
+}
diff --git a/submodules/TelegramCore/Sources/AyuGram/AyuRegexSettings.swift b/submodules/TelegramCore/Sources/AyuGram/AyuRegexSettings.swift
new file mode 100644
index 00000000..93e17f4b
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuGram/AyuRegexSettings.swift
@@ -0,0 +1,90 @@
+import Foundation
+
+public struct AyuRegexSettings: Codable, Equatable {
+    public var enabled = false
+    public var includeChats = false
+    public var caseInsensitive = true
+    public var patterns: [String] = []
+    public init() {}
+
+    /// Keep a literal phrase on one editor line, including multiline message text.
+    public static func literalPattern(for text: String) throws -> String {
+        guard !text.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty, text.utf8.count <= 512 else {
+            throw NSError(domain: "AyuRegex", code: 4, userInfo: [NSLocalizedDescriptionKey: "Choose a non-empty phrase of at most 512 UTF-8 bytes."])
+        }
+        var pattern = ""
+        for scalar in text.unicodeScalars {
+            if CharacterSet.newlines.contains(scalar) || CharacterSet.controlCharacters.contains(scalar) {
+                pattern += "\\x{" + String(scalar.value, radix: 16) + "}"
+            } else {
+                pattern += NSRegularExpression.escapedPattern(for: String(scalar))
+            }
+        }
+        var settings = AyuRegexSettings()
+        settings.patterns = [pattern]
+        try settings.validate()
+        return pattern
+    }
+
+    public func draftAddingLiteral(_ text: String) throws -> [String] {
+        let pattern = try Self.literalPattern(for: text)
+        var result = self
+        if !result.patterns.contains(pattern) { result.patterns.append(pattern) }
+        try result.validate()
+        return result.patterns
+    }
+
+    public func validate() throws {
+        guard self.patterns.count <= 32 else {
+            throw NSError(domain: "AyuRegex", code: 1, userInfo: [NSLocalizedDescriptionKey: "Use at most 32 patterns."])
+        }
+        for (index, pattern) in self.patterns.enumerated() {
+            guard !pattern.isEmpty, pattern.utf8.count <= 512 else {
+                throw NSError(domain: "AyuRegex", code: 2, userInfo: [NSLocalizedDescriptionKey: "Pattern \(index + 1) must contain 1–512 UTF-8 bytes."])
+            }
+            do {
+                let _ = try NSRegularExpression(pattern: pattern, options: .anchorsMatchLines)
+            } catch {
+                throw NSError(domain: "AyuRegex", code: 3, userInfo: [NSLocalizedDescriptionKey: "Invalid pattern \(index + 1): \(error.localizedDescription)"])
+            }
+        }
+    }
+}
+
+/// Immutable compiled expressions are shared; matching never stores message text.
+public final class AyuRegexMatcher {
+    public static let shared = AyuRegexMatcher()
+    private let lock = NSLock()
+    private var cachedSettings: AyuRegexSettings?
+    private var cachedExpressions: [NSRegularExpression] = []
+    private init() {}
+
+    public func matches(_ text: String, settings: AyuRegexSettings, deadline: TimeInterval) -> Bool {
+        guard settings.enabled, !settings.patterns.isEmpty, !text.isEmpty,
+              text.utf8.count <= 16_384, Date.timeIntervalSinceReferenceDate < deadline else { return false }
+        self.lock.lock()
+        if self.cachedSettings != settings {
+            var options: NSRegularExpression.Options = [.anchorsMatchLines]
+            if settings.caseInsensitive { options.insert(.caseInsensitive) }
+            self.cachedExpressions = settings.patterns.compactMap { try? NSRegularExpression(pattern: $0, options: options) }
+            self.cachedSettings = settings
+        }
+        let expressions = self.cachedExpressions
+        self.lock.unlock()
+        let range = NSRange(text.startIndex ..< text.endIndex, in: text)
+        for expression in expressions {
+            guard Date.timeIntervalSinceReferenceDate < deadline else { return false }
+            var matched = false
+            expression.enumerateMatches(in: text, options: [.reportProgress], range: range) { result, _, stop in
+                if Date.timeIntervalSinceReferenceDate >= deadline {
+                    stop.pointee = true
+                } else if result != nil {
+                    matched = true
+                    stop.pointee = true
+                }
+            }
+            if matched { return true }
+        }
+        return false
+    }
+}
diff --git a/submodules/TelegramCore/Sources/AyuGram/AyuTextProgram.swift b/submodules/TelegramCore/Sources/AyuGram/AyuTextProgram.swift
new file mode 100644
index 00000000..53d3f252
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuGram/AyuTextProgram.swift
@@ -0,0 +1,90 @@
+import Foundation
+
+/// A bounded, persisted text program. No Python or Android code runs while sending.
+public struct AyuTextProgram: Codable, Equatable {
+    public static let converterID = "exteraGram/ast-send-hook-v2"
+    public var instructions: [AyuTextInstruction]
+    public func validate() throws {
+        var remaining = 64
+        try self.validate(self.instructions, depth: 0, remaining: &remaining)
+    }
+    private func validate(_ instructions: [AyuTextInstruction], depth: Int, remaining: inout Int) throws {
+        guard depth <= 4, !instructions.isEmpty else { throw AyuPluginError.invalidManifest }
+        for item in instructions {
+            remaining -= 1
+            guard remaining >= 0 else { throw AyuPluginError.invalidManifest }
+            switch item.op {
+            case "branch":
+                guard let condition = item.condition, condition.value.utf8.count <= 128,
+                      let body = item.body, item.value == nil, item.find == nil, item.count == nil else { throw AyuPluginError.invalidManifest }
+                try self.validate(body, depth: depth + 1, remaining: &remaining)
+                if let other = item.otherwise, !other.isEmpty { try self.validate(other, depth: depth + 1, remaining: &remaining) }
+            case "replace":
+                guard let find = item.find, !find.isEmpty, find.utf8.count <= 128,
+                      let value = item.value, value.utf8.count <= 128,
+                      item.count == nil || (0...4096).contains(item.count!),
+                      item.condition == nil, item.body == nil, item.otherwise == nil else { throw AyuPluginError.invalidManifest }
+            case "lower", "upper", "strip":
+                guard item.value == nil, item.find == nil, item.count == nil,
+                      item.condition == nil, item.body == nil, item.otherwise == nil else { throw AyuPluginError.invalidManifest }
+            case "prepend", "append", "removePrefix", "removeSuffix":
+                guard let value = item.value, !value.isEmpty, value.utf8.count <= 128,
+                      item.find == nil, item.count == nil, item.condition == nil, item.body == nil, item.otherwise == nil else { throw AyuPluginError.invalidManifest }
+            default: throw AyuPluginError.invalidManifest
+            }
+        }
+    }
+    public func apply(_ input: String) throws -> String {
+        try self.validate()
+        guard input.utf8.count <= 8192, input.utf16.count <= 4096 else { throw AyuPluginError.invalidInput }
+        var text = input
+        try self.run(self.instructions, text: &text)
+        guard !text.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else { throw AyuPluginError.invalidInput }
+        return text
+    }
+    private func run(_ instructions: [AyuTextInstruction], text: inout String) throws {
+        for item in instructions {
+            switch item.op {
+            case "branch":
+                let body = item.condition!.matches(text) ? item.body! : (item.otherwise ?? [])
+                try self.run(body, text: &text)
+            case "replace":
+                let input = text as NSString, find = item.find!, value = item.value!
+                var cursor = 0, applied = 0, output = ""
+                let limit = item.count ?? 4096
+                while applied < limit && cursor < input.length {
+                    let range = input.range(of: find, options: .literal, range: NSRange(location: cursor, length: input.length - cursor))
+                    if range.location == NSNotFound { break }
+                    output += input.substring(with: NSRange(location: cursor, length: range.location - cursor)) + value
+                    guard output.utf8.count <= 8192 else { throw AyuPluginError.invalidInput }
+                    cursor = NSMaxRange(range); applied += 1
+                }
+                text = output + input.substring(from: cursor)
+            case "lower": text = text.lowercased()
+            case "upper": text = text.uppercased()
+            case "strip":
+                var whitespace = CharacterSet.whitespacesAndNewlines
+                whitespace.insert(charactersIn: "\u{001c}\u{001d}\u{001e}\u{001f}")
+                text = text.trimmingCharacters(in: whitespace)
+            case "prepend": text = item.value! + text
+            case "append": text += item.value!
+            case "removePrefix":
+                if text.utf8.starts(with: item.value!.utf8) { text = String(decoding: text.utf8.dropFirst(item.value!.utf8.count), as: UTF8.self) }
+            case "removeSuffix":
+                if text.utf8.reversed().starts(with: item.value!.utf8.reversed()) { text = String(decoding: text.utf8.dropLast(item.value!.utf8.count), as: UTF8.self) }
+            default: throw AyuPluginError.invalidManifest
+            }
+            guard text.utf8.count <= 8192, text.utf16.count <= 4096 else { throw AyuPluginError.invalidInput }
+        }
+    }
+}
+
+public struct AyuTextInstruction: Codable, Equatable {
+    public var op: String
+    public var value: String?
+    public var find: String?
+    public var count: Int?
+    public var condition: AyuPluginTextCondition?
+    public var body: [AyuTextInstruction]?
+    public var otherwise: [AyuTextInstruction]?
+}
