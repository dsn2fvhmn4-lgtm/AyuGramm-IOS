+public enum AyuPluginActivation {
+    /// Prepare typed actions and exercise local handlers. No plugin code or network requests run.
+    public static func prepare(_ manifest: AyuPluginManifest) throws -> AyuPluginManifest {
+        try manifest.validate()
+        let prepared = try AyuPluginImporter.parse(AyuPluginImporter.export(manifest), filename: manifest.id + ".plugin")
+        guard prepared == manifest else { throw AyuPluginError.invalidManifest }
+        for action in prepared.actions {
+            switch action.kind {
+            case .cameraFlip, .chatColors, .arcadeGame, .unlimitedAccounts, .groupMentions, .petpet, .reactionsTotal, .formattedCopy: break
+            case .search:
+                guard try action.queries("AyuGram") == ["AyuGram"] else { throw AyuPluginError.invalidInput }
+            case .searchTerms:
+                guard try action.queries("AyuGram|Telegram|AyuGram") == ["AyuGram", "Telegram"] else { throw AyuPluginError.invalidInput }
+            case .replaceText:
+                let find = action.find ?? ""
+                let marker = find.contains("A") ? "B" : "A"
+                _ = try action.transformed(find + "\n" + marker)
+            case .outgoingReplace:
+                if let program = action.program { try program.validate(); continue }
+                guard let find = action.find, let replacement = action.replacement else { throw AyuPluginError.invalidManifest }
+                let sample = action.prefix ?? find
+                guard sample.replacingOccurrences(of: find, with: replacement, options: .literal).utf8.count <= sample.utf8.count else { throw AyuPluginError.invalidInput }
+            }
+        }
+        if manifest.convertedFrom == AyuPluginCatalogConfiguration.marker {
+            // prepare/parse already verified the portable per-adapter signature.
+            return prepared
+        }
+        if manifest.convertedFrom != nil {
+            if manifest.convertedFrom == AyuAndroidPluginConverter.templateID || manifest.convertedFrom == AyuTextProgram.converterID {
+                guard let hash = manifest.sourceSHA256, hash.count == 64, hash.allSatisfy({ $0.isHexDigit }),
+                      manifest.actions.allSatisfy({ $0.kind == .outgoingReplace }) else { throw AyuPluginError.invalidManifest }
+                return prepared
+            }
+            guard let hash = manifest.sourceSHA256 else { throw AyuPluginError.unsupportedAndroidPlugin }
+            let converted = try AyuPluginImporter.reviewedAdapter(sourceSHA256: hash)
+            guard converted == manifest else { throw AyuPluginError.unsupportedAndroidPlugin }
+            return converted
+        }
+        return prepared
+    }
+}
