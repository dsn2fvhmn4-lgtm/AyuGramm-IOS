+import Foundation
+
+public struct AyuChatColorSettings: Codable, Equatable {
+    public var enabled: Bool
+    public var brightness: Int
+    public var colors: [String: String]
+    public init(enabled: Bool = true, brightness: Int = 2, colors: [String: String] = [:]) {
+        self.enabled = enabled; self.brightness = brightness; self.colors = colors
+    }
+    public static func normalizedHex(_ input: String) -> String? {
+        var value = input.trimmingCharacters(in: .whitespacesAndNewlines).uppercased()
+        if value.hasPrefix("#") { value.removeFirst() }
+        guard [3, 6].contains(value.utf8.count), value.unicodeScalars.allSatisfy({ (48...57).contains($0.value) || (65...70).contains($0.value) }) else { return nil }
+        if value.count == 3 { value = value.map { String(repeating: String($0), count: 2) }.joined() }
+        return value
+    }
+    public func validate() throws {
+        guard (0...9).contains(self.brightness), self.colors.count <= 1024 else { throw AyuPluginError.invalidManifest }
+        for (key, color) in self.colors {
+            guard let id = Int64(key), id != 0, String(id) == key, color.utf8.count == 6, Self.normalizedHex(color) == color else { throw AyuPluginError.invalidManifest }
+        }
+    }
+    public func color(peerKey: String) -> (rgb: UInt32, alpha: Double)? {
+        guard self.enabled, let hex = self.colors[peerKey], hex.utf8.count == 6, let rgb = UInt32(hex, radix: 16), (0...9).contains(self.brightness) else { return nil }
+        let alpha = min(255, Int((Double((self.brightness + 1) * 10) * 2.55).rounded(.toNearestOrEven)))
+        return (rgb, Double(alpha) / 255.0)
+    }
+}
