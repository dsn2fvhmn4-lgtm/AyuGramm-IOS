+    }
+    let controller = ItemListController(context: context, state: signal)
+    presentError = { [weak controller] in
+        let data = context.sharedContext.currentPresentationData.with { $0 }
+        controller?.present(textAlertController(context: context, title: "AyuGram", text: data.strings.baseLanguageCode.hasPrefix("ru") ? "Не удалось сохранить показ реакций." : "Reaction display settings could not be saved.", actions: [TextAlertAction(type: .defaultAction, title: data.strings.Common_OK, action: {})]), in: .window(.root))
+    }
