+            let result = Result { try AyuPetpetRenderer.render(image: image, resolution: size, delay: delay) }
+            DispatchQueue.main.async {
+                guard let self, generation == self.generation else { return }; self.busy = false
+                switch result {
+                case let .success((data, frames)):
+                    self.gif = data; self.preview.image = frames.first; self.preview.animationImages = frames
+                    self.preview.animationDuration = Double(delay * 10) / 1000.0; self.preview.startAnimating()
+                    self.navigationItem.rightBarButtonItem?.isEnabled = true; self.tableView.reloadData()
+                case .failure: self.showError()
+                }
+            }
+        }
+    }
+    private func showError() {
+        self.tableView.reloadData()
+        guard self.viewIfLoaded?.window != nil, self.presentedViewController == nil else { return }
+        let alert = UIAlertController(title: "petpet", message: self.russian ? "Не удалось обработать изображение. Лимит 8 МБ и 64 мегапикселя. Попробуй PNG или JPEG." : "Image could not be processed. Limit: 8 MB and 64 megapixels. Try PNG or JPEG.", preferredStyle: .alert)
+        alert.addAction(UIAlertAction(title: "OK", style: .default)); self.present(alert, animated: true)
+    }
+    @objc private func sendTapped() {
+        guard !self.busy, let data = self.gif else { return }
+        self.navigationItem.rightBarButtonItem?.isEnabled = false
+        self.dismiss(animated: true, completion: { [send = self.send] in send(data) })
+    }
+}
