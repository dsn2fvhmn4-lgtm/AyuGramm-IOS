+private final class AyuTranslationController: UITableViewController {
+    private let context: AccountContext
+    private let text: String
+    private let request = MetaDisposable()
+    private var generation = 0
+    private var running = false
+    private var result = ""
+    private var status = ""
+    private var ru: Bool { return self.context.sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru") }
+    init(context: AccountContext, text: String) { self.context = context; self.text = text; super.init(style: .insetGrouped); self.title = "AyuGram · Translate" }
+    required init?(coder: NSCoder) { return nil }
+    deinit { self.request.dispose() }
+    override func viewDidLoad() {
+        super.viewDidLoad(); self.navigationItem.rightBarButtonItem = UIBarButtonItem(barButtonSystemItem: .done, target: self, action: #selector(self.done))
+        self.navigationItem.leftBarButtonItem = UIBarButtonItem(barButtonSystemItem: .stop, target: self, action: #selector(self.stop))
+    }
+    @objc private func done() { self.request.dispose(); self.dismiss(animated: true) }
+    @objc private func stop() { self.generation += 1; self.request.set(nil); self.running = false; self.status = self.ru ? "Отменено" : "Cancelled"; self.tableView.reloadData() }
+    override func numberOfSections(in tableView: UITableView) -> Int { return 3 }
+    override func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int { return section == 1 ? 2 : 1 }
+    override func tableView(_ tableView: UITableView, titleForHeaderInSection section: Int) -> String? {
+        return self.ru ? ["Текст для отправки провайдеру", "Действия", "Результат"][section] : ["Text to send to provider", "Actions", "Result"][section]
+    }
+    override func tableView(_ tableView: UITableView, titleForFooterInSection section: Int) -> String? {
+        let settings = self.context.account.network.ayuGhostMode.current.advanced
+        return section == 1 ? settings.translationProvider.rawValue + " → " + settings.translationTarget + "\n" + self.status : nil
+    }
+    override func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
+        let cell = UITableViewCell(style: .default, reuseIdentifier: nil); cell.textLabel?.numberOfLines = 0
+        if indexPath.section == 0 { cell.textLabel?.text = self.text }
+        else if indexPath.section == 2 { cell.textLabel?.text = self.result.isEmpty ? "—" : self.result }
+        else { cell.textLabel?.text = indexPath.row == 0 ? (self.ru ? "Перевести" : "Translate") : (self.ru ? "Скопировать результат" : "Copy result"); cell.textLabel?.textColor = .systemBlue }
+        return cell
+    }
+    override func tableView(_ tableView: UITableView, didSelectRowAt indexPath: IndexPath) {
+        tableView.deselectRow(at: indexPath, animated: true); guard indexPath.section == 1 else { return }
+        if indexPath.row == 1 { if !self.result.isEmpty { UIPasteboard.general.string = self.result }; return }
+        guard !self.running else { return }; self.running = true; self.generation += 1; let generation = self.generation
+        self.result = ""; self.status = self.ru ? "Перевод…" : "Translating…"; self.tableView.reloadData()
+        self.request.set((self.context.engine.messages.ayuTranslate(text: self.text)
+        |> timeout(45, queue: Queue.mainQueue(), alternate: .fail(.network))
+        |> deliverOnMainQueue).start(next: { [weak self] result in
+            guard let self, self.generation == generation else { return }; self.result = result; self.status = ""; self.running = false; self.tableView.reloadData()
+        }, error: { [weak self] error in
+            guard let self, self.generation == generation else { return }; self.running = false
+            self.status = (self.ru ? "Перевод не выполнен: " : "Translation failed: ") + String(describing: error); self.tableView.reloadData()
+        }))
+    }
+}
