+import Foundation
+import Display
+import TelegramCore
+import AccountContext
+import TelegramPresentationData
+import AlertUI
+import PresentationDataUtils
+
+extension ChatControllerImpl {
+    /// True means the original synchronous send must stop. Confirmation re-enters
+    /// the same handler once, so native restrictions and paid/scheduled sends recheck.
+    func ayuConfirmMediaSendIfNeeded(kind: AyuMediaSendSettings.Kind, send: @escaping () -> Void) -> Bool {
+        if self.ayuApprovedMediaSend == kind || !self.context.account.network.ayuGhostMode.current.mediaSend.needsConfirmation(for: kind) {
+            return false
+        }
+        if self.ayuMediaConfirmationController != nil { return true }
+        let ru = self.presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        let text: String
+        switch kind {
+        case .sticker: text = ru ? "Отправить этот стикер?" : "Send this sticker?"
+        case .gif: text = ru ? "Отправить эту GIF-анимацию?" : "Send this GIF?"
+        }
+        let decision = AyuMediaSendDecision()
+        let controller = textAlertController(context: self.context, title: "AyuGram", text: text, actions: [
+            TextAlertAction(type: .genericAction, title: self.presentationData.strings.Common_Cancel, action: {
+                let _ = decision.resolve(approved: false)
+            }),
+            TextAlertAction(type: .defaultAction, title: ru ? "Отправить" : "Send", action: { [weak self] in
+                guard decision.resolve(approved: true), let self else { return }
+                let previous = self.ayuApprovedMediaSend
+                self.ayuApprovedMediaSend = kind
+                defer { self.ayuApprovedMediaSend = previous }
+                send()
+            })
+        ])
+        self.ayuMediaConfirmationController = controller
+        self.present(controller, in: .window(.root))
+        return true
+    }
+}
