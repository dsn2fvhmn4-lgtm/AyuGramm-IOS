+private let logoSize = CGSize(width: 100.0, height: 100.0)
+
+private func roundLogo(_ name: String, fallbackColor: UIColor) -> UIImage? {
+    return generateImage(logoSize, rotatedContext: { size, context in
+        let bounds = CGRect(origin: CGPoint(), size: size)
+        context.clear(bounds)
+        context.addEllipse(in: bounds)
+        context.clip()
+        if let image = UIImage(bundleImageName: name) {
+            UIGraphicsPushContext(context)
+            image.draw(in: bounds)
+            UIGraphicsPopContext()
+        } else {
+            context.setFillColor(fallbackColor.cgColor)
+            context.fill(bounds)
+        }
+    })
+}
