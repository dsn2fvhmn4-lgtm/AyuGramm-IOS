+    let palette = AyuPreferencesPalette(background: data.theme.list.blocksBackgroundColor, panel: data.theme.list.itemBlocksBackgroundColor, text: data.theme.list.itemPrimaryTextColor, secondary: data.theme.list.itemSecondaryTextColor, accent: data.theme.list.itemAccentColor)
+    let initialImport: (URL, String)?
+    if let fileURL, let filename { initialImport = (fileURL, filename) } else { initialImport = nil }
+    let plugins = AyuPluginManagerController(store: context.account.network.ayuGhostMode, russian: data.strings.baseLanguageCode.hasPrefix("ru"), palette: palette, initialImport: initialImport, settingsController: { id in AyuChatColorsController(context: context, pluginID: id) }, keepAwake: {
+        let disposable = context.sharedContext.applicationBindings.pushIdleTimerExtension()
+        return { disposable.dispose() }
+    })
+    let navigation = UINavigationController(rootViewController: plugins)
+    navigation.overrideUserInterfaceStyle = data.theme.overallDarkAppearance ? .dark : .light
+    context.sharedContext.applicationBindings.presentNativeController(navigation)
