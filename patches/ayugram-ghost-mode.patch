+    case 3:
+        return (ru ? "Оформление" : "Appearance", [(52, ru ? "Локальный Premium и статус" : "Local Premium and status"), (4, ru ? "Оформление чатов" : "Chat Appearance"), (7, ru ? "Оформление MessageShot" : "MessageShot Appearance"), (20, ru ? "Иконка приложения" : "App Icon")])
+    default:
+        return (ru ? "Чаты" : "Chats", [(8, ru ? "Скрытые сообщения" : "Hidden Messages"), (9, ru ? "Реакции в чатах" : "Chat Reactions")])
