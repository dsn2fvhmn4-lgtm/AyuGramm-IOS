+            .toggle(6, ru ? "Медиа личных чатов" : "Private-chat media", history.mediaPrivateChats),
+            .toggle(7, ru ? "Медиа публичных каналов" : "Public-channel media", history.mediaPublicChannels),
+            .toggle(8, ru ? "Медиа частных каналов" : "Private-channel media", history.mediaPrivateChannels),
+            .toggle(9, ru ? "Медиа публичных групп" : "Public-group media", history.mediaPublicGroups),
+            .toggle(10, ru ? "Медиа частных групп" : "Private-group media", history.mediaPrivateGroups),
+            .info(11, ru ? "Только уже загруженный текст обычных облачных сообщений. До 100 записей за 7 дней, до 8 КБ каждая. Копирование медиа включается отдельно: только уже загруженные фото и файлы до 25 МБ, до 250 МБ на аккаунт. Недоступные файлы не загружаются. Защищённые, секретные и исчезающие сообщения исключены; неизвестный срок хранения чата также исключает сохранение. Архив находится в базе этого аккаунта на устройстве." : "Only text already received in ordinary cloud messages. Up to 100 entries for 7 days, up to 8 KB each. Media copying is opt-in: cached photos/files only, up to 25 MB each and 250 MB per account. Unavailable files are not downloaded. Protected, secret and disappearing messages are excluded, including chats whose lifetime is unknown. The archive stays in this account's local database.")
+        ]
+        let records = history.records.filter { record in
+            guard let messageId else { return true }
