+++ b/submodules/TelegramCore/Sources/AyuGram/AyuDisplayOptions.swift
@@ -0,0 +1,117 @@
+import Foundation
+
+/// Process-wide AyuGram display options for code that renders without an account context
+/// (text formatting, sticker lists, web app requests). An option is on while any signed-in
+/// account of this process has it enabled.
+public enum AyuDisplayOptions {
+    public struct Flags: Equatable {
+        public var revealSpoilers = false
+        public var filterZalgo = false
+        public var spoofWebAppAsAndroid = false
+        public var unlimitedRecentStickers = false
+        public var disableNumberRounding = false
+        public init() {}
+    }
+
+    private static let lock = NSLock()
+    private static var accounts: [Int64: Flags] = [:]
+
+    public static func update(accountPeerId: Int64, flags: Flags) {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        self.accounts[accountPeerId] = flags
+    }
+
+    private static func any(_ predicate: (Flags) -> Bool) -> Bool {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return self.accounts.values.contains(where: predicate)
+    }
+
+    public static var revealSpoilers: Bool { return self.any { $0.revealSpoilers } }
+    public static var filterZalgo: Bool { return self.any { $0.filterZalgo } }
+    public static var webAppPlatform: String? { return self.any { $0.spoofWebAppAsAndroid } ? "android" : nil }
+
+    /// Local cap for the recent stickers list; the server keeps its own list.
+    public static var recentStickersLimit: Int { return self.any { $0.unlimitedRecentStickers } ? 200 : 20 }
+
+    /// exteraGram "Disable number rounding": counters show 1,234 instead of 1.2K.
+    public static var disableNumberRounding: Bool { return self.any { $0.disableNumberRounding } }
+
+    /// The full count with thousands grouped by commas, as exteraGram shows it.
+    public static func fullCountString(_ count: Int64) -> String {
+        let digits = String(count.magnitude)
+        var result = ""
+        for (index, character) in digits.enumerated() {
+            if index != 0 && (digits.count - index) % 3 == 0 {
+                result.append(",")
+            }
+            result.append(character)
+        }
+        return count < 0 ? "-" + result : result
+    }
+
+    /// Combining marks kept after each base character; more are removed as "zalgo" text.
+    public static let maximumCombiningMarks = 2
+
+    private static func isCombiningMark(_ scalar: Unicode.Scalar) -> Bool {
+        switch scalar.properties.generalCategory {
+        case .nonspacingMark, .enclosingMark:
+            // Variation selectors are marks too, but emoji need them.
+            let value = scalar.value
+            return !((0xFE00...0xFE0F).contains(value) || (0xE0100...0xE01EF).contains(value))
+        default:
+            return false
+        }
+    }
+
+    /// UTF-16 ranges of combining marks beyond the per-character limit, in ascending order.
+    public static func zalgoRanges(in text: String) -> [NSRange] {
+        var ranges: [NSRange] = []
+        var offset = 0
+        var run = 0
+        for scalar in text.unicodeScalars {
+            let length = scalar.utf16.count
+            if self.isCombiningMark(scalar) {
+                run += 1
+                if run > self.maximumCombiningMarks {
+                    if let last = ranges.last, last.location + last.length == offset {
+                        ranges[ranges.count - 1].length += length
+                    } else {
+                        ranges.append(NSRange(location: offset, length: length))
+                    }
+                }
+            } else {
+                run = 0
+            }
+            offset += length
+        }
+        return ranges
+    }
+
+    /// Removes excess combining marks in place; attributes of the remaining text stay aligned.
+    /// The result is rebuilt from the kept substrings: per-range deletion is not reliable
+    /// across Foundation implementations for runs of combining marks.
+    public static func removeZalgo(from string: NSMutableAttributedString) {
+        let ranges = self.zalgoRanges(in: string.string)
+        guard !ranges.isEmpty else { return }
+        let rebuilt = NSMutableAttributedString(string: "")
+        var cursor = 0
+        for range in ranges {
+            if range.location > cursor {
+                rebuilt.append(string.attributedSubstring(from: NSRange(location: cursor, length: range.location - cursor)))
+            }
+            cursor = range.location + range.length
+        }
+        if cursor < string.length {
+            rebuilt.append(string.attributedSubstring(from: NSRange(location: cursor, length: string.length - cursor)))
+        }
+        string.setAttributedString(rebuilt)
+    }
+
+    public static func removingZalgo(_ text: String) -> String {
+        let string = NSMutableAttributedString(string: text)
+        self.removeZalgo(from: string)
+        return string.string
+    }
+}
diff --git a/submodules/TelegramCore/Sources/AyuGram/AyuGhostMode.swift b/submodules/TelegramCore/Sources/AyuGram/AyuGhostMode.swift
