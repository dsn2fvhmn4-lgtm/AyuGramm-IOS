diff --git a/submodules/Display/Source/AyuMaterialSelection.swift b/submodules/Display/Source/AyuMaterialSelection.swift
new file mode 100644
index 0000000..33581d9
--- /dev/null
+++ b/submodules/Display/Source/AyuMaterialSelection.swift
@@ -0,0 +1,166 @@
+import Foundation
+import UIKit
+
+public enum AyuMaterialSelectionKind { case checkbox, radio }
+
+/// M3 selection geometry: 18 pt checkbox, 20 pt radio, 40 pt state layer.
+public enum AyuMaterialSelectionDrawing {
+    public static func drawCheckbox(context: CGContext, size: CGSize, progress: CGFloat, primary: UIColor, onPrimary: UIColor, outline: UIColor) {
+        guard size.width > 0.0, size.height > 0.0 else { return }
+        let progress = min(1.0, max(0.0, progress))
+        let side = min(18.0, min(size.width, size.height))
+        let frame = CGRect(x: (size.width - side) * 0.5, y: (size.height - side) * 0.5, width: side, height: side)
+        let path = UIBezierPath(roundedRect: frame.insetBy(dx: 1.0, dy: 1.0), cornerRadius: 1.0).cgPath
+        context.saveGState()
+        context.setBlendMode(.normal)
+        context.setLineWidth(2.0)
+        context.setStrokeColor(outline.mixedWith(primary, alpha: progress).cgColor)
+        context.addPath(path)
+        context.strokePath()
+        if progress > 0.0 {
+            context.setFillColor(primary.withAlphaComponent(progress).cgColor)
+            context.addPath(path)
+            context.fillPath()
+            let points = [CGPoint(x: frame.minX + side * 0.22, y: frame.minY + side * 0.50), CGPoint(x: frame.minX + side * 0.43, y: frame.minY + side * 0.71), CGPoint(x: frame.minX + side * 0.79, y: frame.minY + side * 0.31)]
+            let firstLength = hypot(points[1].x - points[0].x, points[1].y - points[0].y)
+            let secondLength = hypot(points[2].x - points[1].x, points[2].y - points[1].y)
+            let length = (firstLength + secondLength) * min(1.0, max(0.0, (progress - 0.15) / 0.85))
+            if onPrimary == .clear { context.setBlendMode(.clear) }
+            context.setStrokeColor(onPrimary.cgColor)
+            context.setLineWidth(2.0)
+            context.setLineCap(.square)
+            context.setLineJoin(.miter)
+            context.move(to: points[0])
+            if length <= firstLength {
+                let fraction = length / firstLength
+                context.addLine(to: CGPoint(x: points[0].x + (points[1].x - points[0].x) * fraction, y: points[0].y + (points[1].y - points[0].y) * fraction))
+            } else {
+                context.addLine(to: points[1])
+                let fraction = (length - firstLength) / secondLength
+                context.addLine(to: CGPoint(x: points[1].x + (points[2].x - points[1].x) * fraction, y: points[1].y + (points[2].y - points[1].y) * fraction))
+            }
+            context.strokePath()
+        }
+        context.restoreGState()
+    }
+}
+
+public final class AyuMaterialSelectionView: UIControl {
+    private let kind: AyuMaterialSelectionKind
+    private let stateLayer = CAShapeLayer()
+    private let base = CAShapeLayer()
+    private let mark = CAShapeLayer()
+    private var checked = false
+    private var primary = UIColor(rgb: 0x6750A4)
+    private var onPrimary = UIColor.white
+    private var outline = UIColor(rgb: 0x49454F)
+
+    public init(kind: AyuMaterialSelectionKind) {
+        self.kind = kind
+        super.init(frame: .zero)
+        self.isUserInteractionEnabled = false
+        self.isAccessibilityElement = false
+        self.layer.addSublayer(self.stateLayer)
+        self.layer.addSublayer(self.base)
+        self.layer.addSublayer(self.mark)
+        self.base.lineWidth = 2.0
+        self.mark.lineWidth = 2.0
+        self.mark.lineCap = .square
+        self.mark.lineJoin = .miter
+        self.stateLayer.opacity = 0.0
+    }
+    required init?(coder: NSCoder) { fatalError("init(coder:) has not been implemented") }
+
+    public func updateColors(dark: Bool) {
+        self.primary = UIColor(rgb: dark ? 0xD0BCFF : 0x6750A4)
+        self.onPrimary = UIColor(rgb: dark ? 0x381E72 : 0xFFFFFF)
+        self.outline = UIColor(rgb: dark ? 0xCAC4D0 : 0x49454F)
+        self.update(animated: false)
+    }
+
+    public func setSelected(_ selected: Bool, animated: Bool) {
+        let changed = self.checked != selected
+        self.checked = selected
+        self.update(animated: animated && changed)
+        if changed && animated && !UIAccessibility.isReduceMotionEnabled {
+            let flash = CABasicAnimation(keyPath: "opacity")
+            flash.fromValue = 0.12
+            flash.toValue = 0.0
+            flash.duration = 0.22
+            self.stateLayer.add(flash, forKey: "selectionState")
+        }
+    }
+
+    override public var isHighlighted: Bool {
+        didSet {
+            self.stateLayer.removeAnimation(forKey: "selectionState")
+            CATransaction.begin()
+            CATransaction.setAnimationDuration(UIAccessibility.isReduceMotionEnabled ? 0.0 : 0.12)
+            self.stateLayer.opacity = self.isHighlighted ? 0.12 : 0.0
+            CATransaction.commit()
+        }
+    }
+
+    override public func layoutSubviews() {
+        super.layoutSubviews()
+        self.update(animated: false)
+    }
+
+    private func update(animated: Bool) {
+        let center = CGPoint(x: self.bounds.midX, y: self.bounds.midY)
+        let duration = animated && !UIAccessibility.isReduceMotionEnabled ? 0.18 : 0.0
+        let previousStroke = self.mark.presentation()?.strokeEnd ?? self.mark.strokeEnd
+        let previousFill = self.base.presentation()?.fillColor ?? self.base.fillColor
+        let previousTransform = self.mark.presentation()?.transform ?? self.mark.transform
+        CATransaction.begin()
+        CATransaction.setDisableActions(true)
+        self.stateLayer.path = UIBezierPath(ovalIn: CGRect(x: center.x - 20.0, y: center.y - 20.0, width: 40.0, height: 40.0)).cgPath
+        self.stateLayer.fillColor = self.primary.cgColor
+        self.base.strokeColor = (self.checked ? self.primary : self.outline).cgColor
+        if case .checkbox = self.kind {
+            self.base.path = UIBezierPath(roundedRect: CGRect(x: center.x - 8.0, y: center.y - 8.0, width: 16.0, height: 16.0), cornerRadius: 1.0).cgPath
+            self.base.fillColor = (self.checked ? self.primary : .clear).cgColor
+            let path = UIBezierPath()
+            path.move(to: CGPoint(x: center.x - 5.0, y: center.y))
+            path.addLine(to: CGPoint(x: center.x - 1.0, y: center.y + 4.0))
+            path.addLine(to: CGPoint(x: center.x + 5.0, y: center.y - 4.0))
+            self.mark.path = path.cgPath
+            self.mark.fillColor = nil
+            self.mark.strokeColor = self.onPrimary.cgColor
+            self.mark.strokeEnd = self.checked ? 1.0 : 0.0
+        } else {
+            self.base.path = UIBezierPath(ovalIn: CGRect(x: center.x - 9.0, y: center.y - 9.0, width: 18.0, height: 18.0)).cgPath
+            self.base.fillColor = UIColor.clear.cgColor
+            self.mark.bounds = CGRect(x: 0.0, y: 0.0, width: 10.0, height: 10.0)
+            self.mark.position = center
+            self.mark.path = UIBezierPath(ovalIn: self.mark.bounds).cgPath
+            self.mark.fillColor = self.primary.cgColor
+            self.mark.strokeColor = nil
+            self.mark.transform = CATransform3DMakeScale(self.checked ? 1.0 : 0.001, self.checked ? 1.0 : 0.001, 1.0)
+        }
+        CATransaction.commit()
+        if duration > 0.0 {
+            if case .checkbox = self.kind {
+                let stroke = CABasicAnimation(keyPath: "strokeEnd")
+                stroke.fromValue = previousStroke
+                stroke.toValue = self.mark.strokeEnd
+                stroke.duration = duration
+                self.mark.add(stroke, forKey: "check")
+                let fill = CABasicAnimation(keyPath: "fillColor")
+                fill.fromValue = previousFill
+                fill.toValue = self.base.fillColor
+                fill.duration = duration
+                self.base.add(fill, forKey: "fill")
+            } else {
+                let dot = CASpringAnimation(keyPath: "transform")
+                dot.fromValue = NSValue(caTransform3D: previousTransform)
+                dot.toValue = NSValue(caTransform3D: self.mark.transform)
+                dot.mass = 1.0
+                dot.stiffness = 650.0
+                dot.damping = 40.0
+                dot.duration = dot.settlingDuration
+                self.mark.add(dot, forKey: "dot")
+            }
+        }
+    }
+}
