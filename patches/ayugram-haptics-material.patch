index 0000000..1e1a1b2
--- /dev/null
+++ b/submodules/TelegramUI/Sources/AyuMusicHaptics.swift
@@ -0,0 +1,105 @@
+import Foundation
+import AVFoundation
+import CoreHaptics
+
+/// Decodes the cached track independently of playback; it never records the microphone.
+final class AyuMusicHaptics {
+    static var supported: Bool { CHHapticEngine.capabilitiesForHardware().supportsHaptics }
+    private var engine: CHHapticEngine?
+    private var timeline: AyuMusicHapticsTimeline?
+    private var analysis: Task<Void, Never>?
+    private var generation = 0
+    var ready: ((Bool) -> Void)?
+
+    deinit { self.analysis?.cancel(); self.engine?.stop(completionHandler: nil) }
+
+    func clear() {
+        self.generation += 1
+        self.analysis?.cancel()
+        self.analysis = nil
+        self.timeline = nil
+        self.engine?.stop(completionHandler: nil)
+    }
+
+    func suspend() {
+        self.timeline?.reset()
+        self.engine?.stop(completionHandler: nil)
+    }
+
+    func analyze(url: URL) {
+        self.clear()
+        let generation = self.generation
+        self.analysis = Task.detached(priority: .utility) { [weak self] in
+            let beats = await Self.readBeats(url: url)
+            guard !Task.isCancelled else { return }
+            await MainActor.run { [weak self] in
+                guard let self, self.generation == generation else { return }
+                self.timeline = beats.map { AyuMusicHapticsTimeline(beats: $0) }
+                self.ready?(beats?.isEmpty == false)
+            }
+        }
+    }
+
+    func tick(time: Double, playing: Bool) {
+        guard let strength = self.timeline?.advance(to: time, playing: playing), Self.supported else { return }
+        do {
+            let engine: CHHapticEngine
+            if let current = self.engine { engine = current } else {
+                engine = try CHHapticEngine()
+                engine.playsHapticsOnly = true
+                engine.isAutoShutdownEnabled = true
+                self.engine = engine
+            }
+            try engine.start()
+            let event = CHHapticEvent(eventType: .hapticTransient, parameters: [
+                CHHapticEventParameter(parameterID: .hapticIntensity, value: strength * 0.75),
+                CHHapticEventParameter(parameterID: .hapticSharpness, value: 0.35)
+            ], relativeTime: 0.0)
+            let player = try engine.makePlayer(with: CHHapticPattern(events: [event], parameters: []))
+            try player.start(atTime: CHHapticTimeImmediate)
+        } catch {
+            self.engine?.stop(completionHandler: nil)
+            self.engine = nil
+            self.timeline = nil
+            self.ready?(false)
+        }
+    }
+
+    private static func readBeats(url: URL) async -> [AyuMusicBeat]? {
+        do {
+            let file = try AVAudioFile(forReading: url, commonFormat: .pcmFormatFloat32, interleaved: false)
+            let format = file.processingFormat
+            let sampleRate = format.sampleRate
+            let channels = Int(format.channelCount)
+            let duration = Double(file.length) / sampleRate
+            guard sampleRate.isFinite, sampleRate >= 8000.0, sampleRate <= 768000.0, channels > 0, channels <= 8,
+                  duration.isFinite, duration > 0.0, duration <= 1200.0,
+                  let buffer = AVAudioPCMBuffer(pcmFormat: format, frameCapacity: 4096) else { return nil }
+            let window = max(1, Int(sampleRate * 0.023))
+            var energies: [Float] = []
+            var sum: Double = 0.0
+            var count = 0
+            while file.framePosition < file.length, !Task.isCancelled {
+                try file.read(into: buffer)
+                guard buffer.frameLength > 0, let samples = buffer.floatChannelData else { return nil }
+                for frame in 0 ..< Int(buffer.frameLength) {
+                    var energy = 0.0
+                    for channel in 0 ..< channels {
+                        let value = samples[channel][frame]
+                        let finite = value.isFinite ? Double(value) : 0.0
+                        energy += finite * finite
+                    }
+                    sum += energy / Double(channels)
+                    count += 1
+                    if count == window {
+                        energies.append(Float(sqrt(sum / Double(count))))
+                        count = 0
+                        sum = 0.0
+                    }
+                }
+            }
+            guard !Task.isCancelled else { return nil }
+            return AyuMusicBeatDetector.detect(energies: energies, step: Double(window) / sampleRate)
+        } catch { return nil }
+    }
+}
