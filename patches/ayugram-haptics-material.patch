--- /dev/null
+++ b/submodules/TelegramUI/Sources/AyuMusicHapticsTimeline.swift
@@ -0,0 +1,64 @@
+import Foundation
+
+struct AyuMusicBeat: Sendable {
+    let time: Double
+    let intensity: Float
+}
+
+/// Detects local energy attacks, never inventing a fixed pulse rate for quiet audio.
+enum AyuMusicBeatDetector {
+    static func detect(energies: [Float], step: Double) -> [AyuMusicBeat] {
+        guard energies.count >= 3, step.isFinite, step > 0.0 else { return [] }
+        var result: [AyuMusicBeat] = []
+        var lastTime = -1.0
+        for index in 1 ..< energies.count - 1 {
+            let energy = energies[index]
+            guard energy.isFinite, energy > 0.012, energy > energies[index - 1], energy >= energies[index + 1] else { continue }
+            let start = max(0, index - 16)
+            let end = min(energies.count, index + 17)
+            let mean = energies[start ..< end].reduce(Float(0.0)) { $0 + ($1.isFinite ? max(0.0, $1) : 0.0) } / Float(end - start)
+            let time = Double(index) * step
+            guard energy > mean * 1.45 + 0.008, time - lastTime >= 0.16 else { continue }
+            result.append(AyuMusicBeat(time: time, intensity: min(1.0, max(0.25, (energy - mean) / energy))))
+            lastTime = time
+        }
+        return result
+    }
+}
+
+/// Follows the player's clock, dropping missed beats after pauses, seeks and stalls.
+final class AyuMusicHapticsTimeline {
+    private let beats: [AyuMusicBeat]
+    private var cursor = 0
+    private var lastTime: Double?
+    init(beats: [AyuMusicBeat]) { self.beats = beats }
+
+    func reset() { self.lastTime = nil }
+
+    private func seek(to time: Double) {
+        var low = 0
+        var high = self.beats.count
+        while low < high {
+            let middle = (low + high) / 2
+            if self.beats[middle].time <= time { low = middle + 1 } else { high = middle }
+        }
+        self.cursor = low
+    }
+
+    func advance(to time: Double, playing: Bool) -> Float? {
+        guard time.isFinite, time >= 0.0 else { self.reset(); return nil }
+        guard playing, let previous = self.lastTime, time >= previous, time - previous <= 0.35 else {
+            self.seek(to: time)
+            self.lastTime = playing ? time : nil
+            return nil
+        }
+        self.lastTime = time
+        var intensity: Float?
+        while self.cursor < self.beats.count, self.beats[self.cursor].time <= time {
+            let beat = self.beats[self.cursor]
+            if time - beat.time <= 0.08 { intensity = max(intensity ?? 0.0, beat.intensity) }
+            self.cursor += 1
+        }
+        return intensity
+    }
+}
