diff --git a/tools/ayu-tests/music-haptics/main.swift b/tools/ayu-tests/music-haptics/main.swift
new file mode 100644
index 0000000..b92209f
--- /dev/null
+++ b/tools/ayu-tests/music-haptics/main.swift
@@ -0,0 +1,32 @@
+import Foundation
+
+var checks = 0
+func check(_ value: @autoclosure () -> Bool, _ message: String) {
+    precondition(value(), message)
+    checks += 1
+}
+check(AyuMusicBeatDetector.detect(energies: Array(repeating: 0.0, count: 300), step: 0.02).isEmpty, "Silence must not generate artificial beats")
+check(AyuMusicBeatDetector.detect(energies: Array(repeating: 0.25, count: 300), step: 0.02).isEmpty, "A constant energy level must not generate a fixed pulse train")
+var energies = Array(repeating: Float(0.002), count: 200)
+for index in [25, 50, 75] { energies[index] = 0.5 }
+let beats = AyuMusicBeatDetector.detect(energies: energies, step: 0.02)
+check(beats.count == 3, "Distinct audio attacks produce three beats")
+check(zip(beats, [0.5, 1.0, 1.5]).allSatisfy { abs($0.0.time - $0.1) < 0.001 }, "Beat times follow the decoded audio, not wall-clock timers")
+check(beats.allSatisfy { $0.intensity.isFinite && $0.intensity >= 0.25 && $0.intensity <= 1.0 }, "Intensity stays in the hardware range")
+energies[100] = .nan
+check(AyuMusicBeatDetector.detect(energies: energies, step: 0.02).count == 3, "Invalid samples do not create extra events")
+let timeline = AyuMusicHapticsTimeline(beats: beats)
+check(timeline.advance(to: 0.45, playing: true) == nil, "Opening the player does not replay old events")
+check(timeline.advance(to: 0.51, playing: true) != nil, "Crossing a beat plays it")
+check(timeline.advance(to: 0.53, playing: true) == nil, "A beat plays once")
+check(timeline.advance(to: 0.90, playing: false) == nil, "Pause is silent")
+check(timeline.advance(to: 0.99, playing: true) == nil, "Resume resets the clock")
+check(timeline.advance(to: 1.01, playing: true) != nil, "Resume follows the next real beat")
+check(timeline.advance(to: 1.49, playing: true) == nil, "Seeking forward drops missed beats")
+check(timeline.advance(to: 1.51, playing: true) != nil, "After seeking, the next beat remains aligned")
+check(timeline.advance(to: 0.49, playing: true) == nil, "Seeking backward resets the event cursor")
+check(timeline.advance(to: 0.51, playing: true) != nil, "Replayed audio can replay its actual beat")
+timeline.reset()
+check(timeline.advance(to: 1.1, playing: true) == nil, "Leaving and reopening the player does not produce a burst")
+check(timeline.advance(to: .nan, playing: true) == nil, "Invalid clocks are silent")
+print("PASS: \(checks) audio beat and playback-clock checks")
