index 0000000..a8aa83b
--- /dev/null
+++ b/submodules/TelegramUI/Sources/AyuAttachmentMenuController.swift
@@ -0,0 +1,156 @@
+import Foundation
+import UIKit
+import AsyncDisplayKit
+import Display
+import TelegramPresentationData
+import AttachmentUI
+
+/// A compact attachment launcher. Every row opens Telegram's existing picker.
+final class AyuAttachmentMenuController: ViewController {
+    private let buttons: [AttachmentButtonType]
+    private let theme: PresentationTheme
+    private let russian: Bool
+    private let sourceRect: CGRect?
+    private let choose: (AttachmentButtonType) -> Void
+    private let outside = UIButton(type: .custom)
+    private let panel = UIVisualEffectView()
+    private let handleArea = UIView()
+    private let handle = UIView()
+    private let scrollView = UIScrollView()
+    private var rows: [UIButton] = []
+    private var layout: ContainerViewLayout?
+    private var expanded = false
+    private var appeared = false
+    private var closing = false
+
+    init(buttons: [AttachmentButtonType], theme: PresentationTheme, russian: Bool, sourceRect: CGRect?, choose: @escaping (AttachmentButtonType) -> Void) {
+        self.buttons = buttons
+        self.theme = theme
+        self.russian = russian
+        self.sourceRect = sourceRect
+        self.choose = choose
+        super.init(navigationBarPresentationData: nil)
+        self.statusBar.statusBarStyle = .Ignore
+    }
+
+    required init(coder: NSCoder) { fatalError("init(coder:) has not been implemented") }
+
+    override func loadDisplayNode() {
+        self.displayNode = ASDisplayNode()
+        self.displayNode.backgroundColor = .clear
+        self.displayNodeDidLoad()
+        self.outside.addTarget(self, action: #selector(self.cancel), for: .touchUpInside)
+        self.view.addSubview(self.outside)
+        self.panel.effect = UIBlurEffect(style: self.theme.overallDarkAppearance ? .systemChromeMaterialDark : .systemChromeMaterialLight)
+        self.panel.layer.cornerRadius = 26.0
+        self.panel.clipsToBounds = true
+        self.view.addSubview(self.panel)
+        self.panel.contentView.addSubview(self.handleArea)
+        self.handle.backgroundColor = self.theme.list.itemSecondaryTextColor.withAlphaComponent(0.4)
+        self.handle.layer.cornerRadius = 2.0
+        self.handleArea.addSubview(self.handle)
+        self.handleArea.addGestureRecognizer(UIPanGestureRecognizer(target: self, action: #selector(self.pan(_:))))
+        self.scrollView.alwaysBounceVertical = true
+        self.scrollView.showsVerticalScrollIndicator = false
+        self.panel.contentView.addSubview(self.scrollView)
+        for (index, type) in self.buttons.enumerated() {
+            let details = self.details(type)
+            let row = UIButton(type: .system)
+            row.tag = index
+            row.contentHorizontalAlignment = .left
+            row.titleLabel?.font = .systemFont(ofSize: 17.0)
+            row.setTitle(details.0, for: .normal)
+            row.setTitleColor(self.theme.list.itemPrimaryTextColor, for: .normal)
+            row.contentEdgeInsets = UIEdgeInsets(top: 0.0, left: 62.0, bottom: 0.0, right: 12.0)
+            let icon = UIImageView(image: UIImage(systemName: details.1))
+            icon.tintColor = .white
+            icon.contentMode = .center
+            icon.backgroundColor = details.2
+            icon.layer.cornerRadius = 18.0
+            icon.frame = CGRect(x: 16.0, y: 10.0, width: 36.0, height: 36.0)
+            row.addSubview(icon)
+            row.addTarget(self, action: #selector(self.pressed(_:)), for: .touchUpInside)
+            self.scrollView.addSubview(row)
+            self.rows.append(row)
+        }
+    }
+
+    private func details(_ type: AttachmentButtonType) -> (String, String, UIColor) {
+        switch type {
+        case .gallery: return (self.russian ? "Галерея" : "Gallery", "photo.on.rectangle", .systemPink)
+        case .richText: return (self.russian ? "Статья" : "Article", "doc.richtext", .systemGray)
+        case .file: return (self.russian ? "Файл" : "File", "doc.fill", .systemBlue)
+        case .location: return (self.russian ? "Геопозиция" : "Location", "location.fill", .systemGreen)
+        case .contact: return (self.russian ? "Контакт" : "Contact", "person.crop.circle.fill", .systemOrange)
+        case .poll: return (self.russian ? "Опрос" : "Poll", "chart.bar.fill", .systemPurple)
+        case .audio: return (self.russian ? "Музыка" : "Music", "music.note", .systemRed)
+        case .todo: return (self.russian ? "Список задач" : "Checklist", "checklist", .systemYellow)
+        case .gift: return (self.russian ? "Подарок" : "Gift", "gift.fill", .systemPink)
+        case .money: return (self.russian ? "Перевод" : "Transfer", "creditcard.fill", .systemGreen)
+        case .quickReply: return (self.russian ? "Быстрый ответ" : "Quick reply", "text.bubble.fill", .systemPurple)
+        case let .app(bot): return (bot.peer.compactDisplayTitle, "app.fill", .systemBlue)
+        default: return (type.key, "plus.circle.fill", .systemBlue)
+        }
+    }
+
+    override func containerLayoutUpdated(_ layout: ContainerViewLayout, transition: ContainedViewLayoutTransition) {
+        super.containerLayoutUpdated(layout, transition: transition)
+        self.layout = layout
+        self.outside.frame = CGRect(origin: .zero, size: layout.size)
+        let width = min(280.0, layout.size.width - layout.safeInsets.left - layout.safeInsets.right - 32.0)
+        let keyboardTop = layout.size.height - max(layout.inputHeight ?? 0.0, layout.intrinsicInsets.bottom)
+        let bottom = min(self.sourceRect?.minY ?? (keyboardTop - 56.0), keyboardTop) - 8.0
+        let top = max(layout.safeInsets.top, layout.statusBarHeight ?? 0.0) + 12.0
+        let desired = 20.0 + CGFloat(self.expanded ? self.rows.count : min(4, self.rows.count)) * 56.0
+        let height = min(desired, max(0.0, bottom - top))
+        let x = min(max(layout.safeInsets.left + 16.0, self.sourceRect?.minX ?? 16.0), layout.size.width - layout.safeInsets.right - width - 16.0)
+        transition.updateFrame(view: self.panel, frame: CGRect(x: x, y: bottom - height, width: width, height: height))
+        self.handleArea.frame = CGRect(x: 0.0, y: 0.0, width: width, height: 20.0)
+        self.handle.frame = CGRect(x: floor((width - 32.0) * 0.5), y: 7.0, width: 32.0, height: 4.0)
+        self.scrollView.frame = CGRect(x: 0.0, y: 20.0, width: width, height: max(0.0, height - 20.0))
+        for (index, row) in self.rows.enumerated() {
+            row.frame = CGRect(x: 0.0, y: CGFloat(index) * 56.0, width: width, height: 56.0)
+        }
+        self.scrollView.contentSize = CGSize(width: width, height: CGFloat(self.rows.count) * 56.0)
+    }
+
+    override func viewDidAppear(_ animated: Bool) {
+        super.viewDidAppear(animated)
+        guard !self.appeared else { return }
+        self.appeared = true
+        self.panel.alpha = 0.0
+        self.panel.transform = CGAffineTransform(translationX: 0.0, y: 12.0).scaledBy(x: 0.94, y: 0.94)
+        UIView.animate(withDuration: 0.22, delay: 0.0, options: [.curveEaseOut], animations: {
+            self.panel.alpha = 1.0
+            self.panel.transform = .identity
+        })
+    }
+
+    @objc private func pan(_ gesture: UIPanGestureRecognizer) {
+        guard gesture.state == .ended, let layout = self.layout else { return }
+        let distance = gesture.translation(in: self.view).y
+        guard abs(distance) > 12.0 else { return }
+        self.expanded = distance < 0.0
+        self.containerLayoutUpdated(layout, transition: .animated(duration: 0.25, curve: .easeInOut))
+    }
+
+    private func close(selected: AttachmentButtonType?) {
+        guard !self.closing else { return }
+        self.closing = true
+        UIView.animate(withDuration: 0.16, animations: {
+            self.panel.alpha = 0.0
+            self.panel.transform = CGAffineTransform(translationX: 0.0, y: 12.0)
+        }, completion: { [weak self] _ in
+            guard let self else { return }
+            self.dismiss(completion: {
+                if let selected { self.choose(selected) }
+            })
+        })
+    }
+
+    @objc private func cancel() { self.close(selected: nil) }
+    @objc private func pressed(_ sender: UIButton) {
+        guard self.buttons.indices.contains(sender.tag) else { return }
+        self.close(selected: self.buttons[sender.tag])
+    }
+}
