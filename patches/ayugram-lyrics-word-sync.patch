@@ -0,0 +1,112 @@
+import UIKit
+
+/// Draws the same shaped text twice, clipping the white layer to playback progress.
+/// Word rectangles are cached; display ticks never reshape or cross-fade the text.
+final class AyuLyricsLineLabel: UIView {
+    var text = "" { didSet { self.invalidateText() } }
+    var font = UIFont.boldSystemFont(ofSize: 30.0) { didSet { self.invalidateText() } }
+    var textColor = UIColor(white: 1.0, alpha: 0.32) { didSet { self.invalidateText() } }
+    var words: [AyuLyricsWord] = [] { didSet { self.invalidateText() } }
+
+    private let storage = NSTextStorage()
+    private let manager = NSLayoutManager()
+    private let container = NSTextContainer(size: .zero)
+    private var preparedWidth: CGFloat = -1.0
+    private var rectangles: [[CGRect]] = []
+    private var rightToLeft: [Bool] = []
+    private var progresses: [Double] = []
+    private var emptyLineActive = false
+
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+        self.isOpaque = false
+        self.contentMode = .redraw
+        self.container.lineFragmentPadding = 0.0
+        self.manager.addTextContainer(self.container)
+        self.storage.addLayoutManager(self.manager)
+        self.isAccessibilityElement = true
+        self.accessibilityTraits = .staticText
+    }
+
+    required init?(coder: NSCoder) { fatalError("init(coder:) has not been implemented") }
+
+    private func invalidateText() {
+        self.preparedWidth = -1.0
+        self.accessibilityLabel = self.text
+        self.setNeedsDisplay()
+    }
+
+    private func prepare(width: CGFloat) {
+        let width = max(1.0, width)
+        guard self.preparedWidth != width else { return }
+        self.preparedWidth = width
+        self.container.size = CGSize(width: width, height: .greatestFiniteMagnitude)
+        self.storage.setAttributedString(NSAttributedString(string: self.text, attributes: [.font: self.font, .foregroundColor: self.textColor]))
+        self.manager.ensureLayout(for: self.container)
+        self.rectangles = []
+        self.rightToLeft = []
+        var offset = 0
+        for word in self.words {
+            let segment = word.text as NSString
+            let visible = word.text.trimmingCharacters(in: .whitespacesAndNewlines)
+            let local = segment.range(of: visible)
+            var rects: [CGRect] = []
+            if !visible.isEmpty, local.location != NSNotFound, offset + local.location + local.length <= self.storage.length {
+                let characters = NSRange(location: offset + local.location, length: local.length)
+                let glyphs = self.manager.glyphRange(forCharacterRange: characters, actualCharacterRange: nil)
+                self.manager.enumerateEnclosingRects(forGlyphRange: glyphs, withinSelectedGlyphRange: NSRange(location: NSNotFound, length: 0), in: self.container, using: { rect, _ in
+                    rects.append(rect)
+                })
+            }
+            self.rectangles.append(rects)
+            let firstLetter = visible.unicodeScalars.first(where: { CharacterSet.letters.contains($0) })
+            self.rightToLeft.append(firstLetter.map { (0x0590 ... 0x08ff).contains($0.value) || (0xfb1d ... 0xfdff).contains($0.value) || (0xfe70 ... 0xfeff).contains($0.value) } ?? false)
+            offset += segment.length
+        }
+    }
+
+    override func sizeThatFits(_ size: CGSize) -> CGSize {
+        self.prepare(width: size.width)
+        return CGSize(width: size.width, height: max(self.font.lineHeight, ceil(self.manager.usedRect(for: self.container).maxY)))
+    }
+
+    func setProgresses(_ values: [Double], emptyLineActive: Bool = false) {
+        // Bound redraw frequency without adding any animation delay to the audio clock.
+        let quantized = values.map { ($0 * 120.0).rounded() / 120.0 }
+        guard quantized != self.progresses || emptyLineActive != self.emptyLineActive else { return }
+        self.progresses = quantized
+        self.emptyLineActive = emptyLineActive
+        self.setNeedsDisplay()
+    }
+
+    override func draw(_ rect: CGRect) {
+        self.prepare(width: self.bounds.width)
+        let glyphs = self.manager.glyphRange(for: self.container)
+        self.manager.drawGlyphs(forGlyphRange: glyphs, at: .zero)
+        guard let context = UIGraphicsGetCurrentContext() else { return }
+        let path = CGMutablePath()
+        if self.emptyLineActive { path.addRect(self.bounds) }
+        for index in self.rectangles.indices where index < self.progresses.count {
+            let rects = self.rectangles[index]
+            let totalWidth = rects.reduce(CGFloat(0.0)) { $0 + $1.width }
+            var remaining = totalWidth * CGFloat(self.progresses[index])
+            for rectangle in rects {
+                let width = min(rectangle.width, max(0.0, remaining))
+                if width > 0.0 {
+                    let x = self.rightToLeft[index] ? rectangle.maxX - width : rectangle.minX
+                    path.addRect(CGRect(x: x, y: rectangle.minY, width: width, height: rectangle.height))
+                }
+                remaining -= rectangle.width
+            }
+        }
+        guard !path.isEmpty else { return }
+        context.saveGState()
+        context.addPath(path)
+        context.clip()
+        let characters = NSRange(location: 0, length: self.storage.length)
+        self.manager.addTemporaryAttribute(.foregroundColor, value: UIColor.white, forCharacterRange: characters)
+        self.manager.drawGlyphs(forGlyphRange: glyphs, at: .zero)
+        self.manager.removeTemporaryAttribute(.foregroundColor, forCharacterRange: characters)
+        context.restoreGState()
+    }
+}
