diff --git a/tools/ayu-tests/lyrics/main.swift b/tools/ayu-tests/lyrics/main.swift
new file mode 100644
index 0000000..2bde8bd
--- /dev/null
+++ b/tools/ayu-tests/lyrics/main.swift
@@ -0,0 +1,85 @@
+import Foundation
+
+func check(_ condition: @autoclosure () -> Bool, _ message: String) {
+    precondition(condition(), message)
+}
+func near(_ value: Double, _ expected: Double) -> Bool { abs(value - expected) < 0.00001 }
+
+// Synthetic text only: timings exercise pauses, overlapping vocals, whitespace and Unicode.
+let document = """
+version: '1.0'
+metadata:
+  title: 'Timing fixture'
+  artist: 'Test'
+lines:
+  - text: 'Тест  🌙!'
+    start_ms: 1000
+    end_ms: 5000
+    words:
+      - text: 'Тест  '
+        start_ms: 1000
+        end_ms: 1800
+      - text: '🌙!'
+        start_ms: 3100
+        end_ms: 5000
+  - text: '回声'
+    start_ms: 4000
+    end_ms: 6000
+    words:
+      - text: '回'
+        start_ms: 4000
+        end_ms: 5100
+      - text: '声'
+        start_ms: 4800
+        end_ms: 6000
+plain: |
+  Тест  🌙!
+  回声
+"""
+let lines = ayuParseLyricsfile(document, duration: 10.0)
+check(lines.count == 2, "Block YAML Lyricsfile loads both lines")
+check(lines.allSatisfy { $0.exactWordTiming }, "Real word timings remain exact")
+check(lines[0].words.map { $0.text }.joined() == "Тест  🌙!", "Keep original whitespace and Unicode")
+check(near(lines[0].words[1].time, 3.1), "Use word timestamp, not line interpolation")
+check(near(lines[0].words[0].endTime, 1.8), "Preserve vocal pause between words")
+check(near(AyuLyricsPlayback.progress(lines[0].words[0], at: 1.4), 0.5), "Progress follows the audio clock")
+check(near(AyuLyricsPlayback.progress(lines[0].words[1], at: 2.5), 0.0), "A real pause does not start the next word")
+check(AyuLyricsPlayback.visibleLines(lines, at: 4.5) == [0, 1], "Overlapping vocals stay highlighted")
+check(AyuLyricsPlayback.visibleLines(lines, at: 5.2) == [1], "Completed overlapping line is released")
+check(AyuLyricsPlayback.lineIndex(lines, at: 0.99) == nil, "No early line lead")
+check(AyuLyricsPlayback.lineIndex(lines, at: 4.0) == 1, "Switch exactly on time")
+check(AyuLyricsPlayback.lineIndex(lines, at: 1.2) == 0, "Seeking backwards restores the right line")
+check(near(AyuLyricsPlayback.progress(lines[0].words[0], at: 0.0), 0.0), "Seeking backwards clears word progress")
+check(near(AyuLyricsPlayback.progress(lines[0].words[0], at: .nan), 0.0), "Invalid clock does not propagate NaN")
+
+let indentless = document.replacingOccurrences(of: "\n  - text:", with: "\n- text:").replacingOccurrences(of: "\n    ", with: "\n  ")
+check(ayuParseLyricsfile(indentless).count == 2, "Accept YAML's indentless top-level sequence")
+check(ayuParseLyricsfile(document.replacingOccurrences(of: "version: '1.0'", with: "version: 1.0")).isEmpty, "Version must be a string")
+
+let ordinary = ayuParseLrc("[00:01.00]one two\n[00:11.00]three four", duration: 21.0)
+check(ordinary.count == 2 && !ordinary[0].exactWordTiming, "Line-only LRC is honestly marked approximate")
+check(near(ordinary[0].words[1].time, 6.0), "Short lines use the full interval instead of a 0.6 second word cap")
+check(near(ordinary[0].words[1].endTime, 11.0), "No arbitrary 90 percent cutoff")
+check(near(ordinary[1].words.last!.endTime, 21.0), "Last line uses track duration")
+check(near(AyuLyricsPlayback.progress(ordinary[0].words[1], at: 8.0), 0.4), "Long interval keeps progressing")
+
+let enhanced = ayuParseLrc("[00:01][00:11]<00:01>one <00:03>two<00:05>\n[00:20]end", duration: 25.0)
+check(enhanced.count == 3 && enhanced[0].exactWordTiming, "Enhanced LRC reads each word anchor")
+check(near(enhanced[0].words[1].time, 3.0), "Keep enhanced word start")
+check(near(enhanced[0].words[1].endTime, 5.0), "Trailing enhanced tag is the final word end")
+check(near(enhanced[1].words[1].time, 13.0), "Repeated chorus shifts enhanced word anchors")
+check(near(enhanced[1].endTime, 15.0), "Repeated chorus shifts ending tag")
+let mixed = ayuParseLrc("[00:01]<00:01>one two <00:05>three<00:07>")
+check(!mixed[0].exactWordTiming && near(mixed[0].words[1].time, 3.0), "Mixed enhanced LRC preserves known anchors and interpolates missing ones")
+let offset = ayuParseLrc("[offset:500]\n[00:02]<00:02>one<00:03>")
+check(near(offset[0].time, 1.5) && near(offset[0].words[0].time, 1.5), "LRC offset applies to line and word anchors together")
+check(ayuParseLrc("[xx:yy]broken\n[00:nan]broken").isEmpty, "Reject malformed times")
+
+check(ayuParseLyricsfile(document.replacingOccurrences(of: "version: '1.0'", with: "version: '2.0'")).isEmpty, "Unknown Lyricsfile versions fall back safely")
+check(ayuParseLyricsfile(document.replacingOccurrences(of: "        start_ms: 1000", with: "        start_ms: true")).first?.exactWordTiming != true, "Boolean is not a timestamp")
+check(AyuLyricsYaml.parse("version: '1.0'\nversion: '1.0'\n") == nil, "Reject duplicate keys")
+check(AyuLyricsYaml.parse("version: '1.0'\nmetadata: &x value\nlines: *x\n") == nil, "Reject YAML anchors and aliases")
+check(AyuLyricsYaml.parse("version: '1.0'\nmetadata: !!unsafe value\n") == nil, "Reject YAML tags")
+check(AyuLyricsYaml.parse(String(repeating: "x", count: 1_048_577)) == nil, "Bound response size")
+check(AyuLyricsYaml.parse("version: '1.0'\nmetadata:\n  title: 'It''s a test'\n  artist: \"Escaped \\\"quote\\\"\"\n") != nil, "Read single and double quoted scalars")
+print("PASS: lyrics timings, audio-clock progress, seeks, overlap and safe YAML parsing")
