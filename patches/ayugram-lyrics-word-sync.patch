+++ b/submodules/TelegramUI/Sources/AyuLyricsTiming.swift
@@ -0,0 +1,196 @@
+import Foundation
+import CoreFoundation
+
+struct AyuLyricsWord: Equatable {
+    let time: Double
+    let endTime: Double
+    let text: String
+}
+
+struct AyuLyricsLine: Equatable {
+    let time: Double
+    let endTime: Double
+    let text: String
+    let words: [AyuLyricsWord]
+    let exactWordTiming: Bool
+}
+
+enum AyuLyrics: Equatable {
+    case synced([AyuLyricsLine])
+    case plain(String)
+    case instrumental
+    case notFound
+}
+
+enum AyuLyricsPlayback {
+    static func lineIndex(_ lines: [AyuLyricsLine], at timestamp: Double) -> Int? {
+        guard timestamp.isFinite else { return nil }
+        var low = 0
+        var high = lines.count
+        while low < high {
+            let middle = (low + high) / 2
+            if lines[middle].time <= timestamp { low = middle + 1 } else { high = middle }
+        }
+        return low == 0 ? nil : low - 1
+    }
+
+    static func visibleLines(_ lines: [AyuLyricsLine], at timestamp: Double) -> [Int] {
+        guard let index = self.lineIndex(lines, at: timestamp) else { return [] }
+        let active = (0 ... index).filter { timestamp < lines[$0].endTime }
+        return active.isEmpty ? [index] : active
+    }
+
+    static func progress(_ word: AyuLyricsWord, at timestamp: Double) -> Double {
+        guard timestamp.isFinite, timestamp >= word.time else { return 0.0 }
+        guard word.endTime > word.time else { return 1.0 }
+        return min(1.0, max(0.0, (timestamp - word.time) / (word.endTime - word.time)))
+    }
+}
+
+private func ayuLrcTime(_ value: Substring) -> Double? {
+    let parts = value.replacingOccurrences(of: ",", with: ".").split(separator: ":")
+    guard (2 ... 3).contains(parts.count), let last = parts.last, let seconds = Double(last), seconds.isFinite, seconds >= 0.0, seconds < 60.0 else { return nil }
+    var time = seconds
+    var multiplier = 60.0
+    for part in parts.dropLast().reversed() {
+        guard let number = Double(part), number.isFinite, number >= 0.0, number.rounded(.down) == number else { return nil }
+        time += number * multiplier
+        multiplier *= 60.0
+    }
+    return time.isFinite && time <= 86400.0 ? time : nil
+}
+
+private func ayuLrcWords(_ body: Substring) -> (words: [(Double?, String)], end: Double?) {
+    var words: [(Double?, String)] = []
+    var pending: Double?
+    var current = ""
+    func flush() {
+        let pieces = current.split(whereSeparator: { $0.isWhitespace })
+        for (index, piece) in pieces.enumerated() { words.append((index == 0 ? pending : nil, String(piece))) }
+        if !pieces.isEmpty { pending = nil }
+        current = ""
+    }
+    var rest = body
+    while let first = rest.first {
+        if first == "<", let close = rest.firstIndex(of: ">"), let time = ayuLrcTime(rest[rest.index(after: rest.startIndex) ..< close]) {
+            flush()
+            pending = time
+            rest = rest[rest.index(after: close)...]
+        } else {
+            current.append(first)
+            rest = rest.dropFirst()
+        }
+    }
+    flush()
+    return (words, pending)
+}
+
+/// Ordinary LRC only supplies line times. Its fallback spans the whole line interval;
+/// Enhanced LRC supplies real word anchors, which are preserved without a speed cap.
+func ayuParseLrc(_ text: String, duration: Double? = nil) -> [AyuLyricsLine] {
+    guard text.utf8.count <= 1_048_576 else { return [] }
+    let source = text.components(separatedBy: .newlines)
+    var offset = 0.0
+    for value in source {
+        let tag = value.trimmingCharacters(in: .whitespaces)
+        if tag.hasPrefix("[offset:"), let end = tag.firstIndex(of: "]"), let milliseconds = Double(tag[tag.index(tag.startIndex, offsetBy: 8) ..< end]), milliseconds.isFinite {
+            offset = milliseconds / 1000.0
+        }
+    }
+    var raw: [(Double, [(Double?, String)], Double?, Int)] = []
+    for value in source {
+        var rest = Substring(value.trimmingCharacters(in: .whitespaces))
+        var times: [Double] = []
+        while rest.hasPrefix("["), let close = rest.firstIndex(of: "]") {
+            if let time = ayuLrcTime(rest[rest.index(after: rest.startIndex) ..< close]) { times.append(time) }
+            rest = rest[rest.index(after: close)...]
+        }
+        let parsed = ayuLrcWords(rest)
+        for time in times {
+            let shift = time - (times.first ?? time) - offset
+            let words = parsed.words.map { ($0.0.map { max(0.0, $0 + shift) }, $0.1) }
+            raw.append((max(0.0, time - offset), words, parsed.end.map { max(0.0, $0 + shift) }, raw.count))
+        }
+    }
+    raw.sort { $0.0 == $1.0 ? $0.3 < $1.3 : $0.0 < $1.0 }
+    var result: [AyuLyricsLine] = []
+    for (index, line) in raw.enumerated() {
+        let following = raw.dropFirst(index + 1).first(where: { $0.0 > line.0 })?.0
+        let fallbackEnd = duration.flatMap { $0.isFinite && $0 > line.0 ? $0 : nil } ?? (line.0 + max(2.0, Double(line.1.count) * 0.6))
+        let end = max(line.0, line.2 ?? following ?? fallbackEnd)
+        var starts = line.1.map { $0.0 }
+        var cursor = 0
+        while cursor < starts.count {
+            let anchor = starts[cursor] ?? line.0
+            starts[cursor] = anchor
+            var next = cursor + 1
+            while next < starts.count && starts[next] == nil { next += 1 }
+            let boundary = max(anchor, next < starts.count ? (starts[next] ?? end) : end)
+            let weights = line.1[cursor ..< next].map { Double(max(1, $0.1.count)) }
+            let total = max(1.0, weights.reduce(0.0, +))
+            var consumed = 0.0
+            for word in cursor ..< next {
+                starts[word] = anchor + (boundary - anchor) * consumed / total
+                consumed += weights[word - cursor]
+            }
+            cursor = next
+        }
+        var previous = line.0
+        var words: [AyuLyricsWord] = []
+        for word in line.1.indices {
+            let start = max(previous, starts[word] ?? previous)
+            let stop = max(start, word + 1 < starts.count ? (starts[word + 1] ?? end) : end)
+            words.append(AyuLyricsWord(time: start, endTime: stop, text: line.1[word].1 + (word + 1 < line.1.count ? " " : "")))
+            previous = start
+        }
+        result.append(AyuLyricsLine(time: line.0, endTime: max(end, words.last?.endTime ?? end), text: line.1.map { $0.1 }.joined(separator: " "), words: words, exactWordTiming: !words.isEmpty && line.1.allSatisfy { $0.0 != nil }))
+    }
+    return result
+}
+
+private func ayuLyricsMilliseconds(_ value: Any?) -> Double? {
+    guard let value = value as? NSNumber, CFGetTypeID(value) != CFBooleanGetTypeID() else { return nil }
+    let number = value.doubleValue
+    guard number.isFinite, number >= 0.0, number <= 86_400_000.0, number.rounded(.down) == number else { return nil }
+    return number / 1000.0
+}
+
+/// The current Lyricsfile draft stores exact word times in YAML, not syncedLyrics.
+func ayuParseLyricsfile(_ source: String, duration: Double? = nil) -> [AyuLyricsLine] {
+    guard let root = AyuLyricsYaml.parse(source), root["version"] as? String == "1.0", let entries = root["lines"] as? [[String: Any]], entries.count <= 10000 else { return [] }
+    let sorted = entries.enumerated().sorted { left, right in
+        let a = ayuLyricsMilliseconds(left.element["start_ms"]) ?? .infinity
+        let b = ayuLyricsMilliseconds(right.element["start_ms"]) ?? .infinity
+        return a == b ? left.offset < right.offset : a < b
+    }.map { $0.element }
+    var result: [AyuLyricsLine] = []
+    for (index, entry) in sorted.enumerated() {
+        guard let text = entry["text"] as? String, let start = ayuLyricsMilliseconds(entry["start_ms"]) else { continue }
+        let next = sorted.dropFirst(index + 1).compactMap { ayuLyricsMilliseconds($0["start_ms"]) }.first(where: { $0 > start })
+        let fallback = next ?? duration.flatMap { $0.isFinite && $0 > start ? $0 : nil } ?? (start + 5.0)
+        let end = max(start, ayuLyricsMilliseconds(entry["end_ms"]) ?? fallback)
+        let sourceWords = entry["words"] as? [[String: Any]] ?? []
+        var words: [AyuLyricsWord] = []
+        for (wordIndex, value) in sourceWords.enumerated() {
+            guard let valueText = value["text"] as? String, let time = ayuLyricsMilliseconds(value["start_ms"]), time >= (words.last?.time ?? 0.0) else { words = []; break }
+            let nextTime = wordIndex + 1 < sourceWords.count ? ayuLyricsMilliseconds(sourceWords[wordIndex + 1]["start_ms"]) : nil
+            let stop = ayuLyricsMilliseconds(value["end_ms"]) ?? nextTime ?? end
+            guard stop >= time else { words = []; break }
+            words.append(AyuLyricsWord(time: time, endTime: stop, text: valueText))
+        }
+        if !words.isEmpty && words.map({ $0.text }).joined() == text {
+            result.append(AyuLyricsLine(time: min(start, words[0].time), endTime: max(end, words.map { $0.endTime }.max() ?? end), text: text, words: words, exactWordTiming: true))
+        } else {
+            let pieces = text.split(whereSeparator: { $0.isWhitespace }).map(String.init)
+            let total = max(1.0, pieces.reduce(0.0) { $0 + Double($1.count) })
+            var cursor = start
+            let estimated = pieces.enumerated().map { index, piece -> AyuLyricsWord in
+                let stop = cursor + (end - start) * Double(piece.count) / total
+                defer { cursor = stop }
+                return AyuLyricsWord(time: cursor, endTime: stop, text: piece + (index + 1 < pieces.count ? " " : ""))
+            }
+            result.append(AyuLyricsLine(time: start, endTime: end, text: pieces.joined(separator: " "), words: estimated, exactWordTiming: false))
+        }
+    }
+    return result.sorted { $0.time < $1.time }
+}
diff --git a/submodules/TelegramUI/Sources/AyuLyricsYaml.swift b/submodules/TelegramUI/Sources/AyuLyricsYaml.swift
new file mode 100644
index 0000000..ba3c84b
--- /dev/null
+++ b/submodules/TelegramUI/Sources/AyuLyricsYaml.swift
@@ -0,0 +1,166 @@
+import Foundation
+
+/// A bounded reader for Lyricsfile's block YAML. Unsupported YAML falls back to LRC.
+/// No tags, aliases, executable types or duplicate keys are accepted.
+enum AyuLyricsYaml {
+    private enum Invalid: Error { case document }
+    private struct Row {
+        let indent: Int
+        let body: String
+        let original: String
+    }
+
+    static func parse(_ source: String) -> [String: Any]? {
+        guard source.utf8.count <= 1_048_576 else { return nil }
+        do { return try Reader(source).read() } catch { return nil }
+    }
+
+    private final class Reader {
+        private let rows: [Row]
+        private var index = 0
+        private var nodes = 0
+
+        init(_ source: String) {
+            self.rows = source.components(separatedBy: .newlines).map { line in
+                let indent = line.prefix(while: { $0 == " " }).count
+                return Row(indent: indent, body: String(line.dropFirst(indent)), original: line)
+            }
+        }
+
+        private func skip() {
+            while self.index < self.rows.count {
+                let body = self.rows[self.index].body
+                if body.isEmpty || body.hasPrefix("#") || body == "---" || body == "..." { self.index += 1 } else { break }
+            }
+        }
+
+        func read() throws -> [String: Any] {
+            self.skip()
+            guard self.index < self.rows.count, self.rows[self.index].indent == 0 else { throw Invalid.document }
+            let result = try self.block(indent: 0, depth: 0)
+            self.skip()
+            guard self.index == self.rows.count, let mapping = result as? [String: Any] else { throw Invalid.document }
+            return mapping
+        }
+
+        private func block(indent: Int, depth: Int) throws -> Any {
+            guard depth < 10, self.index < self.rows.count else { throw Invalid.document }
+            let sequence = self.rows[self.index].body.hasPrefix("- ") || self.rows[self.index].body == "-"
+            if sequence {
+                var result: [Any] = []
+                while true {
+                    self.skip()
+                    guard self.index < self.rows.count, self.rows[self.index].indent >= indent else { break }
+                    let row = self.rows[self.index]
+                    guard row.indent == indent else { throw Invalid.document }
+                    if row.body != "-" && !row.body.hasPrefix("- ") { break }
+                    let tail = String(row.body.dropFirst()).trimmingCharacters(in: .whitespaces)
+                    self.index += 1
+                    if tail.isEmpty {
+                        self.skip()
+                        guard self.index < self.rows.count, self.rows[self.index].indent > indent else { throw Invalid.document }
+                        result.append(try self.block(indent: self.rows[self.index].indent, depth: depth + 1))
+                    } else if self.pair(tail) != nil {
+                        var mapping: [String: Any] = [:]
+                        try self.entry(tail, indent: indent + 2, depth: depth + 1, into: &mapping)
+                        try self.mappingEntries(indent: indent + 2, depth: depth + 1, into: &mapping)
+                        result.append(mapping)
+                    } else {
+                        result.append(try self.scalar(tail))
+                    }
+                }
+                return result
+            }
+            var result: [String: Any] = [:]
+            try self.mappingEntries(indent: indent, depth: depth, into: &result)
+            return result
+        }
+
+        private func mappingEntries(indent: Int, depth: Int, into mapping: inout [String: Any]) throws {
+            while true {
+                self.skip()
+                guard self.index < self.rows.count, self.rows[self.index].indent >= indent else { return }
+                let row = self.rows[self.index]
+                guard row.indent == indent else { throw Invalid.document }
+                self.index += 1
+                try self.entry(row.body, indent: indent, depth: depth, into: &mapping)
+            }
+        }
+
+        private func pair(_ body: String) -> (String, String)? {
+            guard let colon = body.firstIndex(of: ":") else { return nil }
+            let key = String(body[..<colon])
+            guard !key.isEmpty, key.allSatisfy({ $0.isASCII && ($0.isLetter || $0.isNumber || $0 == "_") }) else { return nil }
+            let rest = body[body.index(after: colon)...]
+            guard rest.isEmpty || rest.first?.isWhitespace == true else { return nil }
+            return (key, rest.trimmingCharacters(in: .whitespaces))
+        }
+
+        private func entry(_ body: String, indent: Int, depth: Int, into mapping: inout [String: Any]) throws {
+            self.nodes += 1
+            guard self.nodes <= 40_000, depth < 10, let (key, tail) = self.pair(body), mapping[key] == nil else { throw Invalid.document }
+            if tail.isEmpty || tail.hasPrefix("#") {
+                self.skip()
+                if self.index < self.rows.count, self.rows[self.index].indent > indent {
+                    mapping[key] = try self.block(indent: self.rows[self.index].indent, depth: depth + 1)
+                } else if self.index < self.rows.count, self.rows[self.index].indent == indent, self.rows[self.index].body.hasPrefix("- ") {
+                    mapping[key] = try self.block(indent: indent, depth: depth + 1)
+                } else { mapping[key] = NSNull() }
+            } else if ["|", "|-", "|+", ">", ">-", ">+"].contains(tail) {
+                var parts: [String] = []
+                var contentIndent: Int?
+                while self.index < self.rows.count {
+                    let row = self.rows[self.index]
+                    if !row.body.isEmpty && row.indent <= indent { break }
+                    if !row.body.isEmpty && contentIndent == nil { contentIndent = row.indent }
+                    guard row.body.isEmpty || row.indent >= (contentIndent ?? row.indent) else { throw Invalid.document }
+                    parts.append(row.body.isEmpty ? "" : String(row.original.dropFirst(contentIndent ?? row.indent)))
+                    self.index += 1
+                }
+                var value = parts.joined(separator: tail.hasPrefix(">") ? " " : "\n")
+                if !tail.hasSuffix("-") { value += "\n" }
+                mapping[key] = value
+            } else { mapping[key] = try self.scalar(tail) }
+        }
+
+        private func scalar(_ source: String) throws -> Any {
+            var value = source
+            if value.hasPrefix("\"") || value.hasPrefix("'") {
+                let quote = value.first!
+                var cursor = value.index(after: value.startIndex)
+                var result = ""
+                while cursor < value.endIndex {
+                    let character = value[cursor]
+                    let next = value.index(after: cursor)
+                    if character == quote {
+                        if quote == "'", next < value.endIndex, value[next] == "'" { result.append("'"); cursor = value.index(after: next); continue }
+                        let suffix = value[next...].trimmingCharacters(in: .whitespaces)
+                        guard suffix.isEmpty || suffix.hasPrefix("#") else { throw Invalid.document }
+                        if quote == "\"" {
+                            let quoted = String(value[...cursor])
+                            guard let data = ("[" + quoted + "]").data(using: .utf8), let array = try? JSONSerialization.jsonObject(with: data) as? [String], let decoded = array.first else { throw Invalid.document }
+                            return decoded
+                        }
+                        return result
+                    }
+                    if quote == "\"", character == "\\" {
+                        guard next < value.endIndex else { throw Invalid.document }
+                        result.append(character); result.append(value[next]); cursor = value.index(after: next)
+                    } else { result.append(character); cursor = next }
+                }
+                throw Invalid.document
+            }
+            if let comment = value.range(of: " #") { value = String(value[..<comment.lowerBound]).trimmingCharacters(in: .whitespaces) }
+            guard !value.contains("\t"), let first = value.first, !"&*!{%".contains(first) || value == "{}" else { throw Invalid.document }
+            if value == "[]" { return [Any]() }
+            if value == "{}" { return [String: Any]() }
+            if first == "[" || first == "]" || first == "}" { throw Invalid.document }
+            if value == "null" || value == "~" { return NSNull() }
+            if value == "true" { return true }
+            if value == "false" { return false }
+            if let number = Int64(value) { return NSNumber(value: number) }
+            if let number = Double(value) { return NSNumber(value: number) }
+            return value
+        }
+    }
+}
