@@ -0,0 +1,349 @@
+import Foundation
+import UIKit
+import Security
+import Display
+import TelegramCore
+import AccountContext
+import EntityKeyboard
+import EmojiStatusSelectionComponent
+
+/// The repository owner's badge desk, opened from any profile: hands out an AyuGram for iOS
+/// badge (custom emoji and text) and the label line under the name, by committing the change to
+/// assets/ayugram_ios_badges.json with the owner's GitHub token. Everyone sees it after their
+/// next registry refresh; the owner sees it at once.
+enum AyuBadgeEditor {
+    private static let repository = "dsn2fvhmn4-lgtm/AyuGramm-IOS"
+    private static let registryPath = "assets/ayugram_ios_badges.json"
+    private static let keychainService = "one.ayugram.badge-editor"
+
+    private struct LabelTemplate {
+        let kind: String
+        let title: (Bool) -> String
+        let text: (Bool) -> String
+    }
+
+    private static let labelTemplates: [LabelTemplate] = [
+        LabelTemplate(kind: "plugins", title: { ru in ru ? "Создатель плагинов" : "Plugin creator" }, text: { _ in "Этот человек официально подтверждён как создатель плагинов для AyuGram" }),
+        LabelTemplate(kind: "sponsor", title: { ru in ru ? "Спонсор" : "Sponsor" }, text: { _ in "Этот человек — спонсор AyuGram для iOS" }),
+        LabelTemplate(kind: "developer", title: { ru in ru ? "Разработчик" : "Developer" }, text: { _ in "Этот человек — разработчик AyuGram для iOS" })
+    ]
+
+    static func canOpen(context: AccountContext) -> Bool {
+        return AyuSupportersManager.shared.canManageBadges(accountPeerId: context.account.peerId.id._internalGetInt64Value())
+    }
+
+    static func present(context: AccountContext, peerId: Int64, name: String, controller: ViewController?) {
+        guard AyuBadgeEditor.canOpen(context: context) else {
+            return
+        }
+        let ru = context.sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru")
+        let present: (UIViewController) -> Void = { controller in
+            context.sharedContext.applicationBindings.presentNativeController(controller)
+        }
+
+        let sheet = AyuBadgeEditor.menu(title: name, message: ru ? "Бейдж и надпись AyuGram для iOS" : "AyuGram for iOS badge and label")
+        sheet.addAction(UIAlertAction(title: ru ? "Выдать бейдж…" : "Give a badge…", style: .default, handler: { _ in
+            AyuBadgeEditor.chooseEmoji(context: context, controller: controller, peerId: peerId, ru: ru, present: present)
+        }))
+        sheet.addAction(UIAlertAction(title: ru ? "Бейдж без эмодзи…" : "Badge without emoji…", style: .default, handler: { _ in
+            AyuBadgeEditor.askText(title: ru ? "Текст бейджа" : "Badge text", message: ru ? "Покажется стандартный значок разработчика." : "The standard developer mark is shown.", initial: "", ru: ru, present: present, done: { text in
+                AyuBadgeEditor.commit(peerId: peerId, ru: ru, present: present, change: { entry in
+                    entry["documentId"] = nil
+                    entry["title"] = text
+                })
+            })
+        }))
+        for template in AyuBadgeEditor.labelTemplates {
+            sheet.addAction(UIAlertAction(title: (ru ? "Надпись: " : "Label: ") + template.title(ru), style: .default, handler: { _ in
+                AyuBadgeEditor.commit(peerId: peerId, ru: ru, present: present, change: { entry in
+                    entry["label"] = ["kind": template.kind, "text": template.text(ru)]
+                })
+            }))
+        }
+        sheet.addAction(UIAlertAction(title: ru ? "Своя надпись…" : "Custom label…", style: .default, handler: { _ in
+            AyuBadgeEditor.askText(title: ru ? "Своя надпись" : "Custom label", message: ru ? "Покажется под именем и в шапке чата." : "Shown under the name and atop the chat.", initial: AyuSupportersManager.shared.label(peerId: peerId)?.text ?? "", ru: ru, present: present, done: { text in
+                AyuBadgeEditor.commit(peerId: peerId, ru: ru, present: present, change: { entry in
+                    entry["label"] = ["kind": "custom", "text": text]
+                })
+            })
+        }))
+        if AyuSupportersManager.shared.badge(peerId: peerId) != nil {
+            sheet.addAction(UIAlertAction(title: ru ? "Убрать бейдж" : "Remove badge", style: .destructive, handler: { _ in
+                AyuBadgeEditor.commit(peerId: peerId, ru: ru, present: present, change: { entry in
+                    entry["documentId"] = nil
+                    entry["title"] = nil
+                })
+            }))
+        }
+        if AyuSupportersManager.shared.label(peerId: peerId) != nil {
+            sheet.addAction(UIAlertAction(title: ru ? "Убрать надпись" : "Remove label", style: .destructive, handler: { _ in
+                AyuBadgeEditor.commit(peerId: peerId, ru: ru, present: present, change: { entry in
+                    entry["label"] = nil
+                })
+            }))
+        }
+        sheet.addAction(UIAlertAction(title: ru ? "Токен GitHub…" : "GitHub token…", style: .default, handler: { _ in
+            AyuBadgeEditor.askToken(ru: ru, present: present, done: {})
+        }))
+        sheet.addAction(UIAlertAction(title: ru ? "Отмена" : "Cancel", style: .cancel, handler: nil))
+        present(sheet)
+    }
+
+    // MARK: Steps
+
+    /// Picks the badge's emoji the way Telegram picks an emoji status: recent emoji and every
+    /// saved custom emoji pack, with search. The text comes next.
+    private static func chooseEmoji(context: AccountContext, controller: ViewController?, peerId: Int64, ru: Bool, present: @escaping (UIViewController) -> Void) {
+        let currentDocumentId: Int64?
+        let currentText: String
+        switch AyuSupportersManager.shared.badge(peerId: peerId) {
+        case let .ayuDeveloper(documentId, text)?:
+            currentDocumentId = documentId
+            currentText = text ?? ""
+        case let .developer(text)?:
+            currentDocumentId = nil
+            currentText = text ?? ""
+        default:
+            currentDocumentId = nil
+            currentText = ""
+        }
+        let next: (Int64?) -> Void = { documentId in
+            AyuBadgeEditor.askText(title: ru ? "Текст бейджа" : "Badge text", message: ru ? "Показывается при нажатии на бейдж. (name) заменится именем." : "Shown when the badge is tapped. (name) becomes the name.", initial: currentText, ru: ru, present: present, done: { text in
+                AyuBadgeEditor.commit(peerId: peerId, ru: ru, present: present, change: { entry in
+                    entry["documentId"] = documentId.map { NSNumber(value: $0) }
+                    entry["title"] = text
+                })
+            })
+        }
+        guard let controller, controller.isViewLoaded else {
+            next(currentDocumentId)
+            return
+        }
+        // The picker pops out of a point under the navigation bar and flies the pick back to it.
+        let anchor = UIView(frame: CGRect(x: controller.view.bounds.midX - 1.0, y: controller.view.safeAreaInsets.top + 56.0, width: 2.0, height: 2.0))
+        anchor.isUserInteractionEnabled = false
+        controller.view.addSubview(anchor)
+        let picker = EmojiStatusSelectionController(
+            context: context,
+            mode: .backgroundSelection(completion: { [weak anchor] file in
+                anchor?.removeFromSuperview()
+                guard let file, file.fileId.id != 0 else {
+                    return
+                }
+                next(file.fileId.id)
+            }),
+            sourceView: anchor,
+            emojiContent: EmojiPagerContentComponent.emojiInputData(
+                context: context,
+                animationCache: context.animationCache,
+                animationRenderer: context.animationRenderer,
+                isStandalone: false,
+                subject: .emoji,
+                hasTrending: false,
+                topReactionItems: [],
+                areUnicodeEmojiEnabled: false,
+                areCustomEmojiEnabled: true,
+                chatPeerId: context.account.peerId,
+                selectedItems: Set()
+            ),
+            currentSelection: currentDocumentId,
+            destinationItemView: { [weak anchor] in
+                return anchor
+            }
+        )
+        picker.pushController = { [weak controller] c in
+            controller?.push(c)
+        }
+        controller.present(picker, in: .window(.root))
+    }
+
+    private static func askText(title: String, message: String, initial: String, ru: Bool, present: @escaping (UIViewController) -> Void, done: @escaping (String) -> Void) {
+        let alert = UIAlertController(title: title, message: message, preferredStyle: .alert)
+        alert.addTextField(configurationHandler: { field in
+            field.text = initial
+            field.autocapitalizationType = .sentences
+        })
+        alert.addAction(UIAlertAction(title: ru ? "Отмена" : "Cancel", style: .cancel, handler: nil))
+        alert.addAction(UIAlertAction(title: ru ? "Сохранить" : "Save", style: .default, handler: { [weak alert] _ in
+            let text = alert?.textFields?.first?.text?.trimmingCharacters(in: .whitespacesAndNewlines) ?? ""
+            guard !text.isEmpty else {
+                AyuBadgeEditor.notify(ru ? "Текст не может быть пустым." : "The text can't be empty.", ru: ru, present: present)
+                return
+            }
+            done(String(text.prefix(160)))
+        }))
+        present(alert)
+    }
+
+    private static func askToken(ru: Bool, present: @escaping (UIViewController) -> Void, done: @escaping () -> Void) {
+        let alert = UIAlertController(title: ru ? "Токен GitHub" : "GitHub token", message: ru ? "Fine-grained токен с правом Contents: Read and write на \(AyuBadgeEditor.repository). Хранится только в связке ключей этого телефона." : "A fine-grained token with Contents: Read and write on \(AyuBadgeEditor.repository). Kept only in this phone's keychain.", preferredStyle: .alert)
+        alert.addTextField(configurationHandler: { field in
+            field.isSecureTextEntry = true
+            field.autocorrectionType = .no
+            field.autocapitalizationType = .none
+            field.placeholder = "github_pat_…"
+        })
+        alert.addAction(UIAlertAction(title: ru ? "Отмена" : "Cancel", style: .cancel, handler: nil))
+        alert.addAction(UIAlertAction(title: ru ? "Сохранить" : "Save", style: .default, handler: { [weak alert] _ in
+            let token = alert?.textFields?.first?.text?.trimmingCharacters(in: .whitespacesAndNewlines) ?? ""
+            guard !token.isEmpty else {
+                return
+            }
+            AyuBadgeEditor.saveToken(token)
+            done()
+        }))
+        present(alert)
+    }
+
+    /// Reads the registry from GitHub, applies `change` to this peer's entry (creating it, or
+    /// dropping it once nothing is left), and commits it straight to main.
+    private static func commit(peerId: Int64, ru: Bool, present: @escaping (UIViewController) -> Void, change: @escaping (inout [String: Any]) -> Void) {
+        guard let token = AyuBadgeEditor.readToken() else {
+            AyuBadgeEditor.askToken(ru: ru, present: present, done: {
+                AyuBadgeEditor.commit(peerId: peerId, ru: ru, present: present, change: change)
+            })
+            return
+        }
+        AyuBadgeEditor.upload(peerId: peerId, token: token, change: change, attempt: 0, completion: { result in
+            DispatchQueue.main.async {
+                switch result {
+                case let .success(data):
+                    AyuSupportersManager.shared.applyAyuRegistry(data: data)
+                    NotificationCenter.default.post(name: AyuVerifiedRegistry.didChangeNotification, object: nil)
+                    AyuBadgeEditor.notify(ru ? "Готово. У остальных появится в течение ~15 минут." : "Done. Others will see it within ~15 minutes.", ru: ru, present: present)
+                case let .failure(message):
+                    AyuBadgeEditor.notify((ru ? "Не удалось сохранить: " : "Couldn't save: ") + message, ru: ru, present: present)
+                }
+            }
+        })
+    }
+
+    private enum UploadResult {
+        case success(Data)
+        case failure(String)
+    }
+
+    private static func upload(peerId: Int64, token: String, change: @escaping (inout [String: Any]) -> Void, attempt: Int, completion: @escaping (UploadResult) -> Void) {
+        guard let url = URL(string: "https://api.github.com/repos/\(AyuBadgeEditor.repository)/contents/\(AyuBadgeEditor.registryPath)") else {
+            return completion(.failure("URL"))
+        }
+        var components = URLComponents(url: url, resolvingAgainstBaseURL: false)
+        components?.queryItems = [URLQueryItem(name: "ref", value: "main")]
+        guard let readURL = components?.url else {
+            return completion(.failure("URL"))
+        }
+        let session = URLSession(configuration: .ephemeral)
+        session.dataTask(with: AyuBadgeEditor.request(url: readURL, token: token, method: "GET", body: nil), completionHandler: { data, response, error in
+            guard let data, let http = response as? HTTPURLResponse else {
+                session.finishTasksAndInvalidate()
+                return completion(.failure(error?.localizedDescription ?? "network"))
+            }
+            guard http.statusCode == 200,
+                  let file = (try? JSONSerialization.jsonObject(with: data)) as? [String: Any],
+                  let sha = file["sha"] as? String,
+                  let encoded = file["content"] as? String,
+                  let current = Data(base64Encoded: encoded.replacingOccurrences(of: "\n", with: "")),
+                  var registry = (try? JSONSerialization.jsonObject(with: current)) as? [String: Any] else {
+                session.finishTasksAndInvalidate()
+                return completion(.failure("GitHub \(http.statusCode)"))
+            }
+            var badges = registry["badges"] as? [[String: Any]] ?? []
+            let index = badges.firstIndex(where: { ($0["id"] as? NSNumber)?.int64Value == peerId })
+            var entry = index.map { badges[$0] } ?? ["id": NSNumber(value: peerId)]
+            change(&entry)
+            let keepsSomething = entry["documentId"] != nil || entry["title"] != nil || entry["label"] != nil
+            if let index {
+                if keepsSomething {
+                    badges[index] = entry
+                } else {
+                    badges.remove(at: index)
+                }
+            } else if keepsSomething {
+                badges.append(entry)
+            }
+            registry["badges"] = badges
+            guard var updated = try? JSONSerialization.data(withJSONObject: registry, options: [.prettyPrinted, .sortedKeys, .withoutEscapingSlashes]) else {
+                session.finishTasksAndInvalidate()
+                return completion(.failure("JSON"))
+            }
+            updated.append(0x0a)
+            let body: [String: Any] = [
+                "message": "Update badge for \(peerId) [skip ci]",
+                "content": updated.base64EncodedString(),
+                "sha": sha,
+                "branch": "main"
+            ]
+            let bodyData = try? JSONSerialization.data(withJSONObject: body)
+            session.dataTask(with: AyuBadgeEditor.request(url: url, token: token, method: "PUT", body: bodyData), completionHandler: { _, response, error in
+                session.finishTasksAndInvalidate()
+                let status = (response as? HTTPURLResponse)?.statusCode ?? 0
+                if status == 200 || status == 201 {
+                    completion(.success(updated))
+                } else if status == 409 && attempt == 0 {
+                    // Someone committed in between; start again from the new file.
+                    AyuBadgeEditor.upload(peerId: peerId, token: token, change: change, attempt: 1, completion: completion)
+                } else if status == 401 || status == 403 {
+                    completion(.failure("GitHub \(status): токен не подходит / token rejected"))
+                } else {
+                    completion(.failure(error?.localizedDescription ?? "GitHub \(status)"))
+                }
+            }).resume()
+        }).resume()
+    }
+
+    private static func request(url: URL, token: String, method: String, body: Data?) -> URLRequest {
+        var request = URLRequest(url: url, cachePolicy: .reloadIgnoringLocalCacheData, timeoutInterval: 20.0)
+        request.httpMethod = method
+        request.setValue("Bearer " + token, forHTTPHeaderField: "Authorization")
+        request.setValue("application/vnd.github+json", forHTTPHeaderField: "Accept")
+        request.setValue("2022-11-28", forHTTPHeaderField: "X-GitHub-Api-Version")
+        if let body {
+            request.setValue("application/json", forHTTPHeaderField: "Content-Type")
+            request.httpBody = body
+        }
+        return request
+    }
+
+    // MARK: UI helpers
+
+    private static func menu(title: String?, message: String?) -> UIAlertController {
+        // Action sheets need an anchor on iPad; an alert works everywhere.
+        let style: UIAlertController.Style = UIDevice.current.userInterfaceIdiom == .pad ? .alert : .actionSheet
+        return UIAlertController(title: title, message: message, preferredStyle: style)
+    }
+
+    private static func notify(_ text: String, ru: Bool, present: @escaping (UIViewController) -> Void) {
+        let alert = UIAlertController(title: nil, message: text, preferredStyle: .alert)
+        alert.addAction(UIAlertAction(title: "OK", style: .default, handler: nil))
+        present(alert)
+    }
+
+    // MARK: Keychain
+
+    private static var tokenQuery: [String: Any] {
+        return [
+            kSecClass as String: kSecClassGenericPassword,
+            kSecAttrService as String: AyuBadgeEditor.keychainService,
+            kSecAttrAccount as String: "github"
+        ]
+    }
+
+    private static func readToken() -> String? {
+        var query = AyuBadgeEditor.tokenQuery
+        query[kSecReturnData as String] = true
+        query[kSecMatchLimit as String] = kSecMatchLimitOne
+        var result: AnyObject?
+        guard SecItemCopyMatching(query as CFDictionary, &result) == errSecSuccess, let data = result as? Data, let token = String(data: data, encoding: .utf8), !token.isEmpty else {
+            return nil
+        }
+        return token
+    }
+
+    private static func saveToken(_ token: String) {
+        SecItemDelete(AyuBadgeEditor.tokenQuery as CFDictionary)
+        var item = AyuBadgeEditor.tokenQuery
+        item[kSecValueData as String] = Data(token.utf8)
+        item[kSecAttrAccessible as String] = kSecAttrAccessibleWhenUnlockedThisDeviceOnly
+        SecItemAdd(item as CFDictionary, nil)
+    }
+}
