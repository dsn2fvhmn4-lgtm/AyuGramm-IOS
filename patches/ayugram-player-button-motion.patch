diff --git a/submodules/TelegramUI/Sources/AyuPlayerButtonMotion.swift b/submodules/TelegramUI/Sources/AyuPlayerButtonMotion.swift
new file mode 100644
index 00000000..2bc92251
--- /dev/null
+++ b/submodules/TelegramUI/Sources/AyuPlayerButtonMotion.swift
@@ -0,0 +1,85 @@
+import Foundation
+import UIKit
+
+/// Press feedback for player controls. The button's content (not its frame, which layout owns)
+/// shrinks under the finger and springs back on release; skip buttons also nudge toward their
+/// direction. Runs on `sublayerTransform`, so it never fights frame changes or transform-based
+/// presentation animations of the button itself.
+@MainActor
+func ayuAttachPressMotion(_ button: UIButton, scale: CGFloat = 0.82, nudge: CGFloat = 0.0) {
+    button.addAction(UIAction { [weak button] _ in
+        guard let button else { return }
+        ayuAnimateContent(button.layer, to: CATransform3DMakeScale(scale, scale, 1.0), stiffness: 600.0, damping: 32.0)
+    }, for: [.touchDown, .touchDragEnter])
+    button.addAction(UIAction { [weak button] _ in
+        guard let button else { return }
+        ayuAnimateContent(button.layer, to: CATransform3DIdentity, stiffness: 420.0, damping: 20.0)
+    }, for: [.touchUpOutside, .touchDragExit, .touchCancel])
+    button.addAction(UIAction { [weak button] _ in
+        guard let button else { return }
+        ayuAnimateContent(button.layer, to: CATransform3DIdentity, stiffness: 420.0, damping: 16.0)
+        if nudge != 0.0 && !UIAccessibility.isReduceMotionEnabled {
+            let shift = CAKeyframeAnimation(keyPath: "sublayerTransform.translation.x")
+            shift.values = [0.0, nudge, 0.0]
+            shift.keyTimes = [0.0, 0.35, 1.0]
+            shift.timingFunctions = [CAMediaTimingFunction(name: .easeOut), CAMediaTimingFunction(name: .easeInEaseOut)]
+            shift.duration = 0.32
+            shift.isAdditive = true
+            button.layer.add(shift, forKey: "ayuNudge")
+        }
+    }, for: .touchUpInside)
+}
+
+/// Swaps a button's symbol with a crossfade and a small pop, as when play turns into pause.
+@MainActor
+func ayuSetImageAnimated(_ button: UIButton, _ image: UIImage?) {
+    guard button.window != nil, !UIAccessibility.isReduceMotionEnabled else {
+        button.setImage(image, for: .normal)
+        return
+    }
+    UIView.transition(with: button, duration: 0.18, options: [.transitionCrossDissolve, .allowUserInteraction, .beginFromCurrentState], animations: {
+        button.setImage(image, for: .normal)
+    })
+    ayuPop(button)
+}
+
+/// Swaps a button's title with a crossfade and a small pop (the playback rate pill).
+@MainActor
+func ayuSetTitleAnimated(_ button: UIButton, _ title: String?) {
+    guard button.window != nil, !UIAccessibility.isReduceMotionEnabled, button.title(for: .normal) != title else {
+        button.setTitle(title, for: .normal)
+        return
+    }
+    UIView.transition(with: button, duration: 0.18, options: [.transitionCrossDissolve, .allowUserInteraction, .beginFromCurrentState], animations: {
+        button.setTitle(title, for: .normal)
+    })
+    ayuPop(button)
+}
+
+@MainActor
+private func ayuPop(_ button: UIButton) {
+    let pop = CASpringAnimation(keyPath: "sublayerTransform.scale")
+    pop.fromValue = 0.7
+    pop.toValue = 1.0
+    pop.stiffness = 380.0
+    pop.damping = 15.0
+    pop.duration = pop.settlingDuration
+    button.layer.add(pop, forKey: "ayuPop")
+}
+
+@MainActor
+private func ayuAnimateContent(_ layer: CALayer, to target: CATransform3D, stiffness: CGFloat, damping: CGFloat) {
+    let from = layer.presentation()?.sublayerTransform ?? layer.sublayerTransform
+    layer.sublayerTransform = target
+    guard !UIAccessibility.isReduceMotionEnabled else {
+        layer.removeAnimation(forKey: "ayuPress")
+        return
+    }
+    let spring = CASpringAnimation(keyPath: "sublayerTransform")
+    spring.fromValue = NSValue(caTransform3D: from)
+    spring.toValue = NSValue(caTransform3D: target)
+    spring.stiffness = stiffness
+    spring.damping = damping
+    spring.duration = spring.settlingDuration
+    layer.add(spring, forKey: "ayuPress")
+}
