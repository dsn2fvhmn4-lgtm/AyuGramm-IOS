+    // MARK: Genius (through api.popcat.xyz)
+
+    private func genius() {
+        let query = [self.artist, AyuMusicMetadata.searchTitle(self.title)].compactMap { $0 }.joined(separator: " ")
+        guard var components = URLComponents(string: "https://api.popcat.xyz/v2/lyrics") else {
+            self.providerDone()
+            return
+        }
+        components.queryItems = [URLQueryItem(name: "song", value: query)]
+        guard let url = components.url else {
+            self.providerDone()
+            return
+        }
+        self.load(url, completion: { [weak self] response in
+            guard let self else { return }
+            // A miss answers {"error": true, "message": {"error": "Song not found!"}}.
+            if let record = (self.json(response) as? [String: Any])?["message"] as? [String: Any], let raw = record["lyrics"] as? String, let text = ayuCleanGeniusLyrics(raw) {
+                let score = AyuMusicMetadata.matchScore(candidateTitle: record["title"] as? String ?? "", candidateArtist: record["artist"] as? String, candidateDuration: nil, title: self.title, artist: self.artist, duration: self.duration)
+                // Search, not an exact lookup: plain text, never above lyrics.ovh's exact path.
+                if score >= 0.55 {
+                    self.offer(AyuLyricsCandidate(lyrics: .plain(text), source: "Genius", score: min(score, 0.75)))
+                }
+            }
+            self.providerDone()
+        })
+    }
+}
+
+/// Genius page text without its header ("254 Contributors…Lyrics", the description up to
+/// "Read More"), section tags like "[Chorus]", "You might also like" and the trailing "Embed".
+func ayuCleanGeniusLyrics(_ raw: String) -> String? {
+    var text = raw
+    if let more = text.range(of: "Read More") {
+        text = String(text[more.upperBound...])
+    } else if text.range(of: #"^\d+ Contributors"#, options: .regularExpression) != nil, let header = text.range(of: "Lyrics") {
+        text = String(text[header.upperBound...])
+    }
+    let lines = text.components(separatedBy: .newlines).map { $0.trimmingCharacters(in: .whitespaces) }.filter { line in
+        if line.hasPrefix("[") && line.hasSuffix("]") { return false }
+        return line != "You might also like"
+    }
+    var result = lines.joined(separator: "\n")
+        .replacingOccurrences(of: #"\d*Embed$"#, with: "", options: .regularExpression)
+        .replacingOccurrences(of: #"\n{3,}"#, with: "\n\n", options: .regularExpression)
+        .trimmingCharacters(in: .whitespacesAndNewlines)
+    if result.count < 20 { result = "" }
+    return result.isEmpty ? nil : result
 }
