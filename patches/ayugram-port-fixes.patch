         try html.write(contentsOf: Data(("<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width\"><meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; img-src 'self'; media-src 'self'; style-src 'unsafe-inline'\"><title>" + title + "</title><style>body{font:16px system-ui;max-width:900px;margin:auto;padding:20px;background:#101923;color:#e6edf3}article{padding:16px;border-bottom:1px solid #345;white-space:pre-wrap;overflow-wrap:anywhere}small{color:#9ab}a{color:#7cf}img{max-width:100%;max-height:400px}</style></head><body><h1>" + title + "</h1>").utf8))
diff --git a/submodules/TelegramCore/Sources/AyuGram/AyuGrantedGift.swift b/submodules/TelegramCore/Sources/AyuGram/AyuGrantedGift.swift
new file mode 100644
index 00000000..640443ac
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuGram/AyuGrantedGift.swift
@@ -0,0 +1,54 @@
+import Foundation
+
+/// A gift the owner granted through the AyuGram for iOS badge registry. It exists only in the
+/// registry: everyone running the port sees it in the peer's profile, Telegram does not.
+/// "unique" gifts are drawn from Telegram's own models, backdrops and patterns of `giftId`;
+/// a "plain" gift can be upgraded to a unique one, and the holder of a unique one may wear,
+/// sign or transfer it.
+public struct AyuGrantedGift: Equatable {
+    public enum Kind: String {
+        case plain
+        case unique
+    }
+
+    /// Position in the registry entry's list, used to upgrade or remove this gift.
+    public let index: Int
+    public let kind: Kind
+    public let giftId: Int64
+    public let title: String?
+    public let number: Int32
+    public let model: String?
+    public let pattern: String?
+    public let backdrop: String?
+    public let date: Int32
+    /// The gift's message: the owner's or the holder's own signature.
+    public let text: String?
+    /// Worn as the holder's emoji status in AyuGram-IOS.
+    public let worn: Bool
+    /// Who handed the gift on, when it came by transfer rather than from the owner.
+    public let fromId: Int64?
+
+    init?(json: [String: Any], index: Int) {
+        let giftId = (json["giftId"] as? NSNumber)?.int64Value ?? (json["giftId"] as? String).flatMap(Int64.init)
+        guard let giftId, let kind = Kind(rawValue: json["kind"] as? String ?? "") else {
+            return nil
+        }
+        self.index = index
+        self.kind = kind
+        self.giftId = giftId
+        self.title = (json["title"] as? String).flatMap { $0.isEmpty ? nil : String($0.prefix(64)) }
+        self.number = max(1, (json["number"] as? NSNumber)?.int32Value ?? 1)
+        self.model = json["model"] as? String
+        self.pattern = json["pattern"] as? String
+        self.backdrop = json["backdrop"] as? String
+        self.date = (json["date"] as? NSNumber)?.int32Value ?? 0
+        self.text = (json["text"] as? String).flatMap { $0.isEmpty ? nil : String($0.prefix(120)) }
+        self.worn = (json["worn"] as? Bool) ?? false
+        self.fromId = (json["fromId"] as? NSNumber)?.int64Value ?? (json["fromId"] as? String).flatMap(Int64.init)
+    }
+
+    /// Shown as the gift's message, so nobody takes it for a gift Telegram knows about.
+    public static func note(_ russian: Bool) -> String {
+        return russian ? "Выдан в VoidGram. Виден только в VoidGram." : "Granted in VoidGram. Visible only in VoidGram."
+    }
+}
diff --git a/submodules/TelegramCore/Sources/AyuGram/AyuGrantedGifts.swift b/submodules/TelegramCore/Sources/AyuGram/AyuGrantedGifts.swift
new file mode 100644
index 00000000..31262d1c
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuGram/AyuGrantedGifts.swift
@@ -0,0 +1,494 @@
+import Foundation
+import Postbox
+import SwiftSignalKit
+
+/// Picks the attribute with this name, or the first one when the name is missing or unknown.
+private func ayuPick(_ attributes: [StarGift.UniqueGift.Attribute], name: String?, matches: (StarGift.UniqueGift.Attribute) -> String?) -> StarGift.UniqueGift.Attribute? {
+    let candidates = attributes.filter { matches($0) != nil }
+    if let name, let found = candidates.first(where: { matches($0) == name }) {
+        return found
+    }
+    return candidates.first
+}
+
+func ayuUniqueGift(_ granted: AyuGrantedGift, title: String, attributes: [StarGift.UniqueGift.Attribute], ownerPeerId: EnginePeer.Id) -> StarGift.UniqueGift? {
+    let model = ayuPick(attributes, name: granted.model, matches: { attribute in
+        if case let .model(name, _, _, _) = attribute { return name }
+        return nil
+    })
+    let pattern = ayuPick(attributes, name: granted.pattern, matches: { attribute in
+        if case let .pattern(name, _, _) = attribute { return name }
+        return nil
+    })
+    let backdrop = ayuPick(attributes, name: granted.backdrop, matches: { attribute in
+        if case let .backdrop(name, _, _, _, _, _, _) = attribute { return name }
+        return nil
+    })
+    guard let model, let pattern, let backdrop else {
+        return nil
+    }
+    let slug = "AyuGram-\(granted.giftId)-\(granted.number)"
+    return StarGift.UniqueGift(id: granted.giftId &+ Int64(granted.number), giftId: granted.giftId, title: granted.title ?? title, number: granted.number, slug: slug, owner: .peerId(ownerPeerId), attributes: [model, pattern, backdrop], availability: StarGift.UniqueGift.Availability(issued: granted.number, total: max(granted.number, 100000)), giftAddress: nil, resellAmounts: nil, resellForTonOnly: false, releasedBy: nil, valueAmount: nil, valueCurrency: nil, valueUsdAmount: nil, flags: [], themePeerId: nil, peerColor: nil, hostPeerId: nil, minOfferStars: nil, craftChancePermille: nil)
+}
+
+private let ayuGrantReferencePrefix = "ayugram-grant-"
+private let ayuGrantedSlugPrefix = "AyuGram-"
+
+/// The upgrade price the gift screen shows for a plain granted gift. Nothing is charged.
+public let ayuGrantedUpgradePrice: Int64 = 100
+
+/// The registry index of the account's own granted gift that a profile row stands for. The gift
+/// screen offers Telegram's upgrade for a plain one and wear, transfer and signing for a unique one;
+/// all of them go to the badge server.
+public func ayuGrantedGiftIndex(_ reference: StarGiftReference?) -> Int? {
+    guard case let .slug(slug)? = reference, slug.hasPrefix(ayuGrantReferencePrefix) else {
+        return nil
+    }
+    return Int(slug.dropFirst(ayuGrantReferencePrefix.count))
+}
+
+/// Fires at once and after every registry read that changed granted gifts.
+private func ayuGrantedGiftsUpdates() -> Signal<Void, NoError> {
+    return Signal { subscriber in
+        subscriber.putNext(Void())
+        let observer = NotificationCenter.default.addObserver(forName: AyuSupportersManager.grantedGiftsDidChange, object: nil, queue: nil, using: { _ in
+            subscriber.putNext(Void())
+        })
+        return ActionDisposable {
+            NotificationCenter.default.removeObserver(observer)
+        }
+    }
+}
+
+/// Granted gifts as profile gift rows, in the order given. A gift whose base gift or attributes
+/// Telegram does not return is left out.
+private func ayuGrantedGiftRows(account: Account, peerId: EnginePeer.Id, granted: [AyuGrantedGift]) -> Signal<[ProfileGiftsContext.State.StarGift], NoError> {
+    guard !granted.isEmpty else {
+        return .single([])
+    }
+    let catalog = _internal_cachedStarGifts(postbox: account.postbox)
+    |> take(1)
+    let uniqueIds = Array(Set(granted.filter { $0.kind == .unique }.map(\.giftId)))
+    let attributes = combineLatest(uniqueIds.map { giftId in
+        return _internal_getStarGiftUpgradeAttributes(account: account, giftId: giftId)
+        |> take(1)
+        |> map { (giftId, $0 ?? []) }
+    })
+    let ru = ayuRussian()
+    let isOwn = peerId == account.peerId
+    return combineLatest(catalog, attributes)
+    |> map { catalog, attributes -> [ProfileGiftsContext.State.StarGift] in
+        var generic: [Int64: StarGift.Gift] = [:]
+        for gift in catalog?.items ?? [] {
+            if case let .generic(value) = gift {
+                generic[value.id] = value
+            }
+        }
+        let attributesById = Dictionary(attributes, uniquingKeysWith: { first, _ in first })
+        return granted.compactMap { item -> ProfileGiftsContext.State.StarGift? in
+            let gift: StarGift
+            var reference: StarGiftReference?
+            var canUpgrade = false
+            var transferStars: Int64?
+            switch item.kind {
+            case .plain:
+                guard let base = generic[item.giftId] else { return nil }
+                gift = .generic(base)
+                // The holder upgrades a plain gift from the gift screen; it is priced as ayuGrantedUpgradePrice and costs nothing.
+                if isOwn && base.upgradeStars != nil {
+                    reference = .slug(slug: ayuGrantReferencePrefix + "\(item.index)")
+                    canUpgrade = true
+                }
+            case .unique:
+                guard let unique = ayuUniqueGift(item, title: generic[item.giftId]?.title ?? "Gift", attributes: attributesById[item.giftId] ?? [], ownerPeerId: peerId) else { return nil }
+                gift = .unique(unique)
+                // The holder transfers it for free, to anyone.
+                if isOwn {
+                    reference = .slug(slug: ayuGrantReferencePrefix + "\(item.index)")
+                    transferStars = 0
+                }
+            }
+            return ProfileGiftsContext.State.StarGift(gift: gift, reference: reference, fromPeer: nil, date: item.date, text: item.text ?? AyuGrantedGift.note(ru), entities: nil, nameHidden: false, savedToProfile: true, pinnedToTop: true, convertStars: nil, canUpgrade: canUpgrade, canExportDate: nil, upgradeStars: nil, transferStars: transferStars, canTransferDate: nil, canResaleDate: nil, collectionIds: nil, prepaidUpgradeHash: nil, upgradeSeparate: false, dropOriginalDetailsStars: nil, number: item.kind == .unique ? item.number : nil, isRefunded: false, canCraftAt: nil)
+        }
+    }
+}
+
+/// The peer's granted gifts as profile gift rows, pinned above the gifts Telegram returns. Emits an
+/// empty list at once, so the profile never waits for the attribute lookups, then follows the registry.
+public func ayuGrantedProfileGifts(account: Account, peerId: EnginePeer.Id) -> Signal<[ProfileGiftsContext.State.StarGift], NoError> {
+    let rows = ayuGrantedGiftsUpdates()
+    |> map { _ -> [AyuGrantedGift] in
+        return AyuSupportersManager.shared.grantedGifts(peerId: peerId.id._internalGetInt64Value())
+    }
+    |> distinctUntilChanged
+    |> mapToSignal { granted -> Signal<[ProfileGiftsContext.State.StarGift], NoError> in
+        return ayuGrantedGiftRows(account: account, peerId: peerId, granted: granted)
+    }
+    return .single([])
+    |> then(rows)
+}
+
+/// A random attribute of one kind, weighted by Telegram's rarity as the real upgrade is.
+private func ayuRandomAttributeName(_ attributes: [StarGift.UniqueGift.Attribute], _ match: (StarGift.UniqueGift.Attribute) -> (String, Int32)?) -> String? {
+    let options = attributes.compactMap(match)
+    let total = options.reduce(Int64(0)) { $0 + Int64(max($1.1, 0)) }
+    guard total > 0 else {
+        return options.randomElement()?.0
+    }
+    var roll = Int64.random(in: 0 ..< total)
+    for (name, weight) in options {
+        roll -= Int64(max(weight, 0))
+        if roll < 0 {
+            return name
+        }
+    }
+    return options.last?.0
+}
+
+/// Upgrades the account's plain granted gift for free: draws a model, backdrop and pattern from
+/// `attributes`, has the badge server commit them and returns the new profile row for the reveal.
+public func ayuUpgradeGrantedGift(account: Account, reference: StarGiftReference, attributes: [StarGift.UniqueGift.Attribute]) -> Signal<ProfileGiftsContext.State.StarGift, UpgradeStarGiftError> {
+    let accountPeerId = account.peerId.id._internalGetInt64Value()
+    guard let index = ayuGrantedGiftIndex(reference), let granted = AyuSupportersManager.shared.grantedGifts(peerId: accountPeerId).first(where: { $0.index == index }) else {
+        return .fail(.generic)
+    }
+    guard granted.kind == .plain else {
+        return .fail(.alreadyUpgraded)
+    }
+    let attributesSignal: Signal<[StarGift.UniqueGift.Attribute], NoError>
+    if attributes.isEmpty {
+        attributesSignal = _internal_getStarGiftUpgradeAttributes(account: account, giftId: granted.giftId)
+        |> take(1)
+        |> map { $0 ?? [] }
+    } else {
+        attributesSignal = .single(attributes)
+    }
+    let ru = ayuRussian()
+    return attributesSignal
+    |> castError(UpgradeStarGiftError.self)
+    |> mapToSignal { attributes -> Signal<ProfileGiftsContext.State.StarGift, UpgradeStarGiftError> in
+        let model = ayuRandomAttributeName(attributes) { attribute in
+            if case let .model(name, _, rarity, _) = attribute { return (name, rarity.permilleValue) }
+            return nil
+        }
+        let pattern = ayuRandomAttributeName(attributes) { attribute in
+            if case let .pattern(name, _, rarity) = attribute { return (name, rarity.permilleValue) }
+            return nil
+        }
+        let backdrop = ayuRandomAttributeName(attributes) { attribute in
+            if case let .backdrop(name, _, _, _, _, _, rarity) = attribute { return (name, rarity.permilleValue) }
+            return nil
+        }
+        guard let model, let pattern, let backdrop else {
+            return .fail(.generic)
+        }
+        return AyuBadgeServer.post(account: account, route: "upgrade", body: ["index": granted.index, "model": model, "backdrop": backdrop, "pattern": pattern], ru: ru)
+        |> mapError { _ -> UpgradeStarGiftError in
+            return .generic
+        }
+        |> mapToSignal { _ -> Signal<ProfileGiftsContext.State.StarGift, UpgradeStarGiftError> in
+            guard let upgraded = AyuSupportersManager.shared.grantedGifts(peerId: accountPeerId).first(where: { $0.index == index && $0.kind == .unique }) else {
+                return .fail(.generic)
+            }
+            return ayuGrantedGiftRows(account: account, peerId: account.peerId, granted: [upgraded])
+            |> castError(UpgradeStarGiftError.self)
+            |> mapToSignal { rows -> Signal<ProfileGiftsContext.State.StarGift, UpgradeStarGiftError> in
+                guard let row = rows.first else {
+                    return .fail(.generic)
+                }
+                return .single(row)
+            }
+        }
+    }
+}
+
+private func ayuRussian() -> Bool {
+    let language = Locale.preferredLanguages.first ?? ""
+    return language.hasPrefix("ru") || language.hasPrefix("uk")
+}
+
+/// Has the badge server change the account's own granted gift at `reference`.
+private func ayuHeldGiftRequest(account: Account, route: String, reference: StarGiftReference?, body: [String: Any]) -> Signal<Data, String> {
+    var body = body
+    if let reference {
+        guard let index = ayuGrantedGiftIndex(reference) else {
+            return .fail("not a granted gift")
+        }
+        body["index"] = index
+    }
+    return AyuBadgeServer.post(account: account, route: route, body: body, ru: ayuRussian())
+}
+
+/// Wears the account's unique granted gift at `reference` as its emoji status in AyuGram-IOS, or
+/// takes off whichever one it wears when `worn` is false.
+public func ayuWearGrantedGift(account: Account, reference: StarGiftReference?, worn: Bool) -> Signal<Never, String> {
+    return ayuHeldGiftRequest(account: account, route: "wear", reference: worn ? reference : nil, body: ["worn": worn])
+    |> ignoreValues
+}
+
+/// Whether the account wears one of its granted gifts.
+public func ayuWearsGrantedGift(account: Account) -> Bool {
+    return AyuSupportersManager.shared.grantedGifts(peerId: account.peerId.id._internalGetInt64Value()).contains(where: { $0.worn })
+}
+
+/// Signs the account's granted gift: `text` becomes its message. Empty text clears it.
+public func ayuSignGrantedGift(account: Account, reference: StarGiftReference, text: String) -> Signal<Never, String> {
+    return ayuHeldGiftRequest(account: account, route: "sign", reference: reference, body: ["text": text])
+    |> ignoreValues
+}
+
+/// The current signature of the account's granted gift at `reference`.
+public func ayuGrantedGiftText(account: Account, reference: StarGiftReference?) -> String? {
+    guard let index = ayuGrantedGiftIndex(reference) else {
+        return nil
+    }
+    return AyuSupportersManager.shared.grantedGifts(peerId: account.peerId.id._internalGetInt64Value()).first(where: { $0.index == index })?.text
+}
+
+/// Transfers the account's unique granted gift to `peerId`, and shows it as sent in the chat with them.
+public func ayuTransferGrantedGift(account: Account, reference: StarGiftReference, peerId: EnginePeer.Id) -> Signal<Never, TransferStarGiftError> {
+    let accountPeerId = account.peerId.id._internalGetInt64Value()
+    guard let index = ayuGrantedGiftIndex(reference), let gift = AyuSupportersManager.shared.grantedGifts(peerId: accountPeerId).first(where: { $0.index == index }), gift.kind == .unique else {
+        return .fail(.generic)
+    }
+    let recipientId = peerId.id._internalGetInt64Value()
+    return ayuHeldGiftRequest(account: account, route: "transfer", reference: reference, body: ["to": String(recipientId)])
+    |> mapError { _ -> TransferStarGiftError in
+        return .generic
+    }
+    |> mapToSignal { _ -> Signal<Never, TransferStarGiftError> in
+        guard let moved = AyuSupportersManager.shared.grantedGifts(peerId: recipientId).first(where: { $0.giftId == gift.giftId && $0.number == gift.number && $0.fromId == accountPeerId }) else {
+            return .complete()
+        }
+        return ayuGrantedGiftRows(account: account, peerId: peerId, granted: [moved])
+        |> take(1)
+        |> mapToSignal { rows -> Signal<Never, NoError> in
+            guard let row = rows.first else {
+                return .complete()
+            }
+            return account.postbox.transaction { transaction -> Void in
+                let _ = ayuAddGrantedGiftMessage(transaction: transaction, accountPeerId: account.peerId, chatPeerId: peerId, incoming: false, row: row, isUpgrade: false, isTransferred: true, timestamp: moved.date > 0 ? moved.date : Int32(Date().timeIntervalSince1970))
+            }
+            |> ignoreValues
+        }
+        |> castError(TransferStarGiftError.self)
+    }
+}
+
+/// A granted NFT by its slug, for t.me/nft links and the emoji status of whoever wears it.
+/// Nil when the slug is Telegram's own.
+func ayuGrantedUniqueGift(account: Account, slug: String) -> Signal<StarGift.UniqueGift, GetUniqueStarGiftError>? {
+    guard slug.hasPrefix(ayuGrantedSlugPrefix) else {
+        return nil
+    }
+    let parts = slug.dropFirst(ayuGrantedSlugPrefix.count).split(separator: "-")
+    guard parts.count == 2, let giftId = Int64(parts[0]), let number = Int32(parts[1]) else {
+        return .fail(.invalidSlug)
+    }
+    var found: (peerId: Int64, gift: AyuGrantedGift)?
+    for (peerId, gifts) in AyuSupportersManager.shared.allGrantedGifts() {
+        if let gift = gifts.first(where: { $0.kind == .unique && $0.giftId == giftId && $0.number == number }) {
+            found = (peerId, gift)
+            break
+        }
+    }
+    guard let found else {
+        return .fail(.invalidSlug)
+    }
+    let ownerPeerId = PeerId(namespace: Namespaces.Peer.CloudUser, id: PeerId.Id._internalFromInt64Value(found.peerId))
+    return ayuGrantedGiftRows(account: account, peerId: ownerPeerId, granted: [found.gift])
+    |> take(1)
+    |> castError(GetUniqueStarGiftError.self)
+    |> mapToSignal { rows -> Signal<StarGift.UniqueGift, GetUniqueStarGiftError> in
+        guard let row = rows.first, case let .unique(unique) = row.gift else {
+            return .fail(.generic)
+        }
+        return .single(unique)
+    }
+}
+
+private let ayuWornGiftStatusesLock = NSLock()
+private var ayuWornGiftStatusesByPeer: [Int64: PeerEmojiStatus] = [:]
+
+/// The emoji status of the granted NFT a peer wears; it takes the place of the Telegram one.
+/// Read for every peer drawn, so it only looks up what `ayuWornGiftStatuses` resolved.
+func ayuWornGiftStatus(peerId: Int64) -> PeerEmojiStatus? {
+    ayuWornGiftStatusesLock.lock()
+    defer { ayuWornGiftStatusesLock.unlock() }
+    return ayuWornGiftStatusesByPeer[peerId]
+}
+
+private func ayuSetWornGiftStatuses(_ statuses: [Int64: PeerEmojiStatus]) {
+    ayuWornGiftStatusesLock.lock()
+    ayuWornGiftStatusesByPeer = statuses
+    ayuWornGiftStatusesLock.unlock()
+}
+
+private func ayuEmojiStatus(_ gift: StarGift.UniqueGift) -> (PeerEmojiStatus, [TelegramMediaFile])? {
+    var file: TelegramMediaFile?
+    var patternFile: TelegramMediaFile?
+    var colors: (inner: Int32, outer: Int32, pattern: Int32, text: Int32)?
+    for attribute in gift.attributes {
+        switch attribute {
+        case let .model(_, value, _, _):
+            file = value
+        case let .pattern(_, value, _):
+            patternFile = value
+        case let .backdrop(_, _, inner, outer, pattern, text, _):
+            colors = (inner, outer, pattern, text)
+        default:
+            break
+        }
+    }
+    guard let file, let patternFile, let colors else {
+        return nil
+    }
+    let status = PeerEmojiStatus(content: .starGift(id: gift.id, fileId: file.fileId.id, title: gift.title, slug: gift.slug, patternFileId: patternFile.fileId.id, innerColor: colors.inner, outerColor: colors.outer, patternColor: colors.pattern, textColor: colors.text), expirationDate: nil)
+    return (status, [file, patternFile])
+}
+
+/// Runs for every account: resolves the granted NFTs people wear into emoji statuses, which
+/// `Peer.emojiStatus` shows in place of their Telegram status.
+public func ayuWornGiftStatuses(account: Account) -> Signal<Never, NoError> {
+    return ayuGrantedGiftsUpdates()
+    |> map { _ -> [Int64: AyuGrantedGift] in
+        var worn: [Int64: AyuGrantedGift] = [:]
+        for (peerId, gifts) in AyuSupportersManager.shared.allGrantedGifts() {
+            if let gift = gifts.first(where: { $0.worn && $0.kind == .unique }) {
+                worn[peerId] = gift
+            }
+        }
+        return worn
+    }
+    |> distinctUntilChanged
+    |> mapToSignal { worn -> Signal<Never, NoError> in
+        guard !worn.isEmpty else {
+            ayuSetWornGiftStatuses([:])
+            return .complete()
+        }
+        let lookups = worn.map { peerId, gift -> Signal<(Int64, ProfileGiftsContext.State.StarGift?), NoError> in
+            let peer = PeerId(namespace: Namespaces.Peer.CloudUser, id: PeerId.Id._internalFromInt64Value(peerId))
+            return ayuGrantedGiftRows(account: account, peerId: peer, granted: [gift])
+            |> take(1)
+            |> map { (peerId, $0.first) }
+        }
+        return combineLatest(lookups)
+        |> take(1)
+        |> mapToSignal { rows -> Signal<Never, NoError> in
+            var statuses: [Int64: PeerEmojiStatus] = [:]
+            var files: [TelegramMediaFile] = []
+            for (peerId, row) in rows {
+                if let row, case let .unique(unique) = row.gift, case let (status, statusFiles)? = ayuEmojiStatus(unique) {
+                    statuses[peerId] = status
+                    files.append(contentsOf: statusFiles)
+                }
+            }
+            return account.postbox.transaction { transaction -> Void in
+                // The status draws its model and pattern by file id, as for a real collectible.
+                for file in files {
+                    transaction.storeMediaIfNotPresent(media: file)
+                }
+                ayuSetWornGiftStatuses(statuses)
+            }
+            |> ignoreValues
+        }
+    }
+}
+
+private func ayuGrantedGiftNoticeKey(_ gift: AyuGrantedGift) -> String {
+    return "\(gift.giftId)-\(gift.date)-\(gift.kind.rawValue)"
+}
+
+/// Adds a gift service message for `row` to the chat with `chatPeerId`, as Telegram shows a real gift.
+/// Returns false when the chat's peer is unknown on this device.
+private func ayuAddGrantedGiftMessage(transaction: Transaction, accountPeerId: PeerId, chatPeerId: PeerId, incoming: Bool, row: ProfileGiftsContext.State.StarGift, isUpgrade: Bool, isTransferred: Bool = false, timestamp: Int32) -> Bool {
+    guard transaction.getPeer(chatPeerId) != nil else {
+        return false
+    }
+    let action: TelegramMediaActionType
+    switch row.gift {
+    case .generic:
