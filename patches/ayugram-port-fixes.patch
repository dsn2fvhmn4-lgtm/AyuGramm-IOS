+}
+
+/// Runs for every account: a gift granted to it shows up as a gift message in the chat with the
+/// owner, or with whoever transferred it, once per gift and once more when it is upgraded.
+/// Only AyuGram-IOS shows it.
+public func ayuGrantedGiftNotices(account: Account) -> Signal<Never, NoError> {
+    let accountPeerId = account.peerId.id._internalGetInt64Value()
+    let defaultsKey = "ayu.grantedGiftNotices.\(accountPeerId)"
+    return ayuGrantedGiftsUpdates()
+    |> map { _ -> [AyuGrantedGift] in
+        return AyuSupportersManager.shared.grantedGifts(peerId: accountPeerId)
+    }
+    |> distinctUntilChanged
+    |> mapToSignal { granted -> Signal<Never, NoError> in
+        guard let owner = AyuSupportersManager.shared.ownerPeerId else {
+            return .complete()
+        }
+        let seen = Set(UserDefaults.standard.stringArray(forKey: defaultsKey) ?? [])
+        let fresh = granted.filter { !seen.contains(ayuGrantedGiftNoticeKey($0)) && ($0.fromId ?? owner) != accountPeerId }.reversed().map { $0 }
+        guard !fresh.isEmpty else {
+            return .complete()
+        }
+        return ayuGrantedGiftRows(account: account, peerId: account.peerId, granted: fresh)
+        |> take(1)
+        |> mapToSignal { rows -> Signal<Never, NoError> in
+            return account.postbox.transaction { transaction -> Void in
+                var announced = seen
+                let now = Int32(Date().timeIntervalSince1970)
+                for gift in fresh {
+                    guard let row = rows.first(where: { $0.date == gift.date && ayuGrantedGiftsMatch($0.gift, gift) }) else {
+                        continue
+                    }
+                    let isUpgrade = gift.kind == .unique && seen.contains("\(gift.giftId)-\(gift.date)-plain")
+                    let timestamp = isUpgrade || gift.date <= 0 ? now : gift.date
+                    let chatPeerId = PeerId(namespace: Namespaces.Peer.CloudUser, id: PeerId.Id._internalFromInt64Value(gift.fromId ?? owner))
+                    if ayuAddGrantedGiftMessage(transaction: transaction, accountPeerId: account.peerId, chatPeerId: chatPeerId, incoming: true, row: row, isUpgrade: isUpgrade, isTransferred: gift.fromId != nil && !isUpgrade, timestamp: timestamp) {
+                        announced.insert(ayuGrantedGiftNoticeKey(gift))
+                    }
+                }
+                UserDefaults.standard.set(Array(announced), forKey: defaultsKey)
+            }
+            |> ignoreValues
+        }
+    }
+}
+
+private func ayuGrantedGiftsMatch(_ gift: StarGift, _ granted: AyuGrantedGift) -> Bool {
+    switch gift {
+    case let .generic(value):
+        return granted.kind == .plain && value.id == granted.giftId
+    case let .unique(value):
+        return granted.kind == .unique && value.giftId == granted.giftId
+    }
+}
+
+/// On the owner's device: the gift just granted to `recipientId` as a sent gift in the chat with them.
+public func ayuAnnounceGrantedGift(account: Account, recipientId: Int64) -> Signal<Never, NoError> {
+    guard let gift = AyuSupportersManager.shared.grantedGifts(peerId: recipientId).max(by: { $0.index < $1.index }) else {
+        return .complete()
+    }
+    let recipientPeerId = PeerId(namespace: Namespaces.Peer.CloudUser, id: PeerId.Id._internalFromInt64Value(recipientId))
+    return ayuGrantedGiftRows(account: account, peerId: recipientPeerId, granted: [gift])
+    |> take(1)
+    |> mapToSignal { rows -> Signal<Never, NoError> in
+        guard let row = rows.first else {
+            return .complete()
+        }
+        return account.postbox.transaction { transaction -> Void in
+            let timestamp = gift.date > 0 ? gift.date : Int32(Date().timeIntervalSince1970)
+            let _ = ayuAddGrantedGiftMessage(transaction: transaction, accountPeerId: account.peerId, chatPeerId: recipientPeerId, incoming: false, row: row, isUpgrade: false, timestamp: timestamp)
+        }
+        |> ignoreValues
+    }
+}
