diff --git a/submodules/TelegramCore/Sources/AyuGram/AyuBadgeServer.swift b/submodules/TelegramCore/Sources/AyuGram/AyuBadgeServer.swift
new file mode 100644
index 00000000..01a251e6
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuGram/AyuBadgeServer.swift
@@ -0,0 +1,73 @@
+import Foundation
+import Postbox
+import SwiftSignalKit
+
+/// The AyuGram badge server, which commits badge and gift changes to the registry. A request proves
+/// who sent it with Mini App data Telegram signs for the badge bot, so the phone keeps no keys.
+public enum AyuBadgeServer {
+    public static let url = "https://badge.vinx.best"
+    public static let botUsername = "AyuZayavka_bot"
+
+    /// Mini App data Telegram signs for the badge bot. Fails with Telegram's error code.
+    public static func signedInitData(account: Account) -> Signal<String, String> {
+        return TelegramEngine(account: account).peers.resolvePeerByName(name: AyuBadgeServer.botUsername, referrer: nil)
+        |> mapToSignal { result -> Signal<EnginePeer?, NoError> in
+            guard case let .result(peer) = result else {
+                return .complete()
+            }
+            return .single(peer)
+        }
+        |> then(.single(nil))
+        |> take(1)
+        |> castError(String.self)
+        |> mapToSignal { peer -> Signal<String, String> in
+            guard let peer else {
+                return .fail("BOT_NOT_FOUND")
+            }
+            return ayuBotWebAppInitData(account: account, botId: peer.id, url: AyuBadgeServer.url + "/")
+        }
+    }
+
+    /// POSTs `body` to `/api/<route>` and returns the registry the server committed, or a message to show.
+    public static func post(account: Account, route: String, body: [String: Any], ru: Bool) -> Signal<Data, String> {
+        return AyuBadgeServer.signedInitData(account: account)
+        |> mapError { code -> String in
+            return ru ? "Telegram не выдал данные для входа на сервер бейджей (\(code)). Проверьте, что бот @\(AyuBadgeServer.botUsername) не заблокирован." : "Telegram gave no sign-in data for the badge server (\(code)). Make sure @\(AyuBadgeServer.botUsername) isn't blocked."
+        }
+        |> mapToSignal { initData -> Signal<Data, String> in
+            return Signal { subscriber in
+                guard let url = URL(string: AyuBadgeServer.url + "/api/" + route) else {
+                    subscriber.putError("bad route")
+                    return EmptyDisposable
+                }
+                var body = body
+                body["initData"] = initData
+                var request = URLRequest(url: url, cachePolicy: .reloadIgnoringLocalCacheData, timeoutInterval: 30.0)
+                request.httpMethod = "POST"
+                request.setValue("application/json", forHTTPHeaderField: "Content-Type")
+                request.httpBody = try? JSONSerialization.data(withJSONObject: body)
+                let session = URLSession(configuration: .ephemeral)
+                let task = session.dataTask(with: request, completionHandler: { data, response, error in
+                    session.finishTasksAndInvalidate()
+                    guard let data, let http = response as? HTTPURLResponse else {
+                        subscriber.putError(error?.localizedDescription ?? "network")
+                        return
+                    }
+                    let json = (try? JSONSerialization.jsonObject(with: data)) as? [String: Any]
+                    if http.statusCode == 200, let registry = json?["registry"] as? String {
+                        let registryData = Data(registry.utf8)
+                        AyuSupportersManager.shared.applyAyuRegistry(data: registryData)
+                        subscriber.putNext(registryData)
+                        subscriber.putCompletion()
+                    } else {
+                        subscriber.putError((json?["error"] as? String) ?? (ru ? "Сервер бейджей ответил \(http.statusCode)." : "The badge server answered \(http.statusCode)."))
+                    }
+                })
+                task.resume()
+                return ActionDisposable {
+                    task.cancel()
+                }
+            }
+        }
+    }
+}
diff --git a/submodules/TelegramCore/Sources/AyuGram/AyuBotWebAppInitData.swift b/submodules/TelegramCore/Sources/AyuGram/AyuBotWebAppInitData.swift
new file mode 100644
index 00000000..fa0cc7d1
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuGram/AyuBotWebAppInitData.swift
@@ -0,0 +1,72 @@
+import Foundation
+import Postbox
+import SwiftSignalKit
+internal import TelegramApi
+import MtProtoKit
+
+/// The signed Mini App data (`tgWebAppData`) a bot's web app at `url` would receive, for a server
+/// that checks Telegram's signature. Asks for a simple web view first and, if Telegram refuses,
+/// for the web view of the chat with the bot, as an inline `web_app` button does. A failure
+/// carries Telegram's error code, so the caller can show what went wrong.
+public func ayuBotWebAppInitData(account: Account, botId: PeerId, url: String) -> Signal<String, String> {
+    return account.postbox.transaction { transaction -> (Api.InputUser, Api.InputPeer)? in
+        guard let bot = transaction.getPeer(botId), let inputBot = apiInputUser(bot), let inputPeer = apiInputPeer(bot) else {
+            return nil
+        }
+        return (inputBot, inputPeer)
+    }
+    |> castError(String.self)
+    |> mapToSignal { inputs -> Signal<String, String> in
+        guard let inputs else {
+            return .fail("BOT_NOT_FOUND")
+        }
+        let (inputBot, inputPeer) = inputs
+        let simple = account.network.request(Api.functions.messages.requestSimpleWebView(flags: 1 << 3, bot: inputBot, url: url, startParam: nil, themeParams: nil, platform: "ios"))
+        |> mapError { error -> String in
+            return error.errorDescription ?? "UNKNOWN"
+        }
+        |> mapToSignal { result -> Signal<String, String> in
+            switch result {
+            case let .webViewResultUrl(webViewResultUrlData):
+                if let initData = ayuInitData(webAppUrl: webViewResultUrlData.url) {
+                    return .single(initData)
+                }
+                return .fail("NO_INIT_DATA")
+            }
+        }
+        let chat = account.network.request(Api.functions.messages.requestWebView(flags: 1 << 1, peer: inputPeer, bot: inputBot, url: url, startParam: nil, themeParams: nil, platform: "ios", replyTo: nil, sendAs: nil))
+        |> mapError { error -> String in
+            return error.errorDescription ?? "UNKNOWN"
+        }
+        |> mapToSignal { result -> Signal<String, String> in
+            switch result {
+            case let .webViewResultUrl(webViewResultUrlData):
+                if let initData = ayuInitData(webAppUrl: webViewResultUrlData.url) {
+                    return .single(initData)
+                }
+                return .fail("NO_INIT_DATA")
+            }
+        }
+        return simple
+        |> `catch` { simpleError -> Signal<String, String> in
+            return chat
+            |> mapError { chatError -> String in
+                return simpleError == chatError ? simpleError : simpleError + ", " + chatError
+            }
+        }
+    }
+}
+
+/// The tgWebAppData parameter of the URL's fragment, which is a percent-encoded query string.
+public func ayuInitData(webAppUrl: String) -> String? {
+    guard let hash = webAppUrl.firstIndex(of: "#") else {
+        return nil
+    }
+    for pair in webAppUrl[webAppUrl.index(after: hash)...].split(separator: "&") {
+        let parts = pair.split(separator: "=", maxSplits: 1)
+        if parts.count == 2, parts[0] == "tgWebAppData", let value = String(parts[1]).removingPercentEncoding, !value.isEmpty {
+            return value
+        }
+    }
+    return nil
+}
diff --git a/submodules/TelegramCore/Sources/AyuGram/AyuGrantedGift.swift b/submodules/TelegramCore/Sources/AyuGram/AyuGrantedGift.swift
