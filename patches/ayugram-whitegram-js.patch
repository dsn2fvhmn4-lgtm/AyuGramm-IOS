diff --git a/submodules/TelegramUI/Sources/AyuWhiteGramChat.swift b/submodules/TelegramUI/Sources/AyuWhiteGramChat.swift
new file mode 100644
index 0000000..637caef
--- /dev/null
+++ b/submodules/TelegramUI/Sources/AyuWhiteGramChat.swift
@@ -0,0 +1,53 @@
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import AccountContext
+import ChatInterfaceState
+import ChatPresentationInterfaceState
+
+/// Hosts WhiteGram JavaScript plugins in an open chat: input field, sending, and delivered-message events.
+extension ChatControllerImpl {
+    func ayuAttachWhiteGram() {
+        guard let peerId = self.chatLocation.peerId, peerId.namespace != Namespaces.Peer.SecretChat else { return }
+        let context = self.context
+        let account = AyuWhiteGramAccountHost(account: context.account.peerId.toInt64(), present: { controller in
+            context.sharedContext.applicationBindings.presentNativeController(controller)
+        }, editMessage: { peer, id, text, completion in
+            let messageId = EngineMessage.Id(peerId: EnginePeer.Id(peer), namespace: Namespaces.Message.Cloud, id: id)
+            let _ = (context.engine.messages.requestEditMessage(messageId: messageId, text: text, media: .keep, entities: nil, richText: nil, inlineStickers: [:])
+            |> deliverOnMainQueue).startStandalone(error: { error in
+                completion("\(error)")
+            }, completed: {
+                completion(nil)
+            })
+        })
+        let chat = AyuWhiteGramChatHost(view: self.view, peer: peerId.toInt64(), inputText: { [weak self] in
+            return self?.presentationInterfaceState.interfaceState.effectiveInputState.inputText.string ?? ""
+        }, setInputText: { [weak self] text in
+            self?.updateChatPresentationInterfaceState(animated: true, interactive: true, {
+                $0.updatedInterfaceState { $0.withUpdatedEffectiveInputState(ChatTextInputState(inputText: NSAttributedString(string: text))) }
+            })
+        }, sendMessage: { [weak self] in
+            // Let the input panel apply text set by the plugin in the same call before sending it.
+            DispatchQueue.main.async {
+                self?.chatDisplayNode.sendCurrentMessage()
+            }
+        }, observeSentMessages: { handler in
+            let disposable = (context.account.pendingMessageManager.deliveredMessageEvents(peerId: peerId)
+            |> mapToSignal { events -> Signal<[EngineMessage], NoError> in
+                let ids = events.map(\.id).filter { $0.namespace == Namespaces.Message.Cloud }
+                return context.engine.data.get(EngineDataList(ids.map { TelegramEngine.EngineData.Item.Messages.Message(id: $0) }))
+                |> map { $0.compactMap { $0 } }
+            }
+            |> deliverOnMainQueue).startStrict(next: { messages in
+                for message in messages where !message.text.isEmpty {
+                    handler(message.id.peerId.toInt64(), message.id.id, message.text)
+                }
+            })
+            return { disposable.dispose() }
+        })
+        AyuWhiteGramRuntime.shared.attach(chat, account: account)
+    }
+}
