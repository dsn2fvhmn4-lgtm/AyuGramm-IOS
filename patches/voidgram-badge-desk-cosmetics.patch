+/// What the owner gave a profile on the badge server besides its badge: extra usernames, a shown
+/// phone number and a TON balance. Every VoidGram user sees them and finds the peer by them.
+public struct AyuProfileCosmetics: Equatable {
+    public var usernames: [String]
+    /// Digits with the country code, no "+".
+    public var phone: String?
+    public var tonNano: Int64?
+    /// The peer's real username when the details were given, to open a peer the app hasn't seen.
+    public var handle: String?
+
+    public init(usernames: [String] = [], phone: String? = nil, tonNano: Int64? = nil, handle: String? = nil) {
+        self.usernames = usernames
+        self.phone = phone
+        self.tonNano = tonNano
+        self.handle = handle
+    }
+
+    public var isEmpty: Bool {
+        return self.usernames.isEmpty && self.phone == nil && self.tonNano == nil
+    }
+
+    init?(json: [String: Any]) {
+        let usernames = ((json["usernames"] as? [String]) ?? []).filter { name in
+            return (4 ... 32).contains(name.count) && name.allSatisfy { $0.isASCII && ($0.isLetter || $0.isNumber || $0 == "_") }
+        }
+        let phone = (json["phone"] as? String).flatMap { value -> String? in
+            return (5 ... 15).contains(value.count) && value.allSatisfy({ $0.isASCII && $0.isNumber }) ? value : nil
+        }
+        let tonNano = (json["ton"] as? String).flatMap { Int64($0) }.flatMap { $0 > 0 ? $0 : nil }
+        let handle = (json["handle"] as? String).flatMap { $0.isEmpty ? nil : $0 }
+        self.init(usernames: Array(usernames.prefix(5)), phone: phone, tonNano: tonNano, handle: handle)
+        if self.isEmpty {
+            return nil
+        }
+    }
+
+    /// Digits of a search query that looks like a phone number ("+7 900 …"), else nil.
+    public static func phoneDigits(_ query: String) -> String? {
+        let trimmed = query.trimmingCharacters(in: .whitespaces)
+        guard !trimmed.isEmpty, trimmed.allSatisfy({ $0.isASCII && ($0.isNumber || " +-()".contains($0)) }) else {
+            return nil
+        }
+        let digits = trimmed.filter { $0.isNumber }
+        return digits.count >= 5 ? digits : nil
+    }
+
+    /// A search query as a username: without "@", lowercased, nil when it can't be one.
+    public static func usernameQuery(_ query: String) -> String? {
+        var name = query.trimmingCharacters(in: .whitespaces)
+        if name.hasPrefix("@") {
+            name.removeFirst()
+        }
+        guard name.count >= 4, name.allSatisfy({ $0.isASCII && ($0.isLetter || $0.isNumber || $0 == "_") }) else {
+            return nil
+        }
+        return name.lowercased()
+    }
+}
