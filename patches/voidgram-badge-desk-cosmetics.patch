+private func ayuDescribeGift(_ gift: AyuGrantedGift, ru: Bool) -> String {
+    let name = gift.title ?? (ru ? "Подарок" : "Gift")
+    switch gift.kind {
+    case .plain:
+        return name + (ru ? " · обычный" : " · plain")
+    case .unique:
+        return "\(name) #\(gift.number) · \(gift.model ?? "?")"
+    }
+}
