+/// Telegram's own variants sheet for this gift: it previews the gift with the model, backdrop and
+/// symbol picked there, and its button grants that combination. The number and signature come next.
+private func ayuConfigureUnique(context: AccountContext, giftId: Int64, title: String?, number: Int32?, preset: [StarGift.UniqueGift.Attribute]?, present: @escaping (ViewController) -> Void, grant: @escaping ([String: Any]) -> Void) {
+    let ru = context.sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru")
+    let alert: (String) -> Void = { text in
+        present(textAlertController(context: context, title: nil, text: text, actions: [TextAlertAction(type: .defaultAction, title: "OK", action: {})]))
+    }
+    let _ = (combineLatest(
+        context.engine.payments.getStarGiftUpgradeAttributes(giftId: giftId) |> take(1),
+        context.engine.payments.cachedStarGifts() |> take(1)
+    )
+    |> deliverOnMainQueue).startStandalone(next: { attributes, gifts in
+        guard let attributes, !attributes.isEmpty else {
+            return alert(ru ? "Telegram не отдал модели, фоны и узоры этого подарка." : "Telegram returned no models, backdrops or patterns for this gift.")
+        }
+        let base = (gifts ?? []).first(where: { gift in
+            if case let .generic(value) = gift { return value.id == giftId }
+            return false
+        })
+        guard let base, let navigationController = context.sharedContext.mainWindow?.viewController as? NavigationController else {
+            return alert(ru ? "Этого подарка нет в каталоге Telegram." : "This gift isn't in Telegram's catalog.")
+        }
+        let screen = GiftUpgradeVariantsScreen(context: context, gift: base, attributes: attributes, selectedAttributes: preset, focusedAttribute: nil, confirmTitle: ru ? "Выдать этот вариант" : "Grant this one", confirm: { chosen in
+            var gift: [String: Any] = ["giftId": String(giftId), "kind": "unique"]
+            for attribute in chosen {
+                switch attribute {
+                case let .model(name, _, _, _): gift["model"] = name
+                case let .pattern(name, _, _): gift["pattern"] = name
+                case let .backdrop(name, _, _, _, _, _, _): gift["backdrop"] = name
+                default: break
                 }
+            }
+            guard gift["model"] != nil, gift["pattern"] != nil, gift["backdrop"] != nil else {
+                return
+            }
+            if let title { gift["title"] = title }
+            let finish = ayuGiftFinishController(context: context, title: title ?? "NFT", askNumber: true, initialNumber: number, grant: { number, text in
+                if let number { gift["number"] = number }
+                if let text { gift["text"] = text }
+                grant(gift)
             })
-            navigationController.pushViewController(screen)
+            // After the sheet's dismissal animation, so the page slides in over the profile.
+            Queue.mainQueue().after(0.4) {
+                navigationController.pushViewController(finish)
+            }
         })
+        navigationController.pushViewController(screen)
+    })
+}
