+private func ayuGiftLabel(_ gift: StarGift.Gift) -> String {
+    var emoji = ""
+    for attribute in gift.file.attributes {
+        if case let .Sticker(displayText, _, _) = attribute {
+            emoji = displayText
         }
     }
+    let name = gift.title ?? emoji
+    return name.isEmpty ? "🎁" : name
+}
 
