+private enum AyuGiftDeskEntry: ItemListNodeEntry {
+    case grantedHeader(String)
+    case granted(Int32, AyuGrantedGift, String)
+    case removeAll(String)
+    case grantHeader(String)
+    case grantPlain(String)
+    case grantUnique(String)
+    case linkHeader(String)
+    case link(String, String)
+    case linkAction(String, Bool)
+    case linkInfo(String)
+
+    var section: ItemListSectionId {
+        switch self {
+        case .grantedHeader, .granted, .removeAll: return 0
+        case .grantHeader, .grantPlain, .grantUnique: return 1
+        case .linkHeader, .link, .linkAction, .linkInfo: return 2
+        }
+    }
+
+    var stableId: Int32 {
+        switch self {
+        case .grantedHeader: return 0
+        case let .granted(index, _, _): return 1 + index
+        case .removeAll: return 99
+        case .grantHeader: return 100
+        case .grantPlain: return 101
+        case .grantUnique: return 102
+        case .linkHeader: return 200
+        case .link: return 201
+        case .linkAction: return 202
+        case .linkInfo: return 203
+        }
+    }
+
+    static func ==(lhs: AyuGiftDeskEntry, rhs: AyuGiftDeskEntry) -> Bool {
+        switch (lhs, rhs) {
+        case let (.grantedHeader(a), .grantedHeader(b)): return a == b
+        case let (.granted(i, g, a), .granted(j, h, b)): return i == j && g == h && a == b
+        case let (.removeAll(a), .removeAll(b)): return a == b
+        case let (.grantHeader(a), .grantHeader(b)): return a == b
+        case let (.grantPlain(a), .grantPlain(b)): return a == b
+        case let (.grantUnique(a), .grantUnique(b)): return a == b
+        case let (.linkHeader(a), .linkHeader(b)): return a == b
+        case let (.link(a, x), .link(b, y)): return a == b && x == y
+        case let (.linkAction(a, x), .linkAction(b, y)): return a == b && x == y
+        case let (.linkInfo(a), .linkInfo(b)): return a == b
+        default: return false
+        }
+    }
+
+    static func <(lhs: AyuGiftDeskEntry, rhs: AyuGiftDeskEntry) -> Bool {
+        return lhs.stableId < rhs.stableId
+    }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! AyuGiftDeskArguments
+        switch self {
+        case let .grantedHeader(text), let .grantHeader(text), let .linkHeader(text):
+            return ItemListSectionHeaderItem(presentationData: presentationData, text: text, sectionId: self.section)
+        case let .granted(_, gift, title):
+            return ItemListDisclosureItem(presentationData: presentationData, title: title, label: "", sectionId: self.section, style: .blocks, disclosureStyle: .none, action: {
+                arguments.removeGift(gift)
+            })
+        case let .removeAll(title):
+            return ItemListActionItem(presentationData: presentationData, title: title, kind: .destructive, alignment: .natural, sectionId: self.section, style: .blocks, action: {
+                arguments.removeAll()
+            })
+        case let .grantPlain(title):
+            return ItemListDisclosureItem(presentationData: presentationData, title: title, label: "", sectionId: self.section, style: .blocks, action: {
+                arguments.grantPlain()
+            })
+        case let .grantUnique(title):
+            return ItemListDisclosureItem(presentationData: presentationData, title: title, label: "", sectionId: self.section, style: .blocks, action: {
+                arguments.grantUnique()
+            })
+        case let .link(placeholder, text):
+            return ItemListSingleLineInputItem(presentationData: presentationData, title: NSAttributedString(), text: text, placeholder: placeholder, type: .username, clearType: .always, sectionId: self.section, textUpdated: { value in
+                arguments.updateLink(value)
+            }, action: {
+                arguments.grantFromLink()
+            })
+        case let .linkAction(title, enabled):
+            return ItemListActionItem(presentationData: presentationData, title: title, kind: enabled ? .generic : .disabled, alignment: .natural, sectionId: self.section, style: .blocks, action: {
+                arguments.grantFromLink()
+            })
+        case let .linkInfo(text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        }
+    }
+}
