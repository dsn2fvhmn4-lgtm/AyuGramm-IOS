+/// The first of `names` a different Telegram account already holds, or nil.
+private func ayuCheckUsernamesFree(context: AccountContext, names: [String], peerId: EnginePeer.Id) -> Signal<String?, NoError> {
+    if names.isEmpty {
+        return .single(nil)
+    }
+    return combineLatest(names.map { name -> Signal<String?, NoError> in
+        return context.engine.peers.resolvePeerByName(name: name, referrer: nil)
+        |> mapToSignal { result -> Signal<String?, NoError> in
+            guard case let .result(peer) = result else {
+                return .complete()
+            }
+            if let peer, peer.id != peerId {
+                return .single(name)
+            }
+            return .single(nil)
+        }
+        |> take(1)
+    })
+    |> map { taken in
+        return taken.compactMap { $0 }.first
+    }
+}
