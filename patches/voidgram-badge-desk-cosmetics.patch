+/// The last step of a grant: the NFT's number (empty for a random one) and the gift's signature.
+private func ayuGiftFinishController(context: AccountContext, title: String, askNumber: Bool, initialNumber: Int32?, grant: @escaping (Int?, String?) -> Void) -> ViewController {
+    let initialState = AyuGiftFinishState(number: initialNumber.map { String($0) } ?? "")
+    let statePromise = ValuePromise(initialState, ignoreRepeated: true)
+    let stateValue = Atomic(value: initialState)
+    var popImpl: (() -> Void)?
+    let arguments = AyuGiftFinishArguments(update: { f in
+        statePromise.set(stateValue.modify { state in
+            var state = state
+            f(&state)
+            return state
+        })
+    }, grant: {
+        var granted = false
+        let state = stateValue.modify { state in
+            var state = state
+            granted = !state.granting
+            state.granting = true
+            return state
+        }
+        statePromise.set(state)
+        guard granted else {
+            return
+        }
+        let number = Int(state.number).flatMap { $0 >= 1 ? $0 : nil }
+        let text = state.text.trimmingCharacters(in: .whitespacesAndNewlines)
+        grant(number, text.isEmpty ? nil : String(text.prefix(120)))
+        popImpl?()
+    })
+    let signal = combineLatest(context.sharedContext.presentationData, statePromise.get())
+    |> map { presentationData, state -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        var entries: [AyuGiftFinishEntry] = []
+        if askNumber {
+            entries.append(.numberHeader(ru ? "НОМЕР" : "NUMBER"))
+            entries.append(.number(ru ? "случайный" : "random", state.number))
+            entries.append(.numberInfo(ru ? "Пусто — случайный номер." : "Leave empty for a random number."))
+        }
+        entries.append(.textHeader(ru ? "ПОДПИСЬ" : "SIGNATURE"))
+        entries.append(.text(ru ? "Без подписи" : "No signature", state.text))
+        entries.append(.grant(ru ? "Выдать" : "Grant", !state.granting))
+        let controllerState = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text(title), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back), animateChanges: false)
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: entries, style: .blocks, animateChanges: false)
+        return (controllerState, (listState, arguments))
+    }
+    let controller = ItemListController(context: context, state: signal)
+    popImpl = { [weak controller] in
+        controller?.view.endEditing(true)
+        let _ = (controller?.navigationController as? NavigationController)?.popViewController(animated: true)
     }
+    return controller
 }
