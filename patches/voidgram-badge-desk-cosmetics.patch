+/// Sends `change` to the badge server and applies the registry it answers with.
+private func ayuDeskCommit(context: AccountContext, peerId: Int64, change: [String: Any], present: @escaping (ViewController) -> Void, completion: @escaping (Bool) -> Void) {
+    let ru = context.sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru")
+    if change.isEmpty {
+        completion(true)
+        return
+    }
+    let grantsGift = (change["gifts"] as? [String: Any])?["add"] != nil
+    let _ = (AyuBadgeServer.post(account: context.account, route: "admin", body: ["peerId": String(peerId), "change": change], ru: ru)
+    |> deliverOnMainQueue).startStandalone(next: { _ in
+        NotificationCenter.default.post(name: AyuVerifiedRegistry.didChangeNotification, object: nil)
+        if grantsGift {
+            // The owner sees the gift as sent in the chat with the recipient, as the recipient sees it arrive.
+            let _ = ayuAnnounceGrantedGift(account: context.account, recipientId: peerId).startStandalone()
+        }
+        completion(true)
+    }, error: { message in
+        present(textAlertController(context: context, title: ru ? "Не удалось сохранить" : "Couldn't save", text: message, actions: [TextAlertAction(type: .defaultAction, title: "OK", action: {})]))
+        completion(false)
+    })
+}
