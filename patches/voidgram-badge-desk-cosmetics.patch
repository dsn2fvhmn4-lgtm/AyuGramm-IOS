+/// Telegram's answer first; a name Telegram doesn't know may be one the VoidGram owner gave a peer.
 func _internal_resolvePeerByName(postbox: Postbox, network: Network, accountPeerId: PeerId, name: String, referrer: String?, ageLimit: Int32 = 2 * 60 * 60 * 24) -> Signal<ResolvePeerIdByNameResult, NoError> {
+    return _internal_telegramResolvePeerByName(postbox: postbox, network: network, accountPeerId: accountPeerId, name: name, referrer: referrer, ageLimit: ageLimit)
+    |> mapToSignal { result -> Signal<ResolvePeerIdByNameResult, NoError> in
+        guard case let .result(peerId) = result, peerId == nil, let givenId = AyuSupportersManager.shared.peerId(givenUsername: name) else {
+            return .single(result)
+        }
+        return _internal_ayuGivenPeer(postbox: postbox, network: network, accountPeerId: accountPeerId, id: givenId)
+        |> map { peerId -> ResolvePeerIdByNameResult in
+            return .result(peerId)
+        }
+    }
+}
+
+/// The user a given username or number belongs to: from the local database, else through the real
+/// username stored with the given details. Nil when the app can't reach them.
+func _internal_ayuGivenPeer(postbox: Postbox, network: Network, accountPeerId: PeerId, id: Int64) -> Signal<PeerId?, NoError> {
+    guard id > 0 else {
+        return .single(nil)
+    }
+    let peerId = PeerId(namespace: Namespaces.Peer.CloudUser, id: PeerId.Id._internalFromInt64Value(id))
+    return postbox.transaction { transaction -> Bool in
+        return transaction.getPeer(peerId) != nil
+    }
+    |> mapToSignal { known -> Signal<PeerId?, NoError> in
+        if known {
+            return .single(peerId)
+        }
+        guard let handle = AyuSupportersManager.shared.cosmetics(peerId: id)?.handle else {
+            return .single(nil)
+        }
+        return _internal_telegramResolvePeerByName(postbox: postbox, network: network, accountPeerId: accountPeerId, name: handle, referrer: nil)
+        |> mapToSignal { result -> Signal<PeerId?, NoError> in
+            guard case let .result(resolved) = result else {
+                return .complete()
+            }
+            return .single(resolved == peerId ? peerId : nil)
+        }
+        |> take(1)
+    }
+}
