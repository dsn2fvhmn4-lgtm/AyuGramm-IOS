diff --git a/submodules/TelegramUI/Sources/AyuLyricsLookup.swift b/submodules/TelegramUI/Sources/AyuLyricsLookup.swift
new file mode 100644
index 0000000..e5c12a4
--- /dev/null
+++ b/submodules/TelegramUI/Sources/AyuLyricsLookup.swift
@@ -0,0 +1,70 @@
+import Foundation
+import CryptoKit
+
+enum AyuLyricsLookup {
+    static func titleVariants(_ title: String) -> [String] {
+        let cleaned = AyuMusicMetadata.searchTitle(title)
+        let solo = cleaned.replacingOccurrences(of: #"\s*[\(\[]\s*(?:feat\.?|ft\.?).*?[\)\]]|\s+(?:feat\.|ft\.)\s+.*$"#, with: "", options: [.regularExpression, .caseInsensitive]).trimmingCharacters(in: .whitespacesAndNewlines)
+        return self.unique([title, cleaned, solo])
+    }
+    static func artistVariants(_ artist: String?) -> [String] {
+        guard let artist else { return [] }
+        let primary = artist.components(separatedBy: CharacterSet(charactersIn: ";,&")).first ?? artist
+        let solo = primary.replacingOccurrences(of: #"\s+(?:feat\.?|ft\.?|with|x)\s+.*$"#, with: "", options: [.regularExpression, .caseInsensitive])
+        return self.unique([artist, solo])
+    }
+    static func queries(title: String, artist: String?) -> [String] {
+        let titles = self.titleVariants(title)
+        let artists = self.artistVariants(artist)
+        var result: [String] = []
+        for name in artists { for song in titles.reversed() { result.append(name + " " + song) } }
+        result.append(contentsOf: titles.reversed())
+        return Array(self.unique(result).prefix(6))
+    }
+    static func secondaryURLs(title: String, artist: String?) -> [URL] {
+        var result: [URL] = []
+        for name in self.artistVariants(artist) {
+            for song in self.titleVariants(title).reversed() {
+                // Slash and query characters are data inside a single path component.
+                var allowed = CharacterSet.urlPathAllowed
+                allowed.remove(charactersIn: "/?#%")
+                guard let artist = name.addingPercentEncoding(withAllowedCharacters: allowed), let track = song.addingPercentEncoding(withAllowedCharacters: allowed), let url = URL(string: "https://api.lyrics.ovh/v1/" + artist + "/" + track) else { continue }
+                if !result.contains(url) { result.append(url) }
+            }
+        }
+        return Array(result.prefix(3))
+    }
+    private static func unique(_ values: [String]) -> [String] {
+        var keys = Set<String>()
+        return values.map { $0.trimmingCharacters(in: .whitespacesAndNewlines) }.filter { !$0.isEmpty && keys.insert($0.lowercased()).inserted }
+    }
+}
+
+/// Cache successful results only; failed lookups must be retried as databases grow.
+enum AyuLyricsCache {
+    private struct Entry: Codable { let created: Date; let lyrics: AyuLyrics }
+    static var directory: URL? { FileManager.default.urls(for: .cachesDirectory, in: .userDomainMask).first?.appendingPathComponent("ayu-lyrics-v1", isDirectory: true) }
+    static func key(title: String, artist: String?, duration: Double) -> String {
+        let identity = [title.lowercased(), artist?.lowercased() ?? "", String(duration.isFinite ? Int(min(86400, max(0, duration.rounded()))) : 0)].joined(separator: "\u{0}")
+        return SHA256.hash(data: Data(identity.utf8)).map { String(format: "%02x", $0) }.joined()
+    }
+    static func load(key: String, directory: URL? = AyuLyricsCache.directory, now: Date = Date()) -> AyuLyrics? {
+        guard let directory, let data = try? Data(contentsOf: directory.appendingPathComponent(key + ".json")), data.count <= 1_048_576, let entry = try? JSONDecoder().decode(Entry.self, from: data) else { return nil }
+        let lifetime: TimeInterval
+        switch entry.lyrics { case .synced: lifetime = 7 * 86400; case .plain: lifetime = 6 * 3600; default: return nil }
+        let age = now.timeIntervalSince(entry.created)
+        guard age >= 0 && age < lifetime else { return nil }
+        return entry.lyrics
+    }
+    static func save(_ lyrics: AyuLyrics, key: String, directory: URL? = AyuLyricsCache.directory, now: Date = Date()) {
+        switch lyrics { case .synced, .plain: break; default: return }
+        guard let directory, let data = try? JSONEncoder().encode(Entry(created: now, lyrics: lyrics)), data.count <= 1_048_576 else { return }
+        try? FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        try? data.write(to: directory.appendingPathComponent(key + ".json"), options: .atomic)
+        let files = (try? FileManager.default.contentsOfDirectory(at: directory, includingPropertiesForKeys: [.contentModificationDateKey])) ?? []
+        if files.count > 200 {
+            let oldest = files.sorted { ((try? $0.resourceValues(forKeys: [.contentModificationDateKey]).contentModificationDate) ?? .distantPast) < ((try? $1.resourceValues(forKeys: [.contentModificationDateKey]).contentModificationDate) ?? .distantPast) }
+            for file in oldest.prefix(files.count - 200) { try? FileManager.default.removeItem(at: file) }
+        }
+    }
+}
