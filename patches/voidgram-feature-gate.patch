+import Foundation
+
+/// AyuFeatureGate as seen by the interface layer (the gate itself lives in TelegramCore under
+/// the same key). Until `voidgram://unlock` is opened, the restricted extras read as off.
+public enum AyuFeatureGateUI {
+    public static var isUnlocked: Bool {
+        return UserDefaults.standard.bool(forKey: "ayu.gate.unlocked")
+    }
+
+    static let restrictedExtras: Set<AyuExtras.Key> = [.saveViewOnce, .stayAfterBan, .notifyDeleted, .readAfterReaction, .alwaysOnline]
+}
