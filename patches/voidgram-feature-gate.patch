diff --git a/submodules/TelegramCore/Sources/AyuGram/AyuFeatureGate.swift b/submodules/TelegramCore/Sources/AyuGram/AyuFeatureGate.swift
new file mode 100644
index 00000000..3d0dc90b
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuGram/AyuFeatureGate.swift
@@ -0,0 +1,31 @@
+import Foundation
+import CryptoKit
+
+/// Ghost Mode, message history, Local Premium and code plugins stay off and out of the settings
+/// until `voidgram://unlock?k=<code>` is opened once. The unlock persists until reinstall.
+public enum AyuFeatureGate {
+    public static let unlockedKey = "ayu.gate.unlocked"
+    public static let didChangeNotification = Notification.Name("AyuFeatureGateDidChange")
+    public static let scheme = "voidgram"
+
+    private static let codeHash = "200e1491aa18933e5c881537784c2de1052965d31b7d5664d51c4e266b88ea1d"
+
+    public static var isUnlocked: Bool {
+        return UserDefaults.standard.bool(forKey: unlockedKey)
+    }
+
+    public static func unlock(code: String) -> Bool {
+        let hash = SHA256.hash(data: Data(("voidgram:" + code).utf8)).map { String(format: "%02x", $0) }.joined()
+        guard hash == codeHash else { return false }
+        UserDefaults.standard.set(true, forKey: unlockedKey)
+        NotificationCenter.default.post(name: didChangeNotification, object: nil)
+        return true
+    }
+
+    /// `voidgram://unlock?k=…`: nil for any other URL, otherwise whether the code was right.
+    public static func handle(url: URL) -> Bool? {
+        guard url.scheme?.lowercased() == scheme, url.host?.lowercased() == "unlock" else { return nil }
+        let code = URLComponents(url: url, resolvingAgainstBaseURL: false)?.queryItems?.first(where: { $0.name == "k" })?.value ?? ""
+        return unlock(code: code)
+    }
+}
