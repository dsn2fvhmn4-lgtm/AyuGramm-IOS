+            let circleSide = min(size.height - 24.0, size.width - menuWidth - 36.0)
+            let circle = CGRect(x: 12.0, y: floor((size.height - circleSide) / 2.0), width: circleSide, height: circleSide)
+
+            context.saveGState()
+            UIBezierPath(ovalIn: circle).addClip()
+            UIColor.black.setFill()
+            context.fill(circle)
+            // The dust view-once media sits under until it is opened.
+            var seed: UInt64 = 0x9E3779B97F4A7C15
+            func next() -> CGFloat {
+                seed = seed &* 6364136223846793005 &+ 1442695040888963407
+                return CGFloat((seed >> 33) % 10000) / 10000.0
+            }
+            UIColor.white.withAlphaComponent(0.85).setFill()
+            for _ in 0 ..< 420 {
+                let point = CGPoint(x: circle.minX + next() * circle.width, y: circle.minY + next() * circle.height)
+                let side: CGFloat = next() > 0.8 ? 1.6 : 1.0
+                context.fillEllipse(in: CGRect(x: point.x, y: point.y, width: side, height: side))
+            }
+            context.restoreGState()
+            UIColor.white.setStroke()
+            let ring = UIBezierPath(ovalIn: circle.insetBy(dx: 3.0, dy: 3.0))
+            ring.lineWidth = 2.0
+            ring.stroke()
+            let play = CGRect(x: circle.midX - 26.0, y: circle.midY - 26.0, width: 52.0, height: 52.0)
+            UIColor(white: 1.0, alpha: 0.25).setFill()
+            context.fillEllipse(in: play)
+            if let icon = UIImage(systemName: "play.fill", withConfiguration: UIImage.SymbolConfiguration(pointSize: 22.0, weight: .bold))?.withTintColor(.white, renderingMode: .alwaysOriginal) {
+                icon.draw(at: CGPoint(x: play.midX - icon.size.width / 2.0 + 2.0, y: play.midY - icon.size.height / 2.0))
+            }
+
+            let menuTheme = theme.contextMenu
+            let rows: [(String, String, Bool)] = [
+                ("arrowshape.turn.up.left", ru ? "Ответить" : "Reply", false),
+                ("square.and.arrow.down", ru ? "Сохранить видео" : "Save Video", false),
+                ("pin", ru ? "Закрепить" : "Pin", false),
+                ("arrowshape.turn.up.right", ru ? "Переслать" : "Forward", false),
+                ("trash", ru ? "Удалить" : "Delete", true)
+            ]
+            let rowHeight: CGFloat = 32.0
+            let gap: CGFloat = 6.0
+            let menuHeight = CGFloat(rows.count + 1) * rowHeight + gap
+            let menu = CGRect(x: size.width - menuWidth - 12.0, y: floor((size.height - menuHeight) / 2.0), width: menuWidth, height: menuHeight)
+            context.saveGState()
+            UIBezierPath(roundedRect: menu, cornerRadius: 14.0).addClip()
+            menuTheme.backgroundColor.setFill()
+            context.fill(menu)
+            func drawRow(_ row: (String, String, Bool), y: CGFloat, highlighted: Bool) {
+                if highlighted {
+                    menuTheme.itemHighlightedBackgroundColor.setFill()
+                    UIBezierPath(roundedRect: CGRect(x: menu.minX + 4.0, y: y + 1.0, width: menu.width - 8.0, height: rowHeight - 2.0), cornerRadius: 9.0).fill()
+                }
+                let color = row.2 ? menuTheme.destructiveColor : menuTheme.primaryColor
+                if let icon = UIImage(systemName: row.0, withConfiguration: UIImage.SymbolConfiguration(pointSize: 13.0, weight: .regular))?.withTintColor(color, renderingMode: .alwaysOriginal) {
+                    icon.draw(at: CGPoint(x: menu.minX + 12.0, y: y + floor((rowHeight - icon.size.height) / 2.0)))
+                }
+                let font = UIFont.systemFont(ofSize: 13.0)
+                let title = row.1 as NSString
+                let titleSize = title.size(withAttributes: [.font: font])
+                title.draw(at: CGPoint(x: menu.minX + 36.0, y: y + floor((rowHeight - titleSize.height) / 2.0)), withAttributes: [.font: font, .foregroundColor: color])
+            }
+            var y = menu.minY
+            for (index, row) in rows.enumerated() {
+                drawRow(row, y: y, highlighted: index == 1)
+                y += rowHeight
+            }
+            menuTheme.sectionSeparatorColor.setFill()
+            context.fill(CGRect(x: menu.minX, y: y, width: menu.width, height: gap))
+            y += gap
+            drawRow(("checkmark.circle", ru ? "Выбрать" : "Select", false), y: y, highlighted: false)
+            context.restoreGState()
+        }
+    }
