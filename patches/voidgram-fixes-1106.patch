diff --git a/submodules/TelegramUI/Components/PeerInfo/PeerInfoScreen/Sources/AyuGiftGridItem.swift b/submodules/TelegramUI/Components/PeerInfo/PeerInfoScreen/Sources/AyuGiftGridItem.swift
