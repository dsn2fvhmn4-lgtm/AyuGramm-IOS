@@ -0,0 +1,162 @@
+import Foundation
+import UIKit
+import Display
+import AsyncDisplayKit
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import AccountContext
+import ComponentFlow
+import ItemListUI
+import GiftItemComponent
+
+/// Gifts drawn as the profile draws them: Telegram's gift cells with the model, backdrop, pattern
+/// and number, three to a row. A tap hands the cell's id back.
+final class AyuGiftGridItem: ListViewItem, ItemListItem {
+    let context: AccountContext
+    let presentationData: ItemListPresentationData
+    let gifts: [(index: Int, gift: StarGift)]
+    /// Price labels for catalog gifts, by gift id.
+    let prices: [Int64: String]
+    let sectionId: ItemListSectionId
+    let action: (Int) -> Void
+
+    init(context: AccountContext, presentationData: ItemListPresentationData, gifts: [(index: Int, gift: StarGift)], prices: [Int64: String] = [:], sectionId: ItemListSectionId, action: @escaping (Int) -> Void) {
+        self.context = context
+        self.presentationData = presentationData
+        self.gifts = gifts
+        self.prices = prices
+        self.sectionId = sectionId
+        self.action = action
+    }
+
+    func nodeConfiguredForParams(async: @escaping (@escaping () -> Void) -> Void, params: ListViewItemLayoutParams, synchronousLoads: Bool, neighbors: ListViewItemNeighbors, completion: @escaping (ListViewItemNode, @escaping () -> (Signal<Void, NoError>?, (ListViewItemApply) -> Void)) -> Void) {
+        Queue.mainQueue().async {
+            let node = AyuGiftGridItemNode()
+            let (layout, apply) = node.asyncLayout()(self, params, itemListNeighbors(item: self, topFacet: neighbors.previous?.base(ItemListNeighborFacet.self), bottomFacet: neighbors.next?.base(ItemListNeighborFacet.self)))
+            node.contentSize = layout.contentSize
+            node.insets = layout.insets
+            completion(node, {
+                return (nil, { _ in apply() })
+            })
+        }
+    }
+
+    func updateNode(async: @escaping (@escaping () -> Void) -> Void, node: @escaping () -> ListViewItemNode, params: ListViewItemLayoutParams, neighbors: ListViewItemNeighbors, animation: ListViewItemUpdateAnimation, completion: @escaping (ListViewItemNodeLayout, @escaping (ListViewItemApply) -> Void) -> Void) {
+        Queue.mainQueue().async {
+            if let nodeValue = node() as? AyuGiftGridItemNode {
+                let (layout, apply) = nodeValue.asyncLayout()(self, params, itemListNeighbors(item: self, topFacet: neighbors.previous?.base(ItemListNeighborFacet.self), bottomFacet: neighbors.next?.base(ItemListNeighborFacet.self)))
+                completion(layout, { _ in
+                    apply()
+                })
+            }
+        }
+    }
+}
+
+private let ayuGiftGridSpacing: CGFloat = 10.0
+private let ayuGiftGridInset: CGFloat = 12.0
+private let ayuGiftGridColumns = 3
+
+final class AyuGiftGridItemNode: ListViewItemNode {
+    private let backgroundNode: ASDisplayNode
+    private let maskNode: ASImageNode
+    private var cells: [ComponentView<Empty>] = []
+
+    init() {
+        self.backgroundNode = ASDisplayNode()
+        self.backgroundNode.isLayerBacked = true
+        self.maskNode = ASImageNode()
+        super.init(layerBacked: false)
+        self.clipsToBounds = true
+        self.addSubnode(self.backgroundNode)
+        self.addSubnode(self.maskNode)
+    }
+
+    func asyncLayout() -> (_ item: AyuGiftGridItem, _ params: ListViewItemLayoutParams, _ neighbors: ItemListNeighbors) -> (ListViewItemNodeLayout, () -> Void) {
+        return { [weak self] item, params, neighbors in
+            let blockWidth = params.width - params.leftInset - params.rightInset
+            let cellSide = floor((blockWidth - ayuGiftGridInset * 2.0 - ayuGiftGridSpacing * CGFloat(ayuGiftGridColumns - 1)) / CGFloat(ayuGiftGridColumns))
+            let rows = max(1, (item.gifts.count + ayuGiftGridColumns - 1) / ayuGiftGridColumns)
+            let contentSize = CGSize(width: params.width, height: ayuGiftGridInset * 2.0 + CGFloat(rows) * cellSide + CGFloat(rows - 1) * ayuGiftGridSpacing)
+            let insets = itemListNeighborsGroupedInsets(neighbors, params)
+            let layout = ListViewItemNodeLayout(contentSize: contentSize, insets: insets)
+            return (layout, { [weak self] in
+                guard let self else {
+                    return
+                }
+                let theme = item.presentationData.theme
+                let blockFrame = CGRect(x: params.leftInset, y: 0.0, width: blockWidth, height: contentSize.height)
+                self.backgroundNode.backgroundColor = theme.list.itemBlocksBackgroundColor
+                self.backgroundNode.frame = blockFrame
+
+                while self.cells.count < item.gifts.count {
+                    self.cells.append(ComponentView<Empty>())
+                }
+                while self.cells.count > item.gifts.count {
+                    self.cells.removeLast().view?.removeFromSuperview()
+                }
+                for (position, entry) in item.gifts.enumerated() {
+                    let subject: GiftItemComponent.Subject
+                    var ribbon: GiftItemComponent.Ribbon?
+                    switch entry.gift {
+                    case let .generic(gift):
+                        subject = .starGift(gift: gift, price: item.prices[gift.id] ?? "")
+                    case let .unique(gift):
+                        subject = .uniqueGift(gift: gift, price: nil)
+                        var color: GiftItemComponent.Ribbon.Color = .blue
+                        for attribute in gift.attributes {
+                            if case let .backdrop(_, _, innerColor, outerColor, _, _, _) = attribute {
+                                color = .custom(outerColor, innerColor)
+                                break
+                            }
+                        }
+                        ribbon = GiftItemComponent.Ribbon(text: "#\(gift.number)", font: .monospaced, color: color)
+                    }
+                    let index = entry.index
+                    let cell = self.cells[position]
+                    let _ = cell.update(
+                        transition: .immediate,
+                        component: AnyComponent(GiftItemComponent(
+                            context: item.context,
+                            style: .glass,
+                            theme: theme,
+                            strings: item.presentationData.strings,
+                            subject: subject,
+                            ribbon: ribbon,
+                            mode: .profile,
+                            action: {
+                                item.action(index)
+                            }
+                        )),
+                        environment: {},
+                        containerSize: CGSize(width: cellSide, height: cellSide)
+                    )
+                    if let view = cell.view {
+                        if view.superview == nil {
+                            self.view.insertSubview(view, belowSubview: self.maskNode.view)
+                        }
+                        let column = position % ayuGiftGridColumns
+                        let row = position / ayuGiftGridColumns
+                        view.frame = CGRect(x: blockFrame.minX + ayuGiftGridInset + CGFloat(column) * (cellSide + ayuGiftGridSpacing), y: ayuGiftGridInset + CGFloat(row) * (cellSide + ayuGiftGridSpacing), width: cellSide, height: cellSide)
+                    }
+                }
+
+                var hasTopCorners = false
+                var hasBottomCorners = false
+                if case .sameSection(false) = neighbors.top {} else { hasTopCorners = true }
+                if case .sameSection(false) = neighbors.bottom {} else { hasBottomCorners = true }
+                self.maskNode.image = itemListHasRoundedBlockLayout(params) ? PresentationResourcesItemList.cornersImage(theme, top: hasTopCorners, bottom: hasBottomCorners, glass: true) : nil
+                self.maskNode.frame = blockFrame
+            })
+        }
+    }
+
+    override func animateInsertion(_ currentTimestamp: Double, duration: Double, options: ListViewItemAnimationOptions) {
+        self.layer.animateAlpha(from: 0.0, to: 1.0, duration: 0.3)
+    }
+
+    override func animateRemoved(_ currentTimestamp: Double, duration: Double) {
+        self.layer.animateAlpha(from: 1.0, to: 0.0, duration: 0.15, removeOnCompletion: false)
+    }
+}
