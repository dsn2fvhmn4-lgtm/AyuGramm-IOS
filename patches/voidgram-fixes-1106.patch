+/// The peer's granted gifts drawn for the badge desk: each with its registry index, so a tap can
+/// take that very gift back. Follows the registry.
+public func ayuGrantedGiftPreviews(account: Account, peerId: EnginePeer.Id) -> Signal<[(index: Int, gift: ProfileGiftsContext.State.StarGift)], NoError> {
+    return ayuGrantedGiftsUpdates()
+    |> map { _ -> [AyuGrantedGift] in
+        return AyuSupportersManager.shared.grantedGifts(peerId: peerId.id._internalGetInt64Value())
+    }
+    |> distinctUntilChanged
+    |> mapToSignal { granted -> Signal<[(index: Int, gift: ProfileGiftsContext.State.StarGift)], NoError> in
+        if granted.isEmpty {
+            return .single([])
+        }
+        return combineLatest(granted.map { item in
+            return ayuGrantedGiftRows(account: account, peerId: peerId, granted: [item])
+            |> map { rows -> (index: Int, gift: ProfileGiftsContext.State.StarGift)? in
+                return rows.first.map { (index: item.index, gift: $0) }
+            }
+        })
+        |> map { rows in
+            return rows.compactMap { $0 }
+        }
+    }
+}
