+// MARK: - Privacy → Deleted messages
+
+/// Everything about deleted messages on one page: keeping them, how they look in the chat (fade
+/// and its strength, the mark beside the time), the notification and the archive.
+func ayuDeletedMessagesController(context: AccountContext) -> ViewController {
+    let store = context.account.network.ayuGhostMode
+    var push: ((ViewController) -> Void)?
+    var presentNative: ((UIViewController) -> Void)?
+    let update: ((inout AyuGhostModeSettings) -> Void) -> Void = { f in
+        let _ = try? store.update(f)
+    }
+    var arguments = AyuSectionedArguments(open: { id in
+        let ru = ayuIsRussian(context)
+        switch id {
+        case 20:
+            let styles: [AyuAppearanceSettings.DeletedMarkStyle] = [.text, .trash, .eye]
+            ayuChoose({ presentNative?($0) }, title: ru ? "Метка удалённых" : "Deleted mark", ru: ru, options: styles, current: store.current.appearance.deletedMarkStyle, label: { style in
+                switch style {
+                case .text: return AyuStrings.textText.text(ru)
+                case .trash: return AyuStrings.trash.text(ru)
+                case .eye: return AyuStrings.eye.text(ru)
+                }
+            }, equal: { $0 == $1 }, pick: { style in
+                update { $0.appearance.deletedMarkStyle = style }
+            })
+        case 21:
+            push?(ayuAppearanceController(context: context))
+        case 40:
+            push?(ayuMessageHistoryController(context: context, archiveOnly: true))
+        case 41:
+            push?(ayuMessageHistoryController(context: context))
+        default:
+            break
+        }
+    }, toggle: { id, value in
+        switch id {
+        case 1:
+            let _ = context.engine.messages.updateAyuMessageHistory(saveDeleted: value).startStandalone()
+        case 10:
+            update { $0.interface.semiTransparentDeletedMessages = value }
+        case 30:
+            AyuExtras.set(.notifyDeleted, value)
+        case 31:
+            AyuExtras.set(.skipOwnDeleted, value)
+        case 32:
+            update { $0.interface.replyToDeletedMessages = value }
+        default:
+            break
+        }
+        NotificationCenter.default.post(name: ayuLocalSettingsChanged, object: nil)
+    })
+    arguments.slider = { id, value in
+        if id == 11 {
+            update { $0.interface.deletedMessageTransparency = min(99, max(25, value)) }
+        }
+    }
+    arguments.context = context
+
+    let signal = combineLatest(ayuSettingsPresentationData(context: context), store.signal, context.engine.messages.ayuMessageHistory(), ayuChanges([ayuLocalSettingsChanged, AyuExtras.didChangeNotification]))
+    |> deliverOnMainQueue
+    |> map { presentationData, settings, history, _ -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        let interface = settings.interface
+        let appearance = settings.appearance
+        let markLabel: String
+        switch appearance.deletedMarkStyle {
+        case .text: markLabel = appearance.deletedMark.isEmpty ? AyuStrings.textText.text(ru) : appearance.deletedMark
+        case .trash: markLabel = AyuStrings.trash.text(ru)
+        case .eye: markLabel = AyuStrings.eye.text(ru)
+        }
+        var entries: [AyuSectionedEntry] = [
+            .chat(0, 0, AyuSectionedChatPreview(presentationData: presentationData, messages: [
+                ChatPreviewMessageItem(outgoing: false, reply: nil, text: AyuStrings.sendMeWiFiPasswordLater.text(ru), nameColor: .preset(.blue), backgroundEmojiId: nil, ayuDeleted: true),
+                ChatPreviewMessageItem(outgoing: true, reply: nil, text: AyuStrings.okSeeYouThere.text(ru), nameColor: .preset(.blue), backgroundEmojiId: nil)
+            ])),
+            .toggle(1, 1, symbol("trash.fill", 0xFF9500), AyuStrings.saveDeletedText.text(ru), ru ? "Удалённые собеседником сообщения остаются в чате" : "Messages the other side deletes stay in the chat", history.saveDeleted),
+            .header(2, 9, ru ? "КАК ВИДНО В ЧАТЕ" : "IN THE CHAT"),
+            .toggle(2, 10, symbol("circle.lefthalf.filled", 0x8E8E93), AyuStrings.semiTransparentDeleted.text(ru), nil, interface.semiTransparentDeletedMessages)
+        ]
+        if interface.semiTransparentDeletedMessages {
+            entries.append(.slider(2, 11, interface.deletedMessageTransparency, 25, 99))
+            entries.append(.info(2, 12, ru ? "Прозрачность удалённых: \(interface.deletedMessageTransparency)%" : "Deleted message transparency: \(interface.deletedMessageTransparency)%"))
+        }
+        entries.append(contentsOf: [
+            .header(3, 19, ru ? "МЕТКА" : "MARK"),
+            .link(3, 20, symbol("tag.fill", 0x5856D6), ru ? "Иконка или текст" : "Icon or text", markLabel),
+            .link(3, 21, symbol("character.cursor.ibeam", 0x007AFF), ru ? "Свой текст метки" : "Custom mark text", ""),
+            .header(4, 29, ru ? "ДРУГОЕ" : "OTHER"),
+            .toggle(4, 30, symbol("bell.badge.fill", 0xFF3B30), ru ? "Уведомлять об удалении" : "Notify about deletions", nil, AyuExtras.isOn(.notifyDeleted)),
+            .toggle(4, 31, symbol("person.crop.circle.badge.xmark", 0x8E8E93), ru ? "Не сохранять свои удалённые" : "Skip my own deleted", nil, AyuExtras.isOn(.skipOwnDeleted)),
+            .toggle(4, 32, symbol("arrowshape.turn.up.left.fill", 0x34C759), ru ? "Ответ на удалённые сообщения" : "Reply to deleted messages", nil, interface.replyToDeletedMessages),
+            .header(5, 39, ru ? "АРХИВ" : "ARCHIVE"),
+            .link(5, 40, symbol("tray.full.fill", 0xFF9500), AyuStrings.savedMessagesArchive.text(ru), "\(history.records.count)"),
+            .link(5, 41, symbol("gearshape.fill", 0x8E8E93), ru ? "Удалённые и изменённые" : "Deleted & edited", "")
+        ])
+        if !AyuFeatureGate.isUnlocked {
+            entries.removeAll(where: { $0.stableId == 30 })
+        }
+        let data = ItemListPresentationData(presentationData)
+        let state = ItemListControllerState(presentationData: data, title: .text(ru ? "Удалённые" : "Deleted"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        return (state, (ItemListNodeState(presentationData: data, entries: entries, style: .blocks, animateChanges: false), arguments))
+    }
+    let controller = ItemListController(context: context, state: signal)
+    push = { [weak controller] in controller?.push($0) }
+    presentNative = { context.sharedContext.applicationBindings.presentNativeController($0) }
+    return controller
+}
