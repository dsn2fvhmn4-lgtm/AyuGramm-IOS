index dc933d1b..12ee335c 100644
--- a/submodules/Display/Source/Font.swift
+++ b/submodules/Display/Source/Font.swift
@@ -160,9 +160,25 @@ public struct Font {
     private static let cache = Cache()
     
     /// AyuGram WhiteGram custom font: replaces the system face in regular text.
+    /// The size is adjusted so the face has the system font's line height: layouts measured
+    /// for San Francisco (chat list rows with their avatars, bubbles) keep their geometry.
     private static func ayuCustomFont(_ size: CGFloat) -> UIFont? {
         guard let name = AyuWhiteGram.cachedCustomFont else { return nil }
-        return UIFont(name: name, size: size)
+        let key = "ayu_custom_\(name)_\(size)"
+        if let cachedFont = self.cache.get(key) {
+            return cachedFont
+        }
+        guard let font = UIFont(name: name, size: size) else {
+            return nil
+        }
+        let systemLineHeight = UIFont.systemFont(ofSize: size).lineHeight
+        var result = font
+        if font.lineHeight > 0.0, abs(font.lineHeight - systemLineHeight) > 0.5 {
+            let scaled = size * systemLineHeight / font.lineHeight
+            result = UIFont(name: name, size: max(1.0, min(size * 1.3, scaled))) ?? font
+        }
+        self.cache.set(result, key: key)
+        return result
     }
 
     public static func with(size: CGFloat, design: Design = .regular, weight: Weight = .regular, width: Width = .standard, traits: Traits = []) -> UIFont {
