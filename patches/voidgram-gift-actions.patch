+/// The registry index of the account's own granted gift behind `reference`: a profile row's
+/// reference, or the NFT's slug as the craft screen passes its first gift.
+private func ayuOwnGrantedIndex(account: Account, reference: StarGiftReference) -> Int? {
+    if let index = ayuGrantedGiftIndex(reference) {
+        return index
+    }
+    guard case let .slug(slug) = reference, slug.hasPrefix(ayuGrantedSlugPrefix) else {
+        return nil
+    }
+    let parts = slug.dropFirst(ayuGrantedSlugPrefix.count).split(separator: "-")
+    guard parts.count == 2, let giftId = Int64(parts[0]), let number = Int32(parts[1]) else {
+        return nil
+    }
+    return AyuSupportersManager.shared.grantedGifts(peerId: account.peerId.id._internalGetInt64Value()).first(where: { $0.kind == .unique && $0.giftId == giftId && $0.number == number })?.index
+}
+
+/// Whether `reference` stands for a gift from the badge registry rather than a Telegram one.
+public func ayuIsGrantedGiftReference(_ reference: StarGiftReference?) -> Bool {
+    if ayuGrantedGiftIndex(reference) != nil {
+        return true
+    }
+    if case let .slug(slug)? = reference {
+        return slug.hasPrefix(ayuGrantedSlugPrefix)
+    }
+    return false
+}
+
+/// Pins the account's granted gift above the others on its profile, or unpins it.
+public func ayuPinGrantedGift(account: Account, reference: StarGiftReference, pinned: Bool) -> Signal<Never, String> {
+    return ayuHeldGiftRequest(account: account, route: "pin", reference: reference, body: ["pinned": pinned])
+    |> ignoreValues
+}
+
+/// Throws away one of the account's granted gifts.
+public func ayuDeleteGrantedGift(account: Account, reference: StarGiftReference) -> Signal<Never, String> {
+    return ayuHeldGiftRequest(account: account, route: "delete", reference: reference, body: [:])
+    |> ignoreValues
+}
+
+/// The account's granted NFTs of one collection, for the craft screen to pick from.
+func ayuGrantedCraftCandidates(account: Account, giftId: Int64) -> Signal<[ProfileGiftsContext.State.StarGift], NoError> {
+    let accountPeerId = account.peerId.id._internalGetInt64Value()
+    return ayuGrantedGiftsUpdates()
+    |> map { _ -> [AyuGrantedGift] in
+        return AyuSupportersManager.shared.grantedGifts(peerId: accountPeerId).filter { $0.kind == .unique && $0.giftId == giftId }
+    }
+    |> distinctUntilChanged
+    |> mapToSignal { granted -> Signal<[ProfileGiftsContext.State.StarGift], NoError> in
+        return ayuGrantedGiftRows(account: account, peerId: account.peerId, granted: granted)
+    }
+}
+
+/// Crafts the account's granted NFTs on the badge server: they are used up, and with luck a new NFT
+/// of the collection comes out. Fails with `.craftFailed` when it does not.
+func ayuCraftGrantedGifts(account: Account, references: [StarGiftReference]) -> Signal<ProfileGiftsContext.State.StarGift, CraftStarGiftError> {
+    let accountPeerId = account.peerId.id._internalGetInt64Value()
+    let indices = references.compactMap { ayuOwnGrantedIndex(account: account, reference: $0) }
+    guard !indices.isEmpty, indices.count == references.count else {
+        return .fail(.generic)
+    }
+    let before = Set(AyuSupportersManager.shared.grantedGifts(peerId: accountPeerId).map { "\($0.giftId)-\($0.number)" })
+    return AyuBadgeServer.post(account: account, route: "craft", body: ["indices": indices], ru: ayuRussian())
+    |> mapError { _ -> CraftStarGiftError in
+        return .generic
+    }
+    |> mapToSignal { _ -> Signal<ProfileGiftsContext.State.StarGift, CraftStarGiftError> in
+        // A crafted NFT is the one gift the account did not hold before.
+        guard let crafted = AyuSupportersManager.shared.grantedGifts(peerId: accountPeerId).first(where: { $0.kind == .unique && !before.contains("\($0.giftId)-\($0.number)") }) else {
+            return .fail(.craftFailed)
+        }
+        return ayuGrantedGiftRows(account: account, peerId: account.peerId, granted: [crafted])
+        |> take(1)
+        |> castError(CraftStarGiftError.self)
+        |> mapToSignal { rows -> Signal<ProfileGiftsContext.State.StarGift, CraftStarGiftError> in
+            guard let row = rows.first else {
+                return .fail(.generic)
+            }
+            return .single(row)
+        }
+    }
+}
