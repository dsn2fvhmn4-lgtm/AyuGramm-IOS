--- /dev/null
+++ b/submodules/TelegramUI/Sources/AyuLyricsPauseView.swift
@@ -0,0 +1,28 @@
+import UIKit
+
+/// Instrumental-gap animation is driven by audio time, so it freezes exactly on pause.
+final class AyuLyricsPauseView: UIView {
+    private var time: Double?
+    private var start = 0.0
+    private var end = 0.0
+
+    override init(frame: CGRect) { super.init(frame: frame); self.isOpaque = false }
+    required init?(coder: NSCoder) { return nil }
+
+    func update(time: Double?, start: Double, end: Double) {
+        guard self.time != time || self.start != start || self.end != end else { return }
+        self.time = time; self.start = start; self.end = end
+        self.setNeedsDisplay()
+    }
+
+    override func draw(_ rect: CGRect) {
+        let progress = self.time.map { min(1.0, max(0.0, ($0 - self.start) / max(0.001, self.end - self.start))) } ?? 0.0
+        for index in 0 ..< 3 {
+            let lit = progress * 3.0 > Double(index)
+            let pulse = UIAccessibility.isReduceMotionEnabled ? 1.0 : self.time.map { 0.85 + 0.15 * sin(($0 - self.start) * 4.0 - Double(index)) } ?? 1.0
+            let radius = CGFloat(4.0 * pulse)
+            UIColor.white.withAlphaComponent(lit ? 0.95 : 0.22).setFill()
+            UIBezierPath(ovalIn: CGRect(x: CGFloat(index) * 18.0 + 5.0 - radius, y: self.bounds.midY - radius, width: radius * 2.0, height: radius * 2.0)).fill()
+        }
+    }
+}
