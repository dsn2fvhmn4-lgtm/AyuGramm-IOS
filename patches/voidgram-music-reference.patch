new file mode 100644
index 0000000..c5b61bf
--- /dev/null
+++ b/submodules/TelegramUI/Sources/AyuMusicMetadata.swift
@@ -0,0 +1,31 @@
+import Foundation
+
+/// Normalize tags and common downloaded filenames without discarding live/remix versions.
+enum AyuMusicMetadata {
+    static func track(title: String?, artist: String?, filename: String?) -> (title: String, artist: String?) {
+        func clean(_ text: String?) -> String {
+            return (text ?? "").replacingOccurrences(of: "_", with: " ").trimmingCharacters(in: .whitespacesAndNewlines)
+        }
+        var name = clean(title)
+        if name.isEmpty { name = clean(filename) }
+        let suffix = (name as NSString).pathExtension.lowercased()
+        if ["mp3", "m4a", "aac", "flac", "ogg", "opus", "wav", "aiff", "alac"].contains(suffix) { name = (name as NSString).deletingPathExtension }
+        var performer = clean(artist)
+        if ["unknown", "unknown artist", "<unknown>", "неизвестный исполнитель"].contains(performer.lowercased()) { performer = "" }
+        if performer.isEmpty {
+            for separator in [" – ", " — ", " - "] {
+                let parts = name.components(separatedBy: separator)
+                if parts.count == 2, !parts[0].isEmpty, !parts[1].isEmpty {
+                    performer = parts[0]; name = parts[1]; break
+                }
+            }
+        }
+        return (name, performer.isEmpty ? nil : performer)
+    }
+
+    static func searchTitle(_ title: String) -> String {
+        return title.replacingOccurrences(of: #"\s*[\(\[]\s*(?:official\s+(?:audio|video|music\s+video|lyric\s+video)|lyrics?|audio|hq|hd|4k)\s*[\)\]]"#, with: "", options: [.regularExpression, .caseInsensitive])
+            .replacingOccurrences(of: #"\s+"#, with: " ", options: .regularExpression)
+            .trimmingCharacters(in: .whitespacesAndNewlines)
+    }
+}
