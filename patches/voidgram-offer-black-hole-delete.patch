+/// CADisplayLink retains its target — the proxy breaks the cycle.
+private final class DisplayLinkTarget: NSObject {
+    let action: () -> Void
+    init(_ action: @escaping () -> Void) { self.action = action }
+    @objc func fire() { action() }
+}
