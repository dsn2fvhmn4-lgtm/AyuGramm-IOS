diff --git a/submodules/TelegramUI/Components/Chat/BlackHoleDelete/Sources/BlackHoleDeleteAnimator.swift b/submodules/TelegramUI/Components/Chat/BlackHoleDelete/Sources/BlackHoleDeleteAnimator.swift
