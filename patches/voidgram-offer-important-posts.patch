+                    offset.y += chipHeight + chipSpacing
+                }
+                inputFrame = CGRect(origin: CGPoint(x: offset.x + (offset.x > leftInset ? 2.0 : 0.0), y: offset.y), size: CGSize(width: params.width - rightInset - offset.x, height: chipHeight))
