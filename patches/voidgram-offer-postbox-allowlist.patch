diff --git a/third-party/ayu-python/Python.framework/Headers/cpython/monitoring.h b/third-party/ayu-python/Python.framework/Headers/cpython/monitoring.h
new file mode 100644
index 00000000..797ba512
--- /dev/null
+++ b/third-party/ayu-python/Python.framework/Headers/cpython/monitoring.h
@@ -0,0 +1,250 @@
+#ifndef Py_CPYTHON_MONITORING_H
+#  error "this header file must not be included directly"
+#endif
+
+/* Local events.
