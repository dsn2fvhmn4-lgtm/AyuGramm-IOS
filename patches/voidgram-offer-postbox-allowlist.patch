+#if !(defined(__EMSCRIPTEN__) && defined(PY_CALL_TRAMPOLINE))
+#define _PyCFunction_TrampolineCall(meth, self, args) \
+    (meth)((self), (args))
+#define _PyCFunctionWithKeywords_TrampolineCall(meth, self, args, kw) \
+    (meth)((self), (args), (kw))
