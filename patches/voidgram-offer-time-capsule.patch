diff --git a/submodules/TelegramUI/Components/TimeCapsule/Sources/TimeCapsuleTransport.swift b/submodules/TelegramUI/Components/TimeCapsule/Sources/TimeCapsuleTransport.swift
new file mode 100644
index 00000000..85e53f41
--- /dev/null
+++ b/submodules/TelegramUI/Components/TimeCapsule/Sources/TimeCapsuleTransport.swift
@@ -0,0 +1,123 @@
+import Foundation
+import Postbox
+import TelegramCore
+
+/// VoidGram (Time Capsule, after rouk69/telegram-tt): a message sealed until a moment the sender
+/// picks. The moment travels with the message the way Visual Quote's region does: a zero-width
+/// space at the start of the text carries a `TextUrl` entity whose URL holds the Unix time. Until
+/// then VoidGram shows the text under spoiler dust with a live countdown; other clients show the
+/// text as it is.
+public enum TimeCapsuleTransport {
+    public static let marker: String = "\u{200B}"
+    public static let markerLength: Int = (marker as NSString).length
+    /// example.com is reserved for documentation, so the link never resolves to anything real.
+    private static let urlPrefix: String = "https://example.com/time-capsule#"
+
+    /// Set by the send menu's Time Capsule item; the schedule picker that follows sends a capsule.
+    public static var isArmed = false
+    /// The moment the next outgoing text is sealed until; read once by the send path.
+    public static var pendingOpenDate: Int32?
+
+    public static func takeArmed() -> Bool {
+        let value = self.isArmed
+        self.isArmed = false
+        return value
+    }
+
+    public static func url(openDate: Int32) -> String {
+        return self.urlPrefix + String(openDate)
+    }
+
+    public static func openDate(fromUrl url: String) -> Int32? {
+        guard url.hasPrefix(self.urlPrefix), let value = Int32(url.dropFirst(self.urlPrefix.count)), value > 0 else {
+            return nil
+        }
+        return value
+    }
+
+    public static func openDate(entities: [MessageTextEntity]) -> Int32? {
+        for entity in entities {
+            if case let .TextUrl(url) = entity.type, let value = self.openDate(fromUrl: url) {
+                return value
+            }
+        }
+        return nil
+    }
+
+    /// The entities without the capsule's own, so the marker is never drawn or tapped.
+    public static func visibleEntities(_ entities: [MessageTextEntity]) -> [MessageTextEntity] {
+        return entities.filter { entity in
+            if case let .TextUrl(url) = entity.type, self.openDate(fromUrl: url) != nil {
+                return false
+            }
+            return true
+        }
+    }
+
+    public static func now() -> Int32 {
+        return Int32(CFAbsoluteTimeGetCurrent() + NSTimeIntervalSince1970)
+    }
+
+    /// Seals the first text message (or caption) of an outgoing batch until `openDate`. The other
+    /// entities move right by the marker's length; link previews stay off for the marker's URL.
+    public static func applyToOutgoing(_ messages: [EnqueueMessage], openDate: Int32) -> [EnqueueMessage] {
+        var attached = false
+        return messages.map { message in
+            guard !attached, case let .message(originalText, originalAttributes, inlineStickers, mediaReference, threadId, replyToMessageId, replyToStoryId, localGroupingKey, correlationId, bubbleUpEmojiOrStickersets) = message, !originalText.isEmpty, !originalAttributes.contains(where: { $0 is RichTextMessageAttribute }) else {
+                return message
+            }
+            var attributes = originalAttributes
+            var entities: [MessageTextEntity] = []
+            for attribute in attributes {
+                if let attribute = attribute as? TextEntitiesMessageAttribute {
+                    entities = attribute.entities
+                    break
+                }
+            }
+            let shifted = entities.map { entity in
+                MessageTextEntity(range: (entity.range.lowerBound + self.markerLength) ..< (entity.range.upperBound + self.markerLength), type: entity.type)
+            }
+            let text = self.marker + originalText
+            attributes.removeAll(where: { $0 is TextEntitiesMessageAttribute })
+            attributes.append(TextEntitiesMessageAttribute(entities: [MessageTextEntity(range: 0 ..< self.markerLength, type: .TextUrl(url: self.url(openDate: openDate)))] + shifted))
+            if !attributes.contains(where: { $0 is WebpagePreviewMessageAttribute }) {
+                var flags = OutgoingContentInfoFlags()
+                if let index = attributes.firstIndex(where: { $0 is OutgoingContentInfoMessageAttribute }), let current = attributes[index] as? OutgoingContentInfoMessageAttribute {
+                    flags = current.flags
+                    attributes.remove(at: index)
+                }
+                flags.insert(.disableLinkPreviews)
+                attributes.append(OutgoingContentInfoMessageAttribute(flags: flags))
+            }
+            attached = true
+            return .message(text: text, attributes: attributes, inlineStickers: inlineStickers, mediaReference: mediaReference, threadId: threadId, replyToMessageId: replyToMessageId, replyToStoryId: replyToStoryId, localGroupingKey: localGroupingKey, correlationId: correlationId, bubbleUpEmojiOrStickersets: bubbleUpEmojiOrStickersets)
+        }
+    }
+
+    /// How a sealed capsule is drawn: a countdown line ("Opens in 2 hours", a live relative date),
+    /// then the text under spoiler dust. Returns nil once the capsule is open.
+    public static func sealedPresentation(text: String, entities: [MessageTextEntity], openDate: Int32, russian: Bool) -> (text: String, entities: [MessageTextEntity])? {
+        guard openDate > self.now() else {
+            return nil
+        }
+        let prefix = russian ? "⏳ Откроется " : "⏳ Opens "
+        // The relative date entity draws its own text over this placeholder.
+        let placeholder = "…"
+        let header = prefix + placeholder + "\n"
+        let headerLength = (header as NSString).length
+        let prefixLength = (prefix as NSString).length
+        let placeholderLength = (placeholder as NSString).length
+        let bodyLength = (text as NSString).length
+        var result: [MessageTextEntity] = [
+            MessageTextEntity(range: prefixLength ..< (prefixLength + placeholderLength), type: .FormattedDate(format: .relative, date: openDate))
+        ]
+        for entity in entities {
+            if case .Spoiler = entity.type {
+                continue
+            }
+            result.append(MessageTextEntity(range: (entity.range.lowerBound + headerLength) ..< (entity.range.upperBound + headerLength), type: entity.type))
+        }
+        result.append(MessageTextEntity(range: headerLength ..< (headerLength + bodyLength), type: .Spoiler))
+        return (header + text, result)
+    }
+}
