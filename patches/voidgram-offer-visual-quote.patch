@@ -0,0 +1,121 @@
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import Postbox
+import TelegramCore
+import AccountContext
+import PhotoResources
+
+/// Layout constants shared by the places that draw a visual quote.
+public enum VisualQuoteLayout {
+    /// The fragment in a reply header, as a multiple of the title line height (a plain photo reply uses 2).
+    public static let replyImageScale: CGFloat = 8.0
+
+    /// The thumbnail box for a fragment of `fragmentSize` pixels when the usual square side is `side` and the
+    /// header can be up to `maximumWidth` wide. The box takes the fragment's own shape: a landscape fragment
+    /// grows in width (like a long text quote takes the whole bubble width) while its height stays within
+    /// `side`; a portrait one keeps `side` as height. The short side never drops below a quarter of `side`.
+    public static func replyThumbnailSize(fragmentSize: CGSize, side: CGFloat, maximumWidth: CGFloat) -> CGSize {
+        let minimumShortSide = floor(side / 4.0)
+        guard fragmentSize.width > 0.0, fragmentSize.height > 0.0 else {
+            return CGSize(width: side, height: side)
+        }
+        if fragmentSize.width >= fragmentSize.height {
+            let width = min(max(side, maximumWidth), floor(side * fragmentSize.width / fragmentSize.height))
+            return CGSize(width: width, height: max(minimumShortSide, min(side, floor(width * fragmentSize.height / fragmentSize.width))))
+        } else {
+            return CGSize(width: max(minimumShortSide, floor(side * fragmentSize.width / fragmentSize.height)), height: side)
+        }
+    }
+}
+
+public extension VisualQuoteRegion {
+    /// The region as a gallery media subject, so the gallery can open zoomed to it.
+    var galleryMediaSubject: GalleryMediaSubject {
+        return .visualQuoteRegion(self.encoded())
+    }
+
+    init?(mediaSubject: GalleryMediaSubject?) {
+        guard case let .visualQuoteRegion(data) = mediaSubject else {
+            return nil
+        }
+        self.init(encoded: data)
+    }
+}
+
+/// A `TransformImageNode` signal that draws the selected region of a photo message, cut out of
+/// the best representation available locally (the thumbnail first, the full photo once downloaded).
+public func visualQuoteCropImage(postbox: Postbox, message: Message, photo: TelegramMediaImage, region: VisualQuoteRegion) -> Signal<(TransformImageArguments) -> DrawingContext?, NoError> {
+    let photoReference = ImageMediaReference.message(message: MessageReference(message), media: photo)
+    return chatMessagePhoto(postbox: postbox, userLocation: .peer(message.id.peerId), photoReference: photoReference)
+    |> map { generate -> (TransformImageArguments) -> DrawingContext? in
+        // The node asks again whenever its layout changes; decode the photo once per emission.
+        let decoded = Atomic<(side: CGFloat, image: CGImage?)?>(value: nil)
+        return { arguments in
+            guard let context = DrawingContext(size: arguments.drawingSize, scale: arguments.scale ?? 0.0, clear: true) else {
+                return nil
+            }
+            let drawingRect = arguments.drawingRect
+
+            // Decode the whole photo at a size that keeps the fragment sharp but stays cheap.
+            let fragmentScale = max(1.0, 1.0 / max(region.rect.width, region.rect.height))
+            let decodeSide = min(1536.0, max(arguments.boundingSize.width, arguments.boundingSize.height) * fragmentScale * UIScreenScale)
+            let dimensions = (largestRepresentationForPhoto(photo)?.dimensions.cgSize ?? CGSize(width: 1.0, height: 1.0)).fitted(CGSize(width: decodeSide, height: decodeSide))
+            let fullArguments = TransformImageArguments(corners: ImageCorners(), imageSize: dimensions, boundingSize: dimensions, intrinsicInsets: UIEdgeInsets())
+
+            let full: CGImage?
+            if let current = decoded.with({ $0 }), current.side == decodeSide {
+                full = current.image
+            } else {
+                full = generate(fullArguments)?.generateImage()?.cgImage
+                let _ = decoded.swap((decodeSide, full))
+            }
+            var cropped: CGImage?
+            if let full {
+                let width = CGFloat(full.width)
+                let height = CGFloat(full.height)
+                let cropRect = CGRect(x: floor(region.rect.minX * width), y: floor(region.rect.minY * height), width: max(1.0, floor(region.rect.width * width)), height: max(1.0, floor(region.rect.height * height))).intersection(CGRect(x: 0.0, y: 0.0, width: width, height: height))
+                if !cropRect.isNull {
+                    cropped = full.cropping(to: cropRect)
+                }
+            }
+
+            var cornerRadius: CGFloat = 0.0
+            if case let .Corner(radius) = arguments.corners.topLeft {
+                cornerRadius = radius
+            }
+            context.withFlippedContext { c in
+                // Clip to the rounded shape instead of `addCorners`: that helper multiplies the colour of
+                // semi-transparent pixels by their alpha once more, which darkened the corners of the
+                // placeholder bands around a fragment.
+                if cornerRadius > 0.0 {
+                    c.addPath(UIBezierPath(roundedRect: drawingRect, cornerRadius: cornerRadius).cgPath)
+                    c.clip()
+                }
+                c.setBlendMode(.copy)
+                if let cropped {
+                    let imageSize = CGSize(width: cropped.width, height: cropped.height)
+                    // Show the whole fragment; when the box could not take its exact shape (short side clamped),
+                    // the remainder is filled with the placeholder colour.
+                    c.setFillColor((arguments.emptyColor ?? UIColor.white).cgColor)
+                    c.fill(drawingRect)
+                    let fittedSize = imageSize.aspectFitted(drawingRect.size)
+                    let fittedRect = CGRect(origin: CGPoint(x: drawingRect.midX - fittedSize.width / 2.0, y: drawingRect.midY - fittedSize.height / 2.0), size: fittedSize)
+                    if cornerRadius > 0.0 {
+                        // When the fragment sits inside placeholder bands, round its own corners too, like the
+                        // thumbnail's; when it fills the box this is the same shape as the clip above.
+                        c.addPath(UIBezierPath(roundedRect: fittedRect, cornerRadius: min(cornerRadius, min(fittedRect.width, fittedRect.height) / 2.0)).cgPath)
+                        c.clip()
+                    }
+                    c.interpolationQuality = .medium
+                    c.draw(cropped, in: fittedRect)
+                } else {
+                    c.setFillColor((arguments.emptyColor ?? UIColor.white).cgColor)
+                    c.fill(drawingRect)
+                }
+            }
+            return context
+        }
+    }
+}
diff --git a/submodules/TelegramUI/Components/VisualQuote/Sources/VisualQuoteDetector.swift b/submodules/TelegramUI/Components/VisualQuote/Sources/VisualQuoteDetector.swift
new file mode 100644
index 00000000..1888895f
--- /dev/null
+++ b/submodules/TelegramUI/Components/VisualQuote/Sources/VisualQuoteDetector.swift
@@ -0,0 +1,151 @@
+import Foundation
+import UIKit
+import SwiftSignalKit
+import TelegramCore
+import AccountContext
+import ImageObjectSeparation
+
+/// Result of looking for an object under the user's finger.
+public enum VisualQuoteDetection {
+    /// An object was found under the point; the region's rect is its bounding box.
+    case object(region: VisualQuoteRegion)
+    /// Nothing confident under the point.
+    case point(region: VisualQuoteRegion)
+}
+
+/// Finds the object under a touch point using the same object separation the
+/// sticker editor uses (`ImageObjectSeparation`): Vision subject lifting on
+/// device, a CoreML fallback model in the simulator.
+public final class VisualQuoteDetector {
+    private static var preparedAccountId: AccountRecordId?
+    private static var availabilityDisposable: Disposable?
+    private static var isAvailable: Bool = false
+
+    /// Makes object separation ready for the given account. In the simulator this downloads the
+    /// fallback model once per launch; until it arrives, detection returns `.point`.
+    public static func prepare(context: AccountContext) {
+        if self.preparedAccountId == context.account.id {
+            return
+        }
+        self.preparedAccountId = context.account.id
+        self.isAvailable = false
+        self.availabilityDisposable?.dispose()
+        self.availabilityDisposable = (cutoutAvailability(context: context)
+        |> deliverOnMainQueue).start(next: { availability in
+            if case .available = availability {
+                self.isAvailable = true
+            }
+        })
+    }
+
+    /// Detects the object under `normalizedPoint` (0...1, top-left origin). The completion is called on the main queue.
+    public static func detect(image: UIImage, normalizedPoint: CGPoint, completion: @escaping (VisualQuoteDetection) -> Void) {
+        let pointDetection = VisualQuoteDetection.point(region: self.pointRegion(at: normalizedPoint, imageSize: image.size))
+        guard self.isAvailable else {
+            completion(pointDetection)
+            return
+        }
+        // The object separation's CoreML fallback (used in the simulator) scales the mask back with
+        // `image.size`, which is in points. Gallery images carry the screen scale, so hand over a
+        // pixel-sized copy (scale 1) to keep the mask aligned with the image.
+        guard let cgImage = image.cgImage else {
+            completion(pointDetection)
+            return
+        }
+        let pixelImage = UIImage(cgImage: cgImage, scale: 1.0, orientation: image.imageOrientation)
+        cutoutImage(from: pixelImage, editedImage: nil, crop: nil, target: .point(normalizedPoint), includeExtracted: false, completion: { results in
+            var detection = pointDetection
+            for result in results {
+                guard let maskImage = result.maskImage, case let .image(uiImage, _) = maskImage, let cgImage = uiImage.cgImage else {
+                    continue
+                }
+                guard let bitmap = MaskBitmap(cgImage: cgImage, maxSide: 256) else {
+                    continue
+                }
+                let rect = bitmap.boundingRect()
+                let containsPoint = bitmap.contains(normalizedPoint: normalizedPoint)
+                guard containsPoint, let rect else {
+                    continue
+                }
+                if rect.width < 0.01 || rect.height < 0.01 {
+                    continue
+                }
+                detection = .object(region: VisualQuoteRegion(kind: .object, point: normalizedPoint, rect: rect))
+                break
+            }
+            Queue.mainQueue().async {
+                completion(detection)
+            }
+        })
+    }
+
+    /// A square area around the point, about a fifth of the shorter side of the image.
+    public static func pointRegion(at point: CGPoint, imageSize: CGSize) -> VisualQuoteRegion {
+        let side = min(imageSize.width, imageSize.height) * 0.2
+        let width = min(1.0, side / max(1.0, imageSize.width))
+        let height = min(1.0, side / max(1.0, imageSize.height))
+        var rect = CGRect(x: point.x - width / 2.0, y: point.y - height / 2.0, width: width, height: height)
+        rect.origin.x = max(0.0, min(1.0 - width, rect.origin.x))
+        rect.origin.y = max(0.0, min(1.0 - height, rect.origin.y))
+        return VisualQuoteRegion(kind: .point, point: point, rect: rect)
+    }
+}
+
+/// A downscaled 8-bit copy of a mask, used to test containment and compute a bounding box.
+private struct MaskBitmap {
+    let width: Int
+    let height: Int
+    let pixels: [UInt8]
+
+    init?(cgImage: CGImage, maxSide: Int) {
+        let scale = min(1.0, CGFloat(maxSide) / CGFloat(max(cgImage.width, cgImage.height)))
+        let width = max(1, Int(CGFloat(cgImage.width) * scale))
+        let height = max(1, Int(CGFloat(cgImage.height) * scale))
+        var pixels = [UInt8](repeating: 0, count: width * height)
+        let drawn = pixels.withUnsafeMutableBytes { buffer -> Bool in
+            guard let context = CGContext(data: buffer.baseAddress, width: width, height: height, bitsPerComponent: 8, bytesPerRow: width, space: CGColorSpaceCreateDeviceGray(), bitmapInfo: CGImageAlphaInfo.none.rawValue) else {
+                return false
+            }
+            context.interpolationQuality = .medium
+            context.draw(cgImage, in: CGRect(origin: CGPoint(), size: CGSize(width: width, height: height)))
+            return true
+        }
+        if !drawn {
+            return nil
+        }
+        self.width = width
+        self.height = height
+        self.pixels = pixels
+    }
+
+    /// Bitmap rows start at the top of the image, so a top-left normalized point maps directly.
+    func contains(normalizedPoint point: CGPoint) -> Bool {
+        let x = max(0, min(self.width - 1, Int(point.x * CGFloat(self.width))))
+        let y = max(0, min(self.height - 1, Int(point.y * CGFloat(self.height))))
+        return self.pixels[y * self.width + x] > 127
+    }
+
+    func boundingRect() -> CGRect? {
+        var minX = self.width, minY = self.height, maxX = -1, maxY = -1
+        for y in 0 ..< self.height {
+            let row = y * self.width
+            for x in 0 ..< self.width {
+                if self.pixels[row + x] > 127 {
+                    if x < minX { minX = x }
+                    if x > maxX { maxX = x }
+                    if y < minY { minY = y }
+                    if y > maxY { maxY = y }
+                }
+            }
+        }
+        if maxX < 0 {
+            return nil
+        }
+        return CGRect(
+            x: CGFloat(minX) / CGFloat(self.width),
+            y: CGFloat(minY) / CGFloat(self.height),
+            width: CGFloat(maxX - minX + 1) / CGFloat(self.width),
+            height: CGFloat(maxY - minY + 1) / CGFloat(self.height)
+        )
+    }
+}
