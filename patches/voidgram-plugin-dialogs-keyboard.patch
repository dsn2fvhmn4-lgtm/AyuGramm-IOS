diff --git a/submodules/SettingsUI/Sources/AyuPluginPresentation.swift b/submodules/SettingsUI/Sources/AyuPluginPresentation.swift
new file mode 100644
index 0000000..0373787
--- /dev/null
+++ b/submodules/SettingsUI/Sources/AyuPluginPresentation.swift
@@ -0,0 +1,26 @@
+import UIKit
+
+/// Telegram windows must register a native presentation to route touches to it.
+protocol AyuPluginPresentationHost: AnyObject {
+    func presentPluginController(_ controller: UIViewController)
+}
+
+class AyuPluginTableController: UITableViewController {
+    override func present(_ viewControllerToPresent: UIViewController, animated flag: Bool, completion: (() -> Void)? = nil) {
+        var ancestor = self.parent
+        while let current = ancestor {
+            if let host = current as? AyuPluginPresentationHost {
+                self.view.endEditing(true)
+                host.presentPluginController(viewControllerToPresent)
+                if let completion {
+                    if let coordinator = viewControllerToPresent.transitionCoordinator {
+                        coordinator.animate(alongsideTransition: nil, completion: { _ in completion() })
+                    } else { DispatchQueue.main.async(execute: completion) }
+                }
+                return
+            }
+            ancestor = current.parent
+        }
+        super.present(viewControllerToPresent, animated: flag, completion: completion)
+    }
+}
