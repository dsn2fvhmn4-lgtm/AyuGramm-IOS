+/// Whether a unique gift is one granted in VoidGram rather than a Telegram collectible.
+public func ayuIsGrantedGiftSlug(_ slug: String) -> Bool {
+    return slug.hasPrefix(ayuGrantedSlugPrefix)
+}
+
+/// Wears the account's own granted NFT with this slug, from any place Telegram offers "Wear".
+/// Only VoidGram users see it; the Telegram status under it stays as it was for everyone else.
+func ayuWearGrantedGift(account: Account, slug: String) -> Signal<Never, NoError> {
+    let parts = slug.dropFirst(ayuGrantedSlugPrefix.count).split(separator: "-")
+    guard ayuIsGrantedGiftSlug(slug), parts.count == 2, let giftId = Int64(parts[0]), let number = Int32(parts[1]),
+          let gift = AyuSupportersManager.shared.grantedGifts(peerId: account.peerId.id._internalGetInt64Value()).first(where: { $0.kind == .unique && $0.giftId == giftId && $0.number == number }) else {
+        return .complete()
+    }
+    return ayuHeldGiftRequest(account: account, route: "wear", reference: .slug(slug: ayuGrantReferencePrefix + String(gift.index)), body: ["worn": true])
+    |> ignoreValues
+    |> `catch` { _ -> Signal<Never, NoError> in
+        return .complete()
+    }
+}
+
+/// The account picked a Telegram emoji status (an emoji from a pack, its own collectible or none),
+/// which everyone sees. A granted NFT worn over it would hide it in VoidGram, so it comes off: at
+/// once on this device, then in the registry.
+func ayuTakeOffGrantedGiftForTelegramStatus(account: Account) -> Signal<Never, NoError> {
+    return Signal { subscriber in
+        guard ayuWearsGrantedGift(account: account) else {
+            subscriber.putCompletion()
+            return EmptyDisposable
+        }
+        ayuWornGiftStatusesLock.lock()
+        ayuWornGiftStatusesByPeer.removeValue(forKey: account.peerId.id._internalGetInt64Value())
+        ayuWornGiftStatusesLock.unlock()
+        let _ = ayuWearGrantedGift(account: account, reference: nil, worn: false).startStandalone()
+        subscriber.putCompletion()
+        return EmptyDisposable
+    }
+}
+
