+// AyuGram: a section draws one rounded panel as tall as its rows and stacks comments under it, so a
+// comment between rows (a note, a plugin block, the team label) cuts the panel and leaves the rows
+// after it outside. Rows keep their order and the comments follow the last row.
+private func ayuCommentsBelowRows(_ items: [PeerInfoScreenItem]) -> [PeerInfoScreenItem] {
+    let start = (items.lastIndex(where: { $0 is PeerInfoScreenHeaderItem }) ?? -1) + 1
+    guard let lastRow = items.lastIndex(where: { !($0 is PeerInfoScreenCommentItem) }), lastRow >= start else {
+        return items
+    }
+    let body = items[start ... lastRow]
+    let rows = body.filter { !($0 is PeerInfoScreenCommentItem) }
+    let comments = body.filter { $0 is PeerInfoScreenCommentItem }
+    return Array(items[..<start]) + rows + comments + Array(items[(lastRow + 1)...])
+}
