+/// State replay calls this on every transaction; decoding the whole history each time was a
+/// constant CPU cost. The full prune runs at most once a minute, while the explicit history
+/// operations below still call `ayuPruneHistory` directly.
+private enum AyuHistoryPruneClock {
+    static let lock = NSLock()
+    static var last: TimeInterval = 0.0
+}
+
+func ayuPruneHistoryIfNeeded(transaction: Transaction) {
+    AyuHistoryPruneClock.lock.lock()
+    let now = Date().timeIntervalSince1970
+    let due = now - AyuHistoryPruneClock.last >= 60.0
+    if due {
+        AyuHistoryPruneClock.last = now
+    }
+    AyuHistoryPruneClock.lock.unlock()
+    guard due else { return }
+    _ = ayuPruneHistory(transaction: transaction)
+}
+
 @discardableResult
 func ayuPruneHistory(transaction: Transaction) -> AyuMessageHistoryState {
     let original = ayuDecodeHistoryState(entry: transaction.getPreferencesEntry(key: ayuHistoryKey))
