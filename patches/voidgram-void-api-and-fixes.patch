+
+/// Automatic power saving. Low Power Mode or a hot phone turns off the optional animation
+/// work (particles, extra display-link frames) without changing any saved setting.
+public enum AyuPower {
+    private static let powerSaverKey = "ayu.power.saver"
+
+    /// On by default: optional particles and extra display-link frames stay off until the
+    /// owner turns this off. It never changes the interface the person chose.
+    public static var powerSaver: Bool {
+        get { return UserDefaults.standard.object(forKey: powerSaverKey) as? Bool ?? true }
+        set {
+            UserDefaults.standard.set(newValue, forKey: powerSaverKey)
+            NotificationCenter.default.post(name: AyuAppearancePlus.didChangeNotification, object: nil)
+        }
+    }
+
+    public static var isThrottled: Bool {
+        if powerSaver {
+            return true
+        }
+        let process = ProcessInfo.processInfo
+        if process.isLowPowerModeEnabled {
+            return true
+        }
+        switch process.thermalState {
+        case .serious, .critical:
+            return true
+        default:
+            return false
+        }
+    }
+}
