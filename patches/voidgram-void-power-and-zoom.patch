+// A real account starts with Ghost Mode on, and the chat button writes only that chat.
+let defaultAccount = root.appendingPathComponent("account-default")
+try FileManager.default.createDirectory(at: defaultAccount, withIntermediateDirectories: true)
+let defaultStore = AyuGhostModeStore(accountPath: defaultAccount.path)
+defaultStore.accountPeerId = 777
+check(defaultStore.current.allEnabled, "A new account starts with Ghost Mode on")
+try defaultStore.update { $0.setChatEnabled(false, peerId: 111) }
+check(!defaultStore.current.isActive(inPeer: 111), "Turning Ghost Mode off in one chat is local")
+check(defaultStore.current.isActive(inPeer: 222), "Other chats keep Ghost Mode on")
+check(AyuGhostModeStore(accountPath: defaultAccount.path).current.allEnabled, "The written policy keeps the other flags on")
