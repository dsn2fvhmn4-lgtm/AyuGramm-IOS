from base_plugin import BasePlugin, HookResult, HookStrategy

__id__ = "literal_hook_demo"
__name__ = "Literal hook demo"
__author__ = "AyuGramm-IOS"
__version__ = "1.0"
__description__ = "Replace tehh with the in plain outgoing cloud text."

class LiteralHookDemo(BasePlugin):
    def on_plugin_load(self):
        self.add_on_send_message_hook()

    def on_send_message_hook(self, account, params):
        params.message = params.message.replace("tehh", "the")
        return HookResult(strategy=HookStrategy.MODIFY, params=params)
