from base_plugin import BasePlugin, HookStrategy, HookResult

__id__ = "prefix_hook_demo"
__name__ = "Prefix hook demo"
__author__ = "AyuGramm-IOS"
__version__ = "1.0"
__description__ = "Convert [note] to NOTE only at the start of plain outgoing cloud text."

class PrefixHookDemo(BasePlugin):
    def on_plugin_load(self):
        self.add_on_send_message_hook()

    def on_send_message_hook(self, account, params):
        if params.message.startswith("[note]"):
            params.message = params.message.replace("[note]", "NOTE")
            return HookResult(strategy=HookStrategy.MODIFY, params=params)
        return HookResult()
