{
  "format": "ayugram-ios-plugin",
  "apiVersion": 3,
  "id": "camera_flip",
  "name": "Camera Flip",
  "author": "@its240hz (original)",
  "version": "0.2.0-ios.1",
  "summary": "Switch the round-video camera using vertical swipes or double taps. Gesture mode and haptic feedback are configurable.",
  "actions": [
    {
      "id": "camera_flip",
      "title": "Switch round-video camera with gestures",
      "kind": "cameraFlip"
    }
  ],
  "convertedFrom": "exteraGram Camera Flip 0.2.0",
  "sourceSHA256": "61136472b21e9ac23fc32883e137173ef1a85314d2cc6c63719be003555f1e98",
  "limitations": [
    "Native adapter for the round-video camera only. It uses the existing camera switch path, including torch, screen brightness and transition checks.",
    "One finger: vertical swipe over 60 points or double tap within 350 ms; 800 ms cooldown. Pinch and controls are excluded.",
    "Configure gesture and haptic feedback on this plugin page. Android reflection is replaced with a native bridge; source Python and Java are not executed."
  ]
}
