from base_plugin import BasePlugin, HookResult, HookStrategy
__id__ = "ota_lowercase_demo"
__name__ = "OTA lowercase demo"
__author__ = "neosay"
__version__ = "1.0"
__description__ = "Lowercase outgoing text through a helper method."
class OTALowercaseDemo(BasePlugin):
    def on_plugin_load(self):
        self.add_on_send_message_hook()
    def normalize(self, text):
        return text.lower()
    def on_send_message_hook(self, account, params):
        params.message = self.normalize(params.message)
        return HookResult(strategy=HookStrategy.MODIFY, params=params)
