{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AyuGramm-IOS plugin API 1",
  "type": "object",
  "required": [
    "format",
    "apiVersion",
    "id",
    "name",
    "author",
    "version",
    "summary",
    "actions",
    "limitations"
  ],
  "properties": {
    "format": {
      "const": "ayugram-ios-plugin"
    },
    "apiVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,64}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "summary": {
      "type": "string",
      "maxLength": 2048
    },
    "convertedFrom": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "sourceSHA256": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "limitations": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "maxLength": 512
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,64}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "kind": {
            "enum": [
              "search",
              "searchTerms",
              "replaceText",
              "outgoingReplace"
            ]
          },
          "find": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          },
          "replacement": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          },
          "prefix": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "replaceText",
                    "outgoingReplace"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "find",
                "replacement"
              ],
              "properties": {
                "find": {
                  "type": "string",
                  "minLength": 1
                },
                "replacement": {
                  "type": "string"
                }
              }
            },
            "else": {
              "properties": {
                "find": {
                  "type": "null"
                },
                "replacement": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "outgoingReplace"
                }
              }
            },
            "then": {
              "properties": {
                "replacement": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "description": "Nonempty replacement must not expand UTF-8/UTF-16 length; native importer checks this."
            },
            "else": {
              "properties": {
                "prefix": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    }
  }
}
