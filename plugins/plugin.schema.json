{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AyuGramm-IOS plugin API 1",
  "type": "object",
  "required": ["format", "apiVersion", "id", "name", "author", "version", "summary", "actions", "limitations"],
  "properties": {
    "format": { "const": "ayugram-ios-plugin" },
    "apiVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9_-]{1,64}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 64 },
    "author": { "type": "string", "minLength": 1, "maxLength": 128 },
    "version": { "type": "string", "minLength": 1, "maxLength": 32 },
    "summary": { "type": "string", "maxLength": 2048 },
    "convertedFrom": { "type": ["string", "null"], "maxLength": 128 },
    "sourceSHA256": { "type": ["string", "null"], "maxLength": 64 },
    "limitations": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 512 } },
    "icon": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "required": ["kind", "value"],
          "oneOf": [
            { "properties": { "kind": { "const": "symbol" }, "value": { "enum": ["puzzlepiece.fill", "magnifyingglass", "textformat", "line.3.horizontal.decrease", "star.fill", "bolt.fill"] } } },
            { "properties": { "kind": { "const": "emoji" }, "value": { "type": "string", "minLength": 1, "maxLength": 16, "description": "One emoji grapheme, at most 64 UTF-8 bytes; checked by the importer." } } },
            { "properties": { "kind": { "const": "png" }, "value": { "type": "string", "maxLength": 87384, "contentEncoding": "base64", "contentMediaType": "image/png", "description": "PNG at most 64 KiB and 256x256 pixels; checked by the importer." } } }
          ]
        }
      ]
    },
    "actions": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "required": ["id", "title", "kind"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_-]{1,64}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "kind": { "enum": ["search", "searchTerms", "replaceText"] },
          "find": { "type": ["string", "null"], "maxLength": 128 },
          "replacement": { "type": ["string", "null"], "maxLength": 128 }
        },
        "allOf": [{
          "if": { "properties": { "kind": { "const": "replaceText" } } },
          "then": { "required": ["find", "replacement"], "properties": { "find": { "type": "string", "minLength": 1 }, "replacement": { "type": "string" } } },
          "else": { "properties": { "find": { "type": "null" }, "replacement": { "type": "null" } } }
        }]
      }
    }
  }
}
