{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AyuGramm-IOS plugin API 1, 2 and 3",
  "type": "object",
  "required": [
    "format",
    "apiVersion",
    "id",
    "name",
    "author",
    "version",
    "summary",
    "actions",
    "limitations"
  ],
  "properties": {
    "format": {
      "const": "ayugram-ios-plugin"
    },
    "apiVersion": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,64}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "summary": {
      "type": "string",
      "maxLength": 2048
    },
    "convertedFrom": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "sourceSHA256": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "limitations": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "maxLength": 512
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,64}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "kind": {
            "enum": [
              "search",
              "searchTerms",
              "replaceText",
              "outgoingReplace",
              "cameraFlip"
            ]
          },
          "find": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          },
          "replacement": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          },
          "prefix": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          },
          "replacementCount": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 4096
          },
          "condition": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "kind",
              "value",
              "negated"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "prefix",
                  "suffix",
                  "contains",
                  "equals"
                ]
              },
              "value": {
                "type": "string",
                "maxLength": 128
              },
              "negated": {
                "type": "boolean"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "replaceText",
                    "outgoingReplace"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "find",
                "replacement"
              ],
              "properties": {
                "find": {
                  "type": "string",
                  "minLength": 1
                },
                "replacement": {
                  "type": "string"
                }
              }
            },
            "else": {
              "properties": {
                "find": {
                  "type": "null"
                },
                "replacement": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "outgoingReplace"
                }
              }
            },
            "then": {
              "properties": {
                "replacement": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "description": "Nonempty replacement must not expand UTF-8/UTF-16 length; native importer checks this."
            },
            "else": {
              "properties": {
                "prefix": {
                  "type": "null"
                },
                "condition": {
                  "type": "null"
                },
                "replacementCount": {
                  "type": "null"
                }
              }
            }
          },
          {
            "not": {
              "required": [
                "prefix",
                "condition"
              ],
              "properties": {
                "prefix": {
                  "type": "string"
                },
                "condition": {
                  "type": "object"
                }
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "apiVersion": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "actions": {
            "items": {
              "properties": {
                "condition": {
                  "type": "null"
                },
                "replacementCount": {
                  "type": "null"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "apiVersion": {
            "enum": [
              1,
              2
            ]
          }
        }
      },
      "then": {
        "properties": {
          "actions": {
            "items": {
              "properties": {
                "kind": {
                  "not": {
                    "const": "cameraFlip"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
