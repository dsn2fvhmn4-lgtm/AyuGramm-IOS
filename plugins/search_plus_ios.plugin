{
  "format": "ayugram-ios-plugin",
  "apiVersion": 1,
  "id": "search_plus",
  "name": "Search+ for iOS",
  "author": "@SearchPlusss (original)",
  "version": "2.6.1-ios.1",
  "summary": "Native search actions adapted from Search+. Multi-term search uses up to six phrases separated by | in the current chat.",
  "actions": [{ "id": "search", "title": "Search+", "kind": "searchTerms" }],
  "convertedFrom": "exteraGram Search+ 2.6.1",
  "sourceSHA256": "802dd326787e3640f55f20ac5462539c03202184e540578a4531c693c2c3458a",
  "limitations": [
    "Search is limited to the current chat and up to 40 results per phrase; no automatic pagination.",
    "Android hooks, global search injection, user lookup by ID/phone and custom date/type/author filters are not converted.",
    "The original Python code is not executed. This installs the listed native adapter actions only."
  ]
}
