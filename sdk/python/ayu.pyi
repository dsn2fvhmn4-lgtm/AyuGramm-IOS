# Type stubs for AyuGram for iOS Python plugins (PocketPy). Put next to your plugin for IDE
# completion; the app provides `ayu` as a global at run time.
from typing import Any, Callable, Dict, List, Optional

Json = Any
TextHook = Callable[[str, Dict[str, Any]], Optional[str]]

class _Points:
    outgoing_text: str  # "message.outgoing.text"
    lyrics_text: str    # "lyrics.text" (inject)

class _Hooks:
    points: _Points
    def before(self, point: str, fn: Optional[TextHook] = ...) -> Any: ...
    def after(self, point: str, fn: Optional[TextHook] = ...) -> Any: ...
    def replace(self, point: str, fn: Optional[TextHook] = ...) -> Any: ...

class _Storage:
    def get(self, key: str) -> Optional[str]: ...
    def set(self, key: str, value: Optional[str]) -> None: ...

class _Settings:
    def declare(self, items: List[Dict[str, Any]]) -> None: ...
    def get(self, key: str) -> Json: ...

class _Section:
    def add(self, options: Optional[Dict[str, Any]] = ..., **kwargs: Any) -> Any: ...
    def remove(self, options: Any = ..., **kwargs: Any) -> Any: ...

class _GiftsCatalog:
    def list(self, fn: Callable[[List[Dict[str, Any]]], None]) -> Any: ...

class _Gifts:
    catalog: _GiftsCatalog

class _UI:
    menu: _Section
    profile: Any
    overlay: Any
    font: Any
    badge: _Section
    gifts: _Gifts
    def alert(self, options: Dict[str, Any], fn: Optional[Callable[[Optional[str]], None]] = ...) -> Any: ...
    def sheet(self, options: Dict[str, Any], fn: Optional[Callable[[Optional[str]], None]] = ...) -> Any: ...

class _Net:
    def fetch(self, url: str, fn: Optional[Callable[[Dict[str, Any]], None]] = ..., method: str = ..., headers: Optional[Dict[str, str]] = ..., body: Optional[str] = ...) -> Any: ...

class _Messages:
    def send(self, peer_id: Any, text: str, fn: Optional[Callable[[Any], None]] = ...) -> Any: ...
    def edit(self, peer_id: Any, message_id: Any, text: str, fn: Optional[Callable[[Any], None]] = ...) -> Any: ...
    def react(self, peer_id: Any, message_id: Any, emoji: str, fn: Optional[Callable[[Any], None]] = ...) -> Any: ...
    def get(self, peer_id: Any, fn: Callable[[List[Dict[str, Any]]], None], limit: int = ...) -> Any: ...
    bookmarks: _Bookmarks

class _Bookmarks:
    def list(self) -> List[Dict[str, Any]]: ...
    def add(self, peer_id: Any, message_id: int, text: str = ..., chat: str = ..., tag: str = ...) -> Any: ...
    def remove(self, peer_id: Any, message_id: int) -> Any: ...

class _PeerValue:
    def get(self, peer_id: Any) -> Optional[str]: ...
    def set(self, peer_id: Any, value: Optional[str]) -> Any: ...

class _Profile:
    notes: _PeerValue
    nickname: _PeerValue

class _Chat:
    def scroll_to(self, message_id: int) -> Any: ...

class _Secrets:
    def get(self, key: str) -> Optional[str]: ...
    def set(self, key: str, value: Optional[str]) -> Any: ...

class _Bus:
    def emit(self, topic: str, data: Json = ...) -> Any: ...
    def on(self, topic: str, fn: Callable[[Json, str], None]) -> None: ...

class _I18n:
    def language(self) -> str: ...
    def t(self, strings: Dict[str, str]) -> str: ...

class _AI:
    def complete(self, prompt: str, fn: Callable[[Dict[str, Any]], None], system: Optional[str] = ..., max_tokens: int = ...) -> Any: ...

class _Screens:
    def show(self, screen: Dict[str, Any]) -> Any: ...

class _Composer:
    def add_button(self, id: str, title: str, icon: Optional[str] = ...) -> Any: ...
