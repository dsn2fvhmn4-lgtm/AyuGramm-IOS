    def register(self, name: str, description: str, fn: Callable[[str, Dict[str, Any]], Optional[str]]) -> bool: ...

class _Ayu:
    hooks: _Hooks
    storage: _Storage
    settings: _Settings
    ui: _UI
    net: _Net
    messages: _Messages
    secrets: _Secrets
    profile: _Profile
    chat: _Chat
    bus: _Bus
    i18n: _I18n
    ai: _AI
    screens: _Screens
    composer: _Composer
    files: _Files
    permissions: _Permissions
    commands: _Commands
    def call(self, op: str, **kwargs: Any) -> Any: ...
    def is_verified(self, peer_id: Any) -> bool: ...
    def log(self, *args: Any) -> None: ...
    def warn(self, *args: Any) -> None: ...
    def error(self, *args: Any) -> None: ...
    def toast(self, text: str) -> None: ...
    def on(self, event: str, fn: Optional[Callable[[Dict[str, Any]], None]] = ...) -> Any: ...

ayu: _Ayu

# exteraGram compatibility (BasePlugin plugins run without a converter).
class HookStrategy:
    DEFAULT: int
    CANCEL: int
    MODIFY: int
    MODIFY_FINAL: int

class HookResult:
    def __init__(self, strategy: int = ..., params: Any = ..., request: Any = ..., update: Any = ..., updates: Any = ...) -> None: ...

class MenuItemType:
    MESSAGE_CONTEXT_MENU: str
    DRAWER_MENU: str
    CHAT_ACTION_MENU: str
    PROFILE_ACTION_MENU: str

class MenuItemData:
    def __init__(self, menu_type: Any = ..., text: str = ..., on_click: Optional[Callable[[Dict[str, Any]], None]] = ..., icon: Any = ..., item_id: Optional[str] = ..., priority: int = ..., condition: Any = ..., subtext: Any = ...) -> None: ...

class BasePlugin:
    def on_plugin_load(self) -> None: ...
    def on_plugin_unload(self) -> None: ...
    def create_settings(self) -> List[Any]: ...
    def get_setting(self, key: str, default: Any = ...) -> Any: ...
    def log(self, text: Any) -> None: ...
    def add_on_send_message_hook(self, priority: int = ...) -> None: ...
    def on_send_message_hook(self, account: Any, params: Any) -> HookResult: ...
    def add_menu_item(self, data: MenuItemData) -> str: ...
    def remove_menu_item(self, item_id: str) -> None: ...

def Header(text: str = ..., **kwargs: Any) -> Any: ...
def Switch(key: str = ..., text: str = ..., default: bool = ..., subtext: Optional[str] = ..., **kwargs: Any) -> Any: ...
def Input(key: str = ..., text: str = ..., default: str = ..., subtext: Optional[str] = ..., **kwargs: Any) -> Any: ...
def Selector(key: str = ..., text: str = ..., default: int = ..., items: Optional[List[str]] = ..., **kwargs: Any) -> Any: ...
